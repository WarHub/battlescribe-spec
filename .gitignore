lib/
.har-staging/

# The other half of the snapshot workflow's scratch space. .har-staging/ was ignored from the
# start and .har-old/ was not, so #80 committed an 11 MB HAR here — and because the workflow only
# checked that the file existed, five months of snapshot PRs diffed against that frozen v34.18
# copy instead of the release they were replacing.
.har-old/

# Playwright MCP artifacts
.playwright-mcp/

# Raw OTLP protobuf dumps from a local collector run. ~600 KB of binary landed in a *docs* commit
# (a59738c) because this directory did not exist at the merge-base and nothing ignored it. Telemetry
# artifacts belong in artifacts/telemetry/, which is already ignored.
tel/

# Subagent-driven-development working notes (process scratch, not repo content).
.superpowers/

# Agent worktrees. `git worktree add` here nests a full checkout inside this one; only a local
# .git/info/exclude was keeping it out of `git status`, which is per-machine and unshared.
.claude/worktrees/
