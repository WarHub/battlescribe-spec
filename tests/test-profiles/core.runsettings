<?xml version="1.0" encoding="utf-8"?>
<!-- Core offline suite: everything except the NR / NR-UI engines (which run in the nr-and-ui
     and nr-conformance jobs). Covers unit, lint, protocol, and BattleScribe engine tests. -->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Engine!=FrozenNrRoster&amp;Engine!=FrozenNrGameData&amp;Engine!=LiveNrRoster&amp;Engine!=LiveNrGameData&amp;Engine!=FrozenNrUiRoster&amp;Engine!=LiveNrUiRoster&amp;Engine!=FrozenNrGameDataUi&amp;Engine!=LiveNrGameDataUi</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
