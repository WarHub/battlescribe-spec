<?xml version="1.0" encoding="utf-8"?>
<!-- Run live New Recruit roster conformance tests against https://www.newrecruit.eu -->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <NR_ENGINE_URL>https://www.newrecruit.eu</NR_ENGINE_URL>
    </EnvironmentVariables>
    <TestCaseFilter>Engine=LiveNrRoster&amp;Category=Conformance</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
