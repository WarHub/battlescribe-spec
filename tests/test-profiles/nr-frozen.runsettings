<?xml version="1.0" encoding="utf-8"?>
<!-- Run frozen New Recruit roster conformance tests using pre-recorded HAR snapshot.
     Excludes Mode=Sequential tests (manual-only; also excluded by pre-push and CI). -->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Engine=FrozenNrRoster&amp;Mode!=Sequential</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
