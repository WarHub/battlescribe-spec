<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BattleScribeSpec.Cli.Tests is a separate project nested in this directory; don't sweep up its files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);BattleScribeSpec.Cli.Tests/**</DefaultItemExcludes>
    <!--
      Server GC. pre-push's critical path is the BsRoster lane's two real-world specs, and they spend it
      allocating inside the BattleScribe engine: under server GC they run in about two thirds of the time,
      and pre-push in about three quarters (docs/concurrency-policy-measurements.md §12).
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Yaml2JsonNode" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\BattleScribeSpec.BattleScribe\BattleScribeSpec.BattleScribe.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.NewRecruit\BattleScribeSpec.NewRecruit.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.XmlGen\BattleScribeSpec.XmlGen.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.BsRosterUiDriver\BattleScribeSpec.BsRosterUiDriver.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.NrRosterUiDriver\BattleScribeSpec.NrRosterUiDriver.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.NrGameDataUiDriver\BattleScribeSpec.NrGameDataUiDriver.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.BsGameDataUiDriver\BattleScribeSpec.BsGameDataUiDriver.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.Telemetry.Collector\BattleScribeSpec.Telemetry.Collector.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.EngineHost\BattleScribeSpec.EngineHost.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.TestKit\BattleScribeSpec.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the analyzer bans in test code: the working directory, and the CLI overloads that read it (BannedSymbolsTests). -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\src\BattleScribeSpec.BattleScribe\BattleScribeIkvmConsumer.targets" />

</Project>