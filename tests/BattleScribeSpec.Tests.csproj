<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\BattleScribeSpec.Oracle\BattleScribeSpec.Oracle.csproj" />
    <ProjectReference Include="..\src\BattleScribeSpec.NewRecruit\BattleScribeSpec.NewRecruit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy IKVM-generated assemblies that aren't transitively referenced -->
  <Target Name="CopyIkvmAssemblies" AfterTargets="Build">
    <ItemGroup>
      <IkvmDlls Include="..\src\BattleScribeSpec.Oracle\bin\$(Configuration)\$(TargetFramework)\DataUtils.dll;..\src\BattleScribeSpec.Oracle\bin\$(Configuration)\$(TargetFramework)\CommonsIo.dll;..\src\BattleScribeSpec.Oracle\bin\$(Configuration)\$(TargetFramework)\KotlinStdlib.dll;..\src\BattleScribeSpec.Oracle\bin\$(Configuration)\$(TargetFramework)\KotlinStdlibCommon.dll;..\src\BattleScribeSpec.Oracle\bin\$(Configuration)\$(TargetFramework)\Stax.dll;..\src\BattleScribeSpec.Oracle\bin\$(Configuration)\$(TargetFramework)\StaxApi.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(IkvmDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>