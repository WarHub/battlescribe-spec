<Project>
  <!--
    THE TEST PROJECTS' BUILD: everything the repository's Directory.Build.props sets, plus what makes
    both test projects Microsoft.Testing.Platform apps whose entry point is the profile host,
    tests/TestProfiles/TestHost.cs. MSBuild stops at the first Directory.Build.props above a project,
    so this file imports the root one explicitly, and every test project must live under tests/ to get
    either (TestHostWiringTests.EveryTestProject_InheritsTheTestHostProps).
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Each project's Program.cs owns Main and hands it to TestHost; xunit's generated one would bypass it. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!--
      THE ONE SETTER OF TestingPlatformCommandLineArguments (TestHostWiringTests.StrictZeroTestPolicy_HasOneSetter).
      How it reaches the test app: the Microsoft.Testing.Platform package's _MTPAddArguments target
      (buildMultiTargeting/Microsoft.Testing.Platform.targets) runs before ComputeRunArguments and appends
      it to RunArguments, which both `dotnet test` and `dotnet run` hand the app, with or without a build
      first. The SDK itself reads only RunArguments; this property travels on the package's target.
      Strict means a run that executed no test fails with exit 8, and a run whose every selected test
      skipped counts as one that executed none — the shape of both silent greens this repo has had.
      The host adds the same policy to a run started any other way, and refuses a `dotnet test` run
      that arrives without it: that is how a dropped channel (`dotnet test` given test modules instead
      of a project, this property set as a global property on the command line, which replaces it, or
      a platform package whose target stopped appending it) shows up as exit 5 instead of as an
      unprofiled, unpoliced run. `dotnet run -p:TestProfile=x` has no such check (a direct run gets
      strict from the host either way, and cannot tell a dropped profile from none), which is why CI and
      the docs give a `dotnet run` lane its profile on the app's own command line, after the separator.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --zero-tests-policy strict</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!-- dotnet test -p:TestProfile=<name>: the host resolves the profile from tests/TestProfiles/TestProfiles.cs. -->
  <PropertyGroup Condition="'$(TestProfile)' != ''">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --test-profile $(TestProfile)</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!-- A VSTest habit (RunSettingsFilePath) is forwarded as a settings option, so the host refuses it, naming -p:TestProfile, rather than the run silently ignoring it. -->
  <PropertyGroup Condition="'$(RunSettingsFilePath)' != ''">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --settings "$(RunSettingsFilePath)"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
