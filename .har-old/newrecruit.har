,\u0022name\u0022:\u0022Chapter Approved 25-26\u0022,\u0022booksDate\u0022:\u00222025-01-01\u0022,\u0022challenger_cards\u0022:[[{\u0022id\u0022:701,\u0022name\u0022:\u0022Attrition\u0022,\u0022paired_with\u0022:\u0022Pivotal Moment\u0022,\u0022description\u0022:\u0022You destroyed one or more enemy units this turn.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroyed one or more enemy units this turn\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:702,\u0022name\u0022:\u0022Dug In\u0022,\u0022paired_with\u0022:\u0022Harboured Power\u0022,\u0022description\u0022:\u0022You control objective markers.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You control an objective marker\u0022,\u0022points\u0022:1,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:3}]}],\u0022max_points\u0022:3},{\u0022id\u0022:703,\u0022name\u0022:\u0022Establish Comms\u0022,\u0022paired_with\u0022:\u0022Renewed Focus\u0022,\u0022description\u0022:\u0022You establish comms with an isolated unit (15\\\u0022 away from other friendly units).\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You completed the Establish Comms action\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022shooting_phase\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:704,\u0022name\u0022:\u0022Focused Effort\u0022,\u0022paired_with\u0022:\u0022Burst of Speed\u0022,\u0022description\u0022:\u0022You coordinate fire from multiple units against the same target.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022Two or more of your units attacked the same enemy unit and wounded it this turn\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:705,\u0022name\u0022:\u0022Over the Line\u0022,\u0022paired_with\u0022:\u0022Great Haste\u0022,\u0022description\u0022:\u0022You push units into enemy territory.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You have units in enemy deployment zone (excluding Aircraft and Battle-shocked)\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:706,\u0022name\u0022:\u0022Secure Extraction Zone\u0022,\u0022paired_with\u0022:\u0022Force a Breach\u0022,\u0022description\u0022:\u0022You secure an extraction zone near battlefield edges.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You completed the Secure Extraction Zone action\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022shooting_phase\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:707,\u0022name\u0022:\u0022Self Preservation\u0022,\u0022paired_with\u0022:\u0022All In\u0022,\u0022description\u0022:\u0022You preserve a unit by keeping it away from enemies.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You completed the Self Preservation action\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:708,\u0022name\u0022:\u0022Sow Chaos\u0022,\u0022paired_with\u0022:\u0022Opportunistic Strike\u0022,\u0022description\u0022:\u0022You spread destruction across multiple enemy units.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroyed models from two or more different enemy units this turn\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}],\u0022max_points\u0022:3},{\u0022id\u0022:709,\u0022name\u0022:\u0022Zone Defence\u0022,\u0022paired_with\u0022:\u0022Strategic Retreat\u0022,\u0022description\u0022:\u0022You establish presence across multiple battlefield zones.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You have units in your deployment zone\u0022,\u0022points\u0022:1,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022per_objective\u0022:true},{\u0022description\u0022:\u0022You have units within 6\\\u0022 of battlefield centre\u0022,\u0022points\u0022:1,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022per_objective\u0022:true},{\u0022description\u0022:\u0022You have units in No Man\u0027s Land\u0022,\u0022points\u0022:1,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022per_objective\u0022:true},{\u0022description\u0022:\u0022You have units in enemy deployment zone\u0022,\u0022points\u0022:1,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022per_objective\u0022:true}]}],\u0022max_points\u0022:3}]],\u0022primary_missions\u0022:[{\u0022id\u0022:501,\u0022name\u0022:\u0022Burden of Trust\u0022,\u0022description\u0022:\u0022At the end of the Command phase, for each objective marker that player whose turn it is controls, they can select one unit from their army (excluding AIRCRAFT) within range of that objective marker to guard it until the start of their next turn.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective outside your deployment zone\u0022,\u0022points\u0022:4,\u0022per_objective\u0022:true},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You have non-Battle-shocked units guarding objectives you control\u0022,\u0022points\u0022:2,\u0022per_objective\u0022:true}]}],\u0022max_points\u0022:6},{\u0022id\u0022:502,\u0022name\u0022:\u0022Hidden Supplies\u0022,\u0022description\u0022:\u0022In the Place Objective Markers step, players must set up one additional objective marker in No Man\u0027s Land. Before setting up this new objective marker, players must first move the objective marker in the centre of the battlefield 6\\\u0022 directly towards one of the corners of the battlefield (if No Man\u0027s Land touches any of the corners of the battlefield, you must move the objective marker towards one of those corners). Otherwise, the players roll-off, and the winner selects which corner the objective marker is moved towards. Players then set up the new objective marker 6\\\u0022 from the centre of the battlefield towards the diagonally opposite corner of the battlefield to the previously moved objective marker.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control one objective outside your deployment zone\u0022,\u0022points\u0022:5,\u0022or\u0022:\u0022objective_control_tiers\u0022},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control two objectives outside your deployment zone\u0022,\u0022points\u0022:10,\u0022or\u0022:\u0022objective_control_tiers\u0022},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control more objectives than your opponent\u0022,\u0022points\u0022:5}]}],\u0022max_points\u0022:15},{\u0022id\u0022:503,\u0022name\u0022:\u0022Linchpin\u0022,\u0022description\u0022:\u0022Control the central objective marker for victory points.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You don\u0027t control your deployment zone objective: score for each objective you control\u0022,\u0022points\u0022:3,\u0022per_objective\u0022:true,\u0022or\u0022:\u0022deployment_zone_control\u0022},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control your deployment zone objective\u0022,\u0022points\u0022:3,\u0022or\u0022:\u0022deployment_zone_control\u0022},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control additional objectives beyond your deployment zone\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true}]}],\u0022max_points\u0022:15},{\u0022id\u0022:504,\u0022name\u0022:\u0022Purge the Foe\u0022,\u0022description\u0022:\u0022Destroy enemy units to score victory points.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Battle Round End\u0022,\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Any Battle Round\u0022,\u0022description\u0022:\u0022You destroyed one or more enemy units this battle round\u0022,\u0022points\u0022:4}]},{\u0022phase\u0022:\u0022Battle Round End\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You destroyed more enemy units than you lost this battle round\u0022,\u0022points\u0022:4}]},{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control one or more objectives\u0022,\u0022points\u0022:4},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control more objectives than your opponent\u0022,\u0022points\u0022:4}]}],\u0022max_points\u0022:16},{\u0022id\u0022:505,\u0022name\u0022:\u0022Scorched Earth\u0022,\u0022description\u0022:\u0022Burn objective markers by completing actions with units within range.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Any Time\u0022,\u0022rounds\u0022:[1,2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Any Time\u0022,\u0022description\u0022:\u0022You burn an objective in No Man\u0027s Land\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true},{\u0022timing\u0022:\u0022Any Time\u0022,\u0022description\u0022:\u0022You burn an objective in enemy deployment zone\u0022,\u0022points\u0022:10,\u0022per_objective\u0022:true}]},{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:10}]}],\u0022max_points\u0022:10},{\u0022id\u0022:506,\u0022name\u0022:\u0022Supply Drop\u0022,\u0022description\u0022:\u0022Players randomly select two different objective markers in No Man\u0027s Land that are not in the centre of the battlefield: The first selected is the Alpha \u03B1 objective, the second selected is the Omega \u03A9 objective. Start of the Fourth Battle Round: The Alpha \u03B1 Objective is removed from the battlefield. Start of the Fifth Battle Round: The Omega \u03A9 Objective is removed from the battlefield.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective in No Man\u0027s Land\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true,\u0022or\u0022:\u0022round_based_scoring\u0022}]},{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[4],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective in No Man\u0027s Land\u0022,\u0022points\u0022:8,\u0022per_objective\u0022:true,\u0022or\u0022:\u0022round_based_scoring\u0022}]},{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective in No Man\u0027s Land\u0022,\u0022points\u0022:15,\u0022per_objective\u0022:true,\u0022or\u0022:\u0022round_based_scoring\u0022}]}],\u0022max_points\u0022:15},{\u0022id\u0022:507,\u0022name\u0022:\u0022Take and Hold\u0022,\u0022description\u0022:\u0022Control objective markers to score victory points.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:15}]}],\u0022max_points\u0022:15},{\u0022id\u0022:508,\u0022name\u0022:\u0022Terraform\u0022,\u0022description\u0022:\u0022Complete terraform actions with units within range of objective markers not in your deployment zone.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective\u0022,\u0022points\u0022:4,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:12}]},{\u0022phase\u0022:\u0022Turn End\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You have terraformed an objective\u0022,\u0022points\u0022:1,\u0022per_objective\u0022:true}]}],\u0022max_points\u0022:12},{\u0022id\u0022:509,\u0022name\u0022:\u0022The Ritual\u0022,\u0022description\u0022:\u0022Complete ritual actions to set up objective markers in No Man\u0027s Land.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Command\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You control an objective in No Man\u0027s Land\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:15}]}],\u0022max_points\u0022:15},{\u0022id\u0022:510,\u0022name\u0022:\u0022Unexploded Ordnance\u0022,\u0022description\u0022:\u0022Start of the Battle: The objective markers within No Man\u0027s Land become a Hazard objective marker. Complete Move Hazard actions to move these markers around the battlefield.\u0022,\u0022scoring_phases\u0022:[{\u0022phase\u0022:\u0022Turn End\u0022,\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You have a Hazard objective wholly in enemy deployment zone\u0022,\u0022points\u0022:8,\u0022per_objective\u0022:true},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You have a Hazard objective within 6\\\u0022 of enemy deployment zone\u0022,\u0022points\u0022:5,\u0022per_objective\u0022:true},{\u0022timing\u0022:\u0022Second Battle Round Onwards\u0022,\u0022description\u0022:\u0022You have a Hazard objective within 12\\\u0022 of enemy deployment zone\u0022,\u0022points\u0022:2,\u0022per_objective\u0022:true}]}],\u0022max_points\u0022:15}],\u0022game_step\u0022:6,\u0022game_setup\u0022:{\u0022mission\u0022:{\u0022id\u0022:\u0022mission\u0022,\u0022name\u0022:\u0022Mission\u0022,\u0022ord\u0022:1,\u0022items\u0022:[{\u0022id\u0022:10,\u0022name\u0022:\u0022Custom\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[],\u0022map\u0022:[]},\u0022ord\u0022:0},{\u0022id\u0022:11,\u0022name\u0022:\u0022Mission A\u0022,\u0022primary\u0022:\u0022Take and Hold\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Tipping Point\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:1},{\u0022id\u0022:12,\u0022name\u0022:\u0022Mission B\u0022,\u0022primary\u0022:\u0022Supply Drop\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Tipping Point\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:2},{\u0022id\u0022:13,\u0022name\u0022:\u0022Mission C\u0022,\u0022primary\u0022:\u0022Linchpin\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Tipping Point\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:3},{\u0022id\u0022:14,\u0022name\u0022:\u0022Mission D\u0022,\u0022primary\u0022:\u0022Scorched Earth\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Tipping Point\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:4},{\u0022id\u0022:15,\u0022name\u0022:\u0022Mission E\u0022,\u0022primary\u0022:\u0022Take and Hold\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Hammer and Anvil\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:5},{\u0022id\u0022:16,\u0022name\u0022:\u0022Mission F\u0022,\u0022primary\u0022:\u0022Hidden Supplies\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Hammer and Anvil\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:6},{\u0022id\u0022:17,\u0022name\u0022:\u0022Mission G\u0022,\u0022primary\u0022:\u0022Purge the Foe\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Hammer and Anvil\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:7},{\u0022id\u0022:18,\u0022name\u0022:\u0022Mission H\u0022,\u0022primary\u0022:\u0022Supply Drop\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Hammer and Anvil\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 7\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:8},{\u0022id\u0022:19,\u0022name\u0022:\u0022Mission I\u0022,\u0022primary\u0022:\u0022Hidden Supplies\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Search and Destroy\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 3\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022]},\u0022ord\u0022:9},{\u0022id\u0022:110,\u0022name\u0022:\u0022Mission J\u0022,\u0022primary\u0022:\u0022Linchpin\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Search and Destroy\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 3\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022]},\u0022ord\u0022:10},{\u0022id\u0022:111,\u0022name\u0022:\u0022Mission K\u0022,\u0022primary\u0022:\u0022Scorched Earth\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Search and Destroy\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 3\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022]},\u0022ord\u0022:11},{\u0022id\u0022:112,\u0022name\u0022:\u0022Mission L\u0022,\u0022primary\u0022:\u0022Take and Hold\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Search and Destroy\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 3\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022]},\u0022ord\u0022:12},{\u0022id\u0022:113,\u0022name\u0022:\u0022Mission M\u0022,\u0022primary\u0022:\u0022Purge the Foe\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Crucible of Battle\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:13},{\u0022id\u0022:114,\u0022name\u0022:\u0022Mission N\u0022,\u0022primary\u0022:\u0022Hidden Supplies\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Crucible of Battle\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:14},{\u0022id\u0022:115,\u0022name\u0022:\u0022Mission O\u0022,\u0022primary\u0022:\u0022Terraform\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Crucible of Battle\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:15},{\u0022id\u0022:116,\u0022name\u0022:\u0022Mission P\u0022,\u0022primary\u0022:\u0022Scorched Earth\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Crucible of Battle\u0022],\u0022map\u0022:[\u0022Layout 1\u0022,\u0022Layout 2\u0022,\u0022Layout 4\u0022,\u0022Layout 6\u0022,\u0022Layout 8\u0022]},\u0022ord\u0022:16},{\u0022id\u0022:117,\u0022name\u0022:\u0022Mission Q\u0022,\u0022primary\u0022:\u0022Supply Drop\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Sweeping Engagement\u0022],\u0022map\u0022:[\u0022Layout 3\u0022,\u0022Layout 5\u0022]},\u0022ord\u0022:17},{\u0022id\u0022:118,\u0022name\u0022:\u0022Mission R\u0022,\u0022primary\u0022:\u0022Terraform\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Sweeping Engagement\u0022],\u0022map\u0022:[\u0022Layout 3\u0022,\u0022Layout 5\u0022]},\u0022ord\u0022:18},{\u0022id\u0022:119,\u0022name\u0022:\u0022Mission S\u0022,\u0022primary\u0022:\u0022Linchpin\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Dawn of War\u0022],\u0022map\u0022:[\u0022Layout 5\u0022]},\u0022ord\u0022:19},{\u0022id\u0022:120,\u0022name\u0022:\u0022Mission T\u0022,\u0022primary\u0022:\u0022Purge the Foe\u0022,\u0022filter\u0022:{\u0022deployment\u0022:[\u0022Dawn of War\u0022],\u0022map\u0022:[\u0022Layout 5\u0022]},\u0022ord\u0022:20}]},\u0022map\u0022:{\u0022id\u0022:\u0022map\u0022,\u0022name\u0022:\u0022Map\u0022,\u0022ord\u0022:2,\u0022image\u0022:true,\u0022items\u0022:[{\u0022name\u0022:\u0022Layout 1\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout1.png\u0022},{\u0022name\u0022:\u0022Layout 2\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout2.png\u0022},{\u0022name\u0022:\u0022Layout 3\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout3.png\u0022},{\u0022name\u0022:\u0022Layout 4\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout4.png\u0022},{\u0022name\u0022:\u0022Layout 5\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout5.png\u0022},{\u0022name\u0022:\u0022Layout 6\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout6.png\u0022},{\u0022name\u0022:\u0022Layout 7\u0022,\u0022ord\u0022:7,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout7.png\u0022},{\u0022name\u0022:\u0022Layout 8\u0022,\u0022ord\u0022:8,\u0022id_system_category\u0022:\u0022map\u0022,\u0022filename\u0022:\u00222/Layout8.png\u0022}]},\u0022secondary\u0022:{\u0022name\u0022:\u0022Secondary Mission\u0022,\u0022id\u0022:\u0022secondary\u0022,\u0022perplayer\u0022:true,\u0022maxchoices\u0022:2,\u0022ord\u0022:2,\u0022items\u0022:[{\u0022id\u0022:601,\u0022name\u0022:\u0022A Tempting Target\u0022,\u0022description\u0022:\u0022Your opponent MUST select one objective marker in No Man\u0027s Land to be your Tempting Target.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You control your Tempting Target objective\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}]},{\u0022id\u0022:602,\u0022name\u0022:\u0022Area Denial\u0022,\u0022description\u0022:\u0022\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You control the centre (3\\\u0022) with no enemy units within 3\\\u0022\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022area_denial_or_1\u0022},{\u0022description\u0022:\u0022You control the centre (3\\\u0022) with no enemy units within 6\\\u0022\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022area_denial_or_1\u0022}]}]},{\u0022id\u0022:603,\u0022name\u0022:\u0022Assassination\u0022,\u0022description\u0022:\u0022\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022type\u0022:\u0022fixed\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroy an enemy CHARACTER model (4\u002B Wounds)\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true},{\u0022description\u0022:\u0022You destroy an enemy CHARACTER model (\u003C4 Wounds)\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true}]},{\u0022rounds\u0022:null,\u0022type\u0022:\u0022tactical\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroyed one or more enemy CHARACTER models this turn\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_either_players_turn\u0022,\u0022or\u0022:\u0022assassination_or_1\u0022},{\u0022description\u0022:\u0022You destroyed all enemy CHARACTER models\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_either_players_turn\u0022,\u0022or\u0022:\u0022assassination_or_1\u0022}]}]},{\u0022id\u0022:604,\u0022name\u0022:\u0022Behind Enemy Lines\u0022,\u0022description\u0022:\u0022If it is the FIRST BATTLE ROUND, you MAY draw a new Secondary Mission card and shuffle this card back into your Secondary Mission deck.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You have one unit wholly in enemy deployment zone\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022behind_enemy_lines_or_1\u0022},{\u0022description\u0022:\u0022You have two or more units wholly in enemy deployment zone\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022behind_enemy_lines_or_1\u0022}]}]},{\u0022id\u0022:605,\u0022name\u0022:\u0022Bring It Down\u0022,\u0022description\u0022:\u0022If there are no enemy MONSTER or VEHICLE units on the battlefield you MAY discard this card and draw a new Secondary Mission card.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022type\u0022:\u0022fixed\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022Destroyed MONSTER or VEHICLE with less than 15 total Wounds\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true},{\u0022description\u0022:\u0022Destroyed MONSTER or VEHICLE with 15\u002B total Wounds\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022any_time\u0022,\u0022additional\u0022:true,\u0022per_objective\u0022:true},{\u0022description\u0022:\u0022Destroyed MONSTER or VEHICLE with 20\u002B total Wounds\u0022,\u0022points\u0022:6,\u0022timing\u0022:\u0022any_time\u0022,\u0022additional\u0022:true,\u0022per_objective\u0022:true}]},{\u0022rounds\u0022:null,\u0022type\u0022:\u0022tactical\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroyed one or more enemy MONSTER or VEHICLE units this turn\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_either_players_turn\u0022}]}]},{\u0022id\u0022:606,\u0022name\u0022:\u0022Cleanse\u0022,\u0022description\u0022:\u0022\u003Cstrong\u003ECLEANSE (ACTION)\u003C/strong\u003E\u003Cbr/\u003E\u003Cstrong\u003ESTARTS:\u003C/strong\u003E Your Shooting phase.\u003Cbr/\u003E\u003Cstrong\u003EUNITS:\u003C/strong\u003E One or more units from your army within range of an objective marker that is not within your deployment zone.\u003Cbr/\u003E\u003Cstrong\u003ECOMPLETES:\u003C/strong\u003E End of your turn, if the unit performing this Action is still within range of the same objective marker and you control that objective marker.\u003Cbr/\u003E\u003Cstrong\u003EIF COMPLETED:\u003C/strong\u003E That objective marker is cleansed by your army.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022type\u0022:\u0022tactical\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You cleansed one objective marker this turn\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022cleanse_or_1\u0022},{\u0022description\u0022:\u0022You cleansed two or more objective markers this turn\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022cleanse_or_1\u0022}]}]},{\u0022id\u0022:607,\u0022name\u0022:\u0022Cull the Horde\u0022,\u0022description\u0022:\u0022If there are no enemy units on the battlefield that satisfy the condition below you MAY discard this card and draw a new Secondary Mission card.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022type\u0022:\u0022fixed\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroy an enemy INFANTRY unit (13\u002B Starting Strength)\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true}]},{\u0022rounds\u0022:null,\u0022type\u0022:\u0022tactical\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroyed one or more enemy INFANTRY units (13\u002B Starting Strength) this turn\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_either_players_turn\u0022}]}]},{\u0022id\u0022:608,\u0022name\u0022:\u0022Defend Stronghold\u0022,\u0022description\u0022:\u0022If it is the FIRST BATTLE ROUND, draw a new Secondary Mission card and shuffle this card back into your Secondary Mission deck.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:[2,3,4,5],\u0022conditions\u0022:[{\u0022description\u0022:\u0022You control one or more objective markers in your deployment zone\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_opponents_turn_or_end_of_battle\u0022}]}]},{\u0022id\u0022:609,\u0022name\u0022:\u0022Display of Might\u0022,\u0022description\u0022:\u0022If it is the FIRST BATTLE ROUND, you MUST draw a new Secondary Mission card and shuffle this card back into your Secondary Mission deck.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You have more units than opponent wholly within No Man\u0027s Land\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_your_turn\u0022}]}]},{\u0022id\u0022:610,\u0022name\u0022:\u0022Engage on All Fronts\u0022,\u0022description\u0022:\u0022If there are fewer than three units from your army on the battlefield, you MAY discard this card and draw a new Secondary Mission card.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You have units in two table quarters\u0022,\u0022points\u0022:1,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022engage_all_fronts_or_1\u0022},{\u0022description\u0022:\u0022You have units in three table quarters\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022engage_all_fronts_or_1\u0022},{\u0022description\u0022:\u0022You have units in four table quarters\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022engage_all_fronts_or_1\u0022}]}]},{\u0022id\u0022:611,\u0022name\u0022:\u0022Establish Locus\u0022,\u0022description\u0022:\u0022\u003Cstrong\u003EESTABLISH LOCUS (ACTION)\u003C/strong\u003E\u003Cbr/\u003E\u003Cstrong\u003ESTARTS:\u003C/strong\u003E Your Shooting phase.\u003Cbr/\u003E\u003Cstrong\u003EUNITS:\u003C/strong\u003E One unit from your army.\u003Cbr/\u003E\u003Cstrong\u003ECOMPLETES:\u003C/strong\u003E End of your turn, if that unit is within your opponent\u0027s deployment zone or within 6\\\u0022 of the centre of the battlefield.\u003Cbr/\u003E\u003Cstrong\u003EIF COMPLETED:\u003C/strong\u003E Your unit establishes a locus.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You established a locus within 6\\\u0022 of centre\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022establish_locus_or_1\u0022},{\u0022description\u0022:\u0022You established a locus within enemy deployment zone\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022establish_locus_or_1\u0022}]}]},{\u0022id\u0022:612,\u0022name\u0022:\u0022Extend Battle Lines\u0022,\u0022description\u0022:\u0022\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You control one or more objective markers in No Man\u0027s Land\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022extend_battle_lines_or_1\u0022},{\u0022description\u0022:\u0022You control objectives in both your deployment zone and No Man\u0027s Land\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022extend_battle_lines_or_1\u0022}]}]},{\u0022id\u0022:613,\u0022name\u0022:\u0022Marked for Death\u0022,\u0022description\u0022:\u0022Your opponent MUST select three units from their army on the battlefield. If there are only one or two units from their army on the battlefield, they must select those units. You MAY then select one unit from your opponent\u0027s army on the battlefield. If there are no units from their army on the battlefield, you MUST discard this card and draw a new Secondary Mission card.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroyed or removed one or more of opponent\u0027s chosen units this turn\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_either_players_turn\u0022,\u0022or\u0022:\u0022marked_for_death_or_1\u0022},{\u0022description\u0022:\u0022You destroyed or removed your chosen unit this turn\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_either_players_turn\u0022,\u0022or\u0022:\u0022marked_for_death_or_1\u0022}]}]},{\u0022id\u0022:614,\u0022name\u0022:\u0022No Prisoners\u0022,\u0022description\u0022:\u0022\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022type\u0022:\u0022fixed\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroy an enemy Bodyguard or non-CHARACTER unit\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:5}]},{\u0022rounds\u0022:null,\u0022type\u0022:\u0022tactical\u0022,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroy an enemy unit\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:5}]}]},{\u0022id\u0022:615,\u0022name\u0022:\u0022Overwhelming Force\u0022,\u0022description\u0022:\u0022\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You destroy an enemy unit that started near an objective\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022any_time\u0022,\u0022per_objective\u0022:true,\u0022maximum_points\u0022:5}]}]},{\u0022id\u0022:616,\u0022name\u0022:\u0022Recover Assets\u0022,\u0022description\u0022:\u0022If you\u0027re playing an Incursion mission, or there are fewer than 3 units from your army on the battlefield you MAY discard this card and draw a new Secondary mission card.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003ERECOVER ASSETS (ACTION)\u003C/strong\u003E\u003Cbr/\u003E\u003Cstrong\u003ESTARTS:\u003C/strong\u003E Your Shooting phase.\u003Cbr/\u003E\u003Cstrong\u003EUNITS:\u003C/strong\u003E Two or more units from your army, if each of those units is wholly within a different one of the following areas; your deployment zone, No Man\u0027s Land, your opponent\u0027s deployment zone.\u003Cbr/\u003E\u003Cstrong\u003ECOMPLETES:\u003C/strong\u003E End of your turn, if either two or three of those units are on the battlefield.\u003Cbr/\u003E\u003Cstrong\u003EIF COMPLETED:\u003C/strong\u003E Those units recover assets.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022Two of your units recovered assets this turn\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022recover_assets_or_1\u0022},{\u0022description\u0022:\u0022Three or more of your units recovered assets this turn\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022recover_assets_or_1\u0022}]}]},{\u0022id\u0022:617,\u0022name\u0022:\u0022Sabotage\u0022,\u0022description\u0022:\u0022\u003Cstrong\u003ESABOTAGE (ACTION)\u003C/strong\u003E\u003Cbr/\u003E\u003Cstrong\u003ESTARTS:\u003C/strong\u003E Your Shooting phase.\u003Cbr/\u003E\u003Cstrong\u003EUNITS:\u003C/strong\u003E One unit from your army that is within a terrain feature and not within your deployment zone.\u003Cbr/\u003E\u003Cstrong\u003ECOMPLETES:\u003C/strong\u003E End of your opponent\u0027s next turn or the end of the battle (whichever comes first), if your unit is on the battlefield.\u003Cbr/\u003E\u003Cstrong\u003EIF COMPLETED:\u003C/strong\u003E Your unit commits sabotage.\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You committed sabotage outside enemy deployment zone\u0022,\u0022points\u0022:3,\u0022timing\u0022:\u0022end_of_your_opponents_turn_or_end_of_battle\u0022,\u0022or\u0022:\u0022sabotage_or_1\u0022},{\u0022description\u0022:\u0022You committed sabotage within enemy deployment zone\u0022,\u0022points\u0022:6,\u0022timing\u0022:\u0022end_of_your_opponents_turn_or_end_of_battle\u0022,\u0022or\u0022:\u0022sabotage_or_1\u0022}]}]},{\u0022id\u0022:618,\u0022name\u0022:\u0022Secure No Man\u0027s Land\u0022,\u0022description\u0022:\u0022\u0022,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You control one objective marker in No Man\u0027s Land\u0022,\u0022points\u0022:2,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022secure_no_mans_land_or_1\u0022},{\u0022description\u0022:\u0022You control two or more objective markers in No Man\u0027s Land\u0022,\u0022points\u0022:5,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022or\u0022:\u0022secure_no_mans_land_or_1\u0022}]}]},{\u0022id\u0022:619,\u0022name\u0022:\u0022Storm Hostile Objective\u0022,\u0022description\u0022:\u0022If it is the FIRST BATTLE ROUND, you MAY draw a new Secondary Mission card and shuffle this card back into your Secondary Mission deck.\u0022,\u0022fixed\u0022:true,\u0022scoring_phases\u0022:[{\u0022rounds\u0022:null,\u0022conditions\u0022:[{\u0022description\u0022:\u0022You captured objectives from opponent this turn\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_your_turn\u0022},{\u0022description\u0022:\u0022You captured new objectives (when opponent controlled none)\u0022,\u0022points\u0022:4,\u0022timing\u0022:\u0022end_of_your_turn\u0022,\u0022rounds\u0022:[2,3,4,5]}]}]}]}},\u0022steps\u0022:[{\u0022key\u0022:\u0022game-config\u0022,\u0022label\u0022:\u0022Game Configuration\u0022,\u0022icon\u0022:\u0022game-config\u0022,\u0022route\u0022:\u0022app-game-GameConfig\u0022},{\u0022key\u0022:\u0022player-setup\u0022,\u0022label\u0022:\u0022Player Setup\u0022,\u0022icon\u0022:\u0022player-setup\u0022,\u0022route\u0022:\u0022app-game-PlayerSetup\u0022},{\u0022key\u0022:\u0022mission-setup\u0022,\u0022label\u0022:\u0022Mission Setup\u0022,\u0022icon\u0022:\u0022mission-setup\u0022,\u0022route\u0022:\u0022app-game-wh40k-MissionSetup\u0022},{\u0022key\u0022:\u0022player1-secondaries\u0022,\u0022label\u0022:\u0022Player 1 Secondaries\u0022,\u0022icon\