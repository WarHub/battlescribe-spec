91C\u7D22\u0022,pl:\u0022Szukaj\u0022,pt:\u0022Buscar\u0022,hr:\u0022Pretra\u017Ei\u0022,cz:\u0022Search\u0022,sk:\u0022H\u013Eada\u0165\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7\u0022,ru:\u0022\u041F\u043E\u0438\u0441\u043A\u0022,ko:\u0022\uAC80\uC0C9\u0022},Uue={en:\u0022Filter Results\u0022,fr:\u0022Filtrer les R\u00E9sultats\u0022,es:\u0022Filter Results\u0022,cn:\u0022Filter Results\u0022,it:\u0022Filtra Risultati\u0022,de:\u0022Ergebnisse Filtern\u0022,ja:\u0022\u7D50\u679C\u3092\u30D5\u30A3\u30EB\u30BF\u30FC\u0022,pl:\u0022Filter Results\u0022,pt:\u0022Filtrar Resultados\u0022,hr:\u0022Filtriraj rezultate\u0022,cz:\u0022Filter Results\u0022,sk:\u0022Filter Results\u0022,gr:\u0022\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1 \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD\u0022,ru:\u0022\u0424\u0438\u043B\u044C\u0442\u0440 \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B\u0022,ko:\u0022Filter Results\u0022},xue={en:\u0022Filter Pairings\u0022,fr:\u0022Filtrer les Paires\u0022,es:\u0022Filter Pairings\u0022,cn:\u0022Filter Pairings\u0022,it:\u0022Filtra Accoppiamenti\u0022,de:\u0022Paarungen Filtern\u0022,ja:\u0022\u30DA\u30A2\u30EA\u30F3\u30B0\u3092\u30D5\u30A3\u30EB\u30BF\u30FC\u0022,pl:\u0022Filter Pairings\u0022,pt:\u0022Filtrar Emparelhamentos\u0022,hr:\u0022Filtriraj uparivanja\u0022,cz:\u0022Filter Pairings\u0022,sk:\u0022Filter Pairings\u0022,gr:\u0022\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1 \u03B6\u03B5\u03C5\u03B3\u03B1\u03C1\u03B9\u03CE\u03BD\u0022,ru:\u0022\u0424\u0438\u043B\u044C\u0442\u0440 \u041F\u0430\u0440\u044B\u0022,ko:\u0022Filter Pairings\u0022},Que={en:\u0022Filter Handshake\u0022,fr:\u0022Filtrer la Poign\u00E9e de Main\u0022,es:\u0022Filter Handshake\u0022,cn:\u0022Filter Handshake\u0022,it:\u0022Filtra Stretta di Mano\u0022,de:\u0022Handshake Filtern\u0022,ja:\u0022\u30CF\u30F3\u30C9\u30B7\u30A7\u30A4\u30AF\u3092\u30D5\u30A3\u30EB\u30BF\u30FC\u0022,pl:\u0022Filter Handshake\u0022,pt:\u0022Filtrar Handshake\u0022,hr:\u0022Filtriraj Handshake\u0022,cz:\u0022Filter Handshake\u0022,sk:\u0022Filter Handshake\u0022,gr:\u0022\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1 \u03C7\u03B5\u03B9\u03C1\u03B1\u03C8\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0424\u0438\u043B\u044C\u0442\u0440 \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u044F\u0022,ko:\u0022Filter Handshake\u0022},Lue={en:\u0022Export Players\u0022,fr:\u0022Exporter les Joueurs\u0022,es:\u0022Export Players\u0022,cn:\u0022Export Players\u0022,it:\u0022Esporta Giocatori\u0022,de:\u0022Spieler Exportieren\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u0022,pl:\u0022Eksportuj Gracze\u0022,pt:\u0022Exportar Jogadores\u0022,hr:\u0022Izvezi igra\u010De\u0022,cz:\u0022Export Players\u0022,sk:\u0022Export Players\u0022,gr:\u0022\u0395\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE \u03C0\u03B1\u03B9\u03BA\u03C4\u03CE\u03BD\u0022,ru:\u0022\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0418\u0433\u0440\u043E\u043A\u0438\u0022,ko:\u0022Export Players\u0022},Due={en:\u0022Accountless mode is meant to be used to quickly try out New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only create up to 3 lists without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Create a New Recruit account if you want to add more lists. It is \u003Cstrong\u003E100% free\u003C/strong\u003E and New Recruit does not ask you for any personal information other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email address is only used for password recovery, it can be communicated to Tournament Organisers if you sign up for a tournament on New Recruit\u003C/strong\u003E.\u0022,fr:\u0022Le mode \u0027sans compte\u0027 est fait pour essayer rapidement New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EVous pouvez cr\u00E9er jusqu\u0027\u00E0 un maximum de 3 listes sans compte\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EVous pouvez cr\u00E9er un compte sur New Recruit afin d\u0027ajouter plus de listes. Ceci est \u003Cstrong\u003E100% gratuit\u003C/strong\u003E et New Recruit ne demande aucune information personnelle autre qu\u0027une adresse email.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EVotre adresse email est uniquement utilis\u00E9 pour la fonction de r\u00E9cup\u00E9ration de mot de passe, et peut \u00EAtre communiqu\u00E9e aux Organisateurs de Tournoi si vous rejoingner un tournoi sur New Recruit\u003C/strong\u003E.\u0022,es:\u0022Accountless mode is meant to be used to quickly try out New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only create up to 3 lists without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Create a New Recruit account if you want to add more lists. It is \u003Cstrong\u003E100% free\u003C/strong\u003E and New Recruit does not ask you for any personal information other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email address is only used for password recovery, it can be communicated to Tournament Organisers if you sign up for a tournament on New Recruit\u003C/strong\u003E.\u0022,cn:\u0022Accountless mode is meant to be used to quickly try out New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only create up to 3 lists without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Create a New Recruit account if you want to add more lists. It is \u003Cstrong\u003E100% free\u003C/strong\u003E and New Recruit does not ask you for any personal information other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email address is only used for password recovery, it can be communicated to Tournament Organisers if you sign up for a tournament on New Recruit\u003C/strong\u003E.\u0022,it:\u0022La modalit\u00E0 senza account \u00E8 pensata per provare rapidamente New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EPuoi creare solo fino a 3 liste senza un account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003ECrea un account New Recruit se vuoi aggiungere pi\u00F9 liste. \u00C8 \u003Cstrong\u003E100% gratuito\u003C/strong\u003E e New Recruit non richiede alcuna informazione personale oltre a un indirizzo email.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EIl tuo indirizzo email \u00E8 utilizzato solo per il recupero della password, pu\u00F2 essere comunicato agli organizzatori del torneo se ti iscrivi a un torneo su New Recruit\u003C/strong\u003E.\u0022,de:\u0022Der kontolose Modus ist f\u00FCr einen schnellen Test von New Recruit gedacht.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003ESie k\u00F6nnen nur bis zu 3 Listen ohne Konto erstellen\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EBitte erstellen Sie ein New Recruit-Konto, wenn Sie weitere Listen hinzuf\u00FCgen m\u00F6chten. Es ist \u003Cstrong\u003E100% kostenlos\u003C/strong\u003E und New Recruit fragt Sie nicht nach pers\u00F6nlichen Informationen au\u00DFer einer E-Mail-Adresse.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EIhre E-Mail-Adresse wird nur f\u00FCr die Passwort-Wiederherstellung verwendet, sie kann an Turnierveranstalter weitergegeben werden, wenn Sie sich f\u00FCr ein Turnier auf New Recruit anmelden\u003C/strong\u003E.\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u306A\u3057\u30E2\u30FC\u30C9\u306F\u3001New Recruit\u3092\u7D20\u65E9\u304F\u8A66\u3059\u305F\u3081\u306B\u7528\u610F\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003E\u30A2\u30AB\u30A6\u30F3\u30C8\u306A\u3057\u3067\u306F\u6700\u59273\u3064\u306E\u30EA\u30B9\u30C8\u3057\u304B\u4F5C\u6210\u3067\u304D\u307E\u305B\u3093\u003C/strong\u003E\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u3055\u3089\u306B\u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u3057\u305F\u3044\u5834\u5408\u306F\u3001New Recruit\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u003Cstrong\u003E100%\u7121\u6599\u003C/strong\u003E\u3067\u3001New Recruit\u306F\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u4EE5\u5916\u306E\u500B\u4EBA\u60C5\u5831\u3092\u6C42\u3081\u307E\u305B\u3093\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003E\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u306F\u30D1\u30B9\u30EF\u30FC\u30C9\u56DE\u5FA9\u306B\u306E\u307F\u4F7F\u7528\u3055\u308C\u3001New Recruit\u3067\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u3059\u308B\u5834\u5408\u306F\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u4E3B\u50AC\u8005\u306B\u4F1D\u3048\u3089\u308C\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u003C/strong\u003E\u3002\u0022,pl:\u0022Accountless tryb is meant do be u\u017Cywane do szybko try out Nowe Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only utw\u00F3rz g\u00F3ra do 3 listy without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Utw\u00F3rz a Nowe Recruit konto if ty chcie\u0107 do dodaj bardziej listy. To is \u003Cstrong\u003E100% free\u003C/strong\u003E and Nowe Recruit does nie ask ty for dowolny osobisty informacja other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email adres is only u\u017Cywane for has\u0142o recovery, to can be communicated do Turniej Organizatorzy if ty znak g\u00F3ra for a turniej on Nowe Recruit\u003C/strong\u003E.\u0022,pt:\u0022O modo sem conta \u00E9 destinado para experimentar rapidamente o New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EVoc\u00EA pode criar apenas at\u00E9 3 listas sem uma conta\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPor favor, crie uma conta New Recruit se quiser adicionar mais listas. \u00C9 \u003Cstrong\u003E100% gratuito\u003C/strong\u003E e o New Recruit n\u00E3o solicita nenhuma informa\u00E7\u00E3o pessoal al\u00E9m de um endere\u00E7o de e-mail.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003ESeu endere\u00E7o de e-mail \u00E9 usado apenas para recupera\u00E7\u00E3o de senha, ele pode ser comunicado aos Organizadores de Torneio se voc\u00EA se inscrever em um torneio no New Recruit\u003C/strong\u003E.\u0022,hr:\u0022Na\u010Din rada bez ra\u010Duna namijenjen je za brzo isprobavanje New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EMo\u017Eete kreirati samo do 3 popisa bez ra\u010Duna\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EMolimo kreirajte New Recruit ra\u010Dun ako \u017Eelite dodati vi\u0161e popisa. To je \u003Cstrong\u003E100% besplatno\u003C/strong\u003E i New Recruit ne tra\u017Ei nikakve osobne podatke osim email adrese.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EVa\u0161a email adresa koristi se samo za oporavak lozinke, mo\u017Ee biti podijeljena s organizatorima turnira ako se prijavite za turnir na New Recruit\u003C/strong\u003E.\u0022,cz:\u0022Accountless mode is meant to be used to quickly try out New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only create up to 3 lists without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Create a New Recruit account if you want to add more lists. It is \u003Cstrong\u003E100% free\u003C/strong\u003E and New Recruit does not ask you for any personal information other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email address is only used for password recovery, it can be communicated to Tournament Organisers if you sign up for a tournament on New Recruit\u003C/strong\u003E.\u0022,sk:\u0022Accountless mode is meant to be used to quickly try out New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only create up to 3 lists without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Create a New Recruit account if you want to add more lists. It is \u003Cstrong\u003E100% free\u003C/strong\u003E and New Recruit does not ask you for any personal information other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email address is only used for password recovery, it can be communicated to Tournament Organisers if you sign up for a tournament on New Recruit\u003C/strong\u003E.\u0022,gr:\u0022\u03A7\u03C9\u03C1\u03AF\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u0022,ru:\u0022\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044E \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438\u0022,ko:\u0022Accountless mode is meant to be used to quickly try out New Recruit.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EYou can only create up to 3 lists without an account\u003C/strong\u003E.\u003Cbr/\u003E\u003Cbr/\u003EPlease Create a New Recruit account if you want to add more lists. It is \u003Cstrong\u003E100% free\u003C/strong\u003E and New Recruit does not ask you for any personal information other than an email address.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong\u003EYour email address is only used for password recovery, it can be communicated to Tournament Organisers if you sign up for a tournament on New Recruit\u003C/strong\u003E.\u0022},Oue={en:\u0022Click here to Create an Account\u0022,fr:\u0022Cliquer ici pour Cr\u00E9er un Compte\u0022,es:\u0022Click here to Create an Account\u0022,cn:\u0022Click here to Create an Account\u0022,it:\u0022Clicca qui per creare un account\u0022,de:\u0022Klicken Sie hier, um ein Konto zu Erstellen\u0022,ja:\u0022\u3053\u3053\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u0022,pl:\u0022Kliknij tutaj do Utw\u00F3rz an Konto\u0022,pt:\u0022Clique aqui para Criar uma Conta\u0022,hr:\u0022Kliknite ovdje za kreiranje ra\u010Duna\u0022,cz:\u0022Click here to Create an Account\u0022,sk:\u0022Click here to Create an Account\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0437\u0434\u0435\u0441\u044C, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0443\u0447\u0451\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C\u0022,ko:\u0022Click here to Create an Account\u0022},Hue={en:\u0022Send payment\u0022,fr:\u0022Envoyer le paiement\u0022,es:\u0022Enviar pago\u0022,cn:\u0022\u53D1\u9001\u4ED8\u6B3E\u0022,it:\u0022Invia pagamento\u0022,de:\u0022Zahlung Senden\u0022,ja:\u0022\u652F\u6255\u3044\u3092\u9001\u4FE1\u0022,pl:\u0022Send payment\u0022,pt:\u0022Enviar pagamento\u0022,hr:\u0022Po\u0161alji Pla\u0107anje\u0022,cz:\u0022Send payment\u0022,sk:\u0022Send payment\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u03C2\u0022,ru:\u0022\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u041E\u043F\u043B\u0430\u0442\u0430\u0022,ko:\u0022Send payment\u0022},Gue={en:\u0022less than 1 day\u0022,fr:\u0022moins d\u0027une journ\u00E9e\u0022,es:\u0022less than 1 day\u0022,cn:\u0022less than 1 day\u0022,it:\u0022Meno di 1 giorno\u0022,de:\u0022weniger als 1 Tag\u0022,ja:\u00221\u65E5\u672A\u6E80\u0022,pl:\u0022less than 1 day\u0022,pt:\u0022menos de 1 dia\u0022,hr:\u0022manje od 1 dana\u0022,cz:\u0022less than 1 day\u0022,sk:\u0022less than 1 day\u0022,gr:\u0022\u039B\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03BF \u03B1\u03C0\u03CC \u03BC\u03AF\u03B1 \u03B7\u03BC\u03AD\u03C1\u03B1\u0022,ru:\u0022\u041C\u0435\u043D\u044C\u0448\u0435 1 \u0434\u043D\u044F\u0022,ko:\u0022less than 1 day\u0022},Vue={en:\u0022days\u0022,fr:\u0022jours\u0022,es:\u0022days\u0022,cn:\u0022days\u0022,it:\u0022giorni\u0022,de:\u0022Tage\u0022,ja:\u0022\u65E5\u0022,pl:\u0022days\u0022,pt:\u0022dias\u0022,hr:\u0022dana\u0022,ru:\u0022\u0434\u043D\u0438\u0022},Wue={en:\u0022Allow players to submit new lists while the tournament is Ongoing\u0022,fr:\u0022Autoriser les joueurs \u00E0 envoyer des listes lorsque le tournoi est En cours\u0022,es:\u0022Allow players to submit new lists while the tournament is Ongoing\u0022,cn:\u0022Allow players to submit new lists while the tournament is Ongoing\u0022,it:\u0022Consenti ai giocatori di inviare nuove liste mentre il torneo \u00E8 in corso\u0022,de:\u0022Spielern erlauben, neue Listen einzureichen, w\u00E4hrend das Turnier l\u00E4uft\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u9032\u884C\u4E2D\u306B\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u65B0\u3057\u3044\u30EA\u30B9\u30C8\u3092\u9001\u4FE1\u3059\u308B\u3053\u3068\u3092\u8A31\u53EF\u0022,pl:\u0022Zezw\u00F3l gracze do prze\u015Blij nowe listy podczas the turniej is Ongoing\u0022,pt:\u0022Permitir que jogadores enviem novas listas enquanto o torneio est\u00E1 Em Andamento\u0022,hr:\u0022Dopusti igra\u010Dima slanje novih popisa dok je turnir u tijeku\u0022,cz:\u0022Allow players to submit new lists while the tournament is Ongoing\u0022,sk:\u0022Allow players to submit new lists while the tournament is Ongoing\u0022,gr:\u0022\u0391\u03BB\u03BB\u03B1\u03B3\u03AE \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03C3\u03B5 \u03B5\u03BE\u03AD\u03BB\u03B9\u03BE\u03B7\u0022,ru:\u0022\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u0430\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0441\u043F\u0438\u0441\u043A\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,ko:\u0022Allow players to submit new lists while the tournament is Ongoing\u0022},Yue={en:\u0022Tournament Name\u0022,fr:\u0022Nom du Tournoi\u0022,es:\u0022Nombre del Torneo\u0022,cn:\u0022\u9526\u6807\u8D5B\u540D\u79F0\u0022,it:\u0022Nome del Torneo\u0022,de:\u0022Turniername\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u540D\u0022,pl:\u0022Turniej Nazwa\u0022,pt:\u0022Nome do Torneio\u0022,hr:\u0022Naziv turnira\u0022,cz:\u0022Tournament Name\u0022,sk:\u0022Tournament Name\u0022,gr:\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u038C\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Tournament Name\u0022},Kue={en:\u0022Short Name\u0022,fr:\u0022Nom Court\u0022,es:\u0022Nombre Corto\u0022,cn:\u0022\u7B80\u79F0\u0022,it:\u0022Nome Breve\u0022,de:\u0022Kurzname\u0022,ja:\u0022\u7565\u79F0\u0022,pl:\u0022Short Name\u0022,pt:\u0022Nome Curto\u0022,hr:\u0022Kratko ime\u0022,cz:\u0022Short Name\u0022,sk:\u0022Short Name\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03C4\u03BF\u03BC\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Short Name\u0022},que={en:\u0022Tournament Type\u0022,fr:\u0022Type de Tournoi\u0022,es:\u0022Tipo de Torneo\u0022,cn:\u0022\u9526\u6807\u8D5B\u7C7B\u578B\u0022,it:\u0022Tipo di Torneo\u0022,de:\u0022Turniertyp\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30BF\u30A4\u30D7\u0022,pl:\u0022Turniej Typ\u0022,pt:\u0022Tipo de Torneio\u0022,hr:\u0022Vrsta turnira\u0022,cz:\u0022Tournament Type\u0022,sk:\u0022Tournament Type\u0022,gr:\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03A4\u03CD\u03C0\u03BF\u03C2\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0422\u0438\u043F\u0022,ko:\u0022Tournament Type\u0022},Jue={en:\u0022Pairings Type\u0022,fr:\u0022Type d\u0027Appariement\u0022,es:\u0022Tipo de Emparejamiento\u0022,cn:\u0022\u914D\u5BF9\u7C7B\u578B\u0022,it:\u0022Tipo di Accoppiamenti\u0022,de:\u0022Paarungstyp\u0022,ja:\u0022\u30DA\u30A2\u30EA\u30F3\u30B0\u30BF\u30A4\u30D7\u0022,pl:\u0022Pairings Type\u0022,pt:\u0022Tipo de Emparelhamentos\u0022,hr:\u0022Vrsta uparivanja\u0022,cz:\u0022Pairings Type\u0022,sk:\u0022Pairings Type\u0022,gr:\u0022\u03A4\u03CD\u03C0\u03BF\u03C2 \u03B6\u03B5\u03C5\u03B3\u03B1\u03C1\u03B9\u03CE\u03BD\u0022,ru:\u0022\u041F\u0430\u0440\u044B \u0422\u0438\u043F\u0022,ko:\u0022Pairings Type\u0022},$ue={en:\u0022If you select Swiss Rounds, it is now possible to create a Playoff table at any point after the Swiss rounds.\u0022,fr:\u0022Si vous s\u00E9lectionnez les Rondes Suisses, il est maintenant possible de cr\u00E9er un tableau des \u00E9liminatoires \u00E0 tout moment apr\u00E8s les rondes suisses.\u0022,es:\u0022Si seleccionas Rondas Suizas, ahora es posible crear una tabla de Eliminatorias en cualquier momento despu\u00E9s de las rondas suizas.\u0022,cn:\u0022\u5982\u679C\u60A8\u9009\u62E9\u745E\u58EB\u8F6E\u6B21\uFF0C\u73B0\u5728\u53EF\u4EE5\u5728\u745E\u58EB\u8F6E\u6B21\u540E\u7684\u4EFB\u4F55\u65F6\u95F4\u521B\u5EFA\u6C7A\u8D5B\u8868\u3002\u0022,it:\u0022Se selezioni Round Svizzeri, \u00E8 ora possibile creare una tabella playoff in qualsiasi momento dopo i round svizzeri.\u0022,de:\u0022Wenn Sie Schweizer System w\u00E4hlen, ist es nun m\u00F6glich, jederzeit nach den Schweizer Runden eine Playoff-Tabelle zu erstellen.\u0022,ja:\u0022\u30B9\u30A4\u30B9\u5F0F\u30E9\u30A6\u30F3\u30C9\u3092\u9078\u629E\u3059\u308B\u3068\u3001\u30B9\u30A4\u30B9\u5F0F\u30E9\u30A6\u30F3\u30C9\u5F8C\u306E\u4EFB\u610F\u306E\u6642\u70B9\u3067\u30D7\u30EC\u30FC\u30AA\u30D5\u30C6\u30FC\u30D6\u30EB\u3092\u4F5C\u6210\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u308A\u307E\u3057\u305F\u3002\u0022,pl:\u0022If ty wybierz Swiss Rundy, to is now mo\u017Cliwe do utw\u00F3rz a Playoff tabela at dowolny punkt po the Swiss rundy.\u0022,pt:\u0022Se voc\u00EA selecionar Rodadas Su\u00ED\u00E7as, agora \u00E9 poss\u00EDvel criar uma tabela de Playoffs a qualquer momento ap\u00F3s as rodadas su\u00ED\u00E7as.\u0022,hr:\u0022Ako odaberete \u0161vicarski sustav, sada je mogu\u0107e kreirati tablicu doigravanja u bilo kojem trenutku nakon \u0161vicarskih rundi.\u0022,cz:\u0022If you select Swiss Rounds, it is now possible to create a Playoff table at any point after the Swiss rounds.\u0022,sk:\u0022If you select Swiss Rounds, it is now possible to create a Playoff table at any point after the Swiss rounds.\u0022,gr:\u0022\u0395\u03BB\u03B2\u03B5\u03C4\u03B9\u03BA\u03BF\u03AF \u03B3\u03CD\u03C1\u03BF\u03B9 - \u03A0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2 playoff\u0022,ru:\u0022\u0415\u0441\u043B\u0438 \u0432\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0435 \u0440\u0430\u0443\u043D\u0434\u044B, \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u043F\u043B\u0435\u0439-\u043E\u0444\u0444 \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u043F\u043E\u0441\u043B\u0435 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0445 \u0440\u0430\u0443\u043D\u0434\u043E\u0432.\u0022,ko:\u0022If you select Swiss Rounds, it is now possible to create a Playoff table at any point after the Swiss rounds.\u0022},Zue={en:\u0022You can use this to create a tournament with just a Playoff table by selecting Swiss Rounds and not generating any Swiss Round before you create the Playoff table.\u0022,fr:\u0022Vous pouvez utiliser ceci pour cr\u00E9er un tournoi avec juste un tableau des \u00E9liminatoires en s\u00E9lectionnant les Rondes Suisses et en ne g\u00E9n\u00E9rant aucune Ronde Suisse avant de cr\u00E9er le tableau des \u00E9liminatoires.\u0022,es:\u0022Puedes usar esto para crear un torneo con solo una tabla de Eliminatorias seleccionando Rondas Suizas y no generando ninguna Ronda Suiza antes de crear la tabla de Eliminatorias.\u0022,cn:\u0022\u60A8\u53EF\u4EE5\u901A\u8FC7\u9009\u62E9\u745E\u58EB\u8F6E\u6B21\u5E76\u5728\u521B\u5EFA\u6C7A\u8D5B\u8868\u4E4B\u524D\u4E0D\u751F\u6210\u4EFB\u4F55\u745E\u58EB\u8F6E\u6B21\u6765\u521B\u5EFA\u4E00\u4E2A\u53EA\u6709\u6C7A\u8D5B\u8868\u7684\u9526\u6807\u8D5B\u3002\u0022,it:\u0022Puoi usare questo per creare un torneo con solo una tabella playoff selezionando Round Svizzeri e non generando alcun round svizzero prima di creare la tabella playoff.\u0022,de:\u0022Sie k\u00F6nnen dies verwenden, um ein Turnier nur mit einer Playoff-Tabelle zu erstellen, indem Sie Schweizer System w\u00E4hlen und keine Schweizer Runden generieren, bevor Sie die Playoff-Tabelle erstellen.\u0022,ja:\u0022\u30B9\u30A4\u30B9\u5F0F\u30E9\u30A6\u30F3\u30C9\u3092\u9078\u629E\u3057\u3001\u30D7\u30EC\u30FC\u30AA\u30D5\u30C6\u30FC\u30D6\u30EB\u3092\u4F5C\u6210\u3059\u308B\u524D\u306B\u30B9\u30A4\u30B9\u5F0F\u30E9\u30A6\u30F3\u30C9\u3092\u751F\u6210\u3057\u306A\u3044\u3053\u3068\u3067\u3001\u30D7\u30EC\u30FC\u30AA\u30D5\u30C6\u30FC\u30D6\u30EB\u306E\u307F\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u3092\u4F5C\u6210\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Ty can use to do utw\u00F3rz a turniej with sprawiedliwy a Playoff tabela by selecting Swiss Rundy and nie generating dowolny Swiss Okr\u0105g\u0142e przed ty utw\u00F3rz the Playoff tabela.\u0022,pt:\u0022Voc\u00EA pode usar isso para criar um torneio com apenas uma tabela de Playoffs selecionando Rodadas Su\u00ED\u00E7as e n\u00E3o gerando nenhuma Rodada Su\u00ED\u00E7a antes de criar a tabela de Playoffs.\u0022,hr:\u0022Mo\u017Eete koristiti ovo za kreiranje turnira samo s tablicom doigravanja odabirom \u0161vicarskog sustava i bez generiranja \u0161vicarskih rundi prije nego \u0161to kreirate tablicu doigravanja.\u0022,cz:\u0022You can use this to create a tournament with just a Playoff table by selecting Swiss Rounds and not generating any Swiss Round before you create the Playoff table.\u0022,sk:\u0022You can use this to create a tournament with just a Playoff table by selecting Swiss Rounds and not generating any Swiss Round before you create the Playoff table.\u0022,gr:\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03BC\u03B5 \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1 playoff\u0022,ru:\u0022\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u044D\u0442\u043E \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0442\u0443\u0440\u043D\u0438\u0440\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0442\u0430\u0431\u043B\u0438\u0446\u0435\u0439 \u043F\u043B\u0435\u0439-\u043E\u0444\u0444, \u0432\u044B\u0431\u0440\u0430\u0432 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0435 \u0440\u0430\u0443\u043D\u0434\u044B \u0438 \u043D\u0435 \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u044F \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0445 \u0440\u0430\u0443\u043D\u0434\u043E\u0432 \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u043F\u043B\u0435\u0439-\u043E\u0444\u0444.\u0022,ko:\u0022You can use this to create a tournament with just a Playoff table by selecting Swiss Rounds and not generating any Swiss Round before you create the Playoff table.\u0022},Xue={en:\u0022Swiss Rounds\u0022,fr:\u0022Rondes Suisses\u0022,es:\u0022Rondas Suizas\u0022,cn:\u0022\u745E\u58EB\u8F6E\u6B21\u0022,it:\u0022Round Svizzeri\u0022,de:\u0022Schweizer System\u0022,ja:\u0022\u30B9\u30A4\u30B9\u5F0F\u30E9\u30A6\u30F3\u30C9\u0022,pl:\u0022Swiss Rounds\u0022,pt:\u0022Rodadas Su\u00ED\u00E7as\u0022,hr:\u0022\u0160vicarski sustav\u0022,cz:\u0022Swiss Rounds\u0022,sk:\u0022Swiss Rounds\u0022,gr:\u0022\u0395\u03BB\u03B2\u03B5\u03C4\u03B9\u03BA\u03BF\u03AF \u03B3\u03CD\u03C1\u03BF\u03B9\u0022,ru:\u0022\u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0420\u0430\u0443\u043D\u0434\u044B\u0022,ko:\u0022Swiss Rounds\u0022},ece={en:\u0022Pods\u0022,fr:\u0022Groupes\u0022,es:\u0022Grupos\u0022,cn:\u0022\u7EC4\u522B\u0022,it:\u0022Gironi\u0022,de:\u0022Pods\u0022,ja:\u0022\u30DD\u30C3\u30C9\u0022,pl:\u0022Pods\u0022,pt:\u0022Grupos\u0022,hr:\u0022Grupe\u0022,cz:\u0022Pods\u0022,sk:\u0022Pods\u0022,gr:\u0022Pods\u0022,ru:\u0022\u0413\u0440\u0443\u043F\u043F\u044B\u0022,ko:\u0022Pods\u0022},tce={en:\u0022Pods \u002B Single bracket\u0022,fr:\u0022Groupes \u002B \u00C9limination directe\u0022,es:\u0022Grupos \u002B Eliminaci\u00F3n simple\u0022,cn:\u0022\u7EC4\u522B \u002B \u5355\u6DE8\u6C70\u8D5B\u0022,it:\u0022Gironi \u002B Eliminazione diretta\u0022,de:\u0022Gruppen \u002B Einfaches KO-System\u0022,ja:\u0022\u30DD\u30C3\u30C9\u002B\u30B7\u30F3\u30B0\u30EB\u30D6\u30E9\u30B1\u30C3\u30C8\u0022,pl:\u0022Pods \u002B Single bracket\u0022,pt:\u0022Grupos \u002B Chave Simples\u0022,hr:\u0022Grupe \u002B Jednostruko ispadanje\u0022,cz:\u0022Pods \u002B Single bracket\u0022,sk:\u0022Pods \u002B Single bracket\u0022,gr:\u0022Pods - \u039C\u03BF\u03BD\u03CC bracket\u0022,ru:\u0022\u0413\u0440\u0443\u043F\u043F\u044B \u002B \u041E\u0434\u0438\u043D \u0421\u0435\u0442\u043A\u0430\u0022,ko:\u0022Pods \u002B Single bracket\u0022},rce={en:\u0022Pods \u002B Double bracket\u0022,fr:\u0022Groupes \u002B Double \u00E9limination\u0022,es:\u0022Grupos \u002B Doble eliminaci\u00F3n\u0022,cn:\u0022\u7EC4\u522B \u002B \u53CC\u6DE8\u6C70\u8D5B\u0022,it:\u0022Gironi \u002B Doppia eliminazione\u0022,de:\u0022Gruppen \u002B Doppeltes KO-System\u0022,ja:\u0022\u30DD\u30C3\u30C9\u002B\u30C0\u30D6\u30EB\u30D6\u30E9\u30B1\u30C3\u30C8\u0022,pl:\u0022Pods \u002B Double bracket\u0022,pt:\u0022Grupos \u002B Chave Dupla\u0022,hr:\u0022Grupe \u002B Dvostruko ispadanje\u0022,cz:\u0022Pods \u002B Double bracket\u0022,sk:\u0022Pods \u002B Double bracket\u0022,gr:\u0022Pods - \u0394\u03B9\u03C0\u03BB\u03CC bracket\u0022,ru:\u0022\u0413\u0440\u0443\u043F\u043