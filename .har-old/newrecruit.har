F\u0022,it:\u0022Successo\u0022,de:\u0022Erfolg\u0022,ja:\u0022\u6210\u529F\u0022,pl:\u0022Sukces\u0022,pt:\u0022Sucesso\u0022,hr:\u0022Uspjeh\u0022,cz:\u0022Success\u0022,sk:\u0022\u00DAspech\u0022,gr:\u0022\u0395\u03C0\u03B9\u03C4\u03C5\u03C7\u03AF\u03B1\u0022,ru:\u0022\u0423\u0441\u043F\u0435\u0448\u043D\u043E\u0022,ko:\u0022\uC131\uACF5\u0022},QUe={en:\u0022Error\u0022,fr:\u0022Erreur\u0022,es:\u0022Error\u0022,cn:\u0022\u9519\u8BEF\u0022,it:\u0022Errore\u0022,de:\u0022Fehler\u0022,ja:\u0022\u30A8\u30E9\u30FC\u0022,pl:\u0022B\u0142\u0105d\u0022,pt:\u0022Erro\u0022,hr:\u0022Gre\u0161ka\u0022,cz:\u0022Error\u0022,sk:\u0022Chyba\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430\u0022,ko:\u0022\uC624\uB958\u0022},LUe={en:\u0022Show Additional Filters\u0022,fr:\u0022Afficher les Filtres Suppl\u00E9mentaires\u0022,es:\u0022Mostrar Filtros Adicionales\u0022,cn:\u0022\u663E\u793A\u9644\u52A0\u8FC7\u6EE4\u5668\u0022,it:\u0022Mostra Filtri Aggiuntivi\u0022,de:\u0022Zus\u00E4tzliche Filter Anzeigen\u0022,ja:\u0022\u8FFD\u52A0\u30D5\u30A3\u30EB\u30BF\u30FC\u3092\u8868\u793A\u0022,pl:\u0022Poka\u017C Dodatkowe Filtry\u0022,pt:\u0022Mostrar Filtros Adicionais\u0022,hr:\u0022Prika\u017Ei dodatne filtere\u0022,cz:\u0022Show Additional Filters\u0022,sk:\u0022Show Additional Filters\u0022,gr:\u0022\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03A0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03C9\u03BD \u03A6\u03AF\u03BB\u03C4\u03C1\u03C9\u03BD\u0022,ru:\u0022\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u0438\u043B\u044C\u0442\u0440\u044B\u0022,ko:\u0022Additional Filters \uD45C\uC2DC\u0022},DUe={en:\u0022Hide Additional Filters\u0022,fr:\u0022Masquer les Filtres Suppl\u00E9mentaires\u0022,es:\u0022Ocultar Filtros Adicionales\u0022,cn:\u0022\u9690\u85CF\u9644\u52A0\u8FC7\u6EE4\u5668\u0022,it:\u0022Nascondi Filtri Aggiuntivi\u0022,de:\u0022Zus\u00E4tzliche Filter Ausblenden\u0022,ja:\u0022\u8FFD\u52A0\u30D5\u30A3\u30EB\u30BF\u30FC\u3092\u975E\u8868\u793A\u0022,pl:\u0022Ukryj Dodatkowe Filtry\u0022,pt:\u0022Ocultar Filtros Adicionais\u0022,hr:\u0022Sakrij dodatne filtere\u0022,cz:\u0022Hide Additional Filters\u0022,sk:\u0022Hide Additional Filters\u0022,gr:\u0022\u0391\u03C0\u03CC\u03BA\u03C1\u03C5\u03C8\u03B7 \u03A0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03C9\u03BD \u03A6\u03AF\u03BB\u03C4\u03C1\u03C9\u03BD\u0022,ru:\u0022\u0421\u043A\u0440\u044B\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u0438\u043B\u044C\u0442\u0440\u044B\u0022,ko:\u0022Additional Filters \uC228\uAE30\uAE30\u0022},OUe={en:\u0022Sort Oldest First\u0022,fr:\u0022Trier du Plus Ancien\u0022,es:\u0022Ordenar del M\u00E1s Antiguo\u0022,cn:\u0022\u4ECE\u65E7\u5230\u65B0\u6392\u5E8F\u0022,it:\u0022Ordina dal Pi\u00F9 Vecchio\u0022,de:\u0022\u00C4lteste Zuerst Sortieren\u0022,ja:\u0022\u53E4\u3044\u9806\u306B\u4E26\u3079\u66FF\u3048\u0022,pl:\u0022Sortuj od Najstarszych\u0022,pt:\u0022Ordenar do Mais Antigo\u0022,hr:\u0022Sortiraj od najstarijih\u0022,cz:\u0022Sort Oldest First\u0022,sk:\u0022Sort Oldest First\u0022,gr:\u0022\u03A4\u03B1\u03BE\u03B9\u03BD\u03CC\u03BC\u03B7\u03C3\u03B7 \u03B1\u03C0\u03CC \u03C4\u03BF \u03A0\u03B1\u03BB\u03B1\u03B9\u03CC\u03C4\u03B5\u03C1\u03BF\u0022,ru:\u0022\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u0442\u0430\u0440\u044B\u0435\u0022,ko:\u0022Sort Oldest First\u0022},HUe={en:\u0022It is not possible to submit new lists at this time because:\u0022,fr:\u0022Il n\u0027est pas possible de soumettre de nouvelles listes pour le moment car :\u0022,es:\u0022No es posible enviar nuevas listas en este momento porque:\u0022,cn:\u0022\u76EE\u524D\u65E0\u6CD5\u63D0\u4EA4\u65B0\u540D\u5355\uFF0C\u56E0\u4E3A\uFF1A\u0022,it:\u0022Non \u00E8 possibile inviare nuove liste in questo momento perch\u00E9:\u0022,de:\u0022Es ist derzeit nicht m\u00F6glich, neue Listen einzureichen, da:\u0022,ja:\u0022\u73FE\u6642\u70B9\u3067\u306F\u65B0\u3057\u3044\u30EA\u30B9\u30C8\u3092\u9001\u4FE1\u3067\u304D\u307E\u305B\u3093\u3002\u7406\u7531\uFF1A\u0022,pl:\u0022Nie mo\u017Cna teraz przes\u0142a\u0107 nowych list, poniewa\u017C:\u0022,pt:\u0022N\u00E3o \u00E9 poss\u00EDvel enviar novas listas no momento porque:\u0022,hr:\u0022Trenutno nije mogu\u0107e poslati nove liste jer:\u0022,cz:\u0022V tuto chv\u00EDli nen\u00ED mo\u017En\u00E9 odes\u00EDlat nov\u00E9 seznamy, proto\u017Ee:\u0022,sk:\u0022V tejto chv\u00EDli nie je mo\u017En\u00E9 odosiela\u0165 nov\u00E9 zoznamy, preto\u017Ee:\u0022,gr:\u0022\u0394\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE \u03B7 \u03C5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE \u03BD\u03AD\u03C9\u03BD \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03C3\u03C4\u03B9\u03B3\u03BC\u03AE \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE:\u0022,ru:\u0022\u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0441\u043F\u0438\u0441\u043A\u0438, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E:\u0022,ko:\u0022\uB2E4\uC74C \uC774\uC720\uB85C \uD604\uC7AC \uC0C8 \uBA85\uB2E8\uC744 \uC81C\uCD9C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4:\u0022},GUe={en:\u0022Your lists are locked by a Tournament Admin\u0022,fr:\u0022Vos listes sont verrouill\u00E9es par un Administrateur du Tournoi\u0022,es:\u0022Tus listas est\u00E1n bloqueadas por un Administrador del Torneo\u0022,cn:\u0022\u60A8\u7684\u540D\u5355\u5DF2\u88AB\u9526\u6807\u8D5B\u7BA1\u7406\u5458\u9501\u5B9A\u0022,it:\u0022Le tue liste sono bloccate da un Amministratore del Torneo\u0022,de:\u0022Ihre Listen sind von einem Turnierverwalter gesperrt\u0022,ja:\u0022\u30EA\u30B9\u30C8\u306F\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7BA1\u7406\u8005\u306B\u3088\u3063\u3066\u30ED\u30C3\u30AF\u3055\u308C\u3066\u3044\u307E\u3059\u0022,pl:\u0022Twoje listy s\u0105 zablokowane przez Administratora Turnieju\u0022,pt:\u0022Suas listas est\u00E3o bloqueadas por um Administrador do Torneio\u0022,hr:\u0022Va\u0161e liste su zaklju\u010Dane od strane administratora turnira\u0022,cz:\u0022Va\u0161e seznamy jsou uzam\u010Deny administr\u00E1torem turnaje\u0022,sk:\u0022Va\u0161e zoznamy s\u00FA uzamknut\u00E9 administr\u00E1torom turnaja\u0022,gr:\u0022\u039F\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C3\u03B1\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BA\u03BB\u03B5\u03B9\u03B4\u03C9\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE \u03C4\u03BF\u03C5 \u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0412\u0430\u0448\u0438 \u0441\u043F\u0438\u0441\u043A\u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u043C \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,ko:\u0022\uADC0\uD558\uC758 \uBA85\uB2E8\uC740 \uD1A0\uB108\uBA3C\uD2B8 \uAD00\uB9AC\uC790\uC5D0 \uC758\uD574 \uC7A0\uACA8 \uC788\uC2B5\uB2C8\uB2E4\u0022},VUe={en:\u0022The tournament is not currently in \u003Cstrong\u003EOpen\u003C/strong\u003E status\u0022,fr:\u0022Le tournoi n\u0027est pas actuellement en statut \u003Cstrong\u003EOuvert\u003C/strong\u003E\u0022,es:\u0022El torneo no est\u00E1 actualmente en estado \u003Cstrong\u003EAbierto\u003C/strong\u003E\u0022,cn:\u0022\u9526\u6807\u8D5B\u76EE\u524D\u4E0D\u5904\u4E8E\u003Cstrong\u003E\u5F00\u653E\u003C/strong\u003E\u72B6\u6001\u0022,it:\u0022Il torneo non \u00E8 attualmente in stato \u003Cstrong\u003EAperto\u003C/strong\u003E\u0022,de:\u0022Das Turnier befindet sich derzeit nicht im Status \u003Cstrong\u003EOffen\u003C/strong\u003E\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u73FE\u5728\u003Cstrong\u003E\u30AA\u30FC\u30D7\u30F3\u003C/strong\u003E\u30B9\u30C6\u30FC\u30BF\u30B9\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u0022,pl:\u0022Turniej nie jest obecnie w statusie \u003Cstrong\u003EOtwarty\u003C/strong\u003E\u0022,pt:\u0022O torneio n\u00E3o est\u00E1 atualmente com status \u003Cstrong\u003EAberto\u003C/strong\u003E\u0022,hr:\u0022Turnir trenutno nije u statusu \u003Cstrong\u003EOtvoren\u003C/strong\u003E\u0022,cz:\u0022Turnaj nen\u00ED aktu\u00E1ln\u011B ve stavu \u003Cstrong\u003EOtev\u0159en\u00FD\u003C/strong\u003E\u0022,sk:\u0022Turnaj moment\u00E1lne nie je v stave \u003Cstrong\u003EOtvoren\u00FD\u003C/strong\u003E\u0022,gr:\u0022\u03A4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B4\u03B5\u03BD \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03C3\u03C4\u03B9\u03B3\u03BC\u03AE \u03C3\u03B5 \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u003Cstrong\u003E\u0391\u03BD\u03BF\u03B9\u03C7\u03C4\u03CC\u003C/strong\u003E\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0441\u0442\u0430\u0442\u0443\u0441\u0435 \u003Cstrong\u003E\u041E\u0442\u043A\u0440\u044B\u0442\u003C/strong\u003E\u0022,ko:\u0022\uD1A0\uB108\uBA3C\uD2B8\uAC00 \uD604\uC7AC \u003Cstrong\u003E\uC624\uD508\u003C/strong\u003E \uC0C1\uD0DC\uAC00 \uC544\uB2D9\uB2C8\uB2E4\u0022},WUe={en:\u0022You may want to contact a Tournament Admin to fix this or submit a list for you.\u0022,fr:\u0022Vous pouvez contacter un Administrateur du Tournoi pour r\u00E9soudre ce probl\u00E8me ou soumettre une liste pour vous.\u0022,es:\u0022Puede que quieras contactar a un Administrador del Torneo para solucionar esto o enviar una lista por ti.\u0022,cn:\u0022\u60A8\u53EF\u80FD\u9700\u8981\u8054\u7CFB\u9526\u6807\u8D5B\u7BA1\u7406\u5458\u6765\u89E3\u51B3\u6B64\u95EE\u9898\u6216\u4E3A\u60A8\u63D0\u4EA4\u540D\u5355\u3002\u0022,it:\u0022Potresti voler contattare un Amministratore del Torneo per risolvere questo problema o inviare una lista per te.\u0022,de:\u0022Sie k\u00F6nnen einen Turnierverwalter kontaktieren, um dies zu beheben oder eine Liste f\u00FCr Sie einzureichen.\u0022,ja:\u0022\u3053\u306E\u554F\u984C\u3092\u89E3\u6C7A\u3059\u308B\u304B\u3001\u30EA\u30B9\u30C8\u3092\u9001\u4FE1\u3057\u3066\u3082\u3089\u3046\u305F\u3081\u306B\u3001\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7BA1\u7406\u8005\u306B\u9023\u7D61\u3059\u308B\u3053\u3068\u3092\u304A\u52E7\u3081\u3057\u307E\u3059\u3002\u0022,pl:\u0022Mo\u017Cesz skontaktowa\u0107 si\u0119 z Administratorem Turnieju, aby to naprawi\u0107 lub przes\u0142a\u0107 list\u0119 za Ciebie.\u0022,pt:\u0022Voc\u00EA pode querer contatar um Administrador do Torneio para corrigir isso ou enviar uma lista para voc\u00EA.\u0022,hr:\u0022Mo\u017Eda \u017Eelite kontaktirati administratora turnira da to rije\u0161i ili po\u0161alje listu za vas.\u0022,cz:\u0022Mo\u017En\u00E1 budete cht\u00EDt kontaktovat administr\u00E1tora turnaje, aby to opravil nebo odeslal seznam za v\u00E1s.\u0022,sk:\u0022Mo\u017Eno budete chcie\u0165 kontaktova\u0165 administr\u00E1tora turnaja, aby to opravil alebo odoslal zoznam za v\u00E1s.\u0022,gr:\u0022\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B5\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03B5\u03C4\u03B5 \u03BC\u03B5 \u03C4\u03BF\u03BD \u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE \u03C4\u03BF\u03C5 \u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C4\u03BF \u03B4\u03B9\u03BF\u03C1\u03B8\u03CE\u03C3\u03B5\u03B9 \u03AE \u03BD\u03B1 \u03C5\u03C0\u03BF\u03B2\u03AC\u03BB\u03B5\u03B9 \u03BC\u03B9\u03B1 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B3\u03B9\u03B1 \u03B5\u03C3\u03AC\u03C2.\u0022,ru:\u0022\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0432\u044B \u0437\u0430\u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u043C \u0442\u0443\u0440\u043D\u0438\u0440\u0430, \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u044D\u0442\u043E \u0438\u043B\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A \u0434\u043B\u044F \u0432\u0430\u0441.\u0022,ko:\u0022\uC774 \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAC70\uB098 \uBA85\uB2E8\uC744 \uC81C\uCD9C\uD558\uB824\uBA74 \uD1A0\uB108\uBA3C\uD2B8 \uAD00\uB9AC\uC790\uC5D0\uAC8C \uBB38\uC758\uD558\uC138\uC694.\u0022},YUe={en:\u0022Add Lists\u0022,fr:\u0022Ajouter des Listes\u0022,es:\u0022A\u00F1adir Listas\u0022,cn:\u0022\u6DFB\u52A0\u540D\u5355\u0022,it:\u0022Aggiungi Liste\u0022,de:\u0022Listen Hinzuf\u00FCgen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj Listy\u0022,pt:\u0022Adicionar Listas\u0022,hr:\u0022Dodaj Liste\u0022,cz:\u0022P\u0159idat Seznamy\u0022,sk:\u0022Prida\u0165 Zoznamy\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u039B\u03B9\u03C3\u03C4\u03CE\u03BD\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0421\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022\uBA85\uB2E8 \uCD94\uAC00\u0022},KUe={en:\u0022Add Tournament List\u0022,fr:\u0022Ajouter une Liste de Tournoi\u0022,es:\u0022A\u00F1adir Lista de Torneo\u0022,cn:\u0022\u6DFB\u52A0\u9526\u6807\u8D5B\u540D\u5355\u0022,it:\u0022Aggiungi Lista Torneo\u0022,de:\u0022Turnierliste Hinzuf\u00FCgen\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj List\u0119 Turniejow\u0105\u0022,pt:\u0022Adicionar Lista de Torneio\u0022,hr:\u0022Dodaj Turnirsku Listu\u0022,cz:\u0022P\u0159idat Turnajov\u00FD Seznam\u0022,sk:\u0022Prida\u0165 Turnajov\u00FD Zoznam\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u039B\u03AF\u03C3\u03C4\u03B1\u03C2 \u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0422\u0443\u0440\u043D\u0438\u0440\u043D\u044B\u0439 \u0421\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022\uD1A0\uB108\uBA3C\uD2B8 \uBA85\uB2E8 \uCD94\uAC00\u0022},qUe={en:\u0022Did you make your list on New Recruit?\u0022,fr:\u0022Avez-vous cr\u00E9\u00E9 votre liste sur New Recruit ?\u0022,es:\u0022\u00BFHiciste tu lista en New Recruit?\u0022,cn:\u0022\u60A8\u662F\u5426\u5728 New Recruit \u4E0A\u521B\u5EFA\u4E86\u540D\u5355\uFF1F\u0022,it:\u0022Hai creato la tua lista su New Recruit?\u0022,de:\u0022Haben Sie Ihre Liste auf New Recruit erstellt?\u0022,ja:\u0022New Recruit \u3067\u30EA\u30B9\u30C8\u3092\u4F5C\u6210\u3057\u307E\u3057\u305F\u304B\uFF1F\u0022,pl:\u0022Czy stworzy\u0142e\u015B swoj\u0105 list\u0119 w New Recruit?\u0022,pt:\u0022Voc\u00EA fez sua lista no New Recruit?\u0022,hr:\u0022Jeste li napravili svoju listu na New Recruit?\u0022,cz:\u0022Vytvo\u0159ili jste sv\u016Fj seznam v New Recruit?\u0022,sk:\u0022Vytvorili ste svoj zoznam v New Recruit?\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B1\u03C4\u03B5 \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C3\u03B1\u03C2 \u03C3\u03C4\u03BF New Recruit;\u0022,ru:\u0022\u0412\u044B \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0441\u0432\u043E\u0439 \u0441\u043F\u0438\u0441\u043E\u043A \u0432 New Recruit?\u0022,ko:\u0022New Recruit\uC5D0\uC11C \uBA85\uB2E8\uC744 \uB9CC\uB4DC\uC168\uB098\uC694?\u0022},JUe={en:\u0022Yes\u0022,fr:\u0022Oui\u0022,es:\u0022S\u00ED\u0022,cn:\u0022\u662F\u0022,it:\u0022S\u00EC\u0022,de:\u0022Ja\u0022,ja:\u0022\u306F\u3044\u0022,pl:\u0022Tak\u0022,pt:\u0022Sim\u0022,hr:\u0022Da\u0022,cz:\u0022Ano\u0022,sk:\u0022\u00C1no\u0022,gr:\u0022\u039D\u03B1\u03B9\u0022,ru:\u0022\u0414\u0430\u0022,ko:\u0022\uC608\u0022},$Ue={en:\u0022Add New Recruit list\u0022,fr:\u0022Ajouter une liste New Recruit\u0022,es:\u0022A\u00F1adir lista de New Recruit\u0022,cn:\u0022\u6DFB\u52A0 New Recruit \u540D\u5355\u0022,it:\u0022Aggiungi lista New Recruit\u0022,de:\u0022New Recruit Liste Hinzuf\u00FCgen\u0022,ja:\u0022New Recruit \u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj list\u0119 New Recruit\u0022,pt:\u0022Adicionar lista New Recruit\u0022,hr:\u0022Dodaj New Recruit listu\u0022,cz:\u0022P\u0159idat seznam New Recruit\u0022,sk:\u0022Prida\u0165 zoznam New Recruit\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2 New Recruit\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A New Recruit\u0022,ko:\u0022New Recruit \uBA85\uB2E8 \uCD94\uAC00\u0022},ZUe={en:\u0022No\u0022,fr:\u0022Non\u0022,es:\u0022No\u0022,cn:\u0022\u5426\u0022,it:\u0022No\u0022,de:\u0022Nein\u0022,ja:\u0022\u3044\u3044\u3048\u0022,pl:\u0022Nie\u0022,pt:\u0022N\u00E3o\u0022,hr:\u0022Ne\u0022,cz:\u0022Ne\u0022,sk:\u0022Nie\u0022,gr:\u0022\u038C\u03C7\u03B9\u0022,ru:\u0022\u041D\u0435\u0442\u0022,ko:\u0022\uC544\uB2C8\uC624\u0022},XUe={en:\u0022Add TEXT list\u0022,fr:\u0022Ajouter une liste TEXTE\u0022,es:\u0022A\u00F1adir lista de TEXTO\u0022,cn:\u0022\u6DFB\u52A0\u6587\u672C\u540D\u5355\u0022,it:\u0022Aggiungi lista TESTO\u0022,de:\u0022TEXT-Liste Hinzuf\u00FCgen\u0022,ja:\u0022\u30C6\u30AD\u30B9\u30C8\u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj list\u0119 TEKSTOW\u0104\u0022,pt:\u0022Adicionar lista TEXTO\u0022,hr:\u0022Dodaj TEKST listu\u0022,cz:\u0022P\u0159idat TEXTOV\u00DD seznam\u0022,sk:\u0022Prida\u0165 TEXTOV\u00DD zoznam\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2 \u039A\u0395\u0399\u039C\u0395\u039D\u039F\u03A5\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0422\u0415\u041A\u0421\u0422\u041E\u0412\u042B\u0419 \u0441\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022\uD14D\uC2A4\uD2B8 \uBA85\uB2E8 \uCD94\uAC00\u0022},e5e={en:\u0022This list has\u0022,fr:\u0022Cette liste a\u0022,es:\u0022Esta lista tiene\u0022,cn:\u0022\u6B64\u540D\u5355\u6709\u0022,it:\u0022Questa lista ha\u0022,de:\u0022Diese Liste hat\u0022,ja:\u0022\u3053\u306E\u30EA\u30B9\u30C8\u306B\u306F\u0022,pl:\u0022Ta lista ma\u0022,pt:\u0022Esta lista tem\u0022,hr:\u0022Ova lista ima\u0022,cz:\u0022Tento seznam m\u00E1\u0022,sk:\u0022Tento zoznam m\u00E1\u0022,gr:\u0022\u0391\u03C5\u03C4\u03AE \u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03AD\u03C7\u03B5\u03B9\u0022,ru:\u0022\u0412 \u044D\u0442\u043E\u043C \u0441\u043F\u0438\u0441\u043A\u0435 \u0435\u0441\u0442\u044C\u0022,ko:\u0022\uC774 \uBA85\uB2E8\uC5D0\uB294\u0022},t5e={en:\u0022validation errors\u0022,fr:\u0022erreurs de validation\u0022,es:\u0022errores de validaci\u00F3n\u0022,cn:\u0022\u9A8C\u8BC1\u9519\u8BEF\u0022,it:\u0022errori di validazione\u0022,de:\u0022Validierungsfehler\u0022,ja:\u0022\u691C\u8A3C\u30A8\u30E9\u30FC\u304C\u3042\u308A\u307E\u3059\u0022,pl:\u0022b\u0142\u0119dy walidacji\u0022,pt:\u0022erros de valida\u00E7\u00E3o\u0022,hr:\u0022gre\u0161ke validacije\u0022,cz:\u0022chyby validace\u0022,sk:\u0022chyby valid\u00E1cie\u0022,gr:\u0022\u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\u03C4\u03B1 \u03B5\u03C0\u03B9\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7\u03C2\u0022,ru:\u0022\u043E\u0448\u0438\u0431\u043A\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438\u0022,ko:\u0022\uAC80\uC99D \uC624\uB958\uAC00 \uC788\uC2B5\uB2C8\uB2E4\u0022},r5e={en:\u0022Paste list here...\u0022,fr:\u0022Collez la liste ici...\u0022,es:\u0022Pega la lista aqu\u00ED...\u0022,cn:\u0022\u5728\u6B64\u7C98\u8D34\u540D\u5355...\u0022,it:\u0022Incolla la lista qui...\u0022,de:\u0022Liste hier einf\u00FCgen...\u0022,ja:\u0022\u3053\u3053\u306B\u30EA\u30B9\u30C8\u3092\u8CBC\u308A\u4ED8\u3051\u3066\u304F\u3060\u3055\u3044...\u0022,pl:\u0022Wklej list\u0119 tutaj...\u0022,pt:\u0022Cole a lista aqui...\u0022,hr:\u0022Zalijepite listu ovdje...\u0022,cz:\u0022Vlo\u017Ete seznam zde...\u0022,sk:\u0022Vlo\u017Ete zoznam sem...\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BA\u03BF\u03BB\u03BB\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B5\u03B4\u03CE...\u0022,ru:\u0022\u0412\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u043F\u0438\u0441\u043E\u043A \u0441\u044E\u0434\u0430...\u0022,ko:\u0022\uC5EC\uAE30\uC5D0 \uBA85\uB2E8\uC744 \uBD99\uC5EC\uB123\uC73C\uC138\uC694...\u0022},n5e={en:\u0022Total Cost\u0022,fr:\u0022Co\u00FBt Total\u0022,es:\u0022Coste Total\u0022,cn:\u0022\u603B\u8D39\u7528\u0022,it:\u0022Costo Totale\u0022,de:\u0022Gesamtkosten\u0022,ja:\u0022\u7DCF\u30B3\u30B9\u30C8\u0022,pl:\u0022Ca\u0142kowity Koszt\u0022,pt:\u0022Custo Total\u0022,hr:\u0022Ukupna Cijena\u0022,cz:\u0022Celkov\u00E9 N\u00E1klady\u0022,sk:\u0022Celkov\u00E1 Cena\u0022,gr:\u0022\u03A3\u03C5\u03BD\u03BF\u03BB\u03B9\u03BA\u03CC \u039A\u03CC\u03C3\u03C4\u03BF\u03C2\u0022,ru:\u0022\u041E\u0431\u0449\u0430\u044F \u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u0022,ko:\u0022\uCD1D \uBE44\uC6A9\u0022},i5e={en:\u0022Faction\u0022,fr:\u0022Faction\u0022,es:\u0022Facci\u00F3n\u0022,cn:\u0022\u6D3E\u7CFB\u0022,it:\u0022Fazione\u0022,de:\u0022Fraktion\u0022,ja:\u0022\u6D3E\u95A5\u0022,pl:\u0022Frakcja\u0022,pt:\u0022Fac\u00E7\u00E3o\u0022,hr:\u0022Frakcija\u0022,cz:\u0022Frakce\u0022,sk:\u0022Frakcia\u0022,gr:\u0022\u03A6\u03B1\u03C4\u03C1\u03AF\u03B1\u0022,ru:\u0022\u0424\u0440\u0430\u043A\u0446\u0438\u044F\u0022,ko:\u0022\uC9C4\uC601\u0022},s5e={en:\u0022Your list has been exported to the following text.\u0022,fr:\u0022Votre liste a \u00E9t\u00E9 export\u00E9e vers le texte suivant.\u0022,es:\u0022Tu lista ha sido exportada al siguiente texto.\u0022,cn:\u0022\u60A8\u7684\u540D\u5355\u5DF2\u5BFC\u51FA\u5230\u4EE5\u4E0B\u6587\u672C\u3002\u0022,it:\u0022La tua lista \u00E8 stata esportata nel seguente testo.\u0022,de:\u0022Ihre Liste wurde in den folgenden Text exportiert.\u0022,ja:\u0022\u30EA\u30B9\u30C8\u306F\u6B21\u306E\u30C6\u30AD\u30B9\u30C8\u306B\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u3055\u308C\u307E\u3057\u305F\u3002\u0022,pl:\u0022Twoja lista zosta\u0142a wyeksportowana do nast\u0119puj\u0105cego tekstu.\u0022,pt:\u0022Sua lista foi exportada para o seguinte texto.\u0022,hr:\u0022Va\u0161a lista je izvezena u sljede\u0107i tekst.\u0022,cz:\u0022V\u00E1\u0161 seznam byl exportov\u00E1n do n\u00E1sleduj\u00EDc\u00EDho textu.\u0022,sk:\u0022V\u00E1\u0161 zoznam bol exportovan\u00FD do nasleduj\u00FAceho textu.\u0022,gr:\u0022\u0397 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C3\u03B1\u03C2 \u03AD\u03C7\u03B5\u03B9 \u03B5\u03BE\u03B1\u03C7\u03B8\u03B5\u03AF \u03C3\u03C4\u03BF \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03C4\u03C9 \u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF.\u0022,ru:\u0022\u0412\u0430\u0448 \u0441\u043F\u0438\u0441\u043E\u043A \u0431\u044B\u043B \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0442\u0435\u043A\u0441\u0442.\u0022,ko:\u0022\uADC0\uD558\uC758 \uBA85\uB2E8\uC774 \uB2E4\uC74C \uD14D\uC2A4\uD2B8\uB85C \uB0B4\uBCF4\uB0B4\uC84C\uC2B5\uB2C8\uB2E4.\u0022},o5e={en:\u0022You may make changes to the text export if needed\u0022,fr:\u0022Vous pouvez apporter des modifications au texte export\u00E9 si n\u00E9cessaire\u0022,es:\u0022Puedes hacer cambios en el texto exportado si es necesario\u0022,cn:\u0022\u5982\u6709\u9700\u8981\uFF0C\u60A8\u53EF\u4EE5\u5BF9\u5BFC\u51FA\u7684\u6587\u672C\u8FDB\u884C\u4FEE\u6539\u0022,it:\u0022Puoi apportare modifiche al testo esportato se necessario\u0022,de:\u0022Sie k\u00F6nnen bei Bedarf \u00C4nderungen am exportierten Text vornehmen\u0022,ja:\u0022\u5FC5\u8981\u306B\u5FDC\u3058\u3066\u3001\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u3055\u308C\u305F\u30C6\u30AD\u30B9\u30C8\u3092\u5909\u66F4\u3067\u304D\u307E\u3059\u0022,pl:\u0022W razie potrzeby mo\u017Cesz wprowadzi\u0107 zmiany w wyeksportowanym tek\u015Bcie\u0022,pt:\u0022Voc\u00EA pode fazer altera\u00E7\u00F5es no texto exportado, se necess\u00E1rio\u0022,hr:\u0022Mo\u017Eete napraviti izmjene u izvezenom tekstu ako je potrebno\u0022,cz:\u0022V p\u0159\u00EDpad\u011B pot\u0159eby m\u016F\u017Eete prov\u00E9st zm\u011Bny v exportovan\u00E9m textu\u0022,sk:\u0022V pr\u00EDpade potreby m\u00F4\u017Eete vykona\u0165 zmeny v exportovanom texte\u0022,gr:\u0022\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03C4\u03B5 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE \u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03BF\u03C5 \u03B5\u03AC\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9\u0022,ru:\u0022\u041F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u043D\u0435\u0441\u0442\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442\u0022,ko:\u0022\uD544\uC694\uD55C \uACBD\uC6B0 \uB0B4\uBCF4\uB0B8 \uD14D\uC2A4\uD2B8\uB97C \uBCC0\uACBD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\u0022},a5e={en:\u0022Submit List\u0022,fr:\u0022Soumettre la Liste\u0022,es:\u0022Enviar Lista\u0022,cn:\u0022\u63D0\u4EA4\u540D\u5355\u0022,it:\u0022Invia Lista\u0022,de:\u0022Liste Einreichen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3092\u9001\u4FE1\u0022,pl:\u0022Prze\u015Blij List\u0119\u0022,pt:\u0022Enviar Lista\u0022,hr:\u0022Po\u0161alji Listu\u0022,cz:\u0022Odeslat Seznam\u0022,sk:\u0022Odosla\u0165 Zoznam\u0022,gr:\u0022\u03A5\u03C0\u03BF\u03B2\u03BF\u03BB\u03AE \u039B\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0421\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022\uBA85\uB2E8 \uC81C\uCD9C\u0022},l5e={en:\u0022Add this List\u0022,fr:\u0022Ajouter cette Liste\u0022,es:\u0022A\u00F1adir esta Lista\u0022,cn:\u0022\u6DFB\u52A0\u6B64\u540D\u5355\u0022,it:\u0022Aggiungi questa Lista\u0022,de:\u0022Diese Liste Hinzuf\u00FCgen\u0022,ja:\u0022\u3053\u306E\u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj t\u0119 List\u0119\u0022,pt:\u0022Adicionar esta Lista\u0022,hr:\u0022Dodaj ovu Listu\u0022,cz:\u0022P\u0159idat tento Seznam\u0022,sk:\u0022Prida\u0165 tento Zoznam\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03B1\u03C5\u03C4\u03AE\u03C2 \u03C4\u03B7\u03C2 \u039B\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0421\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022\uC774 \uBA85\uB2E8 \uCD94\uAC00\u0022},u5e={en:\u0022Current Page \u0022,fr:\u0022Page Actuelle \u0022,es:\u0022P\u00E1gina Actual \u0022,cn:\u0022\u5F53\u524D\u9875\u9762 \u0022,it:\u0022Pagina Corrente \u0022,de:\u0022Aktuelle Seite \u0022,ja:\u0022\u73FE\u5728\u306E\u30DA\u30FC\u30B8 \u0022,pl:\u0022Bie\u017C\u0105ca Strona \u0022,pt:\u0022P\u00E1gina Atual \u0022,hr:\u0022Trenutna Stranica \u0022,cz:\u0022Aktu\u00E1ln\u00ED Str\u00E1nka \u0022,sk:\u0022Aktu\u00E1lna Str\u00E1nka \u0022,gr:\u0022\u03A4\u03C1\u03AD\u03C7\u03BF\u03C5\u03C3\u03B1 \u03A3\u03B5\u03BB\u03AF\u03B4\u03B1 \u0022,ru:\u0022\u0422\u0435\u043A\u0443\u0449\u0430\u044F \u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0022,ko:\u0022\uD604\uC7AC \uD398\uC774\uC9C0 \u0022},c5e={en:\u0022Next page\u0022,fr:\u0022Page suivante\u0022,es:\u0022P\u00E1gina siguiente\u0022,cn:\u0022\u4E0B\u4E00\u9875\u0022,it:\u0022Pagina successiva\u0022,de:\u0022N\u00E4chste Seite\u0022,ja:\u0022\u6B21\u306E\u30DA\u30FC\u30B8\u0022,pl:\u0022Nast\u0119pna strona\u0022,pt:\u0022Pr\u00F3xima p\u00E1gina\u0022,hr:\u0022Sljede\u0107a stranica\u0022,cz:\u0022Dal\u0161\u00ED str\u00E1nka\u0022,sk:\u0022\u010Eal\u0161ia str\u00E1nka\u0022,gr:\u0022\u0395\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03C3\u03B5\u03BB\u03AF\u03B4\u03B1\u0022,ru:\u0022\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u0022,ko:\u0022\uB2E4\uC74C \uD398\uC774\uC9C0\u0022},A5e={en:\u0022Leaders\u0022,fr:\u0022Chefs\u0022,es:\u0022L\u00EDderes\u0022,cn:\u0022\u9886\u8896\u0022,it:\u0022Leader\u0022,de:\u0022Anf\u00FChrer\u0022,ja:\u0022\u30EA\u30FC\u30C0\u30FC\u0022,pl:\u0022Przyw\u00F3dcy\u0022,pt:\u0022L\u00EDderes\u0022,hr:\u0022Vo\u0111e\u0022,cz:\u0022V\u016Fdci\u0022,sk:\u0022Vodcovia\u0022,gr:\u0022\u0397\u03B3\u03AD\u03C4\u03B5\u03C2\u0022,ru:\u0022\u041B\u0438\u0434\u0435\u0440\u044B\u0022,ko:\u0022\uC9C0\uB3C4\uC790\u0022},d5e={en:\u0022This Character already leads other units\u0022,fr:\u0022Ce Personnage dirige d\u00E9j\u00E0 d\u0027autres unit\u00E9s\u0022,es:\u0022Este Personaje ya lidera otras unidades\u0022,cn:\u0022\u6B64\u89D2\u8272\u5DF2\u7ECF\u9886\u5BFC\u5176\u4ED6\u5355\u4F4D\u0022,it:\u0022Questo Personaggio guida gi\u00E0 altre unit\u00E0\u0022,de:\u0022Dieser Charakter f\u00FChrt bereits andere Einheiten\u0022,ja:\u0022\u3053\u306E\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306F\u65E2\u306B\u4ED6\u306E\u30E6\u30CB\u30C3\u30C8\u3092\u7387\u3044\u3066\u3044\u307E\u3059\u0022,pl:\u0022Ta Posta\u0107 ju\u017C prowadzi inne jednostki\u0022,pt:\u0022Este Personagem j\u00E1 lidera outras unidades\u0022,hr:\u0022Ovaj Lik ve\u0107 vodi druge jedinice\u0022,cz:\u0022Tato Postava ji\u017E vede dal\u0161\u00ED jednotky\u0022,sk:\u0022T\u00E1to Postava u\u017E vedie in\u00E9 jednotky\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC\u03C2 \u03BF \u03A7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1\u03C2 \u03B7\u03B3\u03B5\u03AF\u03C4\u03B1\u03B9 \u03AE\u03B4\u03B7 \u03AC\u03BB\u03BB\u03C9\u03BD \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u042D\u0442\u043E\u0442 \u041F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0443\u0436\u0435 \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u0440\u0443\u0433\u0438\u0435 \u043E\u0442\u0440\u044F\u0434\u044B\u0022,ko:\u0022\uC774 \uCE90\uB9AD\uD130\uB294 \uC774\uBBF8 \uB2E4\uB978 