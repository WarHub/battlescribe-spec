022,ru:\u0022\u0422\u0435\u043A\u0441\u0442 \u042D\u043A\u0441\u043F\u043E\u0440\u0442\u0022,ko:\u0022Text Export\u0022},Cpe={en:\u0022Export Format\u0022,fr:\u0022Format d\u0027Export\u0022,es:\u0022Formato de Exportaci\u00F3n\u0022,cn:\u0022\u5BFC\u51FA\u683C\u5F0F\u0022,it:\u0022Esporta Format\u0022,de:\u0022Export Format\u0022,ja:\u0022\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u5F62\u5F0F\u0022,pl:\u0022Format Eksportu\u0022,pt:\u0022Formato de Exporta\u00E7\u00E3o\u0022,hr:\u0022Format izvoza\u0022,cz:\u0022Export Format\u0022,sk:\u0022Export Format\u0022,gr:\u0022\u0395\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE \u039C\u03BF\u03C1\u03C6\u03AE\u0022,ru:\u0022\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0424\u043E\u0440\u043C\u0430\u0442\u0022,ko:\u0022Export Format\u0022},_pe={en:\u0022Export Options\u0022,fr:\u0022Options d\u0027Export\u0022,es:\u0022Opciones de Exportaci\u00F3n\u0022,cn:\u0022\u5BFC\u51FA\u9009\u9879\u0022,it:\u0022Esporta Opzioni\u0022,de:\u0022Export Options\u0022,ja:\u0022\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u30AA\u30D7\u30B7\u30E7\u30F3\u0022,pl:\u0022Opcje Eksportu\u0022,pt:\u0022Op\u00E7\u00F5es de Exporta\u00E7\u00E3o\u0022,hr:\u0022Opcije izvoza\u0022,cz:\u0022Export Options\u0022,sk:\u0022Export Options\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03B5\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE\u03C2\u0022,ru:\u0022\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u041E\u043F\u0446\u0438\u0438\u0022,ko:\u0022Export Options\u0022},Spe={en:\u0022Shift point costs to the right.\u0022,fr:\u0022D\u00E9caler les co\u00FBts de points vers la droite.\u0022,es:\u0022Desplazar los costos de puntos a la derecha.\u0022,cn:\u0022\u5C06\u70B9\u6570\u6210\u672C\u5411\u53F3\u79FB\u52A8\u3002\u0022,it:\u0022Sposta i costi dei punti a destra.\u0022,de:\u0022Shift point costs to the right.\u0022,ja:\u0022\u30DD\u30A4\u30F3\u30C8\u30B3\u30B9\u30C8\u3092\u53F3\u306B\u30B7\u30D5\u30C8\u3002\u0022,pl:\u0022Przesu\u0144 koszty punkt\u00F3w w prawo.\u0022,pt:\u0022Deslocar custos de pontos para a direita.\u0022,hr:\u0022Pomakni tro\u0161kove bodova udesno.\u0022,cz:\u0022Shift point costs to the right.\u0022,sk:\u0022Shift point costs to the right.\u0022,gr:\u0022\u039C\u03B5\u03C4\u03B1\u03C4\u03CC\u03C0\u03B9\u03C3\u03B7 \u03BA\u03CC\u03C3\u03C4\u03BF\u03C5\u03C2 \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD\u0022,ru:\u0022\u0421\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432 \u043E\u0447\u043A\u0430\u0445\u0022,ko:\u0022Shift point costs to the right.\u0022},Epe={en:\u0022Add an \u0027x\u0027 to unit amount (eg: 35x Ghouls).\u0022,fr:\u0022Ajouter un \u0027x\u0027 au nombre d\u0027unit\u00E9s (ex: 35x Goules).\u0022,es:\u0022Agregar una \u0027x\u0027 a la cantidad de unidades (ej: 35x Esp\u00EDritus).\u0022,cn:\u0022\u5728\u5355\u4F4D\u6570\u91CF\u524D\u52A0 \u0027x\u0027\uFF08\u4F8B\uFF1A35x \u98DF\u5C38\u9B3C\uFF09\u3002\u0022,it:\u0022Aggiungi una \u0027x\u0027 alla quantit\u00E0 dell\u0027unit\u00E0 (es: 35x Ghoul).\u0022,de:\u0022Add an \u0027x\u0027 to unit amount (eg: 35x Ghouls).\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u6570\u306B \u0027x\u0027 \u3092\u8FFD\u52A0\uFF08\u4F8B\uFF1A35x Ghouls\uFF09\u3002\u0022,pl:\u0022Dodaj \u0027x\u0027 do ilo\u015Bci jednostek (np: 35x Ghule).\u0022,pt:\u0022Adicionar um \u0027x\u0027 \u00E0 quantidade de unidades (ex: 35x Carni\u00E7ais).\u0022,hr:\u0022Dodaj \u0027x\u0027 koli\u010Dini jedinica (npr: 35x Ghouls).\u0022,cz:\u0022Add an \u0027x\u0027 to unit amount (eg: 35x Ghouls).\u0022,sk:\u0022Add an \u0027x\u0027 to unit amount (eg: 35x Ghouls).\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 x \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1\u03C2\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C %{x} \u044E\u043D\u0438\u0442\u0022,ko:\u0022an \u0027x\u0027 to unit amount (eg: 35x Ghouls). \uCD94\uAC00\u0022},jpe={en:\u0022Insert unit category recap.\u0022,fr:\u0022Ins\u00E9rer un r\u00E9capitulatif des cat\u00E9gories d\u0027unit\u00E9s.\u0022,es:\u0022Insertar resumen de categor\u00EDas de unidades.\u0022,cn:\u0022\u63D2\u5165\u5355\u4F4D\u7C7B\u522B\u6458\u8981\u3002\u0022,it:\u0022Inserisci riepilogo categoria unit\u00E0.\u0022,de:\u0022Insert unit category recap.\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u30AB\u30C6\u30B4\u30EA\u306E\u8981\u7D04\u3092\u633F\u5165\u3002\u0022,pl:\u0022Wstaw podsumowanie kategorii jednostek.\u0022,pt:\u0022Inserir resumo da categoria de unidades.\u0022,hr:\u0022Umetni sa\u017Eetak kategorije jedinica.\u0022,cz:\u0022Insert unit category recap.\u0022,sk:\u0022Insert unit category recap.\u0022,gr:\u0022\u0395\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE \u03B1\u03BD\u03B1\u03BA\u03B5\u03C6\u03B1\u03BB\u03B1\u03AF\u03C9\u03C3\u03B7\u03C2 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u0434\u043A\u0443 \u043F\u043E \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F\u043C\u0022,ko:\u0022Insert unit category recap.\u0022},zpe={en:\u0022Include constant selections\u0022,fr:\u0022Inclure les s\u00E9lections constantes\u0022,es:\u0022Incluir selecciones constantes\u0022,cn:\u0022\u5305\u542B\u5E38\u91CF\u9009\u62E9\u0022,it:\u0022Includi selezioni costanti\u0022,de:\u0022Include constant selections\u0022,ja:\u0022\u5B9A\u6570\u9078\u629E\u3092\u542B\u3081\u308B\u0022,pl:\u0022Uwzgl\u0119dnij sta\u0142e wybory\u0022,pt:\u0022Incluir sele\u00E7\u00F5es constantes\u0022,hr:\u0022Uklju\u010Di stalne odabire\u0022,cz:\u0022Include constant selections\u0022,sk:\u0022Include constant selections\u0022,gr:\u0022\u03A3\u03C5\u03BC\u03C0\u03B5\u03C1\u03AF\u03BB\u03B7\u03C8\u03B7 \u03C3\u03C4\u03B1\u03B8\u03B5\u03C1\u03CE\u03BD \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03CE\u03BD\u0022,ru:\u0022\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0432\u044B\u0431\u043E\u0440\u044B\u0022,ko:\u0022Include constant selections\u0022},Ipe={en:\u0022Split for Discord\u0022,fr:\u0022Diviser pour Discord\u0022,es:\u0022Dividir para Discord\u0022,cn:\u0022\u4E3A Discord \u5206\u5272\u0022,it:\u0022Dividi per Discord\u0022,de:\u0022Split for Discord\u0022,ja:\u0022Discord\u7528\u306B\u5206\u5272\u0022,pl:\u0022Podziel dla Discord\u0022,pt:\u0022Dividir para Discord\u0022,hr:\u0022Podijeli za Discord\u0022,cz:\u0022Split for Discord\u0022,sk:\u0022Split for Discord\u0022,gr:\u0022\u0394\u03B9\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 Discord\u0022,ru:\u0022\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0434\u043B\u044F Discord\u0022,ko:\u0022Split for Discord\u0022},Ppe={en:\u0022characters\u0022,fr:\u0022caract\u00E8res\u0022,es:\u0022caracteres\u0022,cn:\u0022\u5B57\u7B26\u0022,it:\u0022caratteri\u0022,de:\u0022characters\u0022,ja:\u0022\u6587\u5B57\u0022,pl:\u0022znaki\u0022,pt:\u0022caracteres\u0022,hr:\u0022znakova\u0022,ru:\u0022\u0441\u0438\u043C\u0432\u043E\u043B\u044B\u0022},Tpe={en:\u0022Include Header\u0022,fr:\u0022Inclure l\u0027En-t\u00EAte\u0022,es:\u0022Incluir Encabezado\u0022,cn:\u0022\u5305\u542B\u6807\u9898\u0022,it:\u0022Includi Intestazione\u0022,de:\u0022Include Header\u0022,ja:\u0022\u30D8\u30C3\u30C0\u30FC\u3092\u542B\u3081\u308B\u0022,pl:\u0022Uwzgl\u0119dnij Nag\u0142\u00F3wek\u0022,pt:\u0022Incluir Cabe\u00E7alho\u0022,hr:\u0022Uklju\u010Di zaglavlje\u0022,cz:\u0022Include Header\u0022,sk:\u0022Include Header\u0022,gr:\u0022\u03A3\u03C5\u03BC\u03C0\u03B5\u03C1\u03AF\u03BB\u03B7\u03C8\u03B7 \u03BA\u03B5\u03C6\u03B1\u03BB\u03AF\u03B4\u03B1\u03C2\u0022,ru:\u0022\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0022,ko:\u0022Include Header\u0022},Npe={en:\u0022White background.\u0022,fr:\u0022Arri\u00E8re-plan blanc.\u0022,es:\u0022Fondo blanco.\u0022,cn:\u0022\u767D\u8272\u80CC\u666F\u3002\u0022,it:\u0022Sfondo bianco.\u0022,de:\u0022White background.\u0022,ja:\u0022\u767D\u3044\u80CC\u666F\u3002\u0022,pl:\u0022Bia\u0142e t\u0142o.\u0022,pt:\u0022Fundo branco.\u0022,hr:\u0022Bijela pozadina.\u0022,cz:\u0022White background.\u0022,sk:\u0022White background.\u0022,gr:\u0022\u039B\u03B5\u03C5\u03BA\u03CC \u03C6\u03CC\u03BD\u03C4\u03BF\u0022,ru:\u0022\u0411\u0435\u043B\u044B\u0439 \u0444\u043E\u043D.\u0022,ko:\u0022White background.\u0022},Fpe={en:\u0022Include player name\u0022,fr:\u0022Inclure le nom du joueur\u0022,es:\u0022Incluir nombre del jugador\u0022,cn:\u0022\u5305\u542B\u73A9\u5BB6\u59D3\u540D\u0022,it:\u0022Includi nome giocatore\u0022,de:\u0022Include player name\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u540D\u3092\u542B\u3081\u308B\u0022,pl:\u0022Uwzgl\u0119dnij nazw\u0119 gracza\u0022,pt:\u0022Incluir nome do jogador\u0022,hr:\u0022Uklju\u010Di ime igra\u010Da\u0022,cz:\u0022Include player name\u0022,sk:\u0022Include player name\u0022,gr:\u0022\u03A3\u03C5\u03BC\u03C0\u03B5\u03C1\u03AF\u03BB\u03B7\u03C8\u03B7 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u0022,ru:\u0022\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0438\u043C\u044F \u0438\u0433\u0440\u043E\u043A\u0430\u0022,ko:\u0022Include player name\u0022},Rpe={en:\u0022Include team name\u0022,fr:\u0022Inclure le nom de l\u0027\u00E9quipe\u0022,es:\u0022Incluir nombre del equipo\u0022,cn:\u0022\u5305\u542B\u961F\u4F0D\u540D\u79F0\u0022,it:\u0022Includi nome squadra\u0022,de:\u0022Include team name\u0022,ja:\u0022\u30C1\u30FC\u30E0\u540D\u3092\u542B\u3081\u308B\u0022,pl:\u0022Uwzgl\u0119dnij nazw\u0119 dru\u017Cyny\u0022,pt:\u0022Incluir nome da equipe\u0022,hr:\u0022Uklju\u010Di ime tima\u0022,cz:\u0022Include team name\u0022,sk:\u0022Include team name\u0022,gr:\u0022\u03A3\u03C5\u03BC\u03C0\u03B5\u03C1\u03AF\u03BB\u03B7\u03C8\u03B7 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2\u0022,ru:\u0022\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,ko:\u0022Include team name\u0022},Mpe={en:\u0022Copy to Clipboard\u0022,fr:\u0022Copier dans le presse-papiers\u0022,es:\u0022Copiar al portapapeles\u0022,cn:\u0022\u590D\u5236\u5230\u526A\u8D34\u677F\u0022,it:\u0022Copia negli Appunti\u0022,de:\u0022Copy to Clipboard\u0022,ja:\u0022\u30AF\u30EA\u30C3\u30D7\u30DC\u30FC\u30C9\u306B\u30B3\u30D4\u30FC\u0022,pl:\u0022Kopiuj do Schowka\u0022,pt:\u0022Copiar para a \u00C1rea de Transfer\u00EAncia\u0022,hr:\u0022Kopiraj u me\u0111uspremnik\u0022,cz:\u0022Copy to Clipboard\u0022,sk:\u0022Copy to Clipboard\u0022,gr:\u0022\u0391\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\u03C4\u03BF \u03C0\u03C1\u03CC\u03C7\u03B5\u03B9\u03C1\u03BF\u0022,ru:\u0022\u0421\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0432 \u0431\u0443\u0444\u0435\u0440 \u043E\u0431\u043C\u0435\u043D\u0430\u0022,ko:\u0022Copy to Clipboard\u0022},Upe={en:\u0022Your army does not have any Force. Open \u003Cb\u003EList Options\u003C/b\u003E to create a Force\u0022,fr:\u0022Votre arm\u00E9e n\u0027a pas de Force. Ouvrez \u003Cb\u003EOptions de Liste\u003C/b\u003E pour cr\u00E9er une Force\u0022,es:\u0022Su ej\u00E9rcito no tiene ninguna Fuerza. Abra \u003Cb\u003EOpciones de Lista\u003C/b\u003E para crear una Fuerza\u0022,cn:\u0022\u4F60\u7684\u519B\u961F\u6CA1\u6709\u4EFB\u4F55\u90E8\u961F\u3002\u6253\u5F00\u003Cb\u003E\u5217\u8868\u9009\u9879\u003C/b\u003E\u6765\u521B\u5EFA\u90E8\u961F\u0022,it:\u0022La tua armata non ha alcuna Forza. Apri \u003Cb\u003EOpzioni Lista\u003C/b\u003E per creare una Forza\u0022,de:\u0022Your army does not have any Force. Open \u003Cb\u003EList Options\u003C/b\u003E to create a Force\u0022,ja:\u0022\u30A2\u30FC\u30DF\u30FC\u306B\u30D5\u30A9\u30FC\u30B9\u304C\u3042\u308A\u307E\u305B\u3093\u3002\u003Cb\u003E\u30EA\u30B9\u30C8\u30AA\u30D7\u30B7\u30E7\u30F3\u003C/b\u003E\u3092\u958B\u3044\u3066\u30D5\u30A9\u30FC\u30B9\u3092\u4F5C\u6210\u3057\u3066\u304F\u3060\u3055\u3044\u0022,pl:\u0022Twoja armia nie ma \u017Cadnej Si\u0142y. Otw\u00F3rz \u003Cb\u003EOpcje Listy\u003C/b\u003E, aby utworzy\u0107 Si\u0142\u0119\u0022,pt:\u0022Seu ex\u00E9rcito n\u00E3o possui nenhuma For\u00E7a. Abra \u003Cb\u003EOp\u00E7\u00F5es da Lista\u003C/b\u003E e adicione uma For\u00E7a.\u0022,hr:\u0022Va\u0161a vojska nema nijednu snagu. Otvorite \u003Cb\u003EOpcije popisa\u003C/b\u003E da biste stvorili snagu\u0022,cz:\u0022Your army does not have any Force. Open \u003Cb\u003EList Options\u003C/b\u003E to create a Force\u0022,sk:\u0022Your army does not have any Force. Open \u003Cb\u003EList Options\u003C/b\u003E to create a Force\u0022,gr:\u0022\u03A7\u03C9\u03C1\u03AF\u03C2 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B9\u03C9\u03C4\u03B9\u03BA\u03AE \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7\u0022,ru:\u0022\u041D\u0435\u0442 \u0430\u0440\u043C\u0438\u0438 \u0438\u043B\u0438 \u043E\u0442\u0440\u044F\u0434\u0430\u0022,ko:\u0022Your army does not have any Force. Open \u003Cb\u003EList Options\u003C/b\u003E to create a Force\u0022},xpe={en:\u0022No list selected for this player.\u0022,fr:\u0022Aucune liste s\u00E9lectionn\u00E9e pour ce joueur.\u0022,es:\u0022No hay lista seleccionada para este jugador.\u0022,cn:\u0022\u6B64\u73A9\u5BB6\u672A\u9009\u62E9\u5217\u8868\u3002\u0022,it:\u0022Nessuna lista selezionata per questo giocatore.\u0022,de:\u0022No list selected for this player.\u0022,ja:\u0022\u3053\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u30EA\u30B9\u30C8\u304C\u9078\u629E\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002\u0022,pl:\u0022Nie wybrano listy dla tego gracza.\u0022,pt:\u0022Nenhuma lista selecionada para este jogador.\u0022,hr:\u0022Nije odabran popis za ovog igra\u010Da.\u0022,cz:\u0022No list selected for this player.\u0022,sk:\u0022No list selected for this player.\u0022,gr:\u0022\u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03B5\u03AF \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03C0\u03B1\u03AF\u03BA\