\u0022\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B\u0022,\u0022\uACB0\uACFC\u0022,{\u0022en\u0022:13535,\u0022fr\u0022:13536,\u0022es\u0022:13537,\u0022cn\u0022:13538,\u0022it\u0022:13539,\u0022de\u0022:13540,\u0022ja\u0022:13541,\u0022pl\u0022:13542,\u0022pt\u0022:13543,\u0022hr\u0022:13544,\u0022cz\u0022:13535,\u0022sk\u0022:13535,\u0022gr\u0022:13545,\u0022ru\u0022:13546,\u0022ko\u0022:13535},\u0022Load Game\u0022,\u0022Charger le Jeu\u0022,\u0022Cargar Juego\u0022,\u0022\u52A0\u8F7D\u6E38\u620F\u0022,\u0022Carica Game\u0022,\u0022Spiel laden\u0022,\u0022\u8AAD\u307F\u8FBC\u307F\u30B2\u30FC\u30E0\u0022,\u0022Wczytaj Gra\u0022,\u0022Carregar Jogo\u0022,\u0022U\u010Ditaj Igru\u0022,\u0022\u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,\u0022\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0418\u0433\u0440\u0430\u0022,{\u0022en\u0022:10271,\u0022fr\u0022:10272,\u0022es\u0022:10273,\u0022cn\u0022:10274,\u0022it\u0022:10275,\u0022de\u0022:13548,\u0022ja\u0022:10277,\u0022pl\u0022:13549,\u0022pt\u0022:10279,\u0022hr\u0022:10280,\u0022cz\u0022:10271,\u0022sk\u0022:10271,\u0022gr\u0022:10281,\u0022ru\u0022:10282,\u0022ko\u0022:10283},\u0022Neues Spiel\u0022,\u0022Nowe Gra\u0022,{\u0022en\u0022:13551,\u0022fr\u0022:13552,\u0022es\u0022:13553,\u0022cn\u0022:13554,\u0022it\u0022:13551,\u0022de\u0022:13555,\u0022ja\u0022:13551,\u0022pl\u0022:13556,\u0022pt\u0022:13557,\u0022hr\u0022:13558,\u0022cz\u0022:13551,\u0022sk\u0022:13559,\u0022gr\u0022:13560,\u0022ru\u0022:13561,\u0022ko\u0022:13551},\u0022Armies\u0022,\u0022Arm\u00E9es\u0022,\u0022Ej\u00E9rcitos\u0022,\u0022\u519B\u961F\u0022,\u0022Armeen\u0022,\u0022Armie\u0022,\u0022Ex\u00E9rcitos\u0022,\u0022Armije\u0022,\u0022Arm\u00E1dy\u0022,\u0022\u03A3\u03C4\u03C1\u03B1\u03C4\u03B9\u03AD\u03C2\u0022,\u0022\u0410\u0440\u043C\u0438\u0438\u0022,{\u0022en\u0022:13563,\u0022fr\u0022:13564,\u0022es\u0022:13565,\u0022cn\u0022:13566,\u0022it\u0022