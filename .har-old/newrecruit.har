2Identity\u0022,de:\u0022Identit\u00E4t\u0022,ja:\u0022\u30A2\u30A4\u30C7\u30F3\u30C6\u30A3\u30C6\u30A3\u0022,pl:\u0022Identity\u0022,pt:\u0022Identidade\u0022,hr:\u0022Identitet\u0022,cz:\u0022Identity\u0022,sk:\u0022Identity\u0022,gr:\u0022\u03A4\u03B1\u03C5\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u0022,ru:\u0022\u041B\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u0022,ko:\u0022Identity\u0022},uue={en:\u0022If you want to change your username, please contact me (Menu/Contact)\u0022,fr:\u0022Vous pouvez me contacter si vous souhaitez modifier votre nom d\u0027utilisateur (Menu/Contact)\u0022,es:\u0022If you want to change your username, please contact me (Menu/Contact)\u0022,cn:\u0022If you want to change your username, please contact me (Menu/Contact)\u0022,it:\u0022Se desideri cambiare il tuo nome utente, contattami (Menu/Contatto)\u0022,de:\u0022Wenn Sie Ihren Benutzernamen \u00E4ndern m\u00F6chten, kontaktieren Sie mich bitte (Men\u00FC/Kontakt)\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u5909\u66F4\u3057\u305F\u3044\u5834\u5408\u306F\u3001\u304A\u554F\u3044\u5408\u308F\u305B\u304F\u3060\u3055\u3044\uFF08\u30E1\u30CB\u30E5\u30FC/\u304A\u554F\u3044\u5408\u308F\u305B\uFF09\u0022,pl:\u0022If ty chcie\u0107 do zmie\u0144 your nazwa u\u017Cytkownika, prosz\u0119 kontakt me (Menu/Contact)\u0022,pt:\u0022Se voc\u00EA quiser mudar seu nome de usu\u00E1rio, entre em contato comigo (Menu/Contato)\u0022,hr:\u0022Ako \u017Eelite promijeniti korisni\u010Dko ime, molimo kontaktirajte me (Izbornik/Kontakt)\u0022,cz:\u0022If you want to change your username, please contact me (Menu/Contact)\u0022,sk:\u0022If you want to change your username, please contact me (Menu/Contact)\u0022,gr:\u0022\u0391\u03BB\u03BB\u03B1\u03B3\u03AE \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2\u0022,ru:\u0022\u0415\u0441\u043B\u0438 \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0451 \u04