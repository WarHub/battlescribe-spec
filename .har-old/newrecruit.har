4\u5217\u8868\u0022,it:\u0022La Mia Lista\u0022,de:\u0022Meine Liste\u0022,ja:\u0022\u30DE\u30A4\u30EA\u30B9\u30C8\u0022,pl:\u0022Moja Lista\u0022,pt:\u0022Minha Lista\u0022,hr:\u0022Moja Lista\u0022,cz:\u0022M\u016Fj Seznam\u0022,sk:\u0022M\u00F4j Zoznam\u0022,gr:\u0022\u0397 \u039B\u03AF\u03C3\u03C4\u03B1 \u039C\u03BF\u03C5\u0022,ru:\u0022\u041C\u043E\u0439 \u0421\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022\uB0B4 \uBA85\uB2E8\u0022},b5e={en:\u0022Opponent\u0027s List\u0022,fr:\u0022Liste de l\u0027Adversaire\u0022,es:\u0022Lista del Oponente\u0022,cn:\u0022\u5BF9\u624B\u5217\u8868\u0022,it:\u0022Lista dell\u0027Avversario\u0022,de:\u0022Gegnerliste\u0022,ja:\u0022\u5BFE\u6226\u76F8\u624B\u306E\u30EA\u30B9\u30C8\u0022,pl:\u0022Lista Przeciwnika\u0022,pt:\u0022Lista do Oponente\u0022,hr:\u0022Protivnikova Lista\u0022,cz:\u0022Seznam Soupe\u0159e\u0022,sk:\u0022Zoznam S\u00FApera\u0022,gr:\u0022\u039B\u03AF\u03C3\u03C4\u03B1 \u0391\u03BD\u03C4\u03B9\u03C0\u03AC\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u0022,ko:\u0022\uC0C1\uB300 \uBA85\uB2E8\u0022},v5e={en:\u0022Score Recap\u0022,fr:\u0022R\u00E9capitulatif des Points\u0022,es:\u0022Resumen de Puntuaci\u00F3n\u0022,cn:\u0022\u5F97\u5206\u6458\u8981\u0022,it:\u0022Riepilogo Punteggio\u0022,de:\u0022Punkte\u00FCbersicht\u0022,ja:\u0022\u30B9\u30B3\u30A2\u8981\u7D04\u0022,pl:\u0022Podsumowanie Punkt\u00F3w\u0022,pt:\u0022Resumo de Pontua\u00E7\u00E3o\u0022,hr:\u0022Pregled Rezultata\u0022,cz:\u0022P\u0159ehled Sk\u00F3re\u0022,sk:\u0022Preh\u013Ead Sk\u00F3re\u0022,gr:\u0022\u0391\u03BD\u03B1\u03BA\u03B5\u03C6\u03B1\u03BB\u03B1\u03AF\u03C9\u03C3\u03B7 \u03A3\u03BA\u03BF\u03C1\u0022,ru:\u0022\u0421\u0432\u043E\u0434\u043A\u0430 \u041E\u0447\u043A\u043E\u0432\u0022,ko:\u0022\uC810\uC218 \uC694\uC57D\u0022},k5e={en:\u0022Edit Notes\u0022,fr:\u0022Modifier les Notes\u0022,es:\u0022Editar Notas\u0022,cn:\u0022\u7F16\u8F91\u5907\u6CE8\u0022,it:\u0022Modifica Note\u0022,de:\u0022Notizen Bearbeiten\u0022,ja:\u0022\u30CE\u30FC\u30C8\u7DE8\u96C6\u0022,pl:\u0022Edytuj Notatki\u0022,pt:\u0022Editar Notas\u0022,hr:\u0022Uredi Bilje\u0161ke\u0022,cz:\u0022Upravit Pozn\u00E1mky\u0022,sk:\u0022Upravi\u0165 Pozn\u00E1mky\u0022,gr:\u0022\u0395\u03C0\u03B5\u03BE\u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03A3\u03B7\u03BC\u03B5\u03B9\u03CE\u03C3\u03B5\u03C9\u03BD\u0022,ru:\u0022\u0420\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0417\u0430\u043C\u0435\u0442\u043A\u0438\u0022,ko:\u0022\uBA54\uBAA8 \uD3B8\uC9D1\u0022},B5e={en:\u0022Combine Leaders with Units\u0022,fr:\u0022Combiner les Chefs avec les Unit\u00E9s\u0022,es:\u0022Combinar L\u00EDderes con Unidades\u0022,cn:\u0022\u5C06\u9886\u8896\u4E0E\u5355\u4F4D\u5408\u5E76\u0022,it:\u0022Combina Leader con Unit\u00E0\u0022,de:\u0022Anf\u00FChrer mit Einheiten Kombinieren\u0022,ja:\u0022\u30EA\u30FC\u30C0\u30FC\u3092\u30E6\u30CB\u30C3\u30C8\u3068\u7D71\u5408\u0022,pl:\u0022Po\u0142\u0105cz Przyw\u00F3dc\u00F3w z Jednostkami\u0022,pt:\u0022Combinar L\u00EDderes com Unidades\u0022,hr:\u0022Kombiniraj Vo\u0111e s Jedinicama\u0022,cz:\u0022Spojit V\u016Fdce s Jednotkami\u0022,sk:\u0022Spoji\u0165 Vodcov s Jednotkami\u0022,gr:\u0022\u03A3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CC\u03C2 \u0397\u03B3\u03B5\u03C4\u03CE\u03BD \u03BC\u03B5 \u039C\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2\u0022,ru:\u0022\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u041B\u0438\u0434\u0435\u0440\u043E\u0432 \u0441 \u041E\u0442\u0440\u044F\u0434\u0430\u043C\u0438\u0022,ko:\u0022\uC9C0\uB3C4\uC790\uB97C \uC720\uB2DB\uACFC \uACB0\uD569\u0022},C5e={en:\u0022Close Game\u0022,fr:\u0022Fermer la Partie\u0022,es:\u0022Cerrar Partida\u0022,cn:\u0022\u5173\u95ED\u6E38\u620F\u0022,it:\u0022Chiudi Partita\u0022,de:\u0022Spiel Schlie\u00DFen\u0022,ja:\u0022\u30B2\u30FC\u30E0\u3092\u9589\u3058\u308B\u0022,pl:\u0022Zamknij Gr\u0119\u0022,pt:\u0022Fechar Jogo\u0022,hr:\u0022Zatvori Igru\u0022,cz:\u0022Zav\u0159\u00EDt Hru\u0022,sk:\u0022Zatvori\u0165 Hru\u0022,gr:\u0022\u039A\u03BB\u03B5\u03AF\u03C3\u03B9\u03BC\u03BF \u03A0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0418\u0433\u0440\u0443\u0022,ko:\u0022\uAC8C\uC784 \uC885\uB8CC\u0022},_5e={en:\u0022You have not selected a list yet.\u0022,fr:\u0022Vous n\u0027avez pas encore s\u00E9lectionn\u00E9 de liste.\u0022,es:\u0022A\u00FAn no has seleccionado una lista.\u0022,cn:\u0022\u60A8\u5C1A\u672A\u9009\u62E9\u5217\u8868\u3002\u0022,it:\u0022Non hai ancora selezionato una lista.\u0022,de:\u0022Sie haben noch keine Liste ausgew\u00E4hlt.\u0022,ja:\u0022\u307E\u3060\u30EA\u30B9\u30C8\u3092\u9078\u629E\u3057\u3066\u3044\u307E\u305B\u3093\u3002\u0022,pl:\u0022Nie wybra\u0142e\u015B jeszcze listy.\u0022,pt:\u0022Voc\u00EA ainda n\u00E3o selecionou uma lista.\u0022,hr:\u0022Jo\u0161 niste odabrali listu.\u0022,cz:\u0022Je\u0161t\u011B jste nevybrali seznam.\u0022,sk:\u0022E\u0161te ste nevybrali zoznam.\u0022,gr:\u0022\u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03C4\u03B5 \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B1\u03BA\u03CC\u03BC\u03B1.\u0022,ru:\u0022\u0412\u044B \u0435\u0449\u0435 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u0441\u043F\u0438\u0441\u043E\u043A.\u0022,ko:\u0022\uC544\uC9C1 \uBA85\uB2E8\uC744 \uC120\uD0DD\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\u0022},S5e={en:\u0022Your opponent has not selected a list yet.\u0022,fr:\u0022Votre adversaire n\u0027a pas encore s\u00E9lectionn\u00E9 de liste.\u0022,es:\u0022Tu oponente a\u00FAn no ha seleccionado una lista.\u0022,cn:\u0022\u60A8\u7684\u5BF9\u624B\u5C1A\u672A\u9009\u62E9\u5217\u8868\u3002\u0022,it:\u0022Il tuo avversario non ha ancora selezionato una lista.\u0022,de:\u0022Ihr Gegner hat noch keine Liste ausgew\u00E4hlt.\u0022,ja:\u0022\u5BFE\u6226\u76F8\u624B\u306F\u307E\u3060\u30EA\u30B9\u30C8\u3092\u9078\u629E\u3057\u3066\u3044\u307E\u305B\u3093\u3002\u0022,pl:\u0022Tw\u00F3j przeciwnik jeszcze nie wybra\u0142 listy.\u0022,pt:\u0022Seu oponente ainda n\u00E3o selecionou uma lista.\u0022,hr:\u0022Va\u0161 protivnik jo\u0161 nije odabrao listu.\u0022,cz:\u0022V\u00E1\u0161 soupe\u0159 je\u0161t\u011B nevybral seznam.\u0022,sk:\u0022V\u00E1\u0161 s\u00FAper e\u0161te nevybral zoznam.\u0022,gr:\u0022\u039F \u03B1\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03CC\u03C2 \u03C3\u03B1\u03C2 \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B1\u03BA\u03CC\u03BC\u03B1.\u0022,ru:\u0022\u0412\u0430\u0448 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u0435\u0449\u0435 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043B \u0441\u043F\u0438\u0441\u043E\u043A.\u0022,ko:\u0022\uC0C1\uB300\uAC00 \uC544\uC9C1 \uBA85\uB2E8\uC744 \uC120\uD0DD\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\u0022},E5e={en:\u0022Select Challenger Card\u0022,fr:\u0022S\u00E9lectionner la Carte de D\u00E9fi\u0022,es:\u0022Seleccionar Carta de Desaf\u00EDo\u0022,cn:\u0022\u9009\u62E9\u6311\u6218\u8005\u5361\u0022,it:\u0022Seleziona Carta Sfida\u0022,de:\u0022Herausforderungskarte Ausw\u00E4hlen\u0022,ja:\u0022\u30C1\u30E3\u30EC\u30F3\u30B8\u30E3\u30FC\u30AB\u30FC\u30C9\u3092\u9078\u629E\u0022,pl:\u0022Wybierz Kart\u0119 Wyzwania\u0022,pt:\u0022Selecionar Carta de Desafio\u0022,hr:\u0022Odaberi Karticu Izazova\u0022,cz:\u0022Vybrat Kartu V\u00FDzvy\u0022,sk:\u0022Vybra\u0165 Kartu V\u00FDzvy\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u039A\u03AC\u03C1\u03C4\u03B1\u03C2 \u03A0\u03C1\u03CC\u03BA\u03BB\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u041A\u0430\u0440\u0442\u0443 \u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F\u0022,ko:\u0022\uB3C4\uC804\uC790 \uCE74\uB4DC \uC120\uD0DD\u0022},j5e={en:\u0022COMMAND POINTS\u0022,fr:\u0022POINTS DE COMMANDEMENT\u0022,es:\u0022PUNTOS DE MANDO\u0022,cn:\u0022\u6307\u6325\u70B9\u0022,it:\u0022PUNTI COMANDO\u0022,de:\u0022KOMMANDOPUNKTE\u0022,ja:\u0022\u30B3\u30DE\u30F3\u30C9\u30DD\u30A4\u30F3\u30C8\u0022,pl:\u0022PUNKTY DOWODZENIA\u0022,pt:\u0022PONTOS DE COMANDO\u0022,hr:\u0022ZAPOVJEDNE TO\u010CKE\u0022,cz:\u0022VEL\u00CDC\u00CD BODY\u0022,sk:\u0022VELIACIE BODY\u0022,gr:\u0022\u03A3\u0397\u039C\u0395\u0399\u0391 \u0394\u0399\u039F\u0399\u039A\u0397\u03A3\u0397\u03A3\u0022,ru:\u0022\u041E\u0427\u041A\u0418 \u041A\u041E\u041C\u0410\u041D\u0414\u041E\u0412\u0410\u041D\u0418\u042F\u0022,ko:\u0022\uC9C0\uD718 \uD3EC\uC778\uD2B8\u0022},z5e={en:\u0022Gained\u0022,fr:\u0022Gagn\u00E9s\u0022,es:\u0022Ganados\u0022,cn:\u0022\u83B7\u5F97\u0022,it:\u0022Guadagnati\u0022,de:\u0022Gewonnen\u0022,ja:\u0022\u7372\u5F97\u0022,pl:\u0022Zdobyte\u0022,pt:\u0022Ganhos\u0022,hr:\u0022Ste\u010Deno\u0022,cz:\u0022Z\u00EDskan\u00E9\u0022,sk:\u0022Z\u00EDskan\u00E9\u0022,gr:\u0022\u039A\u03B5\u03C1\u03B4\u03B9\u03C3\u03BC\u03AD\u03BD\u03B1\u0022,ru:\u0022\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043E\u0022,ko:\u0022\uD68D\uB4DD\u0022},I5e={en:\u0022Spent\u0022,fr:\u0022D\u00E9pens\u00E9s\u0022,es:\u0022Gastados\u0022,cn:\u0022\u6D88\u8017\u0022,it:\u0022Spesi\u0022,de:\u0022Ausgegeben\u0022,ja:\u0022\u6D88\u8CBB\u0022,pl:\u0022Wydane\u0022,pt:\u0022Gastos\u0022,hr:\u0022Potro\u0161eno\u0022,cz:\u0022Utracen\u00E9\u0022,sk:\u0022Utraten\u00E9\u0022,gr:\u0022\u039E\u03BF\u03B4\u03B5\u03C5\u03BC\u03AD\u03BD\u03B1\u0022,ru:\u0022\u041F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043E\u0022,ko:\u0022\uC18C\uBE44\u0022},P5e={en:\u0022cp\u0022,fr:\u0022pc\u0022,es:\u0022pm\u0022,cn:\u0022\u6307\u6325\u70B9\u0022,it:\u0022pc\u0022,de:\u0022kp\u0022,ja:\u0022cp\u0022,pl:\u0022pd\u0022,pt:\u0022pc\u0022,hr:\u0022zt\u0022,cz:\u0022vb\u0022,sk:\u0022vb\u0022,gr:\u0022\u03C3\u03B4\u0022,ru:\u0022ok\u0022,ko:\u0022cp\u0022},T5e={en:\u0022Stratagems\u0022,fr:\u0022Stratag\u00E8mes\u0022,es:\u0022Estratagemas\u0022,cn:\u0022\u6218\u7565\u0022,it:\u0022Stratagemmi\u0022,de:\u0022Kriegslisten\u0022,ja:\u0022\u30B9\u30C8\u30E9\u30BF\u30B8\u30A7\u30E0\u0022,pl:\u0022Fortel\u0022,pt:\u0022Estratagemas\u0022,hr:\u0022Strategije\u0022,cz:\u0022Strategie\u0022,sk:\u0022Strat\u00E9gie\u0022,gr:\u0022\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1\u0022,ru:\u0022\u0421\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u044B\u0022,ko:\u0022\uC804\uB7B5\u0022},N5e={en:\u0022Full stratagem list included (not just those usable by this unit) because Wahapedia is not updated yet.\u0022,fr:\u0022Liste compl\u00E8te des stratag\u00E8mes incluse (pas seulement ceux utilisables par cette unit\u00E9) car Wahapedia n\u0027est pas encore mis \u00E0 jour.\u0022,es:\u0022Lista completa de estratagemas incluida (no solo los utilizables por esta unidad) porque Wahapedia a\u00FAn no est\u00E1 actualizado.\u0022,cn:\u0022\u5305\u542B\u5B8C\u6574\u6218\u7565\u5217\u8868\uFF08\u4E0D\u4EC5\u4EC5\u662F\u8BE5\u5355\u4F4D\u53EF\u7528\u7684\uFF09\u56E0\u4E3AWahapedia\u5C1A\u672A\u66F4\u65B0\u3002\u0022,it:\u0022Elenco completo degli stratagemmi incluso (non solo quelli utilizzabili da questa unit\u00E0) perch\u00E9 Wahapedia non \u00E8 ancora aggiornato.\u0022,de:\u0022Vollst\u00E4ndige Kriegslisten-Liste enthalten (nicht nur die von dieser Einheit verwendbaren), da Wahapedia noch nicht aktualisiert ist.\u0022,ja:\u0022Wahapedia\u304C\u307E\u3060\u66F4\u65B0\u3055\u308C\u3066\u3044\u306A\u3044\u305F\u3081\u3001\u5B8C\u5168\u306A\u30B9\u30C8\u30E9\u30BF\u30B8\u30A7\u30E0\u30EA\u30B9\u30C8\u304C\u542B\u307E\u308C\u3066\u3044\u307E\u3059\uFF08\u3053\u306E\u30E6\u30CB\u30C3\u30C8\u3067\u4F7F\u7528\u53EF\u80FD\u306A\u3082\u306E\u306E\u307F\u3067\u306F\u3042\u308A\u307E\u305B\u3093\uFF09\u3002\u0022,pl:\u0022Do\u0142\u0105czono pe\u0142n\u0105 list\u0119 forteli (nie tylko tych mo\u017Cliwych do u\u017Cycia przez t\u0119 jednostk\u0119), poniewa\u017C Wahapedia nie jest jeszcze zaktualizowana.\u0022,pt:\u0022Lista completa de estratagemas inclu\u00EDda (n\u00E3o apenas aqueles utiliz\u00E1veis por esta unidade) porque o Wahapedia ainda n\u00E3o foi atualizado.\u0022,hr:\u0022Uklju\u010Dena je puna lista strategija (ne samo one koje mo\u017Ee koristiti ova jedinica) jer Wahapedia jo\u0161 nije a\u017Eurirana.\u0022,cz:\u0022Zahrnut\u00FD \u00FApln\u00FD seznam strategi\u00ED (nejen t\u011Bch pou\u017Eiteln\u00FDch touto jednotkou), proto\u017Ee Wahapedia je\u0161t\u011B nen\u00ED aktualizov\u00E1na.\u0022,sk:\u0022Zahrnut\u00FD \u00FApln\u00FD zoznam strat\u00E9gi\u00ED (nielen t\u00FDch pou\u017Eite\u013En\u00FDch touto jednotkou), preto\u017Ee Wahapedia e\u0161te nie je aktualizovan\u00E1.\u0022,gr:\u0022\u03A0\u03B5\u03C1\u03B9\u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B7\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD (\u03CC\u03C7\u03B9 \u03BC\u03CC\u03BD\u03BF \u03B1\u03C5\u03C4\u03AC \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9 \u03B1\u03C5\u03C4\u03AE \u03B7 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1) \u03B5\u03C0\u03B5\u03B9\u03B4\u03AE \u03C4\u03BF Wahapedia \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03C9\u03B8\u03B5\u03AF \u03B1\u03BA\u03CC\u03BC\u03B1.\u0022,ru:\u0022\u0412\u043A\u043B\u044E\u0447\u0435\u043D \u043F\u043E\u043B\u043D\u044B\u0439 \u0441\u043F\u0438\u0441\u043E\u043A \u0441\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C (\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u044D\u0442\u0438\u043C \u043E\u0442\u0440\u044F\u0434\u043E\u043C), \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E Wahapedia \u0435\u0449\u0435 \u043D\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0430.\u0022,ko:\u0022Wahapedia\uAC00 \uC544\uC9C1 \uC5C5\uB370\uC774\uD2B8\uB418\uC9C0 \uC54A\uC558\uAE30 \uB54C\uBB38\uC5D0 \uC804\uCCB4 \uC804\uB7B5 \uBAA9\uB85D\uC774 \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4(\uC774 \uC720\uB2DB\uC5D0\uC11C \uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uAC83\uB9CC\uC774 \uC544\uB2D9\uB2C8\uB2E4).\u0022},F5e={en:\u0022Stratagems powered by Wahapedia\u0022,fr:\u0022Stratag\u00E8mes fournis par Wahapedia\u0022,es:\u0022Estratagemas proporcionadas por Wahapedia\u0022,cn:\u0022\u6218\u7565\u7531Wahapedia\u63D0\u4F9B\u0022,it:\u0022Stratagemmi forniti da Wahapedia\u0022,de:\u0022Kriegslisten bereitgestellt von Wahapedia\u0022,ja:\u0022\u30B9\u30C8\u30E9\u30BF\u30B8\u30A7\u30E0\u306FWahapedia\u306B\u3088\u3063\u3066\u63D0\u4F9B\u0022,pl:\u0022Fortele dostarczone przez Wahapedia\u0022,pt:\u0022Estratagemas fornecidos pelo Wahapedia\u0022,hr:\u0022Strategije omogu\u0107ene pomo\u0107u Wahapedia\u0022,cz:\u0022Strategie poskytnut\u00E9 Wahapedi\u00ED\u0022,sk:\u0022Strat\u00E9gie poskytnut\u00E9 Wahapediou\u0022,gr:\u0022\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1 \u03C0\u03B1\u03C1\u03AD\u03C7\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF Wahapedia\u0022,ru:\u0022\u0421\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B Wahapedia\u0022,ko:\u0022Wahapedia\uC5D0\uC11C \uC81C\uACF5\uD558\uB294 \uC804\uB7B5\u0022},R5e={en:\u0022Please select a Detachment to enable Stratagems\u0022,fr:\u0022Veuillez s\u00E9lectionner un D\u00E9tachement pour activer les Stratag\u00E8mes\u0022,es:\u0022Por favor selecciona un Destacamento para habilitar Estratagemas\u0022,cn:\u0022\u8BF7\u9009\u62E9\u4E00\u4E2A\u5206\u961F\u4EE5\u542F\u7528\u6218\u7565\u0022,it:\u0022Seleziona un Distaccamento per abilitare gli Stratagemmi\u0022,de:\u0022Bitte w\u00E4hlen Sie ein Kontingent aus, um Kriegslisten zu aktivieren\u0022,ja:\u0022\u30B9\u30C8\u30E9\u30BF\u30B8\u30A7\u30E0\u3092\u6709\u52B9\u306B\u3059\u308B\u306B\u306F\u3001\u30C7\u30BF\u30C3\u30C1\u30E1\u30F3\u30C8\u3092\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u0022,pl:\u0022Wybierz Oddzia\u0142, aby w\u0142\u0105czy\u0107 Fortele\u0022,pt:\u0022Selecione um Destacamento para habilitar Estratagemas\u0022,hr:\u0022Molimo odaberite Odjeljenje da biste omogu\u0107ili Strategije\u0022,cz:\u0022Vyberte pros\u00EDm Odd\u00EDl pro aktivaci Strategi\u00ED\u0022,sk:\u0022Vyberte pros\u00EDm Oddiel na aktiv\u00E1ciu Strat\u00E9gi\u00ED\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u0391\u03C0\u03CC\u03C3\u03C0\u03B1\u03C3\u03BC\u03B1 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03B1 \u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1\u0022,ru:\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u041E\u0442\u0440\u044F\u0434 \u0434\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u0421\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u0022,ko:\u0022\uC804\uB7B5\uC744 \uD65C\uC131\uD654\uD558\uB824\uBA74 \uBD84\uACAC\uB300\uB97C \uC120\uD0DD\uD558\uC138\uC694\u0022},M5e={en:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EStratagems\u003C/strong\u003E! \u0027,fr:\u0027Soutenez New Recruit pour d\u00E9bloquer les \u003Cstrong class=\u0022blue\u0022\u003EStratag\u00E8mes\u003C/strong\u003E ! \u0027,es:\u0027\u00A1Apoya a New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EEstratagemas\u003C/strong\u003E! \u0027,cn:\u0027\u652F\u6301New Recruit\u4EE5\u89E3\u9501\u003Cstrong class=\u0022blue\u0022\u003E\u6218\u7565\u003C/strong\u003E\uFF01\u0027,it:\u0027Supporta New Recruit per sbloccare gli \u003Cstrong class=\u0022blue\u0022\u003EStratagemmi\u003C/strong\u003E! \u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um \u003Cstrong class=\u0022blue\u0022\u003EKriegslisten\u003C/strong\u003E freizuschalten! \u0027,ja:\u0027New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u30B9\u30C8\u30E9\u30BF\u30B8\u30A7\u30E0\u003C/strong\u003E\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby odblokowa\u0107 \u003Cstrong class=\u0022blue\u0022\u003EFortele\u003C/strong\u003E! \u0027,pt:\u0027Apoie New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EEstratagemas\u003C/strong\u003E! \u0027,hr:\u0027Podr\u017Eite New Recruit da otklju\u010Date \u003Cstrong class=\u0022blue\u0022\u003EStrategije\u003C/strong\u003E! \u0027,cz:\u0027Podpo\u0159te New Recruit a odemkn\u011Bte \u003Cstrong class=\u0022blue\u0022\u003EStrategie\u003C/strong\u003E! \u0027,sk:\u0027Podporte New Recruit a odomknite \u003Cstrong class=\u0022blue\u0022\u003EStrat\u00E9gie\u003C/strong\u003E! \u0027,gr:\u0027\u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03C4\u03B5 \u03C4\u03BF New Recruit \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03B1 \u003Cstrong class=\u0022blue\u0022\u003E\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1\u003C/strong\u003E! \u0027,ru:\u0027\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0442\u0435 New Recruit, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u003Cstrong class=\u0022blue\u0022\u003E\u0421\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u044B\u003C/strong\u003E! \u0027,ko:\u0027New Recruit\uB97C \uC9C0\uC6D0\uD558\uC5EC \u003Cstrong class=\u0022blue\u0022\u003E\uC804\uB7B5\u003C/strong\u003E\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694! \u0027},U5e={en:\u0022You\u0022,fr:\u0022Vous\u0022,es:\u0022T\u00FA\u0022,cn:\u0022\u4F60\u0022,it:\u0022Tu\u0022,de:\u0022Sie\u0022,ja:\u0022\u3042\u306A\u305F\u0022,pl:\u0022Ty\u0022,pt:\u0022Voc\u00EA\u0022,hr:\u0022Vi\u0022,cz:\u0022Vy\u0022,sk:\u0022Vy\u0022,gr:\u0022\u0395\u03C3\u03B5\u03AF\u03C2\u0022,ru:\u0022\u0412\u044B\u0022,ko:\u0022\uB2F9\uC2E0\u0022},x5e={en:\u0022Opponent\u0022,fr:\u0022Adversaire\u0022,es:\u0022Oponente\u0022,cn:\u0022\u5BF9\u624B\u0022,it:\u0022Avversario\u0022,de:\u0022Gegner\u0022,ja:\u0022\u5BFE\u6226\u76F8\u624B\u0022,pl:\u0022Przeciwnik\u0022,pt:\u0022Oponente\u0022,hr:\u0022Protivnik\u0022,cz:\u0022Soupe\u0159\u0022,sk:\u0022S\u00FAper\u0022,gr:\u0022\u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03BF\u03C2\u0022,ru:\u0022\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0022,ko:\u0022\uC0C1\uB300\u0022},Q5e={en:\u0022Objective\u0022,fr:\u0022Objectif\u0022,es:\u0022Objetivo\u0022,cn:\u0022\u76EE\u6807\u0022,it:\u0022Obiettivo\u0022,de:\u0022Ziel\u0022,ja:\u0022\u76EE\u6A19\u0022,pl:\u0022Cel\u0022,pt:\u0022Objetivo\u0022,hr:\u0022Cilj\u0022,cz:\u0022C\u00EDl\u0022,sk:\u0022Cie\u013E\u0022,gr:\u0022\u03A3\u03C4\u03CC\u03C7\u03BF\u03C2\u0022,ru:\u0022\u0426\u0435\u043B\u044C\u0022,ko:\u0022\uBAA9\uD45C\u0022},L5e={en:\u0022Total\u0022,fr:\u0022Total\u0022,es:\u0022Total\u0022,cn:\u0022\u603B\u8BA1\u0022,it:\u0022Totale\u0022,de:\u0022Gesamt\u0022,ja:\u0022\u5408\u8A08\u0022,pl:\u0022Suma\u0022,pt:\u0022Total\u0022,hr:\u0022Ukupno\u0022,cz:\u0022Celkem\u0022,sk:\u0022Celkom\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03BF\u03BB\u03BF\u0022,ru:\u0022\u0418\u0442\u043E\u0433\u043E\u0022,ko:\u0022\uD569\uACC4\u0022},D5e={en:\u0022Battle Ready\u0022,fr:\u0022Pr\u00EAt au Combat\u0022,es:\u0022Listo para Batalla\u0022,cn:\u0022\u6218\u6597\u51C6\u5907\u0022,it:\u0022Pronto alla Battaglia\u0022,de:\u0022Kampfbereit\u0022,ja:\u0022\u6226\u95D8\u6E96\u5099\u5B8C\u4E86\u0022,pl:\u0022Gotowy do Bitwy\u0022,pt:\u0022Pronto para Batalha\u0022,hr:\u0022Spreman za Bitku\u0022,cz:\u0022P\u0159ipraven k Boji\u0022,sk:\u0022Pripraven\