rnament Management\u0022},ole={en:\u0022Status\u0022,fr:\u0022Etat\u0022,es:\u0022Estado\u0022,cn:\u0022\u72B6\u6001\u0022,it:\u0022Stato\u0022,de:\u0022Status\u0022,ja:\u0022\u30B9\u30C6\u30FC\u30BF\u30B9\u0022,pl:\u0022Status\u0022,pt:\u0022Status\u0022,hr:\u0022Status\u0022,cz:\u0022Status\u0022,sk:\u0022Status\u0022,gr:\u0022\u039A\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u0022,ru:\u0022\u0421\u0442\u0430\u0442\u0443\u0441\u0022,ko:\u0022\uC0C1\uD0DC\u0022},ale={en:\u0022Visibility\u0022,fr:\u0022Visibilit\u00E9\u0022,es:\u0022Visibility\u0022,cn:\u0022Visibility\u0022,it:\u0022Visibilit\u00E0\u0022,de:\u0022Sichtbarkeit\u0022,ja:\u0022\u8868\u793A\u8A2D\u5B9A\u0022,pl:\u0022Widoczno\u015B\u0107\u0022,pt:\u0022Visibilidade\u0022,hr:\u0022Vidljivost\u0022,cz:\u0022Visibility\u0022,sk:\u0022Visibility\u0022,gr:\u0022\u039F\u03C1\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C\u0022,ko:\u0022Visibility\u0022},lle={en:\u0022Publish player lists\u0022,fr:\u0022Publier les listes\u0022,es:\u0022Publish player lists\u0022,cn:\u0022Publish player lists\u0022,it:\u0022Pubblica liste giocatori\u0022,de:\u0022Spielerlisten Ver\u00F6ffentlichen\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u30EA\u30B9\u30C8\u516C\u958B\u0022,pl:\u0022Opublikuj listy graczy\u0022,pt:\u0022Publicar listas de jogadores\u0022,hr:\u0022Objavi popise igra\u010Da\u0022,cz:\u0022Publish player lists\u0022,sk:\u0022Publish player lists\u0022,gr:\u0022\u0394\u03B7\u03BC\u03BF\u03C3\u03AF\u03B5\u03C5\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u041E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0441\u043F\u0438\u0441\u043A\u0438 \u0438\u0433\u0440\u043E\u043A\u043E\u0432\u0022,ko:\u0022Publish player lists\u0022},ule={en:\u0022Receive Discord notifications\u0022,fr:\u0022Recevoir des notifications Discord\u0022,es:\u0022Receive Discord notifications\u0022,cn:\u0022Receive Discord notifications\u0022,it:\u0022Ricevi notifiche Discord\u0022,de:\u0022Discord-Benachrichtigungen Erhalten\u0022,ja:\u0022Discord\u901A\u77E5\u3092\u53D7\u4FE1\u0022,pl:\u0022Odbieraj powiadomienia Discord\u0022,pt:\u0022Receber notifica\u00E7\u00F5es do Discord\u0022,hr:\u0022Primi Discord obavijesti\u0022,cz:\u0022Receive Discord notifications\u0022,sk:\u0022Receive Discord notifications\u0022,gr:\u0022\u039B\u03AE\u03C8\u03B7 \u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C9\u03BD Discord\u0022,ru:\u0022\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F Discord \u043E \u043C\u0430\u0442\u0447\u0430\u0445 \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,ko:\u0022Receive Discord notifications\u0022},cle={en:\u0022Tournament Admins\u0022,fr:\u0022Admins de Tournoi\u0022,es:\u0022Tournament Admins\u0022,cn:\u0022Tournament Admins\u0022,it:\u0022Amministratori Torneo\u0022,de:\u0022Turnierverwalter\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7BA1\u7406\u8005\u0022,pl:\u0022Administratorzy Turnieju\u0022,pt:\u0022Administradores do Torneio\u0022,hr:\u0022Administratori turnira\u0022,cz:\u0022Tournament Admins\u0022,sk:\u0022Tournament Admins\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u044B\u0022,ko:\u0022Tournament Admins\u0022},Ale={en:\u0022Export Lists\u0022,fr:\u0022Exporter Listes\u0022,es:\u0022Export Lists\u0022,cn:\u0022Export Lists\u0022,it:\u0022Esporta Liste\u0022,de:\u0022Listen Exportieren\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3092\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u0022,pl:\u0022Eksportuj Listy\u0022,pt:\u0022Exportar Listas\u0022,hr:\u0022Izvezi popise\u0022,cz:\u0022Export Lists\u0022,sk:\u0022Export Lists\u0022,gr:\u0022\u0395\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0421\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022Export Lists\u0022},dle={en:\u0022Tournament Link\u0022,fr:\u0022Lien vers le Tournoi\u0022,es:\u0022Tournament Link\u0022,cn:\u0022Tournament Link\u0022,it:\u0022Link Torneo\u0022,de:\u0022Turnierlink\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30EA\u30F3\u30AF\u0022,pl:\u0022Link do Turnieju\u0022,pt:\u0022Link do Torneio\u0022,hr:\u0022Link turnira\u0022,cz:\u0022Tournament Link\u0022,sk:\u0022Tournament Link\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03B4\u03B5\u03C3\u03BC\u03BF\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0421\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \u0442\u0443\u0440\u043D\u0438\u0440\u0022,ko:\u0022Tournament Link\u0022},fle={en:\u0022Pending\u0022,fr:\u0022En pr\u00E9paration\u0022,es:\u0022Pending\u0022,cn:\u0022Pending\u0022,it:\u0022In attesa\u0022,de:\u0022Ausstehend\u0022,ja:\u0022\u4FDD\u7559\u4E2D\u0022,pl:\u0022Oczekuj\u0105ce\u0022,pt:\u0022Pendente\u0022,hr:\u0022Na \u010Dekanju\u0022,cz:\u0022Pending\u0022,sk:\u0022\u010Cak\u00E1 sa\u0022,gr:\u0022\u03A3\u03B5 \u0395\u03BA\u03BA\u03C1\u03B5\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u0022,ru:\u0022\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435\u0022,ko:\u0022Pending\u0022},ple={en:\u0022Open\u0022,fr:\u0022Ouvert\u0022,es:\u0022Open\u0022,cn:\u0022Open\u0022,it:\u0022Aperto\u0022,de:\u0022\u00D6ffnen\u0022,ja:\u0022\u958B\u304F\u0022,pl:\u0022Otwarty\u0022,pt:\u0022Aberto\u0022,hr:\u0022Otvoreno\u0022,cz:\u0022Otev\u0159\u00EDt\u0022,sk:\u0022Otvori\u0165\u0022,gr:\u0022\u0386\u03BD\u03BF\u03B9\u03B3\u03BC\u03B1\u0022,ru:\u0022\u041E\u0442\u043A\u0440\u044B\u0442\u044C\u0022,ko:\u0022\uC5F4\uAE30\u0022},hle={en:\u0022Ongoing\u0022,fr:\u0022En cours\u0022,es:\u0022Ongoing\u0022,cn:\u0022Ongoing\u0022,it:\u0022In Corso\u0022,de:\u0022Laufend\u0022,ja:\u0022\u9032\u884C\u4E2D\u0022,pl:\u0022W trakcie\u0022,pt:\u0022Em Andamento\u0022,hr:\u0022U tijeku\u0022,cz:\u0022Ongoing\u0022,sk:\u0022Ongoing\u0022,gr:\u0022\u03A3\u03B5 \u03B5\u03BE\u03AD\u03BB\u03B9\u03BE\u03B7\u0022,ru:\u0022\u0418\u0434\u0451\u0442\u0022,ko:\u0022Ongoing\u0022},mle={en:\u0022Closed\u0022,fr:\u0022Ferm\u00E9\u0022,es:\u0022Closed\u0022,cn:\u0022Closed\u0022,it:\u0022Chiuso\u0022,de:\u0022Geschlossen\u0022,ja:\u0022\u7D42\u4E86\u0022,pl:\u0022Zamkni\u0119ty\u0022,pt:\u0022Encerrado\u0022,hr:\u0022Zatvoreno\u0022,cz:\u0022Closed\u0022,sk:\u0022Closed\u0022,gr:\u0022\u039A\u03BB\u03B5\u03B9\u03C3\u03C4\u03CC\u0022,ru:\u0022\u0417\u0430\u043A\u0440\u044B\u0442\u0022,ko:\u0022Closed\u0022},gle={en:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022,fr:\u0022\u003Cb\u003EEn pr\u00E9paration\u003C/b\u003E: Le tournoi est en pr\u00E9paration, personne ne peut le voir.\u003Cbr /\u003E \u003Cb\u003EOuvert\u003C/b\u003E: Le tournoi est ouvert, les joueurs peuvent s\u0027inscrire.\u003Cbr /\u003E \u003Cb\u003EEn cours\u003C/b\u003E: Le tournoi a commenc\u00E9, les joueurs ne peuvent plus s\u0027inscrire. Les paires sont visibles et les joueurs peuvent envoyer les r\u00E9sultats de leur matchs. \u003Cbr /\u003E \u003Cb\u003EFerm\u00E9\u003C/b\u003E: Le tournoi est termin\u00E9, il n\u0027est plus possible d\u0027envoyer de r\u00E9sultats de match, les r\u00E9sutats du tournoi restent visibles.\u0022,es:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022,cn:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022,it:\u0022\u003Cb\u003EIn Attesa\u003C/b\u003E: Torneo ancora in preparazione, nessuno pu\u00F2 vederlo.\u003Cbr /\u003E \u003Cb\u003EAperto\u003C/b\u003E: Torneo aperto, i giocatori possono iscriversi.\u003Cbr /\u003E \u003Cb\u003EIn Corso\u003C/b\u003E: Torneo iniziato, i giocatori non possono pi\u00F9 iscriversi. Gli accoppiamenti saranno visibili e i giocatori possono riportare i risultati delle partite. \u003Cbr /\u003E \u003Cb\u003EChiuso\u003C/b\u003E: Torneo terminato, non \u00E8 pi\u00F9 possibile inviare risultati delle partite, i risultati e gli accoppiamenti rimangono visibili.\u0022,de:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022,ja:\u0022\u003Cb\u003E\u4FDD\u7559\u4E2D\u003C/b\u003E: \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u307E\u3060\u6E96\u5099\u4E2D\u3067\u3001\u8AB0\u3082\u898B\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u305B\u3093\u3002\u003Cbr /\u003E \u003Cb\u003E\u516C\u958B\u003C/b\u003E: \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u516C\u958B\u3055\u308C\u3066\u304A\u308A\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u53C2\u52A0\u3067\u304D\u307E\u3059\u3002\u003Cbr /\u003E \u003Cb\u003E\u9032\u884C\u4E2D\u003C/b\u003E: \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u304C\u958B\u59CB\u3055\u308C\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u53C2\u52A0\u3067\u304D\u306A\u304F\u306A\u308A\u307E\u3057\u305F\u3002\u30DA\u30A2\u30EA\u30F3\u30B0\u304C\u8868\u793A\u3055\u308C\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u8A66\u5408\u7D50\u679C\u3092\u5831\u544A\u3067\u304D\u307E\u3059\u3002\u003Cbr /\u003E \u003Cb\u003E\u7D42\u4E86\u003C/b\u003E: \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u304C\u7D42\u4E86\u3057\u3001\u8A66\u5408\u30EC\u30DD\u30FC\u30C8\u306F\u9001\u4FE1\u3067\u304D\u306A\u304F\u306A\u308A\u307E\u3057\u305F\u304C\u3001\u7D50\u679C\u3068\u30DA\u30A2\u30EA\u30F3\u30B0\u306F\u8868\u793A\u3055\u308C\u305F\u307E\u307E\u3067\u3059\u3002\u0022,pl:\u0022\u003Cb\u003EOczekuj\u0105cy\u003C/b\u003E: Turniej wci\u0105\u017C w przygotowaniu, nikt nie mo\u017Ce go zobaczy\u0107.\u003Cbr /\u003E \u003Cb\u003EOtwarty\u003C/b\u003E: Turniej jest otwarty, gracze mog\u0105 do\u0142\u0105czy\u0107.\u003Cbr /\u003E \u003Cb\u003EW trakcie\u003C/b\u003E: Turniej si\u0119 rozpocz\u0105\u0142, gracze nie mog\u0105 ju\u017C do\u0142\u0105czy\u0107. Parowania b\u0119d\u0105 widoczne i gracze mog\u0105 zg\u0142asza\u0107 wyniki mecz\u00F3w. \u003Cbr /\u003E \u003Cb\u003EZamkni\u0119ty\u003C/b\u003E: Turniej si\u0119 zako\u0144czy\u0142, raporty mecz\u00F3w nie mog\u0105 by\u0107 ju\u017C przesy\u0142ane, Wyniki i Parowania pozostaj\u0105 widoczne.\u0022,pt:\u0022\u003Cb\u003EPendente\u003C/b\u003E: Torneio ainda em prepara\u00E7\u00E3o, ningu\u00E9m pode v\u00EA-lo.\u003Cbr /\u003E \u003Cb\u003EAberto\u003C/b\u003E: Torneio est\u00E1 aberto para que os jogadores possam participar.\u003Cbr /\u003E \u003Cb\u003EEm Andamento\u003C/b\u003E: O torneio come\u00E7ou, os jogadores n\u00E3o podem mais participar. Os emparelhamentos estar\u00E3o vis\u00EDveis e os jogadores podem relatar resultados das partidas. \u003Cbr /\u003E \u003Cb\u003EEncerrado\u003C/b\u003E: O torneio terminou, os relat\u00F3rios de partidas n\u00E3o podem mais ser enviados, os Resultados e Emparelhamentos permanecem vis\u00EDveis.\u0022,hr:\u0022\u003Cb\u003ENa \u010Dekanju\u003C/b\u003E: Turnir je jo\u0161 u pripremi, nitko ga ne mo\u017Ee vidjeti.\u003Cbr /\u003E \u003Cb\u003EOtvoreno\u003C/b\u003E: Turnir je otvoren tako da se igra\u010Di mogu prijaviti.\u003Cbr /\u003E \u003Cb\u003EU tijeku\u003C/b\u003E: Turnir je po\u010Deo, igra\u010Di se vi\u0161e ne mogu prijaviti. Uparivanja \u0107e biti vidljiva i igra\u010Di mogu prijaviti rezultate me\u010Deva. \u003Cbr /\u003E \u003Cb\u003EZatvoreno\u003C/b\u003E: Turnir je zavr\u0161io, izvje\u0161taji o me\u010Devima se vi\u0161e ne mogu slati, rezultati i uparivanja ostaju vidljivi.\u0022,cz:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022,sk:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022,gr:\u0022\u039A\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u0022,ru:\u0022\u003Cb\u003E\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435\u003C/b\u003E: \u0422\u0443\u0440\u043D\u0438\u0440 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0432 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0435, \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u0442\u044C.\u003Cbr /\u003E \u003Cb\u003E\u041E\u0442\u043A\u0440\u044B\u0442\u003C/b\u003E: \u0422\u0443\u0440\u043D\u0438\u0440 \u043E\u0442\u043A\u0440\u044B\u0442, \u0438\u0433\u0440\u043E\u043A\u0438 \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F.\u003Cbr /\u003E \u003Cb\u003E\u0418\u0434\u0451\u0442\u003C/b\u003E: \u0422\u0443\u0440\u043D\u0438\u0440 \u043D\u0430\u0447\u0430\u043B\u0441\u044F, \u0438\u0433\u0440\u043E\u043A\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F. \u041F\u0430\u0440\u044B \u0431\u0443\u0434\u0443\u0442 \u0432\u0438\u0434\u043D\u044B, \u0438 \u0438\u0433\u0440\u043E\u043A\u0438 \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u043E\u0431\u0449\u0430\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u043C\u0430\u0442\u0447\u0435\u0439. \u003Cbr /\u003E \u003Cb\u003E\u0417\u0430\u043A\u0440\u044B\u0442\u003C/b\u003E: \u0422\u0443\u0440\u043D\u0438\u0440 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D, \u043E\u0442\u0447\u0451\u0442\u044B \u043E \u043C\u0430\u0442\u0447\u0430\u0445 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B, \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0438 \u043F\u0430\u0440\u044B \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0432\u0438\u0434\u0438\u043C\u044B\u043C\u0438.\u0022,ko:\u0022\u003Cb\u003EPending\u003C/b\u003E: Tournament still in preparation, nobody can see it.\u003Cbr /\u003E \u003Cb\u003EOpen\u003C/b\u003E: Tournament is open so players can join.\u003Cbr /\u003E \u003Cb\u003EOngoing\u003C/b\u003E: Tournament has started, players cannot join anymore. Pairings will be visible and players can report match results. \u003Cbr /\u003E \u003Cb\u003EClosed\u003C/b\u003E: Tournament ended, match reports cannot be submitted anymore, Results and Pairings remain visible.\u0022},yle={en:\u0022Public tournaments will be displayed in the public tournament lists.\u003Cbr /\u003EPrivate tournaments are hidden and you will have to send players the tournament link.\u0022,fr:\u0022Les Tournois Publics sont affich\u00E9s dans la liste des tournois publics.\u003Cbr /\u003E Les Tournois Priv\u00E9s sont invisibles et il faut envoyer le lien directement aux participants pour qu\u0027ils puissent s\u0027inscrire.\u0022,es:\u0022Public tournaments will be displayed in the public tournament lists.\u003Cbr /\u003EPrivate tournaments are hidden and you will have to send players the tournament link.\u0022,cn:\u0022Public tournaments will be displayed in the public tournament lists.\u003Cbr /\u003EPrivate tournaments are hidden and you will have to send players the tournament link.\u0022,it:\u0022I tornei pubblici saranno visualizzati negli elenchi dei tornei pubblici.\u003Cbr /\u003EI tornei privati sono nascosti e dovrai inviare ai giocatori il link del torneo.\u0022,de:\u0022\u00D6ffentliche Turniere werden in den \u00F6ffentlichen Turnierlisten angezeigt.\u003Cbr /\u003EPrivate Turniere sind verborgen und Sie m\u00FCssen den Spielern den Turnierlink senden.\u0022,ja:\u0022\u516C\u958B\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u516C\u958B\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30EA\u30B9\u30C8\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002\u003Cbr /\u003E\u975E\u516C\u958B\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u975E\u8868\u793A\u306B\u306A\u308A\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30EA\u30F3\u30AF\u3092\u9001\u4FE1\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Publiczne turnieje b\u0119d\u0105 wy\u015Bwietlane na li\u015Bcie publicznych turniej\u00F3w.\u003Cbr /\u003EPrywatne turnieje s\u0105 ukryte i b\u0119dziesz musia\u0142 wys\u0142a\u0107 graczom link do turnieju.\u0022,pt:\u0022Torneios p\u00FAblicos ser\u00E3o exibidos nas listas de torneios p\u00FAblicos.\u003Cbr /\u003ETorneios privados est\u00E3o ocultos e voc\u00EA ter\u00E1 que enviar aos jogadores o link do torneio.\u0022,hr:\u0022Javni turniri \u0107e biti prikazani na javnim popisima turnira.\u003Cbr /\u003EPrivatni turniri su skriveni i morat \u0107ete poslati igra\u010Dima link turnira.\u0022,cz:\u0022Public tournaments will be displayed in the public tournament lists.\u003Cbr /\u003EPrivate tournaments are hidden and you will have to send players the tournament link.\u0022,sk:\u0022Public tournaments will be displayed in the public tournament lists.\u003Cbr /\u003EPrivate tournaments are hidden and you will have to send players the tournament link.\u0022,gr:\u0022\u039F\u03C1\u03B1\u03C4\u03CC\u03C4\u03B7\u03C4\u03B1\u0022,ru:\u0022\u041F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0435 \u0442\u0443\u0440\u043D\u0438\u0440\u044B \u0431\u0443\u0434\u0443\u0442 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u0445 \u0442\u0443\u0440\u043D\u0438\u0440\u043E\u0432.\u003Cbr /\u003E\u041F\u0440\u0438\u0432\u0430\u0442\u043D\u044B\u0435 \u0442\u0443\u0440\u043D\u0438\u0440\u044B \u0441\u043A\u0440\u044B\u0442\u044B, \u0438 \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u0430\u043C \u0441\u0441\u044B\u043B\u043A\u0443 \u043D\u0430 \u0442\u0443\u0440\u043D\u0438\u0440.\u0022,ko:\u0022Public tournaments will be displayed in the public tournament lists.\u003Cbr /\u003EPrivate tournaments are hidden and you will have to send players the tournament link.\u0022},wle={en:\u0022Lists will be visible on the tournament page. Lists cannot be submitted anymore by players when lists are public.\u0022,fr:\u0022Les listes seront visibles sur la page du tournoi. Une fois les listes publi\u00E9es, les joueurs ne peuvent plus envoyer de nouvelles listes.\u0022,es:\u0022Lists will be visible on the tournament page. Lists cannot be submitted anymore by players when lists are public.\u0022,cn:\u0022Lists will be visible on the tournament page. Lists cannot be submitted anymore by players when lists are public.\u0022,it:\u0022Le liste saranno visibili sulla pagina del torneo. Le liste non possono pi\u00F9 essere inviate dai giocatori quando sono pubbliche.\u0022,de:\u0022Listen werden auf der Turnierseite sichtbar sein. Listen k\u00F6nnen von Spielern nicht mehr eingereicht werden, wenn sie \u00F6ffentlich sind.\u0022,ja:\u0022\u30EA\u30B9\u30C8\u306F\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30DA\u30FC\u30B8\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002\u30EA\u30B9\u30C8\u304C\u516C\u958B\u3055\u308C\u308B\u3068\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u30EA\u30B9\u30C8\u3092\u9001\u4FE1\u3067\u304D\u306A\u304F\u306A\u308A\u307E\u3059\u3002\u0022,pl:\u0022Listy b\u0119d\u0105 widoczne na stronie turnieju. Listy nie mog\u0105 by\u0107 ju\u017C przesy\u0142ane przez graczy, gdy listy s\u0105 publiczne.\u0022,pt:\u0022As listas ser\u00E3o vis\u00EDveis na p\u00E1gina do torneio. As listas n\u00E3o podem mais ser enviadas pelos jogadores quando est\u00E3o p\u00FAblicas.\u0022,hr:\u0022Popisi \u0107e biti vidljivi na stranici turnira. Igra\u010Di vi\u0161e ne mogu slati popise kada su popisi javni.\u0022,cz:\u0022Lists will be visible on the tournament page. Lists cannot be submitted anymore by players when lists are public.\u0022,sk:\u0022Lists will be visible on the tournament page. Lists cannot be submitted anymore by players when lists are public.\u0022,gr:\u0022\u0394\u03B7\u03BC\u03BF\u03C3\u03AF\u03B5\u03C5\u03C3\u03B7\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043A\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432\u0438\u0434\u043D\u044B \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0442\u0443\u0440\u043D\u0438\u0440\u0430. \u0421\u043F\u0438\u0441\u043A\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u0438\u0433\u0440\u043E\u043A\u0430\u043C\u0438, \u043A\u043E\u0433\u0434\u0430 \u0441\u043F\u0438\u0441\u043A\u0438 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B.\u0022,ko:\u0022Lists will be visible on the tournament page. Lists cannot be submitted anymore by players when lists are public.\u0022},ble={en:\u0022You will receive notifications from the New Recruit Bot about the tournament if you set up your Discord username in New Recruit (Options menu).\u0022,fr:\u0022Tu recevras des notifications du Bot New Recruit sur Discord si tu as configur\u00E9 ton ID Discord sur New Recruit (menu Options).\u0022,es:\u0022You will receive notifications from the New Recruit Bot about the tournament if you set up your Discord username in New Recruit (Options menu).\u0022,cn:\u0022You will receive notifications from the New Recruit Bot about the tournament if you set up your Discord username in New Recruit (Options menu).\u0022,it:\u0022Riceverai notifiche dal bot New Recruit sul torneo se hai configurato il tuo nome utente Discord in New Recruit (menu Opzioni).\u0022,de:\u0022Sie erhalten Benachrichtigungen vom New Recruit Bot \u00FCber das Turnier, wenn Sie Ihren Discord-Benutzernamen in New Recruit einrichten (Optionsmen\u00FC).\u0022,ja:\u0022New Recruit\uFF08\u30AA\u30D7\u30B7\u30E7\u30F3\u30E1\u30CB\u30E5\u30FC\uFF09\u3067Discord\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u8A2D\u5B9A\u3059\u308B\u3068\u3001New Recruit\u30DC\u30C3\u30C8\u304B\u3089\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u95A2\u3059\u308B\u901A\u77E5\u3092\u53D7\u3051\u53D6\u308A\u307E\u3059\u3002\u0022,pl:\u0022Otrzymasz powiadomienia od bota New Recruit o turnieju, je\u015Bli skonfigurujesz swoj\u0105 nazw\u0119 u\u017Cytkownika Discord w New Recruit (menu Opcje).\u0022,pt:\u0022Voc\u00EA receber\u00E1 notifica\u00E7\u00F5es do Bot New Recruit sobre o torneio se configurar seu nome de usu\u00E1rio do Discord no New Recruit (menu Op\u00E7\u00F5es).\u0022,hr:\u0022Primit \u0107ete obavijesti od New Recruit Bota o turniru ako postavite svoje Discord korisni\u010Dko ime u New Recruit (izbornik Opcije).\u0022,cz:\u0022You will receive notifications from the New Recruit Bot about the tournament if you set up your Discord username in New Recruit (Options menu).\u0022,sk:\u0022You will receive notifications from the New Recruit Bot about the tournament if you set up your Discord username in New Recruit (Options menu).\u0022,gr:\u0022\u0395\u03B9\u03B4\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2 Discord\u0022,ru:\u0022\u0415\u0441\u043B\u0438 \u044D\u0442\u043E\u0442 \u0444\u043B\u0430\u0436\u043E\u043A \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D, \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440 \u0442\u0443\u0440\u043D\u0438\u0440\u0430 \u0441\u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u0432\u0430\u043C \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F Discord \u043E \u043C\u0430\u0442\u0447\u0430\u0445 \u0447\u0435\u0440\u0435\u0437 \u0431\u043E\u0442\u0430 New Recruit\u0022,ko:\u0022You will receive notifications from the New Recruit Bot about the tournament if you set up your Discord username in New Recruit (Options menu).\u0022},vle={en:\u0022You can add additional Tournament Admins who will be able to access this interface to manage the tournament.\u0022,fr:\u0022Tu peux ajouter des Gestionnaires de Tournoi qui pourront acc\u00E9der \u00E0 cette interface pour g\u00E9rer le tournoi.\u0022,es:\u0022You can add additional Tournament Admins who will be able to access this interface to manage the tournament.\u0022,cn:\u0022You can add additional Tournament Admins who will be able to access this interface to manage the tournament.\u0022,it:\u0022Puoi aggiungere ulteriori amministratori del torneo che potranno accedere a questa interfaccia per gestire il torneo.\u0022,de:\u0022Sie k\u00F6nnen zus\u00E4tzliche Turnierverwalter hinzuf\u00FCgen, die Zugriff auf diese Oberfl\u00E4che haben, um das Turnier zu verwalten.\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u3092\u7BA1\u7406\u3059\u308B\u305F\u3081\u306B\u3053\u306E\u30A4\u30F3\u30BF\u30FC\u30D5\u30A7\u30FC\u30B9\u306B\u30A2\u30AF\u30BB\u30B9\u3067\u304D\u308B\u8FFD\u52A0\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7BA1\u7406\u8005\u3092\u8FFD\u52A0\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Mo\u017Cesz doda\u0107 dodatkowych Administrator\u00F3w Turnieju, kt\u00F3rzy b\u0119d\u0105 mieli dost\u0119p do tego interfejsu, aby zarz\u0105dza\u0107 turniejem.\u0022,pt:\u0022Voc\u00EA pode adicionar Administradores de Torneio adicionais que poder\u00E3o acessar esta interface para gerenciar o torneio.\u0022,hr:\u0022Mo\u017Eete dodati dodatne administratore turnira koji \u0107e mo\u0107i pristupiti ovom su\u010Delju za upravljanje turnirom.\u0022,cz:\u0022You can add additional Tournament Admins who will be able to access this interface to manage the tournament.\u0022,sk:\u0022You can add additional Tournament Admins who will be able to access this interface to manage the tournament.\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AD\u03C2\u0022,ru:\u0022\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u043E\u0432 \u0442\u0443\u0440\u043D\u0438\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u044D\u0442\u043E\u043C\u0443 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u0434\u043B\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0442\u0443\u0440\u043D\u0438\u0440\u043E\u043C.\u0022,ko:\u0022You can add additional Tournament Admins who will be able to access this interface to manage the tournament.\u0022},kle={en:\u0022Exports all lists in PDF format\u0022,fr:\u0022Exporter toutes les listes au format PDF\u0022,es:\u0022Exports all lists in PDF format\u0022,cn:\u0022Exports all lists in PDF format\u0022,it:\u0022Esporta tutte le liste in formato PDF\u0022,de:\u0022Exportiert alle Listen im PDF-Format\u0022,ja:\u0022\u3059\u3079\u3066\u306E\u30EA\u30B9\u30C8\u3092PDF\u5F62\u5F0F\u3067\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u0022,pl:\u0022Eksportuje wszystkie listy w formacie PDF\u0022,pt:\u0022Exporta todas as listas em formato PDF\u0022,hr:\u0022Izvozi sve popise u PDF formatu\u0022,cz:\u0022Exports all lists in PDF format\u0022,sk:\u0022Exports all lists in PDF format\u0022,gr:\u0022\u0395\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE\u0022,ru:\u0022\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0412\u0441\u0435 \u0421\u043F\u0438\u0441\u043A\u0438 \u0432 PDF \u0424\u043E\u0440\u043C\u0430\u0442\u0022,ko:\u0022Exports all lists in PDF format\u0022},Ble={en:\u0022Add Admin\u0022,fr:\u0022Ajouter un Gestionnaire\u0022,es:\u0022Add Admin\u0022,cn:\u0022Add Admin\u0022,it:\u0022Aggiungi Admin\u0022,de:\u0022Administrator Hinzuf\u00FCgen\u0022,ja:\u0022\u7BA1\u7406\u8005\u8FFD\u52A0\u0022,pl:\u0022Dodaj Admin\u0022,pt:\u0022Adicionar Admin\u0022,hr:\u0022Dodaj administratora\u0022,cz:\u0022Add Admin\u0022,sk:\u0022Add Admin\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u03C2\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0022,ko:\u0022Admin \uCD94\uAC00\u0022},Cle={en:\u0022Send this link to the tournament page to players or to advertise of the tournament.\u0022,fr:\u0022Envoie ce lien vers la page du tournoi aux joueurs ou aux personnes pouvant \u00EAtre int\u00E9ress\u00E9es par le tournoi.\u0022,es:\u0022Send this link to the tournament page to players or to advertise of the tournament.\u0022,cn:\u0022Send this link to the tournament page to players or to advertise of the tournament.\u0022,it:\u0022Invia questo link alla pagina del torneo ai giocatori o per pubblicizzare il torneo.\u0022,de:\u0022Senden Sie diesen Link zur Turnierseite an Spieler oder zur Werbung f\u00FCr das Turnier.\u0022,ja:\u0022\u3053\u306E\u30EA\u30F3\u30AF\u3092\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30DA\u30FC\u30B8\u306B\u9001\u4FE1\u3057\u3066\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u5171\u6709\u3057\u305F\u308A\u3001\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u3092\u5BA3\u4F1D\u3057\u305F\u308A\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Wy\u015Blij ten link do strony turnieju graczom lub do promocji turnieju.\u0022,pt:\u0022Envie este link da p\u00E1gina do torneio aos jogadores ou para divulgar o torneio.\u0022,hr:\u0022Po\u0161aljite ovaj link na stranicu turnira igra\u010Dima ili za ogla\u0161avanje turnira.\u0022,cz:\u0022Send this link to the tournament page to players or to advertise of the tournament.\u0022,sk:\u0022Send this link to the tournament page to players or to advertise of the tournament.\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03B4\u03B5\u03C3\u03BC\u03BF\u03C2\u0022,ru:\u0022\u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u044D\u0442\u0443 \u0441\u0441\u044B\u043B\u043A\u0443 \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 \u0442\u0443\u0440\u043D\u0438\u0440\u0430 \u0438\u0433\u0440\u043E\u043A\u0430\u043C \u0438\u043B\u0438 \u0434\u043B\u044F \u0440\u0435\u043A\u043B\u0430\u043C\u044B \u0442\u0443\u0440\u043D\u0438\u0440\u0430.\u0022,ko:\u0022Send this link to the tournament page to players or to advertise of the tournament.\u0022},_le={en:\u0022To sign up for a Tournament, you need to create a New Recruit account first. This takes a few seconds only by filling the form below.\u0022,fr:\u0022Pour t\u0027inscrire \u00E0 un tournoi, il faut d\u0027abbord cr\u00E9er un compte New Recruit. Cela prendra quelques secondes en remplissant le formulaire ci-dessous.\u0022,es:\u0022To sign up for a Tournament, you need to create a New Recruit account first. This takes a few seconds only by filling the form below.\u0022,cn:\u0022To sign up for a Tournament, you need to create a New Recruit account first. This takes a few seconds only by filling the form below.\u0022,it:\u0022Per iscriverti a un torneo, devi prima creare un account New Recruit. Questo richiede solo pochi secondi compilando il modulo qui sotto.\u0022,de:\u0022Um sich f\u00FCr ein Turnier anzumelden, m\u00FCssen Sie zuerst ein New Recruit-Konto erstellen. Dies dauert nur wenige Sekunden, indem Sie das untenstehende Formular ausf\u00FCllen.\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u3059\u308B\u306B\u306F\u3001\u307E\u305ANew Recruit\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u4EE5\u4E0B\u306E\u30D5\u30A9\u30FC\u30E0\u306B\u8A18\u5165\u3059\u308B\u3053\u3068\u3067\u3001\u6570\u79D2\u3067\u5B8C\u4E86\u3057\u307E\u3059\u3002\u0022,pl:\u0022Aby zapisa\u0107 si\u0119 na Turniej, musisz najpierw utworzy\u0107 konto New Recruit. Zajmie to tylko kilka sekund przez wype\u0142nienie poni\u017Cszego formularza.\u0022,pt:\u0022Para se inscrever em um Torneio, voc\u00EA precisa criar uma conta New Recruit primeiro. Isso leva apenas alguns segundos preenchendo o formul\u00E1rio abaixo.\u0022,hr:\u0022Za prijavu na turnir prvo morate kreirati New Recruit ra\u010Dun. To traje samo nekoliko sekundi ispunjavanjem donjeg obrasca.\u0022,cz:\u0022To sign up for a Tournament, you need to create a New Recruit account first. This takes a few seconds only by filling the form below.\u0022,sk:\u0022To sign up for a Tournament, you need to create a New Recruit account first. This takes a few seconds only by filling the form below.\u0022,gr:\u0022\u039D\u03AD\u03BF\u03C2 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u041D\u043E\u0432\u044B\u0439 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0022,ko:\u0022To sign up for a Tournament, you need to create a New Recruit account first. This takes a few seconds only by filling the form below.\u0022},Sle={en:\u0022Your Account has been created. You can now Sign Up for the Tournament!\u0022,fr:\u0022Ton Compte a \u00E9t\u00E9 cr\u00E9\u00E9. Tu peux maintenant t\u0027inscrire pour le Tournoi.\u0022,es:\u0022Your Account has been created. You can now Sign Up for the Tournament!\u0022,cn:\u0022Your Account has been created. You can now Sign Up for the Tournament!\u0022,it:\u0022Il tuo account \u00E8 stato creato. Ora puoi iscriverti al torneo!\u0022,de:\u0022Ihr Konto wurde erstellt. Sie k\u00F6nnen sich jetzt f\u00FCr das Turnier anmelden!\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u304C\u4F5C\u6210\u3055\u308C\u307E\u3057\u305F\u3002\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u3067\u304D\u307E\u3059\uFF01\u0022,pl:\u0022Twoje konto zosta\u0142o utworzone. Mo\u017Cesz teraz zapisa\u0107 si\u0119 na Turniej!\u0022,pt:\u0022Sua conta foi criada. Agora voc\u00EA pode se inscrever no Torneio!\u0022,hr:\u0022Va\u0161 ra\u010Dun je kreiran. Sada se mo\u017Eete prijaviti za turnir!\u0022,cz:\u0022Your Account has been created. You can now Sign Up for the Tournament!\u0022,sk:\u0022Your Account has been created. You can now Sign Up for the Tournament!\u0022,gr:\u0022\u0395\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0412\u0430\u0448\u0430 \u0443\u0447\u0451\u0442\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u043D\u0430. \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0442\u0443\u0440\u043D\u0438\u0440!\u0022,ko:\u0022Your Account has been created. You can now Sign Up for the Tournament!\u0022},Ele={en:\u0022Tournament Overview\u0022,fr:\u0022Aper\u00E7u du Tournoi\u0022,es:\u0022Tournament Overview\u0022,cn:\u0022Tournament Overview\u0022,it:\u0022Panoramica Torneo\u0022,de:\u0022Turnier-\u00DCbersicht\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u6982\u8981\u0022,pl:\u0022Przegl\u0105d Turnieju\u0022,pt:\u0022Vis\u00E3o Geral do Torneio\u0022,hr:\u0022Pregled turnira\u0022,cz:\u0022Tournament Overview\u0022,sk:\u0022Tournament Overview\u0022,gr:\u0022\u0395\u03C0\u03B9\u03C3\u03BA\u03CC\u03C0\u03B7\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u041E\u0431\u0437\u043E\u0440 \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,ko:\u0022Tournament Overview\u0022},jle={en:\u0022Fill Pods\u0022,fr:\u0022Remplir les Poules\u0022,es:\u0022Fill Pods\u0022,cn:\u0022Fill Pods\u0022,it:\u0022Riempi Gironi\u0022,de:\u0022Gruppen F\u00FCllen\u0022,ja:\u0022\u30DD\u30C3\u30C9\u7DE8\u6210\u0022,pl:\u0022Wype\u0142nij Grupy\u0022,pt:\u0022Preencher Grupos\u0022,hr:\u0022Popuni grupe\u0022,cz:\u0022Fill Pods\u0022,sk:\u0022Fill Pods\u0022,gr:\u0022\u03A4\u03C5\u03C7\u03B1\u03AF\u03B1 \u03BA\u03B1\u03C4\u03B1\u03BD\u03BF\u03BC\u03AE \u03BF\u03BC\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u0417\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0433\u0440\u0443\u043F\u043F\u044B\u0022,ko:\u0022Fill Pods\u0022},zle={en:\u0022Regenerate Playoffs\u0022,fr:\u0022Reg\u00E9n\u00E9rer le tableau Final\u0022,es:\u0022Regenerate Playoffs\u0022,cn:\u0022Regenerate Playoffs\u0022,it:\u0022Rigenera Playoff\u0022,de:\u0022Playoffs Neu Generieren\u0022,ja:\u0022\u30D7\u30EC\u30FC\u30AA\u30D5\u518D\u751F\u6210\u0022,pl:\u0022Regeneruj Playoffy\u0022,pt:\u0022Regenerar Playoffs\u0022,hr:\u0022Ponovno generiraj doigravanje\u0022,cz:\u0022Regenerate Playoffs\u0022,sk:\u0022Regenerate Playoffs\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 playoffs\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043F\u043B\u0435\u0439-\u043E\u0444\u0444\u0022,ko:\u0022Regenerate Playoffs\u0022},Ile={en:\u0022* Your email address will only be used to send you a new password in case you lost yours or to send you information about a Tournament you joined. Your address will not be communicated to anyone. No Spam.\u0022,fr:\u0022* Ton adresse email ne sera utilis\u00E9e que pour te renvoyer un mot de passe perdu ou pour des informations concernant un tournoi auquel tu participes. Ton adresse ne sera envoy\u00E9e \u00E0 personne. Pas de Spam.\u0022,es:\u0022* Your email address will only be used to send you a new password in case you lost yours or to send you information about a Tournament you joined. Your address will not be communicated to anyone. No Spam.\u0022,cn:\u0022* Your email address will only be used to send you a new password in case you lost yours or to send you information about a Tournament you joined. Your address will not be communicated to anyone. No Spam.\u0022,it:\u0022* Il tuo indirizzo email sar\u00E0 utilizzato solo per inviarti una nuova password in caso tu abbia perso la tua o per inviarti informazioni su un torneo a cui ti sei iscritto. Il tuo indirizzo non sar\u00E0 comunicato a nessuno. Niente spam.\u0022,de:\u0022* Ihre E-Mail-Adresse wird nur verwendet, um Ihnen ein neues Passwort zu senden, falls Sie Ihres verloren haben, oder um Ihnen Informationen \u00FCber ein Turnier zu senden, dem Sie beigetreten sind. Ihre Adresse wird niemandem mitgeteilt. Kein Spam.\u0022,ja:\u0022* \u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u306F\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u7D1B\u5931\u3057\u305F\u5834\u5408\u306B\u65B0\u3057\u3044\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u9001\u4FE1\u3057\u305F\u308A\u3001\u53C2\u52A0\u3057\u305F\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u95A2\u3059\u308B\u60C5\u5831\u3092\u9001\u4FE1\u3059\u308B\u305F\u3081\u306B\u306E\u307F\u4F7F\u7528\u3055\u308C\u307E\u3059\u3002\u3042\u306A\u305F\u306E\u30A2\u30C9\u30EC\u30B9\u306F\u8AB0\u306B\u3082\u4F1D\u3048\u3089\u308C\u307E\u305B\u3093\u3002\u30B9\u30D1\u30E0\u306F\u3042\u308A\u307E\u305B\u3093\u3002\u0022,pl:\u0022* Tw\u00F3j adres email b\u0119dzie u\u017Cywany tylko do wys\u0142ania nowego has\u0142a w przypadku jego utraty lub do wysy\u0142ania informacji o Turniejach, do kt\u00F3rych si\u0119 zapisa\u0142e\u015B. Tw\u00F3j adres nie b\u0119dzie udost\u0119pniany nikomu. Bez Spamu.\u0022,pt:\u0022* Seu endere\u00E7o de e-mail ser\u00E1 usado apenas para enviar uma nova senha caso voc\u00EA perca a sua ou para enviar informa\u00E7\u00F5es sobre um Torneio do qual voc\u00EA participou. Seu endere\u00E7o n\u00E3o ser\u00E1 comunicado a ningu\u00E9m. Sem Spam.\u0022,hr:\u0022* Va\u0161a email adresa \u0107e se koristiti samo za slanje nove lozinke u slu\u010Daju da ste je izgubili ili za slanje informacija o turniru kojem ste se pridru\u017Eili. Va\u0161a adresa ne\u0107e biti podijeljena ni s kim. Bez spama.\u0022,cz:\u0022* Your email address will only be used to send you a new password in case you lost yours or to send you information about a Tournament you joined. Your address will not be communicated to anyone. No Spam.\u0022,sk:\u0022* Your email address will only be used to send you a new password in case you lost yours or to send you information about a Tournament you joined. Your address will not be communicated to anyone. No Spam.\u0022,gr:\u0022\u0397 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7 email \u03C3\u03B1\u03C2\u0022,ru:\u0022* \u0412\u0430\u0448 \u0430\u0434\u0440\u0435\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u043F\u043E\u0447\u0442\u044B \u0431\u0443\u0434\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438 \u0432\u0430\u043C \u043D\u043E\u0432\u043E\u0433\u043E \u043F\u0430\u0440\u043E\u043B\u044F \u0432 \u0441\u043B\u0443\u0447\u0430\u0435, \u0435\u0441\u043B\u0438 \u0432\u044B \u0435\u0433\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438, \u0438\u043B\u0438 \u0434\u043B\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438 \u0432\u0430\u043C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u043E \u0442\u0443\u0440\u043D\u0438\u0440\u0435, \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0432\u044B \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C. \u0412\u0430\u0448 \u0430\u0434\u0440\u0435\u0441 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u043D \u043D\u0438\u043A\u043E\u043C\u0443. \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0441\u043F\u0430\u043C\u0430.\u0022,ko:\u0022* Your email address will only be used to send you a new password in case you lost yours or to send you information about a Tournament you joined. Your address will not be communicated to anyone. No Spam.\u0022},Ple={en:\u0022Pod\u0022,fr:\u0022Poule\u0022,es:\u0022Pod\u0022,cn:\u0022Pod\u0022,it:\u0022Pod\u0022,de:\u0022Pod\u0022,ja:\u0022\u30DD\u30C3\u30C9\u0022,pl:\u0022Pod\u0022,pt:\u0022Grupo\u0022,hr:\u0022Grupa\u0022,cz:\u0022Pod\u0022,sk:\u0022Pod\u0022,gr:\u0022Pod\u0022,ru:\u0022\u0413\u0440\u0443\u043F\u043F\u0430\u0022,ko:\u0022Pod\u0022},Tle={en:\u0022Pod\u0022,fr:\u0022Poule\u0022,es:\u0022Pod\u0022,cn:\u0022Pod\u0022,it:\u0022Pod\u0022,de:\u0022Pod\u0022,ja:\u0022\u30DD\u30C3\u30C9\u0022,pl:\u0022Pod\u0022,pt:\u0022Grupo\u0022,hr:\u0022Grupa\u0022,cz:\u0022Pod\u0022,sk:\u0022Pod\u0022,gr:\u0022Pod\u0022,ru:\u0022\u0413\u0440\u0443\u043F\u043F\u0430\u0022,ko:\u0022Pod\u0022},Nle={en:\u0022Pods\u0022,fr:\u0022Poules\u0022,es:\u0022Pods\u0022,cn:\u0022Pods\u0022,it:\u0022Gironi\u0022,de:\u0022Pods\u0022,ja:\u0022\u30DD\u30C3\u30C9\u0022,pl:\u0022Pods\u0022,pt:\u0022Grupos\u0022,hr:\u0022Grupe\u0022,cz:\u0022Pods\u0022,sk:\u0022Pods\u0022,gr:\u0022\u039F\u03BC\u03AC\u03B4\u03B5\u03C2\u0022,ru:\u0022\u0413\u0440\u0443\u043F\u043F\u044B\u0022,ko:\u0022Pods\u0022},Fle={en:\u0022Finals\u0022,fr:\u0022Finale\u0022,es:\u0022Finals\u0022,cn:\u0022Finals\u0022,it:\u0022Finals\u0022,de:\u0022Finals\u0022,ja:\u0022\u6C7A\u52DD\u0022,pl:\u0022Fina\u0142y\u0022,pt:\u0022Finais\u0022,hr:\u0022Finale\u0022,cz:\u0022Finals\u0022,sk:\u0022Finals\u0022,gr:\u0022\u03A4\u03B5\u03BB\u03B9\u03BA\u03BF\u03AF\u0022,ru:\u0022\u0424\u0438\u043D\u0430\u043B\u044B\u0022,ko:\u0022Finals\u0022},Rle={en:\u0022Semi Finals\u0022,fr:\u0022Demi-Finales\u0022,es:\u0022Semi Finals\u0022,cn:\u0022Semi Finals\u0022,it:\u0022Semi Finals\u0022,de:\u0022Halbfinale\u0022,ja:\u0022\u6E96\u6C7A\u52DD\u0022,pl:\u0022P\u00F3\u0142fina\u0142y\u0022,pt:\u0022Semifinais\u0022,hr:\u0022Polufinale\u0022,cz:\u0022Semi Finals\u0022,sk:\u0022Semi Finals\u0022,gr:\u0022\u0397\u03BC\u03B9\u03C4\u03B5\u03BB\u03B9\u03BA\u03BF\u03AF\u0022,ru:\u0022\u041F\u043E\u043B\u0443\u0444\u0438\u043D\u0430\u043B\u044B\u0022,ko:\u0022Semi Finals\u0022},Mle={en:\u0022Rankings\u0022,fr:\u0022Classement\u0022,es:\u0022Rankings\u0022,cn:\u0022Rankings\u0022,it:\u0022Rankings\u0022,de:\u0022Rankings\u0022,ja:\u0022\u30E9\u30F3\u30AD\u30F3\u30B0\u0022,pl:\u0022Rankingi\u0022,pt:\u0022Classifica\u00E7\u00F5es\u0022,hr:\u0022Rangiranje\u0022,cz:\u0022Rankings\u0022,sk:\u0022Poradie\u0022,gr:\u0022\u039A\u03B1\u03C4\u03B1\u03C4\u03AC\u03BE\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0420\u0435\u0439\u0442\u0438\u043D\u0433\u0438\u0022,ko:\u0022Rankings\u0022},Ule={en:\u0022Tournament Stats\u0022,fr:\u0022Statistiques du Tournoi\u0022,es:\u0022Tournament Stats\u0022,cn:\u0022Tournament Stats\u0022,it:\u0022Statistiche Torneo\u0022,de:\u0022Turnierstatistiken\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7D71\u8A08\u0022,pl:\u0022Statystyki Turnieju\u0022,pt:\u0022Estat\u00EDsticas do Torneio\u0022,hr:\u0022Statistika turnira\u0022,cz:\u0022Tournament Stats\u0022,sk:\u0022Tournament Stats\u0022,gr:\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03A3\u03C4\u03B1\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430\u0022,ko:\u0022Tournament Stats\u0022},xle={en:\u0022Save Pod\u0022,fr:\u0022Enregistrer les Poules\u0022,es:\u0022Save Pod\u0022,cn:\u0022Save Pod\u0022,it:\u0022Salvezza Pod\u0022,de:\u0022Gruppe Speichern\u0022,ja:\u0022\u30BB\u30FC\u30D6\u30DD\u30C3\u30C9\u0022,pl:\u0022Zapisz Grup\u0119\u0022,pt:\u0022Salvar Grupo\u0022,hr:\u0022Spremi grupu\u0022,cz:\u0022Save Pod\u0022,sk:\u0022Save Pod\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C4\u03C1\u03BF\u03C0\u03AE Pod\u0022,ru:\u0022\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0413\u0440\u0443\u043F\u043F\u0430\u0022,ko:\u0022Save Pod\u0022},Qle={en:\u0022Round Generation\u0022,fr:\u0022G\u00E9n\u00E9ration des Rondes\u0022,es:\u0022Round Generation\u0022,cn:\u0022Round Generation\u0022,it:\u0022Round Generation\u0022,de:\u0022Runden-Generierung\u0022,ja:\u0022\u30E9\u30A6\u30F3\u30C9\u751F\u6210\u0022,pl:\u0022Generowanie Rund\u0022,pt:\u0022Gera\u00E7\u00E3o de Rodadas\u0022,hr:\u0022Generiranje rundi\u0022,cz:\u0022Round Generation\u0022,sk:\u0022Round Generation\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B3\u03CD\u03C1\u03BF\u03C5\u0022,ru:\u0022\u0413\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F \u0440\u0430\u0443\u043D\u0434\u0430\u0022,ko:\u0022Round Generation\u0022},Lle={en:\u0022Sometimes, after an update, some data files are not updated properly and New Recruit can be stuck loading, or on a white page.\u0022,fr:\u0022Parfois, apr\u00E8s une mise \u00E0 jour, certains fichiers ne sont pas mis \u00E0 jour correctement et New Recruit bloque au chargement ou sur une page blanche\u0022,es:\u0022Sometimes, after an update, some data files are not updated properly and New Recruit can be stuck loading, or on a white page.\u0022,cn:\u0022Sometimes, after an update, some data files are not updated properly and New Recruit can be stuck loading, or on a white page.\u0022,it:\u0022A volte, dopo un aggiornamento, alcuni file di dati non vengono aggiornati correttamente e New Recruit pu\u00F2 bloccarsi durante il caricamento o su una pagina bianca.\u0022,de:\u0022Manchmal werden nach einem Update einige Datendateien nicht ordnungsgem\u00E4\u00DF aktualisiert und New Recruit kann beim Laden h\u00E4ngen bleiben oder auf einer wei\u00DFen Seite.\u0022,ja:\u0022\u66F4\u65B0\u5F8C\u3001\u4E00\u90E8\u306E\u30C7\u30FC\u30BF\u30D5\u30A1\u30A4\u30EB\u304C\u6B63\u3057\u304F\u66F4\u65B0\u3055\u308C\u305A\u3001New Recruit\u304C\u8AAD\u307F\u8FBC\u307F\u4E2D\u306E\u307E\u307E\u306B\u306A\u3063\u305F\u308A\u3001\u767D\u3044\u30DA\u30FC\u30B8\u306B\u7559\u307E\u3063\u305F\u308A\u3059\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Czasami, po aktualizacji, niekt\u00F3re pliki danych nie s\u0105 prawid\u0142owo zaktualizowane i New Recruit mo\u017Ce si\u0119 zawiesi\u0107 podczas \u0142adowania lub na bia\u0142ej stronie.\u0022,pt:\u0022\u00C0s vezes, ap\u00F3s uma atualiza\u00E7\u00E3o, alguns arquivos de dados n\u00E3o s\u00E3o atualizados corretamente e o New Recruit pode ficar travado no carregamento ou em uma p\u00E1gina em branco.\u0022,hr:\u0022Ponekad, nakon a\u017Euriranja, neke datoteke podataka nisu pravilno a\u017Eurirane i New Recruit mo\u017Ee zapeti pri u\u010Ditavanju ili na bijeloj stranici.\u0022,cz:\u0022Sometimes, after an update, some data files are not updated properly and New Recruit can be stuck loading, or on a white page.\u0022,sk:\u0022Sometimes, after an update, some data files are not updated properly and New Recruit can be stuck loading, or on a white page.\u0022,gr:\u0022\u0391\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03B7 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD - \u03A0\u03C1\u03CE\u03C4\u03BF \u03B2\u03AE\u03BC\u03B1\u0022,ru:\u0022\u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0441 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439 \u0434\u0430\u043D\u043D\u044B\u0445, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 (Ctrl\u002BShift\u002BR \u043D\u0430 Windows/Linux, Cmd\u002BShift\u002BR \u043D\u0430 Mac)\u0022,ko:\u0022Sometimes, after an update, some data files are not updated properly and New Recruit can be stuck loading, or on a white page.\u0022},Dle={en:\u0022I am doing my best to prevent this, but if it happens, you can click the Reset New Recruit button below and it should fix the problem. Warning, unsynced list may be lost.\u0022,fr:\u0022Je fais tout mon possible pour \u00E9viter cela, mais en cas de probl\u00E8me, tu peux cliquer sur le bouton R\u00E9initialiser New Recruit ci-dessous et cela devrait r\u00E9gler le probl\u00E8me. Attention, les listes non synchronis\u00E9es risquent d\u0027\u00EAtre perdues.\u0022,es:\u0022I am doing my best to prevent this, but if it happens, you can click the Reset New Recruit button below and it should fix the problem. Warning, unsynced list may be lost.\u0022,cn:\u0022I am doing my best to prevent this, but if it happens, you can click the Reset New Recruit button below and it should fix the problem. Warning, unsynced list may be lost.\u0022,it:\u0022Sto facendo del mio meglio per prevenire questo, ma se succede, puoi cliccare il pulsante Ripristina New Recruit qui sotto e dovrebbe risolvere il problema. Attenzione, le liste non sincronizzate potrebbero essere perse.\u0022,de:\u0022Ich tue mein Bestes, um dies zu verhindern, aber wenn es passiert, k\u00F6nnen Sie auf die Schaltfl\u00E4che \u0027New Recruit Zur\u00FCcksetzen\u0027 unten klicken und es sollte das Problem beheben. Warnung: Nicht synchronisierte Listen k\u00F6nnen verloren gehen.\u0022,ja:\u0022\u3053\u308C\u3092\u9632\u3050\u305F\u3081\u306B\u6700\u5584\u3092\u5C3D\u304F\u3057\u3066\u3044\u307E\u3059\u304C\u3001\u3082\u3057\u767A\u751F\u3057\u305F\u5834\u5408\u306F\u3001\u4E0B\u306ENew Recruit\u3092\u30EA\u30BB\u30C3\u30C8\u30DC\u30BF\u30F3\u3092\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u554F\u984C\u304C\u89E3\u6C7A\u3055\u308C\u308B\u306F\u305A\u3067\u3059\u3002\u8B66\u544A\uFF1A\u540C\u671F\u3055\u308C\u3066\u3044\u306A\u3044\u30EA\u30B9\u30C8\u306F\u5931\u308F\u308C\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Robi\u0119 wszystko, co mog\u0119, aby temu zapobiec, ale je\u015Bli to si\u0119 zdarzy, mo\u017Cesz klikn\u0105\u0107 przycisk Resetuj New Recruit poni\u017Cej i powinno to rozwi\u0105za\u0107 problem. Ostrze\u017Cenie: niesynchronizowane listy mog\u0105 zosta\u0107 utracone.\u0022,pt:\u0022Estou fazendo o meu melhor para evitar isso, mas se acontecer, voc\u00EA pode clicar no bot\u00E3o Resetar New Recruit abaixo e isso deve resolver o problema. Aviso: listas n\u00E3o sincronizadas podem ser perdidas.\u0022,hr:\u0022Dajem sve od sebe da to sprije\u010Dim, ali ako se dogodi, mo\u017Eete kliknuti gumb Resetiraj New Recruit ispod i to bi trebalo rije\u0161iti problem. Upozorenje, nesinkronizirani popisi mogu biti izgubljeni.\u0022,cz:\u0022I am doing my best to prevent this, but if it happens, you can click the Reset New Recruit button below and it should fix the problem. Warning, unsynced list may be lost.\u0022,sk:\u0022I am doing my best to prevent this, but if it happens, you can click the Reset New Recruit button below and it should fix the problem. Warning, unsynced list may be lost.\u0022,gr:\u0022\u0391\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03B7 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD - \u0394\u03B5\u03CD\u03C4\u03B5\u03C1\u03BF \u03B2\u03AE\u03BC\u03B1\u0022,ru:\u0022\u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u043E, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043A\u044D\u0448 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430\u0022,ko:\u0022I am doing my best to prevent this, but if it happens, you can click the Reset New Recruit button below and it should fix the problem. Warning, unsynced list may be lost.\u0022},Ole={en:\u0022Reset New Recruit\u0022,fr:\u0022R\u00E9initialiser New Recruit\u0022,es:\u0022Reset New Recruit\u0022,cn:\u0022Reset New Recruit\u0022,it:\u0022Ripristina New Recruit\u0022,de:\u0022New Recruit Zur\u00FCcksetzen\u0022,ja:\u0022New Recruit\u3092\u30EA\u30BB\u30C3\u30C8\u0022,pl:\u0022Resetuj New Recruit\u0022,pt:\u0022Resetar New Recruit\u0022,hr:\u0022Resetiraj New Recruit\u0022,cz:\u0022Reset New Recruit\u0022,sk:\u0022Reset New Recruit\u0022,gr:\u0022\u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03B1\u03BD\u03C4\u03B9\u03BC\u03B5\u03C4\u03CE\u03C0\u03B9\u03C3\u03B7\u03C2 \u03C0\u03C1\u03BF\u03B2\u03BB\u03B7\u03BC\u03AC\u03C4\u03C9\u03BD\u0022,ru:\u0022\u0412 \u043A\u0440\u0430\u0439\u043D\u0435\u043C \u0441\u043B\u0443\u0447\u0430\u0435, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C New Recruit \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u0022,ko:\u0022Reset New Recruit\u0022},Hle={en:\u0022Manage\u0022,fr:\u0022G\u00E9rer\u0022,es:\u0022Manage\u0022,cn:\u0022Manage\u0022,it:\u0022Gestisci\u0022,de:\u0022Verwalten\u0022,ja:\u0022\u7BA1\u7406\u0022,pl:\u0022Zarz\u0105dzaj\u0022,pt:\u0022Gerenciar\u0022,hr:\u0022Upravljaj\u0022,cz:\u0022Manage\u0022,sk:\u0022Manage\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7\u0022,ru:\u0022\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u0022,ko:\u0022Manage\u0022},Gle={en:\u0022Leagues\u0022,fr:\u0022Ligues\u0022,es:\u0022Leagues\u0022,cn:\u0022Leagues\u0022,it:\u0022Leghe\u0022,de:\u0022Ligen\u0022,ja:\u0022\u30EA\u30FC\u30B0\u0022,pl:\u0022Ligi\u0022,pt:\u0022Ligas\u0022,hr:\u0022Lige\u0022,cz:\u0022Leagues\u0022,sk:\u0022Leagues\u0022,gr:\u0022\u03A0\u03C1\u03C9\u03C4\u03B1\u03B8\u03BB\u03AE\u03BC\u03B1\u03C4\u03B1\u0022,ru:\u0022\u041B\u0438\u0433\u0438\u0022,ko:\u0022Leagues\u0022},Vle={en:\u0022Player Name\u0022,fr:\u0022Nom du Joueur\u0022,es:\u0022Player Name\u0022,cn:\u0022Player Name\u0022,it:\u0022Nome Giocatore\u0022,de:\u0022Spielername\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u540D\u0022,pl:\u0022Nazwa Gracza\u0022,pt:\u0022Nome do Jogador\u0022,hr:\u0022Ime igra\u010Da\u0022,cz:\u0022Player Name\u0022,sk:\u0022Player Name\u0022,gr:\u0022\u03A0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u038C\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u043A \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Player Name\u0022},Wle={en:\u0022Round\u0022,fr:\u0022Ronde\u0022,es:\u0022Ronda\u0022,cn:\u0022\u56DE\u5408\u0022,it:\u0022Turno\u0022,de:\u0022Runde\u0022,ja:\u0022\u30E9\u30A6\u30F3\u30C9\u0022,pl:\u0022Runda\u0022,pt:\u0022Rodada\u0022,hr:\u0022Runda\u0022,cz:\u0022Round\u0022,sk:\u0022Kolo\u0022,gr:\u0022\u0393\u03CD\u03C1\u03BF\u03C2\u0022,ru:\u0022\u0420\u0430\u0443\u043D\u0434\u0022,ko:\u0022\uB77C\uC6B4\uB4DC\u0022},Yle={en:\u0022Import .ros/.rosz/.json\u0022,fr:\u0022Import .ros/.rosz/.json\u0022,es:\u0022Import .ros/.rosz/.json\u0022,cn:\u0022Import .ros/.rosz/.json\u0022,it:\u0022Import .ros/.rosz/.json\u0022,de:\u0022Import .ros/.rosz/.json\u0022,ja:\u0022.ros/.rosz/.json \u30A4\u30F3\u30DD\u30FC\u30C8\u0022,pl:\u0022Import .ros/.rosz/.json\u0022,pt:\u0022Importar .ros/.rosz/.json\u0022,hr:\u0022.ros/.rosz/.json uvoz\u0022,cz:\u0022.ros/.rosz/.json Import\u0022,sk:\u0022.ros/.rosz/.json Import\u0022,gr:\u0022\u0395\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE \u03B1\u03C0\u03CC .ros/.rosz/.json\u0022,ru:\u0022\u0418\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438\u0437 .ros/.rosz/.json\u0022,ko:\u0022.ros/.rosz/.json Import\u0022},Kle={en:\u0022Are you sure you want to re-regenerate Rounds and Matches? This will reset ALL the Pairings and DELETE ALL RESULTS.\u0022,fr:\u0022\u00CAtes-vous s\u00FBr de vouloir reg\u00E9n\u00E9rer les Rounds et Matchs ? Cela va r\u00E9initialiser TOUS les Appariements et SUPPRIMER TOUS LES R\u00C9SULTATS.\u0022,es:\u0022\u00BFEst\u00E1s seguro de que quieres regenerar las Rondas y Partidos? Esto restablecer\u00E1 TODOS los Emparejamientos y ELIMINAR\u00C1 TODOS LOS RESULTADOS.\u0022,cn:\u0022\u60A8\u786E\u5B9A\u8981\u91CD\u65B0\u751F\u6210\u56DE\u5408\u548C\u6BD4\u8D5B\u5417\uFF1F\u8FD9\u5C06\u91CD\u7F6E\u6240\u6709\u914D\u5BF9\u5E76\u5220\u9664\u6240\u6709\u7ED3\u679C\u3002\u0022,it:\u0022Sei sicuro di voler rigenerare i turni e le partite? Questo resetter\u00E0 TUTTI gli accoppiamenti ed ELIMINER\u00C0 TUTTI I RISULTATI.\u0022,de:\u0022Sind Sie sicher, dass Sie Runden und Matches neu generieren m\u00F6chten? Dies setzt ALLE Paarungen zur\u00FCck und L\u00D6SCHT ALLE ERGEBNISSE.\u0022,ja:\u0022\u30E9\u30A6\u30F3\u30C9\u3068\u30DE\u30C3\u30C1\u3092\u518D\u751F\u6210\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F\u3053\u308C\u306B\u3088\u308A\u3059\u3079\u3066\u306E\u30DA\u30A2\u30EA\u30F3\u30B0\u304C\u30EA\u30BB\u30C3\u30C8\u3055\u308C\u3001\u3059\u3079\u3066\u306E\u7D50\u679C\u304C\u524A\u9664\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Czy na pewno chcesz ponownie wygenerowa\u0107 Rundy i Mecze? Spowoduje to zresetowanie WSZYSTKICH Parowa\u0144 i USUNI\u0118CIE WSZYSTKICH WYNIK\u00D3W.\u0022,pt:\u0022Tem certeza de que deseja re-gerar Rodadas e Partidas? Isso ir\u00E1 resetar TODOS os Emparelhamentos e EXCLUIR TODOS OS RESULTADOS.\u0022,hr:\u0022Jeste li sigurni da \u017Eelite ponovno generirati runde i me\u010Deve? Ovo \u0107e resetirati SVA uparivanja i OBRISATI SVE REZULTATE.\u0022,cz:\u0022Are you sure you want to re-regenerate Rounds and Matches? This will reset ALL the Pairings and DELETE ALL RESULTS.\u0022,sk:\u0022Are you sure you want to re-regenerate Rounds and Matches? This will reset ALL the Pairings and DELETE ALL RESULTS.\u0022,gr:\u0022\u0395\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u03B3\u03CD\u03C1\u03BF\u03C5\u0022,ru:\u0022\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0441\u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0443\u043D\u0434\u044B \u0438 \u043C\u0430\u0442\u0447\u0438? \u042D\u0442\u043E \u0441\u0431\u0440\u043E\u0441\u0438\u0442 \u0412\u0421\u0415 \u043F\u0430\u0440\u044B \u0438 \u0423\u0414\u0410\u041B\u0418\u0422 \u0412\u0421\u0415 \u0420\u0415\u0417\u0423\u041B\u042C\u0422\u0410\u0422\u042B.\u0022,ko:\u0022Are you sure you want to re-regenerate Rounds and Matches? This will reset ALL the Pairings and DELETE ALL RESULTS.\u0022},qle={en:\u0022Teams and Lists\u0022,fr:\u0022Equipes et Listes\u0022,es:\u0022Teams and Lists\u0022,cn:\u0022Teams and Lists\u0022,it:\u0022Squadre e Liste\u0022,de:\u0022Mannschaften und Listen\u0022,ja:\u0022\u30C1\u30FC\u30E0\u3068\u30EA\u30B9\u30C8\u0022,pl:\u0022Dru\u017Cyny i Listy\u0022,pt:\u0022Equipes e Listas\u0022,hr:\u0022Timovi i popisi\u0022,cz:\u0022Teams and Lists\u0022,sk:\u0022Teams and Lists\u0022,gr:\u0022\u039F\u03BC\u03AC\u03B4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2\u0022,ru:\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u044B and \u0421\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022Teams and Lists\u0022},Jle={en:\u0022Team Rankings\u0022,fr:\u0022Classement d\u0027\u00E9quipes\u0022,es:\u0022Team Rankings\u0022,cn:\u0022Team Rankings\u0022,it:\u0022Classifica Squadre\u0022,de:\u0022Mannschaftsrangliste\u0022,ja:\u0022\u30C1\u30FC\u30E0\u30E9\u30F3\u30AD\u30F3\u30B0\u0022,pl:\u0022Rankingi Dru\u017Cynowe\u0022,pt:\u0022Classifica\u00E7\u00F5es de Equipe\u0022,hr:\u0022Timsko rangiranje\u0022,cz:\u0022Team Rankings\u0022,sk:\u0022Team Rankings\u0022,gr:\u0022\u039F\u03BC\u03B1\u03B4\u03B9\u03BA\u03AD\u03C2 \u03BA\u03B1\u03C4\u03B1\u03C4\u03AC\u03BE\u03B5\u03B9\u03C2\u0022,ru:\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u0420\u0435\u0439\u0442\u0438\u043D\u0433\u0438\u0022,ko:\u0022Team Rankings\u0022},$le={en:\u0022Individual Rankings\u0022,fr:\u0022Classement Individuel\u0022,es:\u0022Individual Rankings\u0022,cn:\u0022Individual Rankings\u0022,it:\u0022Classifica Individuale\u0022,de:\u0022Einzelrangliste\u0022,ja:\u0022\u500B\u4EBA\u30E9\u30F3\u30AD\u30F3\u30B0\u0022,pl:\u0022Ranking