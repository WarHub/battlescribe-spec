0022Are you sure you want to delete this unit ?\u0022,cn:\u0022\u662F\u5426\u786E\u5B9A\u5220\u9664\u8FD9\u4E2A\u5355\u4F4D\uFF1F\u0022,it:\u0022Sei sicuro di voler eliminare questa unit\u00E0?\u0022,de:\u0022Sind Sie sicher, dass Sie diese Einheit l\u00F6schen m\u00F6chten?\u0022,ja:\u0022\u3053\u306E\u30E6\u30CB\u30C3\u30C8\u3092\u524A\u9664\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F\u0022,pl:\u0022Czy jeste\u015B pewien, \u017Ce chcesz usun\u0105\u0107 t\u0119 jednostk\u0119?\u0022,pt:\u0022Tem certeza de que deseja excluir esta unidade?\u0022,hr:\u0022Jeste li sigurni da \u017Eelite obrisati ovu jedinicu?\u0022,cz:\u0022Opravdu chcete smazat tuto jednotku?\u0022,sk:\u0022Ste si ist\u00FD, \u017Ee chcete vymaza\u0165 t\u00FAto jednotku?\u0022,gr:\u0022\u0395\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7 \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1\u03C2\u0022,ru:\u0022\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u044D\u0442\u0443 \u0435\u0434\u0438\u043D\u0438\u0446\u0443?\u0022,ko:\u0022\uC774 \uBD80\uB300\uB97C \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\u0022},oae={en:\u0022The list will be deleted locally from your browser\u0022,fr:\u0022Cette liste sera supprim\u00E9e de ton navigateur\u0022,es:\u0022The list will be deleted locally from your browser\u0022,cn:\u0022\u8BE5\u519B\u8868\u5C06\u4ECE\u4F60\u7684\u6D4F\u89C8\u5668\u672C\u5730\u5220\u9664\u0022,it:\u0022La lista sar\u00E0 eliminata localmente dal tuo browser\u0022,de:\u0022Die Liste wird lokal aus Ihrem Browser gel\u00F6scht\u0022,ja:\u0022\u30EA\u30B9\u30C8\u306F\u30D6\u30E9\u30A6\u30B6\u304B\u3089\u30ED\u30FC\u30AB\u30EB\u306B\u524A\u9664\u3055\u308C\u307E\u3059\u0022,pl:\u0022Lista zostanie usuni\u0119ta lokalnie z przegl\u0105darki\u0022,pt:\u0022A lista ser\u00E1 exclu\u00EDda localmente do seu navegador\u0022,hr:\u0022Popis \u0107e biti obrisan lokalno iz va\u0161eg preglednika\u0022,cz:\u0022Seznam bude smaz\u00E1n lok\u00E1ln\u011B z va\u0161eho prohl\u00ED\u017Ee\u010De\u0022,sk:\u0022Zoznam bude vymazan\u00FD lok\u00E1lne z v\u00E1\u0161ho prehliada\u010Da\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03C0\u03B5\u03C1\u03B9\u03B7\u03B3\u03B7\u03C4\u03AE\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0430\u043B\u0451\u043D \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430\u0022,ko:\u0022\uBE0C\uB77C\uC6B0\uC800\uC5D0\uC11C \uB85C\uCEEC\uB85C \uC0AD\uC81C\uB429\uB2C8\uB2E4\u0022},aae={en:\u0022The list will be deleted from the server\u0022,fr:\u0022Cette liste sera supprim\u00E9e sur le serveur\u0022,es:\u0022The list will be deleted from the server\u0022,cn:\u0022\u8BE5\u519B\u8868\u5C06\u4ECE\u670D\u52A1\u5668\u5220\u9664\u0022,it:\u0022La lista sar\u00E0 eliminata dal server\u0022,de:\u0022Die Liste wird vom Server gel\u00F6scht\u0022,ja:\u0022\u30EA\u30B9\u30C8\u306F\u30B5\u30FC\u30D0\u30FC\u304B\u3089\u524A\u9664\u3055\u308C\u307E\u3059\u0022,pl:\u0022Lista zostanie usuni\u0119ta z serwera\u0022,pt:\u0022A lista ser\u00E1 exclu\u00EDda do servidor\u0022,hr:\u0022Popis \u0107e biti obrisan sa servera\u0022,cz:\u0022Seznam bude smaz\u00E1n ze serveru\u0022,sk:\u0022Zoznam bude vymazan\u00FD zo servera\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03B4\u03B9\u03B1\u03BA\u03BF\u03BC\u03B9\u03C3\u03C4\u03AE\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0430\u043B\u0451\u043D \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u0022,ko:\u0022\uC11C\uBC84\uC5D0\uC11C \uC0AD\uC81C\uB429\uB2C8\uB2E4\u0022},lae={en:\u0022Create List\u0022,fr:\u0022Cr\u00E9er la Liste\u0022,es:\u0022Crear Lista\u0022,cn:\u0022\u4FDD\u5B58\u519B\u8868\u0022,it:\u0022Crea Lista\u0022,de:\u0022Liste Erstellen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u4F5C\u6210\u0022,pl:\u0022Utw\u00F3rz List\u0119\u0022,pt:\u0022Criar Lista\u0022,hr:\u0022Kreiraj popis\u0022,cz:\u0022Vytvo\u0159it seznam\u0022,sk:\u0022Vytvori\u0165 zoznam\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u039B\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022\uBA85\uB2E8 \uC0DD\uC131\u0022},uae={en:\u0022Cancel\u0022,fr:\u0022Annuler\u0022,es:\u0022Cancelar\u0022,cn:\u0022\u53D6\u6D88\u0022,it:\u0022Annulla\u0022,de:\u0022Abbrechen\u0022,ja:\u0022\u30AD\u30E3\u30F3\u30BB\u30EB\u0022,pl:\u0022Anuluj\u0022,pt:\u0022Cancelar\u0022,hr:\u0022Odustani\u0022,cz:\u0022Zru\u0161it\u0022,sk:\u0022Zru\u0161i\u0165\u0022,gr:\u0022\u0391\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7\u0022,ru:\u0022\u041E\u0442\u043C\u0435\u043D\u0430\u0022,ko:\u0022\uCDE8\uC18C\u0022},cae={en:\u0022New list name\u0022,fr:\u0022Nom de la nouvelle liste\u0022,es:\u0022Nombre de Nueva Lista\u0022,cn:\u0022\u65B0\u519B\u8868\u0022,it:\u0022Nuovo nome lista\u0022,de:\u0022Neuer Listenname\u0022,ja:\u0022\u65B0\u3057\u3044\u30EA\u30B9\u30C8\u540D\u0022,pl:\u0022Nowa nazwa listy\u0022,pt:\u0022Nome da nova lista\u0022,hr:\u0022Naziv novog popisa\u0022,cz:\u0022N\u00E1zev nov\u00E9ho seznamu\u0022,sk:\u0022N\u00E1zov nov\u00E9ho zoznamu\u0022,gr:\u0022\u038C\u03BD\u03BF\u03BC\u03B1 \u03BD\u03AD\u03B1\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043D\u043E\u0432\u043E\u0433\u043E \u0441\u043F\u0438\u0441\u043A\u0430\u0022,ko:\u0022\uC0C8 \uBA85\uB2E8 \uC774\uB984\u0022},Aae={en:\u0022Sync Lists\u0022,fr:\u0022Synchroniser les Listes\u0022,es:\u0022Sync Lists\u0022,cn:\u0022\u540C\u6B65\u519B\u8868\u0022,it:\u0022Sincronizza Liste\u0022,de:\u0022Listen Synchronisieren\u0022,ja:\u0022\u30EA\u30B9\u30C8\u540C\u671F\u0022,pl:\u0022Synchronizuj Listy\u0022,pt:\u0022Sincronizar Listas\u0022,hr:\u0022Sinkroniziraj popise\u0022,cz:\u0022Synchronizovat seznamy\u0022,sk:\u0022Synchronizova\u0165 zoznamy\u0022,gr:\u0022\u03A3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C4\u03CE\u03C1\u03B1\u0022,ru:\u0022\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u0421\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022Sync Lists\u0022},dae={en:\u0022Modify Password\u0022,fr:\u0022Modifier Mot de Passe\u0022,es:\u0022Modificar Contrase\u00F1a\u0022,cn:\u0022\u4FEE\u6539\u5BC6\u7801\u0022,it:\u0022Modifica Password\u0022,de:\u0022Passwort \u00C4ndern\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u5909\u66F4\u0022,pl:\u0022Zmie\u0144 Has\u0142o\u0022,pt:\u0022Modificar Senha\u0022,hr:\u0022Promijeni lozinku\u0022,cz:\u0022Zm\u011Bnit heslo\u0022,sk:\u0022Zmeni\u0165 heslo\u0022,gr:\u0022\u0391\u03BB\u03BB\u03B1\u03B3\u03AE \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0430\u0440\u043E\u043B\u044C\u0022,ko:\u0022Modify Password\u0022},fae={en:\u0022Modify Username\u0022,fr:\u0022Modifier Nom d\u0027Utilisateur\u0022,es:\u0022Modificar Nombre de Usuario\u0022,cn:\u0022\u4FEE\u6539\u7528\u6237\u540D\u0022,it:\u0022Modifica Nome Utente\u0022,de:\u0022Benutzername \u00C4ndern\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u5909\u66F4\u0022,pl:\u0022Zmie\u0144 Nazw\u0119 U\u017Cytkownika\u0022,pt:\u0022Modificar Nome de Usu\u00E1rio\u0022,hr:\u0022Promijeni korisni\u010Dko ime\u0022,cz:\u0022Zm\u011Bnit u\u017Eivatelsk\u00E9 jm\u00E9no\u0022,sk:\u0022Zmeni\u0165 pou\u017E\u00EDvate\u013Esk\u00E9 meno\u0022,gr:\u0022\u0391\u03BB\u03BB\u03B1\u03B3\u03AE \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F\u0022,ko:\u0022Modify Username\u0022},pae={en:\u0022New Username\u0022,fr:\u0022Nouveau Nom d\u0027Utilisateur\u0022,es:\u0022Nuevo Nombre de Usuario\u0022,cn:\u0022\u65B0\u7528\u6237\u540D\u0022,it:\u0022Nuovo Nome Utente\u0022,de:\u0022Neuer Benutzername\u0022,ja:\u0022\u65B0\u3057\u3044\u30E6\u30FC\u30B6\u30FC\u540D\u0022,pl:\u0022Nowa Nazwa U\u017Cytkownika\u0022,pt:\u0022Novo Nome de Usu\u00E1rio\u0022,hr:\u0022Novo korisni\u010Dko ime\u0022,cz:\u0022Nov\u00E9 u\u017Eivatelsk\u00E9 jm\u00E9no\u0022,sk:\u0022Nov\u00E9 pou\u017E\u00EDvate\u013Esk\u00E9 meno\u0022,gr:\u0022\u039D\u03AD\u03BF \u038C\u03BD\u03BF\u03BC\u03B1 \u03A7\u03C1\u03AE\u03C3\u03C4\u03B7\u0022,ru:\u0022\u041D\u043E\u0432\u044B\u0439 \u0418\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F\u0022,ko:\u0022\uC0C8 Username\u0022},hae={en:\u0022New Password\u0022,fr:\u0022Nouveau Mot de Passe\u0022,es:\u0022Nueva Contrase\u00F1a\u0022,cn:\u0022\u65B0\u5BC6\u7801\u0022,it:\u0022Nuova Password\u0022,de:\u0022Neues Passwort\u0022,ja:\u0022\u65B0\u3057\u3044\u30D1\u30B9\u30EF\u30FC\u30C9\u0022,pl:\u0022Nowe Has\u0142o\u0022,pt:\u0022Nova Senha\u0022,hr:\u0022Nova lozinka\u0022,cz:\u0022Nov\u00E9 heslo\u0022,sk:\u0022Nov\u00E9 heslo\u0022,gr:\u0022\u039D\u03AD\u03BF \u039A\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2\u0022,ru:\u0022\u041D\u043E\u0432\u044B\u0439 \u041F\u0430\u0440\u043E\u043B\u044C\u0022,ko:\u0022\uC0C8 Password\u0022},mae={en:\u0022Repeat Password\u0022,fr:\u0022R\u00E9p\u00E9ter le Mot de Passe\u0022,es:\u0022Repetir Contrase\u00F1a\u0022,cn:\u0022\u91CD\u590D\u5BC6\u7801\u0022,it:\u0022Ripeti Password\u0022,de:\u0022Passwort Wiederholen\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u518D\u5165\u529B\u0022,pl:\u0022Powt\u00F3rz Has\u0142o\u0022,pt:\u0022Repetir Senha\u0022,hr:\u0022Ponovite lozinku\u0022,cz:\u0022Zopakovat heslo\u0022,sk:\u0022Zopakova\u0165 heslo\u0022,gr:\u0022\u0395\u03C0\u03B1\u03BD\u03AC\u03BB\u03B7\u03C8\u03B7 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u0430\u0440\u043E\u043B\u044C\u0022,ko:\u0022Repeat Password\u0022},gae={en:\u0022You must be logged in to change your password.\u0022,fr:\u0022Vous devez \u00EAtre connect\u00E9 pour changer votre mot de passe.\u0022,es:\u0022Debes estar conectado para cambiar tu contrase\u00F1a.\u0022,cn:\u0022\u60A8\u5FC5\u987B\u767B\u5F55\u624D\u80FD\u66F4\u6539\u5BC6\u7801\u3002\u0022,it:\u0022Devi essere connesso per cambiare la password.\u0022,de:\u0022Sie m\u00FCssen angemeldet sein, um Ihr Passwort zu \u00E4ndern.\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5909\u66F4\u3059\u308B\u306B\u306F\u30ED\u30B0\u30A4\u30F3\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Musisz by\u0107 zalogowany, aby zmieni\u0107 has\u0142o.\u0022,pt:\u0022Voc\u00EA deve estar logado para alterar sua senha.\u0022,hr:\u0022Morate biti prijavljeni da biste promijenili lozinku.\u0022,cz:\u0022Pro zm\u011Bnu hesla mus\u00EDte b\u00FDt p\u0159ihl\u00E1\u0161eni.\u0022,sk:\u0022Mus\u00EDte by\u0165 prihl\u00E1sen\u00FD, aby ste mohli zmeni\u0165 heslo.\u0022,gr:\u0022\u03A0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03C3\u03C4\u03B5 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0430\u0432\u0442\u043E\u0440\u0438\u0437\u043E\u0432\u0430\u043D\u044B, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u043F\u0430\u0440\u043E\u043B\u044C.\u0022,ko:\u0022You must be logged in to change your password.\u0022},yae={en:\u0022Passwords do not match.\u0022,fr:\u0022Les mots de passe ne correspondent pas.\u0022,es:\u0022Las contrase\u00F1as no coinciden.\u0022,cn:\u0022\u5BC6\u7801\u4E0D\u5339\u914D\u3002\u0022,it:\u0022Le password non corrispondono.\u0022,de:\u0022Passw\u00F6rter stimmen nicht \u00FCberein.\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u4E00\u81F4\u3057\u307E\u305B\u3093\u3002\u0022,pl:\u0022Has\u0142a nie pasuj\u0105.\u0022,pt:\u0022As senhas n\u00E3o correspondem.\u0022,hr:\u0022Lozinke se ne podudaraju.\u0022,cz:\u0022Hesla se neshoduj\u00ED.\u0022,sk:\u0022Hesl\u00E1 sa nezhoduj\u00FA.\u0022,gr:\u0022\u039F\u03B9 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03AF \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03B4\u03B5\u03BD \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03BF\u03C5\u03BD\u0022,ru:\u0022\u041F\u0430\u0440\u043E\u043B\u0438 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442.\u0022,ko:\u0022Passwords do not match.\u0022},wae={en:\u0022Please enter a username.\u0022,fr:\u0022Veuillez entrer un nom d\u0027utilisateur.\u0022,es:\u0022Por favor ingrese un nombre de usuario.\u0022,cn:\u0022\u8BF7\u8F93\u5165\u7528\u6237\u540D\u3002\u0022,it:\u0022Inserisci un nome utente.\u0022,de:\u0022Bitte geben Sie einen Benutzernamen ein.\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Prosz\u0119 wprowadzi\u0107 nazw\u0119 u\u017Cytkownika.\u0022,pt:\u0022Por favor, insira um nome de usu\u00E1rio.\u0022,hr:\u0022Molimo unesite korisni\u010Dko ime.\u0022,cz:\u0022Pros\u00EDm zadejte u\u017Eivatelsk\u00E9 jm\u00E9no.\u0022,sk:\u0022Pros\u00EDm zadajte pou\u017E\u00EDvate\u013Esk\u00E9 meno.\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03AD\u03BD\u03B1 \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7\u0022,ru:\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F.\u0022,ko:\u0022Please enter a username.\u0022},bae={en:\u0022Please enter a password that contains at least 5 characters.\u0022,fr:\u0022Veuillez entrer un mot de passe contenant au moins 5 caract\u00E8res.\u0022,es:\u0022Por favor ingrese una contrase\u00F1a que contenga al menos 5 caracteres.\u0022,cn:\u0022\u8BF7\u8F93\u5165\u81F3\u5C11\u5305\u542B5\u4E2A\u5B57\u7B26\u7684\u5BC6\u7801\u3002\u0022,it:\u0022Inserisci una password che contenga almeno 5 caratteri.\u0022,de:\u0022Bitte geben Sie ein Passwort mit mindestens 5 Zeichen ein.\u0022,ja:\u0022\u5C11\u306A\u304F\u3068\u30825\u6587\u5B57\u3092\u542B\u3080\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Prosz\u0119 wprowadzi\u0107 has\u0142o zawieraj\u0105ce co najmniej 5 znak\u00F3w.\u0022,pt:\u0022Por favor, insira uma senha que contenha pelo menos 5 caracteres.\u0022,hr:\u0022Molimo unesite lozinku koja sadr\u017Ei najmanje 5 znakova.\u0022,cz:\u0022Pros\u00EDm zadejte heslo obsahuj\u00EDc\u00ED alespo\u0148 5 znak\u016F.\u0022,sk:\u0022Pros\u00EDm zadajte heslo, ktor\u00E9 obsahuje minim\u00E1lne 5 znakov.\u0022,gr:\u0022\u039F \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD 5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B5\u03C2\u0022,ru:\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0430\u0440\u043E\u043B\u044C, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 5 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432.\u0022,ko:\u0022Please enter a password that contains at least 5 characters.\u0022},vae={en:\u0022Your username and password have been updated! You will be logged out.\u0022,fr:\u0022Votre nom d\u0027utilisateur et mot de passe ont \u00E9t\u00E9 mis \u00E0 jour ! Vous allez \u00EAtre d\u00E9connect\u00E9.\u0022,es:\u0022\u00A1Tu nombre de usuario y contrase\u00F1a han sido actualizados! Ser\u00E1s desconectado.\u0022,cn:\u0022\u60A8\u7684\u7528\u6237\u540D\u548C\u5BC6\u7801\u5DF2\u66F4\u65B0\uFF01\u60A8\u5C06\u88AB\u6CE8\u9500\u3002\u0022,it:\u0022Il tuo nome utente e password sono stati aggiornati! Verrai disconnesso.\u0022,de:\u0022Ihr Benutzername und Passwort wurden aktualisiert! Sie werden abgemeldet.\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3068\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u66F4\u65B0\u3055\u308C\u307E\u3057\u305F\uFF01\u30ED\u30B0\u30A2\u30A6\u30C8\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Twoja nazwa u\u017Cytkownika i has\u0142o zosta\u0142y zaktualizowane! Zostaniesz wylogowany.\u0022,pt:\u0022Seu nome de usu\u00E1rio e senha foram atualizados! Voc\u00EA ser\u00E1 desconectado.\u0022,hr:\u0022Va\u0161e korisni\u010Dko ime i lozinka su a\u017Eurirani! Bit \u0107ete odjavljeni.\u0022,cz:\u0022Va\u0161e u\u017Eivatelsk\u00E9 jm\u00E9no a heslo byly aktualizov\u00E1ny! Budete odhl\u00E1\u0161eni.\u0022,sk:\u0022Va\u0161e pou\u017E\u00EDvate\u013Esk\u00E9 meno a heslo boli aktualizovan\u00E9! Budete odhl\u00E1sen\u00FD.\u0022,gr:\u0022\u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03BF \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B1\u03BD. \u0398\u03B1 \u03B1\u03C0\u03BF\u03C3\u03C5\u03BD\u03B4\u03B5\u03B8\u03B5\u03AF\u03C4\u03B5.\u0022,ru:\u0022\u0412\u0430\u0448\u0435 \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438 \u043F\u0430\u0440\u043E\u043B\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u044B! \u0412\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u0440\u0430\u0437\u043B\u043E\u0433\u0438\u043D\u0435\u043D\u044B.\u0022,ko:\u0022Your username and password have been updated! You will be logged out.\u0022},kae={en:\u0022Your password has been updated!\u0022,fr:\u0022Votre mot de passe a \u00E9t\u00E9 mis \u00E0 jour !\u0022,es:\u0022\u00A1Tu contrase\u00F1a ha sido actualizada!\u0022,cn:\u0022\u60A8\u7684\u5BC6\u7801\u5DF2\u66F4\u65B0\uFF01\u0022,it:\u0022La tua password \u00E8 stata aggiornata!\u0022,de:\u0022Ihr Passwort wurde aktualisiert!\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u66F4\u65B0\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,pl:\u0022Twoje has\u0142o zosta\u0142o zaktualizowane!\u0022,pt:\u0022Sua senha foi atualizada!\u0022,hr:\u0022Va\u0161a lozinka je a\u017Eurirana!\u0022,cz:\u0022Va\u0161e heslo bylo aktualizov\u00E1no!\u0022,sk:\u0022Va\u0161e heslo bolo aktualizovan\u00E9!\u0022,gr:\u0022\u039F \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5\u0022,ru:\u0022\u0412\u0430\u0448 \u043F\u0430\u0440\u043E\u043B\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0451\u043D!\u0022,ko:\u0022Your password has been updated!\u0022},Bae={en:\u0022This username is already taken!\u0022,fr:\u0022Ce nom d\u0027utilisateur est d\u00E9j\u00E0 pris !\u0022,es:\u0022\u00A1Este nombre de usuario ya est\u00E1 en uso!\u0022,cn:\u0022\u6B64\u7528\u6237\u540D\u5DF2\u88AB\u4F7F\u7528\uFF01\u0022,it:\u0022Questo nome utente \u00E8 gi\u00E0 in uso!\u0022,de:\u0022Dieser Benutzername ist bereits vergeben!\u0022,ja:\u0022\u3053\u306E\u30E6\u30FC\u30B6\u30FC\u540D\u306F\u65E2\u306B\u4F7F\u7528\u3055\u308C\u3066\u3044\u307E\u3059\uFF01\u0022,pl:\u0022Ta nazwa u\u017Cytkownika jest ju\u017C zaj\u0119ta!\u0022,pt:\u0022Este nome de usu\u00E1rio j\u00E1 est\u00E1 em uso!\u0022,hr:\u0022Ovo korisni\u010Dko ime je ve\u0107 zauzeto!\u0022,cz:\u0022Toto u\u017Eivatelsk\u00E9 jm\u00E9no je ji\u017E obsazeno!\u0022,sk:\u0022Toto pou\u017E\u00EDvate\u013Esk\u00E9 meno je u\u017E obsaden\u00E9!\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9 \u03AE\u03B4\u03B7\u0022,ru:\u0022\u042D\u0442\u043E \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u0442\u043E!\u0022,ko:\u0022This username is already taken!\u0022},Cae={en:\u0022Error while updating your username and password!\u0022,fr:\u0022Erreur lors de la mise \u00E0 jour de votre nom d\u0027utilisateur et mot de passe !\u0022,es:\u0022\u00A1Error al actualizar tu nombre de usuario y contrase\u00F1a!\u0022,cn:\u0022\u66F4\u65B0\u7528\u6237\u540D\u548C\u5BC6\u7801\u65F6\u51FA\u9519\uFF01\u0022,it:\u0022Errore durante l\u0027aggiornamento del nome utente e password!\u0022,de:\u0022Fehler beim Aktualisieren Ihres Benutzernamens und Passworts!\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3068\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u66F4\u65B0\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\uFF01\u0022,pl:\u0022B\u0142\u0105d podczas aktualizacji nazwy u\u017Cytkownika i has\u0142a!\u0022,pt:\u0022Erro ao atualizar seu nome de usu\u00E1rio e senha!\u0022,hr:\u0022Gre\u0161ka prilikom a\u017Euriranja korisni\u010Dkog imena i lozinke!\u0022,cz:\u0022Chyba p\u0159i aktualizaci u\u017Eivatelsk\u00E9ho jm\u00E9na a hesla!\u0022,sk:\u0022Chyba pri aktualiz\u00E1cii v\u00E1\u0161ho pou\u017E\u00EDvate\u013Esk\u00E9ho mena a hesla!\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u0438\u043C\u0435\u043D\u0438 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438 \u043F\u0430\u0440\u043E\u043B\u044F!\u0022,ko:\u0022Error while updating your username and password!\u0022},_ae={en:\u0022Error while updating your password!\u0022,fr:\u0022Erreur lors de la mise \u00E0 jour de votre mot de passe !\u0022,es:\u0022\u00A1Error al actualizar tu contrase\u00F1a!\u0022,cn:\u0022\u66F4\u65B0\u5BC6\u7801\u65F6\u51FA\u9519\uFF01\u0022,it:\u0022Errore durante l\u0027aggiornamento della password!\u0022,de:\u0022Fehler beim Aktualisieren Ihres Passworts!\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u66F4\u65B0\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\uFF01\u0022,pl:\u0022B\u0142\u0105d podczas aktualizacji has\u0142a!\u0022,pt:\u0022Erro ao atualizar sua senha!\u0022,hr:\u0022Gre\u0161ka prilikom a\u017Euriranja lozinke!\u0022,cz:\u0022Chyba p\u0159i aktualizaci hesla!\u0022,sk:\u0022Chyba pri aktualiz\u00E1cii v\u00E1\u0161ho hesla!\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u043F\u0430\u0440\u043E\u043B\u044F!\u0022,ko:\u0022Error while updating your password!\u0022},Sae={en:\u0022Cannot change password: Unable to connect!\u0022,fr:\u0022Impossible de changer le mot de passe : Connexion impossible !\u0022,es:\u0022No se puede cambiar la contrase\u00F1a: \u00A1No se pudo conectar!\u0022,cn:\u0022\u65E0\u6CD5\u66F4\u6539\u5BC6\u7801\uFF1A\u65E0\u6CD5\u8FDE\u63A5\uFF01\u0022,it:\u0022Impossibile cambiare password: Impossibile connettersi!\u0022,de:\u0022Passwort kann nicht ge\u00E4ndert werden: Verbindung fehlgeschlagen!\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5909\u66F4\u3067\u304D\u307E\u305B\u3093\uFF1A\u63A5\u7D9A\u3067\u304D\u307E\u305B\u3093\uFF01\u0022,pl:\u0022Nie mo\u017Cna zmieni\u0107 has\u0142a: Nie mo\u017Cna po\u0142\u0105czy\u0107!\u0022,pt:\u0022N\u00E3o \u00E9 poss\u00EDvel alterar a senha: N\u00E3o foi poss\u00EDvel conectar!\u0022,hr:\u0022Nije mogu\u0107e promijeniti lozinku: Nemogu\u0107e se povezati!\u0022,cz:\u0022Nelze zm\u011Bnit heslo: P\u0159ipojen\u00ED se nezda\u0159ilo!\u0022,sk:\u0022Nemo\u017Eno zmeni\u0165 heslo: Ned\u00E1 sa pripoji\u0165!\u0022,gr:\u0022\u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03C3\u03C4\u03BF \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03C4\u03C5\u03BF\u0022,ru:\u0022\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0430\u0440\u043E\u043B\u044C: \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F!\u0022,ko:\u0022Cannot change password: Unable to connect!\u0022},Eae={en:\u0022You must enter a password (you can use your current password if you only want to change your username).\u0022,fr:\u0022Vous devez entrer un mot de passe (vous pouvez utiliser votre mot de passe actuel si vous souhaitez seulement changer votre nom d\u0027utilisateur).\u0022,es:\u0022Debes ingresar una contrase\u00F1a (puedes usar tu contrase\u00F1a actual si solo quieres cambiar tu nombre de usuario).\u0022,cn:\u0022\u60A8\u5FC5\u987B\u8F93\u5165\u5BC6\u7801\uFF08\u5982\u679C\u60A8\u53EA\u60F3\u66F4\u6539\u7528\u6237\u540D\uFF0C\u53EF\u4EE5\u4F7F\u7528\u5F53\u524D\u5BC6\u7801\uFF09\u3002\u0022,it:\u0022Devi inserire una password (puoi usare la tua password attuale se vuoi solo cambiare il tuo nome utente).\u0022,de:\u0022Sie m\u00FCssen ein Passwort eingeben (Sie k\u00F6nnen Ihr aktuelles Passwort verwenden, wenn Sie nur Ihren Benutzernamen \u00E4ndern m\u00F6chten).\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5165\u529B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\uFF08\u30E6\u30FC\u30B6\u30FC\u540D\u306E\u307F\u3092\u5909\u66F4\u3057\u305F\u3044\u5834\u5408\u306F\u3001\u73FE\u5728\u306E\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u4F7F\u7528\u3067\u304D\u307E\u3059\uFF09\u3002\u0022,pl:\u0022Musisz wprowadzi\u0107 has\u0142o (mo\u017Cesz u\u017Cy\u0107 swojego obecnego has\u0142a, je\u015Bli chcesz tylko zmieni\u0107 nazw\u0119 u\u017Cytkownika).\u0022,pt:\u0022Voc\u00EA deve inserir uma senha (voc\u00EA pode usar sua senha atual se quiser apenas alterar seu nome de usu\u00E1rio).\u0022,hr:\u0022Morate unijeti lozinku (mo\u017Eete koristiti trenutnu lozinku ako \u017Eelite promijeniti samo korisni\u010Dko ime).\u0022,cz:\u0022Mus\u00EDte zadat heslo (m\u016F\u017Eete pou\u017E\u00EDt sv\u00E9 sou\u010Dasn\u00E9 heslo, pokud chcete zm\u011Bnit pouze u\u017Eivatelsk\u00E9 jm\u00E9no).\u0022,sk:\u0022Mus\u00EDte zada\u0165 heslo (m\u00F4\u017Eete pou\u017Ei\u0165 aktu\u00E1lne heslo, ak chcete zmeni\u0165 len pou\u017E\u00EDvate\u013Esk\u00E9 meno).\u0022,gr:\u0022\u0395\u03AC\u03BD \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03C3\u03B1\u03C2, \u03B8\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF \u03BD\u03AD\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B8\u03B5\u03AF\u03C4\u03B5 \u03C3\u03C4\u03BF \u03BC\u03AD\u03BB\u03BB\u03BF\u03BD\u0022,ru:\u0022\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0432\u0432\u0435\u0441\u0442\u0438 \u043F\u0430\u0440\u043E\u043B\u044C (\u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0439 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u0430\u0440\u043E\u043B\u044C, \u0435\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F).\u0022,ko:\u0022You must enter a password (you can use your current password if you only want to change your username).\u0022},jae={en:\u0022Log Out\u0022,fr:\u0022D\u00E9connexion\u0022,es:\u0022Log Out\u0022,cn:\u0022\u767B\u51FA\u0022,it:\u0022Disconnetti\u0022,de:\u0022Abmelden\u0022,ja:\u0022\u30ED\u30B0\u30A2\u30A6\u30C8\u0022,pl:\u0022Wyloguj si\u0119\u0022,pt:\u0022Sair\u0022,hr:\u0022Odjava\u0022,cz:\u0022Odhl\u00E1sit se\u0022,sk:\u0022Odhl\u00E1si\u0165 sa\u0022,gr:\u0022Log Out\u0022,ru:\u0022\u0412\u044B\u0439\u0442\u0438\u0022,ko:\u0022Log Out\u0022},zae={en:\u0022Force Update\u0022,fr:\u0022Forcer la Mise \u00E0 Jour\u0022,es:\u0022Force Update\u0022,cn:\u0022\u5F3A\u5236\u5347\u7EA7\u0022,it:\u0022Forza Aggiornamento\u0022,de:\u0022Update Erzwingen\u0022,ja:\u0022\u5F37\u5236\u66F4\u65B0\u0022,pl:\u0022Wymu\u015B Aktualizacj\u0119\u0022,pt:\u0022For\u00E7ar Atualiza\u00E7\u00E3o\u0022,hr:\u0022Prisilno a\u017Euriranje\u0022,cz:\u0022Vynutit aktualizaci\u0022,sk:\u0022Vyn\u00FAti\u0165 aktualiz\u00E1ciu\u0022,gr:\u0022\u0394\u03CD\u03BD\u03B1\u03BC\u03B7 \u0395\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7\u0022,ru:\u0022\u0410\u0440\u043C\u0438\u044F \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\u0022,ko:\u0022Force Update\u0022},Iae={en:\u0022Uninstall\u0022,fr:\u0022D\u00E9sinstaller\u0022,es:\u0022Uninstall\u0022,cn:\u0022\u5378\u8F7D\u0022,it:\u0022Disinstalla\u0022,de:\u0022Deinstallieren\u0022,ja:\u0022\u30A2\u30F3\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u0022,pl:\u0022Odinstaluj\u0022,pt:\u0022Desinstalar\u0022,hr:\u0022Deinstaliraj\u0022,cz:\u0022Odinstalovat\u0022,sk:\u0022Odin\u0161talova\u0165\u0022,gr:\u0022\u0391\u03C0\u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C\u0022,ko:\u0022Uninstall\u0022},Pae={en:\u0022Back to Army Lists\u0022,fr:\u0022Retour vers les Listes\u0022,es:\u0022Back to Army Lists\u0022,cn:\u0022\u8FD4\u56DE\u519B\u8868\u0022,it:\u0022Torna alle Liste d\u0027Armata\u0022,de:\u0022Zur\u00FCck zu Armeelisten\u0022,ja:\u0022\u30A2\u30FC\u30DF\u30FC\u30EA\u30B9\u30C8\u306B\u623B\u308B\u0022,pl:\u0022Powr\u00F3t do list armii\u0022,pt:\u0022Voltar para Listas de Ex\u00E9rcito\u0022,hr:\u0022Natrag na popise vojski\u0022,cz:\u0022Zp\u011Bt na seznamy arm\u00E1d\u0022,sk:\u0022Sp\u00E4\u0165 na zoznamy arm\u00E1d\u0022,gr:\u0022\u0395\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE \u03C3\u03C4\u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC\u0022,ru:\u0022\u041D\u0430\u0437\u0430\u0434 \u043A \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u043C \u0441\u043F\u0438\u0441\u043A\u0430\u043C\u0022,ko:\u0022Back to Army Lists\u0022},Tae={en:\u0022Contact / Legal Info\u0022,fr:\u0022Contact / Info L\u00E9gales\u0022,es:\u0022Contact / Legal Info\u0022,cn:\u0022\u8054\u7CFB\u6211/\u6CD5\u5F8B\u4FE1\u606F\u0022,it:\u0022Contatto / Informazioni Legali\u0022,de:\u0022Kontakt / Rechtliche Informationen\u0022,ja:\u0022\u304A\u554F\u3044\u5408\u308F\u305B / \u6CD5\u7684\u60C5\u5831\u0022,pl:\u0022Kontakt / Informacje Prawne\u0022,pt:\u0022Contato / Informa\u00E7\u00F5es Legais\u0022,hr:\u0022Kontakt / Pravne informacije\u0022,cz:\u0022Kontakt / Pr\u00E1vn\u00ED informace\u0022,sk:\u0022Kontakt / Pr\u00E1vne inform\u00E1cie\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1 / \u039D\u03CC\u03BC\u03B9\u03BC\u03BF \u03A0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u0022,ru:\u0022\u041A\u043E\u043D\u0442\u0430\u043A\u0442\u044B / \u042E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0022,ko:\u0022Contact / Legal Info\u0022},Nae={en:\u0022You can contact me in English or French.\u003Cbr/\u003E\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\u003C/strong\u003E\u0022,fr:\u0022Vous pouvez me contacter en anglais ou en fran\u00E7ais. Privil\u00E9giez DISCORD. Il y a des canaux pour les rapports de bug. S\u0027il s\u0027agit d\u0027un souci concernant les abonnements, les payments un remboursement, vous pouvez m\u0027envoyer un message priv\u00E9 sur Discord (@Flammy), mais \u00E9galement envoyer un mail.\u003Cbr/\u003E\u003Cbr/\u003ESVP ne m\u0027envoyez pas d\u0027email concernant les \u003Cstrong\u003EDONNEES DES JEUX (erreurs de points, options ou unit\u00E9s manquantes...)\u003C/strong\u003E, il y a des canaux Discord d\u00E9di\u00E9s pour cela, SVP lisez les r\u00E8gles sur le canal RULES avant de poster un rapport de bug.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EJe r\u00E9pondrai en g\u00E9n\u00E9ral plus vite pour toutes les demandes faites via Discord.\u003C/strong\u003E\u0022,es:\u0022You can contact me in English or French.\u003Cbr/\u003E\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\u003C/strong\u003E\u0022,cn:\u0022You can contact me in English or French.\u003Cbr/\u003E\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\u003C/strong\u003E\u0022,it:\u0022Puoi contattarmi in inglese o francese.\u003Cbr/\u003E\u003Cbr/\u003ESe si tratta di abbonamenti, pagamenti, rimborsi, sentiti libero di inviarmi un messaggio privato (@Flammy su Discord) se desideri una risposta pi\u00F9 veloce.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EUtilizza la funzione di segnalazione dati nell\u0027app per tutti i problemi relativi ai dati di gioco!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003ERisponder\u00F2 sempre pi\u00F9 velocemente su Discord.\u003C/strong\u003E\u0022,de:\u0022Sie k\u00F6nnen mich auf Englisch oder Franz\u00F6sisch kontaktieren.\u003Cbr/\u003E\u003Cbr/\u003EWenn es sich um Abonnements, Zahlungen oder R\u00FCckerstattungen handelt, k\u00F6nnen Sie mir gerne eine private Nachricht (@Flammy auf Discord) senden, wenn Sie eine schnellere Antwort w\u00FCnschen.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EBitte verwenden Sie die In-App-Funktion \u0027Datenproblem Melden\u0027 f\u00FCr alle spielbezogenen Datenprobleme!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EIch antworte auf Discord immer schneller.\u003C/strong\u003E\u0022,ja:\u0022\u82F1\u8A9E\u307E\u305F\u306F\u30D5\u30E9\u30F3\u30B9\u8A9E\u3067\u3054\u9023\u7D61\u304F\u3060\u3055\u3044\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3001\u652F\u6255\u3044\u3001\u8FD4\u91D1\u306B\u95A2\u3059\u308B\u554F\u984C\u306B\u3064\u3044\u3066\u306F\u3001\u3088\u308A\u8FC5\u901F\u306A\u8FD4\u4FE1\u304C\u5FC5\u8981\u306A\u5834\u5408\u306FDiscord\u3067\u79C1\u306B\u30D7\u30E9\u30A4\u30D9\u30FC\u30C8\u30E1\u30C3\u30BB\u30FC\u30B8(@Flammy)\u3092\u304A\u9001\u308A\u304F\u3060\u3055\u3044\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003E\u30B2\u30FC\u30E0\u30C7\u30FC\u30BF\u306B\u95A2\u3059\u308B\u3059\u3079\u3066\u306E\u554F\u984C\u306B\u3064\u3044\u3066\u306F\u3001\u30A2\u30D7\u30EA\u5185\u306E\u30C7\u30FC\u30BF\u554F\u984C\u5831\u544A\u6A5F\u80FD\u3092\u3054\u5229\u7528\u304F\u3060\u3055\u3044\uFF01\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EDiscord\u3067\u306F\u5E38\u306B\u3088\u308A\u65E9\u304F\u8FD4\u4FE1\u3057\u307E\u3059\u3002\u003C/strong\u003E\u0022,pl:\u0022Mo\u017Cesz skontaktowa\u0107 si\u0119 ze mn\u0105 po angielsku lub francusku.\u003Cbr/\u003E\u003Cbr/\u003EJe\u015Bli sprawa dotyczy subskrypcji, p\u0142atno\u015Bci lub zwrot\u00F3w, wy\u015Blij mi wiadomo\u015B\u0107 prywatn\u0105 (@Flammy na Discord), je\u015Bli potrzebujesz szybszej odpowiedzi.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EProsz\u0119 u\u017Cywa\u0107 funkcji zg\u0142aszania problem\u00F3w z danymi w aplikacji dla wszystkich zagadnie\u0144 zwi\u0105zanych z danymi gry!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EZawsze odpowiem szybciej na Discord.\u003C/strong\u003E\u0022,pt:\u0022Voc\u00EA pode me contatar em ingl\u00EAs ou franc\u00EAs.\u003Cbr/\u003E\u003Cbr/\u003ESe for um assunto relacionado a assinaturas, pagamentos ou reembolsos, sinta-se \u00E0 vontade para me enviar uma mensagem privada (@Flammy no Discord) se quiser uma resposta mais r\u00E1pida.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPor favor, use o recurso Reportar Problema de Dados no aplicativo para todos os problemas relacionados aos dados do jogo!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003ESempre responderei mais r\u00E1pido no Discord.\u003C/strong\u003E\u0022,hr:\u0022Mo\u017Eete me kontaktirati na engleskom ili francuskom.\u003Cbr/\u003E\u003Cbr/\u003EAko je rije\u010D o pretplatama, pla\u0107anjima ili povratima novca, slobodno mi po\u0161aljite privatnu poruku (@Flammy na Discord) ako \u017Eelite br\u017Ei odgovor.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EMolimo koristite prijavu problema s podacima u aplikaciji za sve probleme vezane uz podatke igre!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EUvijek \u0107u odgovoriti br\u017Ee na Discord.\u003C/strong\u003E\u0022,cz:\u0022You can contact me in English or French.\u003Cbr/\u003E\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\u003C/strong\u003E\u0022,sk:\u0022You can contact me in English or French.\u003Cbr/\u003E\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\u003C/strong\u003E\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03BC\u03B1\u03B6\u03AF \u03BC\u03BF\u03C5 (\u0391\u03B3\u03B3\u03BB\u03B9\u03BA\u03AC \u03AE \u0393\u03B1\u03BB\u03BB\u03B9\u03BA\u03AC)\u0022,ru:\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u043D\u0430 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C \u0438\u043B\u0438 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u043C \u044F\u0437\u044B\u043A\u0435\u0022,ko:\u0022You can contact me in English or French.\u003Cbr/\u003E\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\u003Cbr/\u003E\u003Cbr/\u003E\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\u003C/b\u003E\u003Cbr/\u003E\u003Cbr/\u003E\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\u003C/strong\u003E\u0022},Fae={en:\u0022Pending Tournaments\u0022,fr:\u0022Tournois en Pr\u00E9paration\u0022,es:\u0022Pending Tournaments\u0022,cn:\u0022Pending Tournaments\u0022,it:\u0022Tornei in Attesa\u0022,de:\u0022Ausstehende Turniere\u0022,ja:\u0022\u4FDD\u7559\u4E2D\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u0022,pl:\u0022Oczekuj\u0105ce Turnieje\u0022,pt:\u0022Torneios Pendentes\u0022,hr:\u0022Turniri na \u010Dekanju\u0022,cz:\u0022P\u0159ipravovan\u00E9 turnaje\u0022,sk:\u0022\u010Cakaj\u00FAce turnaje\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B5\u03C7\u03AE \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0422\u0443\u0440\u043D\u0438\u0440\u044B\u0022,ko:\u0022Pending Tournaments\u0022},Rae={en:\u0022Open Tournaments\u0022,fr:\u0022Tournois Ouverts\u0022,es:\u0022Open Tournaments\u0022,cn:\u0022Open Tourname