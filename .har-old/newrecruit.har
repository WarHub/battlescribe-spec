\u0022\u0418\u0433\u0440\u043E\u043A \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0022,ko:\u0022Player added!\u0022},wTe={en:\u0022Team Name\u0022,fr:\u0022Nom de l\u0027\u00C9quipe\u0022,es:\u0022Nombre del Equipo\u0022,cn:\u0022\u961F\u4F0D\u540D\u79F0\u0022,it:\u0022Nome Squadra\u0022,de:\u0022Team Name\u0022,ja:\u0022\u30C1\u30FC\u30E0\u540D\u0022,pl:\u0022Nazwa Dru\u017Cyny\u0022,pt:\u0022Nome da Equipe\u0022,hr:\u0022Naziv tima\u0022,cz:\u0022Team Name\u0022,sk:\u0022Team Name\u0022,gr:\u0022\u039F\u03BC\u03AC\u03B4\u03B1 \u038C\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Team Name\u0022},bTe={en:\u0022Confirm\u0022,fr:\u0022Confirmer\u0022,es:\u0022Confirmar\u0022,cn:\u0022\u786E\u8BA4\u0022,it:\u0022Conferma\u0022,de:\u0022Best\u00E4tigen\u0022,ja:\u0022\u78BA\u8A8D\u0022,pl:\u0022Potwierd\u017A\u0022,pt:\u0022Confirmar\u0022,hr:\u0022Potvrdi\u0022,cz:\u0022Confirm\u0022,sk:\u0022Potvrdi\u0165\u0022,gr:\u0022\u0395\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7\u0022,ru:\u0022\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C\u0022,ko:\u0022\uD655\uC778\u0022},vTe={en:\u0022 (npc)\u0022,fr:\u0022 (pnj)\u0022,es:\u0022 (pnj)\u0022,cn:\u0022 (npc)\u0022,it:\u0022 (png)\u0022,de:\u0022 (npc)\u0022,ja:\u0022 (npc)\u0022,pl:\u0022 (npc)\u0022,pt:\u0022 (npc)\u0022,hr:\u0022 (npc)\u0022,cz:\u0022 (npc)\u0022,sk:\u0022 (npc)\u0022,gr:\u0022 (npc)\u0022,ru:\u0022 (NPC)\u0022,ko:\u0022 (npc)\u0022},kTe={en:\u0022Has a New Recruit account\u0022,fr:\u0022A un compte New Recruit\u0022,es:\u0022Tiene una cuenta de New Recruit\u0022,cn:\u0022\u6709\u65B0\u5175\u8D26\u6237\u0022,it:\u0022Ha un account New Recruit\u0022,de:\u0022Has a New Recruit account\u0022,ja:\u0022New Recruit\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u6301\u3063\u3066\u3044\u307E\u3059\u0022,pl:\u0022Posiada konto New Recruit\u0022,pt:\u0022Possui uma conta New Recruit\u0022,hr:\u0022Ima New Recruit ra\u010Dun\u0022,cz:\u0022Has a New Recruit account\u0022,sk:\u0022Has a New Recruit account\u0022,gr:\u0022\u0388\u03C7\u03B5\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC New Recruit\u0022,ru:\u0022\u0418\u043C\u0435\u0435\u0442 \u0443\u0447\u0435\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C New Recruit\u0022,ko:\u0022Has a New Recruit account\u0022},BTe={en:\u0022No list validation status\u0022,fr:\u0022Aucun statut de validation de liste\u0022,es:\u0022Sin estado de validaci\u00F3n de lista\u0022,cn:\u0022\u65E0\u5217\u8868\u9A8C\u8BC1\u72B6\u6001\u0022,it:\u0022Nessuno stato di convalida lista\u0022,de:\u0022No list validation status\u0022,ja:\u0022\u30EA\u30B9\u30C8\u691C\u8A3C\u30B9\u30C6\u30FC\u30BF\u30B9\u304C\u3042\u308A\u307E\u305B\u3093\u0022,pl:\u0022Brak statusu walidacji listy\u0022,pt:\u0022Sem status de valida\u00E7\u00E3o de lista\u0022,hr:\u0022Nema statusa validacije liste\u0022,cz:\u0022No list validation status\u0022,sk:\u0022No list validation status\u0022,gr:\u0022\u039A\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03B5\u03C0\u03B9\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2 \u03BC\u03B7 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7\u0022,ru:\u0022\u0421\u0442\u0430\u0442\u0443\u0441 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0441\u043F\u0438\u0441\u043A\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D\u0022,ko:\u0022No list validation status\u0022},CTe={en:\u0022Lists all valid\u0022,fr:\u0022Toutes les listes sont valides\u0022,es:\u0022Todas las listas son v\u00E1lidas\u0022,cn:\u0022\u6240\u6709\u5217\u8868\u90FD\u6709\u6548\u0022,it:\u0022Tutte le liste sono valide\u0022,de:\u0022Lists all valid\u0022,ja:\u0022\u3059\u3079\u3066\u306E\u30EA\u30B9\u30C8\u304C\u6709\u52B9\u3067\u3059\u0022,pl:\u0022Wszystkie listy s\u0105 prawid\u0142owe\u0022,pt:\u0022Todas as listas v\u00E1lidas\u0022,hr:\u0022Sve liste su valjane\u0022,cz:\u0022Lists all valid\u0022,sk:\u0022Lists all valid\u0022,gr:\u0022\u038C\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B5\u03C2\u0022,ru:\u0022\u0412\u0441\u0435 \u0441\u043F\u0438\u0441\u043A\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0022,ko:\u0022Lists all valid\u0022},_Te={en:\u0022Lists have errors\u0022,fr:\u0022Les listes ont des erreurs\u0022,es:\u0022Las listas tienen errores\u0022,cn:\u0022\u5217\u8868\u6709\u9519\u8BEF\u0022,it:\u0022Le liste hanno errori\u0022,de:\u0022Lists have errors\u0022,ja:\u0022\u30EA\u30B9\u30C8\u306B\u30A8\u30E9\u30FC\u304C\u3042\u308A\u307E\u3059\u0022,pl:\u0022Listy zawieraj\u0105 b\u0142\u0119dy\u0022,pt:\u0022As listas t\u00EAm erros\u0022,hr:\u0022Liste imaju gre\u0161ke\u0022,cz:\u0022Lists have errors\u0022,sk:\u0022Lists have errors\u0022,gr:\u0022\u039F\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03AD\u03C7\u03BF\u03C5\u03BD \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\u03C4\u03B1\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043A\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442 \u043E\u0448\u0438\u0431\u043A\u0438\u0022,ko:\u0022Lists have errors\u0022},STe={en:\u0022This player does not have the correct number of lists\u0022,fr:\u0022Ce joueur n\u0027a pas le bon nombre de listes\u0022,es:\u0022Este jugador no tiene el n\u00FAmero correcto de listas\u0022,cn:\u0022\u6B64\u73A9\u5BB6\u6CA1\u6709\u6B63\u786E\u7684\u5217\u8868\u6570\u91CF\u0022,it:\u0022Questo giocatore non ha il numero corretto di liste\u0022,de:\u0022This player does not have the correct number of lists\u0022,ja:\u0022\u3053\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u6B63\u3057\u3044\u6570\u306E\u30EA\u30B9\u30C8\u3092\u6301\u3063\u3066\u3044\u307E\u305B\u3093\u0022,pl:\u0022Ten gracz nie ma poprawnej liczby list\u0022,pt:\u0022Este jogador n\u00E3o possui o n\u00FAmero correto de listas\u0022,hr:\u0022Igra\u010D ima neto\u010Dan broj lista\u0022,cz:\u0022This player does not have the correct number of lists\u0022,sk:\u0022This player does not have the correct number of lists\u0022,gr:\u0022\u039F \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03AD\u03C7\u03B5\u03B9 \u03BB\u03AC\u03B8\u03BF\u03C2 \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD\u0022,ru:\u0022\u041D\u0435\u0432\u0435\u0440\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u043F\u0438\u0441\u043A\u043E\u0432 \u0443 \u0438\u0433\u0440\u043E\u043A\u0430\u0022,ko:\u0022This player does not have the correct number of lists\u0022},ETe={en:\u0022Failed to update participant name. Please try again.\u0022,fr:\u0022\u00C9chec de la mise \u00E0 jour du nom du participant. Veuillez r\u00E9essayer.\u0022,es:\u0022Error al actualizar el nombre del participante. Int\u00E9ntalo de nuevo.\u0022,cn:\u0022\u66F4\u65B0\u53C2\u4E0E\u8005\u59D3\u540D\u5931\u8D25\u3002\u8BF7\u91CD\u8BD5\u3002\u0022,it:\u0022Impossibile aggiornare il nome del partecipante. Riprova.\u0022,de:\u0022Failed to update participant name. Please try again.\u0022,ja:\u0022\u53C2\u52A0\u8005\u540D\u306E\u66F4\u65B0\u306B\u5931\u6557\u3057\u307E\u3057\u305F\u3002\u3082\u3046\u4E00\u5EA6\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Nie uda\u0142o si\u0119 zaktualizowa\u0107 nazwy uczestnika. Prosz\u0119 spr\u00F3bowa\u0107 ponownie.\u0022,pt:\u0022Falha ao atualizar nome do participante. Por favor, tente novamente.\u0022,hr:\u0022Neuspje\u0161no a\u017Euriranje imena sudionika\u0022,cz:\u0022Failed to update participant name. Please try again.\u0022,sk:\u0022Failed to update participant name. Please try again.\u0022,gr:\u0022\u0397 \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C4\u03BF\u03C5 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03BF\u03BD\u03C4\u03B1 \u03B1\u03C0\u03AD\u03C4\u03C5\u03C7\u03B5\u0022,ru:\u0022\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0438\u043C\u044F \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u0022,ko:\u0022Failed to update participant name. Please try again.\u0022},jTe={en:\u0022You cannot kick yourself from the team! You may signout from the tournament instead.\u0022,fr:\u0022Vous ne pouvez pas vous expulser de l\u0027\u00E9quipe ! Vous pouvez vous d\u00E9connecter du tournoi \u00E0 la place.\u0022,es:\u0022\u00A1No puedes expulsarte a ti mismo del equipo! Puedes desconectarte del torneo en su lugar.\u0022,cn:\u0022\u4F60\u4E0D\u80FD\u628A\u81EA\u5DF1\u8E22\u51FA\u961F\u4F0D\uFF01\u4F60\u53EF\u4EE5\u9000\u51FA\u6BD4\u8D5B\u3002\u0022,it:\u0022Non puoi espellere te stesso dalla squadra! Puoi invece disconnetterti dal torneo.\u0022,de:\u0022You cannot kick yourself from the team! You may signout from the tournament instead.\u0022,ja:\u0022\u81EA\u5206\u81EA\u8EAB\u3092\u30C1\u30FC\u30E0\u304B\u3089\u9664\u540D\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093\uFF01\u4EE3\u308F\u308A\u306B\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u304B\u3089\u30B5\u30A4\u30F3\u30A2\u30A6\u30C8\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Nie mo\u017Cesz wyrzuci\u0107 siebie z dru\u017Cyny! Mo\u017Cesz zamiast tego wylogowa\u0107 si\u0119 z turnieju.\u0022,pt:\u0022Voc\u00EA n\u00E3o pode expulsar a si mesmo da equipe! Voc\u00EA pode sair do torneio em vez disso.\u0022,hr:\u0022Ne mo\u017Eete izbaciti sebe\u0022,cz:\u0022You cannot kick yourself from the team! You may signout from the tournament instead.\u0022,sk:\u0022You cannot kick yourself from the team! You may signout from the tournament instead.\u0022,gr:\u0022\u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03B2\u03AC\u03BB\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03B5\u03B1\u03C5\u03C4\u03CC \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0412\u044B \u043D\u0435 \u043C\u043