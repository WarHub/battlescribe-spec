3B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 API\u0022,ru:\u0022\u0424\u0443\u043D\u043A\u0446\u0438\u044F API\u0022,ko:\u0022API Function\u0022},A0e={en:\u0022To delete your account, please click on the button below.\u0022,fr:\u0022Pour supprimer votre compte, veuillez cliquer sur le bouton ci-dessous.\u0022,es:\u0022Para eliminar su cuenta, haga clic en el bot\u00F3n de abajo.\u0022,cn:\u0022\u8981\u5220\u9664\u60A8\u7684\u8D26\u6237\uFF0C\u8BF7\u70B9\u51FB\u4E0B\u9762\u7684\u6309\u94AE\u3002\u0022,it:\u0022To delete your account, please click on the button below.\u0022,de:\u0022Um Ihr Konto zu l\u00F6schen, klicken Sie bitte auf die Schaltfl\u00E4che unten.\u0022,ja:\u0022 \u524A\u9664 \u3042\u306A\u305F\u306E \u30A2\u30AB\u30A6\u30F3\u30C8, \u304A\u9858\u3044\u3057\u307E\u3059 \u30AF\u30EA\u30C3\u30AF \u30AA\u30F3  \u30DC\u30BF\u30F3 \u4E0B\u306B.\u0022,pl:\u0022Aby usun\u0105\u0107 swoje konto, kliknij przycisk poni\u017Cej.\u0022,pt:\u0022Para excluir sua conta, clique no bot\u00E3o abaixo.\u0022,hr:\u0022Za brisanje va\u0161eg ra\u010Duna, kliknite na gumb ispod.\u0022,cz:\u0022To delete your account, please click on the button below.\u0022,sk:\u0022To delete your account, please click on the button below.\u0022,gr:\u0022\u0393\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC \u03C3\u03B1\u03C2, \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03BA\u03AC\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B9\u03BA \u03C3\u03C4\u03BF \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03C4\u03C9 \u03BA\u03BF\u03C5\u03BC\u03C0\u03AF.\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438 \u043D\u0435\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u043E\u0022,ko:\u0022To delete your account, please click on the button below.\u0022},d0e={en:\u0022Your email address, Discord username, real name will be permanently deleted from the New Recruit database.\u0022,fr:\u0022Votre adresse e-mail, nom d\u0027utilisateur Discord, nom r\u00E9el seront d\u00E9finitivement supprim\u00E9s de la base de donn\u00E9es New Recruit.\u0022,es:\u0022Su direcci\u00F3n de correo electr\u00F3nico, nombre de usuario de Discord, nombre real se eliminar\u00E1n permanentemente de la base de datos de New Recruit.\u0022,cn:\u0022\u60A8\u7684\u7535\u5B50\u90AE\u4EF6\u5730\u5740\u3001Discord\u7528\u6237\u540D\u3001\u771F\u5B9E\u59D3\u540D\u5C06\u4ECENew Recruit\u6570\u636E\u5E93\u4E2D\u6C38\u4E45\u5220\u9664\u3002\u0022,it:\u0022Your email address, Discord username, real name will be permanently deleted from the Nuovo Recruit database.\u0022,de:\u0022Ihre E-Mail-Adresse, Ihr Discord-Benutzername und Ihr richtiger Name werden dauerhaft aus der New Recruit-Datenbank gel\u00F6scht.\u0022,ja:\u0022\u3042\u306A\u305F\u306E \u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9, Discord\u30E6\u30FC\u30B6\u30FC\u540D, real \u540D\u524D \u3057\u307E\u3059 be permanently \u524A\u9664d \u304B\u3089  \u65B0\u898F Recruit \u30C7\u30FC\u30BFbase.\u0022,pl:\u0022Tw\u00F3j adres e-mail, nazwa u\u017Cytkownika Discord, prawdziwe imi\u0119 zostan\u0105 trwale usuni\u0119te z bazy danych New Recruit.\u0022,pt:\u0022Seu endere\u00E7o de e-mail, nome de usu\u00E1rio do Discord e nome real ser\u00E3o permanentemente exclu\u00EDdos do banco de dados do New Recruit.\u0022,hr:\u0022Va\u0161a email adresa, Discord korisni\u010Dko ime, pravo ime bit \u0107e trajno izbrisani iz New Recruit baze podataka.\u0022,cz:\u0022Your email address, Discord username, real name will be permanently deleted from the New Recruit database.\u0022,sk:\u0022Your email address, Discord username, real name will be permanently deleted from the New Recruit database.\u0022,gr:\u0022\u0397 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7 email \u03C3\u03B1\u03C2, \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 Discord, \u03C4\u03BF \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1 \u03B8\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03BF\u03CD\u03BD \u03BF\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B2\u03AC\u03C3\u03B7 \u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD \u03C4\u03BF\u03C5 New Recruit.\u0022,ru:\u0022\u0412\u0441\u0435 \u0432\u0430\u0448\u0438 \u0434\u0430\u043D\u043D\u044B\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043B\u0435\u043D\u044B\u0022,ko:\u0022Your email address, Discord username, real name will be permanently deleted from the New Recruit database.\u0022},f0e={en:\u0022Your lists may stay in the database so they remain visible in tournaments you participated in.\u0022,fr:\u0022Vos listes peuvent rester dans la base de donn\u00E9es pour qu\u0027elles restent visibles dans les tournois auxquels vous avez particip\u00E9.\u0022,es:\u0022Sus listas pueden permanecer en la base de datos para que sigan siendo visibles en los torneos en los que particip\u00F3.\u0022,cn:\u0022\u60A8\u7684\u5217\u8868\u53EF\u80FD\u4F1A\u4FDD\u7559\u5728\u6570\u636E\u5E93\u4E2D\uFF0C\u4EE5\u4FBF\u5728\u60A8\u53C2\u52A0\u7684\u9526\u6807\u8D5B\u4E2D\u4FDD\u6301\u53EF\u89C1\u3002\u0022,it:\u0022Your lists may stay in the database so they remain visible in tournaments you participated in.\u0022,de:\u0022Ihre Listen k\u00F6nnen in der Datenbank verbleiben, damit sie in Turnieren, an denen Sie teilgenommen haben, sichtbar bleiben.\u0022,ja:\u0022\u3042\u306A\u305F\u306E \u30EA\u30B9\u30C8 may stay \u3067  \u30C7\u30FC\u30BFbase \u3060\u304B\u3089 they remain \u8868\u793A \u3067 \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8 you participated \u3067.\u0022,pl:\u0022Twoje listy mog\u0105 pozosta\u0107 w bazie danych, aby pozosta\u0142y widoczne w turniejach, w kt\u00F3rych bra\u0142e\u015B udzia\u0142.\u0022,pt:\u0022Suas listas podem permanecer no banco de dados para que permane\u00E7am vis\u00EDveis nos torneios em que voc\u00EA participou.\u0022,hr:\u0022Va\u0161e liste mogu ostati u bazi podataka kako bi ostale vidljive na turnirima u kojima ste sudjelovali.\u0022,cz:\u0022Your lists may stay in the database so they remain visible in tournaments you participated in.\u0022,sk:\u0022Your lists may stay in the database so they remain visible in tournaments you participated in.\u0022,gr:\u0022\u039F\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C3\u03B1\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03B5\u03AF\u03BD\u03BF\u03C5\u03BD \u03C3\u03C4\u03B7 \u03B2\u03AC\u03C3\u03B7 \u03B4\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD \u03CE\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03BC\u03AD\u03BD\u03BF\u03C5\u03BD \u03BF\u03C1\u03B1\u03C4\u03AD\u03C2 \u03C3\u03C4\u03B1 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03C3\u03C4\u03B1 \u03BF\u03C0\u03BF\u03AF\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03B5\u03AF\u03C7\u03B1\u03C4\u03B5.\u0022,ru:\u0022\u041E\u0431\u0449\u0438\u0435 \u0441\u043F\u0438\u0441\u043A\u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C\u0438\u0022,ko:\u0022Your lists may stay in the database so they remain visible in tournaments you participated in.\u0022},p0e={en:\u0022Delete Account\u0022,fr:\u0022Supprimer le compte\u0022,es:\u0022Eliminar cuenta\u0022,cn:\u0022\u5220\u9664\u8D26\u6237\u0022,it:\u0022Elimina Account\u0022,de:\u0022L\u00F6schen Konto\u0022,ja:\u0022\u524A\u9664\u30A2\u30AB\u30A6\u30F3\u30C8\u0022,pl:\u0022Usu\u0144 konto\u0022,pt:\u0022Excluir Conta\u0022,hr:\u0022Izbri\u0161i Ra\u010Dun\u0022,cz:\u0022Delete Account\u0022,sk:\u0022Delete Account\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u039B\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0410\u043A\u043A\u0430\u0443\u043D\u0442\u0022,ko:\u0022Account \uC0AD\uC81C\u0022},h0e={en:\u0022Are you sure you want to delete your account?\u0022,fr:\u0022\u00CAtes-vous s\u00FBr de vouloir supprimer votre compte ?\u0022,es:\u0022\u00BFEst\u00E1 seguro de que desea eliminar su cuenta?\u0022,cn:\u0022\u60A8\u786E\u5B9A\u8981\u5220\u9664\u60A8\u7684\u8D26\u6237\u5417\uFF1F\u0022,it:\u0022Are you sure you want to delete your account?\u0022,de:\u0022Sind Sie sicher, dass Sie Ihr Konto l\u00F6schen m\u00F6chten?\u0022,ja:\u0022Are you \u78BA\u304B\u306A you \u3057\u305F\u3044  \u524A\u9664 \u3042\u306A\u305F\u306E \u30A2\u30AB\u30A6\u30F3\u30C8?\u0022,pl:\u0022Czy na pewno chcesz usun\u0105\u0107 swoje konto?\u0022,pt:\u0022Tem certeza de que deseja excluir sua conta?\u0022,hr:\u0022Jeste li sigurni da \u017Eelite izbrisati svoj ra\u010Dun?\u0022,cz:\u0022Are you sure you want to delete your account?\u0022,sk:\u0022Are you sure you want to delete your account?\u0022,gr:\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03C2 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC \u03C3\u03B1\u03C2;\u0022,ru:\u0022\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0443\u0447\u0435\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C?\u0022,ko:\u0022Are you sure you want to delete your account?\u0022},m0e={en:\u0022You need to be logged in to delete your account.\u0022,fr:\u0022Vous devez \u00EAtre connect\u00E9 pour supprimer votre compte.\u0022,es:\u0022Debe iniciar sesi\u00F3n para eliminar su cuenta.\u0022,cn:\u0022\u60A8\u9700\u8981\u767B\u5F55\u624D\u80FD\u5220\u9664\u60A8\u7684\u8D26\u6237\u3002\u0022,it:\u0022You need to be logged in to delete your account.\u0022,de:\u0022Sie m\u00FCssen angemeldet sein, um Ihr Konto zu l\u00F6schen.\u0022,ja:\u0022You need  be logged \u3067  \u524A\u9664 \u3042\u306A\u305F\u306E \u30A2\u30AB\u30A6\u30F3\u30C8.\u0022,pl:\u0022Musisz by\u0107 zalogowany, aby usun\u0105\u0107 swoje konto.\u0022,pt:\u0022Voc\u00EA precisa estar conectado para excluir sua conta.\u0022,hr:\u0022Morate biti prijavljeni za brisanje va\u0161eg ra\u010Duna.\u0022,cz:\u0022You need to be logged in to delete your account.\u0022,sk:\u0022You need to be logged in to delete your account.\u0022,gr:\u0022\u03A0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03C3\u03C4\u03B5 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03C2 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC \u03C3\u03B1\u03C2.\u0022,ru:\u0022\u0412\u043E\u0439\u0434\u0438\u0442\u0435 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438\u0022,ko:\u0022You need to be logged in to delete your account.\u0022},g0e={en:\u0022The Gaming Assistant is only available for New Recruit Supporters.\u0022,fr:\u0022L\u0027Assistant de Jeu n\u0027est disponible que pour les Supporters New Recruit.\u0022,es:\u0022El Asistente de Juego solo est\u00E1 disponible para los Supporters de New Recruit.\u0022,cn:\u0022\u6E38\u620F\u52A9\u624B\u4EC5\u9002\u7528\u4E8E New Recruit \u652F\u6301\u8005\u3002\u0022,it:\u0022The Gaming Assistant is only available for Nuovo Recruit Supporters.\u0022,de:\u0022Der Spielassistent ist nur f\u00FCr New Recruit-Unterst\u00FCtzer verf\u00FCgbar.\u0022,ja:\u0022 Gaming \u30A2\u30B7\u30B9\u30BF\u30F3\u30C8 is \u306E\u307F \u5229\u7528\u53EF\u80FD \u306E\u305F\u3081\u306E \u65B0\u898F Recruit S\u4E0Aporters.\u0022,pl:\u0022Asystent gry jest dost\u0119pny tylko dla wspieraj\u0105cych New Recruit.\u0022,pt:\u0022O Assistente de Jogo est\u00E1 dispon\u00EDvel apenas para Apoiadores do New Recruit.\u0022,hr:\u0022Asistent za Igranje je dostupan samo New Recruit Podr\u017Eavateljima.\u0022,cz:\u0022The Gaming Assistant is only available for New Recruit Supporters.\u0022,sk:\u0022The Gaming Assistant is only available for New Recruit Supporters.\u0022,gr:\u0022\u039F \u0392\u03BF\u03B7\u03B8\u03CC\u03C2 \u03A0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF\u03C2 \u03BC\u03CC\u03BD\u03BF \u03B3\u03B9\u03B1 \u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03B9\u03BA\u03C4\u03AD\u03C2 \u03C4\u03BF\u03C5 New Recruit.\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u0447\u0438\u043A\u043E\u0432\u0022,ko:\u0022The Gaming Assistant is only available for New Recruit Supporters.\u0022},y0e={en:\u0022The Gaming Assistant is not available for {system}.\u0022,fr:\u0022L\u0027Assistant de Jeu n\u0027est pas disponible pour {system}.\u0022,es:\u0022El Asistente de Juego no est\u00E1 disponible para {system}.\u0022,cn:\u0022\u6E38\u620F\u52A9\u624B\u4E0D\u9002\u7528\u4E8E {system}\u3002\u0022,it:\u0022The Gaming Assistant is not available for {system}.\u0022,de:\u0022Der Spielassistent ist nicht f\u00FCr {system} verf\u00FCgbar.\u0022,ja:\u0022 Gaming \u30A2\u30B7\u30B9\u30BF\u30F3\u30C8 is \u3044\u3044\u3048t \u5229\u7528\u53EF\u80FD \u306E\u305F\u3081\u306E {system}.\u0022,pl:\u0022Asystent gry nie jest dost\u0119pny dla {system}.\u0022,pt:\u0022O Assistente de Jogo n\u00E3o est\u00E1 dispon\u00EDvel para {system}.\u0022,hr:\u0022Asistent za Igranje nije dostupan za {system}.\u0022,cz:\u0022The Gaming Assistant is not available for {system}.\u0022,sk:\u0022The Gaming Assistant is not available for {system}.\u0022,gr:\u0022\u039F \u0392\u03BF\u03B7\u03B8\u03CC\u03C2 \u03A0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF\u03C2 \u03B3\u03B9\u03B1 {system}.\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0434\u043B\u044F \u044D\u0442\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B\u0022,ko:\u0022The Gaming Assistant is not available for {system}.\u0022},w0e={en:\u0022Opponent\u0022,fr:\u0022Adversaire\u0022,es:\u0022Oponente\u0022,cn:\u0022\u5BF9\u624B\u0022,it:\u0022Avversario\u0022,de:\u0022Gegner\u0022,ja:\u0022\u5BFE\u6226\u76F8\u624B\u0022,pl:\u0022Przeciwnik\u0022,pt:\u0022Oponente\u0022,hr:\u0022Protivnik\u0022,cz:\u0022Opponent\u0022,sk:\u0022Protivn\u00EDk\u0022,gr:\u0022\u0391\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03BF\u03C2\u0022,ru:\u0022\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0022,ko:\u0022\uC0C1\uB300\u0022},b0e={en:\u0022Combat Simulator\u0022,fr:\u0022Simulateur de Combat\u0022,es:\u0022Simulador de Combate\u0022,cn:\u0022\u6218\u6597\u6A21\u62DF\u5668\u0022,it:\u0022Combat Simulator\u0022,de:\u0022Kampfsimulator\u0022,ja:\u0022\u6226\u95D8Simulator\u0022,pl:\u0022Symulator walki\u0022,pt:\u0022Simulador de Combate\u0022,hr:\u0022Simulator Borbe\u0022,cz:\u0022Combat Simulator\u0022,sk:\u0022Combat Simulator\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03C9\u03C4\u03AE\u03C2 \u039C\u03AC\u03C7\u03B7\u03C2\u0022,ru:\u0022\u0421\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0431\u043E\u044F\u0022,ko:\u0022Combat Simulator\u0022},v0e={en:\u0022Welcome to the combat simulator, below are a few instructions.\u0022,fr:\u0022Bienvenue dans le simulateur de combat, voici quelques instructions.\u0022,es:\u0022Bienvenido al simulador de combate, a continuaci\u00F3n algunas instrucciones.\u0022,cn:\u0022\u6B22\u8FCE\u4F7F\u7528\u6218\u6597\u6A21\u62DF\u5668\uFF0C\u4EE5\u4E0B\u662F\u4E00\u4E9B\u8BF4\u660E\u3002\u0022,it:\u0022Welcome to the combat simulator, below are a few instructions.\u0022,de:\u0022Willkommen beim Kampfsimulator, hier sind einige Anweisungen.\u0022,ja:\u0022Welcome   \u6226\u95D8 simulator, \u4E0B\u306B are a \u5C11\u6570 instructions.\u0022,pl:\u0022Witaj w symulatorze walki, poni\u017Cej znajduje si\u0119 kilka instrukcji.\u0022,pt:\u0022Bem-vindo ao simulador de combate, abaixo est\u00E3o algumas instru\u00E7\u00F5es.\u0022,hr:\u0022Dobrodo\u0161li u simulator borbe, ispod su neke upute.\u0022,cz:\u0022Welcome to the combat simulator, below are a few instructions.\u0022,sk:\u0022Welcome to the combat simulator, below are a few instructions.\u0022,gr:\u0022\u039A\u03B1\u03BB\u03CE\u03C2 \u03AE\u03BB\u03B8\u03B1\u03C4\u03B5 \u03C3\u03C4\u03BF\u03BD \u03C0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03C9\u03C4\u03AE \u03BC\u03AC\u03C7\u03B7\u03C2, \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03C4\u03C9 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BC\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2 \u03BF\u03B4\u03B7\u03B3\u03AF\u03B5\u03C2.\u0022,ru:\u0022\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0431\u043E\u044F\u0022,ko:\u0022Welcome to the combat simulator, below are a few instructions.\u0022},k0e={en:\u0022Auras are effects that can come from other units such as Commanding Presence or Arcane Shield, you can add any numbers of auras to a unit before simulating combat.\u0022,fr:\u0022Les auras sont des effets qui peuvent provenir d\u0027autres unit\u00E9s comme Pr\u00E9sence Commandante ou Bouclier Arcanique, vous pouvez ajouter n\u0027importe quel nombre d\u0027auras \u00E0 une unit\u00E9 avant de simuler un combat.\u0022,es:\u0022Las auras son efectos que pueden provenir de otras unidades como Presencia Comandante o Escudo Arcano, puedes agregar cualquier n\u00FAmero de auras a una unidad antes de simular el combate.\u0022,cn:\u0022\u5149\u73AF\u662F\u6765\u81EA\u5176\u4ED6\u5355\u4F4D\u7684\u6548\u679C\uFF0C\u5982\u6307\u6325\u5B98\u5A01\u671B\u6216\u5965\u672F\u62A4\u76FE\uFF0C\u4F60\u53EF\u4EE5\u5728\u6A21\u62DF\u6218\u6597\u524D\u4E3A\u5355\u4F4D\u6DFB\u52A0\u4EFB\u610F\u6570\u91CF\u7684\u5149\u73AF\u3002\u0022,it:\u0022Auras are effects that can come from other units such as Commanding Presence or Arcane Shield, you can add any numbers of auras to a unit before simulating combat.\u0022,de:\u0022Auren sind Effekte, die von anderen Einheiten wie Befehlende Pr\u00E4senz oder Arkaner Schild kommen k\u00F6nnen. Sie k\u00F6nnen einer Einheit beliebig viele Auren hinzuf\u00FCgen, bevor Sie den Kampf simulieren.\u0022,ja:\u0022Auras are effects that \u3067\u304D\u308B come \u304B\u3089 \u305D\u306E\u4ED6 \u30E6\u30CB\u30C3\u30C8 \u305D\u306E\u3088\u3046\u306A \u3068\u3057\u3066 \u30B3\u30DE\u30F3\u30C9ing Presence \u307E\u305F\u306F Arcane \u30B7\u30FC\u30EB\u30C9, you \u3067\u304D\u308B \u8FFD\u52A0 any \u756A\u53F7s \u306E auras  a \u30E6\u30CB\u30C3\u30C8 \u524D\u306B simulating \u6226\u95D8.\u0022,pl:\u0022Aury to efekty, kt\u00F3re mog\u0105 pochodzi\u0107 od innych jednostek, takie jak Dow\u00F3dcza Obecno\u015B\u0107 lub Arkana Tarcza, mo\u017Cesz doda\u0107 dowoln\u0105 liczb\u0119 aur do jednostki przed symulacj\u0105 walki.\u0022,pt:\u0022Auras s\u00E3o efeitos que podem vir de outras unidades, como Presen\u00E7a Comandante ou Escudo Arcano, voc\u00EA pode adicionar qualquer n\u00FAmero de auras a uma unidade antes de simular o combate.\u0022,hr:\u0022Aure su efekti koji mogu dolaziti od drugih jedinica kao \u0161to su Commanding Presence ili Arcane Shield, mo\u017Eete dodati bilo koji broj aura jedinici prije simulacije borbe.\u0022,cz:\u0022Auras are effects that can come from other units such as Commanding Presence or Arcane Shield, you can add any numbers of auras to a unit before simulating combat.\u0022,sk:\u0022Auras are effects that can come from other units such as Commanding Presence or Arcane Shield, you can add any numbers of auras to a unit before simulating combat.\u0022,gr:\u0022\u03A4\u03B1 Auras \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03C6\u03AD \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03C0\u03C1\u03BF\u03AD\u03BB\u03B8\u03BF\u03C5\u03BD \u03B1\u03C0\u03CC \u03AC\u03BB\u03BB\u03B5\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03CC\u03C0\u03C9\u03C2 Commanding Presence \u03AE Arcane Shield, \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03C4\u03B5 \u03BF\u03C0\u03BF\u03B9\u03BF\u03BD\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC auras \u03C3\u03B5 \u03BC\u03B9\u03B1 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B1 \u03C0\u03C1\u03B9\u03BD \u03C0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03CE\u03C3\u03B5\u03C4\u03B5 \u03BC\u03AC\u03C7\u03B7.\u0022,ru:\u0022\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0430\u0443\u0440\u044B \u0438 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B \u0434\u043B\u044F \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438\u0022,ko:\u0022Auras are effects that can come from other units such as Commanding Presence or Arcane Shield, you can add any numbers of auras to a unit before simulating combat.\u0022},B0e={en:\u0022Auras:\u0022,fr:\u0022Auras :\u0022,es:\u0022Auras:\u0022,cn:\u0022\u5149\u73AF\uFF1A\u0022,it:\u0022Auras:\u0022,de:\u0022Auren:\u0022,ja:\u0022Auras:\u0022,pl:\u0022Aury:\u0022,pt:\u0022Auras:\u0022,hr:\u0022Aure:\u0022,cz:\u0022Auras:\u0022,sk:\u0022Auras:\u0022,gr:\u0022Auras:\u0022,ru:\u0022\u0410\u0443\u0440\u044B:\u0022,ko:\u0022Auras:\u0022},C0e={en:\u0022Changes you make to units here are not saved!\u0022,fr:\u0022Les modifications que vous apportez aux unit\u00E9s ici ne sont pas sauvegard\u00E9es !\u0022,es:\u0022\u00A1Los cambios que hagas a las unidades aqu\u00ED no se guardan!\u0022,cn:\u0022\u60A8\u5728\u6B64\u5904\u5BF9\u5355\u4F4D\u6240\u505A\u7684\u66F4\u6539\u4E0D\u4F1A\u4FDD\u5B58\uFF01\u0022,it:\u0022Changes you make to units here are not saved!\u0022,de:\u0022\u00C4nderungen, die Sie hier an Einheiten vornehmen, werden nicht gespeichert!\u0022,ja:\u0022Changes you make  \u30E6\u30CB\u30C3\u30C8 \u3053\u3053 are \u306A\u3044 \u4FDD\u5B58\u6E08\u307F!\u0022,pl:\u0022Zmiany wprowadzone w jednostkach tutaj nie s\u0105 zapisywane!\u0022,pt:\u0022As altera\u00E7\u00F5es que voc\u00EA fizer nas unidades aqui n\u00E3o s\u00E3o salvas!\u0022,hr:\u0022Promjene koje napravite na jedinicama ovdje nisu spremljene!\u0022,cz:\u0022Changes you make to units here are not saved!\u0022,sk:\u0022Changes you make to units here are not saved!\u0022,gr:\u0022\u039F\u03B9 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2 \u03C0\u03BF\u03C5 \u03BA\u03AC\u03BD\u03B5\u03C4\u03B5 \u03C3\u03C4\u03B9\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03B5\u03B4\u03CE \u03B4\u03B5\u03BD \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03BF\u03BD\u03C4\u03B1\u03B9!\u0022,ru:\u0022\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B\u0022,ko:\u0022Changes you make to units here are not saved!\u0022},_0e={en:\u0022Feel free to add or remove options here to test stuff, this will not impact your lists.\u0022,fr:\u0022N\u0027h\u00E9sitez pas \u00E0 ajouter ou supprimer des options ici pour tester, cela n\u0027affectera pas vos listes.\u0022,es:\u0022Si\u00E9ntete libre de agregar o quitar opciones aqu\u00ED para probar cosas, esto no afectar\u00E1 tus listas.\u0022,cn:\u0022\u968F\u610F\u5728\u6B64\u5904\u6DFB\u52A0\u6216\u5220\u9664\u9009\u9879\u8FDB\u884C\u6D4B\u8BD5\uFF0C\u8FD9\u4E0D\u4F1A\u5F71\u54CD\u60A8\u7684\u5217\u8868\u3002\u0022,it:\u0022Feel free to add or remove options here to test stuff, this will not impact your lists.\u0022,de:\u0022F\u00FCgen Sie hier gerne Optionen hinzu oder entfernen Sie sie zum Testen, dies wirkt sich nicht auf Ihre Listen aus.\u0022,ja:\u0022Feel \u89E3\u653E  \u8FFD\u52A0 \u307E\u305F\u306F \u524A\u9664 \u30AA\u30D7\u30B7\u30E7\u30F3 \u3053\u3053  \u30C6\u30B9\u30C8 stuff, \u3053\u306E \u3057\u307E\u3059 \u3044\u3044\u3048t \u5F71\u97FF \u3042\u306A\u305F\u306E \u30EA\u30B9\u30C8.\u0022,pl:\u0022Czuj si\u0119 swobodnie, aby dodawa\u0107 lub usuwa\u0107 opcje tutaj, aby testowa\u0107 rzeczy, nie wp\u0142ynie to na twoje listy.\u0022,pt:\u0022Sinta-se \u00E0 vontade para adicionar ou remover op\u00E7\u00F5es aqui para testar coisas, isso n\u00E3o afetar\u00E1 suas listas.\u0022,hr:\u0022Slobodno dodajte ili uklonite opcije ovdje za testiranje, to ne\u0107e utjecati na va\u0161e liste.\u0022,cz:\u0022Feel free to add or remove options here to test stuff, this will not impact your lists.\u0022,sk:\u0022Feel free to add or remove options here to test stuff, this will not impact your lists.\u0022,gr:\u0022\u039C\u03B7 \u03B4\u03B9\u03C3\u03C4\u03AC\u03C3\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03C4\u03B5 \u03AE \u03BD\u03B1 \u03B1\u03C6\u03B1\u03B9\u03C1\u03AD\u03C3\u03B5\u03C4\u03B5 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03B5\u03B4\u03CE \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03B5\u03C4\u03B5 \u03C0\u03C1\u03AC\u03B3\u03BC\u03B1\u03C4\u03B1, \u03B1\u03C5\u03C4\u03CC \u03B4\u03B5\u03BD \u03B8\u03B1 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03C3\u03B5\u03B9 \u03C4\u03B9\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C3\u03B1\u03C2.\u0022,ru:\u0022\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0431\u0435\u0437 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439?\u0022,ko:\u0022Feel free to add or remove options here to test stuff, this will not impact your lists.\u0022},S0e={en:\u0022The Combat Simulator is not fully supported yet with Ninth Age 3.0. Most modifiers from magic items and special rules that changed may not work yet.\u0022,fr:\u0022Le Simulateur de Combat n\u0027est pas encore enti\u00E8rement support\u00E9 avec Ninth Age 3.0. La plupart des modificateurs des objets magiques et r\u00E8gles sp\u00E9ciales qui ont chang\u00E9 peuvent ne pas encore fonctionner.\u0022,es:\u0022El Simulador de Combate a\u00FAn no es completamente compatible con Ninth Age 3.0. La mayor\u00EDa de modificadores de objetos m\u00E1gicos y reglas especiales que cambiaron pueden no funcionar a\u00FAn.\u0022,cn:\u0022\u6218\u6597\u6A21\u62DF\u5668\u5C1A\u672A\u5B8C\u5168\u652F\u6301\u7B2C\u4E5D\u7EAA\u5143 3.0\u3002\u5927\u591A\u6570\u6765\u81EA\u9B54\u6CD5\u7269\u54C1\u548C\u5DF2\u66F4\u6539\u7279\u6B8A\u89C4\u5219\u7684\u4FEE\u6B63\u53EF\u80FD\u5C1A\u4E0D\u8D77\u4F5C\u7528\u3002\u0022,it:\u0022The Combattimento Simulator is not fully supported yet with Ninth Age 3.0. Most modifiers from magic items and special rules that changed may not work yet.\u0022,de:\u0022Der Kampfsimulator wird noch nicht vollst\u00E4ndig mit Ninth Age 3.0 unterst\u00FCtzt. Die meisten Modifikatoren von magischen Gegenst\u00E4nden und Sonderregeln, die sich ge\u00E4ndert haben, funktionieren m\u00F6glicherweise noch nicht.\u0022,ja:\u0022 \u6226\u95D8 Simulator is \u3044\u3044\u3048t \u6E80\u676Fy s\u4E0Aported \u307E\u3060 \u3068 9\u756A\u76EE Age 3.0. \u6700\u3082 \u4FEE\u6B63\u5024s \u304B\u3089 \u9B54\u6CD5 \u30A2\u30A4\u30C6\u30E0s \u304A\u3088\u3073 \u7279\u6B8A\u30EB\u30FC\u30EB that \u5909\u66F4d may \u3044\u3044\u3048t \u4F5C\u696D \u307E\u3060.\u0022,pl:\u0022Symulator walki nie jest jeszcze w pe\u0142ni obs\u0142ugiwany z Ninth Age 3.0. Wi\u0119kszo\u015B\u0107 modyfikator\u00F3w z magicznych przedmiot\u00F3w i specjalnych zasad, kt\u00F3re si\u0119 zmieni\u0142y, mo\u017Ce jeszcze nie dzia\u0142a\u0107.\u0022,pt:\u0022O Simulador de Combate ainda n\u00E3o \u00E9 totalmente suportado com Ninth Age 3.0. A maioria dos modificadores de itens m\u00E1gicos e regras especiais que mudaram pode n\u00E3o funcionar ainda.\u0022,hr:\u0022Simulator Borbe jo\u0161 nije u potpunosti podr\u017Ean za Ninth Age 3.0. Ve\u0107ina modifikatora od magi\u010Dnih predmeta i posebnih pravila koja su promijenjena mo\u017Eda jo\u0161 ne rade.\u0022,cz:\u0022The Combat Simulator is not fully supported yet with Ninth Age 3.0. Most modifiers from magic items and special rules that changed may not work yet.\u0022,sk:\u0022The Combat Simulator is not fully supported yet with Ninth Age 3.0. Most modifiers from magic items and special rules that changed may not work yet.\u0022,gr:\u0022\u039F \u03A0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03C9\u03C4\u03AE\u03C2 \u039C\u03AC\u03C7\u03B7\u03C2 \u03B4\u03B5\u03BD \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9 \u03C0\u03BB\u03AE\u03C1\u03C9\u03C2 \u03B1\u03BA\u03CC\u03BC\u03B1 \u03BC\u03B5 \u03C4\u03BF Ninth Age 3.0. \u03A0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF\u03B9 \u03C4\u03C1\u03BF\u03C0\u03BF\u03C0\u03BF\u03B9\u03B7\u03C4\u03AD\u03C2 \u03B1\u03C0\u03CC \u03BC\u03B1\u03B3\u03B9\u03BA\u03AC \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1 \u03BA\u03B1\u03B9 \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03AC\u03BB\u03BB\u03B1\u03BE\u03B1\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BC\u03B7\u03BD \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03BF\u03CD\u03BD \u03B1\u03BA\u03CC\u03BC\u03B1.\u0022,ru:\u0022\u0421\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0431\u043E\u044F \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u044D\u0442\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B\u0022,ko:\u0022The Combat Simulator is not fully supported yet with Ninth Age 3.0. Most modifiers from magic items and special rules that changed may not work yet.\u0022},E0e={en:\u0022Combat\u0022,fr:\u0022Combat\u0022,es:\u0022Combate\u0022,cn:\u0022\u6218\u6597\u0022,it:\u0022Combat\u0022,de:\u0022Kampf\u0022,ja:\u0022\u6226\u95D8\u0022,pl:\u0022Walka\u0022,pt:\u0022Combate\u0022,hr:\u0022Borba\u0022,cz:\u0022Combat\u0022,sk:\u0022Combat\u0022,gr:\u0022\u039C\u03AC\u03C7\u03B7\u0022,ru:\u0022\u0411\u043E\u0439\u0022,ko:\u0022Combat\u0022},j0e={en:\u0022Fight!!!\u0022,fr:\u0022Combat !!!\u0022,es:\u0022\u00A1\u00A1\u00A1Luchar!!!\u0022,cn:\u0022\u6218\u6597\uFF01\uFF01\uFF01\u0022,it:\u0022Fight!!!\u0022,de:\u0022K\u00E4mpfen!!!\u0022,ja:\u0022Fight!!!\u0022,pl:\u0022Walcz!!!\u0022,pt:\u0022Lutar!!!\u0022,hr:\u0022Borba!!!\u0022,cz:\u0022Fight!!!\u0022,sk:\u0022Fight!!!\u0022,gr:\u0022\u039C\u03AC\u03C7\u03B7!!!\u0022,ru:\u0022\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F!!!\u0022,ko:\u0022Fight!!!\u0022},z0e={en:\u0022Stop!!!\u0022,fr:\u0022Arr\u00EAter !!!\u0022,es:\u0022\u00A1\u00A1\u00A1Parar!!!\u0022,cn:\u0022\u505C\u6B62\uFF01\uFF01\uFF01\u0022,it:\u0022Stop!!!\u0022,de:\u0022Stopp!!!\u0022,ja:\u0022\u505C\u6B62!!!\u0022,pl:\u0022Stop!!!\u0022,pt:\u0022Parar!!!\u0022,hr:\u0022Stop!!!\u0022,cz:\u0022Stop!!!\u0022,sk:\u0022Stop!!!\u0022,gr:\u0022\u0394\u03B9\u03B1\u03BA\u03BF\u03C0\u03AE!!!\u0022,ru:\u0022\u0421\u0442\u043E\u043F!!!\u0022,ko:\u0022Stop!!!\u0022},I0e={en:\u0022Time:\u0022,fr:\u0022Temps :\u0022,es:\u0022Tiempo:\u0022,cn:\u0022\u65F6\u95F4\uFF1A\u0022,it:\u0022Time:\u0022,de:\u0022Zeit:\u0022,ja:\u0022\u6642\u9593:\u0022,pl:\u0022Czas:\u0022,pt:\u0022Tempo:\u0022,hr:\u0022Vrijeme:\u0022,cz:\u0022Time:\u0022,sk:\u0022Time:\u0022,gr:\u0022\u038F\u03C1\u03B1:\u0022,ru:\u0022\u0412\u0440\u0435\u043C\u044F:\u0022,ko:\u0022Time:\u0022},P0e={en:\u0022Progress:\u0022,fr:\u0022Progression :\u0022,es:\u0022Progreso:\u0022,cn:\u0022\u8FDB\u5EA6\uFF1A\u0022,it:\u0022Progress:\u0022,de:\u0022Fortschritt:\u0022,ja:\u0022Progress:\u0022,pl:\u0022Post\u0119p:\u0022,pt:\u0022Progresso:\u0022,hr:\u0022Napredak:\u0022,cz:\u0022Progress:\u0022,sk:\u0022Progress:\u0022,gr:\u0022\u03A