u0022 units (starting with the player who finished deploying last)\u0022,sk:\u0022 units (starting with the player who finished deploying last)\u0022,gr:\u0022\u039C\u03B5\u03C4\u03B1\u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD \u03C0\u03C1\u03BF\u03C6\u03C5\u03BB\u03B1\u03BA\u03AE\u03C2 (Vanguarding) \u03BC\u03B5\u03C4\u03AC \u03C4\u03B7 \u03C1\u03AF\u03C8\u03B7\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0430\u0432\u0430\u043D\u0433\u0430\u0440\u0434 \u043F\u043E\u0441\u043B\u0435\u0022,ko:\u0022 units (starting with the player who finished deploying last)\u0022},tBe={en:\u0022Vanguarding\u0022,fr:\u0022Avant-garde\u0022,es:\u0022Vanguardia\u0022,cn:\u0022\u5148\u950B\u0022,it:\u0022Vanguarding\u0022,de:\u0022Vorhut\u0022,ja:\u0022Vanguarding\u0022,pl:\u0022Stra\u017C przednia\u0022,pt:\u0022Vanguarda\u0022,hr:\u0022Predstra\u017Ea\u0022,cz:\u0022Vanguarding\u0022,sk:\u0022Vanguarding\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C6\u03C5\u03BB\u03B1\u03BA\u03AE (Vanguarding)\u0022,ru:\u0022\u0410\u0432\u0430\u043D\u0433\u0430\u0440\u0434\u0022,ko:\u0022Vanguarding\u0022},rBe={en:\u0022Other rules and abilities\u0022,fr:\u0022Autres r\u00E8gles et capacit\u00E9s\u0022,es:\u0022Otras reglas y habilidades\u0022,cn:\u0022\u5176\u4ED6\u89C4\u5219\u548C\u80FD\u529B\u0022,it:\u0022Other rules and abilities\u0022,de:\u0022Andere Regeln und F\u00E4higkeiten\u0022,ja:\u0022Other\u30EB\u30FC\u30EBand\u30A2\u30D3\u30EA\u30C6\u30A3\u0022,pl:\u0022Inne zasady i umiej\u0119tno\u015Bci\u0022,pt:\u0022Outras regras e habilidades\u0022,hr:\u0022Ostala pravila i sposobnosti\u0022,cz:\u0022Other rules and abilities\u0022,sk:\u0022Other rules and abilities\u0022,gr:\u0022\u0386\u03BB\u03BB\u03BF\u03B9 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u03C2\u0022,ru:\u0022\u0414\u0440\u0443\u0433\u043E\u0439 \u041F\u0440\u0430\u0432\u0438\u043B\u0430 and \u0421\u043F\u043E\u0441