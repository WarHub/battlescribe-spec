ons!\u0022,sk:\u0022All models from this list have been added to your miniature collections!\u0022,gr:\u0022\u03A4\u03B1 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03B1 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2 \u03C0\u03C1\u03BF\u03C3\u03C4\u03AD\u03B8\u03B7\u03BA\u03B1\u03BD \u03C3\u03C4\u03B9\u03C2 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03B5\u03C2\u0022,ru:\u0022\u041C\u043E\u0434\u0435\u043B\u0438 \u0441\u043F\u0438\u0441\u043A\u0430 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B \u0432 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u044B\u0022,ko:\u0022All models from this list have been added to your miniature collections!\u0022},xFe={en:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EMy Miniatures\u003C/strong\u003E!\u0027,fr:\u0027Soutenez New Recruit pour d\u00E9bloquer \u003Cstrong class=\u0022blue\u0022\u003EMes Figurines\u003C/strong\u003E !\u0027,es:\u0027\u00A1Apoya a New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EMis Miniaturas\u003C/strong\u003E!\u0027,cn:\u0027\u652F\u6301 New Recruit \u4EE5\u89E3\u9501\u003Cstrong class=\u0022blue\u0022\u003E\u6211\u7684\u6A21\u578B\u003C/strong\u003E\uFF01\u0027,it:\u0027Sostieni New Recruit per sbloccare \u003Cstrong class=\u0022blue\u0022\u003ELe Mie Miniature\u003C/strong\u003E!\u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um \u003Cstrong class=\u0022blue\u0022\u003EMeine Miniaturen\u003C/strong\u003E freizuschalten!\u0027,ja:\u0027New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u30DE\u30A4\u30DF\u30CB\u30C1\u30E5\u30A2\u003C/strong\u003E\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby odblokowa\u0107 \u003Cstrong class=\u0022blue\u0022\u003EMoje Miniatury\u003C/strong\u003E!\u0027,pt:\u0027Apoie o New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EMinhas Miniaturas\u003C/strong\u003E!\u0027,hr:\u0022Otklju\u010Daj zna\u010Dajku minijatura\u0022,cz:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EMy Miniatures\u003C/strong\u003E!\u0027,sk:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EMy Miniatures\u003C/strong\u003E!\u0027,gr:\u0022\u039E\u03B5\u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03C9\u03BD\u0022,ru:\u0022\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u0022,ko:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EMy Miniatures\u003C/strong\u003E!\u0027},QFe={en:\u0022Complete Inventory\u0022,fr:\u0022Inventaire complet\u0022,es:\u0022Inventario completo\u0022,cn:\u0022\u5B8C\u6574\u5E93\u5B58\u0022,it:\u0022Inventario completo\u0022,de:\u0022Vollst\u00E4ndiges Inventar\u0022,ja:\u0022\u5B8C\u5168\u306A\u5728\u5EAB\u0022,pl:\u0022Pe\u0142ny inwentarz\u0022,pt:\u0022Invent\u00E1rio completo\u0022,hr:\u0022Inventar minijatura\u0022,cz:\u0022Complete Inventory\u0022,sk:\u0022Complete Inventory\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03B1\u03C0\u03BF\u03B8\u03AD\u03BC\u03B1\u03C4\u03BF\u03C2\u0022,ru:\u0022\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u0022,ko:\u0022Complete Inventory\u0022},LFe={en:\u0022List all the miniatures you own in New Recruit and flag them Built or Painted\u0022,fr:\u0022Listez toutes vos figurines dans New Recruit et marquez-les comme Construites ou Peintes\u0022,es:\u0022Lista todas las miniaturas que posees en New Recruit y m\u00E1rcalas como Construidas o Pintadas\u0022,cn:\u0022\u5728 New Recruit \u4E2D\u5217\u51FA\u60A8\u62E5\u6709\u7684\u6240\u6709\u6A21\u578B\u5E76\u6807\u8BB0\u4E3A\u5DF2\u7EC4\u88C5\u6216\u5DF2\u4E0A\u8272\u0022,it:\u0022Elenca tutte le miniature che possiedi in New Recruit e contrassegnale come Costruite o Dipinte\u0022,de:\u0022Listen Sie alle Ihre Miniaturen in New Recruit auf und markieren Sie sie als Gebaut oder Bemalt\u0022,ja:\u0022New Recruit \u3067\u6240\u6709\u3059\u308B\u3059\u3079\u3066\u306E\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u30EA\u30B9\u30C8\u5316\u3057\u3001\u7D44\u307F\u7ACB\u3066\u6E08\u307F\u307E\u305F\u306F\u5857\u88C5\u6E08\u307F\u3068\u3057\u3066\u30D5\u30E9\u30B0\u3092\u7ACB\u3066\u308B\u0022,pl:\u0022Wymie\u0144 wszystkie miniatury, kt\u00F3re posiadasz w New Recruit i oznacz je jako Zbudowane lub Pomalowane\u0022,pt:\u0022Liste todas as miniaturas que voc\u00EA possui no New Recruit e marque-as como Constru\u00EDdas ou Pintadas\u0022,hr:\u0022Pratite svoju kolekciju minijatura\u0022,cz:\u0022List all the miniatures you own in New Recruit and flag them Built or Painted\u0022,sk:\u0022List all the miniatures you own in New Recruit and flag them Built or Painted\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03AE \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03C9\u03BD \u03C3\u03B1\u03C2\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0432\u0430\u0448\u0443 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u0022,ko:\u0022List all the miniatures you own in New Recruit and flag them Built or Painted\u0022},DFe={en:\u0022Automatic Matching\u0022,fr:\u0022Association automatique\u0022,es:\u0022Coincidencia autom\u00E1tica\u0022,cn:\u0022\u81EA\u52A8\u5339\u914D\u0022,it:\u0022Abbinamento automatico\u0022,de:\u0022Automatische Zuordnung\u0022,ja:\u0022\u81EA\u52D5\u30DE\u30C3\u30C1\u30F3\u30B0\u0022,pl:\u0022Automatyczne dopasowanie\u0022,pt:\u0022Correspond\u00EAncia autom\u00E1tica\u0022,hr:\u0022Uskla\u0111ivanje minijatura\u0022,cz:\u0022Automatic Matching\u0022,sk:\u0022Automatic Matching\u0022,gr:\u0022\u0391\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03AF\u03C7\u03B9\u03C3\u03B7 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03C9\u03BD\u0022,ru:\u0022\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u0022,ko:\u0022Automatic Matching\u0022},OFe={en:\u0022Match your miniatures with their corresponding unit for all games\u0022,fr:\u0022Associez vos figurines aux unit\u00E9s correspondantes pour tous vos jeux\u0022,es:\u0022Asocia tus miniaturas con su unidad correspondiente para todos los juegos\u0022,cn:\u0022\u5C06\u60A8\u7684\u6A21\u578B\u4E0E\u6240\u6709\u6E38\u620F\u4E2D\u7684\u76F8\u5E94\u5355\u4F4D\u5339\u914D\u0022,it:\u0022Abbina le tue miniature con la corrispondente unit\u00E0 per tutti i giochi\u0022,de:\u0022Ordnen Sie Ihre Miniaturen den entsprechenden Einheiten f\u00FCr alle Spiele zu\u0022,ja:\u0022\u3059\u3079\u3066\u306E\u30B2\u30FC\u30E0\u3067\u3001\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u5BFE\u5FDC\u3059\u308B\u30E6\u30CB\u30C3\u30C8\u3068\u30DE\u30C3\u30C1\u30F3\u30B0\u3059\u308B\u0022,pl:\u0022Dopasuj swoje miniatury do odpowiednich jednostek dla wszystkich gier\u0022,pt:\u0022Associe suas miniaturas com a unidade correspondente para todos os jogos\u0022,hr:\u0022Uskladite minijature s listama\u0022,cz:\u0022Match your miniatures with their corresponding unit for all games\u0022,sk:\u0022Match your miniatures with their corresponding unit for all games\u0022,gr:\u0022\u0391\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03AF\u03C3\u03C4\u03B5 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03B1 \u03BC\u03B5 \u03C4\u03B7 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03AE \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u044B \u0441 \u044E\u043D\u0438\u0442\u0430\u043C\u0438 \u0441\u043F\u0438\u0441\u043A\u043E\u0432\u0022,ko:\u0022Match your miniatures with their corresponding unit for all games\u0022},HFe={en:\u0022Instant Verification\u0022,fr:\u0022V\u00E9rification instantan\u00E9e\u0022,es:\u0022Verificaci\u00F3n instant\u00E1nea\u0022,cn:\u0022\u5373\u65F6\u9A8C\u8BC1\u0022,it:\u0022Verifica istantanea\u0022,de:\u0022Sofortige \u00DCberpr\u00FCfung\u0022,ja:\u0022\u5373\u5EA7\u306B\u78BA\u8A8D\u0022,pl:\u0022Natychmiastowa weryfikacja\u0022,pt:\u0022Verifica\u00E7\u00E3o instant\u00E2nea\u0022,hr:\u0022Provjera minijatura\u0022,cz:\u0022Instant Verification\u0022,sk:\u0022Instant Verification\u0022,gr:\u0022\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2 \u03B4\u03B9\u03B1\u03B8\u03B5\u03C3\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2\u0022,ru:\u0022\u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430\u0022,ko:\u0022Instant Verification\u0022},GFe={en:\u0022New Recruit instantly tells you if you have all the miniatures needed to play a list, how many you need to obtain, build, or paint\u0022,fr:\u0022New Recruit vous indique imm\u00E9diatement si vous poss\u00E9dez toutes les figurines n\u00E9cessaires pour jouer une liste, combien vous devez en obtenir, construire ou peindre\u0022,es:\u0022New Recruit te dice instant\u00E1neamente si tienes todas las miniaturas necesarias para jugar una lista, cu\u00E1ntas necesitas obtener, construir o pintar\u0022,cn:\u0022New Recruit \u7ACB\u5373\u544A\u8BC9\u60A8\u662F\u5426\u62E5\u6709\u6E38\u73A9\u5217\u8868\u6240\u9700\u7684\u6240\u6709\u6A21\u578B\uFF0C\u4EE5\u53CA\u9700\u8981\u83B7\u53D6\u3001\u7EC4\u88C5\u6216\u4E0A\u8272\u591A\u5C11\u4E2A\u0022,it:\u0022New Recruit ti dice istantaneamente se hai tutte le miniature necessarie per giocare una lista, quante devi ottenere, costruire o dipingere\u0022,de:\u0022New Recruit sagt Ihnen sofort, ob Sie alle Miniaturen haben, die Sie f\u00FCr eine Liste ben\u00F6tigen, wie viele Sie erwerben, bauen oder bemalen m\u00FCssen\u0022,ja:\u0022New Recruit \u306F\u3001\u30EA\u30B9\u30C8\u3092\u30D7\u30EC\u30A4\u3059\u308B\u305F\u3081\u306B\u5FC5\u8981\u306A\u3059\u3079\u3066\u306E\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u6301\u3063\u3066\u3044\u308B\u304B\u3001\u4F55\u500B\u5165\u624B\u3001\u7D44\u307F\u7ACB\u3066\u3001\u307E\u305F\u306F\u5857\u88C5\u3059\u308B\u5FC5\u8981\u304C\u3042\u308B\u304B\u3092\u5373\u5EA7\u306B\u901A\u77E5\u3057\u307E\u3059\u0022,pl:\u0022New Recruit natychmiast informuje, czy masz wszystkie miniatury potrzebne do zagrania listy, ile musisz zdoby\u0107, zbudowa\u0107 lub pomalowa\u0107\u0022,pt:\u0022New Recruit informa instantaneamente se voc\u00EA tem todas as miniaturas necess\u00E1rias para jogar uma lista, quantas voc\u00EA precisa obter, construir ou pintar\u0022,hr:\u0022Provjerite koje minijature vam trebaju\u0022,cz:\u0022New Recruit instantly tells you if you have all the miniatures needed to play a list, how many you need to obtain, build, or paint\u0022,sk:\u0022New Recruit instantly tells you if you have all the miniatures needed to play a list, how many you need to obtain, build, or paint\u0022,gr:\u0022\u0395\u03BB\u03AD\u03B3\u03BE\u03C4\u03B5 \u03B1\u03BD \u03AD\u03C7\u03B5\u03C4\u03B5 \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03B1\u0022,ru:\u0022\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0439\u0442\u0435, \u043A\u0430\u043A\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0438 \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u044B\u0022,ko:\u0022\uC0C8 Recruit instantly tells you if you have all the miniatures needed to play a list, how many you need to obtain, build, or paint\u0022},VFe={en:\u0022Automatic Counting\u0022,fr:\u0022Comptage automatique\u0022,es:\u0022Conteo autom\u00E1tico\u0022,cn:\u0022\u81EA\u52A8\u8BA1\u6570\u0022,it:\u0022Conteggio automatico\u0022,de:\u0022Automatische Z\u00E4hlung\u0022,ja:\u0022\u81EA\u52D5\u30AB\u30A6\u30F3\u30C8\u0022,pl:\u0022Automatyczne liczenie\u0022,pt:\u0022Contagem autom\u00E1tica\u0022,hr:\u0022Brojanje minijatura\u0022,cz:\u0022Automatic Counting\u0022,sk:\u0022Automatic Counting\u0022,gr:\u0022\u039A\u03B1\u03C4\u03B1\u03BC\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03C9\u03BD\u0022,ru:\u0022\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u043E\u0434\u0441\u0447\u0435\u0442\u0022,ko:\u0022Automatic Counting\u0022},WFe={en:\u0022Count the total number of models in a list, total number painted, or built\u0022,fr:\u0022Comptez le nombre total de mod\u00E8les dans une liste, le nombre total peint ou construit\u0022,es:\u0022Cuenta el n\u00FAmero total de modelos en una lista, el n\u00FAmero total pintado o construido\u0022,cn:\u0022\u8BA1\u7B97\u5217\u8868\u4E2D\u7684\u6A21\u578B\u603B\u6570\u3001\u5DF2\u4E0A\u8272\u603B\u6570\u6216\u5DF2\u7EC4\u88C5\u603B\u6570\u0022,it:\u0022Conta il numero totale di modelli in una lista, il numero totale dipinto o costruito\u0022,de:\u0022Z\u00E4hlen Sie die Gesamtzahl der Modelle in einer Liste, die Gesamtzahl der bemalten oder gebauten\u0022,ja:\u0022\u30EA\u30B9\u30C8\u5185\u306E\u30E2\u30C7\u30EB\u306E\u7DCF\u6570\u3001\u5857\u88C5\u6E08\u307F\u307E\u305F\u306F\u7D44\u307F\u7ACB\u3066\u6E08\u307F\u306E\u7DCF\u6570\u3092\u30AB\u30A6\u30F3\u30C8\u0022,pl:\u0022Policz ca\u0142kowit\u0105 liczb\u0119 modeli na li\u015Bcie, ca\u0142kowit\u0105 liczb\u0119 pomalowanych lub zbudowanych\u0022,pt:\u0022Conte o n\u00FAmero total de modelos em uma lista, o n\u00FAmero total pintado ou constru\u00EDdo\u0022,hr:\u0022Automatsko brojanje modela\u0022,cz:\u0022Count the total number of models in a list, total number painted, or built\u0022,sk:\u0022Count the total number of models in a list, total number painted, or built\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03BD \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03C9\u03BD\u0022,ru:\u0022\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E the \u0412\u0441\u0435\u0433\u043E \u041D\u043E\u043C\u0435\u0440 of \u041C\u043E\u0434\u0435\u043B\u0438 \u0432 a \u0421\u043F\u0438\u0441\u043E\u043A, \u0412\u0441\u0435\u0433\u043E \u041D\u043E\u043C\u0435\u0440 \u041F\u043E\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0435, or \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435\u0022,ko:\u0022Count the total number of models in a list, total number painted, or built\u0022},YFe={en:\u0022Photo Gallery\u0022,fr:\u0022Galerie photos\u0022,es:\u0022Galer\u00EDa de fotos\u0022,cn:\u0022\u7167\u7247\u5E93\u0022,it:\u0022Galleria fotografica\u0022,de:\u0022Fotogalerie\u0022,ja:\u0022\u30D5\u30A9\u30C8\u30AE\u30E3\u30E9\u30EA\u30FC\u0022,pl:\u0022Galeria zdj\u0119\u0107\u0022,pt:\u0022Galeria de fotos\u0022,hr:\u0022Prijenos minijatura\u0022,cz:\u0022Photo Gallery\u0022,sk:\u0022Photo Gallery\u0022,gr:\u0022\u039C\u03B5\u03C4\u03B1\u03C6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03B5\u03B9\u03BA\u03CC\u03BD\u03C9\u03BD\u0022,ru:\u0022\u0424\u043E\u0442\u043E\u0433\u0430\u043B\u0435\u0440\u0435\u044F\u0022,ko:\u0022Photo Gallery\u0022},KFe={en:\u0022Upload pictures of your miniatures to display in the interface\u0022,fr:\u0022T\u00E9l\u00E9chargez des photos de vos figurines pour les afficher dans l\u0027interface\u0022,es:\u0022Sube im\u00E1genes de tus miniaturas para mostrarlas en la interfaz\u0022,cn:\u0022\u4E0A\u4F20\u60A8\u7684\u6A21\u578B\u56FE\u7247\u4EE5\u5728\u754C\u9762\u4E2D\u663E\u793A\u0022,it:\u0022Carica le immagini delle tue miniature da visualizzare nell\u0027interfaccia\u0022,de:\u0022Laden Sie Bilder Ihrer Miniaturen hoch, um sie in der Benutzeroberfl\u00E4che anzuzeigen\u0022,ja:\u0022\u30DF\u30CB\u30C1\u30E5\u30A2\u306E\u5199\u771F\u3092\u30A2\u30C3\u30D7\u30ED\u30FC\u30C9\u3057\u3066\u30A4\u30F3\u30BF\u30FC\u30D5\u30A7\u30FC\u30B9\u306B\u8868\u793A\u0022,pl:\u0022Prze\u015Blij zdj\u0119cia swoich miniatur, aby wy\u015Bwietla\u0107 je w interfejsie\u0022,pt:\u0022Carregue fotos de suas miniaturas para exibir na interface\u0022,hr:\u0022Prenesite slike svojih minijatura\u0022,cz:\u0022Upload pictures of your miniatures to display in the interface\u0022,sk:\u0022Upload pictures of your miniatures to display in the interface\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03C4\u03B5 \u03B5\u03B9\u03BA\u03CC\u03BD\u03B5\u03C2 \u03C3\u03C4\u03B9\u03C2 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03B5\u03C2 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0439\u0442\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0432\u0430\u0448\u0438\u0445 \u0440\u0430\u0441\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439\u0022,ko:\u0022Upload pictures of your miniatures to display in the interface\u0022},qFe={en:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003ECustom Names and Notes\u003C/strong\u003E!\u0027,fr:\u0027Soutenez New Recruit pour d\u00E9bloquer \u003Cstrong class=\u0022blue\u0022\u003ENoms Personnalis\u00E9s et Notes\u003C/strong\u003E !\u0027,es:\u0027\u00A1Apoya a New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003ENombres Personalizados y Notas\u003C/strong\u003E!\u0027,cn:\u0027\u652F\u6301 New Recruit \u4EE5\u89E3\u9501\u003Cstrong class=\u0022blue\u0022\u003E\u81EA\u5B9A\u4E49\u540D\u79F0\u548C\u5907\u6CE8\u003C/strong\u003E\uFF01\u0027,it:\u0027Sostieni New Recruit per sbloccare \u003Cstrong class=\u0022blue\u0022\u003ENomi Personalizzati e Note\u003C/strong\u003E!\u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um \u003Cstrong class=\u0022blue\u0022\u003EBenutzerdefinierte Namen und Notizen\u003C/strong\u003E freizuschalten!\u0027,ja:\u0027New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u30AB\u30B9\u30BF\u30E0\u540D\u3068\u30CE\u30FC\u30C8\u003C/strong\u003E\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby odblokowa\u0107 \u003Cstrong class=\u0022blue\u0022\u003ENiestandardowe Nazwy i Notatki\u003C/strong\u003E!\u0027,pt:\u0027Apoie o New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003ENomes Personalizados e Notas\u003C/strong\u003E!\u0027,hr:\u0022Otklju\u010Daj zna\u010Dajku pre\u0438\u043C\u0435\u043Dovanja\u0022,cz:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003ECustom Names and Notes\u003C/strong\u003E!\u0027,sk:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003ECustom Names and Notes\u003C/strong\u003E!\u0027,gr:\u0022\u039E\u03B5\u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 \u03BC\u03B5\u03C4\u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003ECustom Names and Notes\u003C/strong\u003E!\u0027},JFe={en:\u0022Rename Units\u0022,fr:\u0022Renommer les Unit\u00E9s\u0022,es:\u0022Renombrar Unidades\u0022,cn:\u0022\u91CD\u547D\u540D\u5355\u4F4D\u0022,it:\u0022Rinomina Unit\u00E0\u0022,de:\u0022Einheiten Umbenennen\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u540D\u3092\u5909\u66F4\u0022,pl:\u0022Zmie\u0144 Nazwy Jednostek\u0022,pt:\u0022Renomear Unidades\u0022,hr:\u0022Preimenuj jedinice\u0022,cz:\u0022Rename Units\u0022,sk:\u0022Rename Units\u0022,gr:\u0022\u039C\u03B5\u03C4\u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C \u042E\u043D\u0438\u0442\u044B\u0022,ko:\u0022Rename Units\u0022},$Fe={en:\u0022Give custom names to your units to personalize your army lists\u0022,fr:\u0022Donnez des noms personnalis\u00E9s \u00E0 vos unit\u00E9s pour personnaliser vos listes d\u0027arm\u00E9es\u0022,es:\u0022Dale nombres personalizados a tus unidades para personalizar tus listas de ej\u00E9rcito\u0022,cn:\u0022\u4E3A\u60A8\u7684\u5355\u4F4D\u547D\u540D\u4EE5\u4E2A\u6027\u5316\u60A8\u7684\u519B\u961F\u5217\u8868\u0022,it:\u0022Dai nomi personalizzati alle tue unit\u00E0 per personalizzare le tue liste esercito\u0022,de:\u0022Geben Sie Ihren Einheiten benutzerdefinierte Namen, um Ihre Armeelisten zu personalisieren\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u306B\u30AB\u30B9\u30BF\u30E0\u540D\u3092\u4ED8\u3051\u3066\u3001\u8ECD\u968A\u30EA\u30B9\u30C8\u3092\u30D1\u30FC\u30BD\u30CA\u30E9\u30A4\u30BA\u0022,pl:\u0022Nadaj niestandardowe nazwy swoim jednostkom, aby spersonalizowa\u0107 listy armii\u0022,pt:\u0022D\u00EA nomes personalizados \u00E0s suas unidades para personalizar suas listas de ex\u00E9rcito\u0022,hr:\u0022Dajte prilago\u0111ena imena svojim jedinicama\u0022,cz:\u0022Give custom names to your units to personalize your army lists\u0022,sk:\u0022Give custom names to your units to personalize your army lists\u0022,gr:\u0022\u0394\u03CE\u03C3\u03C4\u03B5 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B1 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C3\u03C4\u03B9\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u044B\u0432\u0430\u0439\u0442\u0435 \u044E\u043D\u0438\u0442\u044B \u0432 \u0432\u0430\u0448\u0438\u0445 \u0441\u043F\u0438\u0441\u043A\u0430\u0445\u0022,ko:\u0022Give custom names to your units to personalize your army lists\u0022},ZFe={en:\u0022Rename Forces\u0022,fr:\u0022Renommer les Forces\u0022,es:\u0022Renombrar Fuerzas\u0022,cn:\u0022\u91CD\u547D\u540D\u90E8\u961F\u0022,it:\u0022Rinomina Forze\u0022,de:\u0022Streitkr\u00E4fte Umbenennen\u0022,ja:\u0022\u30D5\u30A9\u30FC\u30B9\u540D\u3092\u5909\u66F4\u0022,pl:\u0022Zmie\u0144 Nazwy Si\u0142\u0022,pt:\u0022Renomear For\u00E7as\u0022,hr:\u0022Preimenuj snage\u0022,cz:\u0022Rename Forces\u0022,sk:\u0022Rename Forces\u0022,gr:\u0022\u039C\u03B5\u03C4\u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03C9\u03BD\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C \u0410\u0440\u043C\u0438\u0438\u0022,ko:\u0022Rename Forces\u0022},XFe={en:\u0022Customize your force names to create thematic army lists\u0022,fr:\u0022Personnalisez les noms de vos forces pour cr\u00E9er des listes d\u0027arm\u00E9es th\u00E9matiques\u0022,es:\u0022Personaliza los nombres de tus fuerzas para crear listas de ej\u00E9rcito tem\u00E1ticas\u0022,cn:\u0022\u81EA\u5B9A\u4E49\u60A8\u7684\u90E8\u961F\u540D\u79F0\u4EE5\u521B\u5EFA\u4E3B\u9898\u519B\u961F\u5217\u8868\u0022,it:\u0022Personalizza i nomi delle tue forze per creare liste esercito tematiche\u0022,de:\u0022Passen Sie Ihre Streitkr\u00E4ftenamen an, um thematische Armeelisten zu erstellen\u0022,ja:\u0022\u30D5\u30A9\u30FC\u30B9\u540D\u3092\u30AB\u30B9\u30BF\u30DE\u30A4\u30BA\u3057\u3066\u3001\u30C6\u30FC\u30DE\u6027\u306E\u3042\u308B\u8ECD\u968A\u30EA\u30B9\u30C8\u3092\u4F5C\u6210\u0022,pl:\u0022Dostosuj nazwy swoich si\u0142, aby tworzy\u0107 tematyczne listy armii\u0022,pt:\u0022Personalize os nomes das suas for\u00E7as para criar listas de ex\u00E9rcito tem\u00E1ticas\u0022,hr:\u0022Prilagodite nazive svojih snaga\u0022,cz:\u0022Customize your force names to create thematic army lists\u0022,sk:\u0022Customize your force names to create thematic army lists\u0022,gr:\u0022\u0394\u03CE\u03C3\u03C4\u03B5 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B1 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1 \u03C3\u03C4\u03B9\u03C2 \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u044B\u0432\u0430\u0439\u0442\u0435 \u043E\u0442\u0440\u044F\u0434\u044B \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0437\u0430\u043C\u0435\u0442\u043A\u0438\u0022,ko:\u0022Customize your force names to create thematic army lists\u0022},eRe={en:\u0022List Notes\u0022,fr:\u0022Notes de Liste\u0022,es:\u0022Notas de Lista\u0022,cn:\u0022\u5217\u8868\u5907\u6CE8\u0022,it:\u0022Note Lista\u0022,de:\u0022Listennotizen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u30CE\u30FC\u30C8\u0022,pl:\u0022Notatki Listy\u0022,pt:\u0022Notas de Lista\u0022,hr:\u0022Bilje\u0161ke\u0022,cz:\u0022List Notes\u0022,sk:\u0022List Notes\u0022,gr:\u0022\u03A3\u03B7\u03BC\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u0417\u0430\u043C\u0435\u0442\u043A\u0438\u0022,ko:\u0022List Notes\u0022},tRe={en:\u0022Attach notes to lists and units to keep track of important information\u0022,fr:\u0022Attachez des notes aux listes et aux unit\u00E9s pour garder une trace des informations importantes\u0022,es:\u0022Adjunta notas a listas y unidades para hacer seguimiento de informaci\u00F3n importante\u0022,cn:\u0022\u4E3A\u5217\u8868\u548C\u5355\u4F4D\u6DFB\u52A0\u5907\u6CE8\u4EE5\u8DDF\u8E2A\u91CD\u8981\u4FE1\u606F\u0022,it:\u0022Allega note alle liste e alle unit\u00E0 per tenere traccia di informazioni importanti\u0022,de:\u0022F\u00FCgen Sie Listen und Einheiten Notizen hinzu, um wichtige Informationen zu verfolgen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3068\u30E6\u30CB\u30C3\u30C8\u306B\u30CE\u30FC\u30C8\u3092\u4ED8\u3051\u3066\u91CD\u8981\u306A\u60C5\u5831\u3092\u8FFD\u8DE1\u0022,pl:\u0022Do\u0142\u0105cz notatki do list i jednostek, aby \u015Bledzi\u0107 wa\u017Cne informacje\u0022,pt:\u0022Anexe notas a listas e unidades para acompanhar informa\u00E7\u00F5es importantes\u0022,hr:\u0022Dodajte bilje\u0161ke svojim jedinicama\u0022,cz:\u0022Attach notes to lists and units to keep track of important information\u0022,sk:\u0022Attach notes to lists and units to keep track of important information\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03C4\u03B5 \u03C3\u03B7\u03BC\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03B9\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0437\u0430\u043C\u0435\u0442\u043A\u0438 \u043A \u044E\u043D\u0438\u0442\u0430\u043C \u0438 \u043E\u0442\u0440\u044F\u0434\u0430\u043C\u0022,ko:\u0022Attach notes to lists and units to keep track of important information\u0022},rRe={en:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EFavourites\u003C/strong\u003E!\u0027,fr:\u0027Soutenez New Recruit pour d\u00E9bloquer \u003Cstrong class=\u0022blue\u0022\u003EFavoris\u003C/strong\u003E !\u0027,es:\u0027\u00A1Apoya a New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EFavoritos\u003C/strong\u003E!\u0027,cn:\u0027\u652F\u6301 New Recruit \u4EE5\u89E3\u9501\u003Cstrong class=\u0022blue\u0022\u003E\u6536\u85CF\u5939\u003C/strong\u003E\uFF01\u0027,it:\u0027Sostieni New Recruit per sbloccare \u003Cstrong class=\u0022blue\u0022\u003EPreferiti\u003C/strong\u003E!\u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um \u003Cstrong class=\u0022blue\u0022\u003EFavoriten\u003C/strong\u003E freizuschalten!\u0027,ja:\u0027New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u304A\u6C17\u306B\u5165\u308A\u003C/strong\u003E\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby odblokowa\u0107 \u003Cstrong class=\u0022blue\u0022\u003EUlubione\u003C/strong\u003E!\u0027,pt:\u0027Apoie o New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EFavoritos\u003C/strong\u003E!\u0027,hr:\u0022Otklju\u010Daj zna\u010Dajku favorita\u0022,cz:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EFavourites\u003C/strong\u003E!\u0027,sk:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EFavourites\u003C/strong\u003E!\u0027,gr:\u0022\u039E\u03B5\u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 \u03B1\u03B3\u03B1\u03C0\u03B7\u03BC\u03AD\u03BD\u03C9\u03BD\u0022,ru:\u0022\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u043E\u0435\u0022,ko:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EFavourites\u003C/strong\u003E!\u0027},nRe={en:\u0022Save Unit Loadouts\u0022,fr:\u0022Sauvegarder les Configurations\u0022,es:\u0022Guardar Configuraciones\u0022,cn:\u0022\u4FDD\u5B58\u5355\u4F4D\u914D\u7F6E\u0022,it:\u0022Salva Configurazioni Unit\u00E0\u0022,de:\u0022Einheitenkonfigurationen Speichern\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u88C5\u5099\u3092\u4FDD\u5B58\u0022,pl:\u0022Zapisz Konfiguracje Jednostek\u0022,pt:\u0022Salvar Configura\u00E7\u00F5es de Unidade\u0022,hr:\u0022Spremi favorite\u0022,cz:\u0022Save Unit Loadouts\u0022,sk:\u0022Save Unit Loadouts\u0022,gr:\u0022\u0391\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7 \u03B1\u03B3\u03B1\u03C0\u03B7\u03BC\u03AD\u03BD\u03C9\u03BD\u0022,ru:\u0022\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438\u0022,ko:\u0022Save Unit Loadouts\u0022},iRe={en:\u0027Save any unit loadout as \u0022Favourite\u0022 to quickly recreate it later\u0027,fr:\u0060Sauvegardez n\u0027importe quelle configuration d\u0027unit\u00E9 comme \u0022Favori\u0022 pour la recr\u00E9er rapidement plus tard\u0060,es:\u0027Guarda cualquier configuraci\u00F3n de unidad como \u0022Favorito\u0022 para recrearla r\u00E1pidamente m\u00E1s tarde\u0027,cn:\u0027\u5C06\u4EFB\u4F55\u5355\u4F4D\u914D\u7F6E\u4FDD\u5B58\u4E3A\u0022\u6536\u85CF\u0022\u4EE5\u4FBF\u7A0D\u540E\u5FEB\u901F\u91CD\u65B0\u521B\u5EFA\u0027,it:\u0027Salva qualsiasi configurazione di unit\u00E0 come \u0022Preferito\u0022 per ricrearla rapidamente in seguito\u0027,de:\u0027Speichern Sie jede Einheitenkonfiguration als \u0022Favorit\u0022, um sie sp\u00E4ter schnell wiederherzustellen\u0027,ja:\u0022\u4EFB\u610F\u306E\u30E6\u30CB\u30C3\u30C8\u88C5\u5099\u3092\u300C\u304A\u6C17\u306B\u5165\u308A\u300D\u3068\u3057\u3066\u4FDD\u5B58\u3057\u3001\u5F8C\u3067\u7D20\u65E9\u304F\u518D\u4F5C\u6210\u0022,pl:\u0027Zapisz dowoln\u0105 konfiguracj\u0119 jednostki jako \u0022Ulubione\u0022, aby szybko j\u0105 odtworzy\u0107 p\u00F3\u017Aniej\u0027,pt:\u0027Salve qualquer configura\u00E7\u00E3o de unidade como \u0022Favorito\u0022 para recri\u00E1-la rapidamente depois\u0027,hr:\u0022Spremite omiljene kombinacije jedinica\u0022,cz:\u0027Save any unit loadout as \u0022Favourite\u0022 to quickly recreate it later\u0027,sk:\u0027Save any unit loadout as \u0022Favourite\u0022 to quickly recreate it later\u0027,gr:\u0022\u0391\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03C3\u03C4\u03B5 \u03C3\u03C5\u03C7\u03BD\u03AC \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BC\u03B5\u03BD\u03BF\u03C5\u03C2 \u03C3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03BF\u03CD\u03C2\u0022,ru:\u0022\u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435 \u0447\u0430\u0441\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u044E\u043D\u0438\u0442\u043E\u0432\u0022,ko:\u0027Save any unit loadout as \u0022Favourite\u0022 to quickly recreate it later\u0027},sRe={en:\u0022Quick Recreation\u0022,fr:\u0022Recr\u00E9ation Rapide\u0022,es:\u0022Recreaci\u00F3n R\u00E1pida\u0022,cn:\u0022\u5FEB\u901F\u91CD\u5EFA\u0022,it:\u0022Ricreazione Rapida\u0022,de:\u0022Schnelle Wiederherstellung\u0022,ja:\u0022\u30AF\u30A4\u30C3\u30AF\u518D\u4F5C\u6210\u0022,pl:\u0022Szybkie Odtworzenie\u0022,pt:\u0022Recria\u00E7\u00E3o R\u00E1pida\u0022,hr:\u0022Rekreiraj favorite\u0022,cz:\u0022Quick Recreation\u0022,sk:\u0022Quick Recreation\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B1\u03B3\u03B1\u03C0\u03B7\u03BC\u03AD\u03BD\u03C9\u03BD\u0022,ru:\u0022\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u0432\u043E\u0441\u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u0022,ko:\u0022Quick Recreation\u0022},oRe={en:\u0022Re-create the same unit in 1 click at any time\u0022,fr:\u0022Recr\u00E9ez la m\u00EAme unit\u00E9 en 1 clic \u00E0 tout moment\u0022,es:\u0022Recrea la misma unidad con 1 clic en cualquier momento\u0022,cn:\u0022\u968F\u65F6\u4E00\u952E\u91CD\u65B0\u521B\u5EFA\u76F8\u540C\u7684\u5355\u4F4D\u0022,it:\u0022Ricrea la stessa unit\u00E0 con 1 clic in qualsiasi momento\u0022,de:\u0022Erstellen Sie dieselbe Einheit jederzeit mit einem Klick neu\u0022,ja:\u0022\u3044\u3064\u3067\u30821\u30AF\u30EA\u30C3\u30AF\u3067\u540C\u3058\u30E6\u30CB\u30C3\u30C8\u3092\u518D\u4F5C\u6210\u0022,pl:\u0022Odtw\u00F3rz t\u0119 sam\u0105 jednostk\u0119 jednym klikni\u0119ciem w dowolnym momencie\u0022,pt:\u0022Recrie a mesma unidade com 1 clique a qualquer momento\u0022,hr:\u0022Brzo dodajte spremljene kombinacije\u0022,cz:\u0022Re-create the same unit in 1 click at any time\u0022,sk:\u0022Re-create the same unit in 1 click at any time\u0022,gr:\u0022\u0393\u03C1\u03AE\u03B3\u03BF\u03C1\u03B7 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03B1\u03B3\u03B1\u03C0\u03B7\u03BC\u03AD\u03BD\u03C9\u03BD \u03C3\u03C5\u03BD\u03B4\u03C5\u03B1\u03C3\u03BC\u03CE\u03BD\u0022,ru:\u0022\u0411\u044B\u0441\u0442\u0440\u043E \u0432\u043E\u0441\u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0435 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438\u0022,ko:\u0022Re-create the same unit in 1 click at any time\u0022},aRe={en:\u0027Support New Recruit to enable \u003Cstrong class=\u0022blue\u0022\u003ECustom View\u003C/strong\u003E!\u0027,fr:\u0027Soutenez New Recruit pour activer \u003Cstrong class=\u0022blue\u0022\u003EVue Personnalis\u00E9e\u003C/strong\u003E !\u0027,es:\u0027\u00A1Apoya a New Recruit para habilitar \u003Cstrong class=\u0022blue\u0022\u003EVista Personalizada\u003C/strong\u003E!\u0027,cn:\u0027\u652F\u6301 New Recruit \u4EE5\u542F\u7528\u003Cstrong class=\u0022blue\u0022\u003E\u81EA\u5B9A\u4E49\u89C6\u56FE\u003C/strong\u003E\uFF01\u0027,it:\u0027Sostieni New Recruit per abilitare \u003Cstrong class=\u0022blue\u0022\u003EVista Personalizzata\u003C/strong\u003E!\u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um \u003Cstrong class=\u0022blue\u0022\u003EBenutzerdefinierte Ansicht\u003C/strong\u003E zu aktivieren!\u0027,ja:\u0027New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u30AB\u30B9\u30BF\u30E0\u30D3\u30E5\u30FC\u003C/strong\u003E\u3092\u6709\u52B9\u5316\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby w\u0142\u0105czy\u0107 \u003Cstrong class=\u0022blue\u0022\u003EWidok Niestandardowy\u003C/strong\u003E!\u0027,pt:\u0027Apoie o New Recruit para ativar \u003Cstrong class=\u0022blue\u0022\u003EVisualiza\u00E7\u00E3o Personalizada\u003C/strong\u003E!\u0027,hr:\u0022Otklju\u010Daj prilago\u0111eni prikaz\u0022,cz:\u0027Support New Recruit to enable \u003Cstrong class=\u0022blue\u0022\u003ECustom View\u003C/strong\u003E!\u0027,sk:\u0027Support New Recruit to enable \u003Cstrong class=\u0022blue\u0022\u003ECustom View\u003C/strong\u003E!\u0027,gr:\u0022\u039E\u03B5\u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B7\u03C2 \u03C0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE\u03C2\u0022,ru:\u0022\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u0432\u0438\u0434\u0022,ko:\u0027Support New Recruit to enable \u003Cstrong class=\u0022blue\u0022\u003ECustom View\u003C/strong\u003E!\u0027},lRe={en:\u0022Custom Categories\u0022,fr:\u0022Cat\u00E9gories Personnalis\u00E9es\u0022,es:\u0022Categor\u00EDas Personalizadas\u0022,cn:\u0022\u81EA\u5B9A\u4E49\u7C7B\u522B\u0022,it:\u0022Categorie Personalizzate\u0022,de:\u0022Benutzerdefinierte Kategorien\u0022,ja:\u0022\u30AB\u30B9\u30BF\u30E0\u30AB\u30C6\u30B4\u30EA\u0022,pl:\u0022Niestandardowe Kategorie\u0022,pt:\u0022Categorias Personalizadas\u0022,hr:\u0022Prilago\u0111ene kategorije\u0022,cz:\u0022Custom Categories\u0022,sk:\u0022Custom Categories\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03B9\u03CE\u03BD\u0022,ru:\u0022\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438\u0022,ko:\u0022Custom Categories\u0022},uRe={en:\u0022Create custom categories to complete or replace existing categories (such as Core Units, Characters, Battleline...)\u0022,fr:\u0022Cr\u00E9ez des cat\u00E9gories personnalis\u00E9es pour compl\u00E9ter ou remplacer les cat\u00E9gories existantes (telles que Unit\u00E9s de Base, Personnages, Ligne de Bataille...)\u0022,es:\u0022Crea categor\u00EDas personalizadas para completar o reemplazar categor\u00EDas existentes (como Unidades B\u00E1sicas, Personajes, L\u00EDnea de Batalla...)\u0022,cn:\u0022\u521B\u5EFA\u81EA\u5B9A\u4E49\u7C7B\u522B\u4EE5\u8865\u5145\u6216\u66FF\u6362\u73B0\u6709\u7C7B\u522B\uFF08\u5982\u6838\u5FC3\u5355\u4F4D\u3001\u89D2\u8272\u3001\u6218\u6597\u7EBF...\uFF09\u0022,it:\u0022Crea categorie personalizzate per completare o sostituire le categorie esistenti (come Unit\u00E0 Base, Personaggi, Linea di Battaglia...)\u0022,de:\u0022Erstellen Sie benutzerdefinierte Kategorien, um bestehende Kategorien zu erg\u00E4nzen oder zu ersetzen (wie Kerneinheiten, Charaktere, Schlachtreihe...)\u0022,ja:\u0022\u65E2\u5B58\u306E\u30AB\u30C6\u30B4\u30EA\uFF08\u30B3\u30A2\u30E6\u30CB\u30C3\u30C8\u3001\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3001\u30D0\u30C8\u30EB\u30E9\u30A4\u30F3\u306A\u3069\uFF09\u3092\u88DC\u5B8C\u307E\u305F\u306F\u7F6E\u304D\u63DB\u3048\u308B\u30AB\u30B9\u30BF\u30E0\u30AB\u30C6\u30B4\u30EA\u3092\u4F5C\u6210\u0022,pl:\u0022Tw\u00F3rz niestandardowe kategorie, aby uzupe\u0142ni\u0107 lub zast\u0105pi\u0107 istniej\u0105ce kategorie (takie jak Jednostki Podstawowe, Postacie, Linia Bitwy...)\u0022,pt:\u0022Crie categorias personalizadas para completar ou substituir categorias existentes (como Unidades Principais, Personagens, Linha de Batalha...)\u0022,hr:\u0022Organizirajte jedinice po vlastitim kategorijama\u0022,cz:\u0022Create custom categories to complete or replace existing categories (such as Core Units, Characters, Battleline...)\u0022,sk:\u0022Create custom categories to complete or replace existing categories (such as Core Units, Characters, Battleline...)\u0022,gr:\u0022\u039F\u03C1\u03B3\u03B1\u03BD\u03CE\u03C3\u03C4\u03B5 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03BC\u03B5 \u03B4\u03B9\u03BA\u03CC \u03C3\u03B1\u03C2 \u03C4\u03C1\u03CC\u03C0\u03BF\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438\u0022,ko:\u0022custom categories to complete or replace existing categories (such as Core Units, Characters, Battleline...) \uC0DD\uC131\u0022},cRe={en:\u0022Reorder Everything\u0022,fr:\u0022R\u00E9organiser Tout\u0022,es:\u0022Reordenar Todo\u0022,cn:\u0022\u91CD\u65B0\u6392\u5E8F\u4E00\u5207\u0022,it:\u0022Riordina Tutto\u0022,de:\u0022Alles Neu Anordnen\u0022,ja:\u0022\u3059\u3079\u3066\u3092\u4E26\u3079\u66FF\u3048\u0022,pl:\u0022Zmie\u0144 Kolejno\u015B\u0107 Wszystkiego\u0022,pt:\u0022Reordenar Tudo\u0022,hr:\u0022Preuredi jedinice\u0022,cz:\u0022Reorder Everything\u0022,sk:\u0022Reorder Everything\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7 \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0438\u0442\u044C \u0432\u0441\u0451\u0022,ko:\u0022Reorder Everything\u0022},ARe={en:\u0022Reorder categories and move units into any category. Reorder units within their category\u0022,fr:\u0022R\u00E9organisez les cat\u00E9gories et d\u00E9placez les unit\u00E9s dans n\u0027importe quelle cat\u00E9gorie. R\u00E9organisez les unit\u00E9s au sein de leur cat\u00E9gorie\u0022,es:\u0022Reordena categor\u00EDas y mueve unidades a cualquier categor\u00EDa. Reordena unidades dentro de su categor\u00EDa\u0022,cn:\u0022\u91CD\u65B0\u6392\u5E8F\u7C7B\u522B\u5E76\u5C06\u5355\u4F4D\u79FB\u52A8\u5230\u4EFB\u4F55\u7C7B\u522B\u3002\u5728\u7C7B\u522B\u5185\u91CD\u65B0\u6392\u5E8F\u5355\u4F4D\u0022,it:\u0022Riordina le categorie e sposta le unit\u00E0 in qualsiasi categoria. Riordina le unit\u00E0 all\u0027interno della loro categoria\u0022,de:\u0022Ordnen Sie Kategorien neu an und verschieben Sie Einheiten in beliebige Kategorien. Ordnen Sie Einheiten innerhalb ihrer Kategorie neu an\u0022,ja:\u0022\u30AB\u30C6\u30B4\u30EA\u3092\u4E26\u3079\u66FF\u3048\u3001\u30E6\u30CB\u30C3\u30C8\u3092\u4EFB\u610F\u306E\u30AB\u30C6\u30B4\u30EA\u306B\u79FB\u52D5\u3002\u30AB\u30C6\u30B4\u30EA\u5185\u3067\u30E6\u30CB\u30C3\u30C8\u3092\u4E26\u3079\u66FF\u3048\u0022,pl:\u0022Zmie\u0144 kolejno\u015B\u0107 kategorii i przenie\u015B jednostki do dowolnej kategorii. Zmie\u0144 kolejno\u015B\u0107 jednostek w ich kategorii\u0022,pt:\u0022Reordene categorias e mova unidades para qualquer categoria. Reordene unidades dentro de sua categoria\u0022,hr:\u0022Promijenite redoslijed jedinica\u0022,cz:\u0022Reorder categories and move units into any category. Reorder units within their category\u0022,sk:\u0022Reorder categories and move units into any category. Reorder units within their category\u0022,gr:\u0022\u03A4\u03B1\u03BA\u03C4\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B9\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03CC\u03C0\u03C9\u03C2 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u0438 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u0443\u0439\u0442\u0435 \u044E\u043D\u0438\u0442\u044B\u0022,ko:\u0022Reorder categories and move units into any category. Reorder units within their category\u0022},dRe={en:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EUnit Leaders\u003C/strong\u003E!\u0027,fr:\u0060Soutenez New Recruit pour d\u00E9bloquer \u003Cstrong class=\u0022blue\u0022\u003EChefs d\u0027Unit\u00E9\u003C/strong\u003E !\u0060,es:\u0027\u00A1Apoya a New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EL\u00EDderes de Unidad\u003C/strong\u003E!\u0027,cn:\u0027\u652F\u6301 New Recruit \u4EE5\u89E3\u9501\u003Cstrong class=\u0022blue\u0022\u003E\u5355\u4F4D\u9886\u8896\u003C/strong\u003E\uFF01\u0027,it:\u0027Sostieni New Recruit per sbloccare \u003Cstrong class=\u0022blue\u0022\u003ELeader Unit\u00E0\u003C/strong\u003E!\u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um \u003Cstrong class=\u0022blue\u0022\u003EEinheitenf\u00FChrer\u003C/strong\u003E freizuschalten!\u0027,ja:\u0027New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u30E6\u30CB\u30C3\u30C8\u30EA\u30FC\u30C0\u30FC\u003C/strong\u003E\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby odblokowa\u0107 \u003Cstrong class=\u0022blue\u0022\u003ELider\u00F3w Jednostek\u003C/strong\u003E!\u0027,pt:\u0027Apoie o New Recruit para desbloquear \u003Cstrong class=\u0022blue\u0022\u003EL\u00EDderes de Unidade\u003C/strong\u003E!\u0027,hr:\u0022Otklju\u010Daj zna\u010Dajku vo\u0111a\u0022,cz:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EUnit Leaders\u003C/strong\u003E!\u0027,sk:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EUnit Leaders\u003C/strong\u003E!\u0027,gr:\u0022\u039E\u03B5\u03BA\u03BB\u03B5\u03AF\u03B4\u03C9\u03BC\u03B1 \u03B1\u03C1\u03C7\u03B7\u03B3\u03CE\u03BD\u0022,ru:\u0022\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043B\u0438\u0434\u0435\u0440\u043E\u0432\u0022,ko:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003EUnit Leaders\u003C/strong\u003E!\u0027},fRe={en:\u0022Select Leaders\u0022,fr:\u0022S\u00E9lectionner les Chefs\u0022,es:\u0022Seleccionar L\u00EDderes\u0022,cn:\u0022\u9009\u62E9\u9886\u8896\u0022,it:\u0022Seleziona Leader\u0022,de:\u0022F\u00FChrer Ausw\u00E4hlen\u0022,ja:\u0022\u30EA\u30FC\u30C0\u30FC\u3092\u9078\u629E\u0022,pl:\u0022Wybierz Lider\u00F3w\u0022,pt:\u0022Selecionar L\u00EDderes\u0022,hr:\u0022Odaberi vo\u0111e\u0022,cz:\u0022Select Leaders\u0022,sk:\u0022Select Leaders\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C1\u03C7\u03B7\u03B3\u03CE\u03BD\u0022,ru:\u0022\u0412\u044B\u0431\u043E\u0440 \u043B\u0438\u0434\u0435\u0440\u043E\u0432\u0022,ko:\u0022Leaders \uC120\uD0DD\u0022},pRe={en:\u0022Select unit leaders and view units grouped with their leader\u0022,fr:\u0022S\u00E9lectionnez les chefs d\u0027unit\u00E9 et visualisez les unit\u00E9s regroup\u00E9es avec leur chef\u0022,es:\u0022Selecciona l\u00EDderes de unidad y visualiza unidades agrupadas con su l\u00EDder\u0022,cn:\u0022\u9009\u62E9\u5355\u4F4D\u9886\u8896\u5E76\u67E5\u770B\u4E0E\u5176\u9886\u8896\u5206\u7EC4\u7684\u5355\u4F4D\u0022,it:\u0022Seleziona i leader delle unit\u00E0 e visualizza le unit\u00E0 raggruppate con il loro leader\u0022,de:\u0022W\u00E4hlen Sie Einheitenf\u00FChrer aus und zeigen Sie Einheiten gruppiert mit ihrem F\u00FChrer an\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u30EA\u30FC\u30C0\u30FC\u3092\u9078\u629E\u3057\u3001\u30EA\u30FC\u30C0\u30FC\u3068\u30B0\u30EB\u30FC\u30D7\u5316\u3055\u308C\u305F\u30E6\u30CB\u30C3\u30C8\u3092\u8868\u793A\u0022,pl:\u0022Wybierz lider\u00F3w jednostek i zobacz jednostki zgrupowane z ich liderem\u0022,pt:\u0022Selecione l\u00EDderes de unidade e visualize unidades agrupadas com seu l\u00EDder\u0022,hr:\u0022Dodijelite vo\u0111e jedinicama\u0022,cz:\u0022Select unit leaders and view units grouped with their leader\u0022,sk:\u0022Select unit leaders and view units grouped with their leader\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03B1\u03C1\u03C7\u03B7\u03B3\u03BF\u03CD\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03B9\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043B\u0438\u0434\u0435\u0440\u043E\u0432 \u0434\u043B\u044F \u0432\u0430\u0448\u0438\u0445 \u044E\u043D\u0438\u0442\u043E\u0432\u0022,ko:\u0022unit leaders and view units grouped with their leader \uC120\uD0DD\u0022},hRe={en:\u0022Combined Profiles\u0022,fr:\u0022Profils Combin\u00E9s\u0022,es:\u0022Perfiles Combinados\u0022,cn:\u0022\u7EC4\u5408\u6863\u6848\u0022,it:\u0022Profili Combinati\u0022,de:\u0022Kombinierte Profile\u0022,ja:\u0022\u7D50\u5408\u30D7\u30ED\u30D5\u30A1\u30A4\u30EB\u0022,pl:\u0022Po\u0142\u0105czone Profile\u0022,pt:\u0022Perfis Combinados\u0022,hr:\u0022Stratagemi vo\u0111a\u0022,cz:\u0022Combined Profiles\u0022,sk:\u0022Combined Profiles\u0022,gr:\u0022\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1 \u03B1\u03C1\u03C7\u03B7\u03B3\u03CE\u03BD\u0022,ru:\u0022\u0421\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u044B \u043B\u0438\u0434\u0435\u0440\u043E\u0432\u0022,ko:\u0022Combined Profiles\u0022},mRe={en:\u0022Combine profiles to have a full overview of the unit\u0022,fr:\u0022Combinez les profils pour avoir une vue d\u0027ensemble compl\u00E8te de l\u0027unit\u00E9\u0022,es:\u0022Combina perfiles para tener una visi\u00F3n completa de la unidad\u0022,cn:\u0022\u7EC4\u5408\u6863\u6848\u4EE5\u5168\u9762\u4E86\u89E3\u5355\u4F4D\u0022,it:\u0022Combina i profili per avere una panoramica completa dell\u0027unit\u00E0\u0022,de:\u0022Kombinieren Sie Profile, um eine vollst\u00E4ndige \u00DCbersicht \u00FCber die Einheit zu erhalten\u0022,ja:\u0022\u30D7\u30ED\u30D5\u30A1\u30A4\u30EB\u3092\u7D44\u307F\u5408\u308F\u305B\u3066\u30E6\u30CB\u30C3\u30C8\u306E\u5168\u4F53\u50CF\u3092\u628A\u63E1\u0022,pl:\u0022Po\u0142\u0105cz profile, aby mie\u0107 pe\u0142ny przegl\u0105d jednostki\u0022,pt:\u0022Combine perfis para ter uma vis\u00E3o completa da unidade\u0022,hr:\u0022Pristupite stratagemima povezanim s vo\u0111ama\u0022,cz:\u0022Combine profiles to have a full overview of the unit\u0022,sk:\u0022Combine profiles to have a full overview of the unit\u0022,gr:\u0022\u03A0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7 \u03C3\u03B5 \u03C3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1 \u03B1\u03C1\u03C7\u03B7\u03B3\u03CE\u03BD\u0022,ru:\u0022\u0414\u043E\u0441\u0442\u0443\u043F \u043A \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u0430\u043C\u0022,ko:\u0022Combine profiles to have a full overview of the unit\u0022},gRe={en:\u0027Support New Recruit to unlock \u003Cstrong class=\u0022blue\u0022\u003ECasualty Tracking\u003C/strong\u003E!\u0027,fr:\u0027Soutenez New Recruit pour d\u00E9bloquer le \u003Cstrong class=\u0022blue\u0022\u003ESuivi des Pertes\u003C/strong\u003E !\u0027,es:\u0027\u00A1Apoya a New Recruit para desbloquear el \u003Cstrong class=\u0022blue\u0022\u003ESeguimiento de Bajas\u003C/strong\u003E!\u0027,cn:\u0027\u652F\u6301 New Recruit \u4EE5\u89E3\u9501\u003Cstrong class=\u0022blue\u0022\u003E\u4F24\u4EA1\u8FFD\u8E2A\u003C/strong\u003E\uFF01\u0027,it:\u0027Sostieni New Recruit per sbloccare il \u003Cstrong class=\u0022blue\u0022\u003ETracciamento Perdite\u003C/strong\u003E!\u0027,de:\u0027Unterst\u00FCtzen Sie New Recruit, um die \u003Cstrong class=\u0022blue\u0022\u003EVerlust-Verfolgung\u003C/strong\u003E freizuschalten!\u0027,ja:\u0027New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u003Cstrong class=\u0022blue\u0022\u003E\u640D\u5BB3\u8FFD\u8DE1\u003C/strong\u003E\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0027,pl:\u0027Wesprzyj New Recruit, aby odblokowa\u0107 \u003Cstrong class=\u0022blue\u0022\u003E\u015Aledzenie Strat\u003C/strong\u003E!\u0027,pt:\u0027Apoie o New Recruit para desbloquear o \u003Cstrong class=\u0022blue\u0022\u003ERastreamento de Baixas\u003C/strong\u003E!\u0027,hr:\u0027Podr\u017Eite New Recruit za otklju\u010Davanje \u003Cstrong class=\u0022blue\u0022\u003EPra\u0107enja Gubitaka\u003C/strong\u003E!\u0027,cz:\u0027Podpo\u0159te New Recruit pro odemknut\u00ED \u003Cstrong class=\u0022blue\u0022\u003ESledov\u00E1n\u00ED Ztr\u00E1t\u003C/strong\u003E!\u0027,sk:\u0027Podporte New Recruit pre odomknutie \u003Cstrong class=\u0022blue\u0022\u003ESledovania Str\u00E1t\u003C/strong\u003E!\u0027,gr:\u0027\u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03C4\u03B5 \u03C4\u03BF New Recruit \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03B7\u03BD \u003Cstrong class=\u0022blue\u0022\u003E\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B7 \u0391\u03C0\u03C9\u03BB\u03B5\u03B9\u03CE\u03BD\u003C/strong\u003E!\u0027,ru:\u0027\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0442\u0435 New Recruit, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u003Cstrong class=\u0022blue\u0022\u003E\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u041F\u043E\u0442\u0435\u0440\u044C\u003C/strong\u003E!\u0027,ko:\u0027New Recruit\uB97C \uC9C0\uC6D0\uD558\uC5EC \u003Cstrong class=\u0022blue\u0022\u003E\uC0AC\uC0C1\uC790 \uCD94\uC801\u003C/strong\u003E\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694!\u0027},yRe={en:\u0022Track Casualties\u0022,fr:\u0022Suivre les Pertes\u0022,es:\u0022Seguir Bajas\u0022,cn:\u0022\u8FFD\u8E2A\u4F24\u4EA1\u0022,it:\u0022Traccia Perdite\u0022,de:\u0022Verluste Verfolgen\u0022,ja:\u0022\u640D\u5BB3\u3092\u8FFD\u8DE1\u0022,pl:\u0022\u015Aled\u017A Straty\u0022,pt:\u0022Rastrear Baixas\u0022,hr:\u0022Prati Gubitke\u0022,cz:\u0022Sledovat Ztr\u00E1ty\u0022,sk:\u0022Sledova\u0165 Straty\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B7 \u0391\u03C0\u03C9\u03BB\u03B5\u03B9\u03CE\u03BD\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C \u041F\u043E\u0442\u0435\u0440\u0438\u0022,ko:\u0022\uC0AC\uC0C1\uC790 \uCD94\uC801\u0022},wRe={en:\u0022Track the number of killed models during a game with simple \u002B/- buttons\u0022,fr:\u0022Suivez le nombre de figurines tu\u00E9es pendant une partie avec de simples boutons \u002B/-\u0022,es:\u0022Sigue el n\u00FAmero de miniaturas eliminadas durante una partida con simples botones \u002B/-\u0022,cn:\u0022\u4F7F\u7528\u7B80\u5355\u7684 \u002B/- \u6309\u94AE\u8FFD\u8E2A\u6E38\u620F\u4E2D\u88AB\u51FB\u6740\u7684\u6A21\u578B\u6570\u91CF\u0022,it:\u0022Traccia il numero di modelli uccisi durante una partita con semplici pulsanti \u002B/-\u0022,de:\u0022Verfolgen Sie die Anzahl der get\u00F6teten Modelle w\u00E4hrend eines Spiels mit einfachen \u002B/- Tasten\u0022,ja:\u0022\u30B7\u30F3\u30D7\u30EB\u306A \u002B/- \u30DC\u30BF\u30F3\u3067\u30B2\u30FC\u30E0\u4E2D\u306B\u5012\u3055\u308C\u305F\u30E2\u30C7\u30EB\u6570\u3092\u8FFD\u8DE1\u0022,pl:\u0022\u015Aled\u017A liczb\u0119 zabitych modeli podczas gry za pomoc\u0105 prostych przycisk\u00F3w \u002B/-\u0022,pt:\u0022Rastreie o n\u00FAmero de miniaturas eliminadas durante uma partida com simples bot\u00F5es \u002B/-\u0022,hr:\u0022Pratite broj ubijenih modela tijekom igre s jednostavnim \u002B/- gumbima\u0022,cz:\u0022Sledujte po\u010Det zabit\u00FDch model\u016F b\u011Bhem hry pomoc\u00ED jednoduch\u00FDch tla\u010D\u00EDtek \u002B/-\u0022,sk:\u0022Sledujte po\u010Det zabit\u00FDch modelov po\u010Das hry pomocou jednoduch\u00FDch tla\u010Didiel \u002B/-\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03BD \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC \u03C4\u03C9\u03BD \u03BD\u03B5\u03BA\u03C1\u03CE\u03BD \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03C9\u03BD \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03B4\u03B9\u03AC\u03C1\u03BA\u03B5\u03B9\u03B1 \u03B5\u03BD\u03CC\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03BC\u03B5 \u03B1\u03C0\u03BB\u03AC \u03BA\u03BF\u03C5\u03BC\u03C0\u03B9\u03AC \u002B/-\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0443\u0431\u0438\u0442\u044B\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u043A\u043D\u043E\u043F\u043E\u043A \u002B/-\u0022,ko:\u0022\uAC04\uB2E8\uD55C \u002B/- \uBC84\uD2BC\uC73C\uB85C \uAC8C\uC784 \uC911 \uC0AC\uB9DD\uD55C \uBAA8\uB378 \uC218\uB97C \uCD94\uC801\uD558\uC138\uC694\u0022},bRe={en:\u0022Dynamic Profiles\u0022,fr:\u0022Profils Dynamiques\u0022,es:\u0022Perfiles Din\u00E1micos\u0022,cn:\u0022\u52A8\u6001\u6863\u6848\u0022,it:\u0022Profili Dinamici\u0022,de:\u0022Dynamische Profile\u0022,ja:\u0022\u30C0\u30A4\u30CA\u30DF\u30C3\u30AF\u30D7\u30ED\u30D5\u30A1\u30A4\u30EB\u0022,pl:\u0022Dynamiczne Profile\u0022,pt:\u0022Perfis Din\u00E2micos\u0022,hr:\u0022Dinami\u010Dki Profili\u0022,cz:\u0022Dynamick\u00E9 Profily\u0022,sk:\u0022Dynamick\u00E9 Profily\u0022,gr:\u0022\u0394\u03C5\u03BD\u03B1\u03BC\u03B9\u03BA\u03AC \u03A0\u03C1\u03BF\u03C6\u03AF\u03BB\u0022,ru:\u0022\u0414\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u041F\u0440\u043E\u0444\u0438\u043B\u0438\u0022,ko:\u0022\uB3D9\uC801 \uD504\uB85C\uD544\u0022},vRe={en:\u0022Unit profiles automatically update to reflect remaining models and their weapons\u0022,fr:\u0022Les profils d\u0027unit\u00E9 se mettent automatiquement \u00E0 jour pour refl\u00E9ter les figurines restantes et leurs armes\u0022,es:\u0022Los perfiles de unidad se actualizan autom\u00E1ticamente para reflejar las miniaturas restantes y sus armas\u0022,cn:\u0022\u5355\u4F4D\u6863\u6848\u81EA\u52A8\u66F4\u65B0\u4EE5\u53CD\u6620\u5269\u4F59\u6A21\u578B\u53CA\u5176\u6B66\u5668\u0022,it:\u0022I profili unit\u00E0 si aggiornano automaticamente per riflettere i modelli rimanenti e le loro armi\u0022,de:\u0022Einheitenprofile werden automatisch aktualisiert, um verbleibende Modelle und ihre Waffen widerzuspiegeln\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u30D7\u30ED\u30D5\u30A1\u30A4\u30EB\u304C\u81EA\u52D5\u7684\u306B\u66F4\u65B0\u3055\u308C\u3001\u6B8B\u308A\u306E\u30E2\u30C7\u30EB\u3068\u305D\u306E\u6B66\u5668\u3092\u53CD\u6620\u0022,pl:\u0022Profile jednostek automatycznie aktualizuj\u0105 si\u0119, aby odzwierciedli\u0107 pozosta\u0142e modele i ich bro\u0144\u0022,pt:\u0022Os perfis de unidade s\u00E3o atualizados automaticamente para refletir as miniaturas restantes e suas armas\u0022,hr:\u0022Profili jedinica automatski se a\u017Euriraju kako bi odra\u017Eavali preostale modele i njihovo oru\u017Eje\u0022,cz:\u0022Profily jednotek se automaticky aktualizuj\u00ED, aby odr\u00E1\u017Eely zb\u00FDvaj\u00EDc\u00ED modely a jejich zbran\u011B\u0022,sk:\u0022Profily jednotiek sa automaticky aktualizuj\u00FA, aby odr\u00E1\u017Eali zost\u00E1vaj\u00FAce modely a ich zbrane\u0022,gr:\u0022\u03A4\u03B1 \u03C0\u03C1\u03BF\u03C6\u03AF\u03BB \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03BF\u03C0\u03C4\u03C1\u03AF\u03B6\u03BF\u03C5\u03BD \u03C4\u03B1 \u03B5\u03BD\u03B1\u03C0\u03BF\u03BC\u03B5\u03AF\u03BD\u03B1\u03BD\u03C4\u03B1 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03B1 \u03CC\u03C0\u03BB\u03B1 \u03C4\u03BF\u03C5\u03C2\u0022,ru:\u0022\u041F\u0440\u043E\u0444\u0438\u043B\u0438 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u044E\u0442\u0441\u044F, \u043E\u0442\u0440\u0430\u0436\u0430\u044F \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u043C\u043E\u0434\u0435\u043B\u0438 \u0438 \u0438\u0445 \u043E\u0440\u0443\u0436\u0438\u0435\u0022,ko:\u0022\uC720\uB2DB \uD504\uB85C\uD544\uC774 \uC790\uB3D9\uC73C\uB85C \uC5C5\uB370\uC774\uD2B8\uB418\uC5B4 \uB0A8\uC740 \uBAA8\uB378\uACFC \uBB34\uAE30\uB97C \uBC18\uC601\uD569\uB2C8\uB2E4\u0022},kRe={en:\u0022Email Address List\u0022,fr:\u0022Liste des adresses email\u0022,es:\u0022Lista de direcciones de correo electr\u00F3nico\u0022,cn:\u0022\u7535\u5B50\u90AE\u4EF6\u5730\u5740\u5217\u8868\u0022,it:\u0022Elenco indirizzi email\u0022,de:\u0022E-Mail-Adressenliste\u0022,ja:\u0022\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u30EA\u30B9\u30C8\u0022,pl:\u0022Lista adres\u00F3w email\u0022,pt:\u0022Lista de endere\u00E7os de email\u0022,hr:\u0022Lista email adresa\u0022,cz:\u0022Email Address List\u0022,sk:\u0022Email Address List\u0022,gr:\u0022\u039B\u03AF\u03C3\u03C4\u03B1 \u03B4\u03B9\u03B5\u03C5\u03B8\u03CD\u03BD\u03C3\u03B5\u03C9\u03BD email\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A email \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0022,ko:\u0022Email Address List\u0022},BRe={en:\u0022Separator character\u0022,fr:\u0022Caract\u00E8re de s\u00E9paration\u0022,es:\u0022Car\u00E1cter separador\u0022,cn:\u0022\u5206\u9694\u7B26\u0022,it:\u0022Carattere separatore\u0022,de:\u0022Trennzeichen\u0022,ja:\u0022\u533A\u5207\u308A\u6587\u5B57\u0022,pl:\u0022Znak separatora\u0022,pt:\u0022Caractere separador\u0022,hr:\u0022Znak razdvajanja\u0022,cz:\u0022Separator character\u0022,sk:\u0022Separator character\u0022,gr:\u0022\u03A7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B1\u03C2 \u03B4\u03B9\u03B1\u03C7\u03C9\u03C1\u03B9\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u0022,ko:\u0022Separator character\u0022},CRe={en:\u0022players out of\u0022,fr:\u0022joueurs sur\u0022,es:\u0022jugadores de\u0022,cn:\u0022\u73A9\u5BB6\u4E2D\u6709\u0022,it:\u0022giocatori su\u0022,de:\u0022Spieler von\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u4E2D\u0022,pl:\u0022graczy na\u0022,pt:\u0022jogadores de\u0022,hr:\u0022Igra\u010Di s emailom\u0022,cz:\u0022players out of\u0022,sk:\u0022players out of\u0022,gr:\u0022\u03A0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03BC\u03B5 email\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u043A\u0438 out of\u0022,ko:\u0022players out of\u0022},_Re={en:\u0022have an email address recorded.\u0022,fr:\u0022ont une adresse email enregistr\u00E9e.\u0022,es:\u0022tienen una direcci\u00F3n de correo electr\u00F3nico registrada.\u0022,cn:\u0022\u5DF2\u8BB0\u5F55\u7535\u5B50\u90AE\u4EF6\u5730\u5740\u3002\u0022,it:\u0022hanno un indirizzo email registrato.\u0022,de:\u0022haben eine E-Mail-Adresse gespeichert.\u0022,ja:\u0022\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u304C\u767B\u9332\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u0022,pl:\u0022maj\u0105 zapisany adres email.\u0022,pt:\u0022t\u00EAm um endere\u00E7o de email registrado.\u0022,hr:\u0022imaju zabilje\u017Een email\u0022,cz:\u0022have an email address recorded.\u0022,sk:\u0022have an email address recorded.\u0022,gr:\u0022\u0388\u03C7\u03BF\u03C5\u03BD email \u03BA\u03B1\u03C4\u03B1\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u0022,ru:\u0022\u0423\u043A\u0430\u0437\u0430\u043B\u0438 email\u0022,ko:\u0022have an email address recorded.\u0022},SRe={en:\u0022Copy Emails to Clipboard\u0022,fr:\u0022Copier les emails dans le presse-papier\u0022,es:\u0022Copiar correos electr\u00F3nicos al portapapeles\u0022,cn:\u0022\u590D\u5236\u7535\u5B50\u90AE\u4EF6\u5230\u526A\u8D34\u677F\u0022,it:\u0022Copia email negli appunti\u0022,de:\u0022E-Mails in Zwischenablage kopieren\u0022,ja:\u0022\u30E1\u30FC\u30EB\u3092\u30AF\u30EA\u30C3\u30D7\u30DC\u30FC\u30C9\u306B\u30B3\u30D4\u30FC\u0022,pl:\u0022Kopiuj emaile do schowka\u0022,pt:\u0022Copiar emails para a \u00E1rea de transfer\u00EAncia\u0022,hr:\u0022Kopiraj emailove\u0022,cz:\u0022Copy Emails to Clipboard\u0022,sk:\u0022Copy Emails to Clipboard\u0022,gr:\u0022\u0391\u03BD\u03C4\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE emails\u0022,ru:\u0022\u0421\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C email \u0430\u0434\u0440\u0435\u0441\u0430\u0022,ko:\u0022Copy Emails to Clipboard\u0022},ERe={en:\u0022Broadcast to\u0022,fr:\u0022Diffuser \u00E0\u0022,es:\u0022Difundir a\u0022,cn:\u0022\u5E7F\u64AD\u7ED9\u0022,it:\u0022Trasmetti a\u0022,de:\u0022Senden an\u0022,ja:\u0022\u30D6\u30ED\u30FC\u30C9\u30AD\u30E3\u30B9\u30C8\u5148\u0022,pl:\u0022Wy\u015Blij do\u0022,pt:\u0022Transmitir para\u0022,hr:\u0022Objavi za\u0022,cz:\u0022Broadcast to\u0022,sk:\u0022Broadcast to\u0022,gr:\u0022\u0395\u03BA\u03C0\u03BF\u03BC\u03C0\u03AE to\u0022,ru:\u0022\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432\u0022,ko:\u0022Broadcast to\u0022},jRe={en:\u0022players by the Discord Bot\u0022,fr:\u0022joueurs via le Bot Discord\u0022,es:\u0022jugadores por el Bot de Discord\u0022,cn:\u0022\u73A9\u5BB6\u901A\u8FC7 Discord \u673A\u5668\u4EBA\u0022,it:\u0022giocatori tramite il Bot Discord\u0022,de:\u0022Spieler \u00FCber den Discord-Bot\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u306B Discord \u30DC\u30C3\u30C8\u7D4C\u7531\u3067\u0022,pl:\u0022graczy przez Bota Discord\u0022,pt:\u0022jogadores pelo Bot do Discord\u0022,hr:\u0022igra\u010De putem bota\u0022,cz:\u0022players by the Discord Bot\u0022,sk:\u0022players by the Discord Bot\u0022,gr:\u0022\u03A0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03BC\u03AD\u03C3\u03C9 bot\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u043A\u043E\u0432 \u0447\u0435\u0440\u0435\u0437 \u0431\u043E\u0442\u0430\u0022,ko:\u0022players by the Discord Bot\u0022},zRe={en:\u0022Broadcast Message\u0022,fr:\u0022Diffuser le message\u0022,es:\u0022Difundir mensaje\u0022,cn:\u0022\u5E7F\u64AD\u6D88\u606F\u0022,it:\u0022Trasmetti messaggio\u0022,de:\u0022Nachricht senden\u0022,ja:\u0022\u30E1\u30C3\u30BB\u30FC\u30B8\u3092\u30D6\u30ED\u30FC\u30C9\u30AD\u30E3\u30B9\u30C8\u0022,pl:\u0022Wy\u015Blij wiadomo\u015B\u0107\u0022,pt:\u0022Transmitir mensagem\u0022,hr:\u0022Objavi poruku\u0022,cz:\u0022Broadcast Message\u0022,sk:\u0022Broadcast Message\u0022,gr:\u0022\u0395\u03BA\u03C0\u03BF\u03BC\u03C0\u03AE \u039C\u03AE\u03BD\u03C5\u03BC\u03B1\u0022,ru:\u0022\u0420\u0430\u0441\u0441\u044B\u043B\u043A\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439\u0022,ko:\u0022Broadcast Message\u0022},IRe={en:\u0022Notify List Review\u0022,fr:\u0022Notifier R\u00E9vision des Listes\u0022,es:\u0022Notificar Revisi\u00F3n de Listas\u0022,cn:\u0022\u901A\u77E5\u5217\u8868\u5BA1\u6838\u0022,it:\u0022Notifica Revisione Liste\u0022,de:\u0022Listen\u00FCberpr\u00FCfung Benachrichtigen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u78BA\u8A8D\u3092\u901A\u77E5\u0022,pl:\u0022Powiadom o Przegl\u0105dzie List\u0022,pt:\u0022Notificar Revis\u00E3o de Listas\u0022,hr:\u0022Obavijesti o dodjelama recenzija\u0022,cz:\u0022Notify List Review\u0022,sk:\u0022Notify List Review\u0022,gr:\u0022\u0395\u03B9\u03B4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03B1\u03BD\u03B1\u03B8\u03AD\u03C3\u03B5\u03C9\u03BD \u03B1\u03BE\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0423\u0432\u0435\u0434\u043E\u043C\u0438\u0442\u044C \u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\u0445 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438\u0022,ko:\u0022Notify List Review\u0022},PRe={en:\u0022Email list copied to Clipboard\u0022,fr:\u0022Liste d\u0027emails copi\u00E9e dans le presse-papier\u0022,es:\u0022Lista de correos copiada al portapapeles\u0022,cn:\u0022\u7535\u5B50\u90AE\u4EF6\u5217\u8868\u5DF2\u590D\u5236\u5230\u526A\u8D34\u677F\u0022,it:\u0022Elenco email copiato negli appunti\u0022,de:\u0022E-Mail-Liste in Zwischenablage kopiert\u0022,ja:\u0022\u30E1\u30FC\u30EB\u30EA\u30B9\u30C8\u3092\u30AF\u30EA\u30C3\u30D7\u30DC\u30FC\u30C9\u306B\u30B3\u30D4\u30FC\u3057\u307E\u3057\u305F\u0022,pl:\u0022Lista emaili skopiowana do schowka\u0022,pt:\u0022Lista de emails copiada para a \u00E1rea de transfer\u00EAncia\u0022,hr:\u0022Email kopirani\u0022,cz:\u0022Email list copied to Clipboard\u0022,sk:\u0022Email list copied to Clipboard\u0022,gr:\u0022\u03A4\u03BF email \u03B1\u03BD\u03C4\u03B9\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5\u0022,ru:\u0022Email \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u044B\u0022,ko:\u0022Email list copied to Clipboard\u0022},TRe={en:\u0022Notifications have been sent!\u0022,fr:\u0022Les notifications ont \u00E9t\u00E9 envoy\u00E9es !\u0022,es:\u0022\u00A1Las notificaciones han sido enviadas!\u0022,cn:\u0022\u901A\u77E5\u5DF2\u53D1\u9001\uFF01\u0022,it:\u0022Le notifiche sono state inviate!\u0022,de:\u0022Benachrichtigungen wurden gesendet!\u0022,ja:\u0022\u901A\u77E5\u304C\u9001\u4FE1\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,pl:\u0022Powiadomienia zosta\u0142y wys\u0142ane!\u0022,pt:\u0022Notifica\u00E7\u00F5es foram enviadas!\u0022,hr:\u0022Obavijesti poslane\u0022,cz:\u0022Notifications have been sent!\u0022,sk:\u0022Notifications have been sent!\u0022,gr:\u0022\u039F\u03B9 \u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C3\u03C4\u03AC\u03BB\u03B8\u03B7\u03BA\u03B1\u03BD\u0022,ru:\u0022\u0423\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B\u0022,ko:\u0022Notifications have been sent!\u0022},NRe={en:\u0022Preserve folders\u0022,fr:\u0022Conserver les dossiers\u0022,es:\u0022Conservar carpetas\u0022,cn:\u0022\u4FDD\u7559\u6587\u4EF6\u5939\u0022,it:\u0022Conserva cartelle\u0022,de:\u0022Ordner beibehalten\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u4FDD\u6301\u0022,pl:\u0022Zachowaj foldery\u0022,pt:\u0022Preservar pastas\u0022,hr:\u0022Sa\u010Duvaj mape\u0022,cz:\u0022Preserve folders\u0022,sk:\u0022Preserve folders\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7 \u03C6\u03B1\u03BA\u03AD\u03BB\u03C9\u03BD\u0022,ru:\u0022\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u0430\u043F\u043A\u0438\u0022,ko:\u0022Preserve folders\u0022},FRe={en:\u0022Select folder to preserve\u0022,fr:\u0022S\u00E9lectionner un dossier \u00E0 conserver\u0022,es:\u0022Seleccionar carpeta a conservar\u0022,cn:\u0022\u9009\u62E9\u8981\u4FDD\u7559\u7684\u6587\u4EF6\u5939\u0022,it:\u0022Seleziona cartella da conservare\u0022,de:\u0022Ordner zum Beibehalten ausw\u00E4hlen\u0022,ja:\u0022\u4FDD\u6301\u3059\u308B\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u9078\u629E\u0022,pl:\u0022Wybierz folder do zachowania\u0022,pt:\u0022Selecionar pasta para preservar\u0022,hr:\u0022Odaberi mapu za \u010Duvanje\u0022,cz:\u0022Select folder to preserve\u0022,sk:\u0022Select folder to preserve\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0430\u043F\u043A\u0443 \u0434\u043B\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F\u0022,ko:\u0022folder to preserve \uC120\uD0DD\u0022},RRe={en:\u0022Add folder to preserve list\u0022,fr:\u0022Ajouter le dossier \u00E0 la liste de conservation\u0022,es:\u0022A\u00F1adir carpeta a la lista de conservaci\u00F3n\u0022,cn:\u0022\u5C06\u6587\u4EF6\u5939\u6DFB\u52A0\u5230\u4FDD\u7559\u5217\u8868\u0022,it:\u0022Aggiungi cartella alla lista di conservazione\u0022,de:\u0022Ordner zur Beibehaltungsliste hinzuf\u00FCgen\u0022,ja:\u0022\u4FDD\u6301\u30EA\u30B9\u30C8\u306B\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj folder do listy zachowanych\u0022,pt:\u0022Adicionar pasta \u00E0 lista de preserva\u00E7\u00E3o\u0022,hr:\u0022Dodaj mapu za \u010Duvanje\u0022,cz:\u0022Add folder to preserve list\u0022,sk:\u0022Add folder to preserve list\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5 \u03C0\u03C1\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043F\u0430\u043F\u043A\u0443 \u0434\u043B\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F\u0022,ko:\u0022folder to preserve list \uCD94\uAC00\u0022},MRe={en:\u0022Remove from preserve list\u0022,fr:\u0022Retirer de la liste de conservation\u0022,es:\u0022Quitar de la lista de conservaci\u00F3n\u0022,cn:\u0022\u4ECE\u4FDD\u7559\u5217\u8868\u4E2D\u5220\u9664\u0022,it:\u0022Rimuovi dalla lista di conservazione\u0022,de:\u0022Aus Beibehaltungsliste entfernen\u0022,ja:\u0022\u4FDD\u6301\u30EA\u30B9\u30C8\u304B\u3089\u524A\u9664\u0022,pl:\u0022Usu\u0144 z listy zachowanych\u0022,pt:\u0022Remover da lista de preserva\u00E7\u00E3o\u0022,hr:\u0022Ukloni s liste \u010Duvanja\u0022,cz:\u0022Remove from preserve list\u0022,sk:\u0022Remove from preserve list\u0022,gr:\u0022\u0391\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03B1\u03C0\u03CC \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B4\u03B9\u03B1\u03C4\u03AE\u03C1\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F\u0022,ko:\u0022from preserve list \uC81C\uAC70\u0022},URe={en:\u0022No lists to delete. All lists are in preserved folders.\u0022,fr:\u0022Aucune liste \u00E0 supprimer. Toutes les listes sont dans des dossiers conserv\u00E9s.\u0022,es:\u0022No hay listas para eliminar. Todas las listas est\u00E1n en carpetas conservadas.\u0022,cn:\u0022\u6CA1\u6709\u8981\u5220\u9664\u7684\u5217\u8868\u3002\u6240\u6709\u5217\u8868\u90FD\u5728\u4FDD\u7559\u7684\u6587\u4EF6\u5939\u4E2D\u3002\u0022,it:\u0022Nessuna lista da eliminare. Tutte le liste sono in cartelle conservate.\u0022,de:\u0022Keine Listen zum L\u00F6schen. Alle Listen befinden sich in beibehaltenen Ordnern.\u0022,ja:\u0022\u524A\u9664\u3059\u308B\u30EA\u30B9\u30C8\u304C\u3042\u308A\u307E\u305B\u3093\u3002\u3059\u3079\u3066\u306E\u30EA\u30B9\u30C8\u306F\u4FDD\u6301\u3055\u308C\u305F\u30D5\u30A9\u30EB\u30C0\u30FC\u306B\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Brak list do usuni\u0119cia. Wszystkie listy s\u0105 w zachowanych folderach.\u0022,pt:\u0022Nenhuma lista para excluir. Todas as listas est\u00E3o em pastas preservadas.\u0022,hr:\u0022Nema lista za brisanje\u0022,cz:\u0022No lists to delete. All lists are in preserved folders.\u0022,sk:\u0022No lists to delete. All lists are in preserved folders.\u0022,gr:\u0022\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C0\u03C1\u03BF\u03C2 \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\u0022,ru:\u0022\u041D\u0435\u0442 \u0441\u043F\u0438\u0441\u043A\u043E\u0432 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F\u0022,ko:\u0022No lists to delete. All lists are in preserved folders.\u0022},xRe={en:\u0022New Recruit is \u003Cstrong\u003EFREE\u003C/strong\u003E\u0022,fr:\u0022New Recruit est \u003Cstrong\u003EGRATUIT\u003C/strong\u003E\u0022,es:\u0022New Recruit es \u003Cstrong\u003EGRATIS\u003C/strong\u003E\u0022,cn:\u0022New Recruit \u662F\u003Cstrong\u003E\u514D\u8D39\u7684\u003C/strong\u003E\u0022,it:\u0022New Recruit \u00E8 \u003Cstrong\u003EGRATUITO\u003C/strong\u003E\u0022,de:\u0022New Recruit ist \u003Cstrong\u003EKOSTENLOS\u003C/strong\u003E\u0022,ja:\u0022New Recruit \u306F\u003Cstrong\u003E\u7121\u6599\u003C/strong\u003E\u3067\u3059\u0022,pl:\u0022New Recruit jest \u003Cstrong\u003EDARMOWY\u003C/strong\u003E\u0022,pt:\u0022New Recruit \u00E9 \u003Cstrong\u003EGRATUITO\u003C/strong\u003E\u0022,hr:\u0022New Recruit je potpuno besplatan\u0022,cz:\u0022New Recruit is \u003Cstrong\u003EFREE\u003C/strong\u003E\u0022,sk:\u0022New Recruit is \u003Cstrong\u003EFREE\u003C/strong\u003E\u0022,gr:\u0022\u0394\u03C9\u03C1\u03B5\u03AC\u03BD\u0022,ru:\u0022New Recruit \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u0435\u043D\u0022,ko:\u0022\uC0C8 Recruit is \u003Cstrong\u003EFREE\u003C/strong\u003E\u0022},QRe={en:\u0022Become a Supporter\u0022,fr:\u0022Devenir Supporter\u0022,es:\u0022Hazte Supporter\u0022,cn:\u0022\u6210\u4E3A\u652F\u6301\u8005\u0022,it:\u0022Diventa un Supporter\u0022,de:\u0022Supporter werden\u0022,ja:\u0022\u30B5\u30DD\u30FC\u30BF\u30FC\u306B\u306A\u308B\u0022,pl:\u0022Zosta\u0144 Supporterem\u0022,pt:\u0022Torne-se um Apoiador\u0022,hr:\u0022Postani Supporter\u0022,cz:\u0022Sta\u0148te se Supporterem\u0022,sk:\u0022Sta\u0148te sa Supporterom\u0022,gr:\u0022\u0393\u03AF\u03BD\u03B5 \u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03B9\u03BA\u03C4\u03AE\u03C2\u0022,ru:\u0022\u0421\u0442\u0430\u0442\u044C Supporter-\u043E\u043C\u0022,ko:\u0022\uC11C\uD3EC\uD130 \uB418\uAE30\u0022},LRe={en:\u0022Working on New recruit is a \u003Cstrong\u003Efull time job\u003C/strong\u003E, New Recruit could not exist without your support!\u0022,fr:\u0022Travailler sur New Recruit est un \u003Cstrong\u003Etravail \u00E0 temps plein\u003C/strong\u003E, New Recruit ne pourrait pas exister sans votre soutien !\u0022,es:\u0022Trabajar en New Recruit es un \u003Cstrong\u003Etrabajo de tiempo completo\u003C/strong\u003E, \u00A1New Recruit no podr\u00EDa existir sin tu apoyo!\u0022,cn:\u0022\u5F00\u53D1 New Recruit \u662F\u4E00\u9879\u003Cstrong\u003E\u5168\u804C\u5DE5\u4F5C\u003C/strong\u003E\uFF0C\u6CA1\u6709\u60A8\u7684\u652F\u6301\uFF0CNew Recruit \u5C31\u65E0\u6CD5\u5B58\u5728\uFF01\u0022,it:\u0022Lavorare su New Recruit \u00E8 un \u003Cstrong\u003Elavoro a tempo pieno\u003C/strong\u003E, New Recruit non potrebbe esistere senza il tuo supporto!\u0022,de:\u0022An New Recruit zu arbeiten ist ein \u003Cstrong\u003EVollzeitjob\u003C/strong\u003E, New Recruit k\u00F6nnte ohne Ihre Unterst\u00FCtzung nicht existieren!\u0022,ja:\u0022New Recruit \u306E\u958B\u767A\u306F\u003Cstrong\u003E\u30D5\u30EB\u30BF\u30A4\u30E0\u306E\u4ED5\u4E8B\u003C/strong\u003E\u3067\u3059\u3002\u7686\u69D8\u306E\u30B5\u30DD\u30FC\u30C8\u306A\u3057\u306B\u306F New Recruit \u306F\u5B58\u5728\u3067\u304D\u307E\u305B\u3093\uFF01\u0022,pl:\u0022Praca nad New Recruit to \u003Cstrong\u003Epraca na pe\u0142ny etat\u003C/strong\u003E, New Recruit nie m\u00F3g\u0142by istnie\u0107 bez Twojego wsparcia!\u0022,pt:\u0022Trabalhar no New Recruit \u00E9 um \u003Cstrong\u003Etrabalho em tempo integral\u003C/strong\u003E, o New Recruit n\u00E3o poderia existir sem o seu apoio!\u0022,hr:\u0022Ali razvoj je posao s punim radnim vremenom\u0022,cz:\u0022Working on New recruit is a \u003Cstrong\u003Efull time job\u003C/strong\u003E, New Recruit could not exist without your support!\u0022,sk:\u0022Working on New recruit is a \u003Cstrong\u003Efull time job\u003C/strong\u003E, New Recruit could not exist without your support!\u0022,gr:\u0022\u0394\u03BF\u03C5\u03BB\u03B5\u03B9\u03AC \u03C0\u03BB\u03AE\u03C1\u03BF\u03C5\u03C2 \u03B1\u03C0\u03B1\u03C3\u03C7\u03CC\u03BB\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430 New Recruit - \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u043D\u0430 \u043F\u043E\u043B\u043D\u044B\u0439 \u0434\u0435\u043D\u044C\u0022,ko:\u0022Working on New recruit is a \u003Cstrong\u003Efull time job\u003C/strong\u003E, New Recruit could not exist without your support!\u0022},DRe={en:\u0022Support us and gain access to the following bonus features:\u0022,fr:\u0022Soutenez-nous et acc\u00E9dez aux fonctionnalit\u00E9s bonus suivantes :\u0022,es:\u0022Ap\u00F3yanos y obt\u00E9n acceso a las siguientes caracter\u00EDsticas adicionales:\u0022,cn:\u0022\u652F\u6301\u6211\u4EEC\u5E76\u83B7\u5F97\u4EE5\u4E0B\u989D\u5916\u529F\u80FD\uFF1A\u0022,it:\u0022Sostienici e ottieni accesso alle seguenti funzionalit\u00E0 bonus:\u0022,de:\u0022Unterst\u00FCtzen Sie uns und erhalten Sie Zugriff auf die folgenden Bonus-Funktionen:\u0022,ja:\u0022\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u4EE5\u4E0B\u306E\u30DC\u30FC\u30CA\u30B9\u6A5F\u80FD\u306B\u30A2\u30AF\u30BB\u30B9\u3057\u3066\u304F\u3060\u3055\u3044\uFF1A\u0022,pl:\u0022Wspieraj nas i uzyskaj dost\u0119p do nast\u0119puj\u0105cych funkcji bonusowych:\u0022,pt:\u0022Apoie-nos e tenha acesso aos seguintes recursos b\u00F4nus:\u0022,hr:\u0022Dobijte bonus zna\u010Dajke podr\u017Eavanjem New Recruit\u0022,cz:\u0022Support us and gain access to the following bonus features:\u0022,sk:\u0022Support us and gain access to the following bonus features:\u0022,gr:\u0022\u03A7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC \u03BC\u03C0\u03CC\u03BD\u03BF\u03C5\u03C2\u0022,ru:\u0022\u041F\u043E\u0434\u043F\u0438\u0441\u0447\u0438\u043A\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0431\u043E\u043D\u0443\u0441\u043D\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438\u0022,ko:\u0022Support us and gain access to the following bonus features:\u0022},ORe={en:\u0022Remove ads!\u0022,fr:\u0022Supprimer les publicit\u00E9s !\u0022,es:\u0022\u00A1Eliminar anuncios!\u0022,cn:\u0022\u79FB\u9664\u5E7F\u544A\uFF01\u0022,it:\u0022Rimuovi gli annunci!\u0022,de:\u0022Werbung entfernen!\u0022,ja:\u0022\u5E83\u544A\u3092\u524A\u9664\uFF01\u0022,pl:\u0022Usu\u0144 reklamy!\u0022,pt:\u0022Remover an\u00FAncios!\u0022,hr:\u0022Uklonite oglase\u0022,cz:\u0022Remove ads!\u0022,sk:\u0022Remove ads!\u0022,gr:\u0022\u0391\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 ads!\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C ads!\u0022,ko:\u0022ads! \uC81C\uAC70\u0022},HRe={en:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Stratagems\u003C/strong\u003E: Click on a unit and see the Stratagems that can affect it.\u0027,fr:\u0060\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k : Stratag\u00E8mes\u003C/strong\u003E : Cliquez sur une unit\u00E9 et voyez les Stratag\u00E8mes qui peuvent l\u0027affecter.\u0060,es:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Estratagemas\u003C/strong\u003E: Haz clic en una unidad y ve las Estratagemas que pueden afectarla.\u0027,cn:\u0027\u003Cstrong class=\u0022blue\u0022\u003E\u6218\u952440k\uFF1A\u6218\u7565\u003C/strong\u003E\uFF1A\u70B9\u51FB\u4E00\u4E2A\u5355\u4F4D\u5E76\u67E5\u770B\u53EF\u4EE5\u5F71\u54CD\u5B83\u7684\u6218\u7565\u3002\u0027,it:\u0060\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Stratagemmi\u003C/strong\u003E: Clicca su un\u0027unit\u00E0 e vedi gli Stratagemmi che possono influenzarla.\u0060,de:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Strategeme\u003C/strong\u003E: Klicken Sie auf eine Einheit und sehen Sie die Strategeme, die sie beeinflussen k\u00F6nnen.\u0027,ja:\u0027\u003Cstrong class=\u0022blue\u0022\u003E\u30A6\u30A9\u30FC\u30CF\u30F3\u30DE\u30FC40k\uFF1A\u6226\u7565\u003C/strong\u003E\uFF1A\u30E6\u30CB\u30C3\u30C8\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u3001\u305D\u308C\u306B\u5F71\u97FF\u3092\u4E0E\u3048\u308B\u6226\u7565\u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002\u0027,pl:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Stratagemy\u003C/strong\u003E: Kliknij jednostk\u0119 i zobacz Stratagemy, kt\u00F3re mog\u0105 na ni\u0105 wp\u0142yn\u0105\u0107.\u0027,pt:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Estratagemas\u003C/strong\u003E: Clique em uma unidade e veja os Estratagemas que podem afet\u00E1-la.\u0027,hr:\u0022Warhammer 40k stratagemi\u0022,cz:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Stratagems\u003C/strong\u003E: Click on a unit and see the Stratagems that can affect it.\u0027,sk:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Stratagems\u003C/strong\u003E: Click on a unit and see the Stratagems that can affect it.\u0027,gr:\u0022\u03A3\u03C4\u03C1\u03B1\u03C4\u03B7\u03B3\u03AE\u03BC\u03B1\u03C4\u03B1 WH40K\u0022,ru:\u0022\u0421\u0442\u0440\u0430\u0442\u0430\u0433\u0435\u043C\u044B WH40K\u0022,ko:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Stratagems\u003C/strong\u003E: Click on a unit and see the Stratagems that can affect it.\u0027},GRe={en:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Unit Leaders\u003C/strong\u003E: Attach unit leaders and combine stratagems\u0027,fr:\u0060\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k : Chefs d\u0027unit\u00E9\u003C/strong\u003E : Attachez des chefs d\u0027unit\u00E9 et combinez des stratag\u00E8mes\u0060,es:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: L\u00EDderes de Unidad\u003C/strong\u003E: Adjunta l\u00EDderes de unidad y combina estratagemas\u0027,cn:\u0027\u003Cstrong class=\u0022blue\u0022\u003E\u6218\u952440k\uFF1A\u5355\u4F4D\u9886\u8896\u003C/strong\u003E\uFF1A\u9644\u52A0\u5355\u4F4D\u9886\u8896\u5E76\u7EC4\u5408\u6218\u7565\u0027,it:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Leader di Unit\u00E0\u003C/strong\u003E: Collega i leader di unit\u00E0 e combina stratagemmi\u0027,de:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Einheitenf\u00FChrer\u003C/strong\u003E: Einheitenf\u00FChrer anh\u00E4ngen und Strategeme kombinieren\u0027,ja:\u0027\u003Cstrong class=\u0022blue\u0022\u003E\u30A6\u30A9\u30FC\u30CF\u30F3\u30DE\u30FC40k\uFF1A\u30E6\u30CB\u30C3\u30C8\u30EA\u30FC\u30C0\u30FC\u003C/strong\u003E\uFF1A\u30E6\u30CB\u30C3\u30C8\u30EA\u30FC\u30C0\u30FC\u3092\u4ED8\u3051\u3001\u6226\u7565\u3092\u7D44\u307F\u5408\u308F\u305B\u307E\u3059\u0027,pl:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Dow\u00F3dcy Jednostek\u003C/strong\u003E: Do\u0142\u0105cz dow\u00F3dc\u00F3w jednostek i \u0142\u0105cz stratagemy\u0027,pt:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: L\u00EDderes de Unidade\u003C/strong\u003E: Anexe l\u00EDderes de unidade e combine estratagemas\u0027,hr:\u0022Warhammer 40k vo\u0111e\u0022,cz:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Unit Leaders\u003C/strong\u003E: Attach unit leaders and combine stratagems\u0027,sk:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Unit Leaders\u003C/strong\u003E: Attach unit leaders and combine stratagems\u0027,gr:\u0022\u0391\u03C1\u03C7\u03B7\u03B3\u03BF\u03AF WH40K\u0022,ru:\u0022\u041B\u0438\u0434\u0435\u0440\u044B WH40K\u0022,ko:\u0027\u003Cstrong class=\u0022blue\u0022\u003EWarhammer 40k: Unit Leaders\u003C/strong\u003E: Attach unit leaders and combine stratagems\u0027},VRe={en:\u0022Custom Names: Rename forces and units, attach notes.\u0022,fr:\u0022Noms personnalis\u00E9s : Renommez les forces et les unit\u00E9s, ajoutez des notes.\u0022,es:\u0022Nombres Personalizados: Renombra fuerzas y unidades, adjunta notas.\u0022,cn:\u0022\u81EA\u5B9A\u4E49\u540D\u79F0\uFF1A\u91CD\u547D\u540D\u90E8\u961F\u548C\u5355\u4F4D\uFF0C\u6DFB\u52A0\u6CE8\u91CA\u3002\u0022,it:\u0022Nomi Personalizzati: Rinomina forze e unit\u00E0, allega note.\u0022,de:\u0022Benutzerdefinierte Namen: Benennen Sie Kr\u00E4fte und Einheiten um, f\u00FCgen Sie Notizen hinzu.\u0022,ja:\u0022\u30AB\u30B9\u30BF\u30E0\u540D\uFF1A\u90E8\u968A\u3068\u30E6\u30CB\u30C3\u30C8\u306E\u540D\u524D\u5909\u66F4\u3001\u30E1\u30E2\u306E\u6DFB\u4ED8\u3002\u0022,pl:\u0022W\u0142asne Nazwy: Zmie\u0144 nazwy si\u0142 i jednostek, do\u0142\u0105cz notatki.\u0022,pt:\u0022Nomes Personalizados: Renomeie for\u00E7as e unidades, anexe notas.\u0022,hr:\u0022Prilago\u0111ena imena: Preimenuj snage i jedinice, dodaj bilje\u0161ke.\u0022,cz:\u0022Vlastn\u00ED n\u00E1zvy: P\u0159ejmenujte s\u00EDly a jednotky, p\u0159idejte pozn\u00E1mky.\u0022,sk:\u0022Vlastn\u00E9 n\u00E1zvy: Premenujte sily a jednotky, pridajte pozn\u00E1mky.\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B1 \u039F\u03BD\u03CC\u03BC\u03B1\u03C4\u03B1: \u039C\u03B5\u03C4\u03BF\u03BD\u03BF\u03BC\u03AC\u03C3\u03C4\u03B5 \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2, \u03B5\u03C0\u03B9\u03C3\u03C5\u03BD\u03AC\u03C8\u03C4\u03B5 \u03C3\u03B7\u03BC\u03B5\u03B9\u03CE\u03C3\u03B5\u03B9\u03C2.\u0022,ru:\u0022\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u0438\u043C\u0435\u043D\u0430: \u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u044B\u0432\u0430\u0439\u0442\u0435 \u0441\u0438\u043B\u044B \u0438 \u044E\u043D\u0438\u0442\u044B, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0437\u0430\u043C\u0435\u0442\u043A\u0438.\u0022,ko:\u0022\uCEE4\uC2A4\uD140 \uC774\uB984: \uAD70\uB300\uC640 \uC720\uB2DB \uC774\uB984 \uBCC0\uACBD, \uBA54\uBAA8 \uCCA8\uBD80.\u0022},WRe={en:\u0022Favourites: Save Unit builds/loadouts to quickly create them again.\u0022,fr:\u0022Favoris : Sauvegardez vos builds/loadouts pour les recr\u00E9er rapidement.\u0022,es:\u0022Favoritos: Guarda builds/loadouts de unidades para crearlos r\u00E1pidamente de nuevo.\u0022,cn:\u0022\u6536\u85CF\u5939\uFF1A\u4FDD\u5B58\u5355\u4F4D\u914D\u7F6E\uFF0C\u4EE5\u4FBF\u5FEB\u901F\u91CD\u65B0\u521B\u5EFA\u3002\u0022,it:\u0022Preferiti: Salva build/loadout delle unit\u00E0 per ricrearli rapidamente.\u0022,de:\u0022Favoriten: Speichern Sie Einheiten-Builds/Loadouts, um sie schnell neu zu erstellen.\u0022,ja:\u0022\u304A\u6C17\u306B\u5165\u308A\uFF1A\u30E6\u30CB\u30C3\u30C8\u306E\u30D3\u30EB\u30C9/\u30ED\u30FC\u30C9\u30A2\u30A6\u30C8\u3092\u4FDD\u5B58\u3057\u3066\u3001\u3059\u3070\u3084\u304F\u518D\u4F5C\u6210\u3002\u0022,pl:\u0022Ulubione: Zapisz buildy/loadouty jednostek, aby szybko je odtworzy\u0107.\u0022,pt:\u0022Favoritos: Salve builds/loadouts de unidades para recri\u00E1-los rapidamente.\u0022,hr:\u0022Favoriti: Spremi buildove/loadoute jedinica za brzo ponovno stvaranje.\u0022,cz:\u0022Obl\u00EDben\u00E9: Ulo\u017Ete buildy/loadouty jednotek pro rychl\u00E9 znovuvytvo\u0159en\u00ED.\u0022,sk:\u0022Ob\u013E\u00FAben\u00E9: Ulo\u017Ete buildy/loadouty jednotiek pre r\u00FDchle znovuvytvorenie.\u0022,gr:\u0022\u0391\u03B3\u03B1\u03C0\u03B7\u03BC\u03AD\u03BD\u03B1: \u0391\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03C3\u03C4\u03B5 builds/loadouts \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD \u03B3\u03B9\u03B1 \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B7 \u03B5\u03C0\u03B1\u03BD\u03B1\u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1.\u0022,ru:\u0022\u0418\u0437\u0431\u0440\u0430\u043D\u043D\u043E\u0435: \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435 \u0441\u0431\u043E\u0440\u043A\u0438/\u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u044E\u043D\u0438\u0442\u043E\u0432 \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F.\u0022,ko:\u0022\uC990\uACA8\uCC3E\uAE30: \uC720\uB2DB \uBE4C\uB4DC/\uB85C\uB4DC\uC544\uC6C3\uC744 \uC800\uC7A5\uD558\uC5EC \uBE60\uB974\uAC8C \uB2E4\uC2DC \uC0DD\uC131.\u0022},YRe={en:\u0022Miniature matching: Add pictures, keep track of your miniature owned/built/painted status, quickly see miniatures you need to play a list.\u0022,fr:\u0022Gestion des figurines : Ajoutez des photos, suivez le statut poss\u00E9d\u00E9/construit/peint de vos figurines, voyez rapidement les figurines n\u00E9cessaires pour une liste.\u0022,es:\u0022Gesti\u00F3n de miniaturas: A\u00F1ade fotos, sigue el estado pose\u00EDdo/construido/pintado de tus miniaturas, ve r\u00E1pidamente las miniaturas que necesitas para una lista.\u0022,cn:\u0022\u6A21\u578B\u7BA1\u7406\uFF1A\u6DFB\u52A0\u56FE\u7247\uFF0C\u8FFD\u8E2A\u60A8\u6A21\u578B\u7684\u62E5\u6709/\u7EC4\u88C5/\u6D82\u88C5\u72B6\u6001\uFF0C\u5FEB\u901F\u67E5\u770B\u73A9\u67D0\u5217\u8868\u6240\u9700\u7684\u6A21\u578B\u3002\u0022,it:\u0022Gestione Miniature: Aggiungi foto, tieni traccia dello stato posseduto/costruito/dipinto delle tue miniature, vedi rapidamente le miniature necessarie per una lista.\u0022,de:\u0022Miniatur-Verwaltung: F\u00FCgen Sie Bilder hinzu, verfolgen Sie den Status besessen/gebaut/bemalt Ihrer Miniaturen, sehen Sie schnell die ben\u00F6tigten Miniaturen f\u00FCr eine Liste.\u0022,ja:\u0022\u30DF\u30CB\u30C1\u30E5\u30A2\u7BA1\u7406\uFF1A\u5199\u771F\u3092\u8FFD\u52A0\u3001\u6240\u6709/\u7D44\u307F\u7ACB\u3066/\u5857\u88C5\u72B6\u614B\u3092\u8FFD\u8DE1\u3001\u30EA\u30B9\u30C8\u306B\u5FC5\u8981\u306A\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u3059\u3070\u3084\u304F\u78BA\u8A8D\u3002\u0022,pl:\u0022Zarz\u0105dzanie Miniaturami: Dodaj zdj\u0119cia, \u015Bled\u017A status posiadane/zbudowane/pomalowane swoich miniatur, szybko zobacz potrzebne miniatury do listy.\u0022,pt:\u0022Gest\u00E3o de Miniaturas: Adicione fotos, acompanhe o status possu\u00EDdo/constru\u00EDdo/pintado das suas miniaturas, veja rapidamente as miniaturas necess\u00E1rias para uma lista.\u0022,hr:\u0022Upravljanje miniaturama: Dodaj slike, prati status posjedovano/izgra\u0111eno/obojano svojih minijatura, brzo vidi potrebne minijature za listu.\u0022,cz:\u0022Spr\u00E1va miniatur: P\u0159idejte obr\u00E1zky, sledujte stav vlastn\u011Bno/postaveno/namalov\u00E1no va\u0161ich miniatur, rychle zobrazte pot\u0159ebn\u00E9 miniatury pro seznam.\u0022,sk:\u0022Spr\u00E1va miniat\u00FAr: Pridajte obr\u00E1zky, sledujte stav vlastnen\u00E9/postaven\u00E9/nama\u013Eovan\u00E9 va\u0161ich miniat\u00FAr, r\u00FDchlo zobrazite potrebn\u00E9 miniat\u00FAry pre zoznam.\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u039C\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03C9\u03BD: \u03A0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03C4\u03B5 \u03C6\u03C9\u03C4\u03BF\u03B3\u03C1\u03B1\u03C6\u03AF\u03B5\u03C2, \u03C0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7\u03BD \u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u03BA\u03B1\u03C4\u03BF\u03C7\u03AE\u03C2/\u03BA\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03AE\u03C2/\u03B2\u03B1\u03C6\u03AE\u03C2 \u03C4\u03C9\u03BD \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03C9\u03BD \u03C3\u03B1\u03C2, \u03B4\u03B5\u03AF\u03C4\u03B5 \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1 \u03C4\u03B9\u03C2 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03B5\u03C2 \u03C0\u03BF\u03C5 \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C3\u03C4\u03B5 \u03B3\u03B9\u03B1 \u03BC\u03B9\u03B1 \u03BB\u03AF\u03C3\u03C4\u03B1.\u0022,ru:\u0022\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u0430\u043C\u0438: \u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0444\u043E\u0442\u043E, \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0442\u0430\u0442\u0443\u0441 \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F/\u0441\u0431\u043E\u0440\u043A\u0438/\u043F\u043E\u043A\u0440\u0430\u0441\u043A\u0438 \u0432\u0430\u0448\u0438\u0445 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440, \u0431\u044B\u0441\u0442\u0440\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0443\u0436\u043D\u044B\u0435 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u044B \u0434\u043B\u044F \u0441\u043F\u0438\u0441\u043A\u0430.\u0022,ko:\u0022\uBBF8\uB2C8\uC5B4\uCC98 \uAD00\uB9AC: \uC0AC\uC9C4 \uCD94\uAC00, \uBBF8\uB2C8\uC5B4\uCC98\uC758 \uC18C\uC720/\uC870\uB9BD/\uB3C4\uC0C9 \uC0C1\uD0DC \uCD94\uC801, \uB9AC\uC2A4\uD2B8\uC5D0 \uD544\uC694\uD55C \uBBF8\uB2C8\uC5B4\uCC98 \uBE60\uB974\uAC8C \uD655\uC778.\u0022},KRe={en:\u0022Rule Search: Conveniently search rules by name for T9A \u0026 Old World.\u0022,fr:\u0022Recherche de r\u00E8gles : Recherchez facilement les r\u00E8gles par nom pour T9A \u0026 Old World.\u0022,es:\u0022B\u00FAsqueda de Reglas: Busca convenientemente reglas por nombre para T9A y Old World.\u0022,cn:\u0022\u89C4\u5219\u641C\u7D22\uFF1A\u65B9\u4FBF\u5730\u6309\u540D\u79F0\u641C\u7D22 T9A \u548C Old World \u7684\u89C4\u5219\u3002\u0022,it:\u0022Ricerca Regole: Cerca comodamente le regole per nome per T9A e Old World.\u0022,de:\u0022Regelsuche: Suchen Sie bequem Regeln nach Namen f\u00FCr T9A \u0026 Old World.\u0022,ja:\u0022\u30EB\u30FC\u30EB\u691C\u7D22\uFF1AT9A \u304A\u3088\u3073 Old World \u306E\u30EB\u30FC\u30EB\u3092\u540D\u524D\u3067\u7C21\u5358\u306B\u691C\u7D22\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Wyszukiwanie Zasad: Wygodnie wyszukuj zasady wed\u0142ug nazwy dla T9A i Old World.\u0022,pt:\u0022Pesquisa de Regras: Pesquise convenientemente regras por nome para T9A \u0026 Old World.\u0022,hr:\u0022Pretraga pravila\u0022,cz:\u0022Rule Search: Conveniently search rules by name for T9A \u0026 Old World.\u0022,sk:\u0022Rule Search: Conveniently search rules by name for T9A \u0026 Old World.\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD\u0022,ru:\u0022\u041F\u043E\u0438\u0441\u043A \u043F\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0022,ko:\u0022Rule Search: Conveniently search rules by name for T9A \u0026 Old World.\u0022},qRe={en:\u0022Custom View: Reorganise your lists, placing units in a custom order and into custom categories.\u0022,fr:\u0022Vue personnalis\u00E9e : R\u00E9organisez vos listes, en pla\u00E7ant les unit\u00E9s dans un ordre personnalis\u00E9 et dans des cat\u00E9gories personnalis\u00E9es.\u0022,es:\u0022Vista Personalizada: Reorganiza tus listas, colocando unidades en un orden personalizado y en categor\u00EDas personalizadas.\u0022,cn:\u0022\u81EA\u5B9A\u4E49\u89C6\u56FE\uFF1A\u91CD\u65B0\u7EC4\u7EC7\u60A8\u7684\u5217\u8868\uFF0C\u5C06\u5355\u4F4D\u6309\u81EA\u5B9A\u4E49\u987A\u5E8F\u653E\u5165\u81EA\u5B9A\u4E49\u7C7B\u522B\u4E2D\u3002\u0022,it:\u0022Vista Personalizzata: Riorganizza le tue liste, posizionando le unit\u00E0 in un ordine personalizzato e in categorie personalizzate.\u0022,de:\u0022Benutzerdefinierte Ansicht: Organisieren Sie Ihre Listen neu, indem Sie Einheiten in einer benutzerdefinierten Reihenfolge und in benutzerdefinierten Kategorien platzieren.\u0022,ja:\u0022\u30AB\u30B9\u30BF\u30E0\u30D3\u30E5\u30FC\uFF1A\u30EA\u30B9\u30C8\u3092\u518D\u7DE8\u6210\u3057\u3001\u30E6\u30CB\u30C3\u30C8\u3092\u30AB\u30B9\u30BF\u30E0\u306E\u9806\u5E8F\u3068\u30AB\u30B9\u30BF\u30E0\u30AB\u30C6\u30B4\u30EA\u306B\u914D\u7F6E\u3057\u307E\u3059\u3002\u0022,pl:\u0022Widok Niestandardowy: Reorganizuj swoje listy, umieszczaj\u0105c jednostki w niestandardowej kolejno\u015Bci i w niestandardowych kategoriach.\u0022,pt:\u0022Visualiza\u00E7\u00E3o Personalizada: Reorganize suas listas, colocando unidades em uma ordem personalizada e em categorias personalizadas.\u0022,hr:\u0022Prilago\u0111eni prikaz\u0022,cz:\u0022Custom View: Reorganise your lists, placing units in a custom order and into custom categories.\u0022,sk:\u0022Custom View: Reorganise your lists, placing units in a custom order and into custom categories.\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B7 \u03C0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE\u0022,ru:\u0022\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u0432\u0438\u0434\u0022,ko:\u0022Custom View: Reorganise your lists, placing units in a custom order and into custom categories.\u0022},JRe={en:\u0022Discord: Special Discord status. Feature requests and suggestions from supporters are considered with greater priority.\u0022,fr:\u0022Discord : Statut Discord sp\u00E9cial. Les demandes de fonctionnalit\u00E9s et les suggestions des supporters sont consid\u00E9r\u00E9es avec une plus grande priorit\u00E9.\u0022,es:\u0022Discord: Estado especial de Discord. Las solicitudes de funciones y sugerencias de los supporters se consideran con mayor prioridad.\u0022,cn:\u0022Discord\uFF1A\u7279\u6B8A\u7684 Discord \u72B6\u6001\u3002\u6765\u81EA\u652F\u6301\u8005\u7684\u529F\u80FD\u8BF7\u6C42\u548C\u5EFA\u8BAE\u5C06\u88AB\u4F18\u5148\u8003\u8651\u3002\u0022,it:\u0022Discord: Stato Discord speciale. Le richieste di funzionalit\u00E0 e i suggerimenti dai supporter sono considerati con maggiore priorit\u00E0.\u0022,de:\u0022Discord: Spezieller Discord-Status. Funktionsw\u00FCnsche und Vorschl\u00E4ge von Supportern werden mit h\u00F6herer Priorit\u00E4t ber\u00FCcksichtigt.\u0022,ja:\u0022Discord\uFF1A\u7279\u5225\u306A Discord \u30B9\u30C6\u30FC\u30BF\u30B9\u3002\u30B5\u30DD\u30FC\u30BF\u30FC\u304B\u3089\u306E\u6A5F\u80FD\u30EA\u30AF\u30A8\u30B9\u30C8\u3084\u63D0\u6848\u306F\u3001\u3088\u308A\u9AD8\u3044\u512A\u5148\u5EA6\u3067\u691C\u8A0E\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Discord: Specjalny status Discord. Pro\u015Bby o funkcje i sugestie od supporter\u00F3w s\u0105 rozwa\u017Cane z wi\u0119kszym priorytetem.\u0022,pt:\u0022Discord: Status especial no Discord. Solicita\u00E7\u00F5es de recursos e sugest\u00F5es de apoiadores s\u00E3o consideradas com maior prioridade.\u0022,hr:\u0022Discord: Poseban Discord status. Zahtjevi za zna\u010Dajke i prijedlozi supportera se razmatraju s ve\u0107im prioritetom.\u0022,cz:\u0022Discord: Speci\u00E1ln\u00ED Discord status. Po\u017Eadavky na funkce a n\u00E1vrhy od supporter\u016F jsou zva\u017Eov\u00E1ny s vy\u0161\u0161\u00ED prioritou.\u0022,sk:\u0022Discord: \u0160peci\u00E1lny Discord status. Po\u017Eiadavky na funkcie a n\u00E1vrhy od supporterov s\u00FA zva\u017Eovan\u00E9 s vy\u0161\u0161ou prioritou.\u0022,gr:\u0022Discord: \u0395\u03B9\u03B4\u03B9\u03BA\u03CC Discord status. \u03A4\u03B1 \u03B1\u03B9\u03C4\u03AE\u03BC\u03B1\u03C4\u03B1 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03CE\u03BD \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03C0\u03C1\u03BF\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2 \u03B1\u03C0\u03CC supporters \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03BC\u03B5 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7 \u03C0\u03C1\u03BF\u03C4\u03B5\u03C1\u03B1\u03B9\u03CC\u03C4\u03B7\u03C4\u03B1.\u0022,ru:\u0022Discord: \u041E\u0441\u043E\u0431\u044B\u0439 Discord \u0441\u0442\u0430\u0442\u0443\u0441. \u0417\u0430\u043F\u0440\u043E\u0441\u044B \u0444\u0443\u043D\u043A\u0446\u0438\u0439 \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043E\u0442 supporter-\u043E\u0432 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0441 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043E\u043C.\u0022,ko:\u0022Discord: \uD2B9\uBCC4\uD55C Discord \uC0C1\uD0DC. \uC11C\uD3EC\uD130\uC758 \uAE30\uB2A5 \uC694\uCCAD\uACFC \uC81C\uC548\uC740 \uB354 \uB192\uC740 \uC6B0\uC120\uC21C\uC704\uB85C \uACE0\uB824\uB429\uB2C8\uB2E4.\u0022},$Re={en:\u0022Extra features for The 9th Age Fantasy Battles\u0022,fr:\u0022Fonctionnalit\u00E9s suppl\u00E9mentaires pour The 9th Age Fantasy Battles\u0022,es:\u0022Caracter\u00EDsticas adicionales para The 9th Age Fantasy Battles\u0022,cn:\u0022The 9th Age Fantasy Battles \u7684\u989D\u5916\u529F\u80FD\u0022,it:\u0022Funzionalit\u00E0 extra per The 9th Age Fantasy Battles\u0022,de:\u0022Zus\u00E4tzliche Funktionen f\u00FCr The 9th Age Fantasy Battles\u0022,ja:\u0022The 9th Age Fantasy Battles \u306E\u8FFD\u52A0\u6A5F\u80FD\u0022,pl:\u0022Dodatkowe funkcje dla The 9th Age Fantasy Battles\u0022,pt:\u0022Recursos extras para The 9th Age Fantasy Battles\u0022,hr:\u0022The 9th Age\u0022,cz:\u0022Extra features for The 9th Age Fantasy Battles\u0022,sk:\u0022Extra features for The 9th Age Fantasy Battles\u0022,gr:\u0022The 9th Age\u0022,ru:\u00229th Age\u0022,ko:\u0022Extra features for The 9th Age Fantasy Battles\u0022},ZRe={en:\u0022New Recruit supporters benefit from bonus exclusive features for The 9th Age.\u0022,fr:\u0022Les supporters de New Recruit b\u00E9n\u00E9ficient de fonctionnalit\u00E9s bonus exclusives pour The 9th Age.\u0022,es:\u0022Los seguidores de New Recruit se benefician de caracter\u00EDsticas exclusivas adicionales para The 9th Age.\u0022,cn:\u0022New Recruit \u652F\u6301\u8005\u53EF\u4EAB\u53D7 The 9th Age \u7684\u4E13\u5C5E\u989D\u5916\u529F\u80FD\u3002\u0022,it:\u0022I sostenitori di New Recruit beneficiano di funzionalit\u00E0 bonus esclusive per The 9th Age.\u0022,de:\u0022New Recruit-Unterst\u00FCtzer profitieren von exklusiven Bonus-Funktionen f\u00FCr The 9th Age.\u0022,ja:\u0022New Recruit \u30B5\u30DD\u30FC\u30BF\u30FC\u306F\u3001The 9th Age \u306E\u5C02\u7528\u30DC\u30FC\u30CA\u30B9\u6A5F\u80FD\u3092\u5229\u7528\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Wspieraj\u0105cy New Recruit korzystaj\u0105 z bonusowych ekskluzywnych funkcji dla The 9th Age.\u0022,pt:\u0022Os apoiadores do New Recruit se beneficiam de recursos b\u00F4nus exclusivos para The 9th Age.\u0022,hr:\u0022Pomo\u0107nik za igru The 9th Age\u0022,cz:\u0022New Recruit supporters benefit from bonus exclusive features for The 9th Age.\u0022,sk:\u0022New Recruit supporters benefit from bonus exclusive features for The 9th Age.\u0022,gr:\u0022\u0392\u03BF\u03B7\u03B8\u03CC\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03B3\u03B9\u03B1 The 9th Age\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0434\u043B\u044F 9th Age\u0022,ko:\u0022\uC0C8 Recruit supporters benefit from bonus exclusive features for The 9th Age.\u0022},XRe={en:\u0027The \u003Cstrong class=\u0022blue\u0022\u003Eextra features for The Ninth Age\u003C/strong\u003E assist you with playing a T9A game using a cell phone, tablet or computer. These features will let you replace the various cards you need to play T9A with virtual cards and give you easy a quick access to all rules and special rules in a friendly format on all screen sizes, \u003Cstrong\u003Ewhich is especially convenient on phones and much faster than browsing a PDF file or a printout\u003C/strong\u003E.\u0027,fr:\u0060Les \u003Cstrong class=\u0022blue\u0022\u003Efonctionnalit\u00E9s suppl\u00E9mentaires pour The Ninth Age\u003C/strong\u003E vous aident \u00E0 jouer une partie de T9A en utilisant un t\u00E9l\u00E9phone portable, une tablette ou un ordinateur. Ces fonctionnalit\u00E9s vous permettront de remplacer les diff\u00E9rentes cartes dont vous avez besoin pour jouer \u00E0 T9A par des cartes virtuelles et vous donneront un acc\u00E8s facile et rapide \u00E0 toutes les r\u00E8gles et r\u00E8gles sp\u00E9ciales dans un format convivial sur toutes les tailles d\u0027\u00E9cran, \u003Cstrong\u003Ece qui est particuli\u00E8rement pratique sur les t\u00E9l\u00E9phones et beaucoup plus rapide que de parcourir un fichier PDF ou une impression\u003C/strong\u003E.\u0060,es:\u0027Las \u003Cstrong class=\u0022blue\u0022\u003Ecaracter\u00EDsticas adicionales para The Ninth Age\u003C/strong\u003E te ayudan a jugar un juego de T9A usando un tel\u00E9fono celular, tableta u ordenador. Estas caracter\u00EDsticas te permitir\u00E1n reemplazar las diversas cartas que necesitas para jugar T9A con cartas virtuales y te dar\u00E1n acceso f\u00E1cil y r\u00E1pido a todas las reglas y reglas especiales en un formato amigable en todos los tama\u00F1os de pantalla, \u003Cstrong\u003Elo cual es especialmente conveniente en tel\u00E9fonos y mucho m\u00E1s r\u00E1pido que navegar por un archivo PDF o una impresi\u00F3n\u003C/strong\u003E.\u0027,cn:\u0027The Ninth Age \u7684\u003Cstrong class=\u0022blue\u0022\u003E\u989D\u5916\u529F\u80FD\u003C/strong\u003E\u53EF\u5E2E\u52A9\u60A8\u4F7F\u7528\u624B\u673A\u3001\u5E73\u677F\u7535\u8111\u6216\u8BA1\u7B97\u673A\u73A9 T9A \u6E38\u620F\u3002\u8FD9\u4E9B\u529F\u80FD\u5C06\u8BA9\u60A8\u7528\u865A\u62DF\u5361\u66FF\u6362\u73A9 T9A \u6240\u9700\u7684\u5404\u79CD\u5361\uFF0C\u5E76\u5728\u6240\u6709\u5C4F\u5E55\u5C3A\u5BF8\u4E0A\u4EE5\u53CB\u597D\u7684\u683C\u5F0F\u4E3A\u60A8\u63D0\u4F9B\u5BF9\u6240\u6709\u89C4\u5219\u548C\u7279\u6B8A\u89C4\u5219\u7684\u8F7B\u677E\u5FEB\u901F\u8BBF\u95EE\uFF0C\u003Cstrong\u003E\u8FD9\u5728\u624B\u673A\u4E0A\u7279\u522B\u65B9\u4FBF\uFF0C\u6BD4\u6D4F\u89C8 PDF \u6587\u4EF6\u6216\u6253\u5370\u8F93\u51FA\u5FEB\u5F97\u591A\u003C/strong\u003E\u3002\u0027,it:\u0027Le \u003Cstrong class=\u0022blue\u0022\u003Efunzionalit\u00E0 extra per The Ninth Age\u003C/strong\u003E ti assistono nel giocare una partita di T9A usando un telefono cellulare, tablet o computer. Queste funzionalit\u00E0 ti permetteranno di sostituire le varie carte di cui hai bisogno per giocare a T9A con carte virtuali e ti daranno un accesso facile e veloce a tutte le regole e regole speciali in un formato amichevole su tutte le dimensioni dello schermo, \u003Cstrong\u003Eil che \u00E8 particolarmente comodo sui telefoni e molto pi\u00F9 veloce che sfogliare un file PDF o una stampa\u003C/strong\u003E.\u0027,de:\u0027Die \u003Cstrong class=\u0022blue\u0022\u003Ezus\u00E4tzlichen Funktionen f\u00FCr The Ninth Age\u003C/strong\u003E unterst\u00FCtzen Sie beim Spielen eines T9A-Spiels mit einem Mobiltelefon, Tablet oder Computer. Diese Funktionen erm\u00F6glichen es Ihnen, die verschiedenen Karten, die Sie zum Spielen von T9A ben\u00F6tigen, durch virtuelle Karten zu ersetzen, und geben Ihnen einen einfachen und schnellen Zugriff auf alle Regeln und Sonderregeln in einem benutzerfreundlichen Format auf allen Bildschirmgr\u00F6\u00DFen, \u003Cstrong\u003Ewas besonders auf Telefonen bequem ist und viel schneller ist als das Durchsuchen einer PDF-Datei oder eines Ausdrucks\u003C/strong\u003E.\u0027,ja:\u0027The Ninth Age \u306E\u003Cstrong class=\u0022blue\u0022\u003E\u8FFD\u52A0\u6A5F\u80FD\u003C/strong\u003E\u306F\u3001\u643A\u5E2F\u96FB\u8A71\u3001\u30BF\u30D6\u30EC\u30C3\u30C8\u3001\u307E\u305F\u306F\u30B3\u30F3\u30D4\u30E5\u30FC\u30BF\u30FC\u3092\u4F7F\u7528\u3057\u3066 T9A \u30B2\u30FC\u30E0\u3092\u30D7\u30EC\u30A4\u3059\u308B\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u3053\u308C\u3089\u306E\u6A5F\u80FD\u306B\u3088\u308A\u3001T9A \u306E\u30D7\u30EC\u30A4\u306B\u5FC5\u8981\u306A\u3055\u307E\u3056\u307E\u306A\u30AB\u30FC\u30C9\u3092\u4EEE\u60F3\u30AB\u30FC\u30C9\u306B\u7F6E\u304D\u63DB\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u3001\u3059\u3079\u3066\u306E\u753B\u9762\u30B5\u30A4\u30BA\u3067\u30D5\u30EC\u30F3\u30C9\u30EA\u30FC\u306A\u5F62\u5F0F\u3067\u3059\u3079\u3066\u306E\u30EB\u30FC\u30EB\u3068\u7279\u5225\u306A\u30EB\u30FC\u30EB\u306B\u7C21\u5358\u304B\u3064\u8FC5\u901F\u306B\u30A2\u30AF\u30BB\u30B9\u3067\u304D\u307E\u3059\u3002\u003Cstrong\u003E\u3053\u308C\u306F\u7279\u306B\u643A\u5E2F\u96FB\u8A71\u3067\u4FBF\u5229\u3067\u3001PDF \u30D5\u30A1\u30A4\u30EB\u3084\u5370\u5237\u7269\u3092\u95B2\u89A7\u3059\u308B\u3088\u308A\u3082\u306F\u308B\u304B\u306B\u9AD8\u901F\u3067\u3059\u003C/strong\u003E\u3002\u0027,pl:\u0022Dodatkowe funkcje dla The Ninth Age\u003C/strong\u003E pomagaj\u0105 w grze w T9A przy u\u017Cyciu telefonu kom\u00F3rkowego, tabletu lub komputera. Te funkcje pozwol\u0105 Ci zast\u0105pi\u0107 r\u00F3\u017Cne karty potrzebne do gry w T9A kartami wirtualnymi i zapewni\u0105 Ci \u0142atwy i szybki dost\u0119p do wszystkich zasad i zasad specjalnych w przyjaznym formacie na wszystkich rozmiarach ekranu, \u003Cstrong\u003Eco jest szczeg\u00F3lnie wygodne na telefonach i znacznie szybsze ni\u017C przegl\u0105danie pliku PDF lub wydruku\u003C/strong\u003E.\u0022,pt:\u0027Os \u003Cstrong class=\u0022blue\u0022\u003Erecursos extras para The Ninth Age\u003C/strong\u003E ajudam voc\u00EA a jogar um jogo de T9A usando um celular, tablet ou computador. Esses recursos permitir\u00E3o que voc\u00EA substitua as v\u00E1rias cartas necess\u00E1rias para jogar T9A por cartas virtuais e lhe dar\u00E3o acesso f\u00E1cil e r\u00E1pido a todas as regras e regras especiais em um formato amig\u00E1vel em todos os tamanhos de tela, \u003Cstrong\u003Eo que \u00E9 especialmente conveniente em telefones e muito mais r\u00E1pido do que navegar por um arquivo PDF ou uma impress\u00E3o\u003C/strong\u003E.\u0027,hr:\u0022Kompletna integracija pravila i pomo\u0107nik za bitke\u0022,cz:\u0027The \u003Cstrong class=\u0022blue\u0022\u003Eextra features for The Ninth Age\u003C/strong\u003E assist you with playing a T9A game using a cell phone, tablet or computer. These features will let you replace the various cards you need to play T9A with virtual cards and give you easy a quick access to all rules and special rules in a friendly format on all screen sizes, \u003Cstrong\u003Ewhich is especially convenient on phones and much faster than browsing a PDF file or a printout\u003C/strong\u003E.\u0027,sk:\u0027The \u003Cstrong class=\u0022blue\u0022\u003Eextra features for The Ninth Age\u003C/strong\u003E assist you with playing a T9A game using a cell phone, tablet or computer. These features will let you replace the various cards you need to play T9A with virtual cards and give you easy a quick access to all rules and special rules in a friendly format on all screen sizes, \u003Cstrong\u003Ewhich is especially convenient on phones and much faster than browsing a PDF file or a printout\u003C/strong\u003E.\u0027,gr:\u0022\u03A0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7 \u03C3\u03B5 \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC T9A\u0022,ru:\u0022\u041F\u043E\u043B\u043D\u043E\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0434\u043B\u044F \u0438\u0433\u0440\u0022,ko:\u0027The \u003Cstrong class=\u0022blue\u0022\u003Eextra features for The Ninth Age\u003C/strong\u003E assist you with playing a T9A game using a cell phone, tablet or computer. These features will let you replace the various cards you need to play T9A with virtual cards and give you easy a quick access to all rules and special rules in a friendly format on all screen sizes, \u003Cstrong\u003Ewhich is especially convenient on phones and much faster than browsing a PDF file or a printout\u003C/strong\u003E.\u0027},eMe={en:\u0022\u003Cstrong\u003ECasual T9A players\u003C/strong\u003E will find these features extremely helpful to quickly find rules or stats as they need.\u003Cbr /\u003E\u003Cstrong\u003EHardcore T9A players\u003C/strong\u003E will greatly appreciate it to optimize their gameplay as these features will assist them in taking better decisions.\u0022,fr:\u0022\u003Cstrong\u003ELes joueurs occasionnels de T9A\u003C/strong\u003E trouveront ces fonctionnalit\u00E9s extr\u00EAmement utiles pour trouver rapidement les r\u00E8gles ou les statistiques dont ils ont besoin.\u003Cbr /\u003E\u003Cstrong\u003ELes joueurs hardcore de T9A\u003C/strong\u003E l\u0027appr\u00E9cieront grandement pour optimiser leur jeu car ces fonctionnalit\u00E9s les aideront \u00E0 prendre de meilleures d\u00E9cisions.\u0022,es:\u0022\u003Cstrong\u003ELos jugadores ocasionales de T9A\u003C/strong\u003E encontrar\u00E1n estas caracter\u00EDsticas extremadamente \u00FAtiles para encontrar r\u00E1pidamente reglas o estad\u00EDsticas seg\u00FAn sea necesario.\u003Cbr /\u003E\u003Cstrong\u003ELos jugadores hardcore de T9A\u003C/strong\u003E lo apreciar\u00E1n enormemente para optimizar su juego, ya que estas caracter\u00EDsticas los ayudar\u00E1n a tomar mejores decisiones.\u0022,cn:\u0022\u003Cstrong\u003E\u4F11\u95F2 T9A \u73A9\u5BB6\u003C/strong\u003E\u4F1A\u53D1\u73B0\u8FD9\u4E9B\u529F\u80FD\u975E\u5E38\u6709\u7528\uFF0C\u53EF\u4EE5\u5FEB\u901F\u627E\u5230\u6240\u9700\u7684\u89C4\u5219\u6216\u7EDF\u8BA1\u6570\u636E\u3002\u003Cbr /\u003E\u003Cstrong\u003E\u786C\u6838 T9A \u73A9\u5BB6\u003C/strong\u003E\u5C06\u975E\u5E38\u611F\u6FC0\u5B83\u6765\u4F18\u5316\u4ED6\u4EEC\u7684\u6E38\u620F\u73A9\u6CD5\uFF0C\u56E0\u4E3A\u8FD9\u4E9B\u529F\u80FD\u5C06\u5E2E\u52A9\u4ED6\u4EEC\u505A\u51FA\u66F4\u597D\u7684\u51B3\u5B9A\u3002\u0022,it:\u0022\u003Cstrong\u003EI giocatori occasionali di T9A\u003C/strong\u003E troveranno queste funzionalit\u00E0 estremamente utili per trovare rapidamente regole o statistiche quando necessario.\u003Cbr /\u003E\u003Cstrong\u003EI giocatori hardcore di T9A\u003C/strong\u003E lo apprezzeranno enormemente per ottimizzare il loro gioco poich\u00E9 queste funzionalit\u00E0 li assisteranno nel prendere decisioni migliori.\u0022,de:\u0022\u003Cstrong\u003EGelegentliche T9A-Spieler\u003C/strong\u003E werden diese Funktionen \u00E4u\u00DFerst hilfreich finden, um Regeln oder Statistiken schnell zu finden, wenn sie sie ben\u00F6tigen.\u003Cbr /\u003E\u003Cstrong\u003EHardcore-T9A-Spieler\u003C/strong\u003E werden es sehr zu sch\u00E4tzen wissen, ihr Gameplay zu optimieren, da diese Funktionen ihnen helfen, bessere Entscheidungen zu treffen.\u0022,ja:\u0022\u003Cstrong\u003E\u30AB\u30B8\u30E5\u30A2\u30EB\u306A T9A \u30D7\u30EC\u30A4\u30E4\u30FC\u003C/strong\u003E\u306F\u3001\u5FC5\u8981\u306B\u5FDC\u3058\u3066\u30EB\u30FC\u30EB\u3084\u7D71\u8A08\u3092\u3059\u3070\u3084\u304F\u898B\u3064\u3051\u308B\u305F\u3081\u306B\u3001\u3053\u308C\u3089\u306E\u6A5F\u80FD\u304C\u975E\u5E38\u306B\u5F79\u7ACB\u3064\u3053\u3068\u3092\u767A\u898B\u3059\u308B\u3067\u3057\u3087\u3046\u3002\u003Cbr /\u003E\u003Cstrong\u003E\u30CF\u30FC\u30C9\u30B3\u30A2\u306A T9A \u30D7\u30EC\u30A4\u30E4\u30FC\u003C/strong\u003E\u306F\u3001\u3053\u308C\u3089\u306E\u6A5F\u80FD\u304C\u3088\u308A\u826F\u3044\u6C7A\u5B9A\u3092\u4E0B\u3059\u306E\u306B\u5F79\u7ACB\u3064\u305F\u3081\u3001\u30B2\u30FC\u30E0\u30D7\u30EC\u30A4\u3092\u6700\u9069\u5316\u3059\u308B\u305F\u3081\u306B\u305D\u308C\u3092\u5927\u3044\u306B\u8A55\u4FA1\u3059\u308B\u3067\u3057\u3087\u3046\u3002\u0022,pl:\u0022\u003Cstrong\u003EZwykli gracze T9A\u003C/strong\u003E uznaj\u0105 te funkcje za niezwykle pomocne w szybkim znajdowaniu zasad lub statystyk, gdy ich potrzebuj\u0105.\u003Cbr /\u003E\u003Cstrong\u003EHardkorowi gracze T9A\u003C/strong\u003E bardzo to doceni\u0105, aby zoptymalizowa\u0107 swoj\u0105 rozgrywk\u0119, poniewa\u017C te funkcje pomog\u0105 im w podejmowaniu lepszych decyzji.\u0022,pt:\u0022\u003Cstrong\u003EOs jogadores casuais de T9A\u003C/strong\u003E achar\u00E3o esses recursos extremamente \u00FAteis para encontrar rapidamente regras ou estat\u00EDsticas conforme necess\u00E1rio.\u003Cbr /\u003E\u003Cstrong\u003EOs jogadores hardcore de T9A\u003C/strong\u003E apreciar\u00E3o muito isso para otimizar sua jogabilidade, pois esses recursos os ajudar\u00E3o a tomar melhores decis\u00F5es.\u0022,hr:\u0022Za igra\u010De The 9th Age\u0022,cz:\u0022\u003Cstrong\u003ECasual T9A players\u003C/strong\u003E will find these features extremely helpful to quickly find rules or stats as they need.\u003Cbr /\u003E\u003Cstrong\u003EHardcore T9A players\u003C/strong\u003E will greatly appreciate it to optimize their gameplay as these features will assist them in taking better decisions.\u0022,sk:\u0022\u003Cstrong\u003ECasual T9A players\u003C/strong\u003E will find these features extremely helpful to quickly find rules or stats as they need.\u003Cbr /\u003E\u003Cstrong\u003EHardcore T9A players\u003C/strong\u003E will greatly appreciate it to optimize their gameplay as these features will assist them in taking better decisions.\u0022,gr:\u0022\u0393\u03B9\u03B1 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 The 9th Age\u0022,ru:\u0022\u0414\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432\u0022,ko:\u0022\u003Cstrong\u003ECasual T9A players\u003C/strong\u003E will find these features extremely helpful to quickly find rules or stats as they need.\u003Cbr /\u003E\u003Cstrong\u003EHardcore T9A players\u003C/strong\u003E will greatly appreciate it to optimize their gameplay as these features will assist them in taking better decisions.\u0022},tMe={en:\u0022The Gaming Assistant\u0022,fr:\u0022L\u0027Assistant de jeu\u0022,es:\u0022El Asistente de Juego\u0022,cn:\u0022\u6E38\u620F\u52A9\u624B\u0022,it:\u0022L\u0027Assistente di Gioco\u0022,de:\u0022Der Spiel-Assistent\u0022,ja:\u0022\u30B2\u30FC\u30E0\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u0022,pl:\u0022Asystent Gry\u0022,pt:\u0022O Assistente de Jogo\u0022,hr:\u0022Pomo\u0107nik za igru\u0022,cz:\u0022The Gaming Assistant\u0022,sk:\u0022The Gaming Assistant\u0022,gr:\u0022\u0392\u03BF\u03B7\u03B8\u03CC\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022The \u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0022,ko:\u0022The Gaming Assistant\u0022},rMe={en:\u0022Unit Stats and Profile\u0022,fr:\u0022Statistiques et profil d\u0027unit\u00E9\u0022,es:\u0022Estad\u00EDsticas y Perfil de Unidad\u0022,cn:\u0022\u5355\u4F4D\u7EDF\u8BA1\u548C\u914D\u7F6E\u0022,it:\u0022Statistiche e Profilo dell\u0027Unit\u00E0\u0022,de:\u0022Einheitenstatistiken und Profil\u0022,ja:\u0022\u30E6\u30CB\u30C3\u30C8\u7D71\u8A08\u3068\u30D7\u30ED\u30D5\u30A3\u30FC\u30EB\u0022,pl:\u0022Statystyki i Profil Jednostki\u0022,pt:\u0022Estat\u00EDsticas e Perfil da Unidade\u0022,hr:\u0022Statistike jedinica\u0022,cz:\u0022Unit Stats and Profile\u0022,sk:\u0022Unit Stats and Profile\u0022,gr:\u0022\u039C\u03BF\u03BD\u03AC\u03B4\u03B1 \u03A3\u03C4\u03B1\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC and \u03A0\u03C1\u03BF\u03C6\u03AF\u03BB\u0022,ru:\u0022\u042E\u043D\u0438\u0442 \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 and \u041F\u0440\u043E\u0444\u0438\u043B\u044C\u0022,ko:\u0022Unit Stats and Profile\u0022},nMe={en:\u0022The profiles and stats of every T9A unit are directly accessible in the app.\u0022,fr:\u0022Les profils et les statistiques de chaque unit\u00E9 T9A sont directement accessibles dans l\u0027application.\u0022,es:\u0022Los perfiles y estad\u00EDsticas de cada unidad T9A son directamente accesibles en la aplicaci\u00F3n.\u0022,cn:\u0022\u6BCF\u4E2A T9A \u5355\u4F4D\u7684\u914D\u7F6E\u548C\u7EDF\u8BA1\u6570\u636E\u90FD\u53EF\u4EE5\u76F4\u63A5\u5728\u5E94\u7528\u7A0B\u5E8F\u4E2D\u8BBF\u95EE\u3002\u0022,it:\u0022I profili e le statistiche di ogni unit\u00E0 T9A sono direttamente accessibili nell\u0027app.\u0022,de:\u0022Die Profile und Statistiken jeder T9A-Einheit sind direkt in der App zug\u00E4nglich.\u0022,ja:\u0022\u3059\u3079\u3066\u306E T9A \u30E6\u30CB\u30C3\u30C8\u306E\u30D7\u30ED\u30D5\u30A3\u30FC\u30EB\u3068\u7D71\u8A08\u306F\u3001\u30A2\u30D7\u30EA\u3067\u76F4\u63A5\u30A2\u30AF\u30BB\u30B9\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Profile i statystyki ka\u017Cdej jednostki T9A s\u0105 bezpo\u015Brednio dost\u0119pne w aplikacji.\u0022,pt:\u0022Os perfis e estat\u00EDsticas de cada unidade T9A s\u00E3o diretamente acess\u00EDveis no aplicativo.\u0022,hr:\u0022Pregledajte statistike svojih jedinica tijekom igre\u0022,cz:\u0022The profiles and stats of every T9A unit are directly accessible in the app.\u0022,sk:\u0022The profiles and stats of every T9A unit are directly accessible in the app.\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE \u03C3\u03C4\u03B1\u03C4\u03B9\u03C3\u03C4\u03B9\u03BA\u03CE\u03BD \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u044E\u043D\u0438\u0442\u043E\u0432\u0022,ko:\u0022The profiles and stats of every T9A unit are directly accessible in the app.\u0022},iMe={en:\u0022Rules and Special Rules\u0022,fr:\u0022R\u00E8gles et r\u00E8gles sp\u00E9ciales\u0022,es:\u0022Reglas y Reglas Especiales\u0022,cn:\u0022\u89C4\u5219\u548C\u7279\u6B8A\u89C4\u5219\u0022,it:\u0022Regole e Regole Speciali\u0022,de:\u0022Regeln und Sonderregeln\u0022,ja:\u0022\u30EB\u30FC\u30EB\u3068\u7279\u5225\u30EB\u30FC\u30EB\u0022,pl:\u0022Zasady i Zasady Specjalne\u0022,pt:\u0022Regras e Regras Especiais\u0022,hr:\u0022Pravila\u0022,cz:\u0022Rules and Special Rules\u0022,sk:\u0022Rules and Special Rules\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD\u0022,ru:\u0022\u0411\u0430\u0437\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u0022,ko:\u0022Rules and Special Rules\u0022},sMe={en:\u0022Most of T9A\u0027s rules and special rules are directly accessible in the app through hypertex links. It makes looking up a rule much faster than browsing a printed book or a pdf that are generally slow and not convenient to use on cell phones. You can directly access special rules through links in unit profile.\u0022,fr:\u0022La plupart des r\u00E8gles et des r\u00E8gles sp\u00E9ciales de T9A sont directement accessibles dans l\u0027application via des liens hypertexte. Cela rend la recherche d\u0027une r\u00E8gle beaucoup plus rapide que de parcourir un livre imprim\u00E9 ou un pdf qui sont g\u00E9n\u00E9ralement lents et peu pratiques \u00E0 utiliser sur les t\u00E9l\u00E9phones portables. Vous pouvez acc\u00E9der directement aux r\u00E8gles sp\u00E9ciales via des liens dans le profil de l\u0027unit\u00E9.\u0022,es:\u0022La mayor\u00EDa de las reglas y reglas especiales de T9A son directamente accesibles en la aplicaci\u00F3n a trav\u00E9s de enlaces de hipertexto. Hace que buscar una regla sea mucho m\u00E1s r\u00E1pido que navegar por un libro impreso o un pdf que generalmente son lentos y no son convenientes de usar en tel\u00E9fonos celulares. Puedes acceder directamente a reglas especiales a trav\u00E9s de enlaces en el perfil de la unidad.\u0022,cn:\u0022T9A \u7684\u5927\u591A\u6570\u89C4\u5219\u548C\u7279\u6B8A\u89C4\u5219\u53EF\u901A\u8FC7\u8D85\u6587\u672C\u94FE\u63A5\u76F4\u63A5\u5728\u5E94\u7528\u7A0B\u5E8F\u4E2D\u8BBF\u95EE\u3002\u8FD9\u4F7F\u5F97\u67E5\u627E\u89C4\u5219\u6BD4\u6D4F\u89C8\u5370\u5237\u4E66\u7C4D\u6216 pdf \u5FEB\u5F97\u591A\uFF0C\u8FD9\u4E9B\u901A\u5E38\u5F88\u6162\u4E14\u5728\u624B\u673A\u4E0A\u4F7F\u7528\u4E0D\u65B9\u4FBF\u3002\u60A8\u53EF\u4EE5\u901A\u8FC7\u5355\u4F4D\u914D\u7F6E\u6587\u4EF6\u4E2D\u7684\u94FE\u63A5\u76F4\u63A5\u8BBF\u95EE\u7279\u6B8A\u89C4\u5219\u3002\u0022,it:\u0022La maggior parte delle regole e delle regole speciali di T9A sono direttamente accessibili nell\u0027app tramite collegamenti ipertestuali. Rende la ricerca di una regola molto pi\u00F9 veloce che sfogliare un libro stampato o un pdf che sono generalmente lenti e non convenienti da usare sui telefoni cellulari. Puoi accedere direttamente alle regole speciali tramite collegamenti nel profilo dell\u0027unit\u00E0.\u0022,de:\u0022Die meisten Regeln und Sonderregeln von T9A sind direkt in der App \u00FCber Hypertext-Links zug\u00E4nglich. Dies macht das Nachschlagen einer Regel viel schneller als das Durchsuchen eines gedruckten Buches oder einer PDF-Datei, die im Allgemeinen langsam und auf Mobiltelefonen nicht bequem zu verwenden sind. Sie k\u00F6nnen direkt \u00FCber Links im Einheitenprofil auf Sonderregeln zugreifen.\u0022,ja:\u0022T9A \u306E\u30EB\u30FC\u30EB\u3068\u7279\u5225\u30EB\u30FC\u30EB\u306E\u307B\u3068\u3093\u3069\u306F\u3001\u30CF\u30A4\u30D1\u30FC\u30C6\u30AD\u30B9\u30C8\u30EA\u30F3\u30AF\u3092\u901A\u3058\u3066\u30A2\u30D7\u30EA\u3067\u76F4\u63A5\u30A2\u30AF\u30BB\u30B9\u3067\u304D\u307E\u3059\u3002\u3053\u308C\u306B\u3088\u308A\u3001\u30EB\u30FC\u30EB\u3092\u691C\u7D22\u3059\u308B\u3053\u3068\u304C\u3001\u901A\u5E38\u306F\u9045\u304F\u3001\u643A\u5E2F\u96FB\u8A71\u3067\u4F7F\u7528\u3059\u308B\u306E\u306B\u4FBF\u5229\u3067\u306F\u306A\u3044\u5370\u5237\u3055\u308C\u305F\u672C\u3084 pdf \u3092\u95B2\u89A7\u3059\u308B\u3088\u308A\u3082\u306F\u308B\u304B\u306B\u9AD8\u901F\u306B\u306A\u308A\u307E\u3059\u3002\u30E6\u30CB\u30C3\u30C8\u30D7\u30ED\u30D5\u30A3\u30FC\u30EB\u306E\u30EA\u30F3\u30AF\u3092\u901A\u3058\u3066\u7279\u5225\u30EB\u30FC\u30EB\u306B\u76F4\u63A5\u30A2\u30AF\u30BB\u30B9\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Wi\u0119kszo\u015B\u0107 zasad i zasad specjalnych T9A jest bezpo\u015Brednio dost\u0119pna w aplikacji przez linki hipertekstowe. Sprawia to, \u017Ce wyszukiwanie zasady jest znacznie szybsze ni\u017C przegl\u0105danie wydrukowanej ksi\u0105\u017Cki lub pdf, kt\u00F3re s\u0105 zazwyczaj wolne i niewygodne w u\u017Cyciu na telefonach kom\u00F3rkowych. Mo\u017Cesz bezpo\u015Brednio uzyska\u0107 dost\u0119p do zasad specjalnych przez linki w profilu jednostki.\u0022,pt:\u0022A maioria das regras e regras especiais de T9A s\u00E3o diretamente acess\u00EDveis no aplicativo por meio de links de hipertexto. Isso torna a pesquisa de uma regra muito mais r\u00E1pida do que navegar por um livro impresso ou um pdf que geralmente s\u00E3o lentos e n\u00E3o s\u00E3o convenientes para usar em telefones celulares. Voc\u00EA pode acessar diretamente regras especiais por meio de links no perfil da unidade.\u0022,hr:\u0022Pristupite pravilima igre\u0022,cz:\u0022Most of T9A\u0027s rules and special rules are directly accessible in the app through hypertex links. It makes looking up a rule much faster than browsing a printed book or a pdf that are generally slow and not convenient to use on cell phones. You can directly access special rules through links in unit profile.\u0022,sk:\u0022Most of T9A\u0027s rules and special rules are directly accessible in the app through hypertex links. It makes looking up a rule much faster than browsing a printed book or a pdf that are generally slow and not convenient to use on cell phones. You can directly access special rules through links in unit profile.\u0022,gr:\u0022\u0393\u03C1\u03AE\u03B3\u03BF\u03C1\u03B7 \u03B1\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03BA\u03B1\u03BD\u03CC\u03BD\u03C9\u03BD\u0022,ru:\u0022\u041F\u043E\u0438\u0441\u043A \u0438 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u0440\u0430\u0432\u0438\u043B\u0022,ko:\u0022Most of T9A\u0027s rules and special rules are directly accessible in the app through hypertex links. It makes looking up a rule much faster than browsing a printed book or a pdf that are generally slow and not convenient to use on cell phones. You can directly access special rules through links in unit profile.\u0022},oMe={en:\u0022Pregame Sequence Assistant\u0022,fr:\u0022Assistant de s\u00E9quence de pr\u00E9-jeu\u0022,es:\u0022Asistente de Secuencia Previa al Juego\u0022,cn:\u0022\u8D5B\u524D\u5E8F\u5217\u52A9\u624B\u0022,it:\u0022Assistente di Sequenza Pre-gioco\u0022,de:\u0022Vorspiel-Sequenz-Assistent\u0022,ja:\u0022\u8A66\u5408\u524D\u30B7\u30FC\u30B1\u30F3\u30B9\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u0022,pl:\u0022Asystent Sekwencji Przed Gr\u0105\u0022,pt:\u0022Assistente de Sequ\u00EAncia Pr\u00E9-jogo\u0022,hr:\u0022Prije igre\u0022,cz:\u0022Pregame Sequence Assistant\u0022,sk:\u0022Pregame Sequence Assistant\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03B5\u03C4\u03BF\u03B9\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u043F\u0440\u0435\u0434\u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438\u0022,ko:\u0022Pregame Sequence Assistant\u0022},aMe={en:\u0022The Pregame Sequence Assistant hels you quickly randomize the Map, the Objective and the Deployment Type.\u0022,fr:\u0022L\u0027Assistant de s\u00E9quence de pr\u00E9-jeu vous aide \u00E0 randomiser rapidement la carte, l\u0027objectif et le type de d\u00E9ploiement.\u0022,es:\u0022El Asistente de Secuencia Previa al Juego te ayuda a aleatorizar r\u00E1pidamente el Mapa, el Objetivo y el Tipo de Despliegue.\u0022,cn:\u0022\u8D5B\u524D\u5E8F\u5217\u52A9\u624B\u53EF\u5E2E\u52A9\u60A8\u5FEB\u901F\u968F\u673A\u5316\u5730\u56FE\u3001\u76EE\u6807\u548C\u90E8\u7F72\u7C7B\u578B\u3002\u0022,it:\u0022L\u0027Assistente di Sequenza Pre-gioco ti aiuta a randomizzare rapidamente la Mappa, l\u0027Obiettivo e il Tipo di Schieramento.\u0022,de:\u0022Der Vorspiel-Sequenz-Assistent hilft Ihnen, die Karte, das Ziel und den Einsatztyp schnell zu randomisieren.\u0022,ja:\u0022\u8A66\u5408\u524D\u30B7\u30FC\u30B1\u30F3\u30B9\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u306F\u3001\u30DE\u30C3\u30D7\u3001\u76EE\u6A19\u3001\u5C55\u958B\u30BF\u30A4\u30D7\u3092\u8FC5\u901F\u306B\u30E9\u30F3\u30C0\u30E0\u5316\u3059\u308B\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u0022,pl:\u0022Asystent Sekwencji Przed Gr\u0105 pomaga szybko losowa\u0107 Map\u0119, Cel i Typ Rozmieszczenia.\u0022,pt:\u0022O Assistente de Sequ\u00EAncia Pr\u00E9-jogo ajuda voc\u00EA a aleatorizar rapidamente o Mapa, o Objetivo e o Tipo de Implanta\u00E7\u00E3o.\u0022,hr:\u0022Upravljajte postavljanjem prije igre\u0022,cz:\u0022The Pregame Sequence Assistant hels you quickly randomize the Map, the Objective and the Deployment Type.\u0022,sk:\u0022The Pregame Sequence Assistant hels you quickly randomize the Map, the Objective and the Deployment Type.\u0022,gr:\u0022\u0392\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C3\u03C4\u03AE\u03C3\u03B9\u03BC\u03BF \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u043F\u0435\u0440\u0435\u0434 \u0438\u0433\u0440\u043E\u0439\u0022,ko:\u0022The Pregame Sequence Assistant hels you quickly randomize the Map, the Objective and the Deployment Type.\u0022},lMe={en:\u0022Virtual Spell Cards\u0022,fr:\u0022Cartes de sort virtuelles\u0022,es:\u0022Cartas de Hechizo Virtuales\u0022,cn:\u0022\u865A\u62DF\u6CD5\u672F\u5361\u0022,it:\u0022Carte Incantesimo Virtuali\u0022,de:\u0022Virtuelle Zauberkarten\u0022,ja:\u0022\u4EEE\u60F3\u546A\u6587\u30AB\u30FC\u30C9\u0022,pl:\u0022Wirtualne Karty Zakl\u0119\u0107\u0022,pt:\u0022Cartas de Feiti\u00E7o Virtuais\u0022,hr:\u0022Kartice \u010Darolija\u0022,cz:\u0022Virtual Spell Cards\u0022,sk:\u0022Virtual Spell Cards\u0022,gr:\u0022\u039A\u03AC\u03C1\u03C4\u03B5\u03C2 \u03BE\u03BF\u03C1\u03BA\u03B9\u03CE\u03BD\u0022,ru:\u0022\u0412\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439\u0022,ko:\u0022Virtual Spell Cards\u0022},uMe={en:\u0022New Recruit helps you select your spells for all your Wizards. All spells and rules regarding spell selection are accounted for. Virtual Spell Cards are generated for all spells, bound spells and attributes. These will be kept up to date so you will never have to print cards anymore.\u0022,fr:\u0022New Recruit vous aide \u00E0 s\u00E9lectionner vos sorts pour tous vos magiciens. Tous les sorts et r\u00E8gles concernant la s\u00E9lection des sorts sont pris en compte. Des cartes de sort virtuelles sont g\u00E9n\u00E9r\u00E9es pour tous les sorts, les sorts li\u00E9s et les attributs. Celles-ci seront tenues \u00E0 jour afin que vous n\u0027ayez plus jamais \u00E0 imprimer de cartes.\u0022,es:\u0022New Recruit te ayuda a seleccionar tus hechizos para todos tus Magos. Todos los hechizos y reglas relacionadas con la selecci\u00F3n de hechizos est\u00E1n contabilizados. Las Cartas de Hechizo Virtuales se generan para todos los hechizos, hechizos vinculados y atributos. Estas se mantendr\u00E1n actualizadas para que nunca tengas que imprimir cartas de nuevo.\u0022,cn:\u0022New Recruit \u53EF\u5E2E\u52A9\u60A8\u4E3A\u6240\u6709\u6CD5\u5E08\u9009\u62E9\u6CD5\u672F\u3002\u6240\u6709\u6CD5\u672F\u548C\u6709\u5173\u6CD5\u672F\u9009\u62E9\u7684\u89C4\u5219\u90FD\u88AB\u8003\u8651\u5728\u5185\u3002\u4E3A\u6240\u6709\u6CD5\u672F\u3001\u7ED1\u5B9A\u6CD5\u672F\u548C\u5C5E\u6027\u751F\u6210\u865A\u62DF\u6CD5\u672F\u5361\u3002\u8FD9\u4E9B\u5C06\u4FDD\u6301\u6700\u65B0\u72B6\u6001\uFF0C\u56E0\u6B64\u60A8\u5C06\u6C38\u8FDC\u4E0D\u5FC5\u518D\u6253\u5370\u5361\u7247\u3002\u0022,it:\u0022New Recruit ti aiuta a selezionare i tuoi incantesimi per tutti i tuoi Maghi. Tutti gli incantesimi e le regole riguardanti la selezione degli incantesimi sono contabilizzati. Le Carte Incantesimo Virtuali vengono generate per tutti gli incantesimi, incantesimi legati e attributi. Queste saranno mantenute aggiornate in modo che non dovrai mai pi\u00F9 stampare carte.\u0022,de:\u0022New Recruit hilft Ihnen, Ihre Zauberspr\u00FCche f\u00FCr alle Ihre Zauberer auszuw\u00E4hlen. Alle Zauberspr\u00FCche und Regeln zur Zauberauswahl werden ber\u00FCcksichtigt. Virtuelle Zauberkarten werden f\u00FCr alle Zauberspr\u00FCche, gebundene Zauberspr\u00FCche und Attribute generiert. Diese werden auf dem neuesten Stand gehalten, sodass Sie nie wieder Karten drucken m\u00FCssen.\u0022,ja:\u0022New Recruit \u306F\u3001\u3059\u3079\u3066\u306E\u30A6\u30A3\u30B6\u30FC\u30C9\u306E\u546A\u6587\u3092\u9078\u629E\u3059\u308B\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u546A\u6587\u306E\u9078\u629E\u306B\u95A2\u3059\u308B\u3059\u3079\u3066\u306E\u546A\u6587\u3068\u30EB\u30FC\u30EB\u304C\u8003\u616E\u3055\u308C\u307E\u3059\u3002\u3059\u3079\u3066\u306E\u546A\u6587\u3001\u30D0\u30A6\u30F3\u30C9\u546A\u6587\u3001\u5C5E\u6027\u306B\u5BFE\u3057\u3066\u4EEE\u60F3\u546A\u6587\u30AB\u30FC\u30C9\u304C\u751F\u6210\u3055\u308C\u307E\u3059\u3002\u3053\u308C\u3089\u306F\u6700\u65B0\u306E\u72B6\u614B\u306B\u4FDD\u305F\u308C\u308B\u305F\u3081\u3001\u30AB\u30FC\u30C9\u3092\u5370\u5237\u3059\u308B\u5FC5\u8981\u304C\u306A\u304F\u306A\u308A\u307E\u3059\u3002\u0022,pl:\u0022New Recruit pomaga wybra\u0107 zakl\u0119cia dla wszystkich twoich Czarodziej\u00F3w. Wszystkie zakl\u0119cia i zasady dotycz\u0105ce wyboru zakl\u0119\u0107 s\u0105 uwzgl\u0119dnione. Wirtualne Karty Zakl\u0119\u0107 s\u0105 generowane dla wszystkich zakl\u0119\u0107, zakl\u0119\u0107 zwi\u0105zanych i atrybut\u00F3w. B\u0119d\u0105 one aktualizowane, wi\u0119c nigdy wi\u0119cej nie b\u0119dziesz musia\u0142 drukowa\u0107 kart.\u0022,pt:\u0022O New Recruit ajuda voc\u00EA a selecionar seus feiti\u00E7os para todos os seus Magos. Todos os feiti\u00E7os e regras relacionadas \u00E0 sele\u00E7\u00E3o de feiti\u00E7os s\u00E3o contabilizados. Cartas de Feiti\u00E7o Virtuais s\u00E3o geradas para todos os feiti\u00E7os, feiti\u00E7os vinculados e atributos. Eles ser\u00E3o mantidos atualizados para que voc\u00EA nunca mais precise imprimir cartas.\u0022,hr:\u0022Pristupite karticama \u010Darolija\u0022,cz:\u0022New Recruit helps you select your spells for all your Wizards. All spells and rules regarding spell selection are accounted for. Virtual Spell Cards are generated for all spells, bound spells and attributes. These will be kept up to date so you will never have to print cards anymore.\u0022,sk:\u0022New Recruit helps you select your spells for all your Wizards. All spells and rules regarding spell selection are accounted for. Virtual Spell Cards are generated for all spells, bound spells and attributes. These will be kept up to date so you will never have to print cards anymore.\u0022,gr:\u0022\u03A8\u03B7\u03C6\u03B9\u03B1\u03BA\u03AD\u03C2 \u03BA\u03AC\u03C1\u03C4\u03B5\u03C2 \u03BE\u03BF\u03C1\u03BA\u03B9\u03CE\u03BD\u0022,ru:\u0022\u041A\u0430\u0440\u0442\u043E\u0447\u043A\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439\u0022,ko:\u0022\uC0C8 Recruit helps you select your spells for all your Wizards. All spells and rules regarding spell selection are accounted for. Virtual Spell Cards are generated for all spells, bound spells and attributes. These will be kept up to date so you will never have to print cards anymore.\u0022},cMe={en:\u0022Magic Phase Assistant\u0022,fr:\u0022Assistant de phase de magie\u0022,es:\u0022Asistente de Fase M\u00E1gica\u0022,cn:\u0022\u9B54\u6CD5\u9636\u6BB5\u52A9\u624B\u0022,it:\u0022Assistente di Fase Magica\u0022,de:\u0022Magiephasen-Assistent\u0022,ja:\u0022\u9B54\u6CD5\u30D5\u30A7\u30FC\u30BA\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u0022,pl:\u0022Asystent Fazy Magii\u0022,pt:\u0022Assistente de Fase M\u00E1gica\u0022,hr:\u0022Magijska faza\u0022,cz:\u0022Magic Phase Assistant\u0022,sk:\u0022Magic Phase Assistant\u0022,gr:\u0022\u03A6\u03AC\u03C3\u03B7 \u03BC\u03B1\u03B3\u03B5\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0424\u0430\u0437\u0430 \u043C\u0430\u0433\u0438\u0438\u0022,ko:\u0022Magic Phase Assistant\u0022},AMe={en:\u0022The Magic Phase Assistant will give you easy access to all the Spell Cards of your Wizards and help you keep track of spells you already cast during a Magic Phase. You can also use it to keep track of what your opponent already cast this turn to consider what Spells they have left to cast.\u0022,fr:\u0022L\u0027Assistant de phase de magie vous donnera un acc\u00E8s facile \u00E0 toutes les cartes de sort de vos magiciens et vous aidera \u00E0 garder une trace des sorts que vous avez d\u00E9j\u00E0 lanc\u00E9s pendant une phase de magie. Vous pouvez \u00E9galement l\u0027utiliser pour garder une trace de ce que votre adversaire a d\u00E9j\u00E0 lanc\u00E9 ce tour pour consid\u00E9rer quels sorts il lui reste \u00E0 lancer.\u0022,es:\u0022El Asistente de Fase M\u00E1gica te dar\u00E1 f\u00E1cil acceso a todas las Cartas de Hechizo de tus Magos y te ayudar\u00E1 a llevar un registro de los hechizos que ya lanzaste durante una Fase M\u00E1gica. Tambi\u00E9n puedes usarlo para llevar un registro de lo que tu oponente ya lanz\u00F3 este turno para considerar qu\u00E9 Hechizos le quedan por lanzar.\u0022,cn:\u0022\u9B54\u6CD5\u9636\u6BB5\u52A9\u624B\u5C06\u8BA9\u60A8\u8F7B\u677E\u8BBF\u95EE\u6240\u6709\u6CD5\u5E08\u7684\u6CD5\u672F\u5361\uFF0C\u5E76\u5E2E\u52A9\u60A8\u8DDF\u8E2A\u5728\u9B54\u6CD5\u9636\u6BB5\u5DF2\u7ECF\u65BD\u653E\u7684\u6CD5\u672F\u3002\u60A8\u8FD8\u53EF\u4EE5\u4F7F\u7528\u5B83\u6765\u8DDF\u8E2A\u5BF9\u624B\u5728\u672C\u56DE\u5408\u5DF2\u7ECF\u65BD\u653E\u7684\u5185\u5BB9\uFF0C\u4EE5\u8003\u8651\u4ED6\u4EEC\u8FD8\u5269\u4E0B\u4EC0\u4E48\u6CD5\u672F\u53EF\u4EE5\u65BD\u653E\u3002\u0022,it:\u0022L\u0027Assistente di Fase Magica ti dar\u00E0 un facile accesso a tutte le Carte Incantesimo dei tuoi Maghi e ti aiuter\u00E0 a tenere traccia degli incantesimi che hai gi\u00E0 lanciato durante una Fase Magica. Puoi anche usarlo per tenere traccia di ci\u00F2 che il tuo avversario ha gi\u00E0 lanciato questo turno per considerare quali Incantesimi gli sono rimasti da lanciare.\u0022,de:\u0022Der Magiephasen-Assistent gibt Ihnen einfachen Zugriff auf alle Zauberkarten Ihrer Zauberer und hilft Ihnen, den \u00DCberblick \u00FCber Zauberspr\u00FCche zu behalten, die Sie w\u00E4hrend einer Magiephase bereits gewirkt haben. Sie k\u00F6nnen es auch verwenden, um zu verfolgen, was Ihr Gegner in dieser Runde bereits gewirkt hat, um zu \u00FCberlegen, welche Zauberspr\u00FCche er noch wirken kann.\u0022,ja:\u0022\u9B54\u6CD5\u30D5\u30A7\u30FC\u30BA\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u306F\u3001\u3059\u3079\u3066\u306E\u30A6\u30A3\u30B6\u30FC\u30C9\u306E\u546A\u6587\u30AB\u30FC\u30C9\u3078\u306E\u7C21\u5358\u306A\u30A2\u30AF\u30BB\u30B9\u3092\u63D0\u4F9B\u3057\u3001\u9B54\u6CD5\u30D5\u30A7\u30FC\u30BA\u4E2D\u306B\u3059\u3067\u306B\u5531\u3048\u305F\u546A\u6587\u3092\u8FFD\u8DE1\u3059\u308B\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u307E\u305F\u3001\u76F8\u624B\u304C\u4ECA\u30BF\u30FC\u30F3\u3059\u3067\u306B\u5531\u3048\u305F\u5185\u5BB9\u3092\u8FFD\u8DE1\u3057\u3066\u3001\u307E\u3060\u5531\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u546A\u6587\u3092\u691C\u8A0E\u3059\u308B\u305F\u3081\u306B\u4F7F\u7528\u3059\u308B\u3053\u3068\u3082\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Asystent Fazy Magii zapewni ci \u0142atwy dost\u0119p do wszystkich Kart Zakl\u0119\u0107 twoich Czarodziej\u00F3w i pomo\u017Ce ci \u015Bledzi\u0107 zakl\u0119cia, kt\u00F3re ju\u017C rzuci\u0142e\u015B podczas Fazy Magii. Mo\u017Cesz go r\u00F3wnie\u017C u\u017Cy\u0107 do \u015Bledzenia, co tw\u00F3j przeciwnik ju\u017C rzuci\u0142 w tej turze, aby rozwa\u017Cy\u0107, jakie Zakl\u0119cia ma jeszcze do rzucenia.\u0022,pt:\u0022O Assistente de Fase M\u00E1gica lhe dar\u00E1 f\u00E1cil acesso a todas as Cartas de Feiti\u00E7o de seus Magos e ajudar\u00E1 voc\u00EA a acompanhar os feiti\u00E7os que j\u00E1 lan\u00E7ou durante uma Fase M\u00E1gica. Voc\u00EA tamb\u00E9m pode us\u00E1-lo para acompanhar o que seu oponente j\u00E1 lan\u00E7ou neste turno para considerar quais Feiti\u00E7os eles t\u00EAm para lan\u00E7ar.\u0022,hr:\u0022Upravljajte magijskom fazom\u0022,cz:\u0022The Magic Phase Assistant will give you easy access to all the Spell Cards of your Wizards and help you keep track of spells you already cast during a Magic Phase. You can also use it to keep track of what your opponent already cast this turn to consider what Spells they have left to cast.\u0022,sk:\u0022The Magic Phase Assistant will give you easy access to all the Spell Cards of your Wizards and help you keep track of spells you already cast during a Magic Phase. You can also use it to keep track of what your opponent already cast this turn to consider what Spells they have left to cast.\u0022,gr:\u0022\u0392\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1 \u03B3\u03B9\u03B1 \u03C4\u03B7 \u03C6\u03AC\u03C3\u03B7 \u03BC\u03B1\u03B3\u03B5\u03AF\u03B1\u03C2\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u043C\u0430\u0433\u0438\u0438\u0022,ko:\u0022The Magic Phase Assistant will give you easy access to all the Spell Cards of your Wizards and help you keep track of spells you already cast during a Magic Phase. You can also use it to keep track of what your opponent already cast this turn to consider what Spells they have left to cast.\u0022},dMe={en:\u0022This page also includes a counter to keep track of Veil Tokens and a Flux Card tracker that allows you to select random Flux Cards and remember which have already been used.\u0022,fr:\u0022Cette page comprend \u00E9galement un compteur pour suivre les jetons de voile et un tracker de carte de flux qui vous permet de s\u00E9lectionner des cartes de flux al\u00E9atoires et de vous souvenir de celles qui ont d\u00E9j\u00E0 \u00E9t\u00E9 utilis\u00E9es.\u0022,es:\u0022Esta p\u00E1gina tambi\u00E9n incluye un contador para llevar un registro de los Tokens de Velo y un rastreador de Cartas de Flujo que te permite seleccionar Cartas de Flujo aleatorias y recordar cu\u00E1les ya se han usado.\u0022,cn:\u0022\u6B64\u9875\u9762\u8FD8\u5305\u62EC\u4E00\u4E2A\u8BA1\u6570\u5668\uFF0C\u7528\u4E8E\u8DDF\u8E2A\u9762\u7EB1\u4EE4\u724C\u548C\u4E00\u4E2A\u901A\u91CF\u5361\u8DDF\u8E2A\u5668\uFF0C\u5141\u8BB8\u60A8\u9009\u62E9\u968F\u673A\u901A\u91CF\u5361\u5E76\u8BB0\u4F4F\u54EA\u4E9B\u5DF2\u7ECF\u4F7F\u7528\u8FC7\u3002\u0022,it:\u0022Questa pagina include anche un contatore per tenere traccia dei Token Velo e un tracker di Carte Flusso che ti consente di selezionare Carte Flusso casuali e ricordare quali sono gi\u00E0 state utilizzate.\u0022,de:\u0022Diese Seite enth\u00E4lt auch einen Z\u00E4hler, um Schleier-Token im Auge zu behalten, und einen Flux-Karten-Tracker, mit dem Sie zuf\u00E4llige Flux-Karten ausw\u00E4hlen und sich merken k\u00F6nnen, welche bereits verwendet wurden.\u0022,ja:\u0022\u3053\u306E\u30DA\u30FC\u30B8\u306B\u306F\u3001\u30F4\u30A7\u30FC\u30EB\u30C8\u30FC\u30AF\u30F3\u3092\u8FFD\u8DE1\u3059\u308B\u305F\u3081\u306E\u30AB\u30A6\u30F3\u30BF\u30FC\u3068\u3001\u30E9\u30F3\u30C0\u30E0\u306A\u30D5\u30E9\u30C3\u30AF\u30B9\u30AB\u30FC\u30C9\u3092\u9078\u629E\u3057\u3001\u3069\u308C\u304C\u3059\u3067\u306B\u4F7F\u7528\u3055\u308C\u3066\u3044\u308B\u304B\u3092\u899A\u3048\u3066\u304A\u304F\u3053\u3068\u304C\u3067\u304D\u308B\u30D5\u30E9\u30C3\u30AF\u30B9\u30AB\u30FC\u30C9\u30C8\u30E9\u30C3\u30AB\u30FC\u3082\u542B\u307E\u308C\u3066\u3044\u307E\u3059\u3002\u0022,pl:\u0022Ta strona zawiera r\u00F3wnie\u017C licznik do \u015Bledzenia \u017Beton\u00F3w Zas\u0142ony i tracker Kart Strumienia, kt\u00F3ry pozwala wybra\u0107 losowe Karty Strumienia i zapami\u0119ta\u0107, kt\u00F3re zosta\u0142y ju\u017C u\u017Cyte.\u0022,pt:\u0022Esta p\u00E1gina tamb\u00E9m inclui um contador para acompanhar os Tokens de V\u00E9u e um rastreador de Cartas de Fluxo que permite selecionar Cartas de Fluxo aleat\u00F3rias e lembrar quais j\u00E1 foram usadas.\u0022,hr:\u0022Tokeni magijske faze\u0022,cz:\u0022This page also includes a counter to keep track of Veil Tokens and a Flux Card tracker that allows you to select random Flux Cards and remember which have already been used.\u0022,sk:\u0022This page also includes a counter to keep track of Veil Tokens and a Flux Card tracker that allows you to select random Flux Cards and remember which have already been used.\u0022,gr:\u0022\u039A\u03BF\u03C5\u03C0\u03CC\u03BD\u03B9\u03B1 \u03BC\u03B1\u03B3\u03B5\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0416\u0435\u0442\u043E\u043D\u044B \u043C\u0430\u0433\u0438\u0438\u0022,ko:\u0022This page also includes a counter to keep track of Veil Tokens and a Flux Card tracker that allows you to select random Flux Cards and remember which have already been used.\u0022},fMe={en:\u0022Victory Point Tracker\u0022,fr:\u0022Tracker de points de victoire\u0022,es:\u0022Rastreador de Puntos de Victoria\u0022,cn:\u0022\u80DC\u5229\u70B9\u8FFD\u8E2A\u5668\u0022,it:\u0022Tracker dei Punti Vittoria\u0022,de:\u0022Siegpunkt-Tracker\u0022,ja:\u0022\u52DD\u5229\u30DD\u30A4\u30F3\u30C8\u30C8\u30E9\u30C3\u30AB\u30FC\u0022,pl:\u0022Tracker Punkt\u00F3w Zwyci\u0119stwa\u0022,pt:\u0022Rastreador de Pontos de Vit\u00F3ria\u0022,hr:\u0022Pra\u0107enje pobjede\u0022,cz:\u0022Victory Point Tracker\u0022,sk:\u0022Victory Point Tracker\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B7 \u03BD\u03AF\u03BA\u03B7\u03C2\u0022,ru:\u0022\u0422\u0440\u0435\u043A\u0435\u0440 \u043F\u043E\u0431\u0435\u0434\u043D\u044B\u0445 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022Victory Point Tracker\u0022},pMe={en:\u0022The Victory Point Tracker helps you keep easily count Victory Points. You simply check buttons to switch your units status between fleeing, shattered and destroyed and New Recruit automatically calculates Victory Points. Bonus points for General and BSB are accounted for.\u0022,fr:\u0022Le Tracker de points de victoire vous aide \u00E0 compter facilement les points de victoire. Vous cochez simplement des boutons pour changer le statut de vos unit\u00E9s entre en fuite, bris\u00E9e et d\u00E9truite et New Recruit calcule automatiquement les points de victoire. Les points bonus pour le G\u00E9n\u00E9ral et le BSB sont pris en compte.\u0022,es:\u0022El Rastreador de Puntos de Victoria te ayuda a contar f\u00E1cilmente los Puntos de Victoria. Simplemente marcas botones para cambiar el estado de tus unidades entre huyendo, destrozada y destruida y New Recruit calcula autom\u00E1ticamente los Puntos de Victoria. Los puntos de bonificaci\u00F3n para General y BSB est\u00E1n contabilizados.\u0022,cn:\u0022\u80DC\u5229\u70B9\u8FFD\u8E2A\u5668\u53EF\u5E2E\u52A9\u60A8\u8F7B\u677E\u8BA1\u7B97\u80DC\u5229\u70B9\u3002\u60A8\u53EA\u9700\u9009\u4E2D\u6309\u94AE\u5373\u53EF\u5728\u9003\u8DD1\u3001\u7C89\u788E\u548C\u6467\u6BC1\u4E4B\u95F4\u5207\u6362\u5355\u4F4D\u72B6\u6001\uFF0CNew Recruit \u4F1A\u81EA\u52A8\u8BA1\u7B97\u80DC\u5229\u70B9\u3002\u5DF2\u8003\u8651\u5C06\u519B\u548C BSB \u7684\u5956\u52B1\u70B9\u6570\u3002\u0022,it:\u0022Il Tracker dei Punti Vittoria ti aiuta a contare facilmente i Punti Vittoria. Basta controllare i pulsanti per cambiare lo stato delle tue unit\u00E0 tra in fuga, distrutta e distrutta e New Recruit calcola automaticamente i Punti Vittoria. I punti bonus per Generale e BSB sono contabilizzati.\u0022,de:\u0022Der Siegpunkt-Tracker hilft Ihnen, Siegpunkte einfach zu z\u00E4hlen. Sie aktivieren einfach Schaltfl\u00E4chen, um den Status Ihrer Einheiten zwischen fliehend, zerschmettert und zerst\u00F6rt zu wechseln, und New Recruit berechnet automatisch Siegpunkte. Bonuspunkte f\u00FCr General und BSB werden ber\u00FCcksichtigt.\u0022,ja:\u0022\u52DD\u5229\u30DD\u30A4\u30F3\u30C8\u30C8\u30E9\u30C3\u30AB\u30FC\u306F\u3001\u52DD\u5229\u30DD\u30A4\u30F3\u30C8\u3092\u7C21\u5358\u306B\u30AB\u30A6\u30F3\u30C8\u3059\u308B\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u30DC\u30BF\u30F3\u3092\u30C1\u30A7\u30C3\u30AF\u3057\u3066\u30E6\u30CB\u30C3\u30C8\u306E\u30B9\u30C6\u30FC\u30BF\u30B9\u3092\u9003\u8D70\u3001\u7C89\u7815\u3001\u7834\u58CA\u306E\u9593\u3067\u5207\u308A\u66FF\u3048\u308B\u3060\u3051\u3067\u3001New Recruit \u304C\u81EA\u52D5\u7684\u306B\u52DD\u5229\u30DD\u30A4\u30F3\u30C8\u3092\u8A08\u7B97\u3057\u307E\u3059\u3002\u5C06\u8ECD\u3068 BSB \u306E\u30DC\u30FC\u30CA\u30B9\u30DD\u30A4\u30F3\u30C8\u304C\u8003\u616E\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Tracker Punkt\u00F3w Zwyci\u0119stwa pomaga \u0142atwo liczy\u0107 Punkty Zwyci\u0119stwa. Po prostu zaznaczasz przyciski, aby zmieni\u0107 status swoich jednostek mi\u0119dzy uciekaj\u0105c\u0105, roztrzaskan\u0105 i zniszczon\u0105, a New Recruit automatycznie oblicza Punkty Zwyci\u0119stwa. Punkty bonusowe za Genera\u0142a i BSB s\u0105 uwzgl\u0119dnione.\u0022,pt:\u0022O Rastreador de Pontos de Vit\u00F3ria ajuda voc\u00EA a contar facilmente os Pontos de Vit\u00F3ria. Basta marcar bot\u00F5es para alternar o status de suas unidades entre fugindo, despeda\u00E7ada e destru\u00EDda e o New Recruit calcula automaticamente os Pontos de Vit\u00F3ria. Pontos de b\u00F4nus para General e BSB s\u00E3o contabilizados.\u0022,hr:\u0022Pratite bodove pobjede\u0022,cz:\u0022The Victory Point Tracker helps you keep easily count Victory Points. You simply check buttons to switch your units status between fleeing, shattered and destroyed and New Recruit automatically calculates Victory Points. Bonus points for General and BSB are accounted for.\u0022,sk:\u0022The Victory Point Tracker helps you keep easily count Victory Points. You simply check buttons to switch your units status between fleeing, shattered and destroyed and New Recruit automatically calculates Victory Points. Bonus points for General and BSB are accounted for.\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03CC\u03BD\u03C4\u03BF\u03C5\u03C2 \u03BD\u03AF\u03BA\u03B7\u03C2\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043E\u0447\u043A\u0438 \u043F\u043E\u0431\u0435\u0434\u044B\u0022,ko:\u0022The Victory Point Tracker helps you keep easily count Victory Points. You simply check buttons to switch your units status between fleeing, shattered and destroyed and New Recruit automatically calculates Victory Points. Bonus points for General and BSB are accounted for.\u0022},hMe={en:\u0022Very useful at the end of the game but can also be used throughout the game to help you see where you are at. It can help you make decisions by knowing if a trade would be favorable example. Could be considered cheating, use with caution!\u0022,fr:\u0022Tr\u00E8s utile \u00E0 la fin du jeu mais peut \u00E9galement \u00EAtre utilis\u00E9 tout au long du jeu pour vous aider \u00E0 voir o\u00F9 vous en \u00EAtes. Cela peut vous aider \u00E0 prendre des d\u00E9cisions en sachant si un \u00E9change serait favorable par exemple. Pourrait \u00EAtre consid\u00E9r\u00E9 comme de la triche, \u00E0 utiliser avec pr\u00E9caution !\u0022,es:\u0022Muy \u00FAtil al final del juego, pero tambi\u00E9n se puede usar durante todo el juego para ayudarte a ver d\u00F3nde est\u00E1s. Puede ayudarte a tomar decisiones sabiendo si un intercambio ser\u00EDa favorable, por ejemplo. Podr\u00EDa considerarse trampa, \u00A1\u00FAsalo con precauci\u00F3n!\u0022,cn:\u0022\u5728\u6E38\u620F\u7ED3\u675F\u65F6\u975E\u5E38\u6709\u7528\uFF0C\u4F46\u4E5F\u53EF\u4EE5\u5728\u6574\u4E2A\u6E38\u620F\u4E2D\u4F7F\u7528\uFF0C\u4EE5\u5E2E\u52A9\u60A8\u4E86\u89E3\u81EA\u5DF1\u7684\u4F4D\u7F6E\u3002\u5B83\u53EF\u4EE5\u901A\u8FC7\u77E5\u9053\u4EA4\u6613\u662F\u5426\u6709\u5229\u6765\u5E2E\u52A9\u60A8\u505A\u51FA\u51B3\u5B9A\u3002\u53EF\u80FD\u88AB\u8BA4\u4E3A\u662F\u4F5C\u5F0A\uFF0C\u8BF7\u8C28\u614E\u4F7F\u7528\uFF01\u0022,it:\u0022Molto utile alla fine del gioco ma pu\u00F2 anche essere utilizzato durante tutto il gioco per aiutarti a vedere dove sei. Pu\u00F2 aiutarti a prendere decisioni sapendo se uno scambio sarebbe favorevole ad esempio. Potrebbe essere considerato un imbroglio, usalo con cautela!\u0022,de:\u0022Sehr n\u00FCtzlich am Ende des Spiels, kann aber auch w\u00E4hrend des gesamten Spiels verwendet werden, um zu sehen, wo Sie stehen. Es kann Ihnen helfen, Entscheidungen zu treffen, indem Sie wissen, ob ein Handel g\u00FCnstig w\u00E4re, zum Beispiel. K\u00F6nnte als Betrug angesehen werden, mit Vorsicht verwenden!\u0022,ja:\u0022\u30B2\u30FC\u30E0\u306E\u7D42\u308F\u308A\u306B\u975E\u5E38\u306B\u4FBF\u5229\u3067\u3059\u304C\u3001\u30B2\u30FC\u30E0\u5168\u4F53\u3067\u4F7F\u7528\u3057\u3066\u3001\u81EA\u5206\u304C\u3069\u3053\u306B\u3044\u308B\u304B\u3092\u78BA\u8A8D\u3059\u308B\u306E\u306B\u3082\u5F79\u7ACB\u3061\u307E\u3059\u3002\u4EA4\u63DB\u304C\u6709\u5229\u304B\u3069\u3046\u304B\u3092\u77E5\u308B\u3053\u3068\u3067\u3001\u6C7A\u5B9A\u3092\u4E0B\u3059\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u30C1\u30FC\u30C8\u3068\u898B\u306A\u3055\u308C\u308B\u53EF\u80FD\u6027\u304C\u3042\u308B\u305F\u3081\u3001\u6CE8\u610F\u3057\u3066\u4F7F\u7528\u3057\u3066\u304F\u3060\u3055\u3044\uFF01\u0022,pl:\u0022Bardzo przydatne na ko\u0144cu gry, ale mo\u017Ce by\u0107 r\u00F3wnie\u017C u\u017Cywane przez ca\u0142\u0105 gr\u0119, aby pom\u00F3c ci zobaczy\u0107, gdzie jeste\u015B. Mo\u017Ce pom\u00F3c ci w podejmowaniu decyzji, wiedz\u0105c, czy wymiana by\u0142aby korzystna na przyk\u0142ad. Mo\u017Ce by\u0107 uwa\u017Cane za oszustwo, u\u017Cywaj z ostro\u017Cno\u015Bci\u0105!\u0022,pt:\u0022Muito \u00FAtil no final do jogo, mas tamb\u00E9m pode ser usado durante todo o jogo para ajud\u00E1-lo a ver onde voc\u00EA est\u00E1. Pode ajud\u00E1-lo a tomar decis\u00F5es sabendo se uma troca seria favor\u00E1vel, por exemplo. Pode ser considerado trapa\u00E7a, use com cautela!\u0022,hr:\u0022Koristite pra\u0107enje bodova pobjede\u0022,cz:\u0022Very useful at the end of the game but can also be used throughout the game to help you see where you are at. It can help you make decisions by knowing if a trade would be favorable example. Could be considered cheating, use with caution!\u0022,sk:\u0022Very useful at the end of the game but can also be used throughout the game to help you see where you are at. It can help you make decisions by knowing if a trade would be favorable example. Could be considered cheating, use with caution!\u0022,gr:\u0022\u03A7\u03C1\u03AE\u03C3\u03B7 \u03C0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B7\u03C2 \u03BD\u03AF\u03BA\u03B7\u03C2\u0022,ru:\u0022\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0435\u043A\u0435\u0440\u0430 \u041E\u041F\u0022,ko:\u0022Very useful at the end of the game but can also be used throughout the game to help you see where you are at. It can help you make decisions by knowing if a trade would be favorable example. Could be considered cheating, use with caution!\u0022},mMe={en:\u0022Extra features for Warhammer: The Old World\u0022,fr:\u0022Fonctionnalit\u00E9s suppl\u00E9mentaires pour Warhammer : The Old World\u0022,es:\u0022Caracter\u00EDsticas adicionales para Warhammer: The Old World\u0022,cn:\u0022Warhammer: The Old World \u7684\u989D\u5916\u529F\u80FD\u0022,it:\u0022Funzionalit\u00E0 extra per Warhammer: The Old World\u0022,de:\u0022Zus\u00E4tzliche Funktionen f\u00FCr Warhammer: The Old World\u0022,ja:\u0022Warhammer: The Old World \u306E\u8FFD\u52A0\u6A5F\u80FD\u0022,pl:\u0022Dodatkowe funkcje dla Warhammer: The Old World\u0022,pt:\u0022Recursos extras para Warhammer: The Old World\u0022,hr:\u0022The Old World\u0022,cz:\u0022Extra features for Warhammer: The Old World\u0022,sk:\u0022Extra features for Warhammer: The Old World\u0022,gr:\u0022The Old World\u0022,ru:\u0022The Old World\u0022,ko:\u0022Extra features for Warhammer: The Old World\u0022},gMe={en:\u0022New Recruit supporters benefit from bonus exclusive features Extra features for Warhammer: The Old World.\u0022,fr:\u0022Les supporters de New Recruit b\u00E9n\u00E9ficient de fonctionnalit\u00E9s bonus exclusives pour Warhammer : The Old World.\u0022,es:\u0022Los seguidores de New Recruit se benefician de caracter\u00EDsticas exclusivas adicionales para Warhammer: The Old World.\u0022,cn:\u0022New Recruit \u652F\u6301\u8005\u53EF\u4EAB\u53D7 Warhammer: The Old World \u7684\u4E13\u5C5E\u989D\u5916\u529F\u80FD\u3002\u0022,it:\u0022I sostenitori di New Recruit beneficiano di funzionalit\u00E0 bonus esclusive per Warhammer: The Old World.\u0022,de:\u0022New Recruit-Unterst\u00FCtzer profitieren von exklusiven Bonus-Funktionen f\u00FCr Warhammer: The Old World.\u0022,ja:\u0022New Recruit \u30B5\u30DD\u30FC\u30BF\u30FC\u306F\u3001Warhammer: The Old World \u306E\u5C02\u7528\u30DC\u30FC\u30CA\u30B9\u6A5F\u80FD\u3092\u5229\u7528\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Wspieraj\u0105cy New Recruit korzystaj\u0105 z bonusowych ekskluzywnych funkcji dla Warhammer: The Old World.\u0022,pt:\u0022Os apoiadores do New Recruit se beneficiam de recursos b\u00F4nus exclusivos para Warhammer: The Old World.\u0022,hr:\u0022Pomo\u0107nik za igru The Old World\u0022,cz:\u0022New Recruit supporters benefit from bonus exclusive features Extra features for Warhammer: The Old World.\u0022,sk:\u0022New Recruit supporters benefit from bonus exclusive features Extra features for Warhammer: The Old World.\u0022,gr:\u0022\u0392\u03BF\u03B7\u03B8\u03CC\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03B3\u03B9\u03B1 The Old World\u0022,ru:\u0022\u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0434\u043B\u044F The Old World\u0022,ko:\u0022\uC0C8 Recruit supporters benefit from bonus exclusive features Extra features for Warhammer: The Old World.\u0022},yMe={en:\u0022Support New Recruit\u0022,fr:\u0022Soutenir New Recruit\u0022,es:\u0022Apoyar New Recruit\u0022,cn:\u0022\u652F\u6301 New Recruit\u0022,it:\u0022Sostieni New Recruit\u0022,de:\u0022Unterst\u00FCtze New Recruit\u0022,ja:\u0022New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u0022,pl:\u0022Wspieraj New Recruit\u0022,pt:\u0022Apoiar New Recruit\u0022,hr:\u0022Razine podr\u0161ke\u0022,cz:\u0022Support New Recruit\u0022,sk:\u0022Support New Recruit\u0022,gr:\u0022\u0395\u03C0\u03AF\u03C0\u03B5\u03B4\u03B1 \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7\u03C2\u0022,ru:\u0022\u0423\u0440\u043E\u0432\u043D\u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438\u0022,ko:\u0022Support New Recruit\u0022},wMe={en:\u0022New Recruit is free, and I would like most of New Recruit features to remain free for everyone.\u0022,fr:\u0022New Recruit est gratuit, et je souhaite que la plupart des fonctionnalit\u00E9s de New Recruit restent gratuites pour tous.\u0022,es:\u0022New Recruit es gratis, y me gustar\u00EDa que la mayor\u00EDa de las funciones de New Recruit permanezcan gratuitas para todos.\u0022,cn:\u0022New Recruit \u662F\u514D\u8D39\u7684\uFF0C\u6211\u5E0C\u671B\u5927\u591A\u6570 New Recruit \u529F\u80FD\u5BF9\u6240\u6709\u4EBA\u4FDD\u6301\u514D\u8D39\u3002\u0022,it:\u0022New Recruit \u00E8 gratuito e vorrei che la maggior parte delle funzionalit\u00E0 di New Recruit rimanessero gratuite per tutti.\u0022,de:\u0022New Recruit ist kostenlos, und ich m\u00F6chte, dass die meisten Funktionen von New Recruit f\u00FCr alle kostenlos bleiben.\u0022,ja:\u0022New Recruit \u306F\u7121\u6599\u3067\u3042\u308A\u3001New Recruit \u306E\u6A5F\u80FD\u306E\u307B\u3068\u3093\u3069\u3092\u3059\u3079\u3066\u306E\u4EBA\u306B\u7121\u6599\u3067\u63D0\u4F9B\u3057\u305F\u3044\u3068\u8003\u3048\u3066\u3044\u307E\u3059\u3002\u0022,pl:\u0022New Recruit jest darmowy i chcia\u0142bym, aby wi\u0119kszo\u015B\u0107 funkcji New Recruit pozosta\u0142a darmowa dla wszystkich.\u0022,pt:\u0022O New Recruit \u00E9 gratuito e gostaria que a maioria dos recursos do New Recruit permanecesse gratuita para todos.\u0022,hr:\u0022Besplatno\u0022,cz:\u0022New Recruit is free, and I would like most of New Recruit features to remain free for everyone.\u0022,sk:\u0022New Recruit is free, and I would like most of New Recruit features to remain free for everyone.\u0022,gr:\u0022\u0394\u03C9\u03C1\u03B5\u03AC\u03BD\u0022,ru:\u0022\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F\u0022,ko:\u0022\uC0C8 Recruit is free, and I would like most of New Recruit features to remain free for everyone.\u0022},bMe={en:\u0022Working on New Recruit is a \u003Cstrong\u003Efull time job\u003C/strong\u003E! New Recruit is ever improving with regular updates.\u0022,fr:\u0022Travailler sur New Recruit est un \u003Cstrong\u003Etravail \u00E0 temps plein\u003C/strong\u003E ! New Recruit s\u0027am\u00E9liore constamment avec des mises \u00E0 jour r\u00E9guli\u00E8res.\u0022,es:\u0022Trabajar en New Recruit es un \u003Cstrong\u003Etrabajo de tiempo completo\u003C/strong\u003E! New Recruit est\u00E1 en constante mejora con actualizaciones regulares.\u0022,cn:\u0022\u5F00\u53D1 New Recruit \u662F\u4E00\u9879\u003Cstrong\u003E\u5168\u804C\u5DE5\u4F5C\u003C/strong\u003E\uFF01New Recruit \u901A\u8FC7\u5B9A\u671F\u66F4\u65B0\u4E0D\u65AD\u6539\u8FDB\u3002\u0022,it:\u0022Lavorare su New Recruit \u00E8 un \u003Cstrong\u003Elavoro a tempo pieno\u003C/strong\u003E! New Recruit \u00E8 in continuo miglioramento con aggiornamenti regolari.\u0022,de:\u0022An New Recruit zu arbeiten ist ein \u003Cstrong\u003EVollzeitjob\u003C/strong\u003E! New Recruit wird st\u00E4ndig mit regelm\u00E4\u00DFigen Updates verbessert.\u0022,ja:\u0022New Recruit \u306E\u958B\u767A\u306F\u003Cstrong\u003E\u30D5\u30EB\u30BF\u30A4\u30E0\u306E\u4ED5\u4E8B\u003C/strong\u003E\u3067\u3059\uFF01New Recruit \u306F\u5B9A\u671F\u7684\u306A\u30A2\u30C3\u30D7\u30C7\u30FC\u30C8\u3067\u5E38\u306B\u6539\u5584\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u0022,pl:\u0022Praca nad New Recruit to \u003Cstrong\u003Epraca na pe\u0142ny etat\u003C/strong\u003E! New Recruit stale si\u0119 rozwija dzi\u0119ki regularnym aktualizacjom.\u0022,pt:\u0022Trabalhar no New Recruit \u00E9 um \u003Cstrong\u003Etrabalho em tempo integral\u003C/strong\u003E! O New Recruit est\u00E1 sempre melhorando com atualiza\u00E7\u00F5es regulares.\u0022,hr:\u0022Rad na New Recruit je \u003Cstrong\u003Epuno radno vrijeme\u003C/strong\u003E! New Recruit se stalno pobolj\u0161ava redovitim a\u017Euriranjima.\u0022,cz:\u0022Pr\u00E1ce na New Recruit je \u003Cstrong\u003Epr\u00E1ce na pln\u00FD \u00FAvazek\u003C/strong\u003E! New Recruit se neust\u00E1le zlep\u0161uje pravideln\u00FDmi aktualizacemi.\u0022,sk:\u0022Pr\u00E1ca na New Recruit je \u003Cstrong\u003Epr\u00E1ca na pln\u00FD \u00FAv\u00E4zok\u003C/strong\u003E! New Recruit sa neust\u00E1le zlep\u0161uje pravideln\u00FDmi aktualiz\u00E1ciami.\u0022,gr:\u0022\u0397 \u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C4\u03BF New Recruit \u03B5\u03AF\u03BD\u03B1\u03B9 \u003Cstrong\u003E\u03C0\u03BB\u03AE\u03C1\u03B7\u03C2 \u03B1\u03C0\u03B1\u03C3\u03C7\u03CC\u03BB\u03B7\u03C3\u03B7\u003C/strong\u003E! \u03A4\u03BF New Recruit \u03B2\u03B5\u03BB\u03C4\u03B9\u03CE\u03BD\u03B5\u03C4\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B5\u03C7\u03CE\u03C2 \u03BC\u03B5 \u03C4\u03B1\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03C3\u03B5\u03B9\u03C2.\u0022,ru:\u0022\u0420\u0430\u0431\u043E\u0442\u0430 \u043D\u0430\u0434 New Recruit \u2014 \u044D\u0442\u043E \u003Cstrong\u003E\u043F\u043E\u043B\u043D\u0430\u044F \u0437\u0430\u043D\u044F\u0442\u043E\u0441\u0442\u044C\u003C/strong\u003E! New Recruit \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442\u0441\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u043C \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F\u043C.\u0022,ko:\u0022New Recruit \uAC1C\uBC1C\uC740 \u003Cstrong\u003E\uC804\uC5C5\u003C/strong\u003E\uC785\uB2C8\uB2E4! New Recruit\uC740 \uC815\uAE30\uC801\uC778 \uC5C5\uB370\uC774\uD2B8\uB85C \uACC4\uC18D \uAC1C\uC120\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\u0022},vMe={en:\u0022Click here\u0022,fr:\u0022Cliquez ici\u0022,es:\u0022Haz clic aqu\u00ED\u0022,cn:\u0022\u70B9\u51FB\u8FD9\u91CC\u0022,it:\u0022Clicca qui\u0022,de:\u0022Hier klicken\u0022,ja:\u0022\u3053\u3053\u3092\u30AF\u30EA\u30C3\u30AF\u0022,pl:\u0022Kliknij tutaj\u0022,pt:\u0022Clique aqui\u0022,hr:\u0022Kliknite ovdje\u0022,cz:\u0022Click here\u0022,sk:\u0022Click here\u0022,gr:\u0022\u039A\u03AC\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B9\u03BA \u03B5\u03B4\u03CE\u0022,ru:\u0022\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0437\u0434\u0435\u0441\u044C\u0022,ko:\u0022Click here\u0022},kMe={en:\u0022to display an overview of the\u0022,fr:\u0022pour afficher un aper\u00E7u des\u0022,es:\u0022para mostrar una descripci\u00F3n general de las\u0022,cn:\u0022\u4EE5\u663E\u793A\u0022,it:\u0022per visualizzare una panoramica delle\u0022,de:\u0022um eine \u00DCbersicht der\u0022,ja:\u0022\u306E\u6982\u8981\u3092\u8868\u793A\u3059\u308B\u306B\u306F\u0022,pl:\u0022aby wy\u015Bwietli\u0107 przegl\u0105d\u0022,pt:\u0022para exibir uma vis\u00E3o geral dos\u0022,hr:\u0022Pregled bonus zna\u010Dajki\u0022,cz:\u0022to display an overview of the\u0022,sk:\u0022to display an overview of the\u0022,gr:\u0022\u0395\u03C0\u03B9\u03C3\u03BA\u03CC\u03C0\u03B7\u03C3\u03B7 \u03BC\u03C0\u03CC\u03BD\u03BF\u03C5\u03C2\u0022,ru:\u0022\u041E\u0431\u0437\u043E\u0440 \u0431\u043E\u043D\u0443\u0441\u043E\u0432\u0022,ko:\u0022to display an overview of the\u0022},BMe={en:\u0022New Recruit Bonus Features\u0022,fr:\u0022Fonctionnalit\u00E9s Bonus de New Recruit\u0022,es:\u0022Caracter\u00EDsticas Adicionales de New Recruit\u0022,cn:\u0022New Recruit \u989D\u5916\u529F\u80FD\u0022,it:\u0022Funzionalit\u00E0 Bonus di New Recruit\u0022,de:\u0022New Recruit Bonus-Funktionen\u0022,ja:\u0022New Recruit \u30DC\u30FC\u30CA\u30B9\u6A5F\u80FD\u0022,pl:\u0022Funkcje Bonusowe New Recruit\u0022,pt:\u0022Recursos B\u00F4nus do New Recruit\u0022,hr:\u0022Bonus zna\u010Dajke\u0022,cz:\u0022New Recruit Bonus Features\u0022,sk:\u0022New Recruit Bonus Features\u0022,gr:\u0022\u03A7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC \u03BC\u03C0\u03CC\u03BD\u03BF\u03C5\u03C2\u0022,ru:\u0022\u0411\u043E\u043D\u0443\u0441\u043D\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438\u0022,ko:\u0022\uC0C8 Recruit Bonus Features\u0022},CMe={en:\u0022All subscription levels unlock the same bonus features. Higher levels get a \u003Cstrong\u003Especial Discord status\u003C/strong\u003E\u0022,fr:\u0022Tous les niveaux d\u0027abonnement d\u00E9bloquent les m\u00EAmes fonctionnalit\u00E9s bonus. Les niveaux sup\u00E9rieurs obtiennent un \u003Cstrong\u003Estatut Discord sp\u00E9cial\u003C/strong\u003E\u0022,es:\u0022Todos los niveles de suscripci\u00F3n desbloquean las mismas caracter\u00EDsticas bonus. Los niveles superiores obtienen un \u003Cstrong\u003Eestado especial de Discord\u003C/strong\u003E\u0022,cn:\u0022\u6240\u6709\u8BA2\u9605\u7EA7\u522B\u90FD\u89E3\u9501\u76F8\u540C\u7684\u989D\u5916\u529F\u80FD\u3002\u66F4\u9AD8\u7EA7\u522B\u53EF\u83B7\u5F97\u003Cstrong\u003E\u7279\u6B8A\u7684 Discord \u72B6\u6001\u003C/strong\u003E\u0022,it:\u0022Tutti i livelli di abbonamento sbloccano le stesse funzionalit\u00E0 bonus. I livelli superiori ottengono uno \u003Cstrong\u003Estato Discord speciale\u003C/strong\u003E\u0022,de:\u0022Alle Abonnementstufen schalten die gleichen Bonus-Funktionen frei. H\u00F6here Stufen erhalten einen \u003Cstrong\u003Espeziellen Discord-Status\u003C/strong\u003E\u0022,ja:\u0022\u3059\u3079\u3066\u306E\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u30EC\u30D9\u30EB\u3067\u540C\u3058\u30DC\u30FC\u30CA\u30B9\u6A5F\u80FD\u304C\u30A2\u30F3\u30ED\u30C3\u30AF\u3055\u308C\u307E\u3059\u3002\u4E0A\u4F4D\u30EC\u30D9\u30EB\u306B\u306F\u003Cstrong\u003E\u7279\u5225\u306A Discord \u30B9\u30C6\u30FC\u30BF\u30B9\u003C/strong\u003E\u304C\u4ED8\u4E0E\u3055\u308C\u307E\u3059\u0022,pl:\u0022Wszystkie poziomy subskrypcji odblokowuj\u0105 te same funkcje bonusowe. Wy\u017Csze poziomy otrzymuj\u0105 \u003Cstrong\u003Especjalny status Discord\u003C/strong\u003E\u0022,pt:\u0022Todos os n\u00EDveis de assinatura desbloqueiam os mesmos recursos b\u00F4nus. N\u00EDveis superiores recebem um \u003Cstrong\u003Estatus especial no Discord\u003C/strong\u003E\u0022,hr:\u0022Sve razine pretplate otklju\u010Davaju iste bonus zna\u010Dajke. Vi\u0161e razine dobivaju \u003Cstrong\u003Eposeban Discord status\u003C/strong\u003E\u0022,cz:\u0022V\u0161echny \u00FArovn\u011B p\u0159edplatn\u00E9ho odemykaj\u00ED stejn\u00E9 bonusov\u00E9 funkce. Vy\u0161\u0161\u00ED \u00FArovn\u011B z\u00EDsk\u00E1vaj\u00ED \u003Cstrong\u003Especi\u00E1ln\u00ED Discord status\u003C/strong\u003E\u0022,sk:\u0022V\u0161etky \u00FArovne predplatn\u00E9ho odomykaj\u00FA rovnak\u00E9 bonusov\u00E9 funkcie. Vy\u0161\u0161ie \u00FArovne z\u00EDskavaj\u00FA \u003Cstrong\u003E\u0161peci\u00E1lny Discord status\u003C/strong\u003E\u0022,gr:\u0022\u038C\u03BB\u03B1 \u03C4\u03B1 \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03B1 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2 \u03BE\u03B5\u03BA\u03BB\u03B5\u03B9\u03B4\u03CE\u03BD\u03BF\u03C5\u03BD \u03C4\u03B9\u03C2 \u03AF\u03B4\u03B9\u03B5\u03C2 bonus \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B5\u03C2. \u03A4\u03B1 \u03C5\u03C8\u03B7\u03BB\u03CC\u03C4\u03B5\u03C1\u03B1 \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03B1 \u03B1\u03C0\u03BF\u03BA\u03C4\u03BF\u03CD\u03BD \u003Cstrong\u003E\u03B5\u03B9\u03B4\u03B9\u03BA\u03CC Discord status\u003C/strong\u003E\u0022,ru:\u0022\u0412\u0441\u0435 \u0443\u0440\u043E\u0432\u043D\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u043D\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438. \u0411\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0443\u0440\u043E\u0432\u043D\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u003Cstrong\u003E\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 Discord \u0441\u0442\u0430\u0442\u0443\u0441\u003C/strong\u003E\u0022,ko:\u0022\uBAA8\uB4E0 \uAD6C\uB3C5 \uB808\uBCA8\uC740 \uB3D9\uC77C\uD55C \uBCF4\uB108\uC2A4 \uAE30\uB2A5\uC744 \uC7A0\uAE08 \uD574\uC81C\uD569\uB2C8\uB2E4. \uB192\uC740 \uB808\uBCA8\uC740 \u003Cstrong\u003E\uD2B9\uBCC4\uD55C Discord \uC0C1\uD0DC\u003C/strong\u003E\uB97C \uBC1B\uC2B5\uB2C8\uB2E4\u0022},_Me={en:\u0022You can chose to help me more if you select levels 2 or 3 but there is no additional benefit to it compared to support level 1, other than bragging rights on Discord :)\u0022,fr:\u0022Vous pouvez choisir de m\u0027aider davantage si vous s\u00E9lectionnez les niveaux 2 ou 3, mais il n\u0027y a aucun avantage suppl\u00E9mentaire par rapport au niveau de support 1, \u00E0 part les droits de vantardise sur Discord :)\u0022,es:\u0022Puedes elegir ayudarme m\u00E1s si seleccionas los niveles 2 o 3, pero no hay ning\u00FAn beneficio adicional en comparaci\u00F3n con el nivel de apoyo 1, aparte de los derechos de presumir en Discord :)\u0022,cn:\u0022\u5982\u679C\u60A8\u9009\u62E9\u7B49\u7EA7 2 \u6216 3\uFF0C\u60A8\u53EF\u4EE5\u9009\u62E9\u5E2E\u52A9\u6211\u66F4\u591A\uFF0C\u4F46\u4E0E\u652F\u6301\u7B49\u7EA7 1 \u76F8\u6BD4\uFF0C\u9664\u4E86\u5728 Discord \u4E0A\u7684\u5439\u5618\u6743\u5916\uFF0C\u6CA1\u6709\u989D\u5916\u7684\u597D\u5904 :)\u0022,it:\u0022Puoi scegliere di aiutarmi di pi\u00F9 se selezioni i livelli 2 o 3, ma non c\u0027\u00E8 alcun beneficio aggiuntivo rispetto al livello di supporto 1, a parte i diritti di vanto su Discord :)\u0022,de:\u0022Sie k\u00F6nnen sich daf\u00FCr entscheiden, mir mehr zu helfen, wenn Sie die Stufen 2 oder 3 ausw\u00E4hlen, aber es gibt keinen zus\u00E4tzlichen Vorteil im Vergleich zur Unterst\u00FCtzungsstufe 1, au\u00DFer Prahlrechten auf Discord :)\u0022,ja:\u0022\u30EC\u30D9\u30EB 2 \u307E\u305F\u306F 3 \u3092\u9078\u629E\u3059\u308B\u3068\u3001\u79C1\u3092\u3055\u3089\u306B\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u3053\u3068\u3092\u9078\u629E\u3067\u304D\u307E\u3059\u304C\u3001\u30B5\u30DD\u30FC\u30C8\u30EC\u30D9\u30EB 1 \u3068\u6BD4\u8F03\u3057\u3066\u8FFD\u52A0\u306E\u5229\u70B9\u306F\u3042\u308A\u307E\u305B\u3093\u3002Discord \u3067\u306E\u81EA\u6162\u306E\u6A29\u5229\u4EE5\u5916\u306F :)\u0022,pl:\u0022Mo\u017Cesz zdecydowa\u0107 si\u0119 na wi\u0119ksz\u0105 pomoc, je\u015Bli wybierzesz poziomy 2 lub 3, ale nie ma \u017Cadnych dodatkowych korzy\u015Bci w por\u00F3wnaniu z poziomem wsparcia 1, poza prawami do chwalenia si\u0119 na Discordzie :)\u0022,pt:\u0022Voc\u00EA pode optar por me ajudar mais se selecionar os n\u00EDveis 2 ou 3, mas n\u00E3o h\u00E1 nenhum benef\u00EDcio adicional em compara\u00E7\u00E3o ao n\u00EDvel de suporte 1, al\u00E9m dos direitos de se gabar no Discord :)\u0022,hr:\u0022Pomozite vi\u0161e\u0022,cz:\u0022You can chose to help me more if you select levels 2 or 3 but there is no additional benefit to it compared to support level 1, other than bragging rights on Discord :)\u0022,sk:\u0022You can chose to help me more if you select levels 2 or 3 but there is no additional benefit to it compared to support level 1, other than bragging rights on Discord :)\u0022,gr:\u0022\u0392\u03BF\u03B7\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03BF\u0022,ru:\u0022\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435\u0022,ko:\u0022You can chose to help me more if you select levels 2 or 3 but there is no additional benefit to it compared to support level 1, other than bragging rights on Discord :)\u0022},SMe={en:\u0022Account Creation\u0022,fr:\u0022Cr\u00E9ation de compte\u0022,es:\u0022Creaci\u00F3n de cuenta\u0022,cn:\u0022\u521B\u5EFA\u8D26\u6237\u0022,it:\u0022Creazione account\u0022,de:\u0022Kontoerstellung\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u4F5C\u6210\u0022,pl:\u0022Tworzenie konta\u0022,pt:\u0022Cria\u00E7\u00E3o de conta\u0022,hr:\u0022Kreiranje ra\u010Duna\u0022,cz:\u0022Account Creation\u0022,sk:\u0022Account Creation\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438\u0022,ko:\u0022Account Creation\u0022},EMe={en:\u0022To support New Recruit and access the new features, you need to create a New Recruit Account first, it takes 30 seconds to create and it is free.\u0022,fr:\u0022Pour soutenir New Recruit et acc\u00E9der aux nouvelles fonctionnalit\u00E9s, vous devez d\u0027abord cr\u00E9er un compte New Recruit, cela prend 30 secondes et c\u0027est gratuit.\u0022,es:\u0022Para apoyar a New Recruit y acceder a las nuevas funciones, primero debes crear una cuenta de New Recruit, tarda 30 segundos en crearse y es gratis.\u0022,cn:\u0022\u8981\u652F\u6301 New Recruit \u5E76\u8BBF\u95EE\u65B0\u529F\u80FD\uFF0C\u60A8\u9700\u8981\u5148\u521B\u5EFA\u4E00\u4E2A New Recruit \u8D26\u6237\uFF0C\u53EA\u9700 30 \u79D2\u5373\u53EF\u521B\u5EFA\uFF0C\u800C\u4E14\u662F\u514D\u8D39\u7684\u3002\u0022,it:\u0022Per sostenere New Recruit e accedere alle nuove funzionalit\u00E0, devi prima creare un account New Recruit, ci vogliono 30 secondi per crearlo ed \u00E8 gratuito.\u0022,de:\u0022Um New Recruit zu unterst\u00FCtzen und auf die neuen Funktionen zuzugreifen, m\u00FCssen Sie zun\u00E4chst ein New Recruit-Konto erstellen. Die Erstellung dauert 30 Sekunden und ist kostenlos.\u0022,ja:\u0022New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u65B0\u6A5F\u80FD\u306B\u30A2\u30AF\u30BB\u30B9\u3059\u308B\u306B\u306F\u3001\u307E\u305A New Recruit \u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u4F5C\u6210\u306B\u306F 30 \u79D2\u304B\u304B\u308A\u3001\u7121\u6599\u3067\u3059\u3002\u0022,pl:\u0022Aby wspiera\u0107 New Recruit i uzyska\u0107 dost\u0119p do nowych funkcji, musisz najpierw utworzy\u0107 konto New Recruit, zajmuje to 30 sekund i jest darmowe.\u0022,pt:\u0022Para apoiar o New Recruit e acessar os novos recursos, voc\u00EA precisa criar uma conta New Recruit primeiro, leva 30 segundos para criar e \u00E9 gratuito.\u0022,hr:\u0022Trebate ra\u010Dun\u0022,cz:\u0022To support New Recruit and access the new features, you need to create a New Recruit Account first, it takes 30 seconds to create and it is free.\u0022,sk:\u0022To support New Recruit and access the new features, you need to create a New Recruit Account first, it takes 30 seconds to create and it is free.\u0022,gr:\u0022\u03A7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C3\u03C4\u03B5 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u0022,ru:\u0022\u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430 \u0443\u0447\u0435\u0442\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C\u0022,ko:\u0022To support New Recruit and access the new features, you need to create a New Recruit Account first, it takes 30 seconds to create and it is free.\u0022},jMe={en:\u0022Create an Account\u0022,fr:\u0022Cr\u00E9er un compte\u0022,es:\u0022Crear una cuenta\u0022,cn:\u0022\u521B\u5EFA\u8D26\u6237\u0022,it:\u0022Crea un account\u0022,de:\u0022Konto erstellen\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u0022,pl:\u0022Utw\u00F3rz konto\u0022,pt:\u0022Criar uma conta\u0022,hr:\u0022Kreirajte ra\u010Dun\u0022,cz:\u0022Create an Account\u0022,sk:\u0022Create an Account\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0442\u044C an \u0410\u043A\u043A\u0430\u0443\u043D\u0442\u0022,ko:\u0022an Account \uC0DD\uC131\u0022},zMe={en:\u0022Sub level\u0022,fr:\u0022Niveau d\u0027abonnement\u0022,es:\u0022Nivel de suscripci\u00F3n\u0022,cn:\u0022\u8BA2\u9605\u7EA7\u522B\u0022,it:\u0022Livello di abbonamento\u0022,de:\u0022Abonnementstufe\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u30EC\u30D9\u30EB\u0022,pl:\u0022Poziom subskrypcji\u0022,pt:\u0022N\u00EDvel de assinatura\u0022,hr:\u0022Razina pretplate\u0022,cz:\u0022Sub level\u0022,sk:\u0022Sub level\u0022,gr:\u0022\u0395\u03C0\u03AF\u03C0\u03B5\u03B4\u03BF \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2\u0022,ru:\u0022\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022Sub level\u0022},IMe={en:\u0022per\u0022,fr:\u0022par\u0022,es:\u0022por\u0022,cn:\u0022\u6BCF\u0022,it:\u0022per\u0022,de:\u0022pro\u0022,ja:\u0022\u3042\u305F\u308A\u0022,pl:\u0022za\u0022,pt:\u0022por\u0022,hr:\u0022per\u0022,cz:\u0022per\u0022,sk:\u0022per\u0022,gr:\u0022per\u0022,ru:\u0022\u0437\u0430\u0022,ko:\u0022per\u0022},PMe={en:\u0022for 1\u0022,fr:\u0022pour 1\u0022,es:\u0022por 1\u0022,cn:\u00221\u0022,it:\u0022per 1\u0022,de:\u0022f\u00FCr 1\u0022,ja:\u00221\u0022,pl:\u0022za 1\u0022,pt:\u0022por 1\u0022,hr:\u0022for 1\u0022,cz:\u0022for 1\u0022,sk:\u0022for 1\u0022,gr:\u0022for 1\u0022,ru:\u0022\u043D\u0430 1\u0022,ko:\u0022for 1\u0022},TMe={en:\u0022month\u0022,fr:\u0022mois\u0022,es:\u0022mes\u0022,cn:\u0022\u6708\u0022,it:\u0022mese\u0022,de:\u0022Monat\u0022,ja:\u0022\u304B\u6708\u0022,pl:\u0022miesi\u0105c\u0022,pt:\u0022m\u00EAs\u0022,hr:\u0022Mjesec\u0022,cz:\u0022month\u0022,sk:\u0022month\u0022,gr:\u0022\u039C\u03AE\u03BD\u03B1\u03C2\u0022,ru:\u0022\u041C\u0435\u0441\u044F\u0446\u0022,ko:\u0022month\u0022},NMe={en:\u0022year\u0022,fr:\u0022an\u0022,es:\u0022a\u00F1o\u0022,cn:\u0022\u5E74\u0022,it:\u0022anno\u0022,de:\u0022Jahr\u0022,ja:\u0022\u5E74\u0022,pl:\u0022rok\u0022,pt:\u0022ano\u0022,hr:\u0022Godina\u0022,cz:\u0022year\u0022,sk:\u0022year\u0022,gr:\u0022\u0388\u03C4\u03BF\u03C2\u0022,ru:\u0022\u0413\u043E\u0434\u0022,ko:\u0022year\u0022},FMe={en:\u0022Please select your country\u0022,fr:\u0022Veuillez s\u00E9lectionner votre pays\u0022,es:\u0022Por favor selecciona tu pa\u00EDs\u0022,cn:\u0022\u8BF7\u9009\u62E9\u60A8\u7684\u56FD\u5BB6\u0022,it:\u0022Seleziona il tuo paese\u0022,de:\u0022Bitte w\u00E4hlen Sie Ihr Land\u0022,ja:\u0022\u56FD\u3092\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u0022,pl:\u0022Wybierz sw\u00F3j kraj\u0022,pt:\u0022Por favor, selecione seu pa\u00EDs\u0022,hr:\u0022Odaberite dr\u017Eavu\u0022,cz:\u0022Please select your country\u0022,sk:\u0022Please select your country\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C7\u03CE\u03C1\u03B1\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043D\u0443\u0022,ko:\u0022Please select your country\u0022},RMe={en:\u0022-- Select a country --\u0022,fr:\u0022-- S\u00E9lectionnez un pays --\u0022,es:\u0022-- Selecciona un pa\u00EDs --\u0022,cn:\u0022-- \u9009\u62E9\u4E00\u4E2A\u56FD\u5BB6 --\u0022,it:\u0022-- Seleziona un paese --\u0022,de:\u0022-- W\u00E4hlen Sie ein Land --\u0022,ja:\u0022-- \u56FD\u3092\u9078\u629E --\u0022,pl:\u0022-- Wybierz kraj --\u0022,pt:\u0022-- Selecione um pa\u00EDs --\u0022,hr:\u0022Odaberite svoju dr\u017Eavu\u0022,cz:\u0022-- Select a country --\u0022,sk:\u0022-- Select a country --\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03B7 \u03C7\u03CE\u03C1\u03B1 \u03C3\u03B1\u03C2\u0022,ru:\u0022-- \u0412\u044B\u0431\u0440\u0430\u0442\u044C a \u0421\u0442\u0440\u0430\u043D\u0430 --\u0022,ko:\u0022-- Select a country --\u0022},MMe={en:\u0022Total (tax included):\u0022,fr:\u0022Total (taxes incluses) :\u0022,es:\u0022Total (impuestos incluidos):\u0022,cn:\u0022\u603B\u8BA1\uFF08\u542B\u7A0E\uFF09\uFF1A\u0022,it:\u0022Totale (tasse incluse):\u0022,de:\u0022Gesamt (inkl. Steuern):\u0022,ja:\u0022\u5408\u8A08\uFF08\u7A0E\u8FBC\uFF09\uFF1A\u0022,pl:\u0022Razem (podatki wliczone):\u0022,pt:\u0022Total (impostos inclu\u00EDdos):\u0022,hr:\u0022Ukupno s porezom\u0022,cz:\u0022Total (tax included):\u0022,sk:\u0022Total (tax included):\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03BF\u03BB\u03BF \u03BC\u03B5 \u03C6\u03CC\u03C1\u03BF\u0022,ru:\u0022\u0418\u0442\u043E\u0433\u043E \u0441 \u043D\u0430\u043B\u043E\u0433\u043E\u043C\u0022,ko:\u0022Total (tax included):\u0022},UMe={en:\u0022Options\u0022,fr:\u0022Options\u0022,es:\u0022Opciones\u0022,cn:\u0022\u9009\u9879\u0022,it:\u0022Opzioni\u0022,de:\u0022Optionen\u0022,ja:\u0022\u30AA\u30D7\u30B7\u30E7\u30F3\u0022,pl:\u0022Opcje\u0022,pt:\u0022Op\u00E7\u00F5es\u0022,hr:\u0022Opcije\u0022,cz:\u0022Options\u0022,sk:\u0022Mo\u017Enosti\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2\u0022,ru:\u0022\u041E\u043F\u0446\u0438\u0438\u0022,ko:\u0022\uC635\uC158\u0022},xMe={en:\u0027If you want to use \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, please select \u0022sub for 1 year\u0022, and do NOT select renew my Sub automatically. New Recruit may support Paypal subscriptions in the future.\u0027,fr:\u0060Si vous souhaitez utiliser \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, veuillez s\u00E9lectionner \u0022abonnement pour 1 an\u0022 et ne PAS s\u00E9lectionner renouveler automatiquement mon abonnement. New Recruit pourrait prendre en charge les abonnements Paypal \u00E0 l\u0027avenir.\u0060,es:\u0027Si deseas usar \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, por favor selecciona \u0022suscripci\u00F3n por 1 a\u00F1o\u0022 y NO selecciones renovar mi suscripci\u00F3n autom\u00E1ticamente. New Recruit podr\u00EDa admitir suscripciones de Paypal en el futuro.\u0027,cn:\u0027\u5982\u679C\u60A8\u60F3\u4F7F\u7528 \u003Cimg src=\\\\\u0022/assets/icons/paypal_small.png\\\\\u0022 /\u003E\uFF0C\u8BF7\u9009\u62E9\\\\\u0022\u8BA2\u9605 1 \u5E74\\\\\u0022\uFF0C\u4E0D\u8981\u9009\u62E9\u81EA\u52A8\u7EED\u8BA2\u6211\u7684\u8BA2\u9605\u3002New Recruit \u5C06\u6765\u53EF\u80FD\u652F\u6301 Paypal \u8BA2\u9605\u3002\u0027,it:\u0027Se vuoi usare \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, seleziona \u0022abbonamento per 1 anno\u0022 e NON selezionare rinnova automaticamente il mio abbonamento. New Recruit potrebbe supportare gli abbonamenti Paypal in futuro.\u0027,de:\u0027Wenn Sie \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E verwenden m\u00F6chten, w\u00E4hlen Sie bitte \u0022Abonnement f\u00FCr 1 Jahr\u0022 und w\u00E4hlen Sie NICHT automatisch mein Abonnement erneuern. New Recruit k\u00F6nnte in Zukunft Paypal-Abonnements unterst\u00FCtzen.\u0027,ja:\u0027\u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E \u3092\u4F7F\u7528\u3057\u305F\u3044\u5834\u5408\u306F\u3001\u300C1\u5E74\u9593\u306E\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u300D\u3092\u9078\u629E\u3057\u3001\u81EA\u52D5\u7684\u306B\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u66F4\u65B0\u3059\u308B\u3053\u3068\u3092\u9078\u629E\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002New Recruit \u306F\u5C06\u6765 Paypal \u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\u0027,pl:\u0027Je\u015Bli chcesz u\u017Cy\u0107 \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, wybierz \u0022subskrypcja na 1 rok\u0022 i NIE wybieraj automatycznego odnawiania mojej subskrypcji. New Recruit mo\u017Ce wspiera\u0107 subskrypcje Paypal w przysz\u0142o\u015Bci.\u0027,pt:\u0027Se voc\u00EA quiser usar \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, selecione \u0022assinatura por 1 ano\u0022 e N\u00C3O selecione renovar minha assinatura automaticamente. O New Recruit pode oferecer suporte a assinaturas Paypal no futuro.\u0027,hr:\u0022Pla\u0107anje putem PayPal\u0022,cz:\u0027If you want to use \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, please select \u0022sub for 1 year\u0022, and do NOT select renew my Sub automatically. New Recruit may support Paypal subscriptions in the future.\u0027,sk:\u0027If you want to use \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, please select \u0022sub for 1 year\u0022, and do NOT select renew my Sub automatically. New Recruit may support Paypal subscriptions in the future.\u0027,gr:\u0022\u03A0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2 PayPal\u0022,ru:\u0022\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E PayPal\u0022,ko:\u0027If you want to use \u003Cimg src=\u0022/assets/icons/paypal_small.png\u0022 /\u003E, please select \u0022sub for 1 year\u0022, and do NOT select renew my Sub automatically. New Recruit may support Paypal subscriptions in the future.\u0027},QMe={en:\u0022Sub for 1 year (2 months free)\u0022,fr:\u0022Abonnement pour 1 an (2 mois offerts)\u0022,es:\u0022Suscripci\u00F3n por 1 a\u00F1o (2 meses gratis)\u0022,cn:\u0022\u8BA2\u9605 1 \u5E74\uFF082 \u4E2A\u6708\u514D\u8D39\uFF09\u0022,it:\u0022Abbonamento per 1 anno (2 mesi gratis)\u0022,de:\u0022Abonnement f\u00FCr 1 Jahr (2 Monate kostenlos)\u0022,ja:\u00221\u5E74\u9593\u306E\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\uFF082\u304B\u6708\u7121\u6599\uFF09\u0022,pl:\u0022Subskrypcja na 1 rok (2 miesi\u0105ce gratis)\u0022,pt:\u0022Assinatura por 1 ano (2 meses gr\u00E1tis)\u0022,hr:\u0022Pretplata na 1 godinu (2 mjeseca besplatno)\u0022,cz:\u0022P\u0159edplatn\u00E9 na 1 rok (2 m\u011Bs\u00EDce zdarma)\u0022,sk:\u0022Predplatn\u00E9 na 1 rok (2 mesiace zadarmo)\u0022,gr:\u0022\u03A3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03B3\u03B9\u03B1 1 \u03C7\u03C1\u03CC\u03BD\u03BF (2 \u03BC\u03AE\u03BD\u03B5\u03C2 \u03B4\u03C9\u03C1\u03B5\u03AC\u03BD)\u0022,ru:\u0022\u041F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u043D\u0430 1 \u0433\u043E\u0434 (2 \u043C\u0435\u0441\u044F\u0446\u0430 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E)\u0022,ko:\u00221\uB144 \uAD6C\uB3C5 (2\uAC1C\uC6D4 \uBB34\uB8CC)\u0022},LMe={en:\u0022most popular, required for Paypal payments\u0022,fr:\u0022le plus populaire, requis pour les paiements Paypal\u0022,es:\u0022m\u00E1s popular, requerido para pagos con Paypal\u0022,cn:\u0022\u6700\u53D7\u6B22\u8FCE\uFF0CPaypal \u652F\u4ED8\u5FC5\u9700\u0022,it:\u0022pi\u00F9 popolare, richiesto per i pagamenti Paypal\u0022,de:\u0022am beliebtesten, erforderlich f\u00FCr Paypal-Zahlungen\u0022,ja:\u0022\u6700\u3082\u4EBA\u6C17\u3001Paypal\u652F\u6255\u3044\u306B\u5FC5\u8981\u0022,pl:\u0022najpopularniejszy, wymagany dla p\u0142atno\u015Bci Paypal\u0022,pt:\u0022mais popular, necess\u00E1rio para pagamentos Paypal\u0022,hr:\u0022najpopularnije, potrebno za Paypal pla\u0107anja\u0022,cz:\u0022nejpopul\u00E1rn\u011Bj\u0161\u00ED, vy\u017Eadov\u00E1no pro platby Paypal\u0022,sk:\u0022najpopul\u00E1rnej\u0161ie, vy\u017Eadovan\u00E9 pre platby Paypal\u0022,gr:\u0022\u03C0\u03B9\u03BF \u03B4\u03B7\u03BC\u03BF\u03C6\u03B9\u03BB\u03AD\u03C2, \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B3\u03B9\u03B1 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03C2 Paypal\u0022,ru:\u0022\u0441\u0430\u043C\u044B\u0439 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u0439, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439 Paypal\u0022,ko:\u0022\uAC00\uC7A5 \uC778\uAE30, Paypal \uACB0\uC81C\uC5D0 \uD544\uC694\u0022},DMe={en:\u0022recommended\u0022,fr:\u0022recommand\u00E9\u0022,es:\u0022recomendado\u0022,cn:\u0022\u63A8\u8350\u0022,it:\u0022consigliato\u0022,de:\u0022empfohlen\u0022,ja:\u0022\u304A\u3059\u3059\u3081\u0022,pl:\u0022zalecane\u0022,pt:\u0022recomendado\u0022,hr:\u0022preporu\u010Deno\u0022,cz:\u0022doporu\u010Deno\u0022,sk:\u0022odpor\u00FA\u010Dan\u00E9\u0022,gr:\u0022\u03C3\u03C5\u03BD\u03B9\u03C3\u03C4\u03AC\u03C4\u03B1\u03B9\u0022,ru:\u0022\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F\u0022,ko:\u0022\uCD94\uCC9C\u0022},OMe={en:\u0022Renew my Sub automatically\u0022,fr:\u0022Renouveler mon abonnement automatiquement\u0022,es:\u0022Renovar mi suscripci\u00F3n autom\u00E1ticamente\u0022,cn:\u0022\u81EA\u52A8\u7EED\u8BA2\u6211\u7684\u8BA2\u9605\u0022,it:\u0022Rinnova automaticamente il mio abbonamento\u0022,de:\u0022Mein Abo automatisch erneuern\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u81EA\u52D5\u66F4\u65B0\u0022,pl:\u0022Automatycznie odnawiaj moj\u0105 subskrypcj\u0119\u0022,pt:\u0022Renovar minha assinatura automaticamente\u0022,hr:\u0022Automatski obnovi moju pretplatu\u0022,cz:\u0022Automaticky obnovovat m\u00E9 p\u0159edplatn\u00E9\u0022,sk:\u0022Automaticky obnovova\u0165 moje predplatn\u00E9\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03B1\u03BD\u03B1\u03BD\u03AD\u03C9\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2 \u03BC\u03BF\u03C5\u0022,ru:\u0022\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0442\u044C \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443\u0022,ko:\u0022\uB0B4 \uAD6C\uB3C5 \uC790\uB3D9 \uAC31\uC2E0\u0022},HMe={en:\u0022cancel anytime in 2 clicks\u0022,fr:\u0022annuler \u00E0 tout moment en 2 clics\u0022,es:\u0022cancelar en cualquier momento en 2 clics\u0022,cn:\u0022\u968F\u65F6 2 \u6B21\u70B9\u51FB\u5373\u53EF\u53D6\u6D88\u0022,it:\u0022annulla in qualsiasi momento con 2 clic\u0022,de:\u0022jederzeit mit 2 Klicks k\u00FCndigen\u0022,ja:\u0022\u3044\u3064\u3067\u30822\u30AF\u30EA\u30C3\u30AF\u3067\u30AD\u30E3\u30F3\u30BB\u30EB\u0022,pl:\u0022anuluj w dowolnym momencie 2 klikni\u0119ciami\u0022,pt:\u0022cancele a qualquer momento em 2 cliques\u0022,hr:\u0022otka\u017Ei bilo kada u 2 klika\u0022,cz:\u0022zru\u0161it kdykoli 2 kliknut\u00EDmi\u0022,sk:\u0022zru\u0161i\u0165 kedyko\u013Evek 2 kliknutiami\u0022,gr:\u0022\u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 \u03B1\u03BD\u03AC \u03C0\u03AC\u03C3\u03B1 \u03C3\u03C4\u03B9\u03B3\u03BC\u03AE \u03BC\u03B5 2 \u03BA\u03BB\u03B9\u03BA\u0022,ru:\u0022\u043E\u0442\u043C\u0435\u043D\u0430 \u0432 \u043B\u044E\u0431\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0437\u0430 2 \u043A\u043B\u0438\u043A\u0430\u0022,ko:\u0022\uC5B8\uC81C\uB4E0\uC9C0 2\uBC88 \uD074\uB9AD\uC73C\uB85C \uCDE8\uC18C\u0022},GMe={en:\u0022Support New Recruit\u0022,fr:\u0022Soutenir New Recruit\u0022,es:\u0022Apoyar New Recruit\u0022,cn:\u0022\u652F\u6301 New Recruit\u0022,it:\u0022Sostieni New Recruit\u0022,de:\u0022Unterst\u00FCtze New Recruit\u0022,ja:\u0022New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u0022,pl:\u0022Wspieraj New Recruit\u0022,pt:\u0022Apoiar New Recruit\u0022,hr:\u0022Podr\u017Ei New Recruit\u0022,cz:\u0022Support New Recruit\u0022,sk:\u0022Support New Recruit\u0022,gr:\u0022\u039A\u03BF\u03C5\u03BC\u03C0\u03AF \u03C5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7\u03C2\u0022,ru:\u0022\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0022,ko:\u0022Support New Recruit\u0022},VMe={en:\u0022Thank you, but you must be online to support New Recruit!\u0022,fr:\u0022Merci, mais vous devez \u00EAtre en ligne pour soutenir New Recruit !\u0022,es:\u0022\u00A1Gracias, pero debes estar en l\u00EDnea para apoyar a New Recruit!\u0022,cn:\u0022\u8C22\u8C22\uFF0C\u4F46\u60A8\u5FC5\u987B\u5728\u7EBF\u624D\u80FD\u652F\u6301 New Recruit\uFF01\u0022,it:\u0022Grazie, ma devi essere online per sostenere New Recruit!\u0022,de:\u0022Danke, aber Sie m\u00FCssen online sein, um New Recruit zu unterst\u00FCtzen!\u0022,ja:\u0022\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u304C\u3001New Recruit \u3092\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u306B\u306F\u30AA\u30F3\u30E9\u30A4\u30F3\u3067\u3042\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\uFF01\u0022,pl:\u0022Dzi\u0119kuj\u0119, ale musisz by\u0107 online, aby wspiera\u0107 New Recruit!\u0022,pt:\u0022Obrigado, mas voc\u00EA deve estar online para apoiar o New Recruit!\u0022,hr:\u0022Morate biti online\u0022,cz:\u0022Thank you, but you must be online to support New Recruit!\u0022,sk:\u0022Thank you, but you must be online to support New Recruit!\u0022,gr:\u0022\u03A0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03C3\u03C4\u03B5 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9\u0022,ru:\u0022\u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443\u0022,ko:\u0022Thank you, but you must be online to support New Recruit!\u0022},WMe={en:\u0022Enable List Review\u0022,fr:\u0022Activer la revue de listes\u0022,es:\u0022Activar revisi\u00F3n de listas\u0022,cn:\u0022\u542F\u7528\u5217\u8868\u5BA1\u6838\u0022,it:\u0022Abilita revisione elenco\u0022,de:\u0022Listen\u00FCberpr\u00FCfung aktivieren\u0022,ja:\u0022\u30EA\u30B9\u30C8\u5BE9\u67FB\u3092\u6709\u52B9\u306B\u3059\u308B\u0022,pl:\u0022W\u0142\u0105cz przegl\u0105d list\u0022,pt:\u0022Ativar revis\u00E3o de listas\u0022,hr:\u0022Omogu\u0107i recenziju lista\u0022,cz:\u0022Enable List Review\u0022,sk:\u0022Enable List Review\u0022,gr:\u0022\u0395\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u039B\u03AF\u03C3\u03C4\u03B1 \u039A\u03C1\u03B9\u03C4\u03B9\u03BA\u03AE\u0022,ru:\u0022\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443 \u0441\u043F\u0438\u0441\u043A\u043E\u0432\u0022,ko:\u0022List Review \uD65C\uC131\uD654\u0022},YMe={en:\u0022Reviewers per list\u0022,fr:\u0022Reviewers par liste\u0022,es:\u0022Revisores por lista\u0022,cn:\u0022\u6BCF\u4E2A\u5217\u8868\u7684\u5BA1\u6838\u8005\u0022,it:\u0022Revisori per elenco\u0022,de:\u0022Pr\u00FCfer pro Liste\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3054\u3068\u306E\u30EC\u30D3\u30E5\u30A2\u30FC\u0022,pl:\u0022Recenzenci na list\u0119\u0022,pt:\u0022Revisores por lista\u0022,hr:\u0022Recenzenti po listi\u0022,cz:\u0022Reviewers per list\u0022,sk:\u0022Reviewers per list\u0022,gr:\u0022\u0391\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B7\u03C4\u03AD\u03C2 \u03B1\u03BD\u03AC \u03BB\u03AF\u03C3\u03C4\u03B1\u0022,ru:\u0022\u0420\u0435\u0446\u0435\u043D\u0437\u0435\u043D\u0442\u043E\u0432 \u043D\u0430 \u0441\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022Reviewers per list\u0022},KMe={en:\u0022Only assign reviewers with players of the same faction\u0022,fr:\u0022Assigner uniquement des reviewers avec des joueurs de la m\u00EAme faction\u0022,es:\u0022Asignar solo revisores con jugadores de la misma facci\u00F3n\u0022,cn:\u0022\u4EC5\u5206\u914D\u76F8\u540C\u6D3E\u7CFB\u7684\u73A9\u5BB6\u4F5C\u4E3A\u5BA1\u6838\u8005\u0022,it:\u0022Assegna solo revisori con giocatori della stessa fazione\u0022,de:\u0022Nur Pr\u00FCfer mit Spielern derselben Fraktion zuweisen\u0022,ja:\u0022\u540C\u3058\u6D3E\u95A5\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u307F\u3092\u30EC\u30D3\u30E5\u30A2\u30FC\u3068\u3057\u3066\u5272\u308A\u5F53\u3066\u308B\u0022,pl:\u0022Przydziel tylko recenzent\u00F3w z graczami tej samej frakcji\u0022,pt:\u0022Atribuir apenas revisores com jogadores da mesma fac\u00E7\u00E3o\u0022,hr:\u0022Samo ista frakcija\u0022,cz:\u0022Only assign reviewers with players of the same faction\u0022,sk:\u0022Only assign reviewers with players of the same faction\u0022,gr:\u0022\u039C\u03CC\u03BD\u03BF \u03AF\u03B4\u03B9\u03B1 \u03C6\u03B1\u03C4\u03C1\u03AF\u03B1\u0022,ru:\u0022\u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0430 \u0436\u0435 \u0444\u0440\u0430\u043A\u0446\u0438\u044F\u0022,ko:\u0022Only assign reviewers with players of the same faction\u0022},qMe={en:\u0022Assign teams as reviewers\u0022,fr:\u0022Assigner des \u00E9quipes comme reviewers\u0022,es:\u0022Asignar equipos como revisores\u0022,cn:\u0022\u5206\u914D\u56E2\u961F\u4F5C\u4E3A\u5BA1\u6838\u8005\u0022,it:\u0022Assegna team come revisori\u0022,de:\u0022Teams als Pr\u00FCfer zuweisen\u0022,ja:\u0022\u30C1\u30FC\u30E0\u3092\u30EC\u30D3\u30E5\u30A2\u30FC\u3068\u3057\u3066\u5272\u308A\u5F53\u3066\u308B\u0022,pl:\u0022Przypisz zespo\u0142y jako recenzent\u00F3w\u0022,pt:\u0022Atribuir equipes como revisores\u0022,hr:\u0022Po timu\u0022,cz:\u0022Assign teams as reviewers\u0022,sk:\u0022Assign teams as reviewers\u0022,gr:\u0022\u0391\u03BD\u03AC \u03BF\u03BC\u03AC\u03B4\u03B1\u0022,ru:\u0022\u041F\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0430\u043C\u0022,ko:\u0022Assign teams as reviewers\u0022},JMe={en:\u0022Assign reviews to players of a different faction during automatic generation\u0022,fr:\u0022Assigner des reviews \u00E0 des joueurs d\u0027une faction diff\u00E9rente lors de la g\u00E9n\u00E9ration automatique\u0022,es:\u0022Asignar revisiones a jugadores de una facci\u00F3n diferente durante la generaci\u00F3n autom\u00E1tica\u0022,cn:\u0022\u5728\u81EA\u52A8\u751F\u6210\u671F\u95F4\u5C06\u5BA1\u6838\u5206\u914D\u7ED9\u4E0D\u540C\u6D3E\u7CFB\u7684\u73A9\u5BB6\u0022,it:\u0022Assegna revisioni a giocatori di fazioni diverse durante la generazione automatica\u0022,de:\u0022\u00DCberpr\u00FCfungen Spielern einer anderen Fraktion bei automatischer Generierung zuweisen\u0022,ja:\u0022\u81EA\u52D5\u751F\u6210\u6642\u306B\u7570\u306A\u308B\u6D3E\u95A5\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u30EC\u30D3\u30E5\u30FC\u3092\u5272\u308A\u5F53\u3066\u308B\u0022,pl:\u0022Przydziel recenzje graczom innej frakcji podczas automatycznego generowania\u0022,pt:\u0022Atribuir revis\u00F5es a jogadores de uma fac\u00E7\u00E3o diferente durante a gera\u00E7\u00E3o autom\u00E1tica\u0022,hr:\u0022Dopusti recenziju razli\u010Ditih frakcija\u0022,cz:\u0022Assign reviews to players of a different faction during automatic generati