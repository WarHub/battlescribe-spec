n%\u0022,ja:\u0022\u52DD\u5229%\u0022,pl:\u0022Szansa wygranej%\u0022,pt:\u0022Vit\u00F3ria%\u0022,hr:\u0022Win%\u0022,cz:\u0022Win%\u0022,sk:\u0022Win%\u0022,gr:\u0022\u039D\u03AF\u03BA\u03B7%\u0022,ru:\u0022\u041F\u043E\u0431\u0435\u0434\u0430%\u0022,ko:\u0022Win%\u0022},U0e={en:\u0022Draw:\u0022,fr:\u0022Match nul :\u0022,es:\u0022Empate:\u0022,cn:\u0022\u5E73\u5C40\uFF1A\u0022,it:\u0022Draw:\u0022,de:\u0022Unentschieden:\u0022,ja:\u0022\u5F15\u304D\u5206\u3051:\u0022,pl:\u0022Remis:\u0022,pt:\u0022Empate:\u0022,hr:\u0022Nerije\u0161eno:\u0022,cz:\u0022Draw:\u0022,sk:\u0022Draw:\u0022,gr:\u0022\u0399\u03C3\u03BF\u03C0\u03B1\u03BB\u03AF\u03B1:\u0022,ru:\u0022\u041D\u0438\u0447\u044C\u044F:\u0022,ko:\u0022Draw:\u0022},x0e={en:\u0022Combat Log\u0022,fr:\u0022Journal de Combat\u0022,es:\u0022Registro de Combate\u0022,cn:\u0022\u6218\u6597\u65E5\u5FD7\u0022,it:\u0022Combat Log\u0022,de:\u0022Kampfprotokoll\u0022,ja:\u0022\u6226\u95D8\u30ED\u30B0\u0022,pl:\u0022Dziennik walki\u0022,pt:\u0022Registro de Combate\u0022,hr:\u0022Dnevnik Borbe\u0022,cz:\u0022Combat Log\u0022,sk:\u0022Combat Log\u0022,gr:\u0022\u039C\u03AC\u03C7\u03B7 Log\u0022,ru:\u0022\u0416\u0443\u0440\u043D\u0430\u043B \u0431\u043E\u044F\u0022,ko:\u0022Combat Log\u0022},Q0e={en:\u0022No Armies!\u0022,fr:\u0022Aucune Arm\u00E9e !\u0022,es:\u0022\u00A1Sin Ej\u00E9rcitos!\u0022,cn:\u0022\u6CA1\u6709\u519B\u961F\uFF01\u0022,it:\u0022No Armies!\u0022,de:\u0022Nein Armies!\u0022,ja:\u0022\u3044\u3044\u3048Armies!\u0022,pl:\u0022Brak armii!\u0022,pt:\u0022Sem Ex\u00E9rcitos!\u0022,hr:\u0022Nema Armija!\u0022,cz:\u0022No Armies!\u0022,sk:\u0022No Armies!\u0022,gr:\u0022\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03AF!\u0022,ru:\u0022\u041D\u0435\u0442 \u0410\u0440\u043C\u0438\u0438!\u0022,ko:\u0022No Armies!\u0022},L0e={en:\u0022You need to create at least one Army List to use the Combat Simulator! Did you forget to Sync?\u0022,fr:\u0022Vous devez cr\u00E9er au moins une Liste d\u0027Arm\u00E9e pour utiliser le Simulateur de Combat ! Avez-vous oubli\u00E9 de Synchroniser ?\u0022,es:\u0022\u00A1Necesitas crear al menos una Lista de Ej\u00E9rcito para usar el Simulador de Combate! \u00BFOlvidaste Sincronizar?\u0022,cn:\u0022\u60A8\u9700\u8981\u521B\u5EFA\u81F3\u5C11\u4E00\u4E2A\u519B\u961F\u5217\u8868\u624D\u80FD\u4F7F\u7528\u6218\u6597\u6A21\u62DF\u5668\uFF01\u60A8\u5FD8\u8BB0\u540C\u6B65\u4E86\u5417\uFF1F\u0022,it:\u0022You need to create at least one Listaa d\u0027Armata to use the Combattimento Simulator! Did you forget to Sync?\u0022,de:\u0022You need to create at least one Armee Liste to use the Combat Simulator! Did you forget to Sync?\u0022,ja:\u0022You need  \u4F5C\u6210 \u3067 least 1 \u30A2\u30FC\u30DF\u30FC\u30EA\u30B9\u30C8  \u4F7F\u7528  \u6226\u95D8 Simulator! Did you forget  \u540C\u671F?\u0022,pl:\u0022Musisz utworzy\u0107 co najmniej jedn\u0105 list\u0119 armii, aby u\u017Cy\u0107 Symulatora Walki! Czy zapomnia\u0142e\u015B zsynchronizowa\u0107?\u0022,pt:\u0022Voc\u00EA precisa criar pelo menos uma Lista de Ex\u00E9rcito para usar o Simulador de Combate! Voc\u00EA esqueceu de Sincronizar?\u0022,hr:\u0022Trebate kreirati barem jednu Listu Armije za kori\u0161tenje Simulatora Borbe! Jeste li zaboravili Sinkronizirati?\u0022,cz:\u0022You need to create at least one Army List to use the Combat Simulator! Did you forget to Sync?\u0022,sk:\u0022You need to create at least one Army List to use the Combat Simulator! Did you forget to Sync?\u0022,gr:\u0022\u03A0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD \u03BC\u03AF\u03B1 \u039B\u03AF\u03C3\u03C4\u03B1 \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03CD \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03A0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03C9\u03C4\u03AE \u039C\u03AC\u03C7\u03B7\u03C2! \u039E\u03B5\u03C7\u03AC\u03C3\u03B1\u03C4\u03B5 \u03BD\u03B1 \u03A3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03AF\u03C3\u03B5\u03C4\u03B5;\u0022,ru:\u0022\u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0441\u043F\u0438\u0441\u043A\u0438 \u0430\u0440\u043C\u0438\u0439\u0022,ko:\u0022You need to create at least one Army List to use the Combat Simulator! Did you forget to Sync?\u0022},D0e={en:\u0022The Combat simulator is not available for {system}.\u0022,fr:\u0022Le simulateur de Combat n\u0027est pas disponible pour {system}.\u0022,es:\u0022El simulador de Combate no est\u00E1 disponible para {system}.\u0022,cn:\u0022\u6218\u6597\u6A21\u62DF\u5668\u4E0D\u9002\u7528\u4E8E {system}\u3002\u0022,it:\u0022The Combattimento simulator is not available for {system}.\u0022,de:\u0022Der Kampfsimulator ist nicht f\u00FCr {system} verf\u00FCgbar.\u0022,ja:\u0022 \u6226\u95D8 simulator is \u3044\u3044\u3048t \u5229\u7528\u53EF\u80FD \u306E\u305F\u3081\u306E {system}.\u0022,pl:\u0022Symulator walki nie jest dost\u0119pny dla {system}.\u0022,pt:\u0022O Simulador de Combate n\u00E3o est\u00E1 dispon\u00EDvel para {system}.\u0022,hr:\u0022Simulator Borbe nije dostupan za {system}.\u0022,cz:\u0022The Combat simulator is not available for {system}.\u0022,sk:\u0022The Combat simulator is not available for {system}.\u0022,gr:\u0022\u039F \u03C0\u03C1\u03BF\u03C3\u03BF\u03BC\u03BF\u03B9\u03C9\u03C4\u03AE\u03C2 \u039C\u03AC\u03C7\u03B7\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF\u03C2 \u03B3\u03B9\u03B1 {system}.\u0022,ru:\u0022\u0421\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0431\u043E\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0434\u043B\u044F \u044D\u0442\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B\u0022,ko:\u0022The Combat simulator is not available f