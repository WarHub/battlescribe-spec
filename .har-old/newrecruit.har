D\u0438\u0430\u0442\u044E\u0440\u044B\u0022,ko:\u0022Remaining Miniatures\u0022},$be={en:\u0022You have not added any miniatures to your collection yet!\u003Cbr /\u003E\u003Cbr /\u003EClick the button below to add miniatures to your collection.\u0022,fr:\u0022Vous n\u0027avez pas encore ajout\u00E9 de figurines \u00E0 votre collection !\u003Cbr /\u003E\u003Cbr /\u003ECliquez sur le bouton ci-dessous pour ajouter des figurines \u00E0 votre collection.\u0022,es:\u0022\u00A1A\u00FAn no has agregado ninguna miniatura a tu colecci\u00F3n!\u003Cbr /\u003E\u003Cbr /\u003EHaz clic en el bot\u00F3n de abajo para agregar miniaturas a tu colecci\u00F3n.\u0022,cn:\u0022\u60A8\u8FD8\u6CA1\u6709\u5C06\u4EFB\u4F55\u5FAE\u7F29\u6A21\u578B\u6DFB\u52A0\u5230\u60A8\u7684\u6536\u85CF\u4E2D\uFF01\u003Cbr /\u003E\u003Cbr /\u003E\u70B9\u51FB\u4E0B\u9762\u7684\u6309\u94AE\u5C06\u5FAE\u7F29\u6A21\u578B\u6DFB\u52A0\u5230\u60A8\u7684\u6536\u85CF\u4E2D\u3002\u0022,it:\u0022Non hai ancora aggiunto nessuna miniatura alla tua collezione!\u003Cbr /\u003E\u003Cbr /\u003EClicca sul pulsante qui sotto per aggiungere miniature alla tua collezione.\u0022,de:\u0022Sie haben Ihrer Sammlung noch keine Miniaturen hinzugef\u00FCgt!\u003Cbr /\u003E\u003Cbr /\u003EKlicken Sie auf die Schaltfl\u00E4che unten, um Miniaturen zu Ihrer Sammlung hinzuzuf\u00FCgen.\u0022,ja:\u0022\u307E\u3060\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u306B\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u8FFD\u52A0\u3057\u3066\u3044\u307E\u305B\u3093\uFF01\u003Cbr /\u003E\u003Cbr /\u003E\u4E0B\u306E\u30DC\u30BF\u30F3\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u306B\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u8FFD\u52A0\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Nie doda\u0142e\u015B jeszcze \u017Cadnych miniatur do swojej kolekcji!\u003Cbr /\u003E\u003Cbr /\u003EKliknij poni\u017Cszy przycisk, aby doda\u0107 miniatury do swojej kolekcji.\u0022,pt:\u0022Voc\u00EA ainda n\u00E3o adicionou nenhuma miniatura \u00E0 sua cole\u00E7\u00E3o!\u003Cbr /\u003E\u003Cbr /\u003EClique no bot\u00E3o abaixo para adicionar miniaturas \u00E0 sua cole\u00E7\u00E3o.\u0022,hr:\u0022Jo\u0161 niste dodali nijednu minijaturu u svoju kolekciju!\u003Cbr /\u003E\u003Cbr /\u003EKliknite donji gumb za dodavanje minijatura u va\u0161u kolekciju.\u0022,cz:\u0022You have not added any miniatures to your collection yet!\u003Cbr /\u003E\u003Cbr /\u003EClick the button below to add miniatures to your collection.\u0022,sk:\u0022You have not added any miniatures to your collection yet!\u003Cbr /\u003E\u003Cbr /\u003EClick the button below to add miniatures to your collection.\u0022,gr:\u0022\u0394\u03B5\u03BD \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03B9 \u03BA\u03B1\u03BC\u03AF\u03B1 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03B1 \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03AE \u03C3\u03B1\u03C2 \u03B1\u03BA\u03CC\u03BC\u03B1!\u003Cbr /\u003E\u003Cbr /\u003E\u039A\u03AC\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B9\u03BA \u03C3\u03C4\u03BF \u03C0\u03B1\u03C1\u03B1\u03BA\u03AC\u03C4\u03C9 \u03BA\u03BF\u03C5\u03BC\u03C0\u03AF \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03C4\u03B5 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03B5\u03C2 \u03C3\u03C4\u03B7 \u03C3\u03C5\u03BB\u03BB\u03BF\u03B3\u03AE \u03C3\u03B1\u03C2.\u0022,ru:\u0022\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F \u0435\u0449\u0435 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u0430\u0022,ko:\u0022You have not added any miniatures to your collection yet!\u003Cbr /\u003E\u003Cbr /\u003EClick the button below to add miniatures to your collection.\u0022},Zbe={en:\u0022Add {count} missing model{plural}\u0022,fr:\u0022Ajouter {count} figurine{plural} manquante{plural}\u0022,es:\u0022Agregar {count} miniatura{plural} faltante{plural}\u0022,cn:\u0022\u6DFB\u52A0 {count} \u4E2A\u7F3A\u5931\u7684\u6A21\u578B\u0022,it:\u0022Aggiungi {count} miniatura{plural} mancante{plural}\u0022,de:\u0022{count} fehlende Miniatur{plural} hinzuf\u00FCgen\u0022,ja:\u0022{count} \u500B\u306E\u4E0D\u8DB3\u3057\u3066\u3044\u308B\u30E2\u30C7\u30EB\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj {count} brakuj\u0105c\u0105{plural} miniatur\u0119{plural}\u0022,pt:\u0022Adicionar {count} miniatura{plural} faltante{plural}\u0022,hr:\u0022Dodaj {count} model{plural} koji nedostaje\u0022,cz:\u0022Add {count} missing model{plural}\u0022,sk:\u0022Add {count} missing model{plural}\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 {count} \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF\u03C5/\u03C9\u03BD \u03C0\u03BF\u03C5 \u03BB\u03B5\u03AF\u03C0\u03B5\u03B9/\u03BF\u03C5\u03BD\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0438\u0022,ko:\u0022{count} missing model{plural} \uCD94\uAC00\u0022},Xbe={en:\u0022Mark all found miniatures as Built?\u0022,fr:\u0022Marquer toutes les figurines trouv\u00E9es comme assembl\u00E9es ?\u0022,es:\u0022\u00BFMarcar todas las miniaturas encontradas como construidas?\u0022,cn:\u0022\u5C06\u6240\u6709\u627E\u5230\u7684\u5FAE\u7F29\u6A21\u578B\u6807\u8BB0\u4E3A\u5DF2\u7EC4\u88C5\uFF1F\u0022,it:\u0022Contrassegnare tutte le miniature trovate come assemblate?\u0022,de:\u0022Alle gefundenen Miniaturen als zusammengebaut markieren?\u0022,ja:\u0022\u898B\u3064\u304B\u3063\u305F\u3059\u3079\u3066\u306E\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u7D44\u7ACB\u6E08\u307F\u3068\u3057\u3066\u30DE\u30FC\u30AF\u3057\u307E\u3059\u304B\uFF1F\u0022,pl:\u0022Oznaczy\u0107 wszystkie znalezione miniatury jako zbudowane?\u0022,pt:\u0022Marcar todas as miniaturas encontradas como montadas?\u0022,hr:\u0022Ozna\u010Diti sve prona\u0111ene minijature kao Sastavljeno?\u0022,cz:\u0022Mark all found miniatures as Built?\u0022,sk:\u0022Mark all found miniatures as Built?\u0022,gr:\u0022\u0395\u03C0\u03B9\u03C3\u03AE\u