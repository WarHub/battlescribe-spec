lla:\u0022,\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u540D\u3092\u5165\u529B:\u0022,\u0022Wprowad\u017A nazw\u0119 folderu:\u0022,\u0022Insira o nome da pasta:\u0022,\u0022Unesite naziv mape\u0022,\u0022\u0395\u03B9\u03C3\u03B1\u03B3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,\u0022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u0430\u043F\u043A\u0438\u0022,{\u0022en\u0022:16946,\u0022fr\u0022:16947,\u0022es\u0022:16948,\u0022cn\u0022:16949,\u0022it\u0022:16950,\u0022de\u0022:16946,\u0022ja\u0022:16951,\u0022pl\u0022:16952,\u0022pt\u0022:16953,\u0022hr\u0022:16954,\u0022cz\u0022:16946,\u0022sk\u0022:16946,\u0022gr\u0022:16955,\u0022ru\u0022:16956,\u0022ko\u0022:16946},\u0022Folder \u0027{name}\u0027 created\u0022,\u0022Dossier \u0027{name}\u0027 cr\u00E9\u00E9\u0022,\u0022Carpeta \u0027{name}\u0027 creada\u0022,\u0022\u6587\u4EF6\u5939 \u0027{name}\u0027 \u5DF2\u521B\u5EFA\u0022,\u0022Cartella \u0027{name}\u0027 creata\u0022,\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u304C\u4F5C\u6210\u3055\u308C\u307E\u3057\u305F\u0022,\u0022Folder \u0027{name}\u0027 utworzony\u0022,\u0022Pasta \u0027{name}\u0027 criada\u0022,\u0022Mapa kreirana\u0022,\u0022\u039F \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03B8\u03B7\u03BA\u03B5\u0022,\u0022\u041F\u0430\u043F\u043A\u0430 \u0027{\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435}\u0027 \u0421\u043E\u0437\u0434\u0430\u043D\u043E\u0022,{\u0022en\u0022:16958,\u0022fr\u0022:16959,\u0022es\u0022:16960,\u0022cn\u0022:16961,\u0022it\u0022:16962,\u0022de\u0022:16958,\u0022ja\u0022:16963,\u0022pl\u0022:16964,\u0022pt\u0022:16965,\u0022hr\u0022:16966,\u0022cz\u0022:16958,\u0022sk\u0022:16958,\u0022gr\u0022:16967,\u0022ru\u0022:16968,\u0022ko\u0022:16958},\u0022Folder \u0027{name}\u0027 already exists\u0022,\u0022Le dossier \u0027{name}\u0027 existe d\u00E9j\u00E0\