2\u0413\u043E\u0442\u043E\u0432\u043E\u0022,ko:\u0022Done\u0022},Qke={en:\u0022Deployment Zones\u0022,fr:\u0022Zones de D\u00E9ploiement\u0022,es:\u0022Zonas de Despliegue\u0022,cn:\u0022\u90E8\u7F72\u533A\u57DF\u0022,it:\u0022Deployment Zones\u0022,de:\u0022Aufstellenment Zones\u0022,ja:\u0022\u914D\u7F6EZones\u0022,pl:\u0022Strefy rozmieszczenia\u0022,pt:\u0022Zonas de Implanta\u00E7\u00E3o\u0022,hr:\u0022Zone Rasporeda\u0022,cz:\u0022Deployment Zones\u0022,sk:\u0022Deployment Zones\u0022,gr:\u0022\u0396\u03CE\u03BD\u03B5\u03C2 \u0391\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u03C2\u0022,ru:\u0022\u0417\u043E\u043D\u044B \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u043D\u0438\u044F\u0022,ko:\u0022Deployment Zones\u0022},Lke={en:\u0022It is now time for players to roll for Deployment zones.\u0022,fr:\u0022Il est maintenant temps pour les joueurs de lancer pour les zones de d\u00E9ploiement.\u0022,es:\u0022Es hora de que los jugadores rueden por las zonas de despliegue.\u0022,cn:\u0022\u73B0\u5728\u662F\u73A9\u5BB6\u4E3A\u90E8\u7F72\u533A\u57DF\u6295\u63B7\u7684\u65F6\u5019\u4E86\u3002\u0022,it:\u0022It is now time for players to roll for Schieramento zones.\u0022,de:\u0022It is now time for players to roll for Aufstellenment zones.\u0022,ja:\u0022It is \u3044\u3044\u3048w \u6642\u9593 \u306E\u305F\u3081\u306E \u30D7\u30EC\u30A4\u30E4\u30FC  \u30ED\u30FC\u30EB \u306E\u305F\u3081\u306E \u914D\u7F6E zones.\u0022,pl:\u0022Teraz nadszed\u0142 czas, aby gracze rzucili na strefy rozmieszczenia.\u0022,pt:\u0022Agora \u00E9 hora dos jogadores rolarem para as Zonas de Implanta\u00E7\u00E3o.\u0022,hr:\u0022Sada je vrijeme da igra\u010Di bacaju kockicu za Zone Rasporeda.\u0022,cz:\u0022It is now time for players to roll for Deployment zones.\u0022,sk:\u0022It is now time for players to roll for Deployment zones.\u0022,gr:\u0022\u03A1\u03AF\u03BE\u03C4\u03B5 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03AF\u03C3\u03B5\u03C4\u03B5 \u03C4\u03B7 \u03B6\u03CE\u03BD\u03B7 \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u03C2\u0022,ru:\u0022\u0411\u0440\u043E\u0441\u043E\u043A \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438\u0022,ko:\u0022It is now time for players to roll for Deployment zones.\u0022},Dke={en:\u0022Both players roll a D6. The player that rolls higher chooses their Deployment Zone and follows the Deployment Type specific instructions if applicable. In case of a tie, roll again.\u0022,fr:\u0022Les deux joueurs lancent un D6. Le joueur qui obtient le plus haut choisit sa zone de d\u00E9ploiement et suit les instructions sp\u00E9cifiques du type de d\u00E9ploiement si applicable. En cas d\u0027\u00E9galit\u00E9, relancez.\u0022,es:\u0022Ambos jugadores lanzan un D6. El jugador que saque m\u00E1s alto elige su Zona de Despliegue y sigue las instrucciones espec\u00EDficas del Tipo de Despliegue si corresponde. En caso de empate, vuelvan a tirar.\u0022,cn:\u0022\u53CC\u65B9\u73A9\u5BB6\u90FD\u6295\u63B7\u4E00\u4E2AD6\u3002\u6295\u63B7\u7ED3\u679C\u8F83\u9AD8\u7684\u73A9\u5BB6\u9009\u62E9\u4ED6\u4EEC\u7684\u90E8\u7F72\u533A\u57DF\uFF0C\u5982\u679C\u9002\u7528\uFF0C\u5219\u9075\u5FAA\u90E8\u7F72\u7C7B\u578B\u7684\u7279\u5B9A\u8BF4\u660E\u3002\u5982\u679C\u5E73\u5C40\uFF0C\u8BF7\u91CD\u65B0\u6295\u63B7\u3002\u0022,it:\u0022Both players roll a D6. The player that rolls higher chooses their Schieramento Zone and follows the Schieramento Tipo specific instructions if applicable. In case of a tie, roll again.\u0022,de:\u0022Both players roll a D6. The player that rolls higher chooses their Aufstellenment Zone and follows the Aufstellenment Type specific instructions if applicable. In case of a tie, roll again.\u0022,ja:\u0022\u4E21\u65B9 \u30D7\u30EC\u30A4\u30E4\u30FC \u30ED\u30FC\u30EB a D6.  \u30D7\u30EC\u30A4\u30E4\u30FC that \u30ED\u30FC\u30EBs higher chooses their \u914D\u7F6E \u30BE\u30FC\u30F3 \u304A\u3088\u3073 follows  \u914D\u7F6E \u30BF\u30A4\u30D7 specific instructions \u3082\u3057 applicable. \u3067 case \u306E a tie, \u30ED\u30FC\u30EB \u518D\u3073.\u0022,pl:\u0022Obaj gracze rzucaj\u0105 k6. Gracz, kt\u00F3ry wyrzuci wi\u0119cej, wybiera swoj\u0105 stref\u0119 rozmieszczenia i post\u0119puje zgodnie ze szczeg\u00F3\u0142owymi instrukcjami typu rozmieszczenia, je\u015Bli ma to zastosowanie. W przypadku remisu rzu\u0107 ponownie.\u0022,pt:\u0022Ambos os jogadores rolam um D6. O jogador que rolar maior escolhe sua Zona de Implanta\u00E7\u00E3o e segue as instru\u00E7\u00F5es espec\u00EDficas do Tipo de Implanta\u00E7\u00E3o, se aplic\u00E1vel. Em caso de empate, role novamente.\u0022,hr:\u0022Oba igra\u010Da bacaju D6. Igra\u010D koji baci vi\u0161e bira svoju Zonu Rasporeda i slijedi specifi\u010Dne upute Tipa Rasporeda ako je primjenjivo. U slu\u010Daju izjedna\u010Denja, bacite ponovno.\u0022,cz:\u0022Both players roll a D6. The player that rolls higher chooses their Deployment Zone and follows the Deployment Type specific instructions if applicable. In case of a tie, roll again.\u0022,sk:\u0022Both players roll a D6. The player that rolls higher chooses their Deployment Zone and follows the Deployment Type specific instructions if applicable. In case of a tie, roll again.\u0022,gr:\u0022\u03A1\u03AF\u03BE\u03C4\u03B5 \u03AD\u03BD\u03B1 \u03B6\u03AC\u03C1\u03B9\u0022,ru:\u0022\u0411\u0440\u043E\u0441\u044C\u0442\u0435 \u043A\u0443\u0431\u0438\u043A \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0437\u043E\u043D \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438\u0022,ko:\u0022Both players roll a D6. The player that rolls higher chooses their Deployment Zone and follows the Deployment Type specific instructions if applicable. In case of a tie, roll again.\u0022},Oke={en:\u0022Roll for Deployment Type\u0022,fr:\u0022Lancer pour le Type de D\u00E9ploiement\u0022,es:\u0022Lanzar por Tipo de Despliegue\u0022,cn:\u0022\u6295\u63B7\u90E8\u7F72\u7C7B\u578B\u0022,it:\u0022Roll for Deployment Type\u0022,de:\u0022W\u00FCrfeln for Aufstellenment Type\u0022,ja:\u0022\u30ED\u30FC\u30EBfor\u914D\u7F6E\u30BF\u30A4\u30D7\u0022,pl:\u0022Rzu\u0107 na typ rozmieszczenia\u0022,pt:\u0022Rolar para Tipo de Implanta\u00E7\u00E3o\u0022,hr:\u0022Bacite Kockicu za Tip Rasporeda\u0022,cz:\u0022Roll for Deployment Type\u0022,sk:\u0022Roll for Deployment Type\u0022,gr:\u0022\u0396\u03AC\u03C1\u03B9 for \u0391\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7 \u03A4\u03CD\u03C0\u03BF\u03C2\u0022,ru:\u0022\u0411\u0440\u043E\u0441\u043E\u043A \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0442\u0438\u043F\u0430 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438\u0022,ko:\u0022Roll for Deployment Type\u0022},Hke={en:\u0022Select Deployment Type\u0022,fr:\u0022S\u00E9lectionner le Type de D\u00E9ploiement\u0022,es:\u0022Seleccionar Tipo de Despliegue\u0022,cn:\u0022\u9009\u62E9\u90E8\u7F72\u7C7B\u578B\u0022,it:\u0022Select Schieramento Tipo\u0022,de:\u0022Ausw\u00E4hlen Aufstellenment Type\u0022,ja:\u0022\u9078\u629E\u914D\u7F6E\u30BF\u30A4\u30D7\u0022,pl:\u0022Wybierz typ rozmieszczenia\u0022,pt:\u0022Selecionar Tipo de Implanta\u00E7\u00E3o\u0022,hr:\u0022Odaberi Tip Rasporeda\u0022,cz:\u0022Select Deployment Type\u0022,sk:\u0022Select Deployment Type\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u0391\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7 \u03A4\u03CD\u03C0\u03BF\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0420\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u043D\u0438\u0435 \u0422\u0438\u043F\u0022,ko:\u0022Deployment Type \uC120\uD0DD\u0022},Gke={en:\u0022Deployment\u0022,fr:\u0022D\u00E9ploiement\u0022,es:\u0022Despliegue\u0022,cn:\u0022\u90E8\u7F72\u0022,it:\u0022Schieramento\u0022,de:\u0022Aufstellung\u0022,ja:\u0022\u914D\u7F6E\u0022,pl:\u0022Rozmieszczenie\u0022,pt:\u0022Implanta\u00E7\u00E3o\u0022,hr:\u0022Raspored\u0022,cz:\u0022Deployment\u0022,sk:\u0022Rozmiestnenie\u0022,gr:\u0022\u0391\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u0022,ru:\u0022\u0420\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Deployment\u0022},Vke={en:\u0022Deployment Phase Sequence\u0022,fr:\u0022S\u00E9quence de Phase de D\u00E9ploiement\u0022,es:\u0022Secuencia de Fase de Despliegue\u0022,cn:\u0022\u90E8\u7F72\u9636\u6BB5\u5E8F\u5217\u0022,it:\u0022Deployment Phase Sequence\u0022,de:\u0022Aufstellenment Phase Sequence\u0022,ja:\u0022\u914D\u7F6E\u30D5\u30A7\u30FC\u30BASequence\u0022,pl:\u0022Sekwencja fazy rozmieszczenia\u0022,pt:\u0022Sequ\u00EAncia da Fase de Implanta\u00E7\u00E3o\u0022,hr:\u0022Slijed Faze Rasporeda\u0022,cz:\u0022Deployment Phase Sequence\u0022,sk:\u0022Deployment Phase Sequence\u0022,gr:\u0022\u0391\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AF\u03B1 \u03A6\u03AC\u03C3\u03B7\u03C2 \u0391\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u03C2\u0022,ru:\u0022\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0444\u0430\u0437\u044B \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u043D\u0438\u044F\u0022,ko:\u0022Deployment Phase Sequence\u0022},Wke={en:\u0022Determine who deploys first\u0022,fr:\u0022D\u00E9terminer qui d\u00E9ploie en premier\u0022,es:\u0022Determinar qui\u00E9n despliega primero\u0022,cn:\u0022\u786E\u5B9A\u8C01\u5148\u90E8\u7F72\u0022,it:\u0022Determine who deploys first\u0022,de:\u0022Bestimmen Sie, wer zuerst aufstellt\u0022,ja:\u0022Determine who deploys \u6700\u521D\u0022,pl:\u0022Okre\u015Bl, kto rozmieszcza pierwszy\u0022,pt:\u0022Determinar quem implanta primeiro\u0022,hr:\u0022Odredite tko postavlja prvi\u0022,cz:\u0022Determine who deploys first\u0022,sk:\u0022Determine who deploys first\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B4\u03B9\u03BF\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B1\u03BD\u03B1\u03C0\u03C4\u03CD\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2\u0022,ru:\u0022\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C, \u043A\u0442\u043E \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u043C\u0022,ko:\u0022Determine who deploys first\u0022},Yke={en:\u0022Take turns deploying units\u0022,fr:\u0022D\u00E9ployer les unit\u00E9s \u00E0 tour de r\u00F4le\u0022,es:\u0022Turnarse para desplegar unidades\u0022,cn:\u0022\u8F6E\u6D41\u90E8\u7F72\u5355\u4F4D\u0022,it:\u0022Take turns deploying units\u0022,de:\u0022Wechseln Sie sich beim Aufstellen von Einheiten ab\u0022,ja:\u0022Take turns deploying \u30E6\u30CB\u30C3\u30C8\u0022,pl:\u0022Rozmieszczajcie jednostki na zmian\u0119\u0022,pt:\u0022Alternar na implanta\u00E7\u00E3o de unidades\u0022,hr:\u0022Naizmjeni\u010Dno postavljajte jedinice\u0022,cz:\u0022Take turns deploying units\u0022,sk:\u0022Take turns deploying units\u0022,gr:\u0022\u0395\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE \u03C3\u03B5\u03B9\u03C1\u03AC\u03C2 \u03B1\u03BD\u03B1\u03C0\u03C4\u03CD\u03C3\u03C3\u03BF\u03BD\u03C4\u03B1\u03C2 \u03BC\u03BF\u03BD\u03AC\u03B4\u03B5\u03C2\u0022,ru:\u0022\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u044E\u043D\u0438\u0442\u044B \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438\u0022,ko:\u0022Take turns deploying units\u0022},Kke={en:\u0022Declare intent to go first or second\u0022,fr:\u0022D\u00E9clarer l\u0027intention d\u0027aller en premier ou en second\u0022,es:\u0022Declarar intenci\u00F3n de ir primero o segundo\u0022,cn:\u0022\u58F0\u660E\u5148\u624B\u6216\u540E\u624B\u610F\u56FE\u0022,it:\u0022Declare intent to go first or second\u0022,de:\u0022Absicht erkl\u00E4ren, zuerst oder zweiter zu gehen\u0022,ja:\u0022\u5BA3\u8A00 intent  \u79FB\u52D5 \u6700\u521D \u307E\u305F\u306F 2\u756A\u76EE\u0022,pl:\u0022Zadeklaruj zamiar, aby i\u015B\u0107 pierwszy l