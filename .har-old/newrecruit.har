as\u0022,hr:\u0022Prikaz mapa\u0022,cz:\u0022Folder View\u0022,sk:\u0022Folder View\u0022,gr:\u0022\u03A6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03A0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE\u0022,ru:\u0022\u041F\u0430\u043F\u043A\u0430 \u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0022,ko:\u0022Folder View\u0022},TTe={en:\u0022Create Folder\u0022,fr:\u0022Cr\u00E9er un Dossier\u0022,es:\u0022Crear Carpeta\u0022,cn:\u0022\u521B\u5EFA\u6587\u4EF6\u5939\u0022,it:\u0022Crea Cartella\u0022,de:\u0022Create Folder\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u4F5C\u6210\u0022,pl:\u0022Utw\u00F3rz Folder\u0022,pt:\u0022Criar Pasta\u0022,hr:\u0022Kreiraj mapu\u0022,cz:\u0022Create Folder\u0022,sk:\u0022Create Folder\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u041F\u0430\u043F\u043A\u0430\u0022,ko:\u0022Folder \uC0DD\uC131\u0022},NTe={en:\u0022Enter folder name:\u0022,fr:\u0022Entrez le nom du dossier :\u0022,es:\u0022Ingrese el nombre de la carpeta:\u0022,cn:\u0022\u8F93\u5165\u6587\u4EF6\u5939\u540D\u79F0\uFF1A\u0022,it:\u0022Inserisci nome cartella:\u0022,de:\u0022Enter folder name:\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u540D\u3092\u5165\u529B:\u0022,pl:\u0022Wprowad\u017A nazw\u0119 folderu:\u0022,pt:\u0022Insira o nome da pasta:\u0022,hr:\u0022Unesite naziv mape\u0022,cz:\u0022Enter folder name:\u0022,sk:\u0022Enter folder name:\u0022,gr:\u0022\u0395\u03B9\u03C3\u03B1\u03B3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u0430\u043F\u043A\u0438\u0022,ko:\u0022Enter folder name:\u0022},FTe={en:\u0022Folder \u0027{name}\u0027 created\u0022,fr:\u0022Dossier \u0027{name}\u0027 cr\u00E9\u00E9\u0022,es:\u0022Carpeta \u0027{name}\u0027 creada\u0022,cn:\u0022\u6587\u4EF6\u5939 \u0027{name}\u0027 \u5DF2\u521B\u5EFA\u0022,it:\u0022Cartella \u0027{name}\u0027 creata\u0022,de:\u0022Folder \u0027{name}\u0027 created\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u304C\u4F5C\u6210\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022Folder \u0027{name}\u0027 utworzony\u0022,pt:\u0022Pasta \u0027{name}\u0027 criada\u0022,hr:\u0022Mapa kreirana\u0022,cz:\u0022Folder \u0027{name}\u0027 created\u0022,sk:\u0022Folder \u0027{name}\u0027 created\u0022,gr:\u0022\u039F \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03B8\u03B7\u03BA\u03B5\u0022,ru:\u0022\u041F\u0430\u043F\u043A\u0430 \u0027{\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435}\u0027 \u0421\u043E\u0437\u0434\u0430\u043D\u043E\u0022,ko:\u0022Folder \u0027{name}\u0027 created\u0022},RTe={en:\u0022Folder \u0027{name}\u0027 already exists\u0022,fr:\u0022Le dossier \u0027{name}\u0027 existe d\u00E9j\u00E0\u0022,es:\u0022La carpeta \u0027{name}\u0027 ya existe\u0022,cn:\u0022\u6587\u4EF6\u5939 \u0027{name}\u0027 \u5DF2\u5B58\u5728\u0022,it:\u0022La cartella \u0027{name}\u0027 esiste gi\u00E0\u0022,de:\u0022Folder \u0027{name}\u0027 already exists\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u306F\u3059\u3067\u306B\u5B58\u5728\u3057\u307E\u3059\u0022,pl:\u0022Folder \u0027{name}\u0027 ju\u017C istnieje\u0022,pt:\u0022Pasta \u0027{name}\u0027 j\u00E1 existe\u0022,hr:\u0022Mapa ve\u0107 postoji\u0022,cz:\u0022Folder \u0027{name}\u0027 already exists\u0022,sk:\u0022Folder \u0027{name}\u0027 already exists\u0022,gr:\u0022\u039F \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03AE\u03B4\u03B7\u0022,ru:\u0022\u041F\u0430\u043F\u043A\u0430 \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442\u0022,ko:\u0022Folder \u0027{name}\u0027 already exists\u0022},MTe={en:\u0022Use \u0027Move to folder\u0027 to add lists\u0022,fr:\u0022Utilisez \u0027D\u00E9placer vers dossier\u0027 pour ajouter des listes\u0022,es:\u0022Use \u0027Mover a carpeta\u0027 para agregar listas\u0022,cn:\u0022\u4F7F\u7528\u0027\u79FB\u81F3\u6587\u4EF6\u5939\u0027\u6DFB\u52A0\u5217\u8868\u0022,it:\u0022Usa \u0027Sposta nella cartella\u0027 per aggiungere liste\u0022,de:\u0022Use \u0027Move to folder\u0027 to add lists\u0022,ja:\u0022\u0027\u30D5\u30A9\u30EB\u30C0\u30FC\u306B\u79FB\u52D5\u0027 \u3092\u4F7F\u7528\u3057\u3066\u30EA\u30B9\u30C8\u3092\u8FFD\u52A0\u0022,pl:\u0022U\u017Cyj \u0027Przenie\u015B do folderu\u0027, aby doda\u0107 listy\u0022,pt:\u0022Use \u0027Mover para pasta\u0027 para adicionar listas\u0022,hr:\u0022Premjesti liste u mapu\u0022,cz:\u0022Use \u0027Move to folder\u0027 to add lists\u0022,sk:\u0022Use \u0027Move to folder\u0027 to add lists\u0022,gr:\u0022\u039C\u03B5\u03C4\u03B1\u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD \u03C3\u03B5 \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u0022,ru:\u0022Use \u0027\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C to \u041F\u0430\u043F\u043A\u0430\u0027 to \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0421\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022Use \u0027Move to folder\u0027 to add lists\u0022},UTe={en:\u0022Rename folder\u0022,fr:\u0022Renommer le dossier\u0022,es:\u0022Renombrar carpeta\u0022,cn:\u0022\u91CD\u547D\u540D\u6587\u4EF6\u5939\u0022,it:\u0022Rinomina cartella\u0022,de:\u0022Rename folder\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u540D\u3092\u5909\u66F4\u0022,pl:\u0022Zmie\u0144 nazw\u0119 folderu\u0022,pt:\u0022Renomear pasta\u0022,hr:\u0022Preimenuj mapu\u0022,cz:\u0022Rename folder\u0022,sk:\u0022Rename folder\u0022,gr:\u0022\u039C\u03B5\u03C4\u03BF\u03BD\u03BF\u03BC\u03B1\u03C3\u03AF\u03B1 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C \u041F\u0430\u043F\u043A\u0430\u0022,ko:\u0022Rename folder\u0022},xTe={en:\u0022Delete folder\u0022,fr:\u0022Supprimer le dossier\u0022,es:\u0022Eliminar carpeta\u0022,cn:\u0022\u5220\u9664\u6587\u4EF6\u5939\u0022,it:\u0022Elimina cartella\u0022,de:\u0022Delete folder\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u524A\u9664\u0022,pl:\u0022Usu\u0144 folder\u0022,pt:\u0022Excluir pasta\u0022,hr:\u0022Obri\u0161i mapu\u0022,cz:\u0022Delete folder\u0022,sk:\u0022Delete folder\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u041F\u0430\u043F\u043A\u0430\u0022,ko:\u0022folder \uC0AD\uC81C\u0022},QTe={en:\u0022Hide folder\u0022,fr:\u0022Masquer le dossier\u0022,es:\u0022Ocultar carpeta\u0022,cn:\u0022\u9690\u85CF\u6587\u4EF6\u5939\u0022,it:\u0022Nascondi cartella\u0022,de:\u0022Ordner ausblenden\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u975E\u8868\u793A\u0022,pl:\u0022Ukryj folder\u0022,pt:\u0022Ocultar pasta\u0022,hr:\u0022Sakrij mapu\u0022,cz:\u0022Skr\u00FDt slo\u017Eku\u0022,sk:\u0022Skry\u0165 prie\u010Dinok\u0022,gr:\u0022\u0391\u03C0\u03CC\u03BA\u03C1\u03C5\u03C8\u03B7 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0421\u043A\u0440\u044B\u0442\u044C \u043F\u0430\u043F\u043A\u0443\u0022,ko:\u0022\uD3F4\uB354 \uC228\uAE30\uAE30\u0022},LTe={en:\u0022Show folder\u0022,fr:\u0022Afficher le dossier\u0022,es:\u0022Mostrar carpeta\u0022,cn:\u0022\u663E\u793A\u6587\u4EF6\u5939\u0022,it:\u0022Mostra cartella\u0022,de:\u0022Ordner anzeigen\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u8868\u793A\u0022,pl:\u0022Poka\u017C folder\u0022,pt:\u0022Mostrar pasta\u0022,hr:\u0022Prika\u017Ei mapu\u0022,cz:\u0022Zobrazit slo\u017Eku\u0022,sk:\u0022Zobrazi\u0165 prie\u010Dinok\u0022,gr:\u0022\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u0430\u043F\u043A\u0443\u0022,ko:\u0022\uD3F4\uB354 \uD45C\uC2DC\u0022},DTe={en:\u0022Enter new folder name:\u0022,fr:\u0022Entrez le nouveau nom du dossier :\u0022,es:\u0022Ingrese el nuevo nombre de la carpeta:\u0022,cn:\u0022\u8F93\u5165\u65B0\u7684\u6587\u4EF6\u5939\u540D\u79F0\uFF1A\u0022,it:\u0022Inserisci nuovo nome cartella:\u0022,de:\u0022Enter new folder name:\u0022,ja:\u0022\u65B0\u3057\u3044\u30D5\u30A9\u30EB\u30C0\u30FC\u540D\u3092\u5165\u529B:\u0022,pl:\u0022Wprowad\u017A now\u0105 nazw\u0119 folderu:\u0022,pt:\u0022Insira o novo nome da pasta:\u0022,hr:\u0022Unesite novi naziv mape\u0022,cz:\u0022Enter new folder name:\u0022,sk:\u0022Enter new folder name:\u0022,gr:\u0022\u0395\u03B9\u03C3\u03B1\u03B3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03BD\u03AD\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u043E\u0432\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u0430\u043F\u043A\u0438\u0022,ko:\u0022Enter new folder name:\u0022},OTe={en:\u0022Folder \u0027{oldName}\u0027 renamed to \u0027{newName}\u0027\u0022,fr:\u0022Dossier \u0027{oldName}\u0027 renomm\u00E9 en \u0027{newName}\u0027\u0022,es:\u0022Carpeta \u0027{oldName}\u0027 renombrada a \u0027{newName}\u0027\u0022,cn:\u0022\u6587\u4EF6\u5939 \u0027{oldName}\u0027 \u5DF2\u91CD\u547D\u540D\u4E3A \u0027{newName}\u0027\u0022,it:\u0022Cartella \u0027{oldName}\u0027 rinominata in \u0027{newName}\u0027\u0022,de:\u0022Folder \u0027{oldName}\u0027 renamed to \u0027{newName}\u0027\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{oldName}\u0027 \u304C \u0027{newName}\u0027 \u306B\u540D\u524D\u5909\u66F4\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022Folder \u0027{oldName}\u0027 przemianowany na \u0027{newName}\u0027\u0022,pt:\u0022Pasta \u0027{oldName}\u0027 renomeada para \u0027{newName}\u0027\u0022,hr:\u0022Mapa preimenovana\u0022,cz:\u0022Folder \u0027{oldName}\u0027 renamed to \u0027{newName}\u0027\u0022,sk:\u0022Folder \u0027{oldName}\u0027 renamed to \u0027{newName}\u0027\u0022,gr:\u0022\u039F \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03BC\u03B5\u03C4\u03BF\u03BD\u03BF\u03BC\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5\u0022,ru:\u0022\u041F\u0430\u043F\u043A\u0430 \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0430\u0022,ko:\u0022Folder \u0027{oldName}\u0027 renamed to \u0027{newName}\u0027\u0022},HTe={en:\u0022Delete folder \u0027{name}\u0027? {count} lists will be moved to Default.\u0022,fr:\u0022Supprimer le dossier \u0027{name}\u0027 ? {count} listes seront d\u00E9plac\u00E9es vers D\u00E9faut.\u0022,es:\u0022\u00BFEliminar carpeta \u0027{name}\u0027? {count} listas se mover\u00E1n a Predeterminado.\u0022,cn:\u0022\u5220\u9664\u6587\u4EF6\u5939 \u0027{name}\u0027\uFF1F{count} \u4E2A\u5217\u8868\u5C06\u79FB\u81F3\u9ED8\u8BA4\u6587\u4EF6\u5939\u3002\u0022,it:\u0022Eliminare cartella \u0027{name}\u0027? {count} liste verranno spostate in Predefinito.\u0022,de:\u0022Delete folder \u0027{name}\u0027? {count} lists will be moved to Default.\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u3092\u524A\u9664\u3057\u307E\u3059\u304B\uFF1F{count} \u500B\u306E\u30EA\u30B9\u30C8\u304C\u30C7\u30D5\u30A9\u30EB\u30C8\u306B\u79FB\u52D5\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Usun\u0105\u0107 folder \u0027{name}\u0027? {count} list zostanie przeniesionych do Domy\u015Blnego.\u0022,pt:\u0022Excluir pasta \u0027{name}\u0027? {count} listas ser\u00E3o movidas para Padr\u00E3o.\u0022,hr:\u0022Jeste li sigurni da \u017Eelite obrisati ovu mapu?\u0022,cz:\u0022Delete folder \u0027{name}\u0027? {count} lists will be moved to Default.\u0022,sk:\u0022Delete folder \u0027{name}\u0027? {count} lists will be moved to Default.\u0022,gr:\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03B9 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC\u03BD \u03C4\u03BF\u03BD \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF;\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u044D\u0442\u0443 \u043F\u0430\u043F\u043A\u0443?\u0022,ko:\u0022folder \u0027{name}\u0027? {count} lists will be moved to Default. \uC0AD\uC81C\u0022},GTe={en:\u0022Folder \u0027{name}\u0027 deleted. {count} lists moved to Default.\u0022,fr:\u0022Dossier \u0027{name}\u0027 supprim\u00E9. {count} listes d\u00E9plac\u00E9es vers D\u00E9faut.\u0022,es:\u0022Carpeta \u0027{name}\u0027 eliminada. {count} listas movidas a Predeterminado.\u0022,cn:\u0022\u6587\u4EF6\u5939 \u0027{name}\u0027 \u5DF2\u5220\u9664\u3002{count} \u4E2A\u5217\u8868\u5DF2\u79FB\u81F3\u9ED8\u8BA4\u6587\u4EF6\u5939\u3002\u0022,it:\u0022Cartella \u0027{name}\u0027 eliminata. {count} liste spostate in Predefinito.\u0022,de:\u0022Folder \u0027{name}\u0027 deleted. {count} lists moved to Default.\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u304C\u524A\u9664\u3055\u308C\u307E\u3057\u305F\u3002{count} \u500B\u306E\u30EA\u30B9\u30C8\u304C\u30C7\u30D5\u30A9\u30EB\u30C8\u306B\u79FB\u52D5\u3055\u308C\u307E\u3057\u305F\u3002\u0022,pl:\u0022Folder \u0027{name}\u0027 usuni\u0119ty. {count} list przeniesiono do Domy\u015Blnego.\u0022,pt:\u0022Pasta \u0027{name}\u0027 exclu\u00EDda. {count} listas movidas para Padr\u00E3o.\u0022,hr:\u0022Mapa obrisana\u0022,cz:\u0022Folder \u0027{name}\u0027 deleted. {count} lists moved to Default.\u0022,sk:\u0022Folder \u0027{name}\u0027 deleted. {count} lists moved to Default.\u0022,gr:\u0022\u039F \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5\u0022,ru:\u0022\u041F\u0430\u043F\u043A\u0430 \u0443\u0434\u0430\u043B\u0435\u043D\u0430\u0022,ko:\u0022Folder \u0027{name}\u0027 deleted. {count} lists moved to Default.\u0022},VTe={en:\u0022Delete folder \u0027{name}\u0027? This folder contains {count} lists.\u0022,fr:\u0022Supprimer le dossier \u0027{name}\u0027 ? Ce dossier contient {count} listes.\u0022,es:\u0022\u00BFEliminar carpeta \u0027{name}\u0027? Esta carpeta contiene {count} listas.\u0022,cn:\u0022\u5220\u9664\u6587\u4EF6\u5939 \u0027{name}\u0027\uFF1F\u6B64\u6587\u4EF6\u5939\u5305\u542B {count} \u4E2A\u5217\u8868\u3002\u0022,it:\u0022Eliminare cartella \u0027{name}\u0027? Questa cartella contiene {count} liste.\u0022,de:\u0022Ordner \u0027{name}\u0027 l\u00F6schen? Dieser Ordner enth\u00E4lt {count} Listen.\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u3092\u524A\u9664\u3057\u307E\u3059\u304B\uFF1F\u3053\u306E\u30D5\u30A9\u30EB\u30C0\u30FC\u306B\u306F {count} \u500B\u306E\u30EA\u30B9\u30C8\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Usun\u0105\u0107 folder \u0027{name}\u0027? Ten folder zawiera {count} list.\u0022,pt:\u0022Excluir pasta \u0027{name}\u0027? Esta pasta cont\u00E9m {count} listas.\u0022,hr:\u0022Obrisati mapu \u0027{name}\u0027? Ova mapa sadr\u017Ei {count} popisa.\u0022,cz:\u0022Smazat slo\u017Eku \u0027{name}\u0027? Tato slo\u017Eka obsahuje {count} seznam\u016F.\u0022,sk:\u0022Odstr\u00E1ni\u0165 prie\u010Dinok \u0027{name}\u0027? Tento prie\u010Dinok obsahuje {count} zoznamov.\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5 \u0027{name}\u0027; \u0391\u03C5\u03C4\u03CC\u03C2 \u03BF \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u03C0\u03B5\u03C1\u03B9\u03AD\u03C7\u03B5\u03B9 {count} \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2.\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u043F\u0430\u043F\u043A\u0443 \u0027{name}\u0027? \u0412 \u044D\u0442\u043E\u0439 \u043F\u0430\u043F\u043A\u0435 {count} \u0441\u043F\u0438\u0441\u043A\u043E\u0432.\u0022,ko:\u0022\u0027{name}\u0027 \uD3F4\uB354\uB97C \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C? \uC774 \uD3F4\uB354\uC5D0\uB294 {count}\uAC1C\uC758 \uBAA9\uB85D\uC774 \uC788\uC2B5\uB2C8\uB2E4.\u0022},WTe={en:\u0022Delete folder and all lists\u0022,fr:\u0022Supprimer le dossier et toutes les listes\u0022,es:\u0022Eliminar carpeta y todas las listas\u0022,cn:\u0022\u5220\u9664\u6587\u4EF6\u5939\u548C\u6240\u6709\u5217\u8868\u0022,it:\u0022Elimina cartella e tutte le liste\u0022,de:\u0022Ordner und alle Listen l\u00F6schen\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3068\u3059\u3079\u3066\u306E\u30EA\u30B9\u30C8\u3092\u524A\u9664\u0022,pl:\u0022Usu\u0144 folder i wszystkie listy\u0022,pt:\u0022Excluir pasta e todas as listas\u0022,hr:\u0022Obri\u0161i mapu i sve popise\u0022,cz:\u0022Smazat slo\u017Eku a v\u0161echny seznamy\u0022,sk:\u0022Odstr\u00E1ni\u0165 prie\u010Dinok a v\u0161etky zoznamy\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03CC\u03BB\u03C9\u03BD \u03C4\u03C9\u03BD \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u043F\u0430\u043F\u043A\u0443 \u0438 \u0432\u0441\u0435 \u0441\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022\uD3F4\uB354 \uBC0F \uBAA8\uB4E0 \uBAA9\uB85D \uC0AD\uC81C\u0022},YTe={en:\u0022Delete folder only\u0022,fr:\u0022Supprimer le dossier uniquement\u0022,es:\u0022Eliminar solo la carpeta\u0022,cn:\u0022\u4EC5\u5220\u9664\u6587\u4EF6\u5939\u0022,it:\u0022Elimina solo la cartella\u0022,de:\u0022Nur Ordner l\u00F6schen\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u306E\u307F\u524A\u9664\u0022,pl:\u0022Usu\u0144 tylko folder\u0022,pt:\u0022Excluir apenas a pasta\u0022,hr:\u0022Obri\u0161i samo mapu\u0022,cz:\u0022Smazat pouze slo\u017Eku\u0022,sk:\u0022Odstr\u00E1ni\u0165 iba prie\u010Dinok\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03BC\u03CC\u03BD\u03BF \u03C4\u03BF\u03C5 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0430\u043F\u043A\u0443\u0022,ko:\u0022\uD3F4\uB354\uB9CC \uC0AD\uC81C\u0022},KTe={en:\u0022Folder \u0027{name}\u0027 and {count} lists deleted.\u0022,fr:\u0022Dossier \u0027{name}\u0027 et {count} listes supprim\u00E9s.\u0022,es:\u0022Carpeta \u0027{name}\u0027 y {count} listas eliminadas.\u0022,cn:\u0022\u6587\u4EF6\u5939 \u0027{name}\u0027 \u548C {count} \u4E2A\u5217\u8868\u5DF2\u5220\u9664\u3002\u0022,it:\u0022Cartella \u0027{name}\u0027 e {count} liste eliminate.\u0022,de:\u0022Ordner \u0027{name}\u0027 und {count} Listen gel\u00F6scht.\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{name}\u0027 \u3068 {count} \u500B\u306E\u30EA\u30B9\u30C8\u304C\u524A\u9664\u3055\u308C\u307E\u3057\u305F\u3002\u0022,pl:\u0022Folder \u0027{name}\u0027 i {count} list zosta\u0142o usuni\u0119tych.\u0022,pt:\u0022Pasta \u0027{name}\u0027 e {count} listas exclu\u00EDdas.\u0022,hr:\u0022Mapa \u0027{name}\u0027 i {count} popisa obrisano.\u0022,cz:\u0022Slo\u017Eka \u0027{name}\u0027 a {count} seznam\u016F smaz\u00E1no.\u0022,sk:\u0022Prie\u010Dinok \u0027{name}\u0027 a {count} zoznamov odstr\u00E1nen\u00FDch.\u0022,gr:\u0022\u039F \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u03C2 \u0027{name}\u0027 \u03BA\u03B1\u03B9 {count} \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B1\u03BD.\u0022,ru:\u0022\u041F\u0430\u043F\u043A\u0430 \u0027{name}\u0027 \u0438 {count} \u0441\u043F\u0438\u0441\u043A\u043E\u0432 \u0443\u0434\u0430\u043B\u0435\u043D\u044B.\u0022,ko:\u0022\u0027{name}\u0027 \uD3F4\uB354\uC640 {count}\uAC1C\uC758 \uBAA9\uB85D\uC774 \uC0AD\uC81C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\u0022},qTe={en:\u0022Select folder:\u0022,fr:\u0022S\u00E9lectionnez le dossier :\u0022,es:\u0022Seleccionar carpeta:\u0022,cn:\u0022\u9009\u62E9\u6587\u4EF6\u5939\uFF1A\u0022,it:\u0022Seleziona cartella:\u0022,de:\u0022Select folder:\u0022,ja:\u0022\u30D5\u30A9\u30EB\u30C0\u30FC\u3092\u9078\u629E:\u0022,pl:\u0022Wybierz folder:\u0022,pt:\u0022Selecionar pasta:\u0022,hr:\u0022Odaberi mapu\u0022,cz:\u0022Select folder:\u0022,sk:\u0022Select folder:\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u041F\u0430\u043F\u043A\u0430:\u0022,ko:\u0022folder: \uC120\uD0DD\u0022},JTe={en:\u0022Enter existing folder name or type a new one:\u0022,fr:\u0022Entrez un nom de dossier existant ou tapez-en un nouveau :\u0022,es:\u0022Ingrese el nombre de una carpeta existente o escriba uno nuevo:\u0022,cn:\u0022\u8F93\u5165\u73B0\u6709\u6587\u4EF6\u5939\u540D\u79F0\u6216\u8F93\u5165\u65B0\u540D\u79F0\uFF1A\u0022,it:\u0022Inserisci nome cartella esistente o digitane uno nuovo:\u0022,de:\u0022Enter existing folder name or type a new one:\u0022,ja:\u0022\u65E2\u5B58\u306E\u30D5\u30A9\u30EB\u30C0\u30FC\u540D\u3092\u5165\u529B\u3059\u308B\u304B\u3001\u65B0\u3057\u3044\u540D\u524D\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044:\u0022,pl:\u0022Wprowad\u017A nazw\u0119 istniej\u0105cego folderu lub wpisz now\u0105:\u0022,pt:\u0022Insira o nome de uma pasta existente ou digite um novo:\u0022,hr:\u0022Unesite naziv mape ili odaberite postoje\u0107u\u0022,cz:\u0022Enter existing folder name or type a new one:\u0022,sk:\u0022Enter existing folder name or type a new one:\u0022,gr:\u0022\u0395\u03B9\u03C3\u03B1\u03B3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C6\u03B1\u03BA\u03AD\u03BB\u03BF\u03C5 \u03AE \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5\u0022,ru:\u0022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u0430\u043F\u043A\u0438 \u0438\u043B\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435\u0022,ko:\u0022Enter existing folder name or type a new one:\u0022},$Te={en:\u0022\u0027{listName}\u0027 moved to folder \u0027{folderName}\u0027\u0022,fr:\u0022\u0027{listName}\u0027 d\u00E9plac\u00E9 vers le dossier \u0027{folderName}\u0027\u0022,es:\u0022\u0027{listName}\u0027 movido a la carpeta \u0027{folderName}\u0027\u0022,cn:\u0022\u0027{listName}\u0027 \u5DF2\u79FB\u81F3\u6587\u4EF6\u5939 \u0027{folderName}\u0027\u0022,it:\u0022\u0027{listName}\u0027 spostato nella cartella \u0027{folderName}\u0027\u0022,de:\u0022\u0027{listName}\u0027 moved to folder \u0027{folderName}\u0027\u0022,ja:\u0022\u0027{listName}\u0027 \u304C\u30D5\u30A9\u30EB\u30C0\u30FC \u0027{folderName}\u0027 \u306B\u79FB\u52D5\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022\u0027{listName}\u0027 przeniesione do folderu \u0027{folderName}\u0027\u0022,pt:\u0022\u0027{listName}\u0027 movida para a pasta \u0027{folderName}\u0027\u0022,hr:\u0022Lista premje\u0161tena u mapu\u0022,cz:\u0022\u0027{listName}\u0027 moved to folder \u0027{folderName}\u0027\u0022,sk:\u0022\u0027{listName}\u0027 moved to folder \u0027{folderName}\u0027\u0022,gr:\u0022\u0397 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03BC\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C4\u03BF\u03BD \u03C6\u03AC\u03BA\u03B5\u03BB\u03BF\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D \u0432 \u043F\u0430\u043F\u043A\u0443\u0022,ko:\u0022\u0027{listName}\u0027 moved to folder \u0027{folderName}\u0027\u0022},ZTe={en:\u0022The Game Assistant for Warhammer 40k is in TESTING PHASE, there may be bugs! Please report any problem on Discord or using the Report Issue function, selecting New Recruit Issue.\u0022,fr:\u0022L\u0027Assistant de Jeu pour Warhammer 40k est en PHASE DE TEST, il peut y avoir des bugs ! Veuillez signaler tout probl\u00E8me sur Discord ou en utilisant la fonction Signaler un Probl\u00E8me, en s\u00E9lectionnant New Recruit Issue.\u0022,es:\u0022El Asistente de Juego para Warhammer 40k est\u00E1 en FASE DE PRUEBA, \u00A1puede haber errores! Por favor, informe cualquier problema en Discord o utilizando la funci\u00F3n Informar Problema, seleccionando New Recruit Issue.\u0022,cn:\u0022Warhammer 40k\u7684\u6E38\u620F\u52A9\u624B\u5904\u4E8E\u6D4B\u8BD5\u9636\u6BB5\uFF0C\u53EF\u80FD\u5B58\u5728\u9519\u8BEF\uFF01\u8BF7\u5728Discord\u4E0A\u62A5\u544A\u4EFB\u4F55\u95EE\u9898\u6216\u4F7F\u7528\u62A5\u544A\u95EE\u9898\u529F\u80FD\uFF0C\u9009\u62E9New Recruit Issue\u3002\u0022,it:\u0022L\u0027Assistente di Gioco per Warhammer 40k \u00E8 in FASE DI TEST, potrebbero esserci bug! Si prega di segnalare qualsiasi problema su Discord o utilizzando la funzione Segnala Problema, selezionando New Recruit Issue.\u0022,de:\u0022Der Spielassistent f\u00FCr Warhammer 40k befindet sich in der TESTPHASE, es k\u00F6nnen Fehler auftreten! Bitte melden Sie jedes Problem auf Discord oder \u00FCber die Funktion Problem melden, indem Sie New Recruit Issue ausw\u00E4hlen.\u0022,ja:\u0022Warhammer 40k\u306E\u30B2\u30FC\u30E0\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u306F\u30C6\u30B9\u30C8\u6BB5\u968E\u306B\u3042\u308A\u3001\u30D0\u30B0\u304C\u5B58\u5728\u3059\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\uFF01Discord\u3067\u554F\u984C\u3092\u5831\u544A\u3059\u308B\u304B\u3001\u554F\u984C\u3092\u5831\u544A\u3059\u308B\u6A5F\u80FD\u3092\u4F7F\u7528\u3057\u3066New Recruit Issue\u3092\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Asystent Gry dla Warhammer 40k jest w FAZIE TESTOWEJ, mog\u0105 wyst\u0105pi\u0107 b\u0142\u0119dy! Prosz\u0119 zg\u0142asza\u0107 wszelkie problemy na Discord lub za pomoc\u0105 funkcji Zg\u0142o\u015B Problem, wybieraj\u0105c New Recruit Issue.\u0022,pt:\u0022O Assistente de Jogo para Warhammer 40k est\u00E1 em FASE DE TESTE, pode haver bugs! Por favor, relate qualquer problema no Discord ou usando a fun\u00E7\u00E3o Relatar Problema, selecionando New Recruit Issue.\u0022,hr:\u0022Warhammer 40,000 10. izdanje je u beta verziji\u0022,cz:\u0022The Game Assistant for Warhammer 40k is in TESTING PHASE, there may be bugs! Please report any problem on Discord or using the Report Issue function, selecting New Recruit Issue.\u0022,sk:\u0022The Game Assistant for Warhammer 40k is in TESTING PHASE, there may be bugs! Please report any problem on Discord or using the Report Issue function, selecting New Recruit Issue.\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 Beta: \u0391\u03C5\u03C4\u03AE \u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AE\u0022,ru:\u0022\u0411\u0435\u0442\u0430-\u0432\u0435\u0440\u0441\u0438\u044F \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430 \u0434\u043B\u044F WH40K\u0022,ko:\u0022The Game Assistant for Warhammer 40k is in TESTING PHASE, there may be bugs! Please report any problem on Discord or using the Report Issue function, selecting New Recruit Issue.\u0022},XTe={en:\u0022Game Options\u0022,fr:\u0022Options de Jeu\u0022,es:\u0022Opciones de Juego\u0022,cn:\u0022\u6E38\u620F\u9009\u9879\u0022,it:\u0022Opzioni di Gioco\u0022,de:\u0022Spieloptionen\u0022,ja:\u0022\u30B2\u30FC\u30E0\u30AA\u30D7\u30B7\u30E7\u30F3\u0022,pl:\u0022Opcje Gry\u0022,pt:\u0022Op\u00E7\u00F5es de Jogo\u0022,hr:\u0022Opcije igre\u0022,cz:\u0022Game Options\u0022,sk:\u0022Game Options\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u0418\u0433\u0440\u0430 \u041E\u043F\u0446\u0438\u0438\u0022,ko:\u0022Game Options\u0022},eNe={en:\u0022Normal Scoring\u0022,fr:\u0022Score Normal\u0022,es:\u0022Puntuaci\u00F3n Normal\u0022,cn:\u0022\u6B63\u5E38\u8BA1\u5206\u0022,it:\u0022Punteggio Normale\u0022,de:\u0022Normale Punktevergabe\u0022,ja:\u0022\u901A\u5E38\u30B9\u30B3\u30A2\u0022,pl:\u0022Normalne Punktowanie\u0022,pt:\u0022Pontua\u00E7\u00E3o Normal\u0022,hr:\u0022Normalno bodovanje\u0022,cz:\u0022Normal Scoring\u0022,sk:\u0022Normal Scoring\u0022,gr:\u0022\u039A\u03B1\u03BD\u03BF\u03BD\u03B9\u03BA\u03AE \u03B2\u03B1\u03B8\u03BC\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u0022,ru:\u0022\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0447\u0435\u0442 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022Normal Scoring\u0022},tNe={en:\u0022WTC Scoring\u0022,fr:\u0022Score WTC\u0022,es:\u0022Puntuaci\u00F3n WTC\u0022,cn:\u0022WTC\u8BA1\u5206\u0022,it:\u0022Punteggio WTC\u0022,de:\u0022WTC-Punktevergabe\u0022,ja:\u0022WTC\u30B9\u30B3\u30A2\u0022,pl:\u0022Punktowanie WTC\u0022,pt:\u0022Pontua\u00E7\u00E3o WTC\u0022,hr:\u0022WTC bodovanje\u0022,cz:\u0022WTC Scoring\u0022,sk:\u0022WTC Scoring\u0022,gr:\u0022\u0392\u03B1\u03B8\u03BC\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7 WTC\u0022,ru:\u0022WTC \u041F\u043E\u0434\u0441\u0447\u0451\u0442 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022WTC Scoring\u0022},rNe={en:\u0022Show Command Point counters\u0022,fr:\u0022Afficher les compteurs de Points de Commandement\u0022,es:\u0022Mostrar contadores de Puntos de Mando\u0022,cn:\u0022\u663E\u793A\u6307\u6325\u70B9\u8BA1\u6570\u5668\u0022,it:\u0022Mostra contatori Punti Comando\u0022,de:\u0022Befehlspunkte-Z\u00E4hler anzeigen\u0022,ja:\u0022\u30B3\u30DE\u30F3\u30C9\u30DD\u30A4\u30F3\u30C8\u30AB\u30A6\u30F3\u30BF\u30FC\u3092\u8868\u793A\u0022,pl:\u0022Poka\u017C liczniki Punkt\u00F3w Dowodzenia\u0022,pt:\u0022Mostrar contadores de Pontos de Comando\u0022,hr:\u0022Prika\u017Ei zapovjedne bodove\u0022,cz:\u0022Show Command Point counters\u0022,sk:\u0022Show Command Point counters\u0022,gr:\u0022\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD \u03B4\u03B9\u03BF\u03AF\u03BA\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0435 \u043E\u0447\u043A\u0438\u0022,ko:\u0022Command Point counters \uD45C\uC2DC\u0022},nNe={en:\u0022Show Extra Points counter\u0022,fr:\u0022Afficher le compteur de Points Suppl\u00E9mentaires\u0022,es:\u0022Mostrar contador de Puntos Extra\u0022,cn:\u0022\u663E\u793A\u989D\u5916\u79EF\u5206\u8BA1\u6570\u5668\u0022,it:\u0022Mostra contatore Punti Extra\u0022,de:\u0022Extrapunkte-Z\u00E4hler anzeigen\u0022,ja:\u0022\u8FFD\u52A0\u30DD\u30A4\u30F3\u30C8\u30AB\u30A6\u30F3\u30BF\u30FC\u3092\u8868\u793A\u0022,pl:\u0022Poka\u017C licznik Dodatkowych Punkt\u00F3w\u0022,pt:\u0022Mostrar contador de Pontos Extra\u0022,hr:\u0022Prika\u017Ei dodatne bodove\u0022,cz:\u0022Show Extra Points counter\u0022,sk:\u0022Show Extra Points counter\u0022,gr:\u0022\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD\u0022,ru:\u0022\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043E\u0447\u043A\u0438\u0022,ko:\u0022Extra Points counter \uD45C\uC2DC\u0022},iNe={en:\u0022Total Victory Points conceded\u0022,fr:\u0022Total de Points de Victoire conc\u00E9d\u00E9s\u0022,es:\u0022Total de Puntos de Victoria concedidos\u0022,cn:\u0022\u8BA9\u51FA\u7684\u603B\u80DC\u5229\u70B9\u6570\u0022,it:\u0022Punti Vittoria totali concessi\u0022,de:\u0022Gesamtzahl der abgetretenen Siegpunkte\u0022,ja:\u0022\u8B72\u6B69\u3057\u305F\u52DD\u5229\u70B9\u306E\u5408\u8A08\u0022,pl:\u0022\u0141\u0105czna liczba ust\u0105pionych Punkt\u00F3w Zwyci\u0119stwa\u0022,pt:\u0022Total de Pontos de Vit\u00F3ria concedidos\u0022,hr:\u0022Ukupno VP prepu\u0161teno\u0022,cz:\u0022Total Victory Points conceded\u0022,sk:\u0022Total Victory Points conceded\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03BF\u03BB\u03BF \u03C0\u03B1\u03C1\u03B1\u03C7\u03C9\u03C1\u03B7\u03BC\u03AD\u03BD\u03C9\u03BD VP\u0022,ru:\u0022\u0412\u0441\u0435\u0433\u043E \u0441\u0434\u0430\u043D\u043D\u044B\u0445 \u041E\u041F\u0022,ko:\u0022Total Victory Points conceded\u0022},sNe={en:\u0022Note: enter the extra points earned by your OPPONENT here as they are added to your total of units lost\u0022,fr:\u0022Note : entrez ici les points suppl\u00E9mentaires gagn\u00E9s par votre ADVERSAIRE car ils sont ajout\u00E9s \u00E0 votre total d\u0027unit\u00E9s perdues\u0022,es:\u0022Nota: ingrese aqu\u00ED los puntos extra ganados por su OPONENTE ya que se agregan a su total de unidades perdidas\u0022,cn:\u0022\u6CE8\u610F\uFF1A\u5728\u6B64\u8F93\u5165\u60A8\u7684\u5BF9\u624B\u83B7\u5F97\u7684\u989D\u5916\u79EF\u5206\uFF0C\u56E0\u4E3A\u5B83\u4EEC\u4F1A\u6DFB\u52A0\u5230\u60A8\u4E22\u5931\u7684\u5355\u4F4D\u603B\u6570\u4E2D\u0022,it:\u0022Nota: inserisci qui i punti extra guadagnati dal tuo AVVERSARIO poich\u00E9 vengono aggiunti al tuo totale di unit\u00E0 perse\u0022,de:\u0022Hinweis: Geben Sie hier die von Ihrem GEGNER verdienten Extrapunkte ein, da diese zu Ihrer Gesamtzahl verlorener Einheiten addiert werden\u0022,ja:\u0022\u6CE8\u610F\uFF1A\u5BFE\u6226\u76F8\u624B\u304C\u7372\u5F97\u3057\u305F\u8FFD\u52A0\u30DD\u30A4\u30F3\u30C8\u3092\u3053\u3053\u306B\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u5931\u308F\u308C\u305F\u30E6\u30CB\u30C3\u30C8\u306E\u5408\u8A08\u306B\u8FFD\u52A0\u3055\u308C\u307E\u3059\u0022,pl:\u0022Uwaga: wprowad\u017A tutaj dodatkowe punkty zdobyte przez przeciwnika, poniewa\u017C s\u0105 one dodawane do ca\u0142kowitej liczby utraconych jednostek\u0022,pt:\u0022Nota: insira aqui os pontos extras ganhos pelo seu OPONENTE, pois eles s\u00E3o adicionados ao seu total de unidades perdidas\u0022,hr:\u0022Dodatni bodovi (npr. za slikanje)\u0022,cz:\u0022Note: enter the extra points earned by your OPPONENT here as they are added to your total of units lost\u0022,sk:\u0022Note: enter the extra points earned by your OPPONENT here as they are added to your total of units lost\u0022,gr:\u0022\u03A3\u03B7\u03BC\u03B5\u03AF\u03C9\u03C3\u03B7 \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD\u0022,ru:\u0022\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0447\u043A\u0430\u0445\u0022,ko:\u0022Note: enter the extra points earned by your OPPONENT here as they are added to your total of units lost\u0022},oNe={en:\u0022Change List\u0022,fr:\u0022Changer de Liste\u0022,es:\u0022Cambiar Lista\u0022,cn:\u00