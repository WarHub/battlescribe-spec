{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.58.1"},"browser":{"name":"chromium","version":"145.0.7632.6"},"entries":[{"startedDateTime":"2026-03-16T05:20:13.766Z","time":2.106,"request":{"method":"GET","url":"https://newrecruit.eu/","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"newrecruit.eu"},{"name":":method","value":"GET"},{"name":":path","value":"/"},{"name":":scheme","value":"https"},{"name":"accept","value":"text/html,application/xhtml\u002Bxml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"priority","value":"u=0, i"},{"name":"sec-ch-ua","value":"\u0022Not:A-Brand\u0022;v=\u002299\u0022, \u0022HeadlessChrome\u0022;v=\u0022145\u0022, \u0022Chromium\u0022;v=\u0022145\u0022"},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\u0022Linux\u0022"},{"name":"sec-fetch-dest","value":"document"},{"name":"sec-fetch-mode","value":"navigate"},{"name":"sec-fetch-site","value":"none"},{"name":"sec-fetch-user","value":"?1"},{"name":"upgrade-insecure-requests","value":"1"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/145.0.7632.6 Safari/537.36"}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{"status":301,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"content-length","value":"178"},{"name":"content-type","value":"text/html"},{"name":"date","value":"Mon, 16 Mar 2026 05:20:14 GMT"},{"name":"location","value":"https://www.newrecruit.eu/"},{"name":"server","value":"nginx/1.24.0 (Ubuntu)"}],"content":{"size":-1,"mimeType":"text/html"},"headersSize":-1,"bodySize":-1,"redirectURL":"https://www.newrecruit.eu/"},"cache":{},"timings":{"send":-1,"wait":-1,"receive":2.106}},{"startedDateTime":"2026-03-16T05:20:14.113Z","time":379.421,"request":{"method":"GET","url":"https://www.newrecruit.eu/","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"www.newrecruit.eu"},{"name":":method","value":"GET"},{"name":":path","value":"/"},{"name":":scheme","value":"https"},{"name":"accept","value":"text/html,application/xhtml\u002Bxml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"priority","value":"u=0, i"},{"name":"sec-ch-ua","value":"\u0022Not:A-Brand\u0022;v=\u002299\u0022, \u0022HeadlessChrome\u0022;v=\u0022145\u0022, \u0022Chromium\u0022;v=\u0022145\u0022"},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\u0022Linux\u0022"},{"name":"sec-fetch-dest","value":"document"},{"name":"sec-fetch-mode","value":"navigate"},{"name":"sec-fetch-site","value":"none"},{"name":"sec-fetch-user","value":"?1"},{"name":"upgrade-insecure-requests","value":"1"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/145.0.7632.6 Safari/537.36"}],"queryString":[],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-encoding","value":"gzip"},{"name":"content-type","value":"text/html;charset=utf-8"},{"name":"date","value":"Mon, 16 Mar 2026 05:20:14 GMT"},{"name":"server","value":"nginx/1.24.0 (Ubuntu)"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-powered-by","value":"Nuxt"}],"content":{"size":-1,"mimeType":"text/html;charset=utf-8","text":"\u003C!DOCTYPE html\u003E\u003Chtml  lang=\u0022en\u0022 translate=\u0022no\u0022\u003E\u003Chead\u003E\u003Cmeta charset=\u0022utf-8\u0022\u003E\u003Cmeta name=\u0022viewport\u0022 content=\u0022width=device-width, initial-scale=1, viewport-fit=cover\u0022\u003E\u003Ctitle\u003ENew Recruit\u003C/title\u003E\u003Cstyle\u0