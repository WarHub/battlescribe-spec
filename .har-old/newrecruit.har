.912% 40.269%, 99.923% 38.833%, 99.937% 37.391%, 99.948% 35.956%, 99.952% 34.54%, 99.943% 33.152%, 99.915% 31.806%, 99.915% 31.806%, 99.963% 30.566%, 99.983% 29.33%, 99.982% 28.096%, 99.967% 26.862%, 99.945% 25.628%, 99.923% 24.39%, 99.907% 23.149%, 99.904% 21.902%, 99.921% 20.647%, 99.965% 19.383%, 99.965% 19.383%, 100.001% 18.199%, 99.987% 17.166%, 99.94% 16.253%, 99.874% 15.43%, 99.806% 14.67%, 99.75% 13.94%, 99.722% 13.213%, 99.739% 12.459%, 99.814% 11.647%, 99.965% 10.749%, 99.965% 10.749%, 99.926% 9.711%, 99.889% 8.659%, 99.854% 7.597%, 99.821% 6.527%, 99.789% 5.452%, 99.758% 4.374%, 99.728% 3.296%, 99.698% 2.22%, 99.669% 1.15%, 99.639% 0.088%, 0.304% 0.088%, 0.304% 0.088%, 0.358% 2.035%, 0.386% 3.92%, 0.393% 5.752%, 0.383% 7.544%, 0.36% 9.306%, 0.328% 11.05%, 0.292% 12.786%, 0.255% 14.526%, 0.223% 16.281%, 0.198% 18.062%, 0.198% 18.062%, 0.393% 18.664%, 0.496% 19.398%, 0.525% 20.245%, 0.498% 21.183%, 0.431% 22.192%, 0.341% 23.251%, 0.247% 24.339%, 0.165% 25.437%, 0.112% 26.523%, 0.106% 27.577%, 0.106% 27.577%, 0.125% 28.281%, 0.14% 29.287%, 0.152% 30.521%, 0.16% 31.91%, 0.165% 33.381%, 0.168% 34.86%, 0.168% 36.273%, 0.165% 37.546%, 0.161% 38.608%, 0.156% 39.383%, 0.156% 39.383%, 0.075% 40.475%, 0.03% 41.583%, 0.011% 42.708%, 0.013% 43.851%, 0.028% 45.011%, 0.049% 46.19%, 0.069% 47.388%, 0.08% 48.605%, 0.076% 49.843%, 0.05% 51.101%, 0.05% 51.101%, 0.121% 51.006%, 0.201% 51.118%, 0.281% 51.404%, 0.357% 51.829%, 0.421% 52.357%, 0.467% 52.954%, 0.489% 53.584%, 0.481% 54.214%, 0.435% 54.808%, 0.347% 55.33%, 0.347% 55.33%, 0.246% 55.81%, 0.164% 56.668%, 0.1% 57.831%, 0.052% 59.224%, 0.021% 60.771%, 0.005% 62.397%, 0.004% 64.028%, 0.016% 65.587%, 0.041% 67.001%, 0.078% 68.194%, 0.078% 68.194%, 0.097% 69.082%, 0.103% 70.084%, 0.1% 71.166%, 0.093% 72.295%, 0.085% 73.436%, 0.081% 74.556%, 0.087% 75.622%, 0.105% 76.598%, 0.14% 77.452%, 0.198% 78.15%, 0.198% 78.15%, 0.256% 78.387%, 0.301% 78.671%, 0.334% 78.996%, 0.356% 79.356%, 0.369% 79.747%, 0.374% 80.161%, 0.374% 80.593%, 0.369% 81.037%, 0.362% 81.487%, 0.354% 81.938%, 0.354% 81.938%, 0.328% 82.988%, 0.354% 83.845%, 0.415% 84.559%, 0.493% 85.181%, 0.572% 85.76%, 0.635% 86.347%, 0.664% 86.993%, 0.643% 87.746%, 0.555% 88.659%, 0.382% 89.78%, 0.382% 89.78%, 0.392% 90.216%, 0.397% 90.628%, 0.396% 91.016%, 0.389% 91.383%, 0.376% 91.729%, 0.356% 92.057%, 0.329% 92.368%, 0.295% 92.664%, 0.254% 92.946%, 0.205% 93.216%, 0.205% 93.216%, 0.168% 93.725%, 0.149% 94.336%, 0.145% 95.025%, 0.15% 95.769%, 0.158% 96.542%, 0.166% 97.32%, 0.167% 98.079%, 0.158% 98.795%, 0.132% 99.444%, 0.085% 100%, 99.908% 100%, 99.908% 100%, 99.968% 96.779%, 99.995% 93.517%, 99.996% 90.22%, 99.977% 86.894%, 99.945% 83.546%, 99.907% 80.183%, 99.869% 76.809%, 99.838% 73.433%, 99.821% 70.06%, 99.823% 66.696%, 99.823% 66.696%, 99.87% 66.006%, 99.896% 65.312%, 99.904% 64.613%, 99.897% 63.91%, 99.88% 63.205%, 99.856% 62.497%, 99.829% 61.786%, 99.802% 61.074%, 99.78% 60.361%, 99.767% 59.648%, 99.767% 59.648%, 99.754% 58.91%, 99.76% 58.22%, 99.779% 57.562%, 99.807% 56.92%, 99.84% 56.278%, 99.873% 55.619%, 99.9% 54.93%, 99.918% 54.192%, 99.923% 53.391%, 99.908% 52.511%, 99.908% 52.511%, 99.71% 52.01%, 99.565% 51.333%, 99.47% 50.532%, 99.423% 49.659%, 99.421% 48.767%, 99.461% 47.906%, 99.542% 47.128%, 99.66% 46.486%, 99.814% 46.031%, 100% 45.815%);\n  }\n\n  body {\n    margin: 0;\n  }\n\n  html {\n    font-family: \u0022Newsreader Variable\u0022, sans-serif, Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;\n    font-weight: 400;\n    font-size: 14px;\n    color-scheme: light dark;\n    color: #111113;\n    background-color: #fff;\n    text-rendering: optimizeLegibility;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    -webkit-text-size-adjust: 100%;\n\n    column-count: 1;\n    column-gap: 0;\n\n    @media screen and (min-width: 1400px) {\n      column-count: 2;\n    }\n\n    @media screen and (min-width: 1950px) {\n      column-count: 3;\n    }\n\n    @media screen and (min-width: 2600px) {\n      column-count: 4;\n    }\n  }\n\n  .avoid-page-break {\n    margin-bottom: 32px;\n    padding: 2%;\n  }\n\n  .avoid-page-break:not(:has(:is(.ability-box, .weapons-table))) {\n    display: none;\n  }\n\n  .section-header {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 1em 0 0.2em;\n    font-weight: bold;\n    font-variant: small-caps;\n    font-size: 2em;\n  }\n\n  .card-header:not(:has(*)),\n  .hide-if-empty:not(:has(*)) {\n    display: none;\n  }\n\n  .card-header {\n    position: relative;\n  }\n\n  .titleWrap {\n    padding: 20px 30px 30px 80px;\n    height: 100%;\n  }\n\n  .titleCard {\n    height: 100%;\n    display: flex;\n    background: url(https://raw.githubusercontent.com/giloushaker/nr-templates/refs/heads/main/assets/backgrounds/aos-title.png),\n      var(--primary-color, black);\n    background-blend-mode: color-burn;\n    background-size: cover;\n    clip-path: var(--jagged-edges);\n  }\n\n  .title {\n    margin: auto;\n    font-size: xx-large;\n    text-align: center;\n    padding-left: 80px;\n    padding-right: 20px;\n    color: white;\n    text-transform: uppercase;\n    height: 110px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n  }\n\n  .subtitle {\n    font-size: large;\n  }\n\n  .ward {\n    left: 115px;\n    top: 3px;\n    position: absolute;\n    aspect-ratio: 1;\n    z-index: 1;\n    display: grid;\n    grid-template-columns: 34px;\n    grid-template-rows: 34px;\n    gap: 0px 0px;\n    grid-template-areas: \u0022icon\u0022;\n    align-items: anchor-center;\n    justify-items: center;\n\n    span {\n      color: white;\n      font-size: 1.6em;\n      white-space: nowrap;\n      line-height: 1;\n      grid-area: icon;\n      height: 100%;\n      height: auto;\n      transform: translate(2px, 2px);\n    }\n\n    \u0026::before {\n      content: \u0022\u0022;\n      background: rgb(126 10 17);\n      border-radius: 50%;\n      border: 2px solid rgb(139 122 90);\n      width: 100%;\n      height: 100%;\n      grid-area: icon;\n    }\n  }\n\n  .statWheel {\n    position: absolute;\n    background-image: url(\u0022https://raw.githubusercontent.com/BSData/age-of-sigmar-4th/main/images/statwheel.png\u0022);\n    background-repeat: no-repeat;\n    background-size: cover;\n    height: 150px;\n    width: 150px;\n    z-index: 1;\n\n    .statWheelStats {\n      position: relative;\n      height: 150px;\n      width: 150px;\n    }\n\n    .statwheelEntry {\n      position: absolute;\n      text-align: center;\n      height: 100%;\n      width: 100%;\n      color: white;\n\n      .statLabel {\n        font-size: 7px;\n        text-transform: uppercase;\n\n        svg {\n          position: absolute;\n          font-size: 1.2em;\n          top: 0;\n          left: 0;\n          width: 150px;\n          height: 150px;\n\n          text {\n            fill: #ffffff;\n          }\n\n          textPath {\n            text-anchor: middle;\n          }\n\n          path {\n            fill: transparent;\n          }\n        }\n      }\n\n      .stat {\n        font-size: 1.6em;\n        font-weight: 500;\n      }\n    }\n\n    .statwheelEntry:nth-child(1) {\n      .stat {\n        transform: translate(2px, 38px);\n      }\n\n      svg {\n        transform: rotate(-90deg);\n      }\n    }\n\n    .statwheelEntry:nth-child(2) {\n      .stat {\n        transform: translate(-30px, 67px);\n      }\n\n      svg {\n        transform: rotate(-180deg);\n      }\n    }\n\n    .statwheelEntry:nth-child(3) {\n      .stat {\n        transform: translate(30px, 67px);\n      }\n\n      svg {\n        transform: rotate(0deg);\n      }\n    }\n\n    .statwheelEntry:nth-child(4) {\n      .stat {\n        transform: translateY(96px);\n      }\n\n      svg {\n        transform: rotate(90deg);\n      }\n    }\n  }\n\n  .weapons-table {\n    td\u003E* {\n      vertical-align: sub;\n      vertical-align: -webkit-baseline-middle;\n    }\n\n    td,\n    td {\n      border: 1px solid var(--primary-color, cadetblue);\n    }\n\n    td:not(.placeholder) {\n      padding: 3px;\n    }\n\n    td:has(\u002B .placeholder) {\n      border-right: none;\n    }\n\n    td:first-child {\n      border-left: none;\n    }\n\n    td:last-child {\n      border-right: none;\n    }\n\n    td.placeholder {\n      border-left: none;\n      border-right: none;\n    }\n\n    thead {\n      color: white;\n      background-color: var(--primary-color, cadetblue);\n    }\n\n    thead tr td:first-child {\n      text-transform: uppercase;\n    }\n\n    tbody tr:nth-child(even) {\n      background-color: color-mix(in srgb, var(--primary-color, cadetblue) 25%, transparent);\n    }\n\n    border-collapse: collapse;\n    padding: 0 20px;\n    width: calc(100% - 50px);\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .rules {\n    width: calc(100% - 50px);\n    margin: 0 auto;\n\n    .rule {\n      margin-bottom: 1em;\n    }\n\n    .rule-name {\n      font-weight: bold;\n\n      \u0026::after {\n        content: \u0022:\u0022;\n      }\n    }\n  }\n\n  .ability-section {\n    gap: 8px;\n    margin: 20px;\n    width: calc(100% - 40px);\n    column-count: 2;\n    column-gap: 10px;\n\n    @media screen and (max-width: 950px) {\n      column-count: 1;\n    }\n  }\n\n  .ability-wrapper {\n    border: 1px solid var(--ability-color, black);\n    border-top: none;\n    margin: 0px 5px;\n    background: rgba(255, 255, 255, 0.4);\n  }\n\n  .ability-description {\n    padding: 8px;\n\n    \u0026\u003Ediv:not(:last-child) {\n      margin-bottom: 5px;\n    }\n  }\n\n  .ability-keywords {\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    border-top: 1px solid var(--ability-color, black);\n\n    .header {\n      font-variant: small-caps;\n      font-weight: 700;\n      color: white;\n    }\n  }\n\n  .ability-box {\n    -webkit-column-break-inside: avoid;\n    page-break-inside: avoid;\n    /* Firefox is dumb */\n    break-inside: avoid;\n    padding: 0;\n    height: min-content;\n    position: relative;\n    margin-bottom: 15px;\n\n    .header-icon {\n      width: 18px;\n      height: 18px;\n      fill: currentColor;\n      vertical-align: text-bottom;\n\n      \u0026:has(use[href=\u0022#icon\u0022]) {\n        width: 0;\n        height: 0;\n      }\n    }\n\n    span[style*=\u0022small-caps\u0022] {\n      font-weight: 900;\n    }\n\n    td,\n    td {\n      border: none;\n      text-align: left;\n    }\n  }\n\n  .icon {\n    position: absolute;\n    z-index: 1;\n    right: 0px;\n    transform: translateX(calc(50% - var(--offset-x, 5px))) translateY(var(--offset-y, 0px));\n    font-size: 14px;\n    font-weight: bold;\n    color: white;\n    display: grid;\n    grid-template-columns: 50px;\n    grid-template-rows: 50px;\n    gap: 0px 0px;\n    grid-template-areas: \u0022icon\u0022;\n    align-items: center;\n    justify-items: center;\n    top: 2px;\n\n    img,\n    span,\n    div {\n      aspect-ratio: 1;\n      grid-area: icon;\n      width: 100%;\n    }\n\n    span,\n    div {\n      display: block;\n      text-align: center;\n      align-content: center;\n    }\n  }\n\n  .cast {\n    --offset-y: -15px;\n    --offset-x: 22px;\n\n    img {\n      width: 46px;\n      margin-top: -1px;\n    }\n\n    span,\n    div {\n      background-color: black;\n      border-radius: 50vh;\n      width: 28px;\n      padding-top: 2px;\n    }\n  }\n\n  .chant {\n    --offset-y: -15px;\n    --offset-x: 14px;\n  }\n\n  .command {\n    --offset-y: -15px;\n    --offset-x: 18px;\n\n    span,\n    div {\n      color: black;\n    }\n  }\n\n  .keyword-box {\n    .header {\n      font-weight: 700;\n      align-self: stretch;\n      align-content: center;\n      background-color: var(--primary-color, black);\n    }\n\n    .split {\n      \u0026::first-letter {\n        text-transform: uppercase;\n      }\n\n      text-transform: lowercase;\n    }\n\n    .header,\n    .split {\n      font-variant: small-caps;\n    }\n\n    .keywords {\n      margin: 10px;\n      display: inline;\n      text-align: center;\n      width: 100%;\n      font-size: 1em;\n      font-weight: 700;\n\n      .split {\n        white-space: nowrap;\n        display: inline-block;\n        /* for ::first-letter to work */\n      }\n    }\n\n    \u0026:has(.hide-keywords) {\n      display: none;\n    }\n\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    border: 1px solid var(--primary-color, black);\n    width: calc(100% - 50px);\n    margin: 20px auto 1.5em 1.5em;\n  }\n\n  .header {\n    background-color: var(--ability-color, black);\n    color: white;\n    padding: 5px 10px 3px;\n    font-weight: 500;\n  }\n\n  .header.bg {\n    background-image: url(\u0022https://raw.githubusercontent.com/giloushaker/nr-templates/refs/heads/main/assets/backgrounds/aos-header-highres.png\u0022);\n    background-size: auto 100%;\n    background-color: color-mix(in srgb, var(--ability-color, black) 85%, transparent);\n    background-blend-mode: multiply;\n    clip-path: var(--jagged-edges-header);\n  }\n\n  .card.bg {\n    background-image: url(\u0022https://raw.githubusercontent.com/giloushaker/nr-templates/refs/heads/main/assets/backgrounds/aos-highres.png\u0022);\n    background-repeat: no-repeat;\n    background-size: cover;\n    background-color: color-mix(in srgb, var(--primary-color) 7.5%, transparent);\n    background-blend-mode: darken;\n  }\n\n  .card {\n    border: 1px solid black;\n    padding-bottom: 1px;\n  }\n\n  [catalogue*=\u0022Beasts of Chaos\u0022i] {\n    --primary-color: #2e2211;\n  }\n\n  [catalogue*=\u0022Blades of Khorne\u0022i] {\n    --primary-color: #901515;\n  }\n\n  [catalogue*=\u0022Bonesplitterz\u0022i] {\n    --primary-color: #375b4b;\n  }\n\n  [catalogue*=\u0022Cities of Sigmar\u0022i] {\n    --primary-color: #40061d;\n  }\n\n  [catalogue*=\u0022Daughters of Khaine\u0022i] {\n    --primary-color: #531e2f;\n  }\n\n  [catalogue*=\u0022Disciples of