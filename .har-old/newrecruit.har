2es\u0022:5348,\u0022cn\u0022:5349,\u0022it\u0022:5350,\u0022de\u0022:5346,\u0022ja\u0022:5351,\u0022pl\u0022:5352,\u0022pt\u0022:5353,\u0022hr\u0022:5354,\u0022cz\u0022:5346,\u0022sk\u0022:5346,\u0022gr\u0022:5355,\u0022ru\u0022:5356,\u0022ko\u0022:5346},\u0022Join an existing Team\u0022,\u0022Rejoindre une \u00C9quipe existante\u0022,\u0022Unirse a un Equipo existente\u0022,\u0022\u52A0\u5165\u73B0\u6709\u56E2\u961F\u0022,\u0022Unisciti a una Squadra esistente\u0022,\u0022\u7D50\u5408anexisting\u30C1\u30FC\u30E0\u0022,\u0022Do\u0142\u0105cz do Istniej\u0105cej Dru\u017Cyny\u0022,\u0022Entrar em Equipe Existente\u0022,\u0022Pridru\u017Ei se postoje\u0107em timu\u0022,\u0022\u03A3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03B5 \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03C3\u03B1 \u039F\u03BC\u03AC\u03B4\u03B1\u0022,\u0022\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F \u043A \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435\u0022,{\u0022en\u0022:5358,\u0022fr\u0022:5359,\u0022es\u0022:5360,\u0022cn\u0022:5361,\u0022it\u0022:5362,\u0022de\u0022:5358,\u0022ja\u0022:5363,\u0022pl\u0022:5364,\u0022pt\u0022:5365,\u0022hr\u0022:5366,\u0022cz\u0022:5358,\u0022sk\u0022:5358,\u0022gr\u0022:5367,\u0022ru\u0022:5368,\u0022ko\u0022:5358},\u0022Team Password\u0022,\u0022Mot de passe de l\u0027\u00C9quipe\u0022,\u0022Contrase\u00F1a del Equipo\u0022,\u0022\u56E2\u961F\u5BC6\u7801\u0022,\u0022Password Squadra\u0022,\u0022\u30C1\u30FC\u30E0\u30D1\u30B9\u30EF\u30FC\u30C9\u0022,\u0022Has\u0142o Dru\u017Cyny\u0022,\u0022Senha da Equipe\u0022,\u0022Lozinka tima\u0022,\u0022\u039F\u03BC\u03AC\u03B4\u03B1 \u039A\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2\u0022,\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u041F\u0430\u0440\u043E\u043B\u044C\u0022,{\u0022en\u0022:5370,\u0022fr\u0022:5371,\u0022es\u0022:5372,\u0022cn\u0022:5373,\u0022it\u0022:5374,\u0022de\u0022:5370,\u0022ja\u0022:5375,\u0022pl\u0022:5376,\u0022pt\u0022:5377,\u0022hr\u0022:5378,\u0022cz\u0022:5370,\u0022sk\u0022:5370,\u0022gr\u0022:5379,\u0022ru\u0022:5380,\u0022ko\u0022:5381},\u0022Create a new Team\u0022,\u0022Cr\u00E9er une nouvelle \u00C9quipe\u0022,\u0022Crear un nuevo Equipo\u0022,\u0022\u521B\u5EFA\u65B0\u56E2\u961F\u0022,\u0022Crea a new Team\u0022,\u0022\u4F5C\u6210a\u65B0\u898F\u30C1\u30FC\u30E0\u0022,\u0022Utw\u00F3rz Now\u0105 Dru\u017Cyn\u0119\u0022,\u0022Criar Nova Equipe\u0022,\u0022Stvori novi tim\u0022,\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BD\u03AD\u03B1\u03C2 \u039F\u03BC\u03AC\u03B4\u03B1\u03C2\u0022,\u0022\u0421\u043E\u0437\u0434\u0430\u0442\u044C a \u041D\u043E\u0432\u044B\u0439 \u041A\u043E\u043C\u0430\u043D\u0434\u0430\u0022,\u0022a new Team \uC0DD\uC131\u0022,{\u0022en\u0022:5383,\u0022fr\u0022:5384,\u0022es\u0022:5385,\u0022cn\u0022:5386,\u0022it\u0022:5387,\u0022de\u0022:5383,\u0022ja\u0022:5388,\u0022pl\u0022:5389,\u0022pt\u0022:5390,\u0022hr\u0022:5391,\u0022cz\u0022:5383,\u0022sk\u0022:5383,\u0022gr\u0022:5392,\u0022ru\u0022:5393,\u0022ko\u0022:5394},\u0022New Team Name (5\u002B characters)\u0022,\u0022Nom de la nouvelle \u00C9quipe (5\u002B caract\u00E8res)\u0022,\u0022Nombre del nuevo Equipo (5\u002B caracteres)\u0022,\u0022\u65B0\u56E2\u961F\u540D\u79F0\uFF085\u4E2A\u4EE5\u4E0A\u5B57\u7B26\uFF09\u0022,\u0022Nuovo Team Nome (5\u002B characters)\u0022,\u0022\u65B0\u898F\u30C1\u30FC\u30E0\u540D\u524D(5\u002Bcharacters)\u0022,\u0022Nazwa Nowej Dru\u017Cyny (5\u002B znak\u00F3w)\u0022,\u0022Nome da Nova Equipe\u0022,\u0022Naziv novog tima (5\u002B znakova)\u0022,\u0022\u039D\u03AD\u03BF \u038C\u03BD\u03BF\u03BC\u03B1 \u039F\u03BC\u03AC\u03B4\u03B1\u03C2 (5\u002B \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B5\u03C2)\u0022,\u0022\u041D\u043E\u0432\u044B\u0439 \u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 (5\u002B \u0441\u0438\u043C\u0432\u043E\u043B\u044B)\u0022,\u0022\uC0C8 Team Name (5\u002B characters)\u0022,{\u0022en\u0022:5396,\u0022fr\u0022:5397,\u0022es\u0022:5398,\u0022cn\u0022:5399,\u0022it\u0022:5400,\u0022de\u0022:5396,\u0022ja\u0022:5401,\u0022pl\u0022:5402,\u0022pt\u0022:5403,\u0022hr\u0022:5404,\u0022cz\u0022:5396,\u0022sk\u0022:5396,\u0022gr\u0022:5405,\u0022ru\u0022:5406,\u0022ko\u0022:5396},\u0022Team Password (optional)\u0022,\u0022Mot de passe de l\u0027\u00C9quipe (optionnel)\u0022,\u0022Contrase\u00F1a del Equipo (opcional)\u0022,\u0022\u56E2\u961F\u5BC6\u7801\uFF08\u53EF\u9009\uFF09\u0022,\u0022Password Squadra (opzionale)\u0022,\u0022\u30C1\u30FC\u30E0\u30D1\u30B9\u30EF\u30FC\u30C9(optional)\u0022,\u0022Has\u0142o Dru\u017Cyny (opcjonalne)\u0022,\u0022Senha da Equipe (opcional)\u0022,\u0022Lozinka tima (opcionalno)\u0022,\u0022\u039A\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u039F\u03BC\u03AC\u03B4\u03B1\u03C2 (\u03C0\u03C1\u03BF\u03B1\u03B9\u03C1\u03B5\u03C4\u03B9\u03BA\u03CC)\u0022,\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u041F\u0430\u0440\u043E\u043B\u044C (\u041E\u043F\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E)\u0022,{\u0022en\u0022:5408,\u0022fr\u0022:5409,\u0022es\u0022:5410,\u0022cn\u0022:5411,\u0022it\u0022:5412,\u0022de\u0022:5408,\u0022ja\u0022:5413,\u0022pl\u0022:5414,\u0022pt\u0022:5415,\u0022hr\u0022:5416,\u0022cz\u0022:5408,\u0022sk\u0022:5408,\u0022gr\u0022:5417,\u0022ru\u0022:5418,\u0022ko\u0022:5408},\u0022Please link a valid Discord Account to sign up\u0022,\u0022Veuillez lier un compte Discord valide pour vous inscrire\u0022,\u0022Por favor, vincula una cuenta de Discord v\u00E1lida para inscribirte\u0022,\u0022\u8BF7\u94FE\u63A5\u6709\u6548\u7684Discord\u8D26\u6237\u4EE5\u62A5\u540D\u0022,\u0022LPease link a valid Discord Account to sign up\u0022,\u0022\u304A\u9858\u3044\u3057\u307E\u3059 \u30EA\u30F3\u30AF a \u6709\u52B9 Discord \u30A2\u30AB\u30A6\u30F3\u30C8  \u30B5\u30A4\u30F3 \u4E0A\u0022,\u0022Prosz\u0119 po\u0142\u0105czy\u0107 wa\u017Cne konto Discord, aby si\u0119 zarejestrowa\u0107\u0022,\u0022Link do Discord (obrigat\u00F3rio para jogar no TTS)\u0022,\u0022Molimo pove\u017Eite valjan Discord ra\u010Dun za prijavu\u0022,\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03C3\u03C5\u03BD\u03B4\u03AD\u03C3\u03C4\u03B5 \u03AD\u03BD\u03B1\u03BD \u03AD\u03B3\u03BA\u03C5\u03C1\u03BF \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC Discord \u03B3\u03B9\u03B1 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u0022,\u0022Discord ID \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,{\u0022en\u0022:5420,\u0022fr\u0022:5421,\u0022es\u0022:5422,\u0022cn\u0022:5423,\u0022it\u0022:5424,\u0022de\u0022:5420,\u0022ja\u0022:5425,\u0022pl\u0022:5426,\u0022pt\u0022:5427,\u0022hr\u0022:5428,\u0022cz\u0022:5420,\u0022sk\u0022:5420,\u0022gr\u0022:5429,\u0022ru\u0022:5430,\u0022ko\u0022:5420},\u0022The provided password is incorrect\u0022,\u0022Le mot de passe fourni est incorrect\u0022,\u0022La contrase\u00F1a proporcionada es incorrecta\u0022,\u0022\u63D0\u4F9B\u7684\u5BC6\u7801\u4E0D\u6B63\u786E\u0022,\u0022La password fornita \u00E8 errata\u0022,\u0022 provided \u30D1\u30B9\u30EF\u30FC\u30C9 is \u9593\u9055\u3044\u0022,\u0022Podane has\u0142o jest niepoprawne\u0022,\u0022Senha incorreta\u0022,\u0022Unesena lozinka nije ispravna\u0022,\u0022\u039F \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03BF\u03C5 \u03C0\u03B1\u03C1\u03AD\u03C7\u03B5\u03C4\u03B1\u03B9 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03C3\u03C6\u03B1\u03BB\u03BC\u03AD\u03BD\u03BF\u03C2\u0022,\u0022\u041D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,{\u0022en\u0022:5432,\u0022fr\u0022:5433,\u0022es\u0022:5434,\u0022cn\u0022:5435,\u0022it\u0022:5436,\u0022de\u0022:5432,\u0022ja\u0022:5437,\u0022pl\u0022:5438,\u0022pt\u0022:5439,\u0022hr\u0022:5440,\u0022cz\u0022:5432,\u0022sk\u0022:5432,\u0022gr\u0022:5441,\u0022ru\u0022:5442,\u0022ko\u0022:5432},\u0022You are now signed up for this tournament! You can now submit lists.\u0022,\u0022Vous \u00EAtes maintenant inscrit \u00E0 ce tournoi ! Vous pouvez maintenant soumettre des listes.\u0022,\u0022\u00A1Ya est\u00E1s inscrito en este torneo! Ahora puedes enviar listas.\u0022,\u0022\u60A8\u73B0\u5728\u5DF2\u62A5\u540D\u53C2\u52A0\u6B64\u9526\u6807\u8D5B\uFF01\u60A8\u73B0\u5728\u53EF\u4EE5\u63D0\u4EA4\u540D\u5355\u3002\u0022,\u0022Ora sei iscritto a questo torneo! Ora puoi inviare le liste.\u0022,\u0022\u3053\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u3057\u307E\u3057\u305F\uFF01\u30EA\u30B9\u30C8\u3092\u9001\u4FE1\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u308A\u307E\u3057\u305F\u3002\u0022,\u0022Jeste\u015B teraz zarejestrowany na ten turniej! Mo\u017Cesz teraz przesy\u0142a\u0107 listy.\u0022,\u0022Inscri\u00E7\u00E3o realizada com sucesso\u0022,\u0022Sada ste prijavljeni za ovaj turnir! Sada mo\u017Eete poslati popise.\u0022,\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03C0\u03BB\u03AD\u03BF\u03BD \u03B5\u03B3\u03B3\u03B5\u03B3\u03C1\u03B1\u03BC\u03BC\u03AD\u03BD\u03BF\u03C2 \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC! \u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03C4\u03CE\u03C1\u03B1 \u03BD\u03B1 \u03C5\u03C0\u03BF\u03B2\u03AC\u03BB\u03B5\u03C4\u03B5 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2.\u0022,\u0022\u0412\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u044B \u043D\u0430 \u0442\u0443\u0440\u043D\u0438\u0440\u0022,{\u0022en\u0022:5444,\u0022fr\u0022:5445,\u0022es\u0022:5446,\u0022cn\u0022:5447,\u0022it\u0022:5448,\u0022de\u0022:5444,\u0022ja\u0022:5449,\u0022pl\u0022:5450,\u0022pt\u0022:5451,\u0022hr\u0022:5452,\u0022cz\u0022:5444,\u0022sk\u0022:5444,\u0022gr\u0022:5453,\u0022ru\u0022:5454,\u0022ko\u0022:5444},\u0022An error occured, please contact New Recruit\u0022,\u0022Une erreur s\u0027est produite, veuillez contacter New Recruit\u0022,\u0022Ocurri\u00F3 un error, por favor contacta a New Recruit\u0022,\u0022\u53D1\u751F\u9519\u8BEF\uFF0C\u8BF7\u8054\u7CFB New Recruit\u0022,\u0022Si \u00E8 verificato un errore, si prega di contattare New Recruit\u0022,\u0022\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\u3002New Recruit\u306B\u9023\u7D61\u3057\u3066\u304F\u3060\u3055\u3044\u0022,\u0022Wyst\u0105pi\u0142 b\u0142\u0105d, prosz\u0119 skontaktowa\u0107 si\u0119 z New Recruit\u0022,\u0022Erro na inscri\u00E7\u00E3o\u0022,\u0022Do\u0161lo je do gre\u0161ke, molimo kontaktirajte New Recruit\u0022,\u0022\u03A0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5 \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1, \u03C0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B5\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03BC\u03B5 \u03C4\u03BF New Recruit\u0022,\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043D\u0430 \u0442\u0443\u0440\u043D\u0438\u0440\u0022,{\u0022en\u0022:5456,\u0022fr\u0022:5457,\u0022es\u0022:5458,\u0022cn\u0022:5459,\u0022it\u0022:5460,\u0022de\u0022:5456,\u0022ja\u0022:5461,\u0022pl\u0022:5462,\u0022pt\u0022:5463,\u0022hr\u0022:5464,\u0022cz\u0022:5456,\u0022sk\u0022:5456,\u0022gr\u0022:5465,\u0022ru\u0022:5466,\u0022ko\u0022:5456},\u0022List Import/Export\u0022,\u0022Import/Export de Listes\u0022,\u0022Importar/Exportar Listas\u0022,\u0022\u5217\u8868\u5BFC\u5165/\u5BFC\u51FA\u0022,\u0022Importa/Esporta Lista\u0022,\u0022\u30EA\u30B9\u30C8Import/\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u0022,\u0022Import/Eksport Listy\u0022,\u0022Importar/Exportar Lista\u0022,\u0022Uvoz/Izvoz popisa\u0022,\u0022\u039B\u03AF\u03C3\u03C4\u03B1 \u0395\u03B9\u03C3\u03B1\u03B3\u03C9\u03B3\u03AE/\u0395\u03BE\u03B1\u03B3\u03C9\u03B3\u03AE\u0022,\u0022\u0418\u043C\u043