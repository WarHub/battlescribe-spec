E9galit\u00E9s\u0022,es:\u0022Desempates\u0022,cn:\u0022\u5E73\u5C40\u51B3\u80DC\u0022,it:\u0022Tie Breakers\u0022,de:\u0022Tiebreaker\u0022,ja:\u0022Tie Breakers\u0022,pl:\u0022Tie Breakers\u0022,pt:\u0022Desempatadores\u0022,hr:\u0022Rje\u0161avanje Izjedna\u010Denja\u0022,cz:\u0022Tie Breakers\u0022,sk:\u0022Tie Breakers\u0022,gr:\u0022\u0394\u03B9\u03B1\u03BB\u03C5\u03C4\u03AD\u03C2 \u03B9\u03C3\u03BF\u03C0\u03B1\u03BB\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0422\u0430\u0439-\u0431\u0440\u0435\u0439\u043A\u0435\u0440\u044B\u0022,ko:\u0022Tie Breakers\u0022},y_e={en:\u0022Use \u003Cstrong\u003E{pointType} DIFFERENCE\u003C/strong\u003E for tiebreakers\u0022,fr:\u0022Utiliser la \u003Cstrong\u003EDIFF\u00C9RENCE de {pointType}\u003C/strong\u003E pour les brise-\u00E9galit\u00E9s\u0022,es:\u0022Usar \u003Cstrong\u003EDIFERENCIA de {pointType}\u003C/strong\u003E para desempates\u0022,cn:\u0022\u4F7F\u7528\u003Cstrong\u003E{pointType}\u5DEE\u503C\u003C/strong\u003E\u8FDB\u884C\u5E73\u5C40\u51B3\u80DC\u0022,it:\u0022Use \u003Cstrong\u003E{pointType} DIFFERENCE\u003C/strong\u003E for tiebreakers\u0022,de:\u0022Verwenden Sie die \u003Cstrong\u003E{pointType}-DIFFERENZ\u003C/strong\u003E f\u00FCr Tiebreaker\u0022,ja:\u0022Use \u003Cstrong\u003E{\u30DD\u30A4\u30F3\u30C8\u30BF\u30A4\u30D7} \u5DEE\u003C/strong\u003E for tiebreakers\u0022,pl:\u0022Use \u003Cstrong\u003E{pointType} DIFFERENCE\u003C/strong\u003E for tiebreakers\u0022,pt:\u0022Use \u003Cstrong\u003EDIFEREN\u00C7A de {pointType}\u003C/strong\u003E para desempatadores\u0022,hr:\u0022Koristi \u003Cstrong\u003ERAZLIKU {pointType}\u003C/strong\u003E za rje\u0161avanje izjedna\u010Denja\u0022,cz:\u0022Use \u003Cstrong\u003E{pointType} DIFFERENCE\u003C/strong\u003E for tiebreakers\u0022,sk:\u0022Use \u003Cstrong\u003E{pointType} DIFFERENCE\u003C/strong\u003E for tiebreakers\u0022,gr:\u0022\u03A7\u03C1\u03AE\u03C3\u03B7 \u03B4\u03B9\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2 \u03B3\u03B9\u03B1 \u03B4\u03B9\u03B1\u03BB\u03CD\u03C4\u03B5\u03C2 \u03B9\u03C3\u03BF\u03C0\u03B1\u03BB\u03AF\u03B1\u03C2\u0022,ru:\u0022\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0437\u043D\u0438\u0446\u0443 \u0434\u043B\u044F \u0442\u0430\u0439-\u0431\u0440\u0435\u0439\u043A\u0435\u0440\u043E\u0432\u0022,ko:\u0022Use \u003Cstrong\u003E{pointType} DIFFERENCE\u003C/strong\u003E for tiebreakers\u0022},w_e={en:\u0022Customize Scoring\u0022,fr:\u0022Personnaliser la notation\u0022,es:\u0022Personalizar puntuaci\u00F3n\u0022,cn:\u0022\u81EA\u5B9A\u4E49\u8BA1\u5206\u0022,it:\u0022Customize Scoring\u0022,de:\u0022Punktevergabe anpassen\u0022,ja:\u0022Customize Scoring\u0022,pl:\u0022Customize Scoring\u0022,pt:\u0022Personalizar Pontua\u00E7\u00E3o\u0022,hr:\u0022Prilagodi Bodovanje\u0022,cz:\u0022Customize Scoring\u0022,sk:\u0022Customize Scoring\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE \u03B2\u03B1\u03B8\u03BC\u03BF\u03BB\u03BF\u03B3\u03AF\u03B1\u03C2\u0022,ru:\u0022\u041D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u043E\u0434\u0441\u0447\u0451\u0442 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022Customize Scoring\u0022},b_e={en:\u0022Automatic calculation\u0022,fr:\u0022Calcul automatique\u0022,es:\u0022C\u00E1lculo autom\u00E1tico\u0022,cn:\u0022\u81EA\u52A8\u8BA1\u7B97\u0022,it:\u0022Automatic calculation\u0022,de:\u0022Automatische Berechnung\u0022,ja:\u0022Automatic calculation\u0022,pl:\u0022Automatic calculation\u0022,pt:\u0022C\u00E1lculo autom\u00E1tico\u0022,hr:\u0022Automatski izra\u010Dun\u0022,cz:\u0022Automatic calculation\u0022,sk:\u0022Automatic calculation\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C5\u03C0\u03BF\u03BB\u03BF\u03B3\u03B9\u03C3\u03BC\u03CC\u03C2\u0022,ru:\u0022\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u0430\u0441\u0447\u0451\u0442\u0022,ko:\u0022Automatic calculation\u0022},v_e={en:\u0022Your table is formatted correctly!\u0022,fr:\u0022Votre table est correctement format\u00E9e !\u0022,es:\u0022\u00A1Tu tabla est\u00E1 formateada correctamente!\u0022,cn:\u0022\u60A8\u7684\u8868\u683C\u683C\u5F0F\u6B63\u786E\uFF01\u0022,it:\u0022Your table is formatted correctly!\u0022,de:\u0022Ihre Tabelle ist korrekt formatiert!\u0022,ja:\u0022\u3042\u306A\u305F\u306E table is \u30D5\u30A9\u30FC\u30DE\u30C3\u30C8\u6E08\u307F correctly!\u0022,pl:\u0022Your tabela is formatted correctly!\u0022,pt:\u0022Sua tabela est\u00E1 formatada corretamente!\u0022,hr:\u0022Va\u0161a tablica je ispravno formatirana!\u0022,cz:\u0022Your table is formatted correctly!\u0022,sk:\u0022Your table is formatted correctly!\u0022,gr:\u0022\u039F \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1\u03C2 \u03BC\u03BF\u03C1\u03C6\u03BF\u03C0\u03BF\u03B9\u03AE\u03B8\u03B7\u03BA\u03B5 \u03C3\u03C9\u03C3\u03C4\u03AC\u0022,ru:\u0022\u0422\u0430\u0431\u043B\u0438\u0446\u0430 \u043E\u0442\u0444\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0022,ko:\u0022Your table is formatted correctly!\u0022},k_e={en:\u0022Your table incorrectly formatted\u0022,fr:\u0022Votre table est mal format\u00E9e\u0022,es:\u0022Tu tabla est\u00E1 mal formateada\u0022,cn:\u0022\u60A8\u7684\u8868\u683C\u683C\u5F0F\u4E0D\u6B63\u786E\u0022,it:\u0022Your table incorrectly formatted\u0022,de:\u0022Ihre Tabelle ist falsch formatiert\u0022,ja:\u0022\u3042\u306A\u305F\u306E table incorrectly \u30D5\u30A9\u30FC\u30DE\u30C3\u30C8\u6E08\u307F\u0022,pl:\u0022Your tabela incorrectly formatted\u0022,pt:\u0022Sua tabela est\u00E1 formatada incorretamente\u0022,hr:\u0022Va\u0161a tablica je neispravno formatirana\u0022,cz:\u0022Your table incorrectly formatted\u0022,sk:\u0022Your table incorrectly formatted\u0022,gr:\u0022\u039F \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1\u03C2 \u03BC\u03BF\u03C1\u03C6\u03BF\u03C0\u03BF\u03B9\u03AE\u03B8\u03B7\u03BA\u03B5 \u03BB\u03B1\u03BD\u03B8\u03B1\u03C3\u03BC\u03AD\u03BD\u03B1\u0