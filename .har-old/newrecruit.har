022Aktionen\u0022,ja:\u0022\u30A2\u30AF\u30B7\u30E7\u30F3\u0022,pl:\u0022Akcje\u0022,pt:\u0022A\u00E7\u00F5es\u0022,hr:\u0022Akcije\u0022,cz:\u0022Actions\u0022,sk:\u0022Actions\u0022,gr:\u0022\u0395\u03BD\u03AD\u03C1\u03B3\u03B5\u03B9\u03B5\u03C2\u0022,ru:\u0022\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u0022,ko:\u0022Actions\u0022},LBe={en:\u0022New players \u003Cb\u003Ewill not\u003C/b\u003E be able to join\u0022,fr:\u0022Les nouveaux joueurs \u003Cb\u003Ene pourront pas\u003C/b\u003E rejoindre\u0022,es:\u0022Los nuevos jugadores \u003Cb\u003Eno podr\u00E1n\u003C/b\u003E unirse\u0022,cn:\u0022\u65B0\u73A9\u5BB6\u003Cb\u003E\u5C06\u65E0\u6CD5\u003C/b\u003E\u52A0\u5165\u0022,it:\u0022I nuovi giocatori \u003Cb\u003Enon potranno\u003C/b\u003E iscriversi\u0022,de:\u0022Neue Spieler k\u00F6nnen \u003Cb\u003Enicht\u003C/b\u003E beitreten\u0022,ja:\u0022\u65B0\u3057\u3044\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u003Cb\u003E\u53C2\u52A0\u3067\u304D\u307E\u305B\u3093\u003C/b\u003E\u0022,pl:\u0022Nowi gracze \u003Cb\u003Enie b\u0119d\u0105 mogli\u003C/b\u003E do\u0142\u0105czy\u0107\u0022,pt:\u0022Novos jogadores \u003Cb\u003En\u00E3o poder\u00E3o\u003C/b\u003E participar\u0022,hr:\u0022Novi igra\u010Di \u003Cb\u003Ene\u0107e mo\u0107i\u003C/b\u003E pristupiti\u0022,cz:\u0022New players \u003Cb\u003Ewill not\u003C/b\u003E be able to join\u0022,sk:\u0022New players \u003Cb\u003Ewill not\u003C/b\u003E be able to join\u0022,gr:\u0022\u039D\u03AD\u03BF\u03B9 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03B4\u03B5\u03BD \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF\u03CD\u03BD\u0022,ru:\u0022\u041D\u043E\u0432\u044B\u0435 \u0438\u0433\u0440\u043E\u043A\u0438 \u043D\u0435 \u0441\u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F\u0022,ko:\u0022\uC0C8 players \u003Cb\u003Ewill not\u003C/b\u003E be able to join\u0022},DBe={en:\u0022New teams \u003Cb\u003Ewill not\u003C/b\u003E be able to join, but existing teams may add new players\u0022,fr:\u0022Les nouvelles \u00E9quipes \u003Cb\u003Ene pourront pas\u003C/b\u003E rejoindre, mais les \u00E9quipes existantes peuvent ajouter de nouveaux joueurs\u0022,es:\u0022Los nuevos equipos \u003Cb\u003Eno podr\u00E1n\u003C/b\u003E unirse, pero los equipos existentes pueden agregar nuevos jugadores\u0022,cn:\u0022\u65B0\u56E2\u961F\u003Cb\u003E\u5C06\u65E0\u6CD5\u003C/b\u003E\u52A0\u5165\uFF0C\u4F46\u73B0\u6709\u56E2\u961F\u53EF\u4EE5\u6DFB\u52A0\u65B0\u73A9\u5BB6\u0022,it:\u0022I nuovi team \u003Cb\u003Enon potranno\u003C/b\u003E iscriversi, ma i team esistenti possono aggiungere nuovi giocatori\u0022,de:\u0022Neue Teams k\u00F6nnen \u003Cb\u003Enicht\u003C/b\u003E beitreten, aber bestehende Teams k\u00F6nnen neue Spieler hinzuf\u00FCgen\u0022,ja:\u0022\u65B0\u3057\u3044\u30C1\u30FC\u30E0\u306F\u003Cb\u003E\u53C2\u52A0\u3067\u304D\u307E\u305B\u3093\u003C/b\u003E\u304C\u3001\u65E2\u5B58\u306E\u30C1\u30FC\u30E0\u306F\u65B0\u3057\u3044\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u8FFD\u52A0\u3067\u304D\u307E\u3059\u0022,pl:\u0022Nowe dru\u017Cyny \u003Cb\u003Enie b\u0119d\u0105 mog\u0142y\u003C/b\u003E do\u0142\u0105czy\u0107, ale istniej\u0105ce dru\u017Cyny mog\u0105 doda\u0107 nowych graczy\u0022,pt:\u0022Novas equipes \u003Cb\u003En\u00E3o poder\u00E3o\u003C/b\u003E participar, mas equipes existentes podem adicionar novos jogadores\u0022,hr:\u0022Nove mom\u010Dadi \u003Cb\u003Ene\u0107e mo\u0107i\u003C/b\u003E pristupiti, ali postoje\u0107e mom\u010Dadi mogu dodati nove igra\u010De\u0022,cz:\u0022New teams \u003Cb\u003Ewill not\u003C/b\u003E be able to join, but existing teams may add new players\u0022,sk:\u0022New teams \u003Cb\u003Ewill not\u003C/b\u003E be able to join, but existing teams may add new players\u0022,gr:\u0022\u039D\u03AD\u03B5\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2 \u03B4\u03B5\u03BD \u03B8\u03B1 \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03BF\u03CD\u03BD\u0022,ru:\u0022\u041D\u043E\u0432\u044B\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F\u0022,ko:\u0022\uC0C8 teams \u003Cb\u003Ewill not\u003C/b\u003E be able to join, but existing teams may add new players\u0022},OBe={en:\u0060Your discord username is not correctly configured, please go to \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOptions\u003C/NuxtLink\u003E to configure it if you want to receive notifications.\u0060,fr:\u0060Votre nom d\u0027utilisateur Discord n\u0027est pas configur\u00E9 correctement, veuillez aller dans les \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOptions\u003C/NuxtLink\u003E pour le configurer si vous voulez recevoir des notifications.\u0060,es:\u0060Su nombre de usuario de Discord no est\u00E1 configurado correctamente, vaya a \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOpciones\u003C/NuxtLink\u003E para configurarlo si desea recibir notificaciones.\u0060,cn:\u0060\u60A8\u7684Discord\u7528\u6237\u540D\u914D\u7F6E\u4E0D\u6B63\u786E\uFF0C\u5982\u679C\u60A8\u60F3\u63A5\u6536\u901A\u77E5\uFF0C\u8BF7\u524D\u5F80\u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003E\u9009\u9879\u003C/NuxtLink\u003E\u8FDB\u884C\u914D\u7F6E\u3002\u0060,it:\u0060Il tuo nome utente Discord non \u00E8 configurato correttamente, vai su \u003CNuxtLink :to=\u0022{ name: \u0027app-Opzioni\u0027 }\u0022\u003EOpzioni\u003C/NuxtLink\u003E per configurarlo se vuoi ricevere notifiche.\u0060,de:\u0060Ihr Discord-Benutzername ist nicht korrekt konfiguriert. Bitte gehen Sie zu \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOptionen\u003C/NuxtLink\u003E, um ihn zu konfigurieren, wenn Sie Benachrichtigungen erhalten m\u00F6chten.\u0060,ja:\u0060Discord\u30E6\u30FC\u30B6\u30FC\u540D\u304C\u6B63\u3057\u304F\u8A2D\u5B9A\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002\u901A\u77E5\u3092\u53D7\u3051\u53D6\u308A\u305F\u3044\u5834\u5408\u306F\u3001\u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003E\u30AA\u30D7\u30B7\u30E7\u30F3\u003C/NuxtLink\u003E\u3067\u8A2D\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0060,pl:\u0060Twoja nazwa u\u017Cytkownika Discord nie jest poprawnie skonfigurowana, przejd\u017A do \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOpcji\u003C/NuxtLink\u003E, aby j\u0105 skonfigurowa\u0107, je\u015Bli chcesz otrzymywa\u0107 powiadomienia.\u0060,pt:\u0060Seu nome de usu\u00E1rio do Discord n\u00E3o est\u00E1 configurado corretamente, por favor v\u00E1 em \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOp\u00E7\u00F5es\u003C/NuxtLink\u003E para configur\u00E1-lo se voc\u00EA deseja receber notifica\u00E7\u00F5es.\u0060,hr:\u0060Va\u0161e Discord korisni\u010Dko ime nije pravilno konfigurirano, idite na \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOpcije\u003C/NuxtLink\u003E da ga konfigurirate ako \u017Eelite primati obavijesti.\u0060,cz:\u0060Your discord username is not correctly configured, please go to \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOptions\u003C/NuxtLink\u003E to configure it if you want to receive notifications.\u0060,sk:\u0060Your discord username is not correctly configured, please go to \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOptions\u003C/NuxtLink\u003E to configure it if you want to receive notifications.\u0060,gr:\u0022\u03A4\u03BF Discord \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03B9 \u03C1\u03C5\u03B8\u03BC\u03B9\u03C3\u03C4\u03B5\u03AF \u03B3\u03B9\u03B1 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022Discord \u043D\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0022,ko:\u0060Your discord username is not correctly configured, please go to \u003CNuxtLink :to=\u0022{ name: \u0027app-Options\u0027 }\u0022\u003EOptions\u003C/NuxtLink\u003E to configure it if you want to receive notifications.\u0060},HBe={en:\u0022Add {login} as Manager\u0022,fr:\u0022Ajouter {login} comme Gestionnaire\u0022,es:\u0022Agregar {login} como Administrador\u0022,cn:\u0022\u6DFB\u52A0{login}\u4E3A\u7BA1\u7406\u5458\u0022,it:\u0022Aggiungi {login} come Manager\u0022,de:\u0022Als Manager hinzuf\u00FCgen: {login}\u0022,ja:\u0022{login}\u3092\u30DE\u30CD\u30FC\u30B8\u30E3\u30FC\u3068\u3057\u3066\u8FFD\u52A0\u0022,pl:\u0022Dodaj {login} jako Mened\u017Cera\u0022,pt:\u0022Adicionar {login} como Gerente\u0022,hr:\u0022Dodaj {login} kao Upravitelja\u0022,cz:\u0022Add {login} as Manager\u0022,sk:\u0022Add {login} as Manager\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03C9\u03C2 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043A \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0430\u0022,ko:\u0022{login} as Manager \uCD94\uAC00\u0022},GBe={en:\u0022Could not add a new Tournament Admin\u0022,fr:\u0022Impossible d\u0027ajouter un nouvel Administrateur de Tournoi\u0022,es:\u0022No se pudo agregar un nuevo Administrador del Torneo\u0022,cn:\u0022\u65E0\u6CD5\u6DFB\u52A0\u65B0\u7684\u9526\u6807\u8D5B\u7BA1\u7406\u5458\u0022,it:\u0022Impossibile aggiungere un nuovo Amministratore del Torneo\u0022,de:\u0022Konnte keinen neuen Turnier-Administrator hinzuf\u00FCgen\u0022,ja:\u0022\u65B0\u3057\u3044\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7BA1\u7406\u8005\u3092\u8FFD\u52A0\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\u0022,pl:\u0022Nie mo\u017Cna doda\u0107 nowego Administratora Turnieju\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel adicionar um novo Administrador de Torneio\u0022,hr:\u0022Nije mogu\u0107e dodati novog Administratora Turnira\u0022,cz:\u0022Could not add a new Tournament Admin\u0022,sk:\u0022Could not add a new Tournament Admin\u0022,gr:\u0022\u0394\u03B5\u03BD \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03AE \u03B7 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03B4\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u0022,ru:\u0022\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0430\u0022,ko:\u0022Could not add a new Tournament Admin\u0022},VBe={en:\u0022Are you sure you want to DELETE this tournament?\u0022,fr:\u0022\u00CAtes-vous s\u00FBr de vouloir SUPPRIMER ce tournoi ?\u0022,es:\u0022\u00BFEst\u00E1 seguro de que desea ELIMINAR este torneo?\u0022,cn:\u0022\u60A8\u786E\u5B9A\u8981\u5220\u9664\u6B64\u9526\u6807\u8D5B\u5417\uFF1F\u0022,it:\u0022Sei sicuro di voler ELIMINARE questo torneo?\u0022,de:\u0022Sind Sie sicher, dass Sie dieses Turnier L\u00D6SCHEN m\u00F6chten?\u0022,ja:\u0022\u672C\u5F53\u306B\u3053\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u3092\u524A\u9664\u3057\u307E\u3059\u304B\uFF1F\u0022,pl:\u0022Czy na pewno chcesz USUN\u0104\u0106 ten turniej?\u0022,pt:\u0022Tem certeza de que deseja EXCLUIR este torneio?\u0022,hr:\u0022Jeste li sigurni da \u017Eelite IZBRISATI ovaj turnir?\u0022,cz:\u0022Are you sure you want to DELETE this tournament?\u0022,sk:\u0022Are you sure you want to DELETE this tournament?\u0022,gr:\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03B9 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC;\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0442\u0443\u0440\u043D\u0438\u0440?\u0022,ko:\u0022Are you sure you want to DELETE this tournament?\u0022},WBe={en:\u0022Tournament deleted!\u0022,fr:\u0022Tournoi supprim\u00E9 !\u0022,es:\u0022\u00A1Torneo eliminado!\u0022,cn:\u0022\u9526\u6807\u8D5B\u5DF2\u5220\u9664\uFF01\u0022,it:\u0022Torneo eliminato!\u0022,de:\u0022Turnier gel\u00F6scht!\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u304C\u524A\u9664\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,pl:\u0022Turniej usuni\u0119ty!\u0022,pt:\u0022Torneio exclu\u00EDdo!\u0022,hr:\u0022Turnir izbrisan!\u0022,cz:\u0022Tournament deleted!\u0022,sk:\u0022Tournament deleted!\u0022,gr:\u0022\u03A4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0423\u0434\u0430\u043B\u0435\u043D\u043E!\u0022,ko:\u0022Tournament deleted!\u0022},YBe={en:\u0022Filter Players\u0022,fr:\u0022Filtrer les Joueurs\u0022,es:\u0022Filtrar Jugadores\u0022,cn:\u0022\u7B5B\u9009\u73A9\u5BB6\u0022,it:\u0022Filtra Giocatori\u0022,de:\u0022Spieler filtern\u0022,ja:\u0022\u30D5\u30A3\u30EB\u30BF\u30FC\u30D7\u30EC\u30A4\u30E4\u30FC\u0022,pl:\u0022Filtruj Graczy\u0022,pt:\u0022Filtrar Jogadores\u0022,hr:\u0022Filtriraj Igra\u010De\u0022,cz:\u0022Filter Players\u0022,sk:\u0022Filter Players\u0022,gr:\u0022\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1 \u03C0\u03B1\u03B9\u03BA\u03C4\u03CE\u03BD\u0022,ru:\u0022\u0424\u0438\u043B\u044C\u0442\u0440 \u0418\u0433\u0440\u043E\u043A\u0438\u0022,ko:\u0022Filter Players\u0022},KBe={en:\u0022 or Teams\u0022,fr:\u0022 ou \u00C9quipes\u0022,es:\u0022 o Equipos\u0022,cn:\u0022 \u6216\u56E2\u961F\u0022,it:\u0022 o Team\u0022,de:\u0022 oder Teams\u0022,ja:\u0022 \u307E\u305F\u306F\u30C1\u30FC\u30E0\u0022,pl:\u0022 lub Dru\u017Cyny\u0022,pt:\u0022 ou Equipes\u0022,hr:\u0022 ili Mom\u010Dadi\u0022,cz:\u0022 or Teams\u0022,sk:\u0022 or Teams\u0022,gr:\u0022\u03AE \u03BF\u03BC\u03AC\u03B4\u03B5\u03C2\u0022,ru:\u0022or \u041A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,ko:\u0022 or Teams\u0022},qBe={en:\u0022Search by Name\u0022,fr:\u0022Rechercher par Nom\u002