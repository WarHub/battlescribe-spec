1\u044B\u043B\u043A\u0430 \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u0430 \u0432 \u0431\u0443\u0444\u0435\u0440 \u043E\u0431\u043C\u0435\u043D\u0430!\u0022,ko:\u0022Link copied to clipboard!\u0022},ype={en:\u0022Yellowscribe code (copied to clipboard):\u0022,fr:\u0022Code Yellowscribe (copi\u00E9 dans le presse-papiers) :\u0022,es:\u0022C\u00F3digo Yellowscribe (copiado al portapapeles):\u0022,cn:\u0022Yellowscribe \u4EE3\u7801\uFF08\u5DF2\u590D\u5236\u5230\u526A\u8D34\u677F\uFF09\uFF1A\u0022,it:\u0022Codice Yellowscribe (copiato negli appunti):\u0022,de:\u0022Yellowscribe code (copied to clipboard):\u0022,ja:\u0022Yellowscribe\u30B3\u30FC\u30C9\uFF08\u30AF\u30EA\u30C3\u30D7\u30DC\u30FC\u30C9\u306B\u30B3\u30D4\u30FC\u6E08\u307F\uFF09\uFF1A\u0022,pl:\u0022Kod Yellowscribe (skopiowany do schowka):\u0022,pt:\u0022C\u00F3digo Yellowscribe (copiado para a \u00E1rea de transfer\u00EAncia):\u0022,hr:\u0022Yellowscribe kod (kopiran u me\u0111uspremnik):\u0022,cz:\u0022Yellowscribe code (copied to clipboard):\u0022,sk:\u0022Yellowscribe code (copied to clipboard):\u0022,gr:\u0022\u03A4\u03BF Yellowscribe \u03B1\u03BD\u03C4\u03B9\u03B3\u03C1\u03AC\u03C6\u03B7\u03BA\u03B5\u0022,ru:\u0022\u0424\u043E\u0440\u043C\u0430\u0442 YellowScribe \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D \u0432 \u0431\u0443\u0444\u0435\u0440 \u043E\u0431\u043C\u0435\u043D\u0430\u0022,ko:\u0022Yellowscribe code (copied to clipboard):\u0022},wpe={en:\u0022Yellowscribe is not responding, please try again later.\u0022,fr:\u0022Yellowscribe ne r\u00E9pond pas, veuillez r\u00E9essayer plus tard.\u0022,es:\u0022Yellowscribe no responde, por favor int\u00E9ntalo m\u00E1s tarde.\u0022,cn:\u0022Yellowscribe \u6CA1\u6709\u54CD\u5E94\uFF0C\u8BF7\u7A0D\u540E\u91CD\u8BD5\u3002\u0022,it:\u0022Yellowscribe non risponde, riprova pi\u00F9 tardi.\u0022,de:\u0022Yellowscribe antwortet nicht, bitte versuche es sp\u00E4ter erneut.\u0022,ja:\u0022Yellowscribe\u304C\u5FDC\u7B54\u3057\u3066\