fr\u0022:\u0022Guerriers des Dieux Sombres\u0022,\u0022cn\u0022:\u0022\u90AA\u795E\u6218\u58EB\u0022},\u0022short\u0022:\u0022wdg\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022}],\u0022nrversion\u0022:640,\u0022path\u0022:\u0022t9a/2022\u0022,\u0022last_updated\u0022:\u00222026-03-13T17:11:00.597Z\u0022,\u0022engine\u0022:\u0022t9a\u0022,\u0022wiki\u0022:true,\u0022wikiLastUpdated\u0022:\u00222025-01-01T08:06:47.761Z\u0022,\u0022settings\u0022:{\u0022icons\u0022:{\u0022army_icons\u0022:{\u0022field\u0022:\u0022id\u0022,\u0022icons\u0022:{\u00221\u0022:\u0022al.png\u0022,\u00222\u0022:\u0022bh.png\u0022,\u00223\u0022:\u0022de.png\u0022,\u00224\u0022:\u0022dh.png\u0022,\u00225\u0022:\u0022dl.png\u0022,\u00226\u0022:\u0022eos2.png\u0022,\u00227\u0022:\u0022he.png\u0022,\u00228\u0022:\u0022id.png\u0022,\u00229\u0022:\u0022koe.png\u0022,\u002210\u0022:\u0022mh.png\u0022,\u002211\u0022:\u0022ok.png\u0022,\u002212\u0022:\u0022ong.png\u0022,\u002213\u0022:\u0022sa.png\u0022,\u002214\u0022:\u0022se.png\u0022,\u002215\u0022:\u0022ud.png\u0022,\u002216\u0022:\u0022vc.png\u0022,\u002217\u0022:\u0022vs.png\u0022,\u002218\u0022:\u0022wdg.png\u0022,\u002219\u0022:\u0022cl.png\u0022,\u002220\u0022:\u0022hg.png\u0022,\u002221\u0022:\u0022vs.png\u0022,\u002222\u0022:\u0022ls.png\u0022,\u002224\u0022:\u0022er.png\u0022,\u002225\u0022:\u0022df.png\u0022}},\u0022category_icons\u0022:{\u0022field\u0022:\u0022name\u0022,\u0022icons\u0022:{\u0022Core\u0022:\u0022core.png\u0022,\u0022Core Units\u0022:\u0022core.png\u0022,\u0022Special\u0022:\u0022special.png\u0022,\u0022Characters\u0022:\u0022characters.png\u0022}}},\u0022score\u0022:[{\u0022id\u0022:1,\u0022name\u0022:\u00229th Age Scoring (version 2)\u0022,\u0022functions\u0022:\u0022t9a\u0022,\u0022score\u0022:{\u0022VP\u0022:{\u0022name\u0022:\u0022Victory Points\u0022,\u0022short\u0022:\u0022VP\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:true,\u0022min\u0022:0},\u0022Diff\u0022:{\u0022name\u0022:\u0022VP Difference\u0022,\u0022short\u0022:\u0022Diff\u0022,\u0022dispShort\u0022:\u0022VP Diff\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:false,\u0022min\u0022:0},\u0022Obj\u0022:{\u0022name\u0022:\u0022Primary Objective\u0022,\u0022short\u0022:\u0022Obj\u0022,\u0022type\u0022:\u0022player\u0022,\u0022mod\u0022:true},\u0022Turns\u0022:{\u0022name\u0022:\u0022# of Turns Played (optional)\u0022,\u0022short\u0022:\u0022Turns\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:true,\u0022optional\u0022:true},\u0022BP\u0022:{\u0022name\u0022:\u0022Battle Points\u0022,\u0022short\u0022:\u0022BP\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:false,\u0022min\u0022:0,\u0022max\u0022:20},\u0022BPObj\u0022:{\u0022name\u0022:\u0022Battle Points (with Objective)\u0022,\u0022short\u0022:\u0022BPObj\u0022,\u0022dispShort\u0022:\u0022BP\u002BObj\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:false,\u0022min\u0022:0,\u0022max\u0022:20,\u0022bonus\u0022:true}},\u0022primary\u0022:\u0022BPObj\u0022,\u0022tieBreakers\u0022:[\u0022Diff\u0022],\u0022objective\u0022:\u0022Obj\u0022},{\u0022id\u0022:11,\u0022name\u0022:\u00229th Age Scoring (version 3)\u0022,\u0022functions\u0022:\u0022t9a3\u0022,\u0022score\u0022:{\u0022VP\u0022:{\u0022name\u0022:\u0022Victory Points\u0022,\u0022short\u0022:\u0022VP\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:true,\u0022min\u0022:0},\u0022Diff\u0022:{\u0022name\u0022:\u0022VP Difference\u0022,\u0022short\u0022:\u0022Diff\u0022,\u0022dispShort\u0022:\u0022VP Diff\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:false,\u0022min\u0022:0},\u0022Obj\u0022:{\u0022name\u0022:\u0022Primary Objective\u0022,\u0022short\u0022:\u0022Obj\u0022,\u0022type\u0022:\u0022player\u0022,\u0022mod\u0022:true},\u0022Sec\u0022:{\u0022name\u0022:\u0022Secondary Objective\u0022,\u0022short\u0022:\u0022Sec\u0022,\u0022dispShort\u0022:\u0022Secondary\u0022,\u0022type\u0022:\u00222player\u0022,\u0022mod\u0022:true},\u0022Turns\u0022:{\u0022name\u0022:\u0022# of Turns Played (optional)\u0022,\u0022short\u0022:\u0022Turns\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:true,\u0022optional\u0022:true},\u0022BP\u0022:{\u0022name\u0022:\u0022Battle Points\u0022,\u0022short\u0022:\u0022BP\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:false,\u0022min\u0022:0,\u0022max\u0022:20},\u0022BPObj\u0022:{\u0022name\u0022:\u0022Battle Points (with Objective)\u0022,\u0022short\u0022:\u0022BPObj\u0022,\u0022dispShort\u0022:\u0022BP\u002BObj\u0022,\u0022type\u0022:\u0022number\u0022,\u0022mod\u0022:false,\u0022min\u0022:0,\u0022max\u0022:20,\u0022bonus\u0022:true}},\u0022primary\u0022:\u0022BPObj\u0022,\u0022tieBreakers\u0022:[\u0022Diff\u0022],\u0022objective\u0022:\u0022Obj\u0022}],\u0022major\u0022:{\u0022*\u0022:[{\u0022date\u0022:\u00222024-08-19\u0022,\u0022name\u0022:\u0022Version 2.0\u0022}]},\u0022setup_categories\u0022:{\u0022map\u0022:{\u0022id\u0022:\u0022map\u0022,\u0022name\u0022:\u0022Map\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:1,\u0022items\u0022:[{\u0022id\u0022:1,\u0022name\u0022:\u0022Custom Map\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022map\u0022},{\u0022ord\u0022:2,\u0022id\u0022:18,\u0022name\u0022:\u0022Map A1\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Shrouded Pool\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EI will dream of this pool until my dying days. We spilled the blood of three peoples to reach it, and though my steps left bloody footprints, no taint of gor touched its waters.\u003C/p\u003E\u003Cp\u003EIn every mirror I see my reflection in its surface, and the faces of the foes who sought to keep me from it. The Lady was with me that day, and ever since.\u003C/p\u003E\u003Cp\u003EBaron Siclebald of Keldonne\u003C/p\u003E\u0022},{\u0022ord\u0022:3,\u0022id\u0022:19,\u0022name\u0022:\u0022Map A2\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Foothill Outpost\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EThese soft borderlanders knew of our approach when their fields burned and their herds scattered before us.\u003C/p\u003E\u003Cp\u003EThey even mounted a pitiful resistance, loosing arrows from roofs and thickets. Yet we poured from hill and forest and fell upon their hamlet.\u003C/p\u003E\u003Cp\u003ESo we took all that they had, and more than they could spare. None will stand between me and my glory - or my Lord\u2019s.\u003C/p\u003E\u003Cp\u003ETolomeo \u201CShieldcleaver\u201D - Chosen Warrior of Sugulag\u003C/p\u003E\u0022},{\u0022ord\u0022:4,\u0022id\u0022:20,\u0022name\u0022:\u0022Map A3\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Dilapidated Manor\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EWe who know the true power behind the world must often work insecret.\u003C/p\u003E\u003Cp\u003EWith only a little persuasion, the former occupants were kind enough to allow this master of mysticism to set up home.\u003C/p\u003E\u003Cp\u003ENow the estate is inhabited by friends ofmine, and our occasional... guests.\u003C/p\u003E\u003Cp\u003EFortunately, their arrival goes unnoticed in this grand place. Once the Courtesan arrives, the city will have such havoc visited upon it, they shall be gifted glorious visions of a new world.\u003C/p\u003E\u003Cp\u003EBalthazar the Magnificent, servant of the Seven\u003C/p\u003E\u0022},{\u0022ord\u0022:5,\u0022id\u0022:21,\u0022name\u0022:\u0022Map A4\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Volcanic Lake\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EIn the mountains of the Blasted Plains, water is avaluable resource. Even the water to be found in avolcanic caldera can beput to good use.\u003C/p\u003E\u003Cp\u003ENow these interlopers would seek to infringe upon lands we hold by divine right?\u003C/p\u003E\u003Cp\u003EBy force of arms they will learn their error. By steel and discipline they will be driven from this  place. By fire will our retribution be delivered to them.\u003C/p\u003E\u003Cp\u003EProphet Tevika of the Gar\u003Cbr\u003EShakhub Citadel\u003C/p\u003E\u0022},{\u0022ord\u0022:6,\u0022id\u0022:22,\u0022name\u0022:\u0022Map A5\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Misty Marshes\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EYou do not see us, but we see you - uninitiated. You tramp the highlands and bring waste and decay - despoilers.\u003C/p\u003E\u003Cp\u003EWe lie in wait, beneath the surface, and still your eyes fail you - hotbloods.\u003C/p\u003E\u003Cp\u003EWe will strike from bush,from swamp, from grass, silent death comes - prey.\u003C/p\u003E\u003Cp\u003EWe mourn your passing, yet your graves will give new life from decay - renewers.\u003C/p\u003E\u003Cp\u003ESkink Captain Akeakami\u003C/p\u003E\u0022},{\u0022ord\u0022:7,\u0022id\u0022:23,\u0022name\u0022:\u0022Map A6\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ancient Walls\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOnce our walls stood highand proud over the city of Khedesai. Centuries of wind and sand have created breaches that no battering ram ever did.\u003C/p\u003E\u003Cp\u003EYou saw our unmanned walls and thought our history was yours for the taking. Our legacy there to be plundered.\u003C/p\u003E\u003Cp\u003EWe rose from our eternal rest. Took up weapons that survived the ages. Set ourselves to defend our home. And drove the living from our hallowed ground.\u003C/p\u003E\u003Cp\u003EDeath Hierarch Nehi\u003C/p\u003E\u0022},{\u0022ord\u0022:8,\u0022id\u0022:24,\u0022name\u0022:\u0022Map A7\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Beacon Hill\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EAbove all, our people survive on their discipline.\u003C/p\u003E\u003Cp\u003ESome will speak of guns and artillery. They have not seen damp powder or misfires. Some will speak of arms and armour.\u003C/p\u003E\u003Cp\u003EThey have not seen swords break. Some will talk of faith. I honour Sunna, but she will not defend us - we must fight in her name.\u003C/p\u003E\u003Cp\u003EDiscipline  holds us together, binds us to our cause. The Beacons are a symbol of our commitment, and we will defend them!\u003C/p\u003E\u003Cp\u003EMarshall Hugo Hafer\u003C/p\u003E\u0022},{\u0022ord\u0022:9,\u0022id\u0022:25,\u0022name\u0022:\u0022Map A8\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Witch\u2019s Cottage\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EIn the truly wild places, few make their home. As we travel the DarkWoods, we know all the denizens beneath the black boughs.\u003C/p\u003E\u003Cp\u003EThrough the  tangled thickets and dire beasts, the Witch\u2019s story is known to all our people in this land. From her cabin, the Witch sees all, and we respect her wisdom and her trade in herbs - and ales.\u003C/p\u003E\u003Cp\u003ENow interlopers walk beneath the canopy, among her gardens, and we will drive them backonce more. That her story may continue, and that we may tell it anew.\u003C/p\u003E\u003Cp\u003ESoothsayer Bremen\u003C/p\u003E\u0022},{\u0022ord\u0022:10,\u0022id\u0022:26,\u0022name\u0022:\u0022Map B1\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Mage\u2019s Sanctum\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EMany who are talented in the Art choose to reside in our great institutions. Asfada and Canrac offer unparalleled opportunities for magical study. Yet many choose tobuild their own towers in isolation, preferring seclusion while hoarding secrets.\u003C/p\u003E\u003Cp\u003EThe home of Mage Ilthuryn is one such location. An imposing holdfast of white stone, set in a hollow with a still pool of silvery water.\u003C/p\u003E\u003Cp\u003ENow that home is under attack from invaders, and we are mustered to defend the Master Mage. Let nothing stand in our way. For Celeda Ablan!\u003C/p\u003E\u003Cp\u003EWarden of the Flame\u003Cbr\u003ECivessin Eilynore\u003C/p\u003E\u0022},{\u0022ord\u0022:11,\u0022id\u0022:27,\u0022name\u0022:\u0022Map B2\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Villa Grounds\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EThe nobles of Dathen take great pride in their majestic estates, displays of their position and standing.\u003C/p\u003E\u003Cp\u003EThe villa of Prince Folmon Perxina is no exception. He commands one of the grandest manors to be found, with extensive grounds spreading out across the landscape.\u003C/p\u003E\u003Cp\u003EIt is known that beasts trained in the Menagerie roam the holdings, tasked with savaging any who would dare to transgress.\u003C/p\u003E\u003Cp\u003EThe Prince\u2019s personal guard represents a veritable army, and this is the force you now  find yourself in service to. Serve well, and you may secure advancement.\u003C/p\u003E\u003Cp\u003EDread Sergeant\u003Cbr\u003ETrabhr\u00E6n Crislain\u003C/p\u003E\u0022},{\u0022ord\u0022:12,\u0022id\u0022:28,\u0022name\u0022:\u0022Map B3\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ancient Fortress\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EAmong the peaks and valleys of the White Mountains, there are many remnants of bastions which once marked frontiers of our Holds.\u003C/p\u003E\u003Cp\u003EThe  crumbling walls and slopes of Dun Kenaz are one such example. This was once a thriving stronghold, home to a hundred of our kin and a stopping point for those who traversed this mountain pass.\u003C/p\u003E\u003Cp\u003EI dream that one day thefort will be restored, that the walls can be repaired and the flooded courtyard drained and relaid.\u003C/p\u003E\u003Cp\u003EFor now though, I pledge to ensure no others desecrate the memories of those who died and were buried beneath this place.\u003C/p\u003E\u003Cp\u003EThane Bodraz\u003Cbr\u003EBronzespine\u003C/p\u003E\u0022},{\u0022ord\u0022:13,\u0022id\u0022:29,\u0022name\u0022:\u0022Map B4\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Frontier Farm\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOn the border of the Steppe and Tsuandan, the locals know they owe tribute to the Great Khan. Food grown along the border will feed our tribe through the harsh winter.\u003C/p\u003E\u003Cp\u003EWhere there is value,there are thieves. Now they set upon our people,and we must drive the wolves back. Longjing\u2019s people often press along our border, but when they threaten our sustenance, they will taste our wrath.\u003C/p\u003E\u003Cp\u003ECall in the tribe, ready the cannons, and prepare the beasts.\u003C/p\u003E\u003Cp\u003EKhan Jetei\u003C/p\u003E\u0022},{\u0022ord\u0022:14,\u0022id\u0022:30,\u0022name\u0022:\u0022Map B5\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ravaged Watchtower\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003E In times long past, our reach extended across most of the known world. The Awakening set us as the inheritors of Avras, and all its glory. \u003C/p\u003E \u003Cp\u003E When we were forced to abandon our birthright, our people found havens in many places beneath the notice of those who thought us dispatched. \u003C/p\u003E \u003Cp\u003E This watchtower once stood on the fringes of our territory, in what was the Regio Equitatem. The horselords who rule these lands now see a mere husk of a structure, with no clue of the strength positioned within. These seeds lie in many places, and wait our moment to rise again. \u003C/p\u003E \u003Cp\u003E Senator Mettius Sigilis \u003C/p\u003E\u0022},{\u0022ord\u0022:15,\u0022id\u0022:31,\u0022name\u0022:\u0022Map B6\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Creeping Forest\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOurs is the tree, the thicket, the forest. Ours is the wilderness, the sylvan lands, the liminal places. \u003C/p\u003E \u003Cp\u003E Yours are the villages, the towns, the cities. The foolhardy attempt to have nature follow lines and squares. \u003C/p\u003E \u003Cp\u003E We see you from our home. For so long as you keep a distance we tolerate. But transgress once too often, and you may find the forest draws near. Nothing built by mortals cannot be undone by nature and time. \u003C/p\u003E \u003Cp\u003E Druid Narycot \u003C/p\u003E\u0022},{\u0022ord\u0022:16,\u0022id\u0022:32,\u0022name\u0022:\u0022Map B7\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Eerie Graveyard\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003E Rest in peace. A quaint notion. To lay the body to rest, to bury all the infinite possibilities in the ground, for worms and maggots to feast. \u003C/p\u003E \u003Cp\u003E You fear my kind. Our knowledge scares you, as does our strength and will to use it. Here, in this quiet hamlet, I have everything I need to build an army. \u003C/p\u003E \u003Cp\u003E The souls of your dead, will provide my soldiers. Your cattle will fall and my zombies will rise. \u003C/p\u003E \u003Cp\u003E And buried somewhere in the nearby hills, I have heard tell of a dragon\u2019s fallen form. Soon, I will be among the great powers, all beginning from a small town graveyard. Rest in peace? You may try\u2026 \u003C/p\u003E \u003Cp\u003E Zakutnik the Necromancer \u003C/p\u003E\u0022},{\u0022ord\u0022:17,\u0022id\u0022:33,\u0022name\u0022:\u0022Map B8\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Shattered Bridge\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EWe cross the bridge, we take the town, we win the game, we take the loot, we keep moving. \u003C/p\u003E \u003Cp\u003E Now peaceborn want to stop us. Break their own bridge. Think Warborn can\u2019t swim? Think goblins not make bridges? We can\u2019t build boats? \u003C/p\u003E \u003Cp\u003E Extra challenge for all this time. Maybe some are returned to the Sleep, and we wait to see them again. \u003C/p\u003E \u003Cp\u003E But we are not easy stopped. We will break walls, show strength, win with cunning. We are born of war, and this will be best war yet! \u003C/p\u003E \u003Cp\u003E Warboss Urbul \u003C/p\u003E\u0022}]},\u0022deployment\u0022:{\u0022id\u0022:\u0022deployment\u0022,\u0022name\u0022:\u0022Deployment Type\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:2,\u0022items\u0022:[{\u0022id\u0022:18,\u0022name\u0022:\u0022Frontline Clash\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:19,\u0022name\u0022:\u0022Dawn Assault\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:20,\u0022name\u0022:\u0022Counterthrust\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:21,\u0022name\u0022:\u0022Encircle\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:22,\u0022name\u0022:\u0022Refused Flank\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:23,\u0022name\u0022:\u0022Marching Columns\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:32,\u0022name\u0022:\u0022Surging Tide\u0022,\u0022ord\u0022:7,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:24,\u0022name\u0022:\u0022Custom Deployment\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022deployment\u0022}]},\u0022objective\u0022:{\u0022id\u0022:\u0022objective\u0022,\u0022name\u0022:\u0022Secondary Objective\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:3,\u0022items\u0022:[{\u0022id\u0022:25,\u0022name\u0022:\u0022Hold the Ground\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:26,\u0022name\u0022:\u0022Breakthrough\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:27,\u0022name\u0022:\u0022Spoils of War\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:28,\u0022name\u0022:\u0022King of the Hill\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:29,\u0022name\u0022:\u0022Capture the Flags\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:30,\u0022name\u0022:\u0022Secure Target\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:33,\u0022name\u0022:\u0022Breaking Flags\u0022,\u0022ord\u0022:7,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:34,\u0022name\u0022:\u0022Hold the Targets\u0022,\u0022ord\u0022:8,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:31,\u0022name\u0022:\u0022Custom Objective\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022objective\u0022}]}},\u0022defaultMaxCosts\u0022:{\u0022pts\u0022:4000},\u0022builderSettings\u0022:[{\u0022id\u0022:\u0022army_type\u0022,\u0022type\u0022:\u0022select\u0022,\u0022name\u0022:\u0022Army Type\u0022,\u0022values\u0022:[{\u0022text\u0022:\u0022Automatic\u0022},{\u0022value\u0022:\u00221\u0022,\u0022text\u0022:\u0022Regular Army\u0022},{\u0022value\u0022:\u00222\u0022,\u0022text\u0022:\u0022Grand Army\u0022},{\u0022value\u0022:\u00223\u0022,\u0022text\u0022:\u0022Warband\u0022}]}],\u0022defaultScoring\u0022:11,\u0022seasons\u0022:[{\u0022id\u0022:0,\u0022name\u0022:\u0022T9A 2.0\u0022,\u0022booksDate\u0022:\u00222024-08-19\u0022,\u0022game_setup\u0022:{\u0022map\u0022:{\u0022id\u0022:\u0022map\u0022,\u0022name\u0022:\u0022Map\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:1,\u0022items\u0022:[{\u0022id\u0022:1,\u0022name\u0022:\u0022Custom Map\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022map\u0022},{\u0022ord\u0022:2,\u0022id\u0022:18,\u0022name\u0022:\u0022Map A1\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Shrouded Pool\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EI will dream of this pool until my dying days. We spilled the blood of three peoples to reach it, and though my steps left bloody footprints, no taint of gor touched its waters.\u003C/p\u003E\u003Cp\u003EIn every mirror I see my reflection in its surface, and the faces of the foes who sought to keep me from it. The Lady was with me that day, and ever since.\u003C/p\u003E\u003Cp\u003EBaron Siclebald of Keldonne\u003C/p\u003E\u0022},{\u0022ord\u0022:3,\u0022id\u0022:19,\u0022name\u0022:\u0022Map A2\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Foothill Outpost\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EThese soft borderlanders knew of our approach when their fields burned and their herds scattered before us.\u003C/p\u003E\u003Cp\u003EThey even mounted a pitiful resistance, loosing arrows from roofs and thickets. Yet we poured from hill and forest and fell upon their hamlet.\u003C/p\u003E\u003Cp\u003ESo we took all that they had, and more than they could spare. None will stand between me and my glory - or my Lord\u2019s.\u003C/p\u003E\u003Cp\u003ETolomeo \u201CShieldcleaver\u201D - Chosen Warrior of Sugulag\u003C/p\u003E\u0022},{\u0022ord\u0022:4,\u0022id\u0022:20,\u0022name\u0022:\u0022Map A3\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Dilapidated Manor\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EWe who know the true power behind the world must often work insecret.\u003C/p\u003E\u003Cp\u003EWith only a little persuasion, the former occupants were kind enough to allow this master of mysticism to set up home.\u003C/p\u003E\u003Cp\u003ENow the estate is inhabited by friends ofmine, and our occasional... guests.\u003C/p\u003E\u003Cp\u003EFortunately, their arrival goes unnoticed in this grand place. Once the Courtesan arrives, the city will have such havoc visited upon it, they shall be gifted glorious visions of a new world.\u003C/p\u003E\u003Cp\u003EBalthazar the Magnificent, servant of the Seven\u003C/p\u003E\u0022},{\u0022ord\u0022:5,\u0022id\u0022:21,\u0022name\u0022:\u0022Map A4\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Volcanic Lake\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EIn the mountains of the Blasted Plains, water is avaluable resource. Even the water to be found in avolcanic caldera can beput to good use.\u003C/p\u003E\u003Cp\u003ENow these interlopers would seek to infringe upon lands we hold by divine right?\u003C/p\u003E\u003Cp\u003EBy force of arms they will learn their error. By steel and discipline they will be driven from this  place. By fire will our retribution be delivered to them.\u003C/p\u003E\u003Cp\u003EProphet Tevika of the Gar\u003Cbr\u003EShakhub Citadel\u003C/p\u003E\u0022},{\u0022ord\u0022:6,\u0022id\u0022:22,\u0022name\u0022:\u0022Map A5\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Misty Marshes\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EYou do not see us, but we see you - uninitiated. You tramp the highlands and bring waste and decay - despoilers.\u003C/p\u003E\u003Cp\u003EWe lie in wait, beneath the surface, and still your eyes fail you - hotbloods.\u003C/p\u003E\u003Cp\u003EWe will strike from bush,from swamp, from grass, silent death comes - prey.\u003C/p\u003E\u003Cp\u003EWe mourn your passing, yet your graves will give new life from decay - renewers.\u003C/p\u003E\u003Cp\u003ESkink Captain Akeakami\u003C/p\u003E\u0022},{\u0022ord\u0022:7,\u0022id\u0022:23,\u0022name\u0022:\u0022Map A6\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ancient Walls\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOnce our walls stood highand proud over the city of Khedesai. Centuries of wind and sand have created breaches that no battering ram ever did.\u003C/p\u003E\u003Cp\u003EYou saw our unmanned walls and thought our history was yours for the taking. Our legacy there to be plundered.\u003C/p\u003E\u003Cp\u003EWe rose from our eternal rest. Took up weapons that survived the ages. Set ourselves to defend our home. And drove the living from our hallowed ground.\u003C/p\u003E\u003Cp\u003EDeath Hierarch Nehi\u003C/p\u003E\u0022},{\u0022ord\u0022:8,\u0022id\u0022:24,\u0022name\u0022:\u0022Map A7\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Beacon Hill\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EAbove all, our people survive on their discipline.\u003C/p\u003E\u003Cp\u003ESome will speak of guns and artillery. They have not seen damp powder or misfires. Some will speak of arms and armour.\u003C/p\u003E\u003Cp\u003EThey have not seen swords break. Some will talk of faith. I honour Sunna, but she will not defend us - we must fight in her name.\u003C/p\u003E\u003Cp\u003EDiscipline  holds us together, binds us to our cause. The Beacons are a symbol of our commitment, and we will defend them!\u003C/p\u003E\u003Cp\u003EMarshall Hugo Hafer\u003C/p\u003E\u0022},{\u0022ord\u0022:9,\u0022id\u0022:25,\u0022name\u0022:\u0022Map A8\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Witch\u2019s Cottage\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EIn the truly wild places, few make their home. As we travel the DarkWoods, we know all the denizens beneath the black boughs.\u003C/p\u003E\u003Cp\u003EThrough the  tangled thickets and dire beasts, the Witch\u2019s story is known to all our people in this land. From her cabin, the Witch sees all, and we respect her wisdom and her trade in herbs - and ales.\u003C/p\u003E\u003Cp\u003ENow interlopers walk beneath the canopy, among her gardens, and we will drive them backonce more. That her story may continue, and that we may tell it anew.\u003C/p\u003E\u003Cp\u003ESoothsayer Bremen\u003C/p\u003E\u0022},{\u0022ord\u0022:10,\u0022id\u0022:26,\u0022name\u0022:\u0022Map B1\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Mage\u2019s Sanctum\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EMany who are talented in the Art choose to reside in our great institutions. Asfada and Canrac offer unparalleled opportunities for magical study. Yet many choose tobuild their own towers in isolation, preferring seclusion while hoarding secrets.\u003C/p\u003E\u003Cp\u003EThe home of Mage Ilthuryn is one such location. An imposing holdfast of white stone, set in a hollow with a still pool of silvery water.\u003C/p\u003E\u003Cp\u003ENow that home is under attack from invaders, and we are mustered to defend the Master Mage. Let nothing stand in our way. For Celeda Ablan!\u003C/p\u003E\u003Cp\u003EWarden of the Flame\u003Cbr\u003ECivessin Eilynore\u003C/p\u003E\u0022},{\u0022ord\u0022:11,\u0022id\u0022:27,\u0022name\u0022:\u0022Map B2\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Villa Grounds\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EThe nobles of Dathen take great pride in their majestic estates, displays of their position and standing.\u003C/p\u003E\u003Cp\u003EThe villa of Prince Folmon Perxina is no exception. He commands one of the grandest manors to be found, with extensive grounds spreading out across the landscape.\u003C/p\u003E\u003Cp\u003EIt is known that beasts trained in the Menagerie roam the holdings, tasked with savaging any who would dare to transgress.\u003C/p\u003E\u003Cp\u003EThe Prince\u2019s personal guard represents a veritable army, and this is the force you now  find yourself in service to. Serve well, and you may secure advancement.\u003C/p\u003E\u003Cp\u003EDread Sergeant\u003Cbr\u003ETrabhr\u00E6n Crislain\u003C/p\u003E\u0022},{\u0022ord\u0022:12,\u0022id\u0022:28,\u0022name\u0022:\u0022Map B3\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ancient Fortress\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EAmong the peaks and valleys of the White Mountains, there are many remnants of bastions which once marked frontiers of our Holds.\u003C/p\u003E\u003Cp\u003EThe  crumbling walls and slopes of Dun Kenaz are one such example. This was once a thriving stronghold, home to a hundred of our kin and a stopping point for those who traversed this mountain pass.\u003C/p\u003E\u003Cp\u003EI dream that one day thefort will be restored, that the walls can be repaired and the flooded courtyard drained and relaid.\u003C/p\u003E\u003Cp\u003EFor now though, I pledge to ensure no others desecrate the memories of those who died and were buried beneath this place.\u003C/p\u003E\u003Cp\u003EThane Bodraz\u003Cbr\u003EBronzespine\u003C/p\u003E\u0022},{\u0022ord\u0022:13,\u0022id\u0022:29,\u0022name\u0022:\u0022Map B4\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Frontier Farm\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOn the border of the Steppe and Tsuandan, the locals know they owe tribute to the Great Khan. Food grown along the border will feed our tribe through the harsh winter.\u003C/p\u003E\u003Cp\u003EWhere there is value,there are thieves. Now they set upon our people,and we must drive the wolves back. Longjing\u2019s people often press along our border, but when they threaten our sustenance, they will taste our wrath.\u003C/p\u003E\u003Cp\u003ECall in the tribe, ready the cannons, and prepare the beasts.\u003C/p\u003E\u003Cp\u003EKhan Jetei\u003C/p\u003E\u0022},{\u0022ord\u0022:14,\u0022id\u0022:30,\u0022name\u0022:\u0022Map B5\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ravaged Watchtower\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003E In times long past, our reach extended across most of the known world. The Awakening set us as the inheritors of Avras, and all its glory. \u003C/p\u003E \u003Cp\u003E When we were forced to abandon our birthright, our people found havens in many places beneath the notice of those who thought us dispatched. \u003C/p\u003E \u003Cp\u003E This watchtower once stood on the fringes of our territory, in what was the Regio Equitatem. The horselords who rule these lands now see a mere husk of a structure, with no clue of the strength positioned within. These seeds lie in many places, and wait our moment to rise again. \u003C/p\u003E \u003Cp\u003E Senator Mettius Sigilis \u003C/p\u003E\u0022},{\u0022ord\u0022:15,\u0022id\u0022:31,\u0022name\u0022:\u0022Map B6\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Creeping Forest\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOurs is the tree, the thicket, the forest. Ours is the wilderness, the sylvan lands, the liminal places. \u003C/p\u003E \u003Cp\u003E Yours are the villages, the towns, the cities. The foolhardy attempt to have nature follow lines and squares. \u003C/p\u003E \u003Cp\u003E We see you from our home. For so long as you keep a distance we tolerate. But transgress once too often, and you may find the forest draws near. Nothing built by mortals cannot be undone by nature and time. \u003C/p\u003E \u003Cp\u003E Druid Narycot \u003C/p\u003E\u0022},{\u0022ord\u0022:16,\u0022id\u0022:32,\u0022name\u0022:\u0022Map B7\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Eerie Graveyard\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003E Rest in peace. A quaint notion. To lay the body to rest, to bury all the infinite possibilities in the ground, for worms and maggots to feast. \u003C/p\u003E \u003Cp\u003E You fear my kind. Our knowledge scares you, as does our strength and will to use it. Here, in this quiet hamlet, I have everything I need to build an army. \u003C/p\u003E \u003Cp\u003E The souls of your dead, will provide my soldiers. Your cattle will fall and my zombies will rise. \u003C/p\u003E \u003Cp\u003E And buried somewhere in the nearby hills, I have heard tell of a dragon\u2019s fallen form. Soon, I will be among the great powers, all beginning from a small town graveyard. Rest in peace? You may try\u2026 \u003C/p\u003E \u003Cp\u003E Zakutnik the Necromancer \u003C/p\u003E\u0022},{\u0022ord\u0022:17,\u0022id\u0022:33,\u0022name\u0022:\u0022Map B8\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Shattered Bridge\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EWe cross the bridge, we take the town, we win the game, we take the loot, we keep moving. \u003C/p\u003E \u003Cp\u003E Now peaceborn want to stop us. Break their own bridge. Think Warborn can\u2019t swim? Think goblins not make bridges? We can\u2019t build boats? \u003C/p\u003E \u003Cp\u003E Extra challenge for all this time. Maybe some are returned to the Sleep, and we wait to see them again. \u003C/p\u003E \u003Cp\u003E But we are not easy stopped. We will break walls, show strength, win with cunning. We are born of war, and this will be best war yet! \u003C/p\u003E \u003Cp\u003E Warboss Urbul \u003C/p\u003E\u0022}]},\u0022deployment\u0022:{\u0022id\u0022:\u0022deployment\u0022,\u0022name\u0022:\u0022Deployment Type\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:2,\u0022items\u0022:[{\u0022id\u0022:18,\u0022name\u0022:\u0022Frontline Clash\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:19,\u0022name\u0022:\u0022Dawn Assault\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:20,\u0022name\u0022:\u0022Counterthrust\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:21,\u0022name\u0022:\u0022Encircle\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:22,\u0022name\u0022:\u0022Refused Flank\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:23,\u0022name\u0022:\u0022Marching Columns\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:32,\u0022name\u0022:\u0022Surging Tide\u0022,\u0022ord\u0022:7,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:24,\u0022name\u0022:\u0022Custom Deployment\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022deployment\u0022}]},\u0022objective\u0022:{\u0022id\u0022:\u0022objective\u0022,\u0022name\u0022:\u0022Secondary Objective\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:3,\u0022items\u0022:[{\u0022id\u0022:25,\u0022name\u0022:\u0022Hold the Ground\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:26,\u0022name\u0022:\u0022Breakthrough\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:27,\u0022name\u0022:\u0022Spoils of War\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:28,\u0022name\u0022:\u0022King of the Hill\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:29,\u0022name\u0022:\u0022Capture the Flags\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:30,\u0022name\u0022:\u0022Secure Target\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:33,\u0022name\u0022:\u0022Breaking Flags\u0022,\u0022ord\u0022:7,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:34,\u0022name\u0022:\u0022Hold the Targets\u0022,\u0022ord\u0022:8,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:31,\u0022name\u0022:\u0022Custom Objective\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022objective\u0022}]}}},{\u0022id\u0022:1,\u0022name\u0022:\u0022Season 1: The Broken Isles\u0022,\u0022game_setup\u0022:{\u0022map\u0022:{\u0022id\u0022:\u0022map\u0022,\u0022name\u0022:\u0022Map\u0022,\u0022image\u0022:true,\u0022ord\u0022:1,\u0022items\u0022:[{\u0022name\u0022:\u0022Map 1 - Clearwater Springs\u0022,\u0022id\u0022:1,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluff\u0022:\u0022Not all the Broken Isles are inhabitable, but most are thanks to an abundance of natural springs \u2013 even on islands without lakes or rivers. Several springs, such as that of the Temple of Serena in Patmos, are considered sacred by the locals.\u0022},{\u0022name\u0022:\u0022Map 2 - Ancient Fortifications\u0022,\u0022id\u0022:2,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluff\u0022:\u0022The Broken Isles have been fought over throughout all nine ages, seeing many empires come and go. Ancient ruins are more common here than almost anywhere else in the world, and many are surrounded by the remains of earthen banks, ditches, or crumbing walls that once served as defenses. The grandiose, Golden Age ruins of Dhimkalos are said to be particularly impressive.\u0022},{\u0022name\u0022:\u0022Map 3 - Dormant Caldera\u0022,\u0022id\u0022:3,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluff\u0022:\u0022Much of the region is volcanically active, and some crater-shaped islands bear the telltale signs of ancient eruptions. Some calderas contain pools or lakes after stormy weather, as well as the remains of those who have attempted to settle the summit. The legendary site of Ulxis is perhaps the best-known example \u2013 though its Oracle and her cult remain there to this day.\u0022},{\u0022name\u0022:\u0022Map 4 \u2013 Abandoned Settlement\u0022,\u0022id\u0022:4,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluff\u0022:\u0022The most impressive ruins can be quite extensive, indicating a former city or important port. These sites often demonstrate habitation across different eras. The ongoing excavation of Taynagrit by archaeologists from Sonnstahl has so far revealed temples, halls and even pyramids from distinct ages, all atop an elven city from the Golden Age.\u0022},{\u0022name\u0022:\u0022Map 5 \u2013 Historic Battlefield\u0022,\u0022id\u0022:5,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluff\u0022:\u0022Certain parts of an island\u2019s terrain present natural arenas or unique opportunities for bringing armies to battle. Many commanders \u2013 knowingly or not \u2013 find themselves fighting atop the bones of fallen warriors from ancient wars. The city of Mykleos was famously the site of a long siege that has since passed into myth and song, with many legendary battles having been fought in the surrounding region.\u0022},{\u0022name\u0022:\u0022Map 6 \u2013 Mountainous Crags\u0022,\u0022id\u0022:6,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluff\u0022:\u0022As their name suggests, the Broken Isles are known for rough, jagged terrain, making for impassable coastlines, spectacular peaks and dizzying cliffs. Some of the most remarkable sites from antiquity have been discovered atop mountains or within hidden passes between the crags \u2013 such as the renowned Cairn of Mileusa, a huge mound of stones dedicated to a namless champion of long ago.\u0022}]},\u0022deployment\u0022:{\u0022id\u0022:\u0022deployment\u0022,\u0022name\u0022:\u0022Deployment Type\u0022,\u0022ord\u0022:2,\u0022image\u0022:true,\u0022items\u0022:[{\u0022id\u0022:21,\u0022name\u0022:\u0022Frontline Clash\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:22,\u0022name\u0022:\u0022Bottleneck\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:23,\u0022name\u0022:\u0022Spearhead\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:24,\u0022name\u0022:\u0022Mutual Encroachment\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:25,\u0022name\u0022:\u0022Refused Flank\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:26,\u0022name\u0022:\u0022Cornerstone\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022deployment\u0022}]},\u0022primary_objective\u0022:{\u0022id\u0022:\u0022primary_objective\u0022,\u0022name\u0022:\u0022Primary Objective\u0022,\u0022ord\u0022:3,\u0022items\u0022:[{\u0022id\u0022:31,\u0022name\u0022:\u0022Spoils of War\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E:When an enemy unit is Destroyed in Combat, the opposing player puts one Spoils Token on one of their Scoring Units (if there are any) that was just engaged with the unit Destroyed in Combat. A unit loses all of its Spoils Tokens when any of the following occurs:\u003Cbr/\u003E\u2022 The last Health Point on its Rank-and-File models is lost.\u003Cbr/\u003E\u2022 It becomes Shaken. Remember that units that perform a Flee Move automatically become Shaken.\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, the player with the most Spoils Token on their units wins this Primary Objective.\u0022},{\u0022id\u0022:32,\u0022name\u0022:\u0022Breakthrough\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark Deployment Zones.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, each player adds together the number of Scoring Units in their opponent\u2019s Deployment Zone and the number of enemy units that were Scoring at the start of the game that were Destroyed in Combat. The player with the highest total wins the Primary Objective.\u0022},{\u0022id\u0022:33,\u0022name\u0022:\u0022Secure Target\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Place 2 markers with their centers on the line dividing the board into halves (the dashed line in the figures describing Deployment Types), one on each side of the centre of the table, as close as possible to a third of the length of the long Board Edge (24\u2033 on a 72\u2033 wide board) away from it, and more than 1\u2033 away from Impassable Terrain.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: A marker is controlled by the player with the most expensive Scoring Units within 12\u2033 of the centre of the marker (if both players have Scoring Units with identical Points Cost, no one  controls it).\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of Game Turns 3\u20136, a Victory Counter is awarded to a Player which controls an Objective. The player with the most such Victory Counters at the end of the game wins this Primary Objective.\u0022},{\u0022id\u0022:34,\u0022name\u0022:\u0022Forage and Plunder\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E:Nominate a total of three different Terrain Features: The Terrain Features closest to the centre of the Battlefield. Then both players nominate a not already nominated Terrain Feature that is fully outside their own Deployment Zone they may nominate the same. Impassable Terrain and Walls cannot be nominated.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: You automatically plunder a nominated Terrain Feature, that you have not already plundered, when a friendly Scoring Units starts 6 in contact with it during your Player Turn 3-6. Both players can plunder all nominated Terrain Features once, even if the other player has already done so.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, if one player has plundered more nominated Terrain Features than the other player they win this Primary Objective.\u0022},{\u0022id\u0022:35,\u0022name\u0022:\u0022Hold the Centre\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark the centre of the table.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: The battlefield is controlled by the player with the most expensive Scoring Units within 12\u2033 of the centre of the table (if both players have Scoring Units with identical Points Cost, no one controls it).\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of Game Turns 3\u20136, a Victory Counter is awarded to a Player who controls at least one marker. The player with the most such Victory Counters at the end of the game wins this Primary Objective.\u0022},{\u0022id\u0022:36,\u0022name\u0022:\u0022Hidden Agendas\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: Winning a Secondary Objective is worth \u002B/-2 Battle Points. This replaces the normal Battle Points bonus for winning Primary and Secondary Objectives.\u0022}]},\u0022secondary_objective\u0022:{\u0022id\u0022:\u0022secondary_objective\u0022,\u0022name\u0022:\u0022Secondary Objective\u0022,\u0022perplayer\u0022:true,\u0022ord\u0022:4,\u0022items\u0022:[{\u0022id\u0022:41,\u0022name\u0022:\u0022Capture the Flags\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022bh\u0022,\u0022de\u0022,\u0022dl\u0022,\u0022ong\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if you have more Standard Bearers and Battle Standard Bearers on the Battlefield, than the opponent has.\u0022},{\u0022id\u0022:42,\u0022name\u0022:\u0022Commit to Battle\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022bh\u0022,\u0022ok\u0022,\u0022ong\u0022,\u0022wdg\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark the opponent\u2019s Deployment Zone.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if you have more Scoring Units in your opponent\u2019s Deployment Zone than the opponent has (in their own Deployment Zone).\u0022},{\u0022id\u0022:43,\u0022name\u0022:\u0022Demonstrate Superiority\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022de\u0022,\u0022he\u0022,\u0022vc\u0022,\u0022wdg\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: The opponent nominates one of their units. If possible, this must be the most expensive Scoring Unit.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if the nominated unit has been destroyed.\u0022},{\u0022id\u0022:44,\u0022name\u0022:\u0022Enslave and Ransom\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022de\u0022,\u0022id\u0022,\u0022ok\u0022,\u0022vs\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: None.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: You gain an Enslaved Counter each time an enemy unit is Destroyed in Combat.\u003Cbr/\u003EIf the unit is Destroyed in step 5 of the Round of Combat sequence (Breaking and Pursuing) you gain an additional Enslaved Counter. This includes failing a Break Test and being caught or dying during the Flee Move, Supernal unit failing a Break Test or Unstable unit losing a Combat and being wiped due to HP loss. This does not include units being destroyed as a direct result of Melee Attacks. Ignore Attachable Models joined to units with Rank-and-File models.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if you have at least four Enslaved Counters.\u0022},{\u0022id\u0022:45,\u0022name\u0022:\u0022Master the Veil\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022dl\u0022,\u0022he\u0022,\u0022ud\u0022,\u0022vc\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark the centre of the table.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if you have a model with Channel, or that knows a spell (Learned Spell or Bound Spell), within 12\u2033 of the centre of table, and the opponent has not.\u0022},{\u0022id\u0022:46,\u0022name\u0022:\u0022Forbid Trespass\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022bh\u0022,\u0022koe\u0022,\u0022sa\u0022,\u0022se\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: You nominate a Terrain Feature on the Battlefield that is more than 12\u2033 away from any Table Edge, other than Impassable Terrain.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: A nominated Terrain Feature is plundered when an enemy Scoring Unit starts any of its Player Turn 3\u20136 in contact with it.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if the nominated Terrain Feature was not plundered.\u0022},{\u0022id\u0022:47,\u0022name\u0022:\u0022Seize and Secure\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022dl\u0022,\u0022koe\u0022,\u0022se\u0022,\u0022ud\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: The opponent nominates a Terrain Feature on the Battlefield that is more than 12\u2033 away from any Table Edge. Impassable Terrain cannot be nominated.\u003Cbr/\u003E Rules: A nominated Terrain Feature is plundered when a friendly Scoring Unit starts any of its Player Turn 3\u20136 in contact with it.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: A nominated Terrain Feature is plundered when an enemy Scoring Unit starts any of its Player Turn 3\u20136 in contact with it.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective if the nominated Terrain Feature was plundered.\u0022},{\u0022id\u0022:48,\u0022name\u0022:\u0022Settle the Score\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022dh\u0022,\u0022id\u0022,\u0022se\u0022,\u0022vc\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: The opponent nominates one of their units. If possible, this must be the most expensive non-Scoring Unit.\u003Cbr/\u003E Rules: A nominated Terrain Feature is plundered when a friendly Scoring Unit starts any of its Player Turn 3\u20136 in contact with it.\u003Cbr/\u003E \u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E \u003Cb\u003EWinning conditions\u003C/b\u003E: At the end of the game, you win this Secondary Objective, if the nominated unit has been destroyed.\u0022},{\u0022id\u0022:49,\u0022name\u0022:\u0022Slay the Beast\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022koe\u0022,\u0022ok\u0022,\u0022ong\u0022,\u0022wdg\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: The opponent nominates one of their units. If possible, this must be the unit in the Army List with the largest HP / model ratio.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning Conditions\u003C/b\u003E:At the end of the game, you win this Secondary Objective, if the nominated unit has been destroyed.\u0022},{\u0022id\u0022:410,\u0022name\u0022:\u0022Stand Firm\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022dh\u0022,\u0022eos\u0022,\u0022he\u0022,\u0022sa\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark your Deployment Zone.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning Conditions\u003C/b\u003E:At the end of the game, you win this Secondary Objective if you have more Scoring Units in your Deployment Zone than the opponent has (in your Deployment Zone).\u0022},{\u0022id\u0022:411,\u0022name\u0022:\u0022Unleash the Big Guns\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022dh\u0022,\u0022eos\u0022,\u0022id\u0022,\u0022vs\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: You nominate two Terrain Features on the Battlefield that are not fully within your Deployment Zone. Impassable Terrain and Walls cannot be nominated. Then mark up all non-Characters units from your Army List that have Shooting Weapons and one Scoring unit without Shooting Weapons. Finally, if less than five units have been marked, you may mark one additional Scoring Unit.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: \u003Cbr/\u003E\u003Cb\u003EWinning Conditions\u003C/b\u003E: non-Shaken makred unit in both nominated Terrain Features.\u0022},{\u0022id\u0022:412,\u0022name\u0022:\u0022Work as One\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022armies\u0022:[\u0022eos\u0022,\u0022sa\u0022,\u0022id\u0022,\u0022vs\u0022],\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark the centre of the table.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EWinning Conditions\u003C/b\u003E:At the end of the game, you win this Secondary Objective if you have more Scoring Units within 9\u2033 of the centre of table than the opponent has.\u0022}]}},\u0022leadership_skills\u0022:{\u0022type\u0022:\u0022group\u0022,\u0022optionsLabel\u0022:\u0022Specialist Skills\u0022,\u0022maxSize\u0022:1,\u0022option_id\u0022:\u0022fn23ifin320fn23i0fnf9032nf32\u0022,\u0022options\u0022:[{\u0022option_id\u0022:\u0022egfmewg430gm43gm43gfm2g34\u0022,\u0022type\u0022:\u0022check\u0022,\u0022name\u0022:\u0022Trusted Adviser\u0022,\u0022cost\u0022:25,\u0022description\u0022:\u0022When an army that includes a Trusted Adviser is about to roll for which Secondary Objective to play, roll twice, and if a duplicate is rolled, roll again until two different Secondary Objectives have been randomised. After this, the player with the Trusted Adviser may select which of these Secondary Objectives is played.\u0022,\u0022refs\u0022:[\u0022leadership_skill\u0022],\u0022armyHasNotOption\u0022:[{\u0022refs\u0022:[\u0022leadership_skill\u0022],\u0022amount\u0022:1}]},{\u0022option_id\u0022:\u0022676herm09gb3j0vmi30v430f34\u0022,\u0022type\u0022:\u0022check\u0022,\u0022name\u0022:\u0022Glory Hunter\u0022,\u0022cost\u0022:25,\u0022description\u0022:\u0022When Choosing Weapons and Equipment, if the model\u2019s unit is Engaged with an enemy unit that contains a Character, it must issue a \u201CDuel\u201D. The opponent may either accept or refuse the Duel. If refused; the model that issued the Duel gains \u002B1 to their side\u2019s Combat Score this Round of Combat. If accepted; the opponent selects a Character in a unit Engaged with the model that issued the Duel. Apply the following rules to the two models: \u201CDuellists\u201D (the model issuing the Duel, and the model chosen to accept the Duel) during this Round of Combat.\u003Cbr/\u003E\u003Cbr/\u003E \u2022 Other models may not allocate StandardMelee Attacks towards the Duellists.\u003Cbr/\u003E \u2022 The Duellists are considered to be in base contact with each other.\u003Cbr/\u003E  \u2022 The Duellists must allocate theirStandardMelee Attacks towards each other (even if their models are not physically in contact).\u003Cbr/\u003E  \u2022 Other Melee Attacks, such as Grind Attacks, Impact Hitsand Stomp Attacks, follow their normal rules for allocation.\u003Cbr/\u003E  \u2022 If either or both Duellists causes the last HP loss to the opposing Duellist, it has won the Duel. The winner(s) counts as having successfully accomplished their Secondary Objective.\u003Cbr/\u003E\u003Cbr/\u003EIf both players have models with Glory Hunter, whose units are Engaged, the Active Player must issue a Duel with their model with Glory Hunter, and the Reactive Player must accept the Duel with their model with Glory Hunter.\u0022,\u0022refs\u0022:[\u0022leadership_skill\u0022],\u0022armyHasNotOption\u0022:[{\u0022refs\u0022:[\u0022leadership_skill\u0022],\u0022amount\u0022:1}]},{\u0022option_id\u0022:\u0022g43gfdg430gk34kg34-g3\u0022,\u0022type\u0022:\u0022check\u0022,\u0022name\u0022:\u0022Curse of Lycanthropy\u0022,\u0022cost\u0022:40,\u0022description\u0022:\u0022One use only. Duration: One Turn. You may activate this ability when Choosing Equipment and Abilities. Set the model part\u2019s: Att to 4, Str to 5, and AP to 3. The model part also gains Regeneration (4\u002B) and Innate Weapons. Whilst active the model part can only use Innate Weapons.\u0022,\u0022hasOption\u0022:[{\u0022refs\u0022:[\u0022wizard\u0022],\u0022amount\u0022:1}],\u0022hasStat\u0022:{\u0022global\u0022:{\u0022Hgt\u0022:{\u0022values\u0022:[\u00221\u0022,\u00222\u0022,\u00223\u0022]}}},\u0022refs\u0022:[\u0022leadership_skill\u0022],\u0022armyHasNotOption\u0022:[{\u0022refs\u0022:[\u0022leadership_skill\u0022],\u0022amount\u0022:1}]}]}},{\u0022id\u0022:2,\u0022name\u0022:\u0022Season 2: Legends of the 9th Age\u0022,\u0022game_setup\u0022:{\u0022map\u0022:{\u0022id\u0022:\u0022map\u0022,\u0022name\u0022:\u0022Map\u0022,\u0022image\u0022:true,\u0022ord\u0022:1,\u0022items\u0022:[{\u0022name\u0022:\u0022Vetia 1\u0022,\u0022id\u0022:71,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 2\u0022,\u0022id\u0022:72,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 3\u0022,\u0022id\u0022:73,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 4\u0022,\u0022id\u0022:74,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 5\u0022,\u0022id\u0022:75,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 6\u0022,\u0022id\u0022:76,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 7\u0022,\u0022id\u0022:77,\u0022ord\u0022:7,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Vetia 8\u0022,\u0022id\u0022:78,\u0022ord\u0022:8,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Vetia\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 1\u0022,\u0022id\u0022:81,\u0022ord\u0022:9,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 2\u0022,\u0022id\u0022:82,\u0022ord\u0022:10,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 3\u0022,\u0022id\u0022:83,\u0022ord\u0022:11,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 4\u0022,\u0022id\u0022:84,\u0022ord\u0022:12,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 5\u0022,\u0022id\u0022:85,\u0022ord\u0022:13,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 6\u0022,\u0022id\u0022:86,\u0022ord\u0022:14,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 7\u0022,\u0022id\u0022:87,\u0022ord\u0022:15,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022},{\u0022name\u0022:\u0022Taphria 8\u0022,\u0022id\u0022:88,\u0022ord\u0022:16,\u0022id_system_category\u0022:\u0022map\u0022,\u0022group\u0022:\u0022Taphria\u0022,\u0022fluff\u0022:\u0022\u0022}]},\u0022deployment\u0022:{\u0022id\u0022:\u0022deployment\u0022,\u0022name\u0022:\u0022Deployment Type\u0022,\u0022ord\u0022:2,\u0022image\u0022:true,\u0022items\u0022:[{\u0022id\u0022:31,\u0022name\u0022:\u0022Frontline Clash\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:32,\u0022name\u0022:\u0022Bottleneck\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:33,\u0022name\u0022:\u0022Spearhead\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:34,\u0022name\u0022:\u0022Encircle\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:35,\u0022name\u0022:\u0022Refused Flank\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:36,\u0022name\u0022:\u0022Assault at First Light\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022deployment\u0022}]},\u0022primary_objective\u0022:{\u0022id\u0022:\u0022primary_objective\u0022,\u0022name\u0022:\u0022Primary Objective\u0022,\u0022ord\u0022:3,\u0022items\u0022:[{\u0022id\u0022:51,\u0022name\u0022:\u0022Trophies of War\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: Whenever an Enemy unit Engaged in Combat, including all Attached Models, is removed as a casualty, put a single Trophy Token on a single Friendly Scoring unit that was just Engaged with the removed unit.\u003Cbr/\u003EA unit immediately loses all its Trophy Tokens if it loses Scoring.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: The player with the most Trophy Tokens on their units wins.\u003Cbr/\u003EIf both players have no Tokens and one player also has no Scoring units remaining on the Battlefield, the other player wins.\u0022},{\u0022id\u0022:52,\u0022name\u0022:\u0022Divide and Conquer\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark the Battlefield Centre and divide the Battlefield into quarters.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: At the end of Game Turns 3 to 6, a player gains a single Objective Counter if they have more quarters touching Friendly Scoring units than the opponent has.\u003Cbr/\u003EEach unit can only touch a single quarter at a time, determined by the location of its Centre.\u003Cbr/\u003EA unit with its Centre within 9\u2033 of the Battlefield Centre does not count as being in contact with any quarter.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: The player with the most Objective Counters wins.\u0022},{\u0022id\u0022:53,\u0022name\u0022:\u0022Breakthrough\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark all Scoring units on the opponent\u0027s Army List.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: None.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: Combine the number of: (1) marked Enemy units that were removed as a casualty whilst Engaged in Combat and (2) Friendly Scoring units in contact with the Enemy\u0027s Deployment Zone. The player with the highest total wins.\u0022},{\u0022id\u0022:54,\u0022name\u0022:\u0022Secure Targets\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Place two markers on opposite sides of the Battlefield, with their centres on the Central Line and 18\u2033 from the Battlefield Centre.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: At the end of Game Turns 3 to 6, a player gains a single Objective Counter if they control more markers than their opponent.\u003Cbr/\u003EA marker is controlled if there are any Friendly Scoring units and no Enemy Scoring units within 6\u2033 of a marker.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: The player with the most Objective Counters wins.\u003Cbr/\u003E\u003Ci\u003EFor Battlefields of a larger or smaller size than the standard 72\u2033\u00D748\u2033, replace 18\u2033 with a distance equal to a quarter of the Long Table Edge.\u003C/i\u003E\u0022},{\u0022id\u0022:55,\u0022name\u0022:\u0022Hold the Centre\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Mark the Battlefield Centre.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: At the end of Game Turns 3 to 6, the player with the most Scoring units within 9\u2033 of the Battlefield Centre gains a single Objective Counter.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: The player with the most Objective Counters wins.\u0022},{\u0022id\u0022:56,\u0022name\u0022:\u0022Skull of Harald Redstub\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022primary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: Place a marker on the Battlefield Centre and two markers on opposite sides of the Battlefield, with their centres on the Central Line and 18\u2033 from the Battlefield Centre.\u003Cbr/\u003EThen place a single Clue Token on each Terrain Feature except Impassable Terrain and player-made Terrain Features.\u003Cbr/\u003E\u003Cb\u003ERules\u003C/b\u003E: At the start of each Friendly Player Turn, pick up a Clue Token from each Terrain Feature where: (1) there is a Clue Token, (2) a Friendly Scoring unit is in contact, and (3) no Enemy Scoring units are in contact.\u003Cbr/\u003EAt the end of Game Turn 3, the player with the most Clue Tokens selects which marker holds the Skull. In case of a tie, the marker at the Battlefield Centre is selected.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: The player with the most Scoring units within 6\u2033 of the Skull wins.\u003Cbr/\u003E\u003Ci\u003EFor Battlefields of a larger or smaller size than the standard 72\u2033\u00D748\u2033, replace 18\u2033 with a distance equal to a quarter of the Long Table Edge.\u003C/i\u003E\u0022}]},\u0022secondary_objective\u0022:{\u0022id\u0022:\u0022secondary_objective\u0022,\u0022name\u0022:\u0022Secondary Objective\u0022,\u0022ord\u0022:4,\u0022items\u0022:[{\u0022id\u0022:61,\u0022name\u0022:\u0022Settle the Score\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003EPre-game Selections\u003C/b\u003E: On the opponent\u0027s Army List mark TWO Rank and File units.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: BOTH marked units are in Fighting Shape.\u0022},{\u0022id\u0022:62,\u0022name\u0022:\u0022Demonstrate Superiority\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003EPre-game Selections\u003C/b\u003E: On the opponent\u0027s Army List mark TWO Scoring units.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: At least one of the marked units is in Fighting Shape.\u0022},{\u0022id\u0022:63,\u0022name\u0022:\u0022Slay the Beast\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: On the opponent\u0027s Army List mark the TWO most expensive Non-Scoring Rank and File units or Characters of Height 4-5 with Solitary.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: At least one of the marked units is in Fighting Shape.\u0022},{\u0022id\u0022:64,\u0022name\u0022:\u0022Assassinate\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: On the opponent\u0027s Army List mark TWO Characters.\u003Cbr/\u003EThese must be: Characters who can be Deployed during Battle Setup. \u003Ci\u003E(Note: you cannot mark Hidden Characters.)\u003C/i\u003E\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: At least one of the marked units is in Fighting Shape.\u0022},{\u0022id\u0022:65,\u0022name\u0022:\u0022Capture their Banners\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: On the opponent\u0027s Army List mark ALL Scoring units and The Battle Standard Bearer.\u003Cbr/\u003EAt least 3 units must be marked.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: Three or more of the marked units are in Fighting Shape.\u0022},{\u0022id\u0022:66,\u0022name\u0022:\u0022Conserve our Numbers\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022secondary_objective\u0022,\u0022description\u0022:\u0022\u003Cb\u003ESetup during Pre-game Selections\u003C/b\u003E: On YOUR Army List the opponent marks ALL Scoring units and The Battle Standard Bearer.\u003Cbr/\u003EAt least 3 units must be marked.\u003Cbr/\u003E\u003Cb\u003EEnd of Game Completion\u003C/b\u003E: Three or more of the marked units are NEITHER removed as a casualty, nor Decimated, nor Shaken.\u0022}],\u0022perplayer\u0022:true}}}],\u0022extraVp\u0022:[{\u0022name\u0022:\u0022Extra Points (Trophies...)\u0022,\u0022mult\u0022:1}]},\u0022repoUrl\u0022:\u0022vflam/nr-t9a\u0022},{\u0022_id\u0022:\u0022627bd1133515ffae2deddc38\u0022,\u0022id\u0022:3197002424,\u0022name\u0022:\u0022Warhammer 40,000: Kill Team (2018)\u0022,\u0022short\u0022:\u0022wh40k-killteam\u0022,\u0022books\u0022:[{\u0022_id\u0022:\u0022663431d81c2fb7c676ca50a5\u0022,\u0022id\u0022:3197002424,\u0022id_game_system\u0022:3197002424,\u0022name\u0022:\u0022Warhammer 40,000: Kill Team (2018)\u0022,\u0022playable\u0022:false,\u0022nrversion\u0022:43,\u0022bsid\u0022:\u0022a467-5f42-d24c-6e5b\u0022,\u0022bsid_game_system\u0022:\u0022a467-5f42-d24c-6e5b\u0022,\u0022path\u0022:\u0022Warhammer 40,000 Kill Team.gst\u0022,\u0022sha\u0022:\u00229b7ee8facc4a3b48d771a69e188acd810f05945b\u0022,\u0022filename\u0022:\u0022Warhammer 40,000 Kill Team.gst\u0022,\u0022short\u0022:\u0022warhammer 40,000 kill team\u0022,\u0022date\u0022:\u00222024-05-03T00:37:44.662Z\u0022,\u0022last_updated\u0022:\u00222024-05-03T00:37:44.662Z\u0022},{\u0022_id\u0022:\u0022663431d31c2fb7c676ca501