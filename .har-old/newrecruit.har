r, selecione quem rolou o Primeiro Turno\u0022,hr:\u0022Molimo odaberite tko je dobio Prvi Potez\u0022,cz:\u0022Please select who rolled the First Turn\u0022,sk:\u0022Please select who rolled the First Turn\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u043A\u0442\u043E \u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0432\u044B\u043C\u0022,ko:\u0022Please select who rolled the First Turn\u0022},oBe={en:\u0022-- First Turn --\u0022,fr:\u0022-- Premier Tour --\u0022,es:\u0022-- Primer Turno --\u0022,cn:\u0022-- \u7B2C\u4E00\u8F6E --\u0022,it:\u0022-- First Turn --\u0022,de:\u0022-- First Zug --\u0022,ja:\u0022-- \u6700\u521D Turn --\u0022,pl:\u0022-- Pierwsza tura --\u0022,pt:\u0022-- Primeiro Turno --\u0022,hr:\u0022-- Prvi Potez --\u0022,cz:\u0022-- First Turn --\u0022,sk:\u0022-- First Turn --\u0022,gr:\u0022-- \u03A0\u03C1\u03CE\u03C4\u03BF \u03A3\u03B5\u03B9\u03C1\u03AC --\u0022,ru:\u0022-- \u041F\u0435\u0440\u0432\u044B\u0439 \u0445\u043E\u0434 --\u0022,ko:\u0022-- First Turn --\u0022},aBe={en:\u0022{player} rolled First Turn\u0022,fr:\u0022{player} a lanc\u00E9 le Premier Tour\u0022,es:\u0022{player} lanz\u00F3 el Primer Turno\u0022,cn:\u0022{player} \u6295\u63B7\u4E86\u7B2C\u4E00\u8F6E\u0022,it:\u0022{player} rolled First Turn\u0022,de:\u0022{player} rolled First Zug\u0022,ja:\u0022{\u30D7\u30EC\u30A4\u30E4\u30FC} rolled \u6700\u521D Turn\u0022,pl:\u0022{player} wyrzuci\u0142 pierwsz\u0105 tur\u0119\u0022,pt:\u0022{player} rolou o Primeiro Turno\u0022,hr:\u0022{player} je dobio Prvi Potez\u0022,cz:\u0022{player} rolled First Turn\u0022,sk:\u0022{player} rolled First Turn\u0022,gr:\u0022\u03A1\u03AF\u03BE\u03B1\u03C4\u03B5 \u03B3\u03B9\u03B1 \u03C4\u03BF\u03BD \u03C0\u03C1\u03CE\u03C4\u03BF \u03B3\u03CD\u03C1\u03BF\u0022,ru:\u0022\u0411\u0440\u043E\u0441\u043E\u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u043F\u0435\u0440\u0432\u044B\u0439 \u0445\u043E\u0434\u0022,ko:\u0022{player} rolled First Turn\u0022},lBe={en:\u0022Start Game\u0022,fr:\u0022Commencer la Partie\u0022,es:\u0022Iniciar Juego\u0022,cn:\u0022\u5F00\u59CB\u6E38\u620F\u0022,it:\u0022Inizia Partita\u0022,de:\u0022Spiel Starten\u0022,ja:\u0022\u958B\u59CB\u30B2\u30FC\u30E0\u0022,pl:\u0022Rozpocznij gr\u0119\u0022,pt:\u0022Iniciar Jogo\u0022,hr:\u0022Zapo\u010Dni Igru\u0022,cz:\u0022Start Game\u0022,sk:\u0022Start Game\u0022,gr:\u0022\u0388\u03BD\u03B1\u03C1\u03BE\u03B7 \u03A0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u0022,ru:\u0022\u041D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443\u0022,ko:\u0022Start Game\u0022},uBe={en:\u0022Pre-Game Sequence\u0022,fr:\u0022S\u00E9quence de Pr\u00E9-Jeu\u0022,es:\u0022Secuencia Pre-Juego\u0022,cn:\u0022\u6E38\u620F\u524D\u5E8F\u5217\u0022,it:\u0022Pre-Game Sequence\u0022,de:\u0022Pre-Spiel Sequence\u0022,ja:\u0022Pre-\u30B2\u30FC\u30E0 Sequence\u0022,pl:\u0022Sekwencja przed gr\u0105\u0022,pt:\u0022Sequ\u00EAncia Pr\u00E9-Jogo\u0022,hr:\u0022Slijed Prije Igre\u0022,cz:\u0022Pre-Game Sequence\u0022,sk:\u0022Pre-Game Sequence\u0022,gr:\u0022\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u0391\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AF\u03B1 \u03A0\u03C1\u03BF\u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u041F\u0440\u0435\u0434\u0438\u0433\u0440\u043E\u0432\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u0022,ko:\u0022Pre-Game Sequence\u0022},cBe={en:\u0022Special Deployment\u0022,fr:\u0022D\u00E9ploiement Sp\u00E9cial\u0022,es:\u0022Despliegue Especial\u0022,cn:\u0022\u7279\u6B8A\u90E8\u7F72\u0022,it:\u0022Special Deployment\u0022,de:\u0022Special Aufstellenment\u0022,ja:\u0022\u30B9\u30DA\u30B7\u30E3\u30EB\u914D\u7F6E\u0022,pl:\u0022Specjalne rozmieszczenie\u0022,pt:\u0022Implanta\u00E7\u00E3o Especial\u0022,hr:\u0022Poseban Raspored\u0022,cz:\u0022Special Deployment\u0022,sk:\u0022Special Deployment\u0022,gr:\u0022\u0395\u03B9\u03B4\u03B9\u03BA\u03AE \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u0022,ru:\u0022\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Special Deployment\u0022},ABe={en:\u0022Starting with the player that chose their Deployment Zone, each player must nominate which units with Special Deployment options (such as Scout or Ambush) will use their Special Deployment, or if they will deploy using the normal rules.\u0022,fr:\u0022En commen\u00E7ant par le joueur qui a choisi sa Zone de D\u00E9ploiement, chaque joueur doit d\u00E9signer quelles unit\u00E9s ayant des options de D\u00E9ploiement Sp\u00E9cial (comme \u00C9claireur ou Embuscade) utiliseront leur D\u00E9ploiement Sp\u00E9cial, ou si elles se d\u00E9ploieront selon les r\u00E8gles normales.\u0022,es:\u0022Comenzando con el jugador que eligi\u00F3 su Zona de Despliegue, cada jugador debe nominar qu\u00E9 unidades con opciones de Despliegue Especial (como Explorador o Emboscada) usar\u00E1n su Despliegue Especial, o si se desplegar\u00E1n usando las reglas normales.\u0022,cn:\u0022\u4ECE\u9009\u62E9\u4E86\u90E8\u7F72\u533A\u57DF\u7684\u73A9\u5BB6\u5F00\u59CB\uFF0C\u6BCF\u4E2A\u73A9\u5BB6\u5FC5\u987B\u6307\u5B9A\u54EA\u4E9B\u5177\u6709\u7279\u6B8A\u90E8\u7F72\u9009\u9879\uFF08\u5982\u4FA6\u5BDF\u5175\u6216\u4F0F\u51FB\uFF09\u7684\u5355\u4F4D\u5C06\u4F7F\u7528\u5176\u7279\u6B8A\u90E8\u7F72\uFF0C\u6216\u8005\u662F\u5426\u5C06\u4F7F\u7528\u6B63\u5E38\u89C4\u5219\u8FDB\u884C\u90E8\u7F72\u3002\u0022,it:\u0022Starting with the player that chose their Schieramento Zone, each player must nominate which units with Special Schieramento options (such as Scout or Ambush) will use their Special Schieramento, or if they will deploy using the normal rules.\u0022,de:\u0022Starting with the player that chose their Aufstellenment Zone, each player must nominate which units with Special Aufstellenment options (such as Scout or Ambush) will use their Special Aufstellenment, or if they will deploy using the normal rules.\u0022,ja:\u0022\u958B\u59CBing \u3068  \u30D7\u30EC\u30A4\u30E4\u30FC that chose their \u914D\u7F6E \u30BE\u30FC\u30F3, \u5404 \u30D7\u30EC\u30A4\u30E4\u30FC must \u3044\u3044\u3048minate which \u30E6\u30CB\u30C3\u30C8 \u3068 \u30B9\u30DA\u30B7\u30E3\u30EB \u914D\u7F6E \u30AA\u30D7\u30B7\u30E7\u30F3 (\u305D\u306E\u3088\u3046\u306A \u3068\u3057\u3066 Scout \u307E\u305F\u306F Ambush) \u3057\u307E\u3059 \u4F7F\u7528 their \u30B9\u30DA\u30B7\u30E3\u30EB \u914D\u7F6E, \u307E\u305F\u306F \u3082\u3057 they \u3057\u307E\u3059 deploy using  \u3044\u3044\u3048rmal \u30EB\u30FC\u30EB.\u0022,pl:\u0022Zaczynaj\u0105c od gracza, kt\u00F3ry wybra\u0142 swoj\u0105 stref\u0119 rozmieszczenia, ka\u017Cdy gracz musi wskaza\u0107, kt\u00F3re jednostki z opcjami specjalnego rozmieszczenia (takimi jak Zwiadowca lub Zasadzka) u\u017Cyj\u0105 swojego specjalnego rozmieszczenia, lub czy b\u0119d\u0105 rozmieszcza\u0107 zgodnie z normalnymi zasadami.\u0022,pt:\u0022Come\u00E7ando com o jogador que escolheu sua Zona de Implanta\u00E7\u00E3o, cada jogador deve nomear quais unidades com op\u00E7\u00F5es de Implanta\u00E7\u00E3o Especial (como Batedores ou Emboscada) usar\u00E3o sua Implanta\u00E7\u00E3o Especial, ou se implantar\u00E3o usando as regras normais.\u0022,hr:\u0022Po\u010Dev\u0161i s igra\u010Dem koji je odabrao svoju Zonu Rasporeda, svaki igra\u010D mora nominirati koje jedinice s opcijama Posebnog Rasporeda (kao \u0161to su Scout ili Ambush) \u0107e koristiti svoj Poseban Raspored, ili \u0107e se postaviti koriste\u0107i normalna pravila.\u0022,cz:\u0022Starting with the player that chose their Deployment Zone, each player must nominate which units with Special Deployment options (such as Scout or Ambush) will use their Special Deployment, or if they will deploy using the normal rules.\u0022,sk:\u0022Starting with the player that chose their Deployment Zone, each player must nominate which units with Special Deployment options (such as Scout or Ambush) will use their Special Deployment, or if they will deploy using the normal rules.\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u03C3\u03B5\u03BD\u03AC\u03C1\u03B9\u03BF \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF \u03B5\u03B9\u03B4\u03B9\u03BA\u03BF\u03CD\u03C2 \u03BA\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2 \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u03C2\u0022,ru:\u0022\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430\u0022,ko:\u0022Starting with the player that chose their Deployment Zone, each player must nominate which units with Special Deployment options (such as Scout or Ambush) will use their Special Deployment, or if they will deploy using the normal rules.\u0022},dBe={en:\u0022Start Deployment\u0022,fr:\u0022Commencer le D\u00E9ploiement\u0022,es:\u0022Iniciar Despliegue\u0022,cn:\u0022\u5F00\u59CB\u90E8\u7F72\u0022,it:\u0022Start Deployment\u0022,de:\u0022Start Aufstellenment\u0022,ja:\u0022\u958B\u59CB\u914D\u7F6E\u0022,pl:\u0022Rozpocznij rozmieszczenie\u0022,pt:\u0022Iniciar Implanta\u00E7\u00E3o\u0022,hr:\u0022Zapo\u010Dni Raspored\u0022,cz:\u0022Start Deployment\u0022,sk:\u0022Start Deployment\u0022,gr:\u0022\u0388\u03BD\u03B1\u03C1\u03BE\u03B7 \u0391\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u0022,ru:\u0022\u041D\u0430\u0447\u0430\u0442\u044C \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044B\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Start Deployment\u0022},fBe={en:\u0022This tournament may not exist or has been deleted. \uD83D\uDE2F\u0022,fr:\u0022Ce tournoi n\u0027existe peut-\u00EAtre pas ou a \u00E9t\u00E9 supprim\u00E9. \uD83D\uDE2F\u0022,es:\u0022Este torneo puede no existir o ha sido eliminado. \uD83D\uDE2F\u0022,cn:\u0022\u6B64\u9526\u