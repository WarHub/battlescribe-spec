ns\u0022,sk:\u0022Mo\u017Enosti\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AD\u03C2\u0022,ru:\u0022\u041E\u043F\u0446\u0438\u0438\u0022,ko:\u0022\uC635\uC158\u0022},tde={en:\u0022New Recruit {version}\u0022,fr:\u0022New Recruit {version}\u0022,es:\u0022New Recruit {version}\u0022,cn:\u0022New Recruit {version}\u0022,it:\u0022New Recruit {version}\u0022,de:\u0022New Recruit {version}\u0022,ja:\u0022New Recruit {version}\u0022,pl:\u0022New Recruit {version}\u0022,pt:\u0022New Recruit {version}\u0022,hr:\u0022New Recruit {version}\u0022,cz:\u0022New Recruit {version}\u0022,sk:\u0022New Recruit {version}\u0022,gr:\u0022\u0388\u03BA\u03B4\u03BF\u03C3\u03B7 New Recruit\u0022,ru:\u0022\u0412\u0435\u0440\u0441\u0438\u044F New Recruit\u0022,ko:\u0022\uC0C8 Recruit {version}\u0022},rde={en:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E You are using New Recruit without an Account.\u003Cbr /\u003E\u0027,fr:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E Vous utilisez New Recruit sans Compte.\u003Cbr /\u003E\u0027,es:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E Est\u00E1s usando New Recruit sin una Cuenta.\u003Cbr /\u003E\u0027,cn:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E \u60A8\u5728\u6CA1\u6709\u8D26\u6237\u7684\u60C5\u51B5\u4E0B\u4F7F\u7528 New Recruit\u3002\u003Cbr /\u003E\u0027,it:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E You are using Nuovo Recruit without an Account.\u003Cbr /\u003E\u0027,de:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E Sie verwenden New Recruit ohne Konto.\u003Cbr /\u003E\u0027,ja:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E \u30A2\u30AB\u30A6\u30F3\u30C8\u306A\u3057\u3067New Recruit\u3092\u4F7F\u7528\u3057\u3066\u3044\u307E\u3059\u3002\u003Cbr /\u003E\u0027,pl:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E Ty are using Nowe Recruit without an Account.\u003Cbr /\u003E\u0027,pt:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E Voc\u00EA est\u00E1 usando o New Recruit sem uma Conta.\u003Cbr /\u003E\u0027,hr:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E Koristite New Recruit bez ra\u010Duna.\u003Cbr /\u003E\u0027,cz:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E You are using New Recruit without an Account.\u003Cbr /\u003E\u0027,sk:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E You are using New Recruit without an Account.\u003Cbr /\u003E\u0027,gr:\u0022\u03A7\u03C1\u03AE\u03C3\u03B7 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u0022,ru:\u0022\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438\u0022,ko:\u0027\u003Cimg src=\u0022/assets/icons/i.png\u0022 /\u003E You are using New Recruit without an Account.\u003Cbr /\u003E\u0027},nde={en:\u0022to enable more features like List Syncing.\u0022,fr:\u0022pour activer plus de fonctionnalit\u00E9s comme la Synchronisation des Listes.\u0022,es:\u0022para habilitar m\u00E1s funciones como Sincronizaci\u00F3n de Listas.\u0022,cn:\u0022\u6765\u542F\u7528\u66F4\u591A\u529F\u80FD\uFF0C\u5982\u5217\u8868\u540C\u6B65\u3002\u0022,it:\u0022to enable more features like List Syncing.\u0022,de:\u0022um weitere Funktionen wie Listen-Synchronisierung zu aktivieren.\u0022,ja:\u0022\u30EA\u30B9\u30C8\u540C\u671F\u306A\u3069\u306E\u6A5F\u80FD\u3092\u6709\u52B9\u306B\u3059\u308B\u306B\u306F\u0022,pl:\u0022do w\u0142\u0105cz bardziej features polub Lista Synchronizowanie.\u0022,pt:\u0022para ativar mais recursos como Sincroniza\u00E7\u00E3o de Listas.\u0022,hr:\u0022da omogu\u0107ite vi\u0161e zna\u010Dajki poput sinkronizacije popisa.\u0022,cz:\u0022to enable more features like List Syncing.\u0022,sk:\u0022to enable more features like List Syncing.\u0022,gr:\u0022\u0395\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B9\u03CE\u03BD \u03C3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u0443\u0447\u0435\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C \u0434\u043B\u044F \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0434\u0430\u043D\u043D\u044B\u0445 \u043C\u0435\u0436\u0434\u0443 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438\u0022,ko:\u0022to enable more features like List Syncing.\u0022},ide={en:\u0022Please create an account to sync your lists!\u0022,fr:\u0022Veuillez cr\u00E9er un compte pour synchroniser vos listes !\u0022,es:\u0022\u00A1Por favor crea una cuenta para sincronizar tus listas!\u0022,cn:\u0022\u8BF7\u521B\u5EFA\u4E00\u4E2A\u8D26\u6237\u6765\u540C\u6B65\u60A8\u7684\u5217\u8868\uFF01\u0022,it:\u0022Crea un account per sincronizzare le tue liste!\u0022,de:\u0022Bitte erstellen Sie ein Konto, um Ihre Listen zu synchronisieren!\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3092\u540C\u671F\u3059\u308B\u306B\u306F\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u3057\u3066\u304F\u3060\u3055\u3044\uFF01\u0022,pl:\u0022Prosz\u0119 utw\u00F3rz an konto do synchronizuj your listy!\u0022,pt:\u0022Por favor, crie uma conta para sincronizar suas listas!\u0022,hr:\u0022Molimo kreirajte ra\u010Dun za sinkronizaciju va\u0161ih popisa!\u0022,cz:\u0022Please create an account to sync your lists!\u0022,sk:\u0022Please create an account to sync your lists!\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03C4\u03B5 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC \u03B3\u03B9\u03B1 \u03C3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u0443\u0447\u0435\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C \u0434\u043B\u044F \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043F\u0438\u0441\u043A\u043E\u0432 \u043C\u0435\u0436\u0434\u0443 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438\u0022,ko:\u0022Please create an account to sync your lists!\u0022},sde={en:\u0022Lists synced successfully!\u0022,fr:\u0022Listes synchronis\u00E9es avec succ\u00E8s !\u0022,es:\u0022\u00A1Listas sincronizadas exitosamente!\u0022,cn:\u0022\u5217\u8868\u540C\u6B65\u6210\u529F\uFF01\u0022,it:\u0022Liste sincronizzate con successo!\u0022,de:\u0022Listen erfolgreich synchronisiert!\u0022,ja:\u0022\u30EA\u30B9\u30C8\u304C\u6B63\u5E38\u306B\u540C\u671F\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,pl:\u0022Lists synced successfully!\u0022,pt:\u0022Listas sincronizadas com sucesso!\u0022,hr:\u0022Popisi uspje\u0161no sinkronizirani!\u0022,cz:\u0022Lists synced successfully!\u0022,sk:\u0022Lists synced successfully!\u0022,gr:\u0022\u039F\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03AF\u03C3\u03C4\u03B7\u03BA\u03B1\u03BD \u03B5\u03C0\u03B9\u03C4\u03C5\u03C7\u03CE\u03C2\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043A\u0438 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u044B\u0022,ko:\u0022Lists synced successfully!\u0022},ode={en:\u0022An error occured\u0022,fr:\u0022Une erreur s\u0027est produite\u0022,es:\u0022Ocurri\u00F3 un error\u0022,cn:\u0022\u53D1\u751F\u9519\u8BEF\u0022,it:\u0022Si \u00E8 verificato un errore\u0022,de:\u0022Ein Fehler ist aufgetreten\u0022,ja:\u0022\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\u0022,pl:\u0022An error occured\u0022,pt:\u0022Ocorreu um erro\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke\u0022,cz:\u0022An error occured\u0022,sk:\u0022An error occured\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03AD\u03BA\u03C5\u03C8\u03B5 \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1\u0022,ru:\u0022\u041F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430 \u043E\u0448\u0438\u0431\u043A\u0430\u0022,ko:\u0022An error occured\u0022},ade={en:\u0022Clipboard does not contain a valid list!\u0022,fr:\u0022Le presse-papiers ne contient pas de liste valide !\u0022,es:\u0022\u00A1El portapapeles no contiene una lista v\u00E1lida!\u0022,cn:\u0022\u526A\u8D34\u677F\u4E0D\u5305\u542B\u6709\u6548\u5217\u8868\uFF01\u0022,it:\u0022Gli appunti non contengono una lista valida!\u0022,de:\u0022Zwischenablage enth\u00E4lt keine g\u00FCltige Liste!\u0022,ja:\u0022\u30AF\u30EA\u30C3\u30D7\u30DC\u30FC\u30C9\u306B\u6709\u52B9\u306A\u30EA\u30B9\u30C8\u304C\u542B\u307E\u308C\u3066\u3044\u307E\u305B\u3093\uFF01\u0022,pl:\u0022Clipboard does nie contain a wa\u017Cne lista!\u0022,pt:\u0022A \u00E1rea de transfer\u00EAncia n\u00E3o cont\u00E9m uma lista v\u00E1lida!\u0022,hr:\u0022Me\u0111uspremnik ne sadr\u017Ei va\u017Ee\u0107i popis!\u0022,cz:\u0022Clipboard does not contain a valid list!\u0022,sk:\u0022Clipboard does not contain a valid list!\u0022,gr:\u0022\u039C\u03B7 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C3\u03C4\u03BF \u03C0\u03C1\u03CC\u03C7\u03B5\u03B9\u03C1\u03BF\u0022,ru:\u0022\u0411\u0443\u0444\u0435\u0440 \u043E\u0431\u043C\u0435\u043D\u0430 \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022Clipboard does not contain a valid list!\u0022},lde={en:\u0022List imported successfully!\u0022,fr:\u0022Liste import\u00E9e avec succ\u00E8s !\u0022,es:\u0022\u00A1Lista importada exitosamente!\u0022,cn:\u0022\u5217\u8868\u5BFC\u5165\u6210\u529F\uFF01\u0022,it:\u0022Lista importata con successo!\u0022,de:\u0022Liste erfolgreich importiert!\u0022,ja:\u0022\u30EA\u30B9\u30C8\u304C\u6B63\u5E38\u306B\u30A4\u30F3\u30DD\u30FC\u30C8\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022Lista imported successfully!\u0022,pt:\u0022Lista importada com sucesso!\u0022,hr:\u0022Popis uspje\u0161no uvezen!\u0022,cz:\u0022List imported successfully!\u0022,sk:\u0022List imported successfully!\u0022,gr:\u0022\u0397 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B5\u03B9\u03C3\u03AE\u03C7\u03B8\u03B7 \u03B5\u03C0\u03B9\u03C4\u03C5\u03C7\u03CE\u03C2\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0022,ko:\u0022List imported successfully!\u0022},ude={en:\u0022{count} rosters imported succesfully\u0022,fr:\u0022{count} listes import\u00E9es avec succ\u00E8s\u0022,es:\u0022{count} listas importadas exitosamente\u0022,cn:\u0022{count} \u540D\u5355\u5BFC\u5165\u6210\u529F\u0022,it:\u0022{count} roster importati con successo\u0022,de:\u0022{count} Listen erfolgreich importiert\u0022,ja:\u0022{count}\u500B\u306E\u540D\u7C3F\u304C\u6B63\u5E38\u306B\u30A4\u30F3\u30DD\u30FC\u30C8\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022{count} rosters imported succesfully\u0022,pt:\u0022{count} listas importadas com sucesso\u0022,hr:\u0022{count} rostera uspje\u0161no uvezeno\u0022,cz:\u0022{count} rosters imported succesfully\u0022,sk:\u0022{count} rosters imported succesfully\u0022,gr:\u0022\u039F\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B5\u03B9\u03C3\u03AE\u03C7\u03B8\u03B7\u03C3\u03B1\u03BD \u03B5\u03C0\u03B9\u03C4\u03C5\u03C7\u03CE\u03C2\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043A\u0438 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B\u0022,ko:\u0022{count} rosters imported succesfully\u0022},cde={en:\u0022Support New Recruit\u0022,fr:\u0022Soutenir New Recruit\u0022,es:\u0022Apoyar New Recruit\u0022,cn:\u0022\u652F\u6301 New Recruit\u0022,it:\u0022Supporta New Recruit\u0022,de:\u0022New Recruit Unterst\u00FCtzen\u0022,ja:\u0022New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u0022,pl:\u0022Support New Recruit\u0022,pt:\u0022Apoie o New Recruit\u0022,hr:\u0022Podr\u017Eite New Recruit\u0022,cz:\u0022Support New Recruit\u0022,sk:\u0022Support New Recruit\u0022,gr:\u0022\u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03C4\u03B5 \u03C4\u03BF New Recruit\u0022,ru:\u0022\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C New Recruit\u0022,ko:\u0022Support New Recruit\u0022},Ade={en:\u0022Thank you for supporting the development of New Recruit !\u0022,fr:\u0022Merci de soutenir le d\u00E9veloppement de New Recruit !\u0022,es:\u0022\u00A1Gracias por apoyar el desarrollo de New Recruit!\u0022,cn:\u0022\u611F\u8C22\u652F\u6301 New Recruit \u7684\u5F00\u53D1\uFF01\u0022,it:\u0022Thank you for supporting the development of Nuovo Recruit !\u0022,de:\u0022Vielen Dank f\u00FCr die Unterst\u00FCtzung der Entwicklung von New Recruit!\u0022,ja:\u0022New Recruit\u306E\u958B\u767A\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u3044\u305F\u3060\u304D\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\u0022,pl:\u0022Thank ty for supporting the development of Nowe Recruit !\u0022,pt:\u0022Obrigado por apoiar o desenvolvimento do New Recruit!\u0022,hr:\u0022Hvala vam \u0161to podr\u017Eavate razvoj New Recruit!\u0022,cz:\u0022Thank you for supporting the development of New Recruit !\u0022,sk:\u0022Thank you for supporting the development of New Recruit !\u0022,gr:\u0022\u0395\u03C5\u03C7\u03B1\u03C1\u03B9\u03C3\u03C4\u03BF\u03CD\u03BC\u03B5 \u03C0\u03BF\u03C5 \u03C5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03B6\u03B5\u03C4\u03B5\u0022,ru:\u0022\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443 New Recruit\u0022,ko:\u0022Thank you for supporting the development of New Recruit !\u0022},dde={en:\u0022You can make an additional donation to here if you want to support the project further.\u0022,fr:\u0022Vous pouvez faire un don suppl\u00E9mentaire ici si vous voulez soutenir davantage le projet.\u0022,es:\u0022Puedes hacer una donaci\u00F3n adicional aqu\u00ED si quieres apoyar m\u00E1s el proyecto.\u0022,cn:\u0022\u5982\u679C\u60A8\u60F3\u8FDB\u4E00\u6B65\u652F\u6301\u8BE5\u9879\u76EE\uFF0C\u53EF\u4EE5\u5728\u8FD9\u91CC\u989D\u5916\u6350\u8D60\u3002\u0022,it:\u0022Puoi fare una donazione aggiuntiva qui se vuoi supportare ulteriormente il progetto.\u0022,de:\u0022Sie k\u00F6nnen hier eine zus\u00E4tzliche Spende machen, wenn Sie das Projekt weiter unterst\u00FCtzen m\u00F6chten.\u0022,ja:\u0022\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u3092\u3055\u3089\u306B\u30B5\u30DD\u30FC\u30C8\u3057\u305F\u3044\u5834\u5408\u306F\u3001\u3053\u3053\u3067\u8FFD\u52A0\u306E\u5BC4\u4ED8\u3092\u884C\u3046\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Ty can make an additional donation do tutaj if ty chcie\u0107 do wsparcie the projekt further.\u0022,pt:\u0022Voc\u00EA pode fazer uma doa\u00E7\u00E3o adicional aqui se quiser apoiar mais o projeto.\u0022,hr:\u0022Mo\u017Eete izvr\u0161iti dodatnu donaciju ovdje ako \u017Eelite dodatno podr\u017Eati projekt.\u0022,cz:\u0022You can make an additional donation to here if you want to support the project further.\u0022,sk:\u0022You can make an additional donation to here if you want to support the project further.\u0022,gr:\u0022\u03A0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B7 \u03B4\u03C9\u03C1\u03B5\u03AC\u0022,ru:\u0022\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022You can make an additional donation to here if you want to support the project further.\u0022},fde={en:\u0022The Tournament Organization tool is free, you can make a donation here to support the project.\u0022,fr:\u0022L\u0027outil d\u0027Organisation de Tournoi est gratuit, vous pouvez faire un don ici pour soutenir le projet.\u0022,es:\u0022La herramienta de Organizaci\u00F3n de Torneos es gratuita, puedes hacer una donaci\u00F3n aqu\u00ED para apoyar el proyecto.\u0022,cn:\u0022\u9526\u6807\u8D5B\u7EC4\u7EC7\u5DE5\u5177\u662F\u514D\u8D39\u7684\uFF0C\u60A8\u53EF\u4EE5\u5728\u8FD9\u91CC\u6350\u8D60\u6765\u652F\u6301\u9879\u76EE\u3002\u0022,it:\u0022Lo strumento di organizzazione tornei \u00E8 gratuito, puoi fare una donazione qui per supportare il progetto.\u0022,de:\u0022Das Turnierorganisations-Tool ist kostenlos, Sie k\u00F6nnen hier eine Spende machen, um das Projekt zu unterst\u00FCtzen.\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u904B\u55B6\u30C4\u30FC\u30EB\u306F\u7121\u6599\u3067\u3059\u3002\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u3092\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u305F\u3081\u306B\u3053\u3053\u3067\u5BC4\u4ED8\u3092\u884C\u3046\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022The Turniej Organizacja tool is wolne, ty can make a donation tutaj do wsparcie the projekt.\u0022,pt:\u0022A ferramenta de Organiza\u00E7\u00E3o de Torneios \u00E9 gratuita, voc\u00EA pode fazer uma doa\u00E7\u00E3o aqui para apoiar o projeto.\u0022,hr:\u0022Alat za organizaciju turnira je besplatan, mo\u017Eete napraviti donaciju ovdje kako biste podr\u017Eali projekt.\u0022,cz:\u0022The Tournament Organization tool is free, you can make a donation here to support the project.\u0022,sk:\u0022The Tournament Organization tool is free, you can make a donation here to support the project.\u0022,gr:\u0022\u03A4\u03BF \u03B5\u03C1\u03B3\u03B1\u03BB\u03B5\u03AF\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03C9\u03C1\u03B5\u03AC\u03BD\u0022,ru:\u0022\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0434\u043B\u044F \u0442\u0443\u0440\u043D\u0438\u0440\u043E\u0432 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F\u0022,ko:\u0022The Tournament Organization tool is free, you can make a donation here to support the project.\u0022},pde={en:\u0022The suggested amount is\u0022,fr:\u0022Le montant sugg\u00E9r\u00E9 est de\u0022,es:\u0022La cantidad sugerida es\u0022,cn:\u0022\u5EFA\u8BAE\u91D1\u989D\u4E3A\u0022,it:\u0022L\u0027importo suggerito \u00E8\u0022,de:\u0022Der vorgeschlagene Betrag ist\u0022,ja:\u0022\u63A8\u5968\u91D1\u984D\u306F\u0022,pl:\u0022The suggested kwota is\u0022,pt:\u0022O valor sugerido \u00E9\u0022,hr:\u0022Predlo\u017Eeni iznos je\u0022,cz:\u0022The suggested amount is\u0022,sk:\u0022The suggested amount is\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C4\u03B5\u03B9\u03BD\u03CC\u03BC\u03B5\u03BD\u03BF \u03C0\u03BF\u03C3\u03CC\u0022,ru:\u0022\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u0430\u044F \u0441\u0443\u043C\u043C\u0430\u0022,ko:\u0022The suggested amount is\u0022},hde={en:\u0022per player\u0022,fr:\u0022par joueur\u0022,es:\u0022por jugador\u0022,cn:\u0022\u6BCF\u4F4D\u73A9\u5BB6\u0022,it:\u0022per giocatore\u0022,de:\u0022pro Spieler\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u3054\u3068\u0022,pl:\u0022per gracz\u0022,pt:\u0022por jogador\u0022,hr:\u0022po igra\u010Du\u0022,cz:\u0022per player\u0022,sk:\u0022per player\u0022,gr:\u0022\u0391\u03BD\u03AC \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u0022,ru:\u0022per \u0418\u0433\u0440\u043E\u043A\u0022,ko:\u0022per player\u0022},mde={en:\u0022but you can select any amount you deem reasonable\u0022,fr:\u0022mais vous pouvez choisir n\u0027importe quel montant que vous jugez raisonnable\u0022,es:\u0022pero puedes seleccionar cualquier cantidad que consideres razonable\u0022,cn:\u0022\u4F46\u60A8\u53EF\u4EE5\u9009\u62E9\u4EFB\u4F55\u60A8\u8BA4\u4E3A\u5408\u7406\u7684\u91D1\u989D\u0022,it:\u0022ma puoi selezionare qualsiasi importo che ritieni ragionevole\u0022,de:\u0022aber Sie k\u00F6nnen jeden Betrag w\u00E4hlen, den Sie f\u00FCr angemessen halten\u0022,ja:\u0022\u305F\u3060\u3057\u3001\u59A5\u5F53\u3068\u601D\u308F\u308C\u308B\u4EFB\u610F\u306E\u91D1\u984D\u3092\u9078\u629E\u3067\u304D\u307E\u3059\u0022,pl:\u0022but ty can wybierz dowolny kwota ty deem rozs\u0105dne\u0022,pt:\u0022mas voc\u00EA pode selecionar qualquer valor que considere razo\u00E1vel\u0022,hr:\u0022ali mo\u017Eete odabrati bilo koji iznos koji smatrate razumnim\u0022,cz:\u0022but you can select any amount you deem reasonable\u0022,sk:\u0022but you can select any amount you deem reasonable\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03C0\u03BF\u03C3\u03CC\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043B\u044E\u0431\u0443\u044E \u0441\u0443\u043C\u043C\u0443\u0022,ko:\u0022but you can select any amount you deem reasonable\u0022},gde={en:\u0022anything helps!!!\u0022,fr:\u0022tout aide !!!\u0022,es:\u0022\u00A1\u00A1\u00A1cualquier ayuda es bienvenida!!!\u0022,cn:\u0022\u4EFB\u4F55\u5E2E\u52A9\u90FD\u5F88\u597D\uFF01\uFF01\uFF01\u0022,it:\u0022qualsiasi aiuto \u00E8 benvenuto!!!\u0022,de:\u0022alles hilft!!!\u0022,ja:\u0022anything helps!!!\u0022,pl:\u0022anything helps!!!\u0022,pt:\u0022qualquer coisa ajuda!!!\u0022,hr:\u0022sve poma\u017Ee!!!\u0022,cz:\u0022anything helps!!!\u0022,sk:\u0022anything helps!!!\u0022,gr:\u0022\u039F\u03C4\u03B9\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03B2\u03BF\u03B7\u03B8\u03AC\u0022,ru:\u0022\u041B\u044E\u0431\u0430\u044F \u043F\u043E\u043C\u043E\u0449\u044C \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F!!!\u0022,ko:\u0022anything helps!!!\u0022},yde={en:\u0022Donation\u0022,fr:\u0022Don\u0022,es:\u0022Donaci\u00F3n\u0022,cn:\u0022\u6350\u8D60\u0022,it:\u0022Donazione\u0022,de:\u0022Spende\u0022,ja:\u0022\u5BC4\u4ED8\u0022,pl:\u0022Donation\u0022,pt:\u0022Doa\u00E7\u00E3o\u0022,hr:\u0022Donacija\u0022,cz:\u0022Donation\u0022,sk:\u0022Donation\u0022,gr:\u0022\u0394\u03C9\u03C1\u03B5\u03AC\u0022,ru:\u0022\u041F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Donation\u0022},wde={en:\u0022Select Amount:\u0022,fr:\u0022S\u00E9lectionner le Montant :\u0022,es:\u0022Seleccionar Cantidad:\u0022,cn:\u0022\u9009\u62E9\u91D1\u989D\uFF1A\u0022,it:\u0022Seleziona Importo:\u0022,de:\u0022Betrag Ausw\u00E4hlen:\u0022,ja:\u0022\u91D1\u984D\u3092\u9078\u629E:\u0022,pl:\u0022Select Amount:\u0022,pt:\u0022Selecionar Valor:\u0022,hr:\u0022Odaberite koli\u010Dinu:\u0022,cz:\u0022Select Amount:\u0022,sk:\u0022Select Amount:\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C0\u03BF\u03C3\u03BF\u03CD\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E:\u0022,ko:\u0022Amount: \uC120\uD0DD\u0022},bde={en:\u0022Donate {amount} \u20AC\u0022,fr:\u0022Faire un Don de {amount} \u20AC\u0022,es:\u0022Donar {amount} \u20AC\u0022,cn:\u0022\u6350\u8D60 {amount} \u20AC\u0022,it:\u0022Donate {amount} \u20AC\u0022,de:\u0022{amount} \u20AC Spenden\u0022,ja:\u0022\u20AC{amount}\u3092\u5BC4\u4ED8\u0022,pl:\u0022Donate {amount} \u20AC\u0022,pt:\u0022Doar {amount} \u20AC\u0022,hr:\u0022Donate {amount} \u20AC\u0022,cz:\u0022Donate {amount} \u20AC\u0022,sk:\u0022Donate {amount} \u20AC\u0022,gr:\u0022\u0394\u03C9\u03C1\u03B5\u03AC \u03C0\u03BF\u03C3\u03BF\u03CD\u0022,ru:\u0022\u0421\u0443\u043C\u043C\u0430 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F\u0022,ko:\u0022Donate {amount} \u20AC\u0022},vde={en:\u0022New Recruit has been reset! App should now work (hopefully).\u0022,fr:\u0022New Recruit a \u00E9t\u00E9 r\u00E9initialis\u00E9 ! L\u0027application devrait maintenant fonctionner (esp\u00E9rons-le).\u0022,es:\u0022\u00A1New Recruit ha sido reiniciado! La aplicaci\u00F3n deber\u00EDa funcionar ahora (esperemos).\u0022,cn:\u0022New Recruit \u5DF2\u91CD\u7F6E\uFF01\u5E94\u7528\u73B0\u5728\u5E94\u8BE5\u53EF\u4EE5\u5DE5\u4F5C\u4E86\uFF08\u5E0C\u671B\u5982\u6B64\uFF09\u3002\u0022,it:\u0022Nuovo Recruit has been reset! App should now work (hopefully).\u0022,de:\u0022New Recruit wurde zur\u00FCckgesetzt! Die App sollte jetzt funktionieren (hoffentlich).\u0022,ja:\u0022New Recruit\u304C\u30EA\u30BB\u30C3\u30C8\u3055\u308C\u307E\u3057\u305F\uFF01\u30A2\u30D7\u30EA\u304C\u6B63\u5E38\u306B\u52D5\u4F5C\u3059\u308B\u306F\u305A\u3067\u3059\uFF08\u9858\u308F\u304F\u3070\uFF09\u3002\u0022,pl:\u0022Nowe Recruit has been resetuj! App should now praca (hopefully).\u0022,pt:\u0022New Recruit foi resetado! O app deve funcionar agora (esperan\u00E7osamente).\u0022,hr:\u0022New Recruit je resetiran! Aplikacija bi sada trebala raditi (nadamo se).\u0022,cz:\u0022New Recruit has been reset! App should now work (hopefully).\u0022,sk:\u0022New Recruit has been reset! App should now work (hopefully).\u0022,gr:\u0022\u0397 \u03B5\u03C6\u03B1\u03C1\u03BC\u03BF\u03B3\u03AE \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03AD\u03C1\u03B8\u03B7\u03BA\u03B5 \u03B5\u03C0\u03B9\u03C4\u03C5\u03C7\u03CE\u03C2\u0022,ru:\u0022\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u043E\u0022,ko:\u0022\uC0C8 Recruit has been reset! App should now work (hopefully).\u0022},kde={en:\u0022Admin\u0022,fr:\u0022Admin\u0022,es:\u0022Admin\u0022,cn:\u0022\u7BA1\u7406\u5458\u0022,it:\u0022Admin\u0022,de:\u0022Administrator\u0022,ja:\u0022Admin\u0022,pl:\u0022Admin\u0022,pt:\u0022Admin\u0022,hr:\u0022Admin\u0022,cz:\u0022Admin\u0022,sk:\u0022Admin\u0022,gr:\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03B9\u03C1\u03B9\u03C3\u03C4\u03AE\u03C2\u0022,ru:\u0022\u0410\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0022,ko:\u0022Admin\u0022},Bde={en:\u0022Tutorials\u0022,fr:\u0022Tutoriels\u0022,es:\u0022Tutoriales\u0022,cn:\u0022\u6559\u7A0B\u0022,it:\u0022Tutorial\u0022,de:\u0022Anleitungen\u0022,ja:\u0022Tutorials\u0022,pl:\u0022Tutorials\u0022,pt:\u0022Tutoriais\u0022,hr:\u0022Tutorials\u0022,cz:\u0022Tutorials\u0022,sk:\u0022Tutorials\u0022,gr:\u0022\u039F\u03B4\u03B7\u03B3\u03BF\u03AF\u0022,ru:\u0022\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435\u0022,ko:\u0022Tutorials\u0022},Cde={en:\u0022Wiki\u0022,fr:\u0022Wiki\u0022,es:\u0022Wiki\u0022,cn:\u0022\u767E\u79D1\u0022,it:\u0022Wiki\u0022,de:\u0022Wiki\u0022,ja:\u0022Wiki\u0022,pl:\u0022Wiki\u0022,pt:\u0022Wiki\u0022,hr:\u0022Wiki\u0022,cz:\u0022Wiki\u0022,sk:\u0022Wiki\u0022,gr:\u0022Wiki\u0022,ru:\u0022\u0412\u0438\u043A\u0438\u0022,ko:\u0022Wiki\u0022},_de={en:\u0022Download\u0022,fr:\u0022T\u00E9l\u00E9charger\u0022,es:\u0022Descargar\u0022,cn:\u0022\u4E0B\u8F7D\u0022,it:\u0022Scarica\u0022,de:\u0022Herunterladen\u0022,ja:\u0022\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u0022,pl:\u0022Pobierz\u0022,pt:\u0022Baixar\u0022,hr:\u0022Preuzmi\u0022,cz:\u0022Download\u0022,sk:\u0022Stiahnu\u0165\u0022,gr:\u0022\u039B\u03AE\u03C8\u03B7\u0022,ru:\u0022\u0421\u043A\u0430\u0447\u0430\u0442\u044C\u0022,ko:\u0022\uB2E4\uC6B4\uB85C\uB4DC\u0022},Sde={en:\u0022Username\u0022,fr:\u0022Nom d\u0027utilisateur\u0022,es:\u0022Nombre de usuario\u0022,cn:\u0022\u7528\u6237\u540D\u0022,it:\u0022Nome utente\u0022,de:\u0022Benutzername\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u0022,pl:\u0022Nazwa u\u017Cytkownika\u0022,pt:\u0022Nome de Usu\u00E1rio\u0022,hr:\u0022Korisni\u010Dko ime\u0022,cz:\u0022Username\u0022,sk:\u0022Pou\u017E\u00EDvate\u013Esk\u00E9 meno\u0022,gr:\u0022\u038C\u03BD\u03BF\u03BC\u03B1 \u03A7\u03C1\u03AE\u03C3\u03C4\u03B7\u0022,ru:\u0022\u0418\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F\u0022,ko:\u0022\uC0AC\uC6A9\uC790 \uC774\uB984\u0022},Ede={en:\u0022Username / Email\u0022,fr:\u0022Nom d\u0027utilisateur / Email\u0022,es:\u0022Nombre de usuario / Email\u0022,cn:\u0022\u7528\u6237\u540D / \u90AE\u7BB1\u0022,it:\u0022Username / Email\u0022,de:\u0022Benutzername / E-Mail\u0022,ja:\u0022\u30E6\u30FC\u30B6\u30FC\u540D/\u30E1\u30FC\u30EB\u0022,pl:\u0022Username / Email\u0022,pt:\u0022Nome de Usu\u00E1rio / E-mail\u0022,hr:\u0022Korisni\u010Dko ime / Email\u0022,cz:\u0022Username / Email\u0022,sk:\u0022Username / Email\u0022,gr:\u0022\u038C\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7/Email\u0022,ru:\u0022\u0418\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F/Email\u0022,ko:\u0022Username / Email\u0022},jde={en:\u0022Password\u0022,fr:\u0022Mot de passe\u0022,es:\u0022Contrase\u00F1a\u0022,cn:\u0022\u5BC6\u7801\u0022,it:\u0022Password\u0022,de:\u0022Passwort\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u0022,pl:\u0022Has\u0142o\u0022,pt:\u0022Senha\u0022,hr:\u0022Lozinka\u0022,cz:\u0022Password\u0022,sk:\u0022Heslo\u0022,gr:\u0022\u039A\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2\u0022,ru:\u0022\u041F\u0430\u0440\u043E\u043B\u044C\u0022,ko:\u0022\uBE44\uBC00\uBC88\uD638\u0022},zde={en:\u0022Email*\u0022,fr:\u0022Email*\u0022,es:\u0022Correo*\u0022,cn:\u0022\u90AE\u7BB1*\u0022,it:\u0022Email*\u0022,de:\u0022Email*\u0022,ja:\u0022\u30E1\u30FC\u30EB*\u0022,pl:\u0022Email*\u0022,pt:\u0022E-mail*\u0022,hr:\u0022Email*\u0022,cz:\u0022Email*\u0022,sk:\u0022Email*\u0022,gr:\u0022Email\u0022,ru:\u0022Email\u0022,ko:\u0022Email*\u0022},Ide={en:\u0022Lost Password\u0022,fr:\u0022Mot de passe oubli\u00E9\u0022,es:\u0022Contrase\u00F1a perdida\u0022,cn:\u0022\u5FD8\u8BB0\u5BC6\u7801\u0022,it:\u0022Password Dimenticata\u0022,de:\u0022Passwort Vergessen\u0022,ja:\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5FD8\u308C\u305F\u0022,pl:\u0022Lost Password\u0022,pt:\u0022Esqueceu a Senha\u0022,hr:\u0022Izgubljena lozinka\u0022,cz:\u0022Lost Password\u0022,sk:\u0022Lost Password\u0022,gr:\u0022\u03A7\u03AC\u03C3\u03B1\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2;\u0022,ru:\u0022\u0417\u0430\u0431\u044B\u043B\u0438 \u043F\u0430\u0440\u043E\u043B\u044C?\u0022,ko:\u0022Lost Password\u0022},Pde={en:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022,fr:\u0022Une erreur s\u0027est produite lors de la cr\u00E9ation de votre compte, peut-\u00EAtre que ce nom d\u0027utilisateur ou cet email existe d\u00E9j\u00E0.\u0022,es:\u0022Ocurri\u00F3 un error al crear tu cuenta, tal vez este nombre de usuario o correo ya existe.\u0022,cn:\u0022\u521B\u5EFA\u8D26\u6237\u65F6\u53D1\u751F\u9519\u8BEF\uFF0C\u53EF\u80FD\u6B64\u7528\u6237\u540D\u6216\u90AE\u7BB1\u5DF2\u5B58\u5728\u3002\u0022,it:\u0022Si \u00E8 verificato un errore durante la creazione del tuo account, forse questo nome utente o email esiste gi\u00E0.\u0022,de:\u0022Beim Erstellen Ihres Kontos ist ein Fehler aufgetreten, m\u00F6glicherweise existiert dieser Benutzername oder diese E-Mail bereits.\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u4F5C\u6210\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\u3002\u3053\u306E\u30E6\u30FC\u30B6\u30FC\u540D\u307E\u305F\u306F\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u306F\u65E2\u306B\u5B58\u5728\u3057\u3066\u3044\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d podczas tworzenia konta, mo\u017Cliwe \u017Ce ta nazwa u\u017Cytkownika lub email ju\u017C istnieje.\u0022,pt:\u0022Ocorreu um erro ao criar sua conta, talvez este nome de usu\u00E1rio ou e-mail j\u00E1 exista.\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke prilikom kreiranja va\u0161eg ra\u010Duna, mo\u017Eda ovo korisni\u010Dko ime ili email ve\u0107 postoji.\u0022,cz:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022,sk:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438\u0022,ko:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022},Tde={en:\u0027Incorrect username. Make sure you respect CASING in your username. \u0022MyName\u0022 is not the same as \u0022myname\u0022\u0027,fr:\u0060Nom d\u0027utilisateur incorrect. Assurez-vous de respecter les MAJUSCULES/minuscules. \u0022MonNom\u0022 n\u0027est pas pareil que \u0022monnom\u0022\u0060,es:\u0027Nombre de usuario incorrecto. Aseg\u00FArate de respetar las MAY\u00DASCULAS/min\u00FAsculas. \u0022MiNombre\u0022 no es lo mismo que \u0022minombre\u0022\u0027,cn:\u0027\u7528\u6237\u540D\u9519\u8BEF\u3002\u8BF7\u6CE8\u610F\u5927\u5C0F\u5199\u654F\u611F\u3002\u0022MyName\u0022 \u4E0E \u0022myname\u0022 \u4E0D\u540C\u0027,it:\u0027Nome utente errato. Assicurati di rispettare le MAIUSCOLE/minuscole nel tuo nome utente. \u0022MioNome\u0022 non \u00E8 uguale a \u0022mionome\u0022\u0027,de:\u0027Falscher Benutzername. Achten Sie auf die GROSS-/Kleinschreibung. \u0022MeinName\u0022 ist nicht dasselbe wie \u0022meinname\u0022\u0027,ja:\u0027\u30E6\u30FC\u30B6\u30FC\u540D\u304C\u6B63\u3057\u304F\u3042\u308A\u307E\u305B\u3093\u3002\u30E6\u30FC\u30B6\u30FC\u540D\u3067\u306F\u5927\u6587\u5B57\u3068\u5C0F\u6587\u5B57\u304C\u533A\u5225\u3055\u308C\u307E\u3059\u3002\u0022MyName\u0022\u3068\u0022myname\u0022\u306F\u7570\u306A\u308A\u307E\u3059\u3002\u0027,pl:\u0027Niepoprawna nazwa u\u017Cytkownika. Upewnij si\u0119, \u017Ce u\u017Cajesz w\u0142a\u015Bciwej wielko\u015Bci liter. \u0022MojaNazwa\u0022 to nie to samo co \u0022mojanazwa\u0022\u0027,pt:\u0027Nome de usu\u00E1rio incorreto. Certifique-se de respeitar MAI\u00DASCULAS/min\u00FAsculas no seu nome de usu\u00E1rio. \u0022MeuNome\u0022 n\u00E3o \u00E9 o mesmo que \u0022meunome\u0022\u0027,hr:\u0027Neto\u010Dno korisni\u010Dko ime. Pazite na VELIKA I MALA slova u va\u0161em korisni\u010Dkom imenu. \u0022MyName\u0022 nije isto \u0161to i \u0022myname\u0022\u0027,cz:\u0027Incorrect username. Make sure you respect CASING in your username. \u0022MyName\u0022 is not the same as \u0022myname\u0022\u0027,sk:\u0027Incorrect username. Make sure you respect CASING in your username. \u0022MyName\u0022 is not the same as \u0022myname\u0022\u0027,gr:\u0022\u039B\u03AC\u03B8\u03BF\u03C2 \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7\u0022,ru:\u0022\u041D\u0435\u0432\u0435\u0440\u043D\u043E\u0435 \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438\u043B\u0438 email\u0022,ko:\u0027Incorrect username. Make sure you respect CASING in your username. \u0022MyName\u0022 is not the same as \u0022myname\u0022\u0027},Nde={en:\u0027Incorrect password. Make sure you respect CASING in your password. \u0022PassWoRd\u0022 is not the same as \u0022password\u0022\u0027,fr:\u0060Mot de passe incorrect. Assurez-vous de respecter les MAJUSCULES/minuscules. \u0022MotDePasse\u0022 n\u0027est pas pareil que \u0022motdepasse\u0022\u0060,es:\u0027Contrase\u00F1a incorrecta. Aseg\u00FArate de respetar las MAY\u00DASCULAS/min\u00FAsculas. \u0022ConTraSe\u00F1a\u0022 no es lo mismo que \u0022contrase\u00F1a\u0022\u0027,cn:\u0027\u5BC6\u7801\u9519\u8BEF\u3002\u8BF7\u6CE8\u610F\u5927\u5C0F\u5199\u654F\u611F\u3002\u0022PassWoRd\u0022 \u4E0E \u0022password\u0022 \u4E0D\u540C\u0027,it:\u0027Password errata. Assicurati di rispettare le MAIUSCOLE/minuscole nella tua password. \u0022PassWoRd\u0022 non \u00E8 uguale a \u0022password\u0022\u0027,de:\u0027Falsches Passwort. Achten Sie auf die GROSS-/Kleinschreibung. \u0022PassWoRt\u0022 ist nicht dasselbe wie \u0022passwort\u0022\u0027,ja:\u0027\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u6B63\u3057\u304F\u3042\u308A\u307E\u305B\u3093\u3002\u30D1\u30B9\u30EF\u30FC\u30C9\u3067\u306F\u5927\u6587\u5B57\u3068\u5C0F\u6587\u5B57\u304C\u533A\u5225\u3055\u308C\u307E\u3059\u3002\u0022PassWoRd\u0022\u3068\u0022password\u0022\u306F\u7570\u306A\u308A\u307E\u3059\u3002\u0027,pl:\u0027Niepoprawne has\u0142o. Upewnij si\u0119, \u017Ce u\u017Cywasz w\u0142a\u015Bciwej wielko\u015Bci liter. \u0022PassWoRd\u0022 to nie to samo co \u0022password\u0022\u0027,pt:\u0027Senha incorreta. Certifique-se de respeitar MAI\u00DASCULAS/min\u00FAsculas na sua senha. \u0022PassWoRd\u0022 n\u00E3o \u00E9 o mesmo que \u0022password\u0022\u0027,hr:\u0027Neto\u010Dna lozinka. Pazite na VELIKA I MALA slova u va\u0161oj lozinki. \u0022PassWoRd\u0022 nije isto \u0161to i \u0022password\u0022\u0027,cz:\u0027Incorrect password. Make sure you respect CASING in your password. \u0022PassWoRd\u0022 is not the same as \u0022password\u0022\u0027,sk:\u0027Incorrect password. Make sure you respect CASING in your password. \u0022PassWoRd\u0022 is not the same as \u0022password\u0022\u0027,gr:\u0022\u039B\u03AC\u03B8\u03BF\u03C2 \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C\u0022,ko:\u0027Incorrect password. Make sure you respect CASING in your password. \u0022PassWoRd\u0022 is not the same as \u0022password\u0022\u0027},Fde={en:\u0022Unable to connect to New Recruit!\u0022,fr:\u0022Impossible de se connecter \u00E0 New Recruit !\u0022,es:\u0022\u00A1No se puede conectar a New Recruit!\u0022,cn:\u0022\u65E0\u6CD5\u8FDE\u63A5\u5230 New Recruit\uFF01\u0022,it:\u0022Impossibile connettersi a New Recruit!\u0022,de:\u0022Verbindung zu New Recruit nicht m\u00F6glich!\u0022,ja:\u0022New Recruit\u306B\u63A5\u7D9A\u3067\u304D\u307E\u305B\u3093\uFF01\u0022,pl:\u0022Nie mo\u017Cna po\u0142\u0105czy\u0107 si\u0119 z New Recruit!\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel conectar ao New Recruit!\u0022,hr:\u0022Nemogu\u0107e se povezati s New Recruit!\u0022,cz:\u0022Unable to connect to New Recruit!\u0022,sk:\u0022Unable to connect to New Recruit!\u0022,gr:\u0022\u0391\u03B4\u03C5\u03BD\u03B1\u03BC\u03AF\u03B1 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F \u043A \u0441\u0435\u0440\u0432\u0435\u0440\u0443\u0022,ko:\u0022Unable to connect to New Recruit!\u0022},Rde={en:\u0022Please enter your email address.\u0022,fr:\u0022Veuillez saisir votre adresse email.\u0022,es:\u0022Por favor ingresa tu direcci\u00F3n de correo.\u0022,cn:\u0022\u8BF7\u8F93\u5165\u60A8\u7684\u90AE\u7BB1\u5730\u5740\u3002\u0022,it:\u0022Si prega di inserire il proprio indirizzo email.\u0022,de:\u0022Bitte geben Sie Ihre E-Mail-Adresse ein.\u0022,ja:\u0022\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Prosz\u0119 poda\u0107 sw\u00F3j adres email.\u0022,pt:\u0022Por favor, insira seu endere\u00E7o de e-mail.\u0022,hr:\u0022Molimo unesite svoju email adresu.\u0022,cz:\u0022Please enter your email address.\u0022,sk:\u0022Please enter your email address.\u0022,gr:\u0022\u0395\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03C4\u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7 email\u0022,ru:\u0022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0432\u0430\u0448 \u0430\u0434\u0440\u0435\u0441 email\u0022,ko:\u0022Please enter your email address.\u0022},Mde={en:\u0022A new password has been sent to your email address!\u0022,fr:\u0022Un nouveau mot de passe a \u00E9t\u00E9 envoy\u00E9 \u00E0 votre adresse email !\u0022,es:\u0022\u00A1Se ha enviado una nueva contrase\u00F1a a tu direcci\u00F3n de correo!\u0022,cn:\u0022\u65B0\u5BC6\u7801\u5DF2\u53D1\u9001\u5230\u60A8\u7684\u90AE\u7BB1\u5730\u5740\uFF01\u0022,it:\u0022Una nuova password \u00E8 stata inviata al tuo indirizzo email!\u0022,de:\u0022Ein neues Passwort wurde an Ihre E-Mail-Adresse gesendet!\u0022,ja:\u0022\u65B0\u3057\u3044\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u306B\u9001\u4FE1\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,pl:\u0022Nowe has\u0142o zosta\u0142o wys\u0142ane na Tw\u00F3j adres email!\u0022,pt:\u0022Uma nova senha foi enviada para seu endere\u00E7o de e-mail!\u0022,hr:\u0022Nova lozinka je poslana na va\u0161u email adresu!\u0022,cz:\u0022A new password has been sent to your email address!\u0022,sk:\u0022A new password has been sent to your email address!\u0022,gr:\u0022\u0397 \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03B5\u03C3\u03C4\u03AC\u03BB\u03B7\u0022,ru:\u0022\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u043F\u043E \u0441\u0431\u0440\u043E\u0441\u0443 \u043F\u0430\u0440\u043E\u043B\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430 \u0432\u0430\u0448 email\u0022,ko:\u0022A new password has been sent to your email address!\u0022},Ude={en:\u0022Unable to connect, password could not be reset!\u0022,fr:\u0022Impossible de se connecter, le mot de passe n\u0027a pas pu \u00EAtre r\u00E9initialis\u00E9 !\u0022,es:\u0022No se puede connectar, \u00A1no se pudo restablecer la contrase\u00F1a!\u0022,cn:\u0022\u65E0\u6CD5\u8FDE\u63A5\uFF0C\u5BC6\u7801\u91CD\u7F6E\u5931\u8D25\uFF01\u0022,it:\u0022Impossibile connettersi, la password non pu\u00F2 essere reimpostata!\u0022,de:\u0022Verbindung nicht m\u00F6glich, Passwort konnte nicht zur\u00FCckgesetzt werden!\u0022,ja:\u0022\u63A5\u7D9A\u3067\u304D\u305A\u3001\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u30EA\u30BB\u30C3\u30C8\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\uFF01\u0022,pl:\u0022Nie mo\u017Cna po\u0142\u0105czy\u0107 si\u0119, has\u0142o nie mog\u0142o zosta\u0107 zresetowane!\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel conectar, a senha n\u00E3o p\u00F4de ser redefinida!\u0022,hr:\u0022Nemogu\u0107e se povezati, lozinka nije mogla biti resetirana!\u0022,cz:\u0022Unable to connect, password could not be reset!\u0022,sk:\u0022Unable to connect, password could not be reset!\u0022,gr:\u0022\u0397 \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03B1\u03C0\u03AD\u03C4\u03C5\u03C7\u03B5\u0022,ru:\u0022\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043F\u0438\u0441\u044C\u043C\u043E \u0434\u043B\u044F \u0441\u0431\u0440\u043E\u0441\u0430 \u043F\u0430\u0440\u043E\u043B\u044F\u0022,ko:\u0022Unable to connect, password could not be reset!\u0022},xde={en:\u0022Faction\u0022,fr:\u0022Faction\u0022,es:\u0022Facci\u00F3n\u0022,cn:\u0022\u6D3E\u7CFB\u0022,it:\u0022Fazione\u0022,de:\u0022Fraktion\u0022,ja:\u0022\u30D5\u30A1\u30AF\u30B7\u30E7\u30F3\u0022,pl:\u0022Frakcja\u0022,pt:\u0022Fac\u00E7\u00E3o\u0022,hr:\u0022Frakcija\u0022,cz:\u0022Faction\u0022,sk:\u0022Frakcia\u0022,gr:\u0022\u03A6\u03B1\u03C4\u03C1\u03AF\u03B1\u0022,ru:\u0022\u0424\u0440\u0430\u043A\u0446\u0438\u044F\u0022,ko:\u0022Faction\u0022},Qde={en:\u0022List Name\u0022,fr:\u0022Nom de Liste\u0022,es:\u0022Nombre de Lista\u0022,cn:\u0022\u5217\u8868\u540D\u79F0\u0022,it:\u0022Nome Lista\u0022,de:\u0022Listenname\u0022,ja:\u0022\u30EA\u30B9\u30C8\u540D\u0022,pl:\u0022Nazwa Listy\u0022,pt:\u0022Nome da Lista\u0022,hr:\u0022Naziv popisa\u0022,cz:\u0022List Name\u0022,sk:\u0022N\u00E1zov zoznamu\u0022,gr:\u0022\u039B\u03AF\u03C3\u03C4\u03B1 \u038C\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022List Name\u0022},Lde={en:\u0022Latest Version\u0022,fr:\u0022Derni\u00E8re Version\u0022,es:\u0022\u00DAltima Versi\u00F3n\u0022,cn:\u0022\u6700\u65B0\u7248\u672C\u0022,it:\u0022Ultima Versione\u0022,de:\u0022Neueste Version\u0022,ja:\u0022\u6700\u65B0\u30D0\u30FC\u30B8\u30E7\u30F3\u0022,pl:\u0022Najnowsza Wersja\u0022,pt:\u0022Vers\u00E3o Mais Recente\u0022,hr:\u0022Najnovija verzija\u0022,cz:\u0022Latest Version\u0022,sk:\u0022Latest Version\u0022,gr:\u0022\u03A4\u03B5\u03BB\u03B5\u03C5\u03C4\u03B1\u03AF\u03B1 \u0388\u03BA\u03B4\u03BF\u03C3\u03B7\u0022,ru:\u0022\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0412\u0435\u0440\u0441\u0438\u044F\u0022,ko:\u0022Latest Version\u0022},Dde={en:\u0022Force\u0022,fr:\u0022Force\u0022,es:\u0022Fuerza\u0022,cn:\u0022\u90E8\u961F\u0022,it:\u0022Forza\u0022,de:\u0022Streitmacht\u0022,ja:\u0022\u30D5\u30A9\u30FC\u30B9\u0022,pl:\u0022Si\u0142a\u0022,pt:\u0022For\u00E7a\u0022,hr:\u0022Snaga\u0022,cz:\u0022Force\u0022,sk:\u0022Force\u0022,gr:\u0022\u0394\u03CD\u03BD\u03B1\u03BC\u03B7\u0022,ru:\u0022\u0410\u0440\u043C\u0438\u044F\u0022,ko:\u0022Force\u0022},Ode={en:\u0022Loading...\u0022,fr:\u0022Chargement...\u0022,es:\u0022Cargando...\u0022,cn:\u0022\u52A0\u8F7D\u4E2D...\u0022,it:\u0022Caricamento...\u0022,de:\u0022Laden...\u0022,ja:\u0022\u8AAD\u307F\u8FBC\u307F\u4E2D...\u0022,pl:\u0022\u0141adowanie...\u0022,pt:\u0022Carregando...\u0022,hr:\u0022U\u010Ditavanje...\u0022,cz:\u0022Loading...\u0022,sk:\u0022Na\u010D\u00EDtava sa...\u0022,gr:\u0022\u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7...\u0022,ru:\u0022\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430...\u0022,ko:\u0022Loading...\u0022},Hde={en:\u0022This Army Book could not be loaded. Please try going to Home and click Update All. If that does not work you may\u0022,fr:\u0022Ce Livre d\u0027Arm\u00E9e n\u0027a pas pu \u00EAtre charg\u00E9. Veuillez essayer d\u0027aller \u00E0 Accueil et cliquer sur Tout Mettre \u00E0 Jour. Si cela ne fonctionne pas, vous pouvez\u0022,es:\u0022No se pudo cargar este Libro de Ej\u00E9rcito. Por favor intente ir a Inicio y haga clic en Actualizar Todo. Si eso no funciona, puede\u0022,cn:\u0022\u65E0\u6CD5\u52A0\u8F7D\u6B64\u519B\u961F\u4E66\u3002\u8BF7\u5C1D\u8BD5\u8F6C\u5230\u4E3B\u9875\u5E76\u70B9\u51FB\u5168\u90E8\u66F4\u65B0\u3002\u5982\u679C\u4ECD\u7136\u65E0\u6548\uFF0C\u60A8\u53EF\u4EE5\u0022,it:\u0022Questo Libro d\u0027Armata non pu\u00F2 essere caricato. Si prega di provare ad andare alla Home e cliccare su Aggiorna Tutto. Se non funziona, \u00E8 possibile\u0022,de:\u0022Dieses Armeebuch konnte nicht geladen werden. Bitte versuchen Sie, zur Startseite zu gehen und auf Alle Aktualisieren zu klicken. Wenn das nicht funktioniert, k\u00F6nnen Sie\u0022,ja:\u0022\u3053\u306E\u30A2\u30FC\u30DF\u30FC\u30D6\u30C3\u30AF\u306F\u8AAD\u307F\u8FBC\u3081\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u30DB\u30FC\u30E0\u306B\u79FB\u52D5\u3057\u3066\u5168\u3066\u66F4\u65B0\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u305D\u308C\u3067\u3082\u3046\u307E\u304F\u3044\u304B\u306A\u3044\u5834\u5408\u306F\u0022,pl:\u0022Ta Ksi\u0105\u017Cka Armii nie mog\u0142a zosta\u0107 za\u0142adowana. Prosz\u0119 spr\u00F3bowa\u0107 przej\u015B\u0107 do Strony G\u0142\u00F3wnej i klikn\u0105\u0107 Zaktualizuj Wszystko. Je\u015Bli to nie zadzia\u0142a, mo\u017Cesz\u0022,pt:\u0022Este Livro de Ex\u00E9rcito n\u00E3o p\u00F4de ser carregado. Por favor, tente ir para In\u00EDcio e clique em Atualizar Tudo. Se isso n\u00E3o funcionar, voc\u00EA pode\u0022,hr:\u0022Ova knjiga armija nije mogla biti u\u010Ditana. Molimo poku\u0161ajte oti\u0107i na Po\u010Detnu stranicu i kliknite A\u017Euriraj Sve. Ako to ne uspije, mo\u017Eete\u0022,cz:\u0022Tuto Knihu Arm\u00E1dy se nepoda\u0159ilo na\u010D\u00EDst. Zkuste pros\u00EDm p\u0159ej\u00EDt na Domovskou str\u00E1nku a kliknout na Aktualizovat V\u0161e. Pokud to nepom\u016F\u017Ee, m\u016F\u017Eete\u0022,sk:\u0022T\u00E1to Kniha Arm\u00E1dy sa nepodarilo na\u010D\u00EDta\u0165. Sk\u00FAste pros\u00EDm prejs\u0165 na Domovsk\u00FA str\u00E1nku a klikn\u00FA\u0165 na Aktualizova\u0165 V\u0161etko. Ak to nepom\u00F4\u017Ee, m\u00F4\u017Eete\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u0392\u03B9\u03B2\u03BB\u03AF\u03BF \u03A3\u03C4\u03C1\u03B1\u03C4\u03BF\u03CD \u03B4\u03B5\u03BD \u03BC\u03C0\u03CC\u03C1\u03B5\u03C3\u03B5 \u03BD\u03B1 \u03C6\u03BF\u03C1\u03C4\u03C9\u03B8\u03B5\u03AF. \u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03AC\u03C4\u03B5 \u03C3\u03C4\u03B7\u03BD \u0391\u03C1\u03C7\u03B9\u03BA\u03AE \u03BA\u03B1\u03B9 \u03BA\u03AC\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B9\u03BA \u03C3\u03C4\u03BF \u0395\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u038C\u03BB\u03C9\u03BD. \u0395\u03AC\u03BD \u03B1\u03C5\u03C4\u03CC \u03B4\u03B5\u03BD \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B5\u03B9, \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5\u0022,ru:\u0022\u042D\u0442\u0443 \u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0443\u044E \u041A\u043D\u0438\u0433\u0443 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u0413\u043B\u0430\u0432\u043D\u0443\u044E \u0438 \u043D\u0430\u0436\u0430\u0442\u044C \u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0412\u0441\u0435. \u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435\u0022,ko:\u0022\uC774 \uAD70\uB300 \uCC45\uC744 \uB85C\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD648\uC73C\uB85C \uC774\uB3D9\uD558\uC5EC \uBAA8\uB450 \uC5C5\uB370\uC774\uD2B8\uB97C \uD074\uB9AD\uD574 \uBCF4\uC2ED\uC2DC\uC624. \uADF8\uB798\uB3C4 \uC791\uB3D9\uD558\uC9C0 \uC54A\uC73C\uBA74\u0022},Gde={en:\u0022Contact New Recruit\u0022,fr:\u0022Contacter New Recruit\u0022,es:\u0022Contactar New Recruit\u0022,cn:\u0022\u8054\u7CFB New Recruit\u0022,it:\u0022Contatta New Recruit\u0022,de:\u0022New Recruit kontaktieren\u0022,ja:\u0022New Recruit\u306B\u9023\u7D61\u0022,pl:\u0022Skontaktuj si\u0119 z New Recruit\u0022,pt:\u0022Entrar em Contato com New Recruit\u0022,hr:\u0022Kontaktirajte New Recruit\u0022,cz:\u0022Contact New Recruit\u0022,sk:\u0022Contact New Recruit\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03BC\u03B5 \u03C4\u03BF New Recruit\u0022,ru:\u0022\u0421\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C \u0441 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u043E\u0439 New Recruit, \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u043D\u0435 \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442\u0022,ko:\u0022Contact New Recruit\u0022},Vde={en:\u0022This book is unavailable in offline.\u003Cbr/\u003E\u003Cbr/\u003EBooks are installed when you use them online. You can install all books at once in the Home page, while online.\u0022,fr:\u0022Ce livre n\u0027est pas disponible hors ligne.\u003Cbr/\u003E\u003Cbr/\u003ELes livres sont install\u00E9s lorsque vous les utilisez en ligne. Vous pouvez installer tous les livres \u00E0 la fois dans la page d\u0027Accueil, en ligne.\u0022,es:\u0022Este libro no est\u00E1 disponible sin conexi\u00F3n.\u003Cbr/\u003E\u003Cbr/\u003ELos libros se instalan cuando los usas en l\u00EDnea. Puedes instalar todos los libros a la vez en la p\u00E1gina de Inicio, mientras est\u00E9s en l\u00EDnea.\u0022,cn:\u0022\u6B64\u4E66\u79BB\u7EBF\u4E0D\u53EF\u7528\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u5F53\u60A8\u5728\u7EBF\u4F7F\u7528\u4E66\u7C4D\u65F6\u4F1A\u5B89\u88C5\u4E66\u7C4D\u3002\u60A8\u53EF\u4EE5\u5728\u4E3B\u9875\u4E2D\u4E00\u6B21\u6027\u5B89\u88C5\u6240\u6709\u4E66\u7C4D\uFF0C\u9700\u8981\u5728\u7EBF\u72B6\u6001\u3002\u0022,it:\u0022Questo libro non \u00E8 disponibile offline.\u003Cbr/\u003E\u003Cbr/\u003EI libri vengono installati quando li usi online. Puoi installare tutti i libri contemporaneamente nella pagina Home, mentre sei online.\u0022,de:\u0022Dieses Buch ist offline nicht verf\u00FCgbar.\u003Cbr/\u003E\u003Cbr/\u003EB\u00FCcher werden installiert, wenn Sie sie online verwenden. Sie k\u00F6nnen alle B\u00FCcher auf einmal auf der Startseite installieren, w\u00E4hrend Sie online sind.\u0022,ja:\u0022\u3053\u306E\u30D6\u30C3\u30AF\u306F\u30AA\u30D5\u30E9\u30A4\u30F3\u3067\u306F\u5229\u7528\u3067\u304D\u307E\u305B\u3093\u3002\u003Cbr/\u003E\u003Cbr/\u003E\u30D6\u30C3\u30AF\u306F\u30AA\u30F3\u30E9\u30A4\u30F3\u3067\u4F7F\u7528\u3059\u308B\u3068\u81EA\u52D5\u7684\u306B\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u3055\u308C\u307E\u3059\u3002\u30DB\u30FC\u30E0\u30DA\u30FC\u30B8\u304B\u3089\u30AA\u30F3\u30E9\u30A4\u30F3\u6642\u306B\u3059\u3079\u3066\u306E\u30D6\u30C3\u30AF\u3092\u4E00\u5EA6\u306B\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Ta ksi\u0105\u017Cka jest niedost\u0119pna w trybie offline.\u003Cbr/\u003E\u003Cbr/\u003EKsi\u0105\u017Cki s\u0105 instalowane, gdy u\u017Cywasz ich online. Mo\u017Cesz zainstalowa\u0107 wszystkie ksi\u0105\u017Cki naraz na stronie g\u0142\u00F3wnej, b\u0119d\u0105c online.\u0022,pt:\u0022Este livro est\u00E1 indispon\u00EDvel offline.\u003Cbr/\u003E\u003Cbr/\u003EOs livros s\u00E3o instalados quando voc\u00EA os usa online. Voc\u00EA pode instalar todos os livros de uma vez na p\u00E1gina inicial, enquanto estiver online.\u0022,hr:\u0022Ova knjiga nije dostupna izvan mre\u017Ee.\u003Cbr/\u003E\u003Cbr/\u003EKnjige se instaliraju kada ih koristite online. Mo\u017Eete instalirati sve knjige odjednom na po\u010Detnoj stranici, dok ste online.\u0022,cz:\u0022This book is unavailable in offline.\u003Cbr/\u003E\u003Cbr/\u003EBooks are installed when you use them online. You can install all books at once in the Home page, while online.\u0022,sk:\u0022This book is unavailable in offline.\u003Cbr/\u003E\u003Cbr/\u003EBooks are installed when you use them online. You can install all books at once in the Home page, while online.\u0022,gr:\u0022\u03A4\u03BF \u03B2\u03B9\u03B2\u03BB\u03AF\u03BF \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF offline\u0022,ru:\u0022\u042D\u0442\u0430 \u043A\u043D\u0438\u0433\u0430 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0432 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435\u0022,ko:\u0022This book is unavailable in offline.\u003Cbr/\u003E\u003Cbr/\u003EBooks are installed when you use them online. You can install all books at once in the Home page, while online.\u0022},Wde={en:\u0022An error occured while creating this list: no force selected\u0022,fr:\u0022Une erreur s\u0027est produite lors de la cr\u00E9ation de cette liste : aucune force s\u00E9lectionn\u00E9e\u0022,es:\u0022Ocurri\u00F3 un error al crear esta lista: ninguna fuerza seleccionada\u0022,cn:\u0022\u521B\u5EFA\u6B64\u5217\u8868\u65F6\u53D1\u751F\u9519\u8BEF\uFF1A\u672A\u9009\u62E9\u90E8\u961F\u0022,it:\u0022Si \u00E8 verificato un errore durante la creazione di questa lista: nessuna forza selezionata\u0022,de:\u0022Beim Erstellen dieser Liste ist ein Fehler aufgetreten: keine Streitmacht ausgew\u00E4hlt\u0022,ja:\u0022\u3053\u306E\u30EA\u30B9\u30C8\u4F5C\u6210\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\uFF1A\u30D5\u30A9\u30FC\u30B9\u304C\u9078\u629E\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d podczas tworzenia listy: nie wybrano si\u0142y\u0022,pt:\u0022Ocorreu um erro ao criar esta lista: nenhuma for\u00E7a selecionada\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke prilikom kreiranja ovog popisa: nije odabrana snaga\u0022,cz:\u0022An error occured while creating this list: no force selected\u0022,sk:\u0022An error occured while creating this list: no force selected\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7\u03C2\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043E\u0442\u0440\u044F\u0434\u0430\u0022,ko:\u0022An error occured while creating this list: no force selected\u0022},Yde={en:\u0022Could not create a new list :\u0022,fr:\u0022Impossible de cr\u00E9er une nouvelle liste :\u0022,es:\u0022No se pudo crear una nueva lista:\u0022,cn:\u0022\u65E0\u6CD5\u521B\u5EFA\u65B0\u5217\u8868\uFF1A\u0022,it:\u0022Impossibile creare una nuova lista:\u0022,de:\u0022Neue Liste konnte nicht erstellt werden:\u0022,ja:\u0022\u65B0\u3057\u3044\u30EA\u30B9\u30C8\u3092\u4F5C\u6210\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\uFF1A\u0022,pl:\u0022Nie mo\u017Cna utworzy\u0107 nowej listy:\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel criar uma nova lista:\u0022,hr:\u0022Nije mogu\u0107e kreirati novi popis:\u0022,cz:\u0022Could not create a new list :\u0022,sk:\u0022Could not create a new list :\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0441\u043F\u0438\u0441\u043A\u0430\u0022,ko:\u0022Could not create a new list :\u0022},Kde={en:\u0022Support New Recruit now and access\u0022,fr:\u0022Soutenez New Recruit maintenant et acc\u00E9dez aux\u0022,es:\u0022Apoya New Recruit ahora y accede a\u0022,cn:\u0022\u73B0\u5728\u652F\u6301 New Recruit \u5E76\u8BBF\u95EE\u0022,it:\u0022Supporta New Recruit ora e accedi a\u0022,de:\u0022Unterst\u00FCtzen Sie New Recruit jetzt und greifen Sie zu\u0022,ja:\u0022New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u30A2\u30AF\u30BB\u30B9\u0022,pl:\u0022Wspieraj New Recruit teraz i uzyskaj dost\u0119p do\u0022,pt:\u0022Apoie o New Recruit agora e acesse\u0022,hr:\u0022Podr\u017Eite New Recruit sada i pristupite\u0022,cz:\u0022Support New Recruit now and access\u0022,sk:\u0022Support New Recruit now and access\u0022,gr:\u0022\u03A5\u03C0\u03BF\u03C3\u03C4\u03AE\u03C1\u03B9\u03BE\u03B7 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03C3\u03B5 bonus\u0022,ru:\u0022\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0431\u043E\u043D\u0443\u0441\u043D\u044B\u043C \u0444\u0443\u043D\u043A\u0446\u0438\u044F\u043C\u0022,ko:\u0022Support New Recruit now and access\u0022},qde={en:\u0022New Recruit Bonus Features!\u0022,fr:\u0022Fonctionnalit\u00E9s Bonus de New Recruit !\u0022,es:\u0022\u00A1Caracter\u00EDsticas Bonus de New Recruit!\u0022,cn:\u0022New Recruit \u5956\u52B1\u529F\u80FD\uFF01\u0022,it:\u0022Nuove Funzionalit\u00E0 Bonus di New Recruit!\u0022,de:\u0022New Recruit Bonus-Funktionen!\u0022,ja:\u0022New Recruit\u30DC\u30FC\u30CA\u30B9\u6A5F\u80FD\uFF01\u0022,pl:\u0022Funkcji Bonusowych New Recruit!\u0022,pt:\u0022Recursos B\u00F4nus do New Recruit!\u0022,hr:\u0022New Recruit bonus zna\u010Dajke!\u0022,cz:\u0022New Recruit Bonus Features!\u0022,sk:\u0022New Recruit Bonus Features!\u0022,gr:\u0022Bonus \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03B7\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03AC NR\u0022,ru:\u0022\u0411\u043E\u043D\u0443\u0441\u043D\u044B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438 New Recruit\u0022,ko:\u0022\uC0C8 Recruit Bonus Features!\u0022},Jde={en:\u0022Thank you for supporting New Recruit. Your payment is awaiting approval. Your sub will be activated as soon as the payment is validated. This may take a few days.\u0022,fr:\u0022Merci de soutenir New Recruit. Votre paiement est en attente d\u0027approbation. Votre abonnement sera activ\u00E9 d\u00E8s que le paiement sera valid\u00E9. Cela peut prendre quelques jours.\u0022,es:\u0022Gracias por apoyar New Recruit. Tu pago est\u00E1 esperando aprobaci\u00F3n. Tu suscripci\u00F3n se activar\u00E1 tan pronto como se valide el pago. Esto puede tomar unos d\u00EDas.\u0022,cn:\u0022\u611F\u8C22\u60A8\u652F\u6301 New Recruit\u3002\u60A8\u7684\u4ED8\u6B3E\u6B63\u5728\u7B49\u5F85\u6279\u51C6\u3002\u4E00\u65E6\u4ED8\u6B3E\u5F97\u5230\u9A8C\u8BC1\uFF0C\u60A8\u7684\u8BA2\u9605\u5C06\u88AB\u6FC0\u6D3B\u3002\u8FD9\u53EF\u80FD\u9700\u8981\u51E0\u5929\u65F6\u95F4\u3002\u0022,it:\u0022Grazie per aver supportato New Recruit. Il tuo pagamento \u00E8 in attesa di approvazione. Il tuo abbonamento sar\u00E0 attivato non appena il pagamento sar\u00E0 convalidato. Potrebbero essere necessari alcuni giorni.\u0022,de:\u0022Vielen Dank f\u00FCr Ihre Unterst\u00FCtzung von New Recruit. Ihre Zahlung wartet auf Genehmigung. Ihr Abonnement wird aktiviert, sobald die Zahlung best\u00E4tigt wurde. Dies kann einige Tage dauern.\u0022,ja:\u0022New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u3044\u305F\u3060\u304D\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u304A\u652F\u6255\u3044\u306F\u627F\u8A8D\u5F85\u3061\u3067\u3059\u3002\u304A\u652F\u6255\u3044\u304C\u78BA\u8A8D\u3055\u308C\u6B21\u7B2C\u3001\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u304C\u6709\u52B9\u5316\u3055\u308C\u307E\u3059\u3002\u6570\u65E5\u304B\u304B\u308B\u5834\u5408\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Dzi\u0119kujemy za wspieranie New Recruit. Twoja p\u0142atno\u015B\u0107 oczekuje na zatwierdzenie. Twoja subskrypcja zostanie aktywowana, gdy tylko p\u0142atno\u015B\u0107 zostanie zweryfikowana. Mo\u017Ce to potrwa\u0107 kilka dni.\u0022,pt:\u0022Obrigado por apoiar o New Recruit. Seu pagamento est\u00E1 aguardando aprova\u00E7\u00E3o. Sua assinatura ser\u00E1 ativada assim que o pagamento for validado. Isso pode levar alguns dias.\u0022,hr:\u0022Hvala vam \u0161to podr\u017Eavate New Recruit. Va\u0161e pla\u0107anje \u010Deka odobrenje. Va\u0161a pretplata \u0107e biti aktivirana \u010Dim pla\u0107anje bude potvr\u0111eno. Ovo mo\u017Ee potrajati nekoliko dana.\u0022,cz:\u0022Thank you for supporting New Recruit. Your payment is awaiting approval. Your sub will be activated as soon as the payment is validated. This may take a few days.\u0022,sk:\u0022Thank you for supporting New Recruit. Your payment is awaiting approval. Your sub will be activated as soon as the payment is validated. This may take a few days.\u0022,gr:\u0022\u0395\u03BA\u03BA\u03C1\u03B5\u03BC\u03AE\u03C2 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u0022,ru:\u0022\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043F\u043B\u0430\u0442\u0435\u0436\u0430\u0022,ko:\u0022Thank you for supporting New Recruit. Your payment is awaiting approval. Your sub will be activated as soon as the payment is validated. This may take a few days.\u0022},$de={en:\u0022My New Recruit Sub\u0022,fr:\u0022Mon Abonnement New Recruit\u0022,es:\u0022Mi Suscripci\u00F3n New Recruit\u0022,cn:\u0022\u6211\u7684 New Recruit \u8BA2\u9605\u0022,it:\u0022Il Mio Abbonamento New Recruit\u0022,de:\u0022Mein New Recruit Abonnement\u0022,ja:\u0022\u30DE\u30A4New Recruit\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u0022,pl:\u0022Moja Subskrypcja New Recruit\u0022,pt:\u0022Minha Assinatura New Recruit\u0022,hr:\u0022Moja New Recruit pretplata\u0022,cz:\u0022My New Recruit Sub\u0022,sk:\u0022My New Recruit Sub\u0022,gr:\u0022\u0397 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03BC\u03BF\u03C5 \u03C3\u03C4\u03BF NR\u0022,ru:\u0022\u041C\u043E\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 New Recruit\u0022,ko:\u0022My New Recruit Sub\u0022},Zde={en:\u0022Subscription active until:\u0022,fr:\u0022Abonnement actif jusqu\u0027au :\u0022,es:\u0022Suscripci\u00F3n activa hasta:\u0022,cn:\u0022\u8BA2\u9605\u6709\u6548\u671F\u81F3\uFF1A\u0022,it:\u0022Abbonamento attivo fino a:\u0022,de:\u0022Abonnement aktiv bis:\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u6709\u52B9\u671F\u9650\uFF1A\u0022,pl:\u0022Subskrypcja aktywna do:\u0022,pt:\u0022Assinatura ativa at\u00E9:\u0022,hr:\u0022Pretplata aktivna do:\u0022,cz:\u0022Subscription active until:\u0022,sk:\u0022Subscription active until:\u0022,gr:\u0022\u0397 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B5\u03BD\u03B5\u03C1\u03B3\u03AE \u03AD\u03C9\u03C2\u0022,ru:\u0022\u041F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u0430\u043A\u0442\u0438\u0432\u043D\u0430 \u0434\u043E\u0022,ko:\u0022Subscription active until:\u0022},Xde={en:\u0022Renew my sub automatically\u0022,fr:\u0022Renouveler mon abonnement automatiquement\u0022,es:\u0022Renovar mi suscripci\u00F3n autom\u00E1ticamente\u0022,cn:\u0022\u81EA\u52A8\u7EED\u8BA2\u6211\u7684\u8BA2\u9605\u0022,it:\u0022Rinnova il mio abbonamento automaticamente\u0022,de:\u0022Mein Abonnement automatisch verl\u00E4ngern\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u81EA\u52D5\u66F4\u65B0\u3059\u308B\u0022,pl:\u0022Odn\u00F3w moj\u0105 subskrypcj\u0119 automatycznie\u0022,pt:\u0022Renovar minha assinatura automaticamente\u0022,hr:\u0022Automatski obnovi moju pretplatu\u0022,cz:\u0022Renew my sub automatically\u0022,sk:\u0022Renew my sub automatically\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03B1\u03BD\u03B1\u03BD\u03AD\u03C9\u03C3\u03B7\u0022,ru:\u0022\u041F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0442\u044C \u043C\u043E\u044E \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0022,ko:\u0022Renew my sub automatically\u0022},efe={en:\u0022Next charge:\u0022,fr:\u0022Prochaine facturation :\u0022,es:\u0022Pr\u00F3ximo cargo:\u0022,cn:\u0022\u4E0B\u6B21\u6536\u8D39\uFF1A\u0022,it:\u0022Prossimo addebito:\u0022,de:\u0022N\u00E4chste Abbuchung:\u0022,ja:\u0022\u6B21\u56DE\u8ACB\u6C42\uFF1A\u0022,pl:\u0022Nast\u0119pna op\u0142ata:\u0022,pt:\u0022Pr\u00F3xima cobran\u00E7a:\u0022,hr:\u0022Sljede\u0107a naplata:\u0022,cz:\u0022Next charge:\u0022,sk:\u0022Next charge:\u0022,gr:\u0022\u0395\u03C0\u03CC\u03BC\u03B5\u03BD\u03B7 \u03C7\u03C1\u03AD\u03C9\u03C3\u03B7\u0022,ru:\u0022\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u0022,ko:\u0022Next charge:\u0022},tfe={en:\u0022Cancel my Sub\u0022,fr:\u0022Annuler mon Abonnement\u0022,es:\u0022Cancelar mi Suscripci\u00F3n\u0022,cn:\u0022\u53D6\u6D88\u6211\u7684\u8BA2\u9605\u0022,it:\u0022Annulla il Mio Abbonamento\u0022,de:\u0022Mein Abonnement k\u00FCndigen\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u30AD\u30E3\u30F3\u30BB\u30EB\u0022,pl:\u0022Anuluj moj\u0105 Subskrypcj\u0119\u0022,pt:\u0022Cancelar minha Assinatura\u0022,hr:\u0022Otka\u017Ei moju pretplatu\u0022,cz:\u0022Cancel my Sub\u0022,sk:\u0022Cancel my Sub\u0022,gr:\u0022\u0391\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7 my Sub\u0022,ru:\u0022\u041E\u0442\u043C\u0435\u043D\u0430 my Sub\u0022,ko:\u0022Cancel my Sub\u0022},rfe={en:\u0022Your sub was cancelled and will not renew automatically, you may re-enable automatic renewal in Google Play\u0022,fr:\u0022Votre abonnement a \u00E9t\u00E9 annul\u00E9 et ne se renouvellera pas automatiquement, vous pouvez r\u00E9activer le renouvellement automatique dans Google Play\u0022,es:\u0022Tu suscripci\u00F3n fue cancelada y no se renovar\u00E1 autom\u00E1ticamente, puedes volver a habilitar la renovaci\u00F3n autom\u00E1tica en Google Play\u0022,cn:\u0022\u60A8\u7684\u8BA2\u9605\u5DF2\u53D6\u6D88\uFF0C\u4E0D\u4F1A\u81EA\u52A8\u7EED\u8BA2\uFF0C\u60A8\u53EF\u4EE5\u5728 Google Play \u4E2D\u91CD\u65B0\u542F\u7528\u81EA\u52A8\u7EED\u8BA2\u0022,it:\u0022Il tuo abbonamento \u00E8 stato annullato e non si rinnover\u00E0 automaticamente, puoi riattivare il rinnovo automatico in Google Play\u0022,de:\u0022Ihr Abonnement wurde gek\u00FCndigt und verl\u00E4ngert sich nicht automatisch. Sie k\u00F6nnen die automatische Verl\u00E4ngerung in Google Play erneut aktivieren\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u306F\u30AD\u30E3\u30F3\u30BB\u30EB\u3055\u308C\u3001\u81EA\u52D5\u66F4\u65B0\u3055\u308C\u307E\u305B\u3093\u3002Google Play\u3067\u81EA\u52D5\u66F4\u65B0\u3092\u518D\u5EA6\u6709\u52B9\u306B\u3067\u304D\u307E\u3059\u0022,pl:\u0022Twoja subskrypcja zosta\u0142a anulowana i nie b\u0119dzie odnawiana automatycznie, mo\u017Cesz ponownie w\u0142\u0105czy\u0107 automatyczne odnawianie w Google Play\u0022,pt:\u0022Sua assinatura foi cancelada e n\u00E3o ser\u00E1 renovada automaticamente, voc\u00EA pode reativar a renova\u00E7\u00E3o autom\u00E1tica no Google Play\u0022,hr:\u0022Va\u0161a pretplata je otkazana i ne\u0107e se automatski obnoviti, mo\u017Eete ponovno omogu\u0107iti automatsku obnovu u Google Play\u0022,cz:\u0022Your sub was cancelled and will not renew automatically, you may re-enable automatic renewal in Google Play\u0022,sk:\u0022Your sub was cancelled and will not renew automatically, you may re-enable automatic renewal in Google Play\u0022,gr:\u0022\u0397 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03B1\u03BA\u03C5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5 (Google Play)\u0022,ru:\u0022\u041F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u0430 \u0447\u0435\u0440\u0435\u0437 Google Play. \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0435\u0439 \u0432 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0438 Google Play.\u0022,ko:\u0022Your sub was cancelled and will not renew automatically, you may re-enable automatic renewal in Google Play\u0022},nfe={en:\u0022Your sub will renew automatically.\u0022,fr:\u0022Votre abonnement se renouvellera automatiquement.\u0022,es:\u0022Tu suscripci\u00F3n se renovar\u00E1 autom\u00E1ticamente.\u0022,cn:\u0022\u60A8\u7684\u8BA2\u9605\u5C06\u81EA\u52A8\u7EED\u8BA2\u3002\u0022,it:\u0022Il tuo abbonamento si rinnover\u00E0 automaticamente.\u0022,de:\u0022Ihr Abonnement verl\u00E4ngert sich automatisch.\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u306F\u81EA\u52D5\u7684\u306B\u66F4\u65B0\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Twoja subskrypcja b\u0119dzie odnawiana automatycznie.\u0022,pt:\u0022Sua assinatura ser\u00E1 renovada automaticamente.\u0022,hr:\u0022Va\u0161a pretplata \u0107e se automatski obnoviti.\u0022,cz:\u0022Your sub will renew automatically.\u0022,sk:\u0022Your sub will renew automatically.\u0022,gr:\u0022\u0397 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03B8\u03B1 \u03B1\u03BD\u03B1\u03BD\u03B5\u03C9\u03B8\u03B5\u03AF \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1\u0022,ru:\u0022\u0412\u0430\u0448\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.\u0022,ko:\u0022Your sub will renew automatically.\u0022},ife={en:\u0022Your sub \u003Cb\u003Enot\u003C/b\u003E renew automatically.\u0022,fr:\u0022Votre abonnement ne se renouvellera \u003Cb\u003Epas\u003C/b\u003E automatiquement.\u0022,es:\u0022Tu suscripci\u00F3n \u003Cb\u003Eno\u003C/b\u003E se renovar\u00E1 autom\u00E1ticamente.\u0022,cn:\u0022\u60A8\u7684\u8BA2\u9605\u003Cb\u003E\u4E0D\u4F1A\u003C/b\u003E\u81EA\u52A8\u7EED\u8BA2\u3002\u0022,it:\u0022Il tuo abbonamento \u003Cb\u003Enon\u003C/b\u003E si rinnover\u00E0 automaticamente.\u0022,de:\u0022Ihr Abonnement verl\u00E4ngert sich \u003Cb\u003Enicht\u003C/b\u003E automatisch.\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u306F\u81EA\u52D5\u7684\u306B\u003Cb\u003E\u66F4\u65B0\u3055\u308C\u307E\u305B\u3093\u003C/b\u003E\u3002\u0022,pl:\u0022Twoja subskrypcja \u003Cb\u003Enie\u003C/b\u003E b\u0119dzie odnawiana automatycznie.\u0022,pt:\u0022Sua assinatura \u003Cb\u003En\u00E3o\u003C/b\u003E ser\u00E1 renovada automaticamente.\u0022,hr:\u0022Va\u0161a pretplata se \u003Cb\u003Ene\u0107e\u003C/b\u003E automatski obnoviti.\u0022,cz:\u0022Your sub \u003Cb\u003Enot\u003C/b\u003E renew automatically.\u0022,sk:\u0022Your sub \u003Cb\u003Enot\u003C/b\u003E renew automatically.\u0022,gr:\u0022\u0397 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03B4\u03B5\u03BD \u03B8\u03B1 \u03B1\u03BD\u03B1\u03BD\u03B5\u03C9\u03B8\u03B5\u03AF \u03B1\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B1\u0022,ru:\u0022\u0412\u0430\u0448\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u003Cb\u003E\u043D\u0435\u003C/b\u003E \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.\u0022,ko:\u0022Your sub \u003Cb\u003Enot\u003C/b\u003E renew automatically.\u0022},sfe={en:\u0022You can enable or disable the automatic renewal of your sub from the App Store.\u0022,fr:\u0022Vous pouvez activer ou d\u00E9sactiver le renouvellement automatique de votre abonnement depuis l\u0027App Store.\u0022,es:\u0022Puedes habilitar o deshabilitar la renovaci\u00F3n autom\u00E1tica de tu suscripci\u00F3n desde la App Store.\u0022,cn:\u0022\u60A8\u53EF\u4EE5\u4ECE App Store \u542F\u7528\u6216\u7981\u7528\u8BA2\u9605\u7684\u81EA\u52A8\u7EED\u8BA2\u3002\u0022,it:\u0022Puoi abilitare o disabilitare il rinnovo automatico del tuo abbonamento dall\u0027App Store.\u0022,de:\u0022Sie k\u00F6nnen die automatische Verl\u00E4ngerung Ihres Abonnements im App Store aktivieren oder deaktivieren.\u0022,ja:\u0022App Store\u304B\u3089\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u306E\u81EA\u52D5\u66F4\u65B0\u3092\u6709\u52B9\u307E\u305F\u306F\u7121\u52B9\u306B\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Mo\u017Cesz w\u0142\u0105czy\u0107 lub wy\u0142\u0105czy\u0107 automatyczne odnawianie subskrypcji w App Store.\u0022,pt:\u0022Voc\u00EA pode ativar ou desativar a renova\u00E7\u00E3o autom\u00E1tica de sua assinatura na App Store.\u0022,hr:\u0022Mo\u017Eete omogu\u0107iti ili onemogu\u0107iti automatsku obnovu pretplate iz App Store.\u0022,cz:\u0022You can enable or disable the automatic renewal of your sub from the App Store.\u0022,sk:\u0022You can enable or disable the automatic renewal of your sub from the App Store.\u0022,gr:\u0022\u0391\u03BD\u03B1\u03BD\u03AD\u03C9\u03C3\u03B7 (App Store)\u0022,ru:\u0022\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443 \u0447\u0435\u0440\u0435\u0437 App Store\u0022,ko:\u0022You can enable or disable the automatic renewal of your sub from the App Store.\u0022},ofe={en:\u0022Extend my Sub\u0022,fr:\u0022Prolonger mon Abonnement\u0022,es:\u0022Extender mi Suscripci\u00F3n\u0022,cn:\u0022\u5EF6\u957F\u6211\u7684\u8BA2\u9605\u0022,it:\u0022Estendi il Mio Abbonamento\u0022,de:\u0022Mein Abonnement verl\u00E4ngern\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u5EF6\u9577\u0022,pl:\u0022Przed\u0142u\u017C moj\u0105 Subskrypcj\u0119\u0022,pt:\u0022Estender minha Assinatura\u0022,hr:\u0022Produ\u017Ei moju pretplatu\u0022,cz:\u0022Extend my Sub\u0022,sk:\u0022Extend my Sub\u0022,gr:\u0022\u0395\u03C0\u03AD\u03BA\u03C4\u03B1\u03C3\u03B7 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2\u0022,ru:\u0022\u041F\u0440\u043E\u0434\u043B\u0438\u0442\u044C \u043C\u043E\u044E \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443\u0022,ko:\u0022Extend my Sub\u0022},afe={en:\u0027Clicking \u0022Extend my sub\u0022 will add subscription time to your account, you can do it at any time.\u0027,fr:\u0060Cliquer sur \u0022Prolonger mon abonnement\u0022 ajoutera du temps d\u0027abonnement \u00E0 votre compte, vous pouvez le faire \u00E0 tout moment.\u0060,es:\u0027Hacer clic en \u0022Extender mi suscripci\u00F3n\u0022 agregar\u00E1 tiempo de suscripci\u00F3n a tu cuenta, puedes hacerlo en cualquier momento.\u0027,cn:\u0027\u70B9\u51FB\u0022\u5EF6\u957F\u6211\u7684\u8BA2\u9605\u0022\u5C06\u4E3A\u60A8\u7684\u8D26\u6237\u589E\u52A0\u8BA2\u9605\u65F6\u95F4\uFF0C\u60A8\u53EF\u4EE5\u968F\u65F6\u6267\u884C\u6B64\u64CD\u4F5C\u3002\u0027,it:\u0027Cliccando su \u0022Estendi il mio abbonamento\u0022 aggiungerai tempo di abbonamento al tuo account, puoi farlo in qualsiasi momento.\u0027,de:\u0027Durch Klicken auf \u0022Mein Abonnement verl\u00E4ngern\u0022 wird Ihrem Konto Abonnementzeit hinzugef\u00FCgt, Sie k\u00F6nnen dies jederzeit tun.\u0027,ja:\u0022\u300C\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u5EF6\u9577\u300D\u3092\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u3001\u30A2\u30AB\u30A6\u30F3\u30C8\u306B\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u671F\u9593\u304C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002\u3044\u3064\u3067\u3082\u5B9F\u884C\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0027Klikni\u0119cie \u0022Przed\u0142u\u017C moj\u0105 subskrypcj\u0119\u0022 doda czas subskrypcji do Twojego konta, mo\u017Cesz to zrobi\u0107 w dowolnym momencie.\u0027,pt:\u0027Clicar em \u0022Estender minha assinatura\u0022 adicionar\u00E1 tempo de assinatura \u00E0 sua conta, voc\u00EA pode fazer isso a qualquer momento.\u0027,hr:\u0027Klikom na \u0022Produ\u017Ei moju pretplatu\u0022 dodat \u0107ete vrijeme pretplate va\u0161em ra\u010Dunu, mo\u017Eete to u\u010Diniti bilo kada.\u0027,cz:\u0027Clicking \u0022Extend my sub\u0022 will add subscription time to your account, you can do it at any time.\u0027,sk:\u0027Clicking \u0022Extend my sub\u0022 will add subscription time to your account, you can do it at any time.\u0027,gr:\u0022\u03A0\u03B5\u03C1\u03B9\u03B3\u03C1\u03B1\u03C6\u03AE \u03B5\u03C0\u03AD\u03BA\u03C4\u03B1\u03C3\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2\u0022,ru:\u0022\u041F\u0440\u043E\u0434\u043B\u0438\u0442\u044C \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443 \u0438\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0027Clicking \u0022Extend my sub\u0022 will add subscription time to your account, you can do it at any time.\u0027},lfe={en:\u0022You are offline, subscription details could not be retrieved!\u0022,fr:\u0022Vous \u00EAtes hors ligne, les d\u00E9tails de l\u0027abonnement n\u0027ont pas pu \u00EAtre r\u00E9cup\u00E9r\u00E9s !\u0022,es:\u0022Est\u00E1s desconectado, \u00A1no se pudieron recuperar los detalles de la suscripci\u00F3n!\u0022,cn:\u0022\u60A8\u79BB\u7EBF\u4E86\uFF0C\u65E0\u6CD5\u83B7\u53D6\u8BA2\u9605\u8BE6\u60C5\uFF01\u0022,it:\u0022Sei offline, impossibile recuperare i dettagli dell\u0027abbonamento!\u0022,de:\u0022Sie sind offline, Abonnement-Details konnten nicht abgerufen werden!\u0022,ja:\u0022\u30AA\u30D5\u30E9\u30A4\u30F3\u306E\u305F\u3081\u3001\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u306E\u8A73\u7D30\u3092\u53D6\u5F97\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\uFF01\u0022,pl:\u0022Jeste\u015B offline, szczeg\u00F3\u0142y subskrypcji nie mog\u0142y zosta\u0107 pobrane!\u0022,pt:\u0022Voc\u00EA est\u00E1 offline, os detalhes da assinatura n\u00E3o puderam ser recuperados!\u0022,hr:\u0022Izvan ste mre\u017Ee, detalji pretplate nisu mogli biti dohva\u0107eni!\u0022,cz:\u0022You are offline, subscription details could not be retrieved!\u0022,sk:\u0022You are offline, subscription details could not be retrieved!\u0022,gr:\u0022\u039B\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2 offline \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2\u0022,ru:\u0022\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u0441\u044C \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443 \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022You are offline, subscription details could not be retrieved!\u0022},ufe={en:\u0022As per popular demand, I added the possibility of making free, additional donations here, to support our work on the project. Thank you!\u0022,fr:\u0022Suite \u00E0 la demande populaire, j\u0027ai ajout\u00E9 la possibilit\u00E9 de faire des dons suppl\u00E9mentaires gratuits ici, pour soutenir notre travail sur le projet. Merci !\u0022,es:\u0022Por demanda popular, agregu\u00E9 la posibilidad de hacer donaciones adicionales gratuitas aqu\u00ED, para apoyar nuestro trabajo en el proyecto. \u00A1Gracias!\u0022,cn:\u0022\u5E94\u5927\u4F17\u8981\u6C42\uFF0C\u6211\u5728\u8FD9\u91CC\u6DFB\u52A0\u4E86\u514D\u8D39\u989D\u5916\u6350\u8D60\u7684\u53EF\u80FD\u6027\uFF0C\u4EE5\u652F\u6301\u6211\u4EEC\u5728\u9879\u76EE\u4E0A\u7684\u5DE5\u4F5C\u3002\u8C22\u8C22\uFF01\u0022,it:\u0022Su richiesta popolare, ho aggiunto la possibilit\u00E0 di fare donazioni aggiuntive gratuite qui, per supportare il nostro lavoro sul progetto. Grazie!\u0022,de:\u0022Auf vielfachen Wunsch habe ich hier die M\u00F6glichkeit hinzugef\u00FCgt, kostenlose, zus\u00E4tzliche Spenden zu t\u00E4tigen, um unsere Arbeit am Projekt zu unterst\u00FCtzen. Vielen Dank!\u0022,ja:\u0022\u591A\u304F\u306E\u3054\u8981\u671B\u306B\u304A\u5FDC\u3048\u3057\u3066\u3001\u30D7\u30ED\u30B8\u30A7\u30AF\u30C8\u3078\u306E\u4F5C\u696D\u3092\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u305F\u3081\u306E\u7121\u6599\u306E\u8FFD\u52A0\u5BC4\u4ED8\u306E\u53EF\u80FD\u6027\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\u0022,pl:\u0022Na pro\u015Bb\u0119 spo\u0142eczno\u015Bci, doda\u0142em mo\u017Cliwo\u015B\u0107 dokonywania dodatkowych, dobrowolnych darowizn tutaj, aby wspiera\u0107 nasz\u0105 prac\u0119 nad projektem. Dzi\u0119kuj\u0119!\u0022,pt:\u0022Por demanda popular, adicionei a possibilidade de fazer doa\u00E7\u00F5es adicionais gratuitas aqui, para apoiar nosso trabalho no projeto. Obrigado!\u0022,hr:\u0022Na zahtjev korisnika, dodao sam mogu\u0107nost besplatnih, dodatnih donacija ovdje, kako bismo podr\u017Eali na\u0161 rad na projektu. Hvala vam!\u0022,cz:\u0022As per popular demand, I added the possibility of making free, additional donations here, to support our work on the project. Thank you!\u0022,sk:\u0022As per popular demand, I added the possibility of making free, additional donations here, to support our work on the project. Thank you!\u0022,gr:\u0022\u03A0\u03C1\u03CC\u03C3\u03B8\u03B5\u03C4\u03B5\u03C2 \u03B4\u03C9\u03C1\u03B5\u03AD\u03C2\u0022,ru:\u0022\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F\u0022,ko:\u0022As per popular demand, I added the possibility of making free, additional donations here, to support our work on the project. Thank you!\u0022},cfe={en:\u0022Make a Donation\u0022,fr:\u0022Faire un Don\u0022,es:\u0022Hacer una Donaci\u00F3n\u0022,cn:\u0022\u8FDB\u884C\u6350\u8D60\u0022,it:\u0022Fai una Donazione\u0022,de:\u0022Eine Spende machen\u0022,ja:\u0022\u5BC4\u4ED8\u3059\u308B\u0022,pl:\u0022Przeka\u017C Darowizn\u0119\u0022,pt:\u0022Fazer uma Doa\u00E7\u00E3o\u0022,hr:\u0022Napravite donaciju\u0022,cz:\u0022Make a Donation\u0022,sk:\u0022Make a Donation\u0022,gr:\u0022\u039A\u03AC\u03BD\u03C4\u03B5 \u03B4\u03C9\u03C1\u03B5\u03AC\u0022,ru:\u0022\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Make a Donation\u0022},Afe={en:\u0022Restore Purchase\u0022,fr:\u0022Restaurer l\u0027Achat\u0022,es:\u0022Restaurar Compra\u0022,cn:\u0022\u6062\u590D\u8D2D\u4E70\u0022,it:\u0022Ripristina Acquisto\u0022,de:\u0022Kauf wiederherstellen\u0022,ja:\u0022\u8CFC\u5165\u3092\u5FA9\u5143\u0022,pl:\u0022Przywr\u00F3\u0107 Zakup\u0022,pt:\u0022Restaurar Compra\u0022,hr:\u0022Vrati kupnju\u0022,cz:\u0022Restore Purchase\u0022,sk:\u0022Restore Purchase\u0022,gr:\u0022\u0395\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03B1\u03B3\u03BF\u03C1\u03AC\u03C2\u0022,ru:\u0022\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u043E\u043A\u0443\u043F\u043A\u0443\u0022,ko:\u0022Restore Purchase\u0022},dfe={en:\u0022Unable to restore purchases\u0022,fr:\u0022Impossible de restaurer les achats\u0022,es:\u0022No se pueden restaurar las compras\u0022,cn:\u0022\u65E0\u6CD5\u6062\u590D\u8D2D\u4E70\u0022,it:\u0022Impossibile ripristinare gli acquisti\u0022,de:\u0022K\u00E4ufe k\u00F6nnen nicht wiederhergestellt werden\u0022,ja:\u0022\u8CFC\u5165\u3092\u5FA9\u5143\u3067\u304D\u307E\u305B\u3093\u0022,pl:\u0022Nie mo\u017Cna przywr\u00F3ci\u0107 zakup\u00F3w\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel restaurar as compras\u0022,hr:\u0022Nemogu\u0107e vratiti kupnje\u0022,cz:\u0022Unable to restore purchases\u0022,sk:\u0022Unable to restore purchases\u0022,gr:\u0022\u0391\u03B4\u03C5\u03BD\u03B1\u03BC\u03AF\u03B1 \u03B5\u03C0\u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC\u03C2 \u03B1\u03B3\u03BF\u03C1\u03CE\u03BD\u0022,ru:\u0022\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u043E\u043A\u0443\u043F\u043A\u0438\u0022,ko:\u0022Unable to restore purchases\u0022},ffe={en:\u0022Are you sure you want to cancel your Sub? It will remain valid until expiry\u0022,fr:\u0022\u00CAtes-vous s\u00FBr de vouloir annuler votre Abonnement ? Il restera valide jusqu\u0027\u00E0 expiration\u0022,es:\u0022\u00BFEst\u00E1s seguro de que quieres cancelar tu Suscripci\u00F3n? Seguir\u00E1 siendo v\u00E1lida hasta su vencimiento\u0022,cn:\u0022\u60A8\u786E\u5B9A\u8981\u53D6\u6D88\u8BA2\u9605\u5417\uFF1F\u5B83\u5C06\u4FDD\u6301\u6709\u6548\u76F4\u5230\u5230\u671F\u0022,it:\u0022Sei sicuro di voler annullare il tuo Abbonamento? Rimarr\u00E0 valido fino alla scadenza\u0022,de:\u0022Sind Sie sicher, dass Sie Ihr Abonnement k\u00FCndigen m\u00F6chten? Es bleibt bis zum Ablauf g\u00FCltig\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3092\u30AD\u30E3\u30F3\u30BB\u30EB\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F\u6709\u52B9\u671F\u9650\u307E\u3067\u6709\u52B9\u3067\u3059\u0022,pl:\u0022Czy na pewno chcesz anulowa\u0107 swoj\u0105 Subskrypcj\u0119? Pozostanie ona wa\u017Cna do wyga\u015Bni\u0119cia\u0022,pt:\u0022Tem certeza de que deseja cancelar sua Assinatura? Ela permanecer\u00E1 v\u00E1lida at\u00E9 o vencimento\u0022,hr:\u0022Jeste li sigurni da \u017Eelite otkazati svoju pretplatu? Ostat \u0107e va\u017Ee\u0107a do isteka\u0022,cz:\u0022Are you sure you want to cancel your Sub? It will remain valid until expiry\u0022,sk:\u0022Are you sure you want to cancel your Sub? It will remain valid until expiry\u0022,gr:\u0022\u0395\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7 \u03B1\u03BA\u03CD\u03C1\u03C9\u03C3\u03B7\u03C2 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE\u03C2\u0022,ru:\u0022\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443?\u0022,ko:\u0022Are you sure you want to cancel your Sub? It will remain valid until expiry\u0022},pfe={en:\u0022Your sub has been cancelled\u0022,fr:\u0022Votre abonnement a \u00E9t\u00E9 annul\u00E9\u0022,es:\u0022Tu suscripci\u00F3n ha sido cancelada\u0022,cn:\u0022\u60A8\u7684\u8BA2\u9605\u5DF2\u88AB\u53D6\u6D88\u0022,it:\u0022Il tuo abbonamento \u00E8 stato annullato\u0022,de:\u0022Ihr Abonnement wurde gek\u00FCndigt\u0022,ja:\u0022\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u306F\u30AD\u30E3\u30F3\u30BB\u30EB\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022Twoja subskrypcja zosta\u0142a anulowana\u0022,pt:\u0022Sua assinatura foi cancelada\u0022,hr:\u0022Va\u0161a pretplata je otkazana\u0022,cz:\u0022Your sub has been cancelled\u0022,sk:\u0022Your sub has been cancelled\u0022,gr:\u0022\u0397 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03B1\u03BA\u03C5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5\u0022,ru:\u0022\u0412\u0430\u0448\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u0431\u044B\u043B\u0430 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u0430\u0022,ko:\u0022Your sub has been cancelled\u0022},hfe={en:\u0022An error occured! Please contact New Recruit\u0022,fr:\u0022Une erreur s\u0027est produite ! Veuillez contacter New Recruit\u0022,es:\u0022\u00A1Ocurri\u00F3 un error! Por favor contacta New Recruit\u0022,cn:\u0022\u53D1\u751F\u9519\u8BEF\uFF01\u8BF7\u8054\u7CFB New Recruit\u0022,it:\u0022Si \u00E8 verificato un errore! Si prega di contattare New Recruit\u0022,de:\u0022Ein Fehler ist aufgetreten! Bitte kontaktieren Sie New Recruit\u0022,ja:\u0022\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\uFF01New Recruit\u306B\u9023\u7D61\u3057\u3066\u304F\u3060\u3055\u3044\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d! Prosz\u0119 skontaktowa\u0107 si\u0119 z New Recruit\u0022,pt:\u0022Ocorreu um erro! Por favor, entre em contato com o New Recruit\u0022,hr:\u0022Dogodila se gre\u0161ka! Molimo kontaktirajte New Recruit\u0022,cz:\u0022An error occured! Please contact New Recruit\u0022,sk:\u0022An error occured! Please contact New Recruit\u0022,gr:\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03B5\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1\u03C2 \u03BC\u03B5 NR\u0022,ru:\u0022\u0421\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C \u0441 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u043E\u0439 New Recruit \u043F\u0440\u0438 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0022,ko:\u0022An error occured! Please contact New Recruit\u0022},mfe={en:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022,fr:\u0022Une erreur s\u0027est produite lors de la cr\u00E9ation de votre compte, peut-\u00EAtre que ce nom d\u0027utilisateur ou cette adresse e-mail existe d\u00E9j\u00E0.\u0022,es:\u0022Ocurri\u00F3 un error al crear tu cuenta, tal vez este nombre de usuario o correo electr\u00F3nico ya existe.\u0022,cn:\u0022\u521B\u5EFA\u8D26\u6237\u65F6\u53D1\u751F\u9519\u8BEF\uFF0C\u53EF\u80FD\u6B64\u7528\u6237\u540D\u6216\u90AE\u7BB1\u5DF2\u5B58\u5728\u3002\u0022,it:\u0022Si \u00E8 verificato un errore durante la creazione del tuo account, forse questo nome utente o email esiste gi\u00E0.\u0022,de:\u0022Beim Erstellen Ihres Kontos ist ein Fehler aufgetreten, m\u00F6glicherweise existiert dieser Benutzername oder diese E-Mail bereits.\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u4F5C\u6210\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\u3002\u3053\u306E\u30E6\u30FC\u30B6\u30FC\u540D\u307E\u305F\u306F\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u306F\u65E2\u306B\u5B58\u5728\u3057\u3066\u3044\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d podczas tworzenia konta, mo\u017Cliwe \u017Ce ta nazwa u\u017Cytkownika lub email ju\u017C istnieje.\u0022,pt:\u0022Ocorreu um erro ao criar sua conta, talvez este nome de usu\u00E1rio ou e-mail j\u00E1 exista.\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke prilikom kreiranja va\u0161eg ra\u010Duna, mo\u017Eda ovo korisni\u010Dko ime ili email ve\u0107 postoji.\u0022,cz:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022,sk:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022,gr:\u0022\u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7/email \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03AE\u03B4\u03B7\u0022,ru:\u0022\u0418\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438\u043B\u0438 email \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F\u0022,ko:\u0022An error occured while creating your account, perhaps this username or email already exists.\u0022},gfe={en:\u0022Unable to connect to New Recruit!\u0022,fr:\u0022Impossible de se connecter \u00E0 New Recruit !\u0022,es:\u0022\u00A1No se puede conectar a New Recruit!\u0022,cn:\u0022\u65E0\u6CD5\u8FDE\u63A5\u5230 New Recruit\uFF01\u0022,it:\u0022Impossibile connettersi a New Recruit!\u0022,de:\u0022Verbindung zu New Recruit nicht m\u00F6glich!\u0022,ja:\u0022New Recruit\u306B\u63A5\u7D9A\u3067\u304D\u307E\u305B\u3093\uFF01\u0022,pl:\u0022Nie mo\u017Cna po\u0142\u0105czy\u0107 si\u0119 z New Recruit!\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel conectar ao New Recruit!\u0022,hr:\u0022Nemogu\u0107e se povezati s New Recruit!\u0022,cz:\u0022Unable to connect to New Recruit!\u0022,sk:\u0022Unable to connect to New Recruit!\u0022,gr:\u0022\u0391\u03B4\u03C5\u03BD\u03B1\u03BC\u03AF\u03B1 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u03C2 \u03BC\u03B5 NR\u0022,ru:\u0022\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F \u043A \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043C New Recruit\u0022,ko:\u0022Unable to connect to New Recruit!\u0022},yfe={en:\u0022Filter Lists\u0022,fr:\u0022Filtrer les Listes\u0022,es:\u0022Filtrar Listas\u0022,cn:\u0022\u8FC7\u6EE4\u5217\u8868\u0022,it:\u0022Filtra Liste\u0022,de:\u0022Listen filtern\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3092\u30D5\u30A3\u30EB\u30BF\u30FC\u0022,pl:\u0022Filtruj Listy\u0022,pt:\u0022Filtrar Listas\u0022,hr:\u0022Filtriraj popise\u0022,cz:\u0022Filter Lists\u0022,sk:\u0022Filter Lists\u0022,gr:\u0022\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1 \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD\u0022,ru:\u0022\u0424\u0438\u043B\u044C\u0442\u0440 \u0421\u043F\u0438\u0441\u043A\u0438\u0022,ko:\u0022Filter Lists\u0022},wfe={en:\u0022Any\u0022,fr:\u0022Tous\u0022,es:\u0022Cualquiera\u0022,cn:\u0022\u4EFB\u610F\u0022,it:\u0022Qualsiasi\u0022,de:\u0022Beliebig\u0022,ja:\u0022\u3059\u3079\u3066\u0022,pl:\u0022Dowolny\u0022,pt:\u0022Qualquer\u0022,hr:\u0022Bilo koje\u0022,cz:\u0022Any\u0022,sk:\u0022Ak\u00E9ko\u013Evek\u0022,gr:\u0022\u039F\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5\u0022,ru:\u0022\u041B\u044E\u0431\u043E\u0439\u0022,ko:\u0022Any\u0022},bfe={en:\u0022Search list by name...\u0022,fr:\u0022Rechercher par nom de liste...\u0022,es:\u0022Buscar lista por nombre...\u0022,cn:\u0022\u6309\u540D\u79F0\u641C\u7D22\u5217\u8868...\u0022,it:\u0022Cerca lista per nome...\u0022,de:\u0022Liste nach Name suchen...\u0022,ja:\u0022\u540D\u524D\u3067\u30EA\u30B9\u30C8\u