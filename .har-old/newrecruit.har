n  }\n\n  .p-2px {\n    padding: 2px;\n  }\n\n  .pb-4 {\n    padding-bottom: 1rem;\n  }\n\n  .pb-50px {\n    padding-bottom: 50px;\n  }\n\n  .pt-5 {\n    padding-top: 1.25rem;\n  }\n\n  .align-middle {\n    vertical-align: middle;\n  }\n\n  .text-sm {\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  .uppercase {\n    text-transform: uppercase;\n  }\n\n  @media print {\n    .print\\\\\\\\:p-20px {\n      padding: 20px;\n    }\n  }\n\n  @media (min-width: 640px) {\n    .sm\\\\\\\\:border-l-2 {\n      border-left-width: 2px;\n    }\n\n    .sm\\\\\\\\:border-r-2 {\n      border-right-width: 2px;\n    }\n\n    .sm\\\\\\\\:p-2 {\n      padding: 0.5rem;\n    }\n\n    .sm\\\\\\\\:pb-50px {\n      padding-bottom: 50px;\n    }\n\n    .sm\\\\\\\\:pt-5 {\n      padding-top: 1.25rem;\n    }\n\n    @media print {\n      .sm\\\\\\\\:print\\\\\\\\:p-20px {\n        padding: 20px;\n      }\n\n      .sm\\\\\\\\:print\\\\\\\\:pb-50px {\n        padding-bottom: 50px;\n      }\n    }\n  }\n\n  @media (min-width: 768px) {\n    .md\\\\\\\\:p-20px {\n      padding: 20px;\n    }\n\n    .md\\\\\\\\:pb-50px {\n      padding-bottom: 50px;\n    }\n\n    .md\\\\\\\\:pt-5 {\n      padding-top: 1.25rem;\n    }\n\n    @media print {\n      .md\\\\\\\\:print\\\\\\\\:p-20px {\n        padding: 20px;\n      }\n\n      .md\\\\\\\\:print\\\\\\\\:pb-50px {\n        padding-bottom: 50px;\n      }\n    }\n  }\n\n  .split::after {\n    content: \u0022,\u0022;\n    font-family: inherit;\n  }\n\n  .split:last-of-type::after {\n    content: \u0022\u0022;\n  }\n\n  .hide-if-empty:not(:has(div, span)) {\n    display: none !important;\n  }\n\n  @media print {\n    html {\n      zoom: 0.7;\n    }\n  }\n\n  .row-header {\n    width: 65%;\n  }\n\n  .rules-block:not(:has(.rule)) {\n    display: none !important;\n  }\n\n  .rules-list {\n    padding: 8px;\n    background-color: rgb(233, 234, 236);\n    border: 2px solid gray;\n    margin-bottom: 32px;\n\n    \u003E .rule:not(:last-child) {\n      margin-bottom: 10px;\n    }\n  }\n\n  .rule-name {\n    white-space: nowrap;\n    font-weight: 700;\n    display: block;\n  }\n\n  .force-name {\n    white-space: nowrap;\n    font-weight: 800;\n  }\n\n  .force-catalogue {\n    color: gray;\n    font-weight: 500;\n  }\n\n  .nested {\n    margin-left: 5px;\n  }\n\n  .model-name-options:not(:has(.model-name)) {\n    padding-top: 1.2em;\n  }\n\n  .keywords {\n    position: absolute;\n    left: 0px;\n    bottom: -16px;\n    padding: 0px 4px 0px 42px;\n    display: flex;\n    justify-content: center;\n    flex-direction: column;\n    color: rgb(255, 255, 255);\n    border-left: none;\n    width: calc(100% - 0.9rem);\n    min-height: 54px;\n    background: url(\u0022data:image/bmp;base64,\u0022)\n      0% 0% / contain;\n  }\n\n  .keywords:not(:has(.keyword)) \u003E * {\n    display: none;\n  }\n\u003C/style\u003E\n\u003Cstyle\u003E\n  html {\n    --primary-color: #1f787f;\n    --primary-color-transparent: #1f787f60;\n  }\n\n  [catalogue*=\u0022Adeptus Astartes\u0022 i] {\n    --primary-color: #536766;\n    --primary-color-transparent: #53676660;\n  }\n\n  [catalogue*=\u0022Blood Angels\u0022 i] {\n    --primary-color: #761119;\n    --primary-color-transparent: #76111960;\n  }\n\n  [catalogue*=\u0022Space Wolves\u0022 i] {\n    --primary-color: #3e646f;\n    --primary-color-transparent: #3e646f60;\n  }\n\n  [catalogue*=\u0022Imperial Fists\u0022 i] {\n    --primary-color: #b87d00;\n    --primary-color-transparent: #b87d0060;\n  }\n\n  [catalogue*=\u0022Raven Guard\u0022 i] {\n    --primary-color: #2b2b2b;\n    --primary-color-transparent: #2b2b2b60;\n  }\n\n  [catalogue*=\u0022Salamanders\u0022 i] {\n    --primary-color: #1b623f;\n    --primary-color-transparent: #1b623f60;\n  }\n\n  [catalogue*=\u0022White Scars\u0022 i] {\n    --primary-color: #783028;\n    --primary-color-transparent: #78302860;\n  }\n\n  [catalogue*=\u0022Dark Angels\u0022 i] {\n    --primary-color: #014419;\n    --primary-color-transparent: #01441960;\n  }\n\