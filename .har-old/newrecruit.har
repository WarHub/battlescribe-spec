\u0022,gr:\u0022\u03A1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7 \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03B5\u03C5\u03CC\u03BD\u03C4\u03C9\u03BD \u03C3\u03C4\u03CC\u03C7\u03C9\u03BD\u0022,ru:\u0022\u0412\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u0435 \u043C\u0438\u0441\u0441\u0438\u0438\u0022,ko:\u0022Secondary Missions\u0022},rFe={en:\u0022Please select 2 Secondary missions\u0022,fr:\u0022Veuillez s\u00E9lectionner 2 missions secondaires\u0022,es:\u0022Por favor selecciona 2 misiones secundarias\u0022,cn:\u0022\u8BF7\u9009\u62E92\u4E2A\u6B21\u8981\u4EFB\u52A1\u0022,it:\u0022Si prega di selezionare 2 missioni secondarie\u0022,de:\u0022Bitte w\u00E4hle 2 sekund\u00E4re Missionen\u0022,ja:\u0022\u30BB\u30AB\u30F3\u30C0\u30EA\u30FC\u30DF\u30C3\u30B7\u30E7\u30F3\u30922\u3064\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u0022,pl:\u0022Wybierz 2 misje dodatkowe\u0022,pt:\u0022Por favor selecione 2 miss\u00F5es secund\u00E1rias\u0022,hr:\u0022Odaberite sekundarne ciljeve\u0022,cz:\u0022Please select 2 Secondary missions\u0022,sk:\u0022Please select 2 Secondary missions\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03B5\u03CD\u03BF\u03BD\u03C4\u03B5\u03C2 \u03C3\u03C4\u03CC\u03C7\u03BF\u03C5\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u0447\u0438\u0022,ko:\u0022Please select 2 Secondary missions\u0022},nFe={en:\u0022You will draw Secondary Missions during the game.\u0022,fr:\u0022Vous tirerez des Missions Secondaires pendant la partie.\u0022,es:\u0022Robar\u00E1s Misiones Secundarias durante el juego.\u0022,cn:\u0022\u60A8\u5C06\u5728\u6E38\u620F\u671F\u95F4\u62BD\u53D6\u6B21\u8981\u4EFB\u52A1\u3002\u0022,it:\u0022Pescherai le Missioni Secondarie durante la partita.\u0022,de:\u0022Du wirst w\u00E4hrend des Spiels sekund\u00E4re Missionen ziehen.\u0022,ja:\u0022\u30B2\u30FC\u30E0\u4E2D\u306B\u30BB\u30AB\u30F3\u30C0\u30