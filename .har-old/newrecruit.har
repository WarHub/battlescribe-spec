os jogos selecionados. Isso permitir\u00E1 usar o New Recruit\u0022,hr:\u0022A\u017Eurirajte sve sustave igara odjednom\u0022,cz:\u0022Clicking Update All will update New Recruit, and all selected games. This will allow using New Recruit\u0022,sk:\u0022Clicking Update All will update New Recruit, and all selected games. This will allow using New Recruit\u0022,gr:\u0022\u03A0\u03B1\u03C4\u03CE\u03BD\u03C4\u03B1\u03C2 \u0395\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u038C\u03BB\u03C9\u03BD \u03B8\u03B1 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03C9\u03B8\u03B5\u03AF \u03C4\u03BF New Recruit \u03BA\u03B1\u03B9 \u03CC\u03BB\u03B1 \u03C4\u03B1 \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BC\u03AD\u03BD\u03B1 \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1. \u0391\u03C5\u03C4\u03CC \u03B8\u03B1 \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C8\u03B5\u03B9 \u03C4\u03B7 \u03C7\u03C1\u03AE\u03C3\u03B7 \u03C4\u03BF\u03C5 New Recruit\u0022,ru:\u0022\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u0441\u0435 \u0438\u0433\u0440\u043E\u0432\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0432\u0435\u0440\u0441\u0438\u0438\u0022,ko:\u0022Clicking Update All will update New Recruit, and all selected games. This will allow using New Recruit\u0022},Hye={en:\u0022Installing Offline Mode\u0022,fr:\u0022Installation du Mode Hors Ligne\u0022,es:\u0022Instalando Modo Sin Conexi\u00F3n\u0022,cn:\u0022\u5B89\u88C5\u79BB\u7EBF\u6A21\u5F0F\u0022,it:\u0022Installazione modalit\u00E0 offline\u0022,de:\u0022Installiere Offline-Modus\u0022,ja:\u0022\u30AA\u30D5\u30E9\u30A4\u30F3\u30E2\u30FC\u30C9\u3092\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u4E2D\u0022,pl:\u0022Instalowanie trybu offline\u0022,pt:\u0022Instalando Modo Offline\u0022,hr:\u0022Instalacija za na\u010Din rada izvan mre\u017Ee...\u0022,cz:\u0022Installing Offline Mode\u0022,sk:\u0022Installing Offline Mode\u0022,gr:\u0022\u0395\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7 \u039B\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1\u03C2 \u0395\u03BA\u03C4\u03CC\u03C2 \u03A3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0434\u0430\u043D\u043D\u044B\u0445 \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E\u0433\u043E \u0440\u0435\u0436\u0438\u043C\u0430\u0022,ko:\u0022Installing Offline Mode\u0022},Gye={en:\u0022Updating Game Data\u0022,fr:\u0022Mise \u00E0 Jour des Donn\u00E9es de Jeu\u0022,es:\u0022Actualizando Datos del Juego\u0022,cn:\u0022\u66F4\u65B0\u6E38\u620F\u6570\u636E\u0022,it:\u0022Aggiornamento dati di gioco\u0022,de:\u0022Aktualisiere Spieldaten\u0022,ja:\u0022\u30B2\u30FC\u30E0\u30C7\u30FC\u30BF\u3092\u66F4\u65B0\u4E2D\u0022,pl:\u0022Aktualizowanie danych gry\u0022,pt:\u0022Atualizando Dados do Jogo\u0022,hr:\u0022A\u017Euriranje podataka igre...\u0022,cz:\u0022Updating Game Data\u0022,sk:\u0022Updating Game Data\u0022,gr:\u0022\u0395\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u0394\u03B5\u03B4\u03BF\u03BC\u03AD\u03BD\u03C9\u03BD \u03A0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u0430\u043D\u043D\u044B\u0445 \u0438\u0433\u0440\u044B\u0022,ko:\u0022Updating Game Data\u0022},Vye={en:\u0022Installing: {0}\u0022,fr:\u0022Installation : {0}\u0022,es:\u0022Instalando: {0}\u0022,cn:\u0022\u6B63\u5728\u5B89\u88C5\uFF1A{0}\u0022,it:\u0022Installazione: {0}\u0022,de:\u0022Installiere: {0}\u0022,ja:\u0022Installing: {0}\u0022,pl:\u0022Instalowanie: {0}\u0022,pt:\u0022Instalando: {0}\u0022,hr:\u0022Instaliranje...\u0022,cz:\u0022Installing: {0}\u0022,sk:\u0022Installing: {0}\u0022,gr:\u0022\u0395\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7: {0}\u0022,ru:\u0022\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430: {0}\u0022,ko:\u0022Installing: {0}\u0022},Wye={en:\u0022Installed: {0}\u0022,fr:\u0022Install\u00E9 : {0}\u0022,es:\u0022Instalado: {0}\u0022,cn:\u0022\u5DF2\u5B89\u88C5\uFF1A{0}\u0022,it:\u0022Installato: {0}\u0022,de:\u0022Installiert: {0}\u0022,ja:\u0022\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u6E08\u307F: {0}\u0022,pl:\u0022Zainstalowano: {0}\u0022,pt:\u0022Instalado: {0}\u0022,hr:\u0022Instalirano\u0022,cz:\u0022Installed: {0}\u0022,sk:\u0022Installed: {0}\u0022,gr:\u0022\u0395\u03B3\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AC\u03B8\u03B7\u03BA\u03B5: {0}\u0022,ru:\u0022\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E: {0}\u0022,ko:\u0022Installed: {0}\u0022},Yye={en:\u0022How to use New Recruit offline?\u0022,fr:\u0022Comment utiliser New Recruit hors ligne ?\u0022,es:\u0022\u00BFC\u00F3mo usar New Recruit sin conexi\u00F3n?\u0022,cn:\u0022\u5982\u4F55\u79BB\u7EBF\u4F7F\u7528 New Recruit\uFF1F\u0022,it:\u0022Come usare New Recruit offline?\u0022,de:\u0022Wie verwendet man New Recruit offline?\u0022,ja:\u0022New Recruit\u3092\u30AA\u30D5\u30E9\u30A4\u30F3\u3067\u4F7F\u7528\u3059\u308B\u306B\u306F\uFF1F\u0022,pl:\u0022Jak u\u017Cywa\u0107 New Recruit w trybie offline?\u0022,pt:\u0022Como usar o New Recruit offline?\u0022,hr:\u0022Kako koristiti izvan mre\u017Ee?\u0022,cz:\u0022How to use New Recruit offline?\u0022,sk:\u0022How to use New Recruit offline?\u0022,gr:\u0022\u03A0\u03CE\u03C2 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF New Recruit \u03B5\u03BA\u03C4\u03CC\u03C2 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u03C2;\u0022,ru:\u0022\u041A\u0430\u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C New Recruit \u0432 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435\u0022,ko:\u0022How to use New Recruit offline?\u0022},Kye={en:\u0022After this installation is done, you may use New Recruit offline, using one of the following methods:\u0022,fr:\u0022Une fois cette installation termin\u00E9e, vous pourrez utiliser New Recruit hors ligne, en utilisant l\u0027une des m\u00E9thodes suivantes :\u0022,es:\u0022Despu\u00E9s de completar esta instalaci\u00F3n, puede usar New Recruit sin conexi\u00F3n, utilizando uno de los siguientes m\u00E9todos:\u0022,cn:\u0022\u5B89\u88C5\u5B8C\u6210\u540E\uFF0C\u60A8\u53EF\u4EE5\u4F7F\u7528\u4EE5\u4E0B\u65B9\u6CD5\u4E4B\u4E00\u79BB\u7EBF\u4F7F\u7528 New Recruit\uFF1A\u0022,it:\u0022Dopo aver completato l\u0027installazione, puoi utilizzare New Recruit offline, utilizzando uno dei seguenti metodi:\u0022,de:\u0022Nach Abschluss dieser Installation k\u00F6nnen Sie New Recruit offline verwenden, indem Sie eine der folgenden Methoden verwenden:\u0022,ja:\u0022\u3053\u306E\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u304C\u5B8C\u4E86\u3059\u308B\u3068\u3001\u4EE5\u4E0B\u306E\u3044\u305A\u308C\u304B\u306E\u65B9\u6CD5\u3067New Recruit\u3092\u30AA\u30D5\u30E9\u30A4\u30F3\u3067\u4F7F\u7528\u3067\u304D\u307E\u3059\uFF1A\u0022,pl:\u0022Po zako\u0144czeniu instalacji mo\u017Cesz u\u017Cywa\u0107 New Recruit w trybie offline, korzystaj\u0105c z jednej z nast\u0119puj\u0105cych metod:\u0022,pt:\u0022Ap\u00F3s a conclus\u00E3o desta instala\u00E7\u00E3o, voc\u00EA poder\u00E1 usar o New Recruit offline, usando um dos seguintes m\u00E9todos:\u0022,hr:\u0022Da biste koristili New Recruit izvan mre\u017Ee:\u0022,cz:\u0022After this installation is done, you may use New Recruit offline, using one of the following methods:\u0022,sk:\u0022After this installation is done, you may use New Recruit offline, using one of the following methods:\u0022,gr:\u0022\u0391\u03C6\u03BF\u03CD \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03B8\u03B5\u03AF \u03B1\u03C5\u03C4\u03AE \u03B7 \u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7, \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF New Recruit \u03B5\u03BA\u03C4\u03CC\u03C2 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u03C2, \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03CE\u03BD\u03C4\u03B1\u03C2 \u03BC\u03AF\u03B1 \u03B1\u03C0\u03CC \u03C4\u03B9\u03C2 \u03B1\u03BA\u03CC\u03BB\u03BF\u03C5\u03B8\u03B5\u03C2 \u03BC\u03B5\u03B8\u03CC\u03B4\u03BF\u03C5\u03C2:\u0022,ru:\u0022\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E\u0433\u043E \u0440\u0435\u0436\u0438\u043C\u0430\u0022,ko:\u0022After this installation is done, you may use New Recruit offline, using one of the following methods:\u0022},qye={en:\u0022Open your web browser and go to https://www.newrecruit.eu/app/, you can add this URL to your bookmarks. This page will work even if you do not have an internet connection.\u0022,fr:\u0022Ouvrez votre navigateur web et allez sur https://www.newrecruit.eu/app/, vous pouvez ajouter cette URL \u00E0 vos favoris. Cette page fonctionnera m\u00EAme si vous n\u0027avez pas de connexion internet.\u0022,es:\u0022Abra su navegador web y vaya a https://www.newrecruit.eu/app/, puede agregar esta URL a sus marcadores. Esta p\u00E1gina funcionar\u00E1 incluso si no tiene conexi\u00F3n a internet.\u0022,cn:\u0022\u6253\u5F00\u60A8\u7684\u7F51\u7EDC\u6D4F\u89C8\u5668\u5E76\u8BBF\u95EE https://www.newrecruit.eu/app/\uFF0C\u60A8\u53EF\u4EE5\u5C06\u6B64 URL \u6DFB\u52A0\u5230\u60A8\u7684\u4E66\u7B7E\u4E2D\u3002\u5373\u4F7F\u60A8\u6CA1\u6709\u4E92\u8054\u7F51\u8FDE\u63A5\uFF0C\u6B64\u9875\u9762\u4E5F\u4F1A\u6B63\u5E38\u5DE5\u4F5C\u3002\u0022,it:\u0022Apri il tuo browser web e vai su https://www.newrecruit.eu/app/, puoi aggiungere questo URL ai tuoi segnalibri. Questa pagina funzioner\u00E0 anche se non hai una connessione internet.\u0022,de:\u0022\u00D6ffnen Sie Ihren Webbrowser und gehen Sie zu https://www.newrecruit.eu/app/, Sie k\u00F6nnen diese URL zu Ihren Lesezeichen hinzuf\u00FCgen. Diese Seite funktioniert auch ohne Internetverbindung.\u0022,ja:\u0022Web\u30D6\u30E9\u30A6\u30B6\u3092\u958B\u304D\u3001https://www.newrecruit.eu/app/ \u306B\u30A2\u30AF\u30BB\u30B9\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u3053\u306EURL\u3092\u30D6\u30C3\u30AF\u30DE\u30FC\u30AF\u306B\u8FFD\u52A0\u3067\u304D\u307E\u3059\u3002\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u63A5\u7D9A\u304C\u306A\u304F\u3066\u3082\u3001\u3053\u306E\u30DA\u30FC\u30B8\u306F\u52D5\u4F5C\u3057\u307E\u3059\u3002\u0022,pl:\u0022Otw\u00F3rz przegl\u0105dark\u0119 internetow\u0105 i przejd\u017A do https://www.newrecruit.eu/app/, mo\u017Cesz doda\u0107 ten adres URL do swoich zak\u0142adek. Ta strona b\u0119dzie dzia\u0142a\u0107 nawet je\u015Bli nie masz po\u0142\u0105czenia z internetem.\u0022,pt:\u0022Abra seu navegador da web e v\u00E1 para https://www.newrecruit.eu/app/, voc\u00EA pode adicionar esta URL aos seus favoritos. Esta p\u00E1gina funcionar\u00E1 mesmo sem conex\u00E3o com a internet.\u0022,hr:\u00221. Kliknite \u0027Instaliraj izvan mre\u017Ee\u0027 za svaku igru koju \u017Eelite\u0022,cz:\u0022Open your web browser and go to https://www.newrecruit.eu/app/, you can add this URL to your bookmarks. This page will work even if you do not have an internet connection.\u0022,sk:\u0022Open your web browser and go to https://www.newrecruit.eu/app/, you can add this URL to your bookmarks. This page will work even if you do not have an internet connection.\u0022,gr:\u0022\u0391\u03BD\u03BF\u03AF\u03BE\u03C4\u03B5 \u03C4\u03BF \u03C0\u03C1\u03CC\u03B3\u03C1\u03B1\u03BC\u03BC\u03B1 \u03C0\u03B5\u03C1\u03B9\u03AE\u03B3\u03B7\u03C3\u03B7\u03C2 \u03B9\u03C3\u03C4\u03BF\u03CD \u03C3\u03B1\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03B2\u03B5\u03AF\u03C4\u03B5 \u03C3\u03C4\u03BF https://www.newrecruit.eu/app/, \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C3\u03B8\u03AD\u03C3\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7 URL \u03C3\u03C4\u03BF\u03C5\u03C2 \u03C3\u03B5\u03BB\u03B9\u03B4\u03BF\u03B4\u03B5\u03AF\u03BA\u03C4\u03B5\u03C2 \u03C3\u03B1\u03C2. \u0391\u03C5\u03C4\u03AE \u03B7 \u03C3\u03B5\u03BB\u03AF\u03B4\u03B1 \u03B8\u03B1 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03B1\u03BA\u03CC\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03BD \u03B4\u03B5\u03BD \u03AD\u03C7\u03B5\u03C4\u03B5 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03C3\u03C4\u03BF \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03C4\u03C5\u03BF.\u0022,ru:\u0022\u041C\u0435\u0442\u043E\u0434 1: \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0434\u0435\u0441\u043A\u0442\u043E\u043F\u043D\u043E\u0435 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u0022,ko:\u0022Open your web browser and go to https://www.newrecruit.eu/app/, you can add this URL to your bookmarks. This page will work even if you do not have an internet connection.\u0022},Jye={en:\u0022Install New Recruit from the \u205D menu of your web browser. This usually works on phones but may work on other devices.\u0022,fr:\u0022Installez New Recruit depuis le menu \u205D de votre navigateur web. Cela fonctionne g\u00E9n\u00E9ralement sur les t\u00E9l\u00E9phones mais peut fonctionner sur d\u0027autres appareils.\u0022,es:\u0022Instale New Recruit desde el men\u00FA \u205D de su navegador web. Esto generalmente funciona en tel\u00E9fonos pero puede funcionar en otros dispositivos.\u0022,cn:\u0022\u4ECE\u60A8\u7684\u7F51\u7EDC\u6D4F\u89C8\u5668\u7684 \u205D \u83DC\u5355\u5B89\u88C5 New Recruit\u3002\u8FD9\u901A\u5E38\u5728\u624B\u673A\u4E0A\u6709\u6548\uFF0C\u4F46\u4E5F\u53EF\u80FD\u5728\u5176\u4ED6\u8BBE\u5907\u4E0A\u6709\u6548\u3002\u0022,it:\u0022Installa New Recruit dal menu \u205D del tuo browser web. Questo funziona solitamente su telefoni ma potrebbe funzionare su altri dispositivi.\u0022,de:\u0022Installieren Sie New Recruit \u00FCber das \u205D Men\u00FC Ihres Webbrowsers. Dies funktioniert normalerweise auf Smartphones, kann aber auch auf anderen Ger\u00E4ten funktionieren.\u0022,ja:\u0022Web\u30D6\u30E9\u30A6\u30B6\u306E \u205D \u30E1\u30CB\u30E5\u30FC\u304B\u3089New Recruit\u3092\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u901A\u5E38\u306F\u30B9\u30DE\u30FC\u30C8\u30D5\u30A9\u30F3\u3067\u52D5\u4F5C\u3057\u307E\u3059\u304C\u3001\u4ED6\u306E\u30C7\u30D0\u30A4\u30B9\u3067\u3082\u52D5\u4F5C\u3059\u308B\u5834\u5408\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Zainstaluj New Recruit z menu \u205D przegl\u0105darki internetowej. Zwykle dzia\u0142a na telefonach, ale mo\u017Ce dzia\u0142a\u0107 tak\u017Ce na innych urz\u0105dzeniach.\u0022,pt:\u0022Instale o New Recruit a partir do menu \u205D do seu navegador. Isso geralmente funciona em telefones, mas pode funcionar em outros dispositivos.\u0022,hr:\u00222. Nakon instalacije, mo\u017Eete koristiti New Recruit bez internetske veze\u0022,cz:\u0022Install New Recruit from the \u205D menu of your web browser. This usually works on phones but may work on other devices.\u0022,sk:\u0022Install New Recruit from the \u205D menu of your web browser. This usually works on phones but may work on other devices.\u0022,gr:\u0022\u0395\u03B3\u03BA\u03B1\u03C4\u03B1\u03C3\u03C4\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF New Recruit \u03B1\u03C0\u03CC \u03C4\u03BF \u03BC\u03B5\u03BD\u03BF\u03CD \u205D \u03C4\u03BF\u03C5 \u03C0\u03C1\u03BF\u03B3\u03C1\u03AC\u03BC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C0\u03B5\u03C1\u03B9\u03AE\u03B3\u03B7\u03C3\u03B7\u03C2 \u03B9\u03C3\u03C4\u03BF\u03CD \u03C3\u03B1\u03C2. \u0391\u03C5\u03C4\u03CC \u03C3\u03C5\u03BD\u03AE\u03B8\u03C9\u03C2 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03B5\u03AF \u03C3\u03B5 \u03C4\u03B7\u03BB\u03AD\u03C6\u03C9\u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B5\u03B9 \u03BA\u03B1\u03B9 \u03C3\u03B5 \u03AC\u03BB\u03BB\u03B5\u03C2 \u03C3\u03C5\u03C3\u03BA\u03B5\u03C5\u03AD\u03C2.\u0022,ru:\u0022\u041C\u0435\u0442\u043E\u0434 2: \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0432\u0435\u0431-\u0432\u0435\u0440\u0441\u0438\u044E \u0441 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439 \u0434\u0430\u043D\u043D\u044B\u0445\u0022,ko:\u0022Install New Recruit from the \u205D menu of your web browser. This usually works on phones but may work on other devices.\u0022},$ye={en:\u0022Secure Payment by Stripe\u0022,fr:\u0022Paiement S\u00E9curis\u00E9 par Stripe\u0022,es:\u0022Pago Seguro por Stripe\u0022,cn:\u0022Stripe \u5B89\u5168\u652F\u4ED8\u0022,it:\u0022Pagamento sicuro tramite Stripe\u0022,de:\u0022Sichere Zahlung \u00FCber Stripe\u0022,ja:\u0022Stripe\u306B\u3088\u308B\u5B89\u5168\u306A\u652F\u6255\u3044\u0022,pl:\u0022Bezpieczna p\u0142atno\u015B\u0107 przez Stripe\u0022,pt:\u0022Pagamento Seguro via Stripe\u0022,hr:\u0022Sigurno pla\u0107anje putem Stripe\u0022,cz:\u0022Secure Payment by Stripe\u0022,sk:\u0022Secure Payment by Stripe\u0022,gr:\u0022\u0391\u03C3\u03C6\u03B1\u03BB\u03AE\u03C2 \u03A0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE \u03B1\u03C0\u03CC Stripe\u0022,ru:\u0022\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430\u044F \u043E\u043F\u043B\u0430\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 Stripe\u0022,ko:\u0022Secure Payment by Stripe\u0022},Zye={en:\u0022Use existing payment method\u0022,fr:\u0022Utiliser une m\u00E9thode de paiement existante\u0022,es:\u0022Usar m\u00E9todo de pago existente\u0022,cn:\u0022\u4F7F\u7528\u73B0\u6709\u4ED8\u6B3E\u65B9\u5F0F\u0022,it:\u0022Usa metodo di pagamento esistente\u0022,de:\u0022Vorhandene Zahlungsmethode verwenden\u0022,ja:\u0022\u65E2\u5B58\u306E\u652F\u6255\u3044\u65B9\u6CD5\u3092\u4F7F\u7528\u0022,pl:\u0022U\u017Cyj istniej\u0105cej metody p\u0142atno\u015Bci\u0022,pt:\u0022Usar m\u00E9todo de pagamento existente\u0022,hr:\u0022Koristi postoje\u0107i na\u010Din\u0022,cz:\u0022Use existing payment method\u0022,sk:\u0022Use existing payment method\u0022,gr:\u0022\u03A7\u03C1\u03AE\u03C3\u03B7 \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03C3\u03B1\u03C2 \u03BC\u03B5\u03B8\u03CC\u03B4\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u03C2\u0022,ru:\u0022\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u043F\u043B\u0430\u0442\u044B\u0022,ko:\u0022Use existing payment method\u0022},Xye={en:\u0022Forget {method}\u0022,fr:\u0022Oublier {method}\u0022,es:\u0022Olvidar {method}\u0022,cn:\u0022\u5FD8\u8BB0{method}\u0022,it:\u0022Dimentica {method}\u0022,de:\u0022{method} vergessen\u0022,ja:\u0022{method}\u3092\u524A\u9664\u0022,pl:\u0022Zapomnij {method}\u0022,pt:\u0022Esquecer {method}\u0022,hr:\u0022Zaboravi na\u010Din\u0022,cz:\u0022Forget {method}\u0022,sk:\u0022Forget {method}\u0022,gr:\u0022\u039E\u03AD\u03C7\u03BD\u03B1 {method}\u0022,ru:\u0022\u0417\u0430\u0431\u044B\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u043F\u043B\u0430\u0442\u044B\u0022,ko:\u0022Forget {method}\u0022},ewe={en:\u0022Use new payment method\u0022,fr:\u0022Utiliser une nouvelle m\u00E9thode de paiement\u0022,es:\u0022Usar nuevo m\u00E9todo de pago\u0022,cn:\u0022\u4F7F\u7528\u65B0\u4ED8\u6B3E\u65B9\u5F0F\u0022,it:\u0022Usa nuovo metodo di pagamento\u0022,de:\u0022Neue Zahlungsmethode verwenden\u0022,ja:\u0022\u65B0\u3057\u3044\u652F\u6255\u3044\u65B9\u6CD5\u3092\u4F7F\u7528\u0022,pl:\u0022U\u017Cyj nowej metody p\u0142atno\u015Bci\u0022,pt:\u0022Usar novo m\u00E9todo de pagamento\u0022,hr:\u0022Novi na\u010Din pla\u0107anja\u0022,cz:\u0022Use new payment method\u0022,sk:\u0022Use new payment method\u0022,gr:\u0022\u03A7\u03C1\u03AE\u03C3\u03B7 \u03BD\u03AD\u03B1\u03C2 \u03BC\u03B5\u03B8\u03CC\u03B4\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u03C2\u0022,ru:\u0022Use new \u0421\u043F\u043E\u0441\u043E\