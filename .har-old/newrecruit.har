2\u043E\u0442 \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u043F\u043B\u0430\u0442\u044B?\u0022,{\u0022en\u0022:7871,\u0022fr\u0022:7872,\u0022es\u0022:7873,\u0022cn\u0022:7874,\u0022it\u0022:7875,\u0022de\u0022:7876,\u0022ja\u0022:7877,\u0022pl\u0022:7878,\u0022pt\u0022:7879,\u0022hr\u0022:7880,\u0022cz\u0022:7871,\u0022sk\u0022:7871,\u0022gr\u0022:7881,\u0022ru\u0022:7882,\u0022ko\u0022:7871},\u0022Error removing payment method\u0022,\u0022Erreur lors de la suppression de la m\u00E9thode de paiement\u0022,\u0022Error al eliminar el m\u00E9todo de pago\u0022,\u0022\u79FB\u9664\u4ED8\u6B3E\u65B9\u5F0F\u65F6\u51FA\u9519\u0022,\u0022Errore nella rimozione del metodo di pagamento\u0022,\u0022Fehler beim Entfernen der Zahlungsmethode\u0022,\u0022\u652F\u6255\u3044\u65B9\u6CD5\u306E\u524A\u9664\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\u0022,\u0022B\u0142\u0105d podczas usuwania metody p\u0142atno\u015Bci\u0022,\u0022Erro ao remover m\u00E9todo de pagamento\u0022,\u0022Gre\u0161ka pri zaboravljanju na\u010Dina pla\u0107anja\u0022,\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03C4\u03B7\u03C2 \u03BC\u03B5\u03B8\u03CC\u03B4\u03BF\u03C5 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u03C2\u0022,\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u0430 \u043E\u043F\u043B\u0430\u0442\u044B\u0022,{\u0022en\u0022:7884,\u0022fr\u0022:7885,\u0022es\u0022:7886,\u0022cn\u0022:7887,\u0022it\u0022:7888,\u0022de\u0022:7889,\u0022ja\u0022:7890,\u0022pl\u0022:7891,\u0022pt\u0022:7892,\u0022hr\u0022:7893,\u0022cz\u0022:7884,\u0022sk\u0022:7884,\u0022gr\u0022:7894,\u0022ru\u0022:7895,\u0022ko\u0022:7884},\u0022card\u0022,\u0022carte\u0022,\u0022tarjeta\u0022,\u0022\u5361\u0022,\u0022carta\u0022,\u0022Karte\u0022,\u0022\u30AB\u30FC\u30C9\u0022,\u0022karta\u0022,\u0022cart\u00E3o\u0022,\u0022Kartica\