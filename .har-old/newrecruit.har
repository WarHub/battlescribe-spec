2\u003E\n          \u003Ctd class=\u0022name\u0022\u003E\n            \u003Cspan class=\u0022profile-name\u0022\u003E{{item.name}}\u003C/span\u003E\n            \u003Cspan class=\u0022data\u0022 type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n          \u003C/td\u003E\n        \u003C/if\u003E\n      \u003C/characteristics\u003E\n      \u003Celse\u003E\n        \u003Ctd class=\u0022name\u0022\u003E\n          \u003Cspan class=\u0022profile-name\u0022\u003E{{item.name}}\u003C/span\u003E\n        \u003C/td\u003E\n        \u003Ccharacteristics\u003E \n          \u003Ctd class=\u0022data\u0022 type=\u0022markdown\u0022\u003E{{value}}\u003C/td\u003E \n        \u003C/characteristics\u003E\n      \u003C/else\u003E\n    \u003C/tr\u003E\n  \u003C/items\u003E\n  \u003C/table\u003E\n  \u003C/div\u003E\n\u003C/profiles\u003E\n\u003C/template\u003E\n\u003Cstyle\u003E\n@import url(\u0027https://fonts.googleapis.com/css2?family=Noto\u002BSans:ital,wght@0,100..900;1,100..900\u0026display=swap\u0027);\nol,ul,menu {\n  margin: 0;\n  padding-left: 18px;\n  margin-bottom: -18px;\n}\nth, td {\n  text-align: left;\n  border: 1px solid #32435560;\n  padding: 3px 5px;\n}\nth {\n  font-weight: 700;\n  text-transform: uppercase;\n  background-color: #324355;\n  color: white;\n}\ntable {\n  border-collapse: collapse;\n  width: 100%;\n  padding: 8px;\n  background-color: rgb(238, 238, 240);\n  border: 2px solid #324355;\n  margin-bottom: 12px;\n}\n.name {\n  font-weight: 600;\n}\n.data {\n  font-weight: 400;\n}\n.profile-name:has(\u002B.data)::after {\n  content: \u0022: \u0022;\n}\n.profile-name {\n  white-space: nowrap;\n}\nhtml {\n  font-family: Noto Sans, sans-serif, Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;\n  line-height: 1.5;\n  font-weight: 400;\n  font-size: 13px;\n  color-scheme: light dark;\n  color: #111113;\n  background-color: #fff;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  -webkit-text-size-adjust: 100%;\n}\n* {\n  box-sizing: border-box;\n  print-color-adjust: exact;\n  -webkit-print-color-adjust: exact\n}\nbody { \n  margin: 10px;  \n} \n\u003C/style\u003E\n\u0060,ll=\u0060\u003Ctemplate\u003E\n  \u003Csetting id=\u0022includeModels\u0022 label=\u0022Models\u0022 type=\u0022checkbox\u0022 default=\u0022true\u0022 /\u003E\n  \u003Cset name=\u0022ruleProfiles\u0022 value=\u0022special rule,rule,rules,command\u0022/\u003E\n\n  \u003Cdiv class=\u0022section cards\u0022\u003E\n    \u003Cunits dedupe=\u0022true\u0022\u003E\n      \u003Cif type=\u0022has-profile\u0022 recursive=\u0022true\u0022\u003E\n      \u003Cdiv class=\u0022unit card-wrapper\u0022 type=\u0022card\u0022\u003E\n        \u003Ctable class=\u0022section card movable\u0022\u003E\n          \u003Ctr class=\u0022section card-header\u0022\u003E\n            \u003Ctd\u003E\n              \u003Cspan class=\u0022costs\u0022\u003E\n                \u003Ccosts\u003E\n                  \u003Cspan class=\u0022cost\u0022\u003E\n                    \u003Cspan\u003E{{ value }}\u003C/span\u003E\n                    \u003Cspan\u003E{{ cost.name }}\u003C/span\u003E\n                  \u003C/span\u003E\n                \u003C/costs\u003E\n              \u003C/span\u003E\n              \u003Cif field=\u0022customName\u0022\u003E\n                \u003Cspan class=\u0022custom-name\u0022\u003E{{customName}}\u003C/span\u003E\n              \u003C/if\u003E\n              \u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\n              \u003Cif field=\u0022dupeCount\u0022 type=\u0022\u003E\u0022 value=\u00221\u0022\u003E\n                \u003Cspan class=\u0022count\u0022\u003E{{dupeCount}}\u003C/span\u003E\n              \u003C/if\u003E\n            \u003C/td\u003E\n          \u003C/tr\u003E\n          \u003Ctr if=\u0022settings.includeModels.state\u0022\u003E\n            \u003Ctd\u003E\n              \u003Ctable class=\u0022section card-models group\u0022\u003E\n                \u003Cmodels max=\u00221\u0022\u003E\n                  \u003Ctr class=\u0022header model profile\u0022\u003E\n                    \u003Ctd class=\u0022section cell nowrap header\u0022\u003E\n                      \u003Cspan class=\u0022header name\u0022\u003EModels\u003C/span\u003E\n                    \u003C/td\u003E\n                    \u003Ctd class=\u0022section cell header\u0022\u003E\n                      \u003Cspan class=\u0022header options\u0022\u003EOptions\u003C/span\u003E\n                    \u003C/td\u003E\n                  \u003C/tr\u003E\n                \u003C/models\u003E\n                \u003Cmodels dedupe=\u0022true\u0022\u003E\n                  \u003Ctr class=\u0022model profile\u0022\u003E\n                    \u003Ctd class=\u0022section cell nowrap\u0022\u003E\n                      \u003Cspan class=\u0022count\u0022\u003E{{dupeCount}}\u003C/span\u003Ex\n                      \u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\n                    \u003C/td\u003E\n                    \u003Ctd class=\u0022section cell\u0022\u003E\n                      \u003Cspan class=\u0022options\u0022\u003E\u003Coptions constants=\u0022true\u0022/\u003E\u003C/span\u003E\n                    \u003C/td\u003E\n                  \u003C/tr\u003E\n                \u003C/models\u003E\n              \u003C/table\u003E\n            \u003C/td\u003E\n          \u003C/tr\u003E\n          \u003Centries max=\u00221\u0022 self=\u0022false\u0022\u003E\n          \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n          \u003Ctr class=\u0022section card-units card-row group\u0022\u003E\n            \u003Ctd\u003E\n              \u003Cspan class=\u0022header secondary cell\u0022\u003E\n                \u003Cspan class=\u0022header name\u0022\u003EUnits\u003C/span\u003E\n              \u003C/span\u003E\n              \u003Cdiv class=\u0022secondaries cell\u0022\u003E\n              \u003Cunit.entries self=\u0022false\u0022\u003E\n              \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n                \u003Cspan class=\u0022name\u0022\u003E{{ amount }}x {{ name}}\u003C/span\u003E\n              \u003C/if\u003E\n              \u003C/unit.entries\u003E\n              \u003C/div\u003E\n            \u003C/td\u003E\n          \u003C/tr\u003E\n          \u003C/if\u003E\n          \u003C/entries\u003E\n          \u003Ctr class=\u0022section profile-row profiles group\u0022\u003E\n            \u003Ctd\u003E\n              \u003Cprofiles grouped=\u0022true\u0022 exclude=\u0022{{ruleProfiles}}\u0022\u003E\n                \u003Ctable class=\u0022profile-group group removable\u0022\u003E\n                  \u003Citems max=\u00221\u0022\u003E\n                    \u003Ctr class=\u0022header profile\u0022\u003E\n                      \u003Ctd class=\u0022header name cell\u0022\u003E\n                        \u003Cspan\u003E{{typeName}}\u003C/span\u003E\n                        \u003Cif field=\u0022group\u0022\u003E\n                          ({{group}})\n                        \u003C/if\u003E\n                      \u003C/td\u003E\n                      \u003Ccharacteristics\u003E\n                        \u003Ctd class=\u0022header characteristic small cell data\u0022\u003E\n                          \u003Cspan class=\u0022header value\u0022\u003E{{name}}\u003C/span\u003E\n                        \u003C/td\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n                  \u003C/items\u003E\n                  \u003Citems\u003E\n                    \u003Ctr class=\u0022section profile row removable\u0022\u003E\n                      \u003Ctd class=\u0022name cell\u0022\u003E{{name}}\u003C/td\u003E\n                      \u003Ccharacteristics\u003E\n                        \u003Ctd class=\u0022characteristic small cell data\u0022\u003E\n                          \u003Cspan type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n                        \u003C/td\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n                  \u003C/items\u003E\n                \u003C/table\u003E\n              \u003C/profiles\u003E\n            \u003C/td\u003E\n          \u003C/tr\u003E\n          \u003Ctr class=\u0022section card-rules card-row\u0022\u003E\n            \u003Ctd\u003E\n              \u003Cprofiles include-rules=\u0022true\u0022 grouped=\u0022true\u0022 include=\u0022{{ruleProfiles}}\u0022\u003E\n              \u003Cdiv class=\u0022profiles profile-row profiles group\u0022\u003E\n                \u003Cspan class=\u0022header secondary cell\u0022\u003E\n                  \u003Citems max=\u00221\u0022\u003E\n                  \u003Cspan class=\u0022name nowrap\u0022\u003E{{typeName}}\u003C/span\u003E\n                  \u003C/items\u003E\n                \u003C/span\u003E\n                \u003Cspan class=\u0022secondaries cell\u0022\u003E\n                  \u003Citems\u003E\u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\u003C/items\u003E\n                \u003C/span\u003E\n              \u003C/div\u003E\n              \u003C/profiles\u003E\n            \u003C/td\u003E\n          \u003C/tr\u003E\n          \u003Ctr class=\u0022section card-keywords card-row group\u0022\u003E\n            \u003Ctd\u003E\n              \u003Cspan class=\u0022header secondary cell\u0022\u003E\n                \u003Cspan class=\u0022header name\u0022\u003ECategories\u003C/span\u003E\n              \u003C/span\u003E\n              \u003Cdiv class=\u0022secondaries cell\u0022\u003E\n                \u003Csecondaries\u003E\n                  \u003Cspan class=\u0022secondary\u0022\u003E\u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\u003C/span\u003E\n                \u003C/secondaries\u003E\n              \u003C/div\u003E\n            \u003C/td\u003E\n          \u003C/tr\u003E\n        \u003C/table\u003E\n      \u003C/div\u003E\n    \u003C/if\u003E\n    \u003C/units\u003E\n     \u003C!-- Rules --\u003E\n    \u003Cif type=\u0022has-rule\u0022 recursive=\u0022true\u0022\u003E\n      \u003Cor type=\u0022has-profile\u0022 recursive=\u0022true\u0022 value=\u0022{{ruleProfiles}}\u0022 /\u003E\n    \u003Cdiv type=\u0022card\u0022\u003E\n      \u003Cdiv class=\u0022rules\u0022\u003E\n        \u003Cforces\u003E\n          \u003Cif type=\u0022has-rule\u0022\u003E\n            \u003Cdiv class=\u0022force removable\u0022\u003E\u003Cspan class=\u0022force-name\u0022\u003E{{name}}\u003C/span\u003E \u003Cspan class=\u0022force-catalogue\u0022\u003E({{catalogue}})\u003C/span\u003E\n              \u003Crules recursive=\u0022false\u0022\u003E\n              \u003Cdiv class=\u0022rule nested removable\u0022\u003E\n              \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n              \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n              \u003C/div\u003E\n              \u003C/rules\u003E\n            \u003C/div\u003E\n          \u003C/if\u003E\n        \u003C/forces\u003E\n        \u003Crules skip-forces=\u0022true\u0022\u003E\n          \u003Cdiv class=\u0022rule removable\u0022\u003E\n            \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n            \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n          \u003C/div\u003E\n        \u003C/rules\u003E\n        \u003Cprofiles include=\u0022{{ruleProfiles}}\u0022\u003E\n          \u003Cdiv class=\u0022rule removable\u0022\u003E\n            \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n            \u003Ccharacteristics\u003E\n              \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n            \u003C/characteristics\u003E\n          \u003C/div\u003E\n        \u003C/profiles\u003E\n      \u003C/div\u003E\n    \u003C/div\u003E\n    \u003C/if\u003E\n  \u003C/div\u003E\n\u003C/template\u003E\n\u003Cstyle\u003E\n@charset \u0022UTF-8\u0022;\n\ntable,\n.table {\n  border-collapse: collapse;\n}\n\n@font-face {\n  font-family: \u0022Tahoma\u0022;\n  src: url(\u0022/Tahoma.ttf\u0022) format(truetype);\n  font-weight: normal;\n  font-style: normal;\n}\n\n@font-face {\n  font-family: \u0022Tahoma\u0022;\n  src: url(\u0022https://www.newrecruit.eu/TahomaBold.ttf\u0022) format(truetype);\n  font-weight: bold;\n  font-style: normal;\n  font-variant: normal;\n}\n\nhtml {\n  font-family: \u0022Tahoma\u0022;\n  background-color: white;\n  scrollbar-width: thin;\n  scrollbar-color: rgba(0, 0, 0, 0.3) rgba(0, 0, 0, 0);\n  color: rgb(70, 70, 70);\n}\n\n.card .cost,\n.table .cost {\n  margin-left: 6px;\n}\n\n.card .cost-value-0,\n.table .cost-value-0 {\n  display: none;\n}\n\n.cost-type {\n  margin-left: 1px;\n}\n\n.roster-header {\n  text-align: center;\n  margin-left: auto;\n  margin-right: auto;\n}\n\na {\n  text-decoration: none;\n  color: unset;\n}\n\n.force-catalogue {\n  color: gray;\n}\n\n.forces .force {\n  margin-bottom: 20px;\n  -moz-column-break-inside: avoid;\n  break-inside: avoid;\n  -webkit-print-color-adjust: exact;\n  print-color-adjust: exact;\n}\n\n@media not print {\n  .forces .force {\n    margin-left: auto;\n    margin-right: auto;\n  }\n}\n\n.forces .custom-name {\n  font-weight: bold;\n}\n\n.options\u002B.profile-group {\n  margin-top: 10px;\n}\n\n.options-profiles-group-header,\n.unit-categories-header {\n  font-weight: bold;\n  content: \u0022: \u0022;\n}\n\n.options-profiles-group-header::after,\n.unit-categories-header::after {\n  content: \u0022: \u0022;\n}\n\n.options-profiles-name:not(:last-child)::after {\n  content: \u0022, \u0022;\n  white-space: break-spaces;\n}\n\n.unit-category-name:not(:last-child)::after {\n  content: \u0022, \u0022;\n  white-space: break-spaces;\n}\n\n.options-profiles-name,\n.unit-category-name {\n  display: inline-block;\n}\n\n.section:empty {\n  display: none;\n}\n\n.section.table .costs {\n  margin-left: 4px;\n}\n\n.section.table .cell:not(.header) {\n  text-align: left;\n  vertical-align: middle;\n  padding: 5px;\n  border: 1px solid lightgrey;\n}\n\n.section.table\u003E :nth-child(even) {\n  background-color: rgba(51, 40, 40, 0.05);\n}\n\n.section.table .header.cell {\n  border-bottom: 2px solid black;\n  padding-right: 8px;\n  text-transform: uppercase;\n  font-weight: bold;\n  font-family: \u0022Constantia\u0022;\n}\n\n.section.roster-header .costs {\n  margin-left: 4px;\n}\n\n.section.roster-header .force {\n  display: table;\n}\n\n.section.config .costs {\n  margin-left: 4px;\n}\n\n.section.config .unit::before {\n  content: \u0022\u2022 \u0022;\n}\n\n.section.config .unit .name::after {\n  content: \u0022: \u0022;\n}\n\n.header.cell {\n  background-color: rgba(0, 0, 0, 0.1);\n}\n\n.unit {\n  width: min(1000px, 100%);\n}\n\n.t9aprofile {\n  margin-left: 10px;\n}\n\n.card:before {\n  content: \u0022\u0022;\n  position: absolute;\n  inset: 0;\n  background: lightslategray;\n  clip-path: polygon(0 12px, 12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px), 0 12px, 2px 12.83px, 2px calc(100% - 12px - 0.83px), 12.83px calc(100% - 2px), calc(100% - 12px - 0.83px) calc(100% - 2px), calc(100% - 2px) calc(100% - 12px - 0.83px), calc(100% - 2px) 12.83px, calc(100% - 12px - 0.83px) 2px, 12.83px 2px, 2px 12.83px);\n}\n\n.card {\n  clip-path: polygon(0 12px, 12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px));\n  border-bottom: 2px solid lightslategray;\n  width: 100%;\n}\n\n.card-wrapper {\n  position: relative;\n  margin-left: auto;\n  margin-right: auto;\n  font-size: small;\n  -webkit-print-color-adjust: exact;\n  print-color-adjust: exact;\n  -moz-column-break-inside: avoid;\n  break-inside: avoid;\n  margin-top: 10px;\n  border-collapse: collapse;\n  display: table;\n}\n\n.profile\u003E.cell {\n  padding: 2px;\n  padding-left: 5px;\n  padding-right: 5px;\n}\n\n.profile\u003E.cell:not(.header) {\n  border-left: 1px solid #e5e5e5;\n  border-right: 1px solid #e5e5e5;\n  border-bottom: 1px solid #e5e5e5;\n  border-top: none;\n  /* white-space: break-spaces; */\n}\n\n.profile.header * .cell {\n  white-space: nowrap;\n  border-left: none;\n  border-right: none;\n  border-top: 1px solid slategray;\n  border-bottom: none;\n  /* border-bottom: 1px solid slategray; */\n}\n\n.profiles\u003E :first-child {\n  border-top: none;\n}\n\n.profiles\u003E :first-child\u003E.row {\n  border-top: none;\n}\n\n.profiles\u003E :first-child\u003E.row\u003E.cell {\n  border-top: none;\n}\n\n.row {\n  page-break-inside: avoid;\n}\n\n.card-row {\n  text-align: left;\n}\n\n.card-row .card-models .options::before {\n  content: \u0022: (\u0022;\n}\n\n.card-row .card-models .options::after {\n  content: \u0022)\u0022;\n}\n\n.card-row .card-models .models {\n  padding-bottom: 5px;\n}\n\n.card-row .header.cell {\n  padding: 5px;\n  padding-left: 10px;\n  background-color: rgba(0, 0, 0, 0.1);\n  height: 100%;\n}\n\n.card-row .cell {\n  display: table-cell;\n}\n\n.card-row .cell:not(.header) {\n  border-left: 1px solid lightslategray;\n  vertical-align: middle;\n}\n\n.card-row .cell:not(.header)\u003Espan:not(:last-child)::after {\n  content: \u0022,\u0022;\n}\n\n.card-row .cell:not(.header)\u003E* {\n  margin-left: 5px;\n  display: inline-block;\n}\n\n.card-header {\n  padding: 3px;\n  background-color: slategray;\n  position: relative;\n  text-align: center;\n}\n\n.card-header .count {\n  color: white;\n  position: absolute;\n  right: 15px;\n  font-family: \u0022Georgia\u0022;\n}\n\n.card-header .count::before {\n  content: \u0022x\u0022;\n}\n\n.card-header .name {\n  color: white;\n  text-align: center;\n  text-transform: uppercase;\n  font-family: Arial;\n}\n\n.card-header .custom-name {\n  color: white;\n  font-weight: bold;\n  text-align: center;\n  text-transform: uppercase;\n  font-family: Arial;\n}\n\n.card-header .costs {\n  color: white;\n  position: absolute;\n  text-transform: uppercase;\n  left: 15px;\n}\n\n.card-header .costs .cost-type {\n  margin-left: 3px;\n}\n\n.profile .name {\n  white-space: nowrap;\n}\n\n.group {\n  width: 100%;\n  border-top: 1px solid slategray;\n}\n\n.roster-rules {\n  margin-top: 20px;\n}\n\n.section.roster-rules .rule-name,\n.section.unit-rules .rule-name {\n  margin-top: 5px;\n  font-weight: bold;\n}\n\n.section.roster-rules .rule-text,\n.section.unit-rules .rule-text {\n  white-space: pre-wrap;\n  white-space-collapse: preserve-breaks;\n  text-wrap: wrap;\n}\n\n.section.roster-rules .force-name,\n.section.unit-rules .force-name {\n  font-size: 24px;\n}\n\n.section.unit-rules .header {\n  font-size: 24px;\n  font-weight: bold;\n}\n\n.section.roster-rules .roster-rules-header {\n  font-size: 24px;\n  font-weight: bold;\n}\n\n.section.roster-rules .force {\n  margin-top: 10px;\n}\n\n.nowrap {\n  white-space: nowrap;\n}\n\n.rule-definitions,\n.rule-definition {\n  page-break-inside: avoid;\n  margin-top: 10px;\n}\n\n.page-break-avoid {\n  page-break-inside: avoid;\n}\n\n.on-next-page {\n  page-break-before: always;\n}\n\ntd {\n  padding: 0;\n}\n\n.data {\n  font-size: calc(var(--fontSize, 16px) - 2px) !important;\n}\n\n.data ul {\n  margin: 0;\n  padding: 0;\n  margin-left: 16px;\n  list-style-position: outside;\n  margin-bottom: -16px;\n}\n\n.data li {\n  margin-top: -16px;\n}\n\n.data li:before {\n  content: \u0022\u0022;\n  margin-left: -0.4rem;\n}\n\n.data p {\n  margin: 0;\n  padding: 0;\n  display: inline;\n}\n\n.data del {\n  margin: 0;\n  padding: 0;\n  display: inline;\n}\n\n.note {\n  color: gray;\n  white-space: pre-wrap;\n}\n\n.data * td {\n  border: 1px solid gray;\n  padding: 2px;\n}\n\n.data * th {\n  font-weight: bold;\n}\n\n.rules-block:not(:has(.rule)) {\n  display: none !important;\n}\n.rules {\n    padding: 8px;\n    // background-color: rgb(233, 234, 236);\n    border: 2px solid gray;\n    margin-bottom: 32px;\n}\n.rule:not(:last-child), .force:not(:last-child)  {\n  margin-bottom: 10px;\n}\n.rule-name {\n  white-space: nowrap; \n  font-weight: 700;\n  display: block;\n}\n.rule-name:not(:last-child)::after {\n  content: \u0022: \u0022;\n}\n.rule-desc {\n}\n.force-name {\n  white-space: nowrap; font-weight: 800;\n}\n.force-catalogue {\n  color: gray; font-weight: 500;\n}\n.nested {\n  margin-left: 5px\n}\n\u003C/style\u003E\n\u0060,dl=\u0060\u003Ctemplate\u003E\n  \u003Csetting id=\u0022includeModels\u0022 label=\u0022Models\u0022 type=\u0022checkbox\u0022 default=\u0022true\u0022 /\u003E\n  \u003Cset name=\u0022ruleProfiles\u0022 value=\u0022special rule,rule,rules\u0022 /\u003E\n\n  \u003Cdiv class=\u0022section cards\u0022\u003E\n    \u003Cunits dedupe=\u0022true\u0022\u003E\n      \u003Cif type=\u0022has-profile\u0022 recursive=\u0022true\u0022\u003E\n        \u003Cdiv class=\u0022unit card-wrapper\u0022 type=\u0022card\u0022\u003E\n          \u003Ctable class=\u0022section card movable\u0022\u003E\n            \u003Ctr class=\u0022section card-header\u0022\u003E\n              \u003Ctd\u003E\n                \u003Cspan class=\u0022costs\u0022\u003E\n                  \u003Ccosts\u003E\n                    \u003Cspan class=\u0022cost\u0022\u003E\n                      \u003Cspan\u003E{{ value }}\u003C/span\u003E\n                      \u003Cspan\u003E{{ cost.name }}\u003C/span\u003E\n                    \u003C/span\u003E\n                  \u003C/costs\u003E\n                \u003C/span\u003E\n                \u003Cif field=\u0022customName\u0022\u003E\n                  \u003Cspan class=\u0022custom-name\u0022\u003E{{customName}}\u003C/span\u003E\n                \u003C/if\u003E\n                \u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\n                \u003Cif field=\u0022dupeCount\u0022 type=\u0022\u003E\u0022 value=\u00221\u0022\u003E\n                  \u003Cspan class=\u0022count\u0022\u003E{{dupeCount}}\u003C/span\u003E\n                \u003C/if\u003E\n              \u003C/td\u003E\n            \u003C/tr\u003E\n            \u003Ctr if=\u0022settings.includeModels.state\u0022\u003E\n              \u003Ctd\u003E\n                \u003Ctable class=\u0022section card-models group\u0022\u003E\n                  \u003Cmodels max=\u00221\u0022\u003E\n                    \u003Ctr class=\u0022header model profile\u0022\u003E\n                      \u003Ctd class=\u0022section cell nowrap header\u0022\u003E\n                        \u003Cspan class=\u0022header name\u0022\u003EModels\u003C/span\u003E\n                      \u003C/td\u003E\n                      \u003Ctd class=\u0022section cell header\u0022\u003E\n                        \u003Cspan class=\u0022header options\u0022\u003EOptions\u003C/span\u003E\n                      \u003C/td\u003E\n                    \u003C/tr\u003E\n                  \u003C/models\u003E\n                  \u003Cmodels dedupe=\u0022true\u0022\u003E\n                    \u003Ctr class=\u0022model profile\u0022\u003E\n                      \u003Ctd class=\u0022section cell nowrap\u0022\u003E\n                        \u003Cspan class=\u0022count\u0022\u003E{{dupeCount}}\u003C/span\u003Ex\n                        \u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\n                      \u003C/td\u003E\n                      \u003Ctd class=\u0022section cell\u0022\u003E\n                        \u003Cspan class=\u0022options\u0022\u003E\n                          \u003Coptions constants=\u0022true\u0022 /\u003E\n                        \u003C/span\u003E\n                      \u003C/td\u003E\n                    \u003C/tr\u003E\n                  \u003C/models\u003E\n                \u003C/table\u003E\n              \u003C/td\u003E\n            \u003C/tr\u003E\n            \u003Centries max=\u00221\u0022 self=\u0022false\u0022\u003E\n              \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n                \u003Ctr class=\u0022section card-units card-row group\u0022\u003E\n                  \u003Ctd\u003E\n                    \u003Cspan class=\u0022header secondary cell\u0022\u003E\n                      \u003Cspan class=\u0022header name\u0022\u003EUnits\u003C/span\u003E\n                    \u003C/span\u003E\n                    \u003Cdiv class=\u0022secondaries cell\u0022\u003E\n                      \u003Cunit.entries self=\u0022false\u0022\u003E\n                        \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n                          \u003Cspan class=\u0022name\u0022\u003E{{ amount }}x {{ name}}\u003C/span\u003E\n                        \u003C/if\u003E\n                      \u003C/unit.entries\u003E\n                    \u003C/div\u003E\n                  \u003C/td\u003E\n                \u003C/tr\u003E\n              \u003C/if\u003E\n            \u003C/entries\u003E\n            \u003Ctr class=\u0022section profile-row profiles group\u0022\u003E\n              \u003Ctd\u003E\n                \u003Cprofiles grouped=\u0022true\u0022 exclude=\u0022{{ruleProfiles}}\u0022\u003E\n                  \u003Ctable class=\u0022profile-group group removable\u0022\u003E\n                    \u003Citems max=\u00221\u0022\u003E\n                      \u003Ctr class=\u0022header profile\u0022\u003E\n                        \u003Ctd class=\u0022header name cell\u0022\u003E\n                          \u003Cspan\u003E{{typeName}}\u003C/span\u003E\n                          \u003Cif field=\u0022group\u0022\u003E\n                            ({{group}})\n                          \u003C/if\u003E\n                        \u003C/td\u003E\n                        \u003Ccharacteristics\u003E\n                          \u003Ctd class=\u0022header characteristic small cell data\u0022\u003E\n                            \u003Cspan class=\u0022header value\u0022\u003E{{name}}\u003C/span\u003E\n                          \u003C/td\u003E\n                        \u003C/characteristics\u003E\n                      \u003C/tr\u003E\n                    \u003C/items\u003E\n                    \u003Citems\u003E\n                      \u003Ctr class=\u0022section profile row removable\u0022\u003E\n                        \u003Ctd class=\u0022name cell\u0022\u003E{{name}}\u003C/td\u003E\n                        \u003Ccharacteristics\u003E\n                          \u003Ctd class=\u0022characteristic small cell data\u0022\u003E\n                            \u003Cspan type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n                          \u003C/td\u003E\n                        \u003C/characteristics\u003E\n                      \u003C/tr\u003E\n                    \u003C/items\u003E\n                  \u003C/table\u003E\n                \u003C/profiles\u003E\n              \u003C/td\u003E\n            \u003C/tr\u003E\n            \u003Ctr class=\u0022section card-rules card-row\u0022\u003E\n              \u003Ctd\u003E\n                \u003Cprofiles include-rules=\u0022true\u0022 grouped=\u0022true\u0022 include=\u0022{{ruleProfiles}}\u0022\u003E\n                  \u003Cdiv class=\u0022profiles profile-row profiles group\u0022\u003E\n                    \u003Cspan class=\u0022header secondary cell\u0022\u003E\n                      \u003Citems max=\u00221\u0022\u003E\n                        \u003Cspan class=\u0022name nowrap\u0022\u003E{{typeName}}\u003C/span\u003E\n                      \u003C/items\u003E\n                    \u003C/span\u003E\n                    \u003Cspan class=\u0022secondaries cell\u0022\u003E\n                      \u003Citems\u003E\u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\u003C/items\u003E\n                    \u003C/span\u003E\n                  \u003C/div\u003E\n                \u003C/profiles\u003E\n              \u003C/td\u003E\n            \u003C/tr\u003E\n            \u003Ctr class=\u0022section card-keywords card-row group\u0022\u003E\n              \u003Ctd\u003E\n                \u003Cspan class=\u0022header secondary cell\u0022\u003E\n                  \u003Cspan class=\u0022header name\u0022\u003ECategories\u003C/span\u003E\n                \u003C/span\u003E\n                \u003Cdiv class=\u0022secondaries cell\u0022\u003E\n                  \u003Csecondaries\u003E\n                    \u003Cspan class=\u0022secondary\u0022\u003E\u003Cspan class=\u0022name\u0022\u003E{{name}}\u003C/span\u003E\u003C/span\u003E\n                  \u003C/secondaries\u003E\n                \u003C/div\u003E\n              \u003C/td\u003E\n            \u003C/tr\u003E\n          \u003C/table\u003E\n        \u003C/div\u003E\n      \u003C/if\u003E\n    \u003C/units\u003E\n    \u003C!-- Rules --\u003E\n    \u003Cif type=\u0022has-rule\u0022 recursive=\u0022true\u0022\u003E\n      \u003Cor type=\u0022has-profile\u0022 recursive=\u0022true\u0022 value=\u0022{{ruleProfiles}}\u0022 /\u003E\n      \u003Cdiv type=\u0022card\u0022\u003E\n        \u003Cdiv class=\u0022rules\u0022\u003E\n          \u003Cforces\u003E\n            \u003Cif type=\u0022has-rule\u0022\u003E\n              \u003Cdiv class=\u0022force removable\u0022\u003E\u003Cspan class=\u0022force-name\u0022\u003E{{name}}\u003C/span\u003E \u003Cspan class=\u0022force-catalogue\u0022\u003E({{catalogue}})\u003C/span\u003E\n                \u003Crules recursive=\u0022false\u0022\u003E\n                  \u003Cdiv class=\u0022rule nested removable\u0022\u003E\n                    \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n                    \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n                  \u003C/div\u003E\n                \u003C/rules\u003E\n              \u003C/div\u003E\n            \u003C/if\u003E\n          \u003C/forces\u003E\n          \u003Crules skip-forces=\u0022true\u0022\u003E\n            \u003Cdiv class=\u0022rule removable\u0022\u003E\n              \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n              \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n            \u003C/div\u003E\n          \u003C/rules\u003E\n          \u003Cprofiles include=\u0022{{ruleProfiles}}\u0022\u003E\n            \u003Cdiv class=\u0022rule removable\u0022\u003E\n              \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n              \u003Ccharacteristics\u003E\n                \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n              \u003C/characteristics\u003E\n            \u003C/div\u003E\n          \u003C/profiles\u003E\n        \u003C/div\u003E\n      \u003C/div\u003E\n    \u003C/if\u003E\n  \u003C/div\u003E\n\u003C/template\u003E\n\u003Cstyle\u003E\n  @charset \u0022UTF-8\u0022;\n\n  table,\n  .table {\n    border-collapse: collapse;\n  }\n\n  @font-face {\n    font-family: \u0022Tahoma\u0022;\n    src: url(\u0022/Tahoma.ttf\u0022) format(truetype);\n    font-weight: normal;\n    font-style: normal;\n  }\n\n  @font-face {\n    font-family: \u0022Tahoma\u0022;\n    src: url(\u0022https://www.newrecruit.eu/TahomaBold.ttf\u0022) format(truetype);\n    font-weight: bold;\n    font-style: normal;\n    font-variant: normal;\n  }\n\n  html {\n    font-family: \u0022Tahoma\u0022;\n    background-color: black;\n    scrollbar-width: thin;\n    scrollbar-color: rgba(200, 200, 200, 1) rgba(0, 0, 0, 0.3);\n    color: rgb(255, 255, 255);\n  }\n\n  .card .cost,\n  .table .cost {\n    margin-left: 6px;\n  }\n\n  .card .cost-value-0,\n  .table .cost-value-0 {\n    display: none;\n  }\n\n  .cost-type {\n    margin-left: 1px;\n  }\n\n  .roster-header {\n    text-align: center;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  a {\n    text-decoration: none;\n    color: unset;\n  }\n\n  .force-catalogue {\n    color: gray;\n  }\n\n  .forces .force {\n    margin-bottom: 20px;\n    -moz-column-break-inside: avoid;\n    break-inside: avoid;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  @media not print {\n    .forces .force {\n      margin-left: auto;\n      margin-right: auto;\n    }\n  }\n\n  .forces .custom-name {\n    font-weight: bold;\n  }\n\n  .options\u002B.profile-group {\n    margin-top: 10px;\n  }\n\n  .options-profiles-group-header,\n  .unit-categories-header {\n    font-weight: bold;\n    content: \u0022: \u0022;\n  }\n\n  .options-profiles-group-header::after,\n  .unit-categories-header::after {\n    content: \u0022: \u0022;\n  }\n\n  .options-profiles-name:not(:last-child)::after {\n    content: \u0022, \u0022;\n    white-space: break-spaces;\n  }\n\n  .unit-category-name:not(:last-child)::after {\n    content: \u0022, \u0022;\n    white-space: break-spaces;\n  }\n\n  .options-profiles-name,\n  .unit-category-name {\n    display: inline-block;\n  }\n\n  .section:empty {\n    display: none;\n  }\n\n  .section.table .costs {\n    margin-left: 4px;\n  }\n\n  .section.table .cell:not(.header) {\n    text-align: left;\n    vertical-align: middle;\n    padding: 5px;\n    border: 1px solid lightgrey;\n  }\n\n  .section.table\u003E :nth-child(even) {\n    background-color: rgba(51, 40, 40, 0.05);\n  }\n\n  .section.table .header.cell {\n    border-bottom: 2px solid black;\n    padding-right: 8px;\n    text-transform: uppercase;\n    font-weight: bold;\n    font-family: \u0022Constantia\u0022;\n  }\n\n  .section.roster-header .costs {\n    margin-left: 4px;\n  }\n\n  .section.roster-header .force {\n    display: table;\n  }\n\n  .section.config .costs {\n    margin-left: 4px;\n  }\n\n  .section.config .unit::before {\n    content: \u0022\u2022 \u0022;\n  }\n\n  .section.config .unit .name::after {\n    content: \u0022: \u0022;\n  }\n\n  .header.cell {\n    background-color: rgba(70, 70, 70, 1);\n  }\n\n  .unit {\n    width: min(1000px, 100%);\n  }\n\n  .t9aprofile {\n    margin-left: 10px;\n  }\n\n  .card:before {\n    content: \u0022\u0022;\n    position: absolute;\n    inset: 0;\n    background: rgba(0, 60, 80, 1);\n    clip-path: polygon(0 12px, 12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px), 0 12px, 2px 12.83px, 2px calc(100% - 12px - 0.83px), 12.83px calc(100% - 2px), calc(100% - 12px - 0.83px) calc(100% - 2px), calc(100% - 2px) calc(100% - 12px - 0.83px), calc(100% - 2px) 12.83px, calc(100% - 12px - 0.83px) 2px, 12.83px 2px, 2px 12.83px);\n  }\n\n  .card {\n    clip-path: polygon(0 12px, 12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px));\n    border-bottom: 2px solid rgba(0, 60, 80, 1);\n    width: 100%;\n  }\n\n  .card-wrapper {\n    position: relative;\n    margin-left: auto;\n    margin-right: auto;\n    font-size: 18px;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n    -moz-column-break-inside: avoid;\n    break-inside: avoid;\n    margin-top: 10px;\n    border-collapse: collapse;\n    display: table;\n  }\n\n  .profile\u003E.cell {\n    padding: 2px;\n    padding-left: 5px;\n    padding-right: 5px;\n  }\n\n  .profile\u003E.cell:not(.header) {\n    border-left: 1px solid rgba(0, 60, 80, 1);\n    border-right: 1px solid rgba(0, 60, 80, 1);\n    border-bottom: 1px solid rgba(0, 60, 80, 1);\n    border-top: none;\n    /* white-space: break-spaces; */\n  }\n\n  .profile.header * .cell {\n    white-space: nowrap;\n    border-left: none;\n    border-right: none;\n    border-top: 1px solid slategray;\n    border-bottom: none;\n    /* border-bottom: 1px solid slategray; */\n  }\n\n  .profiles\u003E :first-child {\n    border-top: none;\n  }\n\n  .profiles\u003E :first-child\u003E.row {\n    border-top: none;\n  }\n\n  .profiles\u003E :first-child\u003E.row\u003E.cell {\n    border-top: none;\n  }\n\n  .row {\n    page-break-inside: avoid;\n  }\n\n  .card-row {\n    text-align: left;\n  }\n\n  .card-row .card-models .options::before {\n    content: \u0022: (\u0022;\n  }\n\n  .card-row .card-models .options::after {\n    content: \u0022)\u0022;\n  }\n\n  .card-row .card-models .models {\n    padding-bottom: 5px;\n  }\n\n  .card-row .header.cell {\n    padding: 5px;\n    padding-left: 10px;\n    background-color: rgba(70, 70, 70, 1);\n    height: 100%;\n  }\n\n  .card-row .cell {\n    display: table-cell;\n  }\n\n  .card-row .cell:not(.header) {\n    border-left: 1px solid rgba(0, 60, 80, 1);\n    vertical-align: middle;\n  }\n\n  .card-row .cell:not(.header)\u003Espan:not(:last-child)::after {\n    content: \u0022,\u0022;\n  }\n\n  .card-row .cell:not(.header)\u003E* {\n    margin-left: 5px;\n    display: inline-block;\n  }\n\n  .card-header {\n    padding: 3px;\n    background-color: rgba(0, 60, 80, 1);\n    position: relative;\n    text-align: center;\n  }\n\n  .card-header .count {\n    color: white;\n    position: absolute;\n    right: 15px;\n    font-family: \u0022Georgia\u0022;\n  }\n\n  .card-header .count::before {\n    content: \u0022x\u0022;\n  }\n\n  .card-header .name {\n    color: white;\n    text-align: center;\n    text-transform: uppercase;\n    font-family: Arial;\n  }\n\n  .card-header .custom-name {\n    color: white;\n    font-weight: bold;\n    text-align: center;\n    text-transform: uppercase;\n    font-family: Arial;\n  }\n\n  .card-header .costs {\n    color: white;\n    position: absolute;\n    text-transform: uppercase;\n    left: 15px;\n  }\n\n  .card-header .costs .cost-type {\n    margin-left: 3px;\n  }\n\n  .profile .name {\n    white-space: nowrap;\n  }\n\n  .group {\n    width: 100%;\n    border-top: 1px solid rgba(0, 60, 80, 1);\n  }\n\n  .roster-rules {\n    margin-top: 20px;\n  }\n\n  .section.roster-rules .rule-name,\n  .section.unit-rules .rule-name {\n    margin-top: 5px;\n    font-weight: bold;\n  }\n\n  .section.roster-rules .rule-text,\n  .section.unit-rules .rule-text {\n    white-space: pre-wrap;\n    white-space-collapse: preserve-breaks;\n    text-wrap: wrap;\n  }\n\n  .section.roster-rules .force-name,\n  .section.unit-rules .force-name {\n    font-size: 24px;\n  }\n\n  .section.unit-rules .header {\n    font-size: 24px;\n    font-weight: bold;\n  }\n\n  .section.roster-rules .roster-rules-header {\n    font-size: 24px;\n    font-weight: bold;\n  }\n\n  .section.roster-rules .force {\n    margin-top: 10px;\n  }\n\n  .nowrap {\n    white-space: nowrap;\n  }\n\n  .rule-definitions,\n  .rule-definition {\n    page-break-inside: avoid;\n    margin-top: 10px;\n  }\n\n  .page-break-avoid {\n    page-break-inside: avoid;\n  }\n\n  .on-next-page {\n    page-break-before: always;\n  }\n\n  td {\n    padding: 0;\n  }\n\n  .data {\n    font-size: calc(var(--fontSize, 20px) - 2px) !important;\n  }\n\n  .data ul {\n    margin: 0;\n    padding: 0;\n    margin-left: 16px;\n    list-style-position: outside;\n    margin-bottom: -16px;\n  }\n\n  .data li {\n    margin-top: -16px;\n  }\n\n  .data li:before {\n    content: \u0022\u0022;\n    margin-left: -0.4rem;\n  }\n\n  .data p {\n    margin: 0;\n    padding: 0;\n    display: inline;\n  }\n\n  .data del {\n    margin: 0;\n    padding: 0;\n    display: inline;\n  }\n\n  .note {\n    color: gray;\n    white-space: pre-wrap;\n  }\n\n  .data * td {\n    border: 1px solid gray;\n    padding: 2px;\n  }\n\n  .data * th {\n    font-weight: bold;\n  }\n\n  .rules-block:not(:has(.rule)) {\n    display: none !important;\n  }\n\n  .rules {\n    padding: 8px;\n    border: 2px solid rgba(0, 60, 80, 1);\n\n    margin-bottom: 32px;\n  }\n\n  .rule:not(:last-child),\n  .force:not(:last-child) {\n    margin-bottom: 10px;\n  }\n\n  .rule-name {\n\n    white-space: nowrap;\n    font-weight: 700;\n    display: block;\n  }\n\n  .rule-name:not(:last-child)::after {\n    content: \u0022: \u0022;\n  }\n\n  .force-name {\n    white-space: nowrap;\n    font-weight: 800;\n  }\n\n  .force-catalogue {\n    color: gray;\n    font-weight: 500;\n  }\n\n  .nested {\n    margin-left: 5px\n  }\n\u003C/style\u003E\u0060,ul=\u0060\u003Ctemplate\u003E\n  \u003Csetting id=\u0022titleBackgroundGraphics\u0022 label=\u0022Title Background Graphics\u0022 type=\u0022checkbox\u0022 default=\u0022true\u0022 /\u003E\n  \u003Csetting id=\u0022cardBackgroundGraphics\u0022 label=\u0022Card Background Graphics\u0022 type=\u0022checkbox\u0022 default=\u0022true\u0022 /\u003E\n  \u003Csetting id=\u0022customWarscrollNames\u0022 label=\u0022Original warscroll names (when using Custom Names)\u0022 type=\u0022checkbox\u0022 default=\u0022false\u0022 /\u003E\n  \u003Cunits dedupe=\u0022true\u0022\u003E\n    \u003Centries\u003E\n      \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n        \u003Cor field=\u0022name\u0022 type=\u0022match\u0022 value=\u0022^(.\u002B Lore|Battle Traits.\u002B?|Battle Tactic Cards|Arcane Tome|Campaign Progress|Honour Guard|Battle Formation|Emberstone Vault|Regiment of Renown.\u002B?)*$\u0022 /\u003E\n        \u003Cdiv class=\u0022avoid-page-break\u0022 type=\u0022card\u0022 catalogue=\u0022{{catalogue}}\u0022\u003E\n          \u003Cdiv class=\u0022card\u0022\u003E\n            \u003Cif field=\u0022settings.cardBackgroundGraphics.state\u0022 type=\u0022equals\u0022 value=\u0022true\u0022\u003E\n              \u003Cappend-attribute name=\u0022class\u0022 value=\u0022bg\u0022 /\u003E\n            \u003C/if\u003E\n            \u003Cdiv class=\u0022card-header\u0022\u003E\n              \u003Cif field=\u0022name\u0022 type=\u0022match\u0022 value=\u0022^(.\u002B Lore|Battle Traits.\u002B?|Battle Tactic Cards|Arcane Tome|Campaign Progress|Honour Guard|Battle Formation|Emberstone Vault|Regiment of Renown.\u002B?)*$\u0022\u003E\n                \u003Cspan class=\u0022section-header\u0022\u003E{{name}}\u003C/span\u003E\n              \u003C/if\u003E\n              \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n                \u003Centries\u003E\n                  \u003Cif type=\u0022has-profile\u0022 value=\u0022model,unit,stats,manifestation\u0022\u003E\n                    \u003Csecondaries\u003E\n                      \u003Cif field=\u0022name\u0022 type=\u0022match\u0022 value=\u0022^WARD \\\\((\\\\d\\\\\u002B)\\\\)$\u0022\u003E\n                        \u003Cset name=\u0022wardValue\u0022 value=\u0022{{name}}\u0022 fn=\u0022match\u0022 regex1=\u0022.?(\\\\d\\\\\u002B).\u0022 index=\u00221\u0022 /\u003E\n                        \u003Cdiv class=\u0022ward\u0022\u003E\n                          \u003Cspan\u003E{{wardValue}}\u003C/span\u003E\n                        \u003C/div\u003E\n                      \u003C/if\u003E\n                    \u003C/secondaries\u003E\n                    \u003Cprofiles include=\u0022model,unit,stats,manifestation\u0022 recursive=\u0022false\u0022\u003E\n                      \u003Cdiv class=\u0022statWheel\u0022\u003E\n                        \u003Cdiv class=\u0022statWheelStats\u0022\u003E\n                          \u003Ccharacteristics\u003E\n                            \u003Cdiv class=\u0022statwheelEntry\u0022\u003E\n                              \u003Cdiv class=\u0022statLabel\u0022\u003E\n                                \u003Csvg\u003E\n                                  \u003Ctext\u003E\n                                    \u003Cif field=\u0022last\u0022 type=\u0022match\u0022 value=\u0022true\u0022\u003E\n                                      \u003CtextPath href=\u0022#circlePathReversed\u0022 startOffset=\u002250%\u0022\u003E{{name}}\u003C/textPath\u003E\n                                    \u003C/if\u003E\n                                    \u003Celse\u003E\n                                      \u003CtextPath href=\u0022#circlePath\u0022 startOffset=\u002250%\u0022\u003E{{name}}\u003C/textPath\u003E\n                                    \u003C/else\u003E\n                                  \u003C/text\u003E\n                                \u003C/svg\u003E\n                              \u003C/div\u003E\n                              \u003Cdiv class=\u0022stat\u0022\u003E{{$text}}\u003C/div\u003E\n                            \u003C/div\u003E\n                          \u003C/characteristics\u003E\n                        \u003C/div\u003E\n                      \u003C/div\u003E\n                    \u003C/profiles\u003E\n                    \u003Cdiv class=\u0022titleWrap\u0022\u003E\n                      \u003Cdiv class=\u0022titleCard\u0022\u003E\n                        \u003Cdiv class=\u0022title\u0022\u003E\n                          \u003Cif field=\u0022customName\u0022\u003E{{customName}}\n                            \u003Cif field=\u0022settings.customWarscrollNames.state\u0022 type=\u0022equals\u0022 value=\u0022true\u0022\u003E\n                              \u003Cdiv class=\u0022subtitle\u0022\u003E{{name}}\u003C/div\u003E\n                            \u003C/if\u003E\n                          \u003C/if\u003E\n                          \u003Celse\u003E{{name}}\u003C/else\u003E\n                        \u003C/div\u003E\n                      \u003C/div\u003E\n                    \u003C/div\u003E\n                  \u003C/if\u003E\n                \u003C/entries\u003E\n              \u003C/if\u003E\n            \u003C/div\u003E\n            \u003C!-- Rules --\u003E\n            \u003Cif type=\u0022has-rule\u0022 recursive=\u0022true\u0022\u003E\n              \u003Cdiv class=\u0022rules\u0022\u003E\n                \u003Cforces\u003E\n                  \u003Cif type=\u0022has-rule\u0022\u003E\n                    \u003Cdiv class=\u0022force\u0022\u003E\n                      \u003Cspan class=\u0022force-name\u0022\u003E{{name}}\u003C/span\u003E\n                      \u003Cspan class=\u0022force-catalogue\u0022\u003E({{catalogue}})\u003C/span\u003E\n                      \u003Crules recursive=\u0022false\u0022\u003E\n                        \u003Cdiv class=\u0022rule nested\u0022\u003E\n                          \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n                          \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n                        \u003C/div\u003E\n                      \u003C/rules\u003E\n                    \u003C/div\u003E\n                  \u003C/if\u003E\n                \u003C/forces\u003E\n                \u003Crules skip-forces=\u0022true\u0022\u003E\n                  \u003Cdiv class=\u0022rule\u0022\u003E\n                    \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n                    \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n                  \u003C/div\u003E\n                \u003C/rules\u003E\n                \u003Cprofiles include=\u0022special rule,rule,rules\u0022\u003E\n                  \u003Cdiv class=\u0022rule\u0022\u003E\n                    \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n                    \u003Ccharacteristics\u003E\n                      \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n                    \u003C/characteristics\u003E\n                  \u003C/div\u003E\n                \u003C/profiles\u003E\n              \u003C/div\u003E\n            \u003C/if\u003E\n            \u003C!--body--\u003E\n            \u003Cif field=\u0022type\u0022 type=\u0022equals\u0022 value=\u0022unit\u0022\u003E\n              \u003Ctable cellspacing=\u00220\u0022 class=\u0022weapons-table\u0022\u003E\n                \u003Cthead\u003E\n                  \u003Cprofiles include=\u0022ranged weapon\u0022 max=\u00221\u0022\u003E\n                    \u003Ctr\u003E\n                      \u003Ctd\u003E\u003Cspan\u003ERanged Weapons\u003C/span\u003E\u003C/td\u003E\n                      \u003Ccharacteristics\u003E\n                        \u003Ctd\u003E\u003Cspan\u003E{{name}}\u003C/span\u003E\u003C/td\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n                  \u003C/profiles\u003E\n                \u003C/thead\u003E\n                \u003Ctbody\u003E\n                  \u003Cprofiles include=\u0022ranged weapon\u0022\u003E\n                    \u003Ctr\u003E\n                      \u003Ctd\u003E\u003Cspan\u003E{{name}}\u003C/span\u003E\u003C/td\u003E\n                      \u003Ccharacteristics include=\u0022rng,atk,hit,wnd,rnd,dmg,ability\u0022\u003E\n                        \u003Ctd\u003E\n                          \u003Cspan type=\u0022markdown\u0022\u003E{{$text}}\u003C/span\u003E\n                        \u003C/td\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n                  \u003C/profiles\u003E\n                \u003C/tbody\u003E\n                \u003Cthead\u003E\n                  \u003Cprofiles include=\u0022melee weapon\u0022 max=\u00221\u0022\u003E\n                    \u003Ctr\u003E\n                      \u003Ctd\u003E\u003Cspan\u003EMelee Weapons\u003C/span\u003E\u003C/td\u003E\n                      \u003Ctd class=\u0022placeholder\u0022 /\u003E\n                      \u003Ccharacteristics\u003E\n                        \u003Ctd\u003E\u003Cspan\u003E{{name}}\u003C/span\u003E\u003C/td\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n                  \u003C/profiles\u003E\n                \u003C/thead\u003E\n                \u003Ctbody\u003E\n                  \u003Cprofiles include=\u0022melee weapon\u0022\u003E\n                    \u003Ctr\u003E\n                      \u003Ctd\u003E\u003Cspan\u003E{{name}}\u003C/span\u003E\u003C/td\u003E\n                      \u003Ctd class=\u0022placeholder\u0022 /\u003E\n                      \u003Ccharacteristics include=\u0022atk,hit,wnd,rnd,dmg,ability\u0022\u003E\n                 