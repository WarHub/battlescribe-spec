but may be optionally added.\u0022,cz:\u0022These profiles are not included in the initially created unit but may be optionally added.\u0022,sk:\u0022These profiles are not included in the initially created unit but may be optionally added.\u0022,gr:\u0022\u03A4\u03B1 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03B1 \u03BC\u03B5 \u03C0\u03BF\u03BB\u03BB\u03B1\u03C0\u03BB\u03AC \u03C0\u03C1\u03BF\u03C6\u03AF\u03BB \u03B4\u03B5\u03BD \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9 \u03B5\u03B4\u03CE \u03B5\u03BA\u03C4\u03CC\u03C2 \u03B5\u03AC\u03BD \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03BF\u03CD\u03BD\u0022,ru:\u0022\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u043D\u0435\u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0444\u0438\u043B\u044F\u0445\u0022,ko:\u0022These profiles are not included in the initially created unit but may be optionally added.\u0022},t2e={en:\u0022Support New Recruit to unlock Unit Profiles!\u0022,fr:\u0022Soutenez New Recruit pour d\u00E9bloquer les Profils d\u0027Unit\u00E9 !\u0022,es:\u0022\u00A1Apoya a New Recruit para desbloquear los Perfiles de Unidad!\u0022,cn:\u0022\u652F\u6301 New Recruit \u89E3\u9501\u5355\u4F4D\u914D\u7F6E\u6587\u4EF6\uFF01\u0022,it:\u0022Supporta New Recruit per sbloccare i Profili Unit\u00E0!\u0022,de:\u0022Support New Recruit to unlock Unit Profiles!\u0022,ja:\u0022New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u30E6\u30CB\u30C3\u30C8\u30D7\u30ED\u30D5\u30A3\u30FC\u30EB\u3092\u30A2\u30F3\u30ED\u30C3\u30AF\uFF01\u0022,pl:\u0022Wesprzyj New Recruit, aby odblokowa\u0107 Profile Jednostek!\u0022,pt:\u0022Apoie o New Recruit para desbloquear os Perfis de Unidade!\u0022,hr:\u0022Support New Recruit to unlock Unit Profiles!\u0022,cz:\u0022Support New Recruit to unlock Unit Profiles!\u0022,sk:\u0022Support New Recruit to unlock Unit Profiles!\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C6\u03AF\u03BB \u03BC\u03BF\u03BD\u03AC\u03B4\u03C9\u03BD \u03C5\u0