nar este juego...\u0022,cn:\u0022\u5220\u9664\u6B64\u6E38\u620F\u65F6\u53D1\u751F\u9519\u8BEF...\u0022,it:\u0022An error occured while deleting this game...\u0022,de:\u0022Beim L\u00F6schen dieses Spiels ist ein Fehler aufgetreten...\u0022,ja:\u0022 \u30A8\u30E9\u30FC occured \u9593 deleting \u3053\u306E \u30B2\u30FC\u30E0...\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d podczas usuwania tej gry...\u0022,pt:\u0022Ocorreu um erro ao excluir este jogo...\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke pri brisanju ove igre...\u0022,cz:\u0022An error occured while deleting this game...\u0022,sk:\u0022An error occured while deleting this game...\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5 \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7 \u03B4\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B1\u03C5\u03C4\u03BF\u03CD \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD...\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0441\u043F\u0438\u0441\u043A\u0430\u0022,ko:\u0022An error occured while deleting this game...\u0022},rke={en:\u0022An error and this game could not be loaded, you may want to delete it...\u0022,fr:\u0022Une erreur s\u0027est produite et ce jeu n\u0027a pas pu \u00EAtre charg\u00E9, vous voudrez peut-\u00EAtre le supprimer...\u0022,es:\u0022Ocurri\u00F3 un error y este juego no pudo cargarse, es posible que desees eliminarlo...\u0022,cn:\u0022\u53D1\u751F\u9519\u8BEF\uFF0C\u65E0\u6CD5\u52A0\u8F7D\u6B64\u6E38\u620F\uFF0C\u60A8\u53EF\u80FD\u5E0C\u671B\u5C06\u5176\u5220\u9664...\u0022,it:\u0022An error and this game could not be loaded, you may want to delete it...\u0022,de:\u0022Es ist ein Fehler aufgetreten und dieses Spiel konnte nicht geladen werden, Sie m\u00F6chten es m\u00F6glicherweise l\u00F6schen...\u0022,ja:\u0022 \u30A8\u30E9\u30FC \u304A\u3088\u3073 \u3053\u306E \u30B2\u30FC\u30E0 could \u3044\u3044\u3048t be \u8AAD\u307F\u8FBC\u307Fed, you may \u3057\u305F\u3044  \u524A\u9664 it...\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d i tej gry nie mo\u017Cna za\u0142adowa\u0107, mo\u017Cesz chcie\u0107 j\u0105 usun\u0105\u0107...\u0022,pt:\u0022Ocorreu um erro e este jogo n\u00E3o p\u00F4de ser carregado, voc\u00EA pode querer exclu\u00ED-lo...\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke i ova igra nije se mogla u\u010Ditati, mo\u017Eda je \u017Eelite izbrisati...\u0022,cz:\u0022An error and this game could not be loaded, you may want to delete it...\u0022,sk:\u0022An error and this game could not be loaded, you may want to delete it...\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5 \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9 \u03B4\u03B5\u03BD \u03BC\u03C0\u03CC\u03C1\u03B5\u03C3\u03B5 \u03BD\u03B1 \u03C6\u03BF\u03C1\u03C4\u03C9\u03B8\u03B5\u03AF, \u03AF\u03C3\u03C9\u03C2 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03BF \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5...\u0022,ru:\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438 \u0441\u043F\u0438\u0441\u043A\u0430\u0022,ko:\u0022An error and this game could not be loaded, you may want to delete it...\u0022},nke={en:\u0022Delete\u0022,fr:\u0022Supprimer\u0022,es:\u0022Eliminar\u0022,cn:\u0022\u5220\u9664\u0022,it:\u0022Elimina\u0022,de:\u0022L\u00F6schen\u0022,ja:\u0022\u524A\u9664\u0022,pl:\u0022Usu\u0144\u0022,pt:\u0022Excluir\u0022,hr:\u0022Izbri\u0161i\u0022,cz:\u0022Smazat\u0022,sk:\u0022Vymaza\u0165\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C\u0022,ko:\u0022\uC0AD\uC81C\u0022},ike={en:\u0022Tournament Game\u0022,fr:\u0022Partie de Tournoi\u0022,es:\u0022Juego de Torneo\u0022,cn:\u0022\u9526\u6807\u8D5B\u6E38\u620F\u0022,it:\u0022Tournament Game\u0022,de:\u0022Tournament Spiel\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30B2\u30FC\u30E0\u0022,pl:\u0022Gra turniejowa\u0022,pt:\u0022Jogo de Torneio\u0022,hr:\u0022Turnirska Igra\u0022,cz:\u0022Tournament Game\u0022,sk:\u0022Tournament Game\u0022,gr:\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03A0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0418\u0433\u0440\u0430\u0022,ko:\u0022Tournament Game\u0022},ske={en:\u0022Season\u0022,fr:\u0022Saison\u0022,es:\u0022Temporada\u0022,cn:\u0022\u8D5B\u5B63\u0022,it:\u0022Season\u0022,de:\u0022Saison\u0022,ja:\u0022\u30B7\u30FC\u30BA\u30F3\u0022,pl:\u0022Sezon\u0022,pt:\u0022Temporada\u0022,hr:\u0022Sezona\u0022,cz:\u0022Season\u0022,sk:\u0022Season\u0022,gr:\u0022\u03A3\u03B5\u03B6\u03CC\u03BD\u0022,ru:\u0022\u0421\u0435\u0437\u043E\u043D\u0022,ko:\u0022Season\u0022},oke={en:\u0022Select your list\u0022,fr:\u0022S\u00E9lectionnez votre liste\u0022,es:\u0022Selecciona tu lista\u0022,cn:\u0022\u9009\u62E9\u4F60\u7684\u519B\u8868\u0022,it:\u0022Select your list\u0022,de:\u0022Ausw\u00E4hlen your list\u0022,ja:\u0022\u9078\u629Eyour\u30EA\u30B9\u30C8\u0022,pl:\u0022Wybierz swoj\u0105 list\u0119\u0022,pt:\u0022Selecione sua lista\u0022,hr:\u0022Odaberite svoju listu\u0022,cz:\u0022Select your list\u0022,sk:\u0022Select your list\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u0430\u0448 \u0441\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022your list \uC120\uD0DD\u0022},ake={en:\u0022Select your opponent\u0027s list\u0022,fr:\u0022S\u00E9lectionnez la liste de votre adversaire\u0022,es:\u0022Selecciona la lista de tu oponente\u0022,cn:\u0022\u9009\u62E9\u5BF9\u624B\u7684\u519B\u8868\u0022,it:\u0022Select your opponent\u0027s list\u0022,de:\u0022Ausw\u00E4hlen your opponent\u0027s list\u0022,ja:\u0022\u9078\u629Eyour\u5BFE\u6226\u76F8\u624B\u306E\u30EA\u30B9\u30C8\u0022,pl:\u0022Wybierz list\u0119 przeciwnika\u0022,pt:\u0022Selecione a lista do seu oponente\u0022,hr:\u0022Odaberite listu protivnika\u0022,cz:\u0022Select your opponent\u0027s list\u0022,sk:\u0022Select your opponent\u0027s list\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C4\u03BF\u03C5 \u03B1\u03BD\u03C4\u03B9\u03C0\u03AC\u03BB\u03BF\u03C5 \u03C3\u03B1\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u0022,ko:\u0022your opponent\u0027s list \uC120\uD0DD\u0022},lke={en:\u0022If your opponent has a New Recruit account, you can find it here, this will link the game report to their account.\u0022,fr:\u0022Si votre adversaire a un compte New Recruit, vous pouvez le trouver ici, cela liera le rapport de partie \u00E0 son compte.\u0022,es:\u0022Si tu oponente tiene una cuenta New Recruit, puedes encontrarla aqu\u00ED, esto vincular\u00E1 el reporte del juego a su cuenta.\u0022,cn:\u0022\u5982\u679C\u4F60\u7684\u5BF9\u624B\u6709 New Recruit \u8D26\u6237\uFF0C\u4F60\u53EF\u4EE5\u5728\u8FD9\u91CC\u627E\u5230\uFF0C\u8FD9\u5C06\u628A\u6E38\u620F\u62A5\u544A\u94FE\u63A5\u5230\u4ED6\u4EEC\u7684\u8D26\u6237\u3002\u0022,it:\u0022If your opponent has a Nuovo Recruit account, you can find it here, this will link the game report to their account.\u0022,de:\u0022Wenn Ihr Gegner ein New Recruit-Konto hat, k\u00F6nnen Sie es hier finden. Dadurch wird der Spielbericht mit seinem Konto verkn\u00FCpft.\u0022,ja:\u0022\u3082\u3057 \u3042\u306A\u305F\u306E \u5BFE\u6226\u76F8\u624B has a \u65B0\u898F Recruit \u30A2\u30AB\u30A6\u30F3\u30C8, you \u3067\u304D\u308B \u691C\u7D22 it \u3053\u3053, \u3053\u306E \u3057\u307E\u3059 \u30EA\u30F3\u30AF  \u30B2\u30FC\u30E0 \u30EC\u30DD\u30FC\u30C8  their \u30A2\u30AB\u30A6\u30F3\u30C8.\u0022,pl:\u0022Je\u015Bli tw\u00F3j przeciwnik ma konto New Recruit, mo\u017Cesz je tutaj znale\u017A\u0107, to po\u0142\u0105czy raport gry z jego kontem.\u0022,pt:\u0022Se seu oponente tiver uma conta New Recruit, voc\u00EA pode encontr\u00E1-la aqui, isso vincular\u00E1 o relat\u00F3rio do jogo \u00E0 conta dele.\u0022,hr:\u0022Ako va\u0161 protivnik ima New Recruit ra\u010Dun, mo\u017Eete ga prona\u0107i ovdje, ovo \u0107e povezati izvje\u0161taj igre s njihovim ra\u010Dunom.\u0022,cz:\u0022If your opponent has a New Recruit account, you can find it here, this will link the game report to their account.\u0022,sk:\u0022If your opponent has a New Recruit account, you can find it here, this will link the game report to their account.\u0022,gr:\u0022\u0395\u03AC\u03BD \u03BF \u03B1\u03BD\u03C4\u03AF\u03C0\u03B1\u03BB\u03CC\u03C2 \u03C3\u03B1\u03C2 \u03AD\u03C7\u03B5\u03B9 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC New Recruit, \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03BF\u03BD \u03B2\u03C1\u03B5\u03AF\u03C4\u03B5 \u03B5\u03B4\u03CE, \u03B1\u03C5\u03C4\u03CC \u03B8\u03B1 \u03C3\u03C5\u03BD\u03B4\u03AD\u03C3\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B1\u03BD\u03B1\u03C6\u03BF\u03C1\u03AC \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC \u03C4\u03BF\u03C5.\u0022,ru:\u0022\u0423\u0447\u0435\u0442\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u0022,ko:\u0022If your opponent has a New Recruit account, you can find it here, this will link the game report to their account.\u0022},uke={en:\u0022I don\u0027t have their list\u0022,fr:\u0022Je n\u0027ai pas leur liste\u0022,es:\u0022No tengo su lista\u0022,cn:\u0022\u6211\u6CA1\u6709\u4ED6\u4EEC\u7684\u519B\u8868\u0022,it:\u0022I don\u0027t have their list\u0022,de:\u0022Ich habe ihre Liste nicht\u0022,ja:\u0022I don\u0027t have their \u30EA\u30B9\u30C8\u0022,pl:\u0022Nie mam ich listy\u0022,pt:\u0022N\u00E3o tenho a lista dele\u0022,hr:\u0022Nemam njihovu listu\u0022,cz:\u0022I don\u0027t have their list\u0022,sk:\u0022I don\u0027t have their list\u0022,gr:\u0022\u0394\u03B5\u03BD \u03AD\u03C7\u03C9 \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C4\u03BF\u03C5\u0022,ru:\u0022\u0423 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0435\u0442 \u0441\u043F\u0438\u0441\u043A\u0430\u0022,ko:\u0022I don\u0027t have their list\u0022},cke={en:\u0022Next\u0022,fr:\u0022Suivant\u0022,es:\u0022Siguiente\u0022,cn:\u0022\u4E0B\u4E00\u6B65\u0022,it:\u0022Avanti\u0022,de:\u0022Weiter\u0022,ja:\u0022\u6B21\u3078\u0022,pl:\u0022Dalej\u0022,pt:\u0022Pr\u00F3ximo\u0022,hr:\u0022Sljede\u0107e\u0022,cz:\u0022Dal\u0161\u00ED\u0022,sk:\u0022\u010Ealej\u0022,gr:\u0022\u0395\u03C0\u03CC\u03BC\u03B5\u03BD\u03BF\u0022,ru:\u0022\u0414\u0430\u043B\u0435\u0435\u0022,ko:\u0022\uB2E4\uC74C\u0022},Ake={en:\u0022Tournament Game\u0022,fr:\u0022Partie de Tournoi\u0022,es:\u0022Juego de Torneo\u0022,cn:\u0022\u9526\u6807\u8D5B\u6E38\u620F\u0022,it:\u0022Tournament Game\u0022,de:\u0022Tournament Spiel\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30B2\u30FC\u30E0\u0022,pl:\u0022Gra turniejowa\u0022,pt:\u0022Jogo de Torneio\u0022,hr:\u0022Turnirska Igra\u0022,cz:\u0022Tournament Game\u0022,sk:\u0022Tournament Game\u0022,gr:\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03A0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0418\u0433\u0440\u0430\u0022,ko:\u0022Tournament Game\u0022},dke={en:\u0022Match ID\u0022,fr:\u0022ID du Match\u0022,es:\u0022ID del Partido\u0022,cn:\u0022\u6BD4\u8D5B\u7F16\u53F7\u0022,it:\u0022Match ID\u0022,de:\u0022\u00DCbereinstimmung ID\u0022,ja:\u0022\u4E00\u81F4ID\u0022,pl:\u0022ID meczu\u0022,pt:\u0022ID da Partida\u0022,hr:\u0022Me\u010D ID\u0022,cz:\u0022Match ID\u0022,sk:\u0022Match ID\u0022,gr: