0022,gr:\u0022\u0394\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\u03C0\u03C4\u03BF\u0022,ru:\u0022\u0421\u0435\u043A\u0443\u043D\u0434\u0430\u0022,ko:\u0022second\u0022},PNe={en:\u0022seconds\u0022,fr:\u0022secondes\u0022,es:\u0022segundos\u0022,cn:\u0022\u79D2\u0022,it:\u0022secondi\u0022,de:\u0022Sekunden\u0022,ja:\u0022\u79D2\u0022,pl:\u0022sekundy\u0022,pt:\u0022segundos\u0022,hr:\u0022sekundi\u0022,cz:\u0022seconds\u0022,sk:\u0022seconds\u0022,gr:\u0022\u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\u03C0\u03C4\u03B1\u0022,ru:\u0022\u0441\u0435\u043A\u0443\u043D\u0434\u0022,ko:\u0022seconds\u0022},TNe={en:\u0022just now\u0022,fr:\u0022\u00E0 l\u0027instant\u0022,es:\u0022justo ahora\u0022,cn:\u0022\u521A\u521A\u0022,it:\u0022proprio ora\u0022,de:\u0022gerade eben\u0022,ja:\u0022\u305F\u3063\u305F\u4ECA\u0022,pl:\u0022przed chwil\u0105\u0022,pt:\u0022agora mesmo\u0022,hr:\u0022upravo sada\u0022,cz:\u0022just now\u0022,sk:\u0022just now\u0022,gr:\u0022\u03BC\u03CC\u03BB\u03B9\u03C2 \u03C4\u03CE\u03C1\u03B1\u0022,ru:\u0022\u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E\u0022,ko:\u0022just now\u0022},NNe={en:\u0022{amount} {unit}\u0022,fr:\u0022{amount} {unit}\u0022,es:\u0022{amount} {unit}\u0022,cn:\u0022{amount}{unit}\u0022,it:\u0022{amount} {unit}\u0022,de:\u0022{amount} {unit}\u0022,ja:\u0022{amount}{unit}\u0022,pl:\u0022{amount} {unit}\u0022,pt:\u0022{amount} {unit}\u0022,hr:\u0022Vrijeme\u0022,cz:\u0022{amount} {unit}\u0022,sk:\u0022{amount} {unit}\u0022,gr:\u0022\u03A7\u03C1\u03CC\u03BD\u03BF\u03C2\u0022,ru:\u0022{\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E} {\u042E\u043D\u0438\u0442}\u0022,ko:\u0022{amount} {unit}\u0022},FNe={en:\u0022{amount} {unit} ago\u0022,fr:\u0022il y a {amount} {unit}\u0022,es:\u0022hace {amount} {unit}\u0022,cn:\u0022{amount}{unit}\u524D\u0022,it:\u0022{amount} {unit} fa\u0022,de:\u0022vor {amount} {unit}\u0022,ja:\u0022{amount}{unit}\u524D\u0022,pl:\u0022{amount} {unit} temu\u0022,pt:\u0022h\u00E1 {amount} {unit}\u0022,hr:\u0022prije\u0022,cz:\u0022{amount} {unit} ago\u0022,sk:\u0022{amount} {unit} ago\u0022,gr:\u0022\u03C0\u03C1\u03B9\u03BD\u0022,ru:\u0022{\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E} {\u042E\u043D\u0438\u0442} ago\u0022,ko:\u0022{amount} {unit} ago\u0022},RNe={en:\u0022Support New Recruit to use the new Game Assistant for Warhammer 40,000!\u0022,fr:\u0022Soutenez New Recruit pour utiliser le nouvel Assistant de Jeu pour Warhammer 40,000 !\u0022,es:\u0022\u00A1Apoya a New Recruit para usar el nuevo Asistente de Juego para Warhammer 40,000!\u0022,cn:\u0022\u652F\u6301 New Recruit \u4EE5\u4F7F\u7528\u65B0\u7684\u6218\u952440,000\u6E38\u620F\u52A9\u624B\uFF01\u0022,it:\u0022Sostieni New Recruit per utilizzare il nuovo Assistente di Gioco per Warhammer 40,000!\u0022,de:\u0022Unterst\u00FCtze New Recruit, um den neuen Spiel-Assistenten f\u00FCr Warhammer 40,000 zu nutzen!\u0022,ja:\u0022Warhammer 40,000\u306E\u65B0\u3057\u3044\u30B2\u30FC\u30E0\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u3092\u4F7F\u7528\u3059\u308B\u306B\u306F\u3001New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u304F\u3060\u3055\u3044\uFF01\u0022,pl:\u0022Wesprzyj New Recruit, aby korzysta\u0107 z nowego Asystenta Gry dla Warhammer 40,000!\u0022,pt:\u0022Apoie o New Recruit para usar o novo Assistente de Jogo para Warhammer 40,000!\u0022,hr:\u0022Dobrodo\u0161li u pomo\u0107nika za Warhammer 40,000 bitke\u0022,cz:\u0022Support New Recruit to use the new Game Assistant for Warhammer 40,000!\u0022,sk:\u0022Support New Recruit to use the new Game Assistant for Warhammer 40,000!\u0022,gr:\u0022\u039A\u03B1\u03BB\u03CE\u03C2 \u03AE\u03C1\u03B8\u03B1\u03C4\u03B5 \u03C3\u03C4\u03BF\u03BD \u0392\u03BF\u03B7\u03B8\u03CC WH40K\u0022,ru:\u0022\u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0434\u043B\u044F Warhammer 40,000\u0022,ko:\u0022Support New Recruit to use the new Game Assistant for Warhammer 40,000!\u0022},MNe={en:\u0022Integrated with the list builder\u0022,fr:\u0022Int\u00E9gr\u00E9 avec le cr\u00E9ateur de listes\u0022,es:\u0022Integrado con el creador de listas\u0022,cn:\u0022\u4E0E\u5217\u8868\u751F\u6210\u5668\u96C6\u6210\u0022,it:\u0022Integrato con il costruttore di liste\u0022,de:\u0022Integriert mit dem Listenbauer\u0022,ja:\u0022\u30EA\u30B9\u30C8\u30D3\u30EB\u30C0\u30FC\u3068\u7D71\u5408\u0022,pl:\u0022Zintegrowany z kreatorem list\u0022,pt:\u0022Integrado com o construtor de listas\u0022,hr:\u0022Integrirani upravlja\u010D bitaka\u0022,cz:\u0022Integrated with the list builder\u0022,sk:\u0022Integrated with the list builder\u0022,gr:\u0022\u039F\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03BD\u03B7 \u03B5\u03BC\u03C0\u03B5\u03B9\u03C1\u03AF\u03B1 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD\u0022,ru:\u0022\u0418\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0022,ko:\u0022Integrated with the list builder\u0022},UNe={en:\u0022Mission setup with randomization and deployment zones\u0022,fr:\u0022Configuration de mission avec randomisation et zones de d\u00E9ploiement\u0022,es:\u0022Configuraci\u00F3n de misi\u00F3n con aleatorizaci\u00F3n y zonas de despliegue\u0022,cn:\u0022\u4EFB\u52A1\u8BBE\u7F6E\uFF0C\u5305\u542B\u968F\u673A\u5316\u548C\u90E8\u7F72\u533A\u57DF\u0022,it:\u0022Configurazione missione con casualizzazione e zone di schieramento\u0022,de:\u0022Missionserstellung mit Zufallsgenerierung und Einsatzzonen\u0022,ja:\u0022\u30E9\u30F3\u30C0\u30E0\u5316\u3068\u914D\u7F6E\u30BE\u30FC\u30F3\u3092\u5099\u3048\u305F\u30DF\u30C3\u30B7\u30E7\u30F3\u8A2D\u5B9A\u0022,pl:\u0022Ustawienia misji z losowaniem i strefami rozmieszczenia\u0022,pt:\u0022Configura\u00E7\u00E3o de miss\u00E3o com aleatoriedade e zonas de implanta\u00E7\u00E3o\u0022,hr:\u0022Odabir misija i terena\u0022,cz:\u0022Mission setup with randomization and deployment zones\u0022,sk:\u0022Mission setup with randomization and deployment zones\u0022,gr:\u0022\u03A4\u03C5\u03C7\u03B1\u03AF\u03B1 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03CE\u03BD\u0022,ru:\u0022\u0412\u044B\u0431\u043E\u0440 \u043C\u0438\u0441\u0441\u0438\u0438 \u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438\u0022,ko:\u0022Mission setup with randomization and deployment zones\u0022},xNe={en:\u0022Round-by-round tracking with CP counters and turn management\u0022,fr:\u0022Suivi round par round avec compteurs de PC et gestion des tours\u0022,es:\u0022Seguimiento ronda por ronda con contadores de PC y gesti\u00F3n de turnos\u0022,cn:\u0022\u9010\u8F6E\u8FFD\u8E2A\uFF0C\u5305\u542BCP\u8BA1\u6570\u5668\u548C\u56DE\u5408\u7BA1\u7406\u0022,it:\u0022Tracciamento round per round con contatori CP e gestione dei turni\u0022,de:\u0022Runden-f\u00FCr-Runden-Verfolgung mit CP-Z\u00E4hlern und Zugverwaltung\u0022,ja:\u0022CP\u30AB\u30A6\u30F3\u30BF\u30FC\u3068\u30BF\u30FC\u30F3\u7BA1\u7406\u3092\u5099\u3048\u305F\u30E9\u30A6\u30F3\u30C9\u3054\u3068\u306E\u8FFD\u8DE1\u0022,pl:\u0022\u015Aledzenie runda po rundzie z licznikami PC i zarz\u0105dzaniem turami\u0022,pt:\u0022Rastreamento rodada por rodada com contadores de CP e gest\u00E3o de turnos\u0022,hr:\u0022Pra\u0107enje bodova i kola\u0022,cz:\u0022Round-by-round tracking with CP counters and turn management\u0022,sk:\u0022Round-by-round tracking with CP counters and turn management\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03CD\u03B8\u03B7\u03C3\u03B7 \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD \u03BA\u03B1\u03B9 \u03C3\u03C4\u03CC\u03C7\u03C9\u03BD\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u043E\u0447\u043A\u043E\u0432 \u0438 \u0440\u0430\u0443\u043D\u0434\u043E\u0432\u0022,ko:\u0022Round-by-round tracking with CP counters and turn management\u0022},QNe={en:\u0022Scoring for primary and secondary objectives\u0022,fr:\u0022Calcul des points pour les objectifs primaires et secondaires\u0022,es:\u0022Puntuaci\u00F3n para objetivos primarios y secundarios\u0022,cn:\u0022\u4E3B\u8981\u548C\u6B21\u8981\u76EE\u6807\u7684\u5F97\u5206\u0022,it:\u0022Punteggio per obiettivi primari e secondari\u0022,de:\u0022Punktevergabe f\u00FCr Haupt- und Nebenziele\u0022,ja:\u0022\u4E3B\u76EE\u6A19\u3068\u526F\u76EE\u6A19\u306E\u30B9\u30B3\u30A2\u30EA\u30F3\u30B0\u0022,pl:\u0022Punktacja dla cel\u00F3w podstawowych i dodatkowych\u0022,pt:\u0022Pontua\u00E7\u00E3o para objetivos prim\u00E1rios e secund\u00E1rios\u0022,hr:\u0022Automatsko bodovanje\u0022,cz:\u0022Scoring for primary and secondary objectives\u0022,sk:\u0022Scoring for primary and secondary objectives\u0022,gr:\u0022\u0391\u03C5\u03C4\u03CC\u03BC\u03B1\u03C4\u03B7 \u03B2\u03B1\u03B8\u03BC\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u0022,ru:\u0022\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u043E\u0434\u0441\u0447\u0435\u0442 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022Scoring for primary and secondary objectives\u0022},LNe={en:\u0022... and more to come\u0022,fr:\u0022... et bien plus \u00E0 venir\u0022,es:\u0022... y m\u00E1s por venir\u0022,cn:\u0022...\u8FD8\u6709\u66F4\u591A\u529F\u80FD\u5373\u5C06\u63A8\u51FA\u0022,it:\u0022... e molto altro in arrivo\u0022,de:\u0022... und mehr in K\u00FCrze\u0022,ja:\u0022...\u305D\u3057\u3066\u3055\u3089\u306B\u8FFD\u52A0\u4E88\u5B9A\u0022,pl:\u0022... i wi\u0119cej w przysz\u0142o\u015Bci\u0022,pt:\u0022... e mais por vir\u0022,hr:\u0022I jo\u0161 mnogo toga!\u0022,cz:\u0022... and more to come\u0022,sk:\u0022... and more to come\u0022,gr:\u0022\u039A\u03B1\u03B9 \u03C0\u03BF\u03BB\u03BB\u03AC \u03AC\u03BB\u03BB\u03B1\u0022,ru:\u0022\u0418 \u043C\u043D\u043E\u0433\u043E\u0435 \u0434\u0440\u0443\u0433\u043E\u0435\u0022,ko:\u0022... and more to come\u0022},DNe={en:\u0022\u26A0\uFE0F Beta Feature\u0022,fr:\u0022\u26A0\uFE0F Fonctionnalit\u00E9 Beta\u0022,es:\u0022\u26A0\uFE0F Caracter\u00EDstica Beta\u0022,cn:\u0022\u26A0\uFE0F \u6D4B\u8BD5\u529F\u80FD\u0022,it:\u0022\u26A0\uFE0F Funzionalit\u00E0 Beta\u0022,de:\u0022\u26A0\uFE0F Beta-Funktion\u0022,ja:\u0022\u26A0\uFE0F \u30D9\u30FC\u30BF\u6A5F\u80FD\u0022,pl:\u0022\u26A0\uFE0F Funkcja Beta\u0022,pt:\u0022\u26A0\uFE0F Recurso Beta\u0022,hr:\u0022Beta verzija\u0022,cz:\u0022\u26A0\uFE0F Beta Feature\u0022,sk:\u0022\u26A0\uFE0F Beta Feature\u0022,gr:\u0022\u0394\u03BF\u03BA\u03B9\u03BC\u03B1\u03C3\u03C4\u03B9\u03BA\u03AE \u03AD\u03BA\u03B4\u03BF\u03C3\u03B7\u0022,ru:\u0022\u0411\u0435\u0442\u0430-\u0432\u0435\u0440\u0441\u0438\u044F\u0022,ko:\u0022\u26A0\uFE0F Beta Feature\u0022},ONe={en:\u0022The Warhammer 40,000 Gaming Assistant is currently in beta. We\u0027re actively working on improvements and new features. Your feedback helps us make it better!\u0022,fr:\u0022L\u0027Assistant de Jeu Warhammer 40,000 est actuellement en b\u00EAta. Nous travaillons activement sur des am\u00E9liorations et de nouvelles fonctionnalit\u00E9s. Vos retours nous aident \u00E0 l\u0027am\u00E9liorer !\u0022,es:\u0022El Asistente de Juego de Warhammer 40,000 est\u00E1 actualmente en beta. Estamos trabajando activamente en mejoras y nuevas caracter\u00EDsticas. \u00A1Tus comentarios nos ayudan a mejorarlo!\u0022,cn:\u0022\u6218\u952440,000\u6E38\u620F\u52A9\u624B\u76EE\u524D\u5904\u4E8E\u6D4B\u8BD5\u9636\u6BB5\u3002\u6211\u4EEC\u6B63\u5728\u79EF\u6781\u5F00\u53D1\u6539\u8FDB\u548C\u65B0\u529F\u80FD\u3002\u60A8\u7684\u53CD\u9988\u5E2E\u52A9\u6211\u4EEC\u505A\u5F97\u66F4\u597D\uFF01\u0022,it:\u0022L\u0027Assistente di Gioco di Warhammer 40,000 \u00E8 attualmente in beta. Stiamo lavorando attivamente su miglioramenti e nuove funzionalit\u00E0. Il tuo feedback ci aiuta a migliorarlo!\u0022,de:\u0022Der Warhammer 40,000 Spiel-Assistent befindet sich derzeit in der Beta-Phase. Wir arbeiten aktiv an Verbesserungen und neuen Funktionen. Dein Feedback hilft uns, ihn besser zu machen!\u0022,ja:\u0022Warhammer 40,000\u30B2\u30FC\u30E0\u30A2\u30B7\u30B9\u30BF\u30F3\u30C8\u306F\u73FE\u5728\u30D9\u30FC\u30BF\u7248\u3067\u3059\u3002\u6539\u5584\u3068\u65B0\u6A5F\u80FD\u306B\u7A4D\u6975\u7684\u306B\u53D6\u308A\u7D44\u3093\u3067\u3044\u307E\u3059\u3002\u3042\u306A\u305F\u306E\u30D5\u30A3\u30FC\u30C9\u30D0\u30C3\u30AF\u304C\u6539\u5584\u306B\u5F79\u7ACB\u3061\u307E\u3059\uFF01\u0022,pl:\u0022Asystent Gry Warhammer 40,000 jest obecnie w wersji beta. Aktywnie pracujemy nad ulepszeniami i nowymi funkcjami. Twoja opinia pomaga nam go ulepszy\u0107!\u0022,pt:\u0022O Assistente de Jogo Warhammer 40,000 est\u00E1 atualmente em beta. Estamos trabalhando ativamente em melhorias e novos recursos. Seu feedback nos ajuda a melhor\u00E1-lo!\u0022,hr:\u0022Ova zna\u010Dajka je u beta verziji. Molimo prijavite sve probleme.\u0022,cz:\u0022The Warhammer 40,000 Gaming Assistant is currently in beta. We\u0027re actively working on improvements and new features. Your feedback helps us make it better!\u0022,sk:\u0022The Warhammer 40,000 Gaming Assistant is currently in beta. We\u0027re actively working on improvements and new features. Your feedback helps us make it better!\u0022,gr:\u0022\u0391\u03C5\u03C4\u03AE \u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9 \u03C3\u03B5 \u03B4\u03BF\u03BA\u03B9\u03BC\u03AE\u0022,ru:\u0022\u042D\u0442\u0430 \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0431\u0435\u0442\u0430-\u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438\u0022,ko:\u0022The Warhammer 40,000 Gaming Assistant is currently in beta. We\u0027re actively working on improvements and new features. Your feedback helps us make it better!\u0022},HNe={en:\u0022Fixed Missions\u0022,fr:\u0022Missions Fixes\u0022,es:\u0022Misiones Fijas\u0022,cn:\u0022\u56FA\u5B9A\u4EFB\u52A1\u0022,it:\u0022Missioni Fisse\u0022,de:\u0022Feste Missionen\u0022,ja:\u0022\u56FA\u5B9A\u30DF\u30C3\u30B7\u30E7\u30F3\u0022,pl:\u0022Misje Sta\u0142e\u0022,pt:\u0022Miss\u00F5es Fixas\u0022,hr:\u0022Fiksne misije\u0022,cz:\u0022Fixed Missions\u0022,sk:\u0022Fixed Missions\u0022,gr:\u0022\u039A\u03B1\u03B8\u03BF\u03C1\u03B9\u03C3\u03BC\u03AD\u03BD\u03B5\u03C2 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AD\u03C2\u0022,ru:\u0022\u0424\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043C\u0438\u0441\u0441\u0438\u0438\u0022,ko:\u0022Fixed Missions\u0022},GNe={en:\u0022Tactical Missions\u0022,fr:\u0022Missions Tactiques\u0022,es:\u0022Misiones T\u00E1cticas\u0022,cn:\u0022\u6218\u672F\u4EFB\u52A1\u0022,it:\u0022Missioni Tattiche\u0022,de:\u0022Taktische Missionen\u0022,ja:\u0022\u6226\u8853\u30DF\u30C3\u30B7\u30E7\u30F3\u0022,pl:\u0022Misje Taktyczne\u0022,pt:\u0022Miss\u00F5es T\u00E1ticas\u0022,hr:\u0022Takti\u010Dke misije\u0022,cz:\u0022Tactical Missions\u0022,sk:\u0022Tactical Missions\u0022,gr:\u0022\u03A4\u03B1\u03BA\u03C4\u03B9\u03BA\u03AD\u03C2 \u03B1\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AD\u03C2\u0022,ru:\u0022\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043C\u0438\u0441\u0441\u0438\u0438\u0022,ko:\u0022Tactical Missions\u0022},VNe={en:\u0022Custom $cat\u0022,fr:\u0022Personnalis\u00E9 $cat\u0022,es:\u0022Personalizado $cat\u0022,cn:\u0022\u81EA\u5B9A\u4E49 $cat\u0022,it:\u0022Personalizzato $cat\u0022,de:\u0022Benutzerdefiniert $cat\u0022,ja:\u0022\u30AB\u30B9\u30BF\u30E0 $cat\u0022,pl:\u0022Niestandardowe $cat\u0022,pt:\u0022Personalizado $cat\u0022,hr:\u0022Prilago\u0111ena kategorija\u0022,cz:\u0022Custom $cat\u0022,sk:\u0022Custom $cat\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B1\u03C1\u03BC\u03BF\u03C3\u03BC\u03AD\u03BD\u03B7 \u03BA\u03B1\u03C4\u03B7\u03B3\u03BF\u03C1\u03AF\u03B1\u0022,ru:\u0022\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 $cat\u0022,ko:\u0022Custom $cat\u0022},WNe={en:\u0022Mission\u0022,fr:\u0022Mission\u0022,es:\u0022Misi\u00F3n\u0022,cn:\u0022\u4EFB\u52A1\u0022,it:\u0022Missione\u0022,de:\u0022Mission\u0022,ja:\u0022\u30DF\u30C3\u30B7\u30E7\u30F3\u0022,pl:\u0022Misja\u0022,pt:\u0022Miss\u00E3o\u0022,hr:\u0022Postavljanje misije\u0022,cz:\u0022Mission\u0022,sk:\u0022Misia\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C3\u03C4\u03BF\u03BB\u03AE\u0022,ru:\u0022\u041C\u0438\u0441\u0441\u0438\u044F\u0022,ko:\u0022Mission\u0022},YNe={en:\u0022Randomize\u0022,fr:\u0022Al\u00E9atoire\u0022,es:\u0022Aleatorizar\u0022,cn:\u0022\u968F\u673A\u0022,it:\u0022Casuale\u0022,de:\u0022Zuf\u00E4llig\u0022,ja:\u0022\u30E9\u30F3\u30C0\u30E0\u0022,pl:\u0022Losuj\u0022,pt:\u0022Aleat\u00F3rio\u0022,hr:\u0022Nasumi\u010Dno\u0022,cz:\u0022Randomize\u0022,sk:\u0022Randomize\u0022,gr:\u0022\u03A4\u03C5\u03C7\u03B1\u03B9\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u0022,ru:\u0022\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440\u0022,ko:\u0022Randomize\u0022},KNe={en:\u0022Terrain Layout\u0022,fr:\u0022Disposition du Terrain\u0022,es:\u0022Disposici\u00F3n del Terreno\u0022,cn:\u0022\u5730\u5F62\u5E03\u5C40\u0022,it:\u0022Disposizione del Terreno\u0022,de:\u0022Gel\u00E4ndeanordnung\u0022,ja:\u0022\u5730\u5F62\u30EC\u30A4\u30A2\u30A6\u30C8\u0022,pl:\u0022Uk\u0142ad Terenu\u0022,pt:\u0022Layout do Terreno\u0022,hr:\u0022Postavljanje terena\u0022,cz:\u0022Terrain Layout\u0022,sk:\u0022Terrain Layout\u0022,gr:\u0022\u03A1\u03CD\u03B8\u03BC\u03B9\u03C3\u03B7 \u03B5\u03B4\u03AC\u03C6\u03BF\u03C5\u03C2\u0022,ru:\u0022\u0420\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442\u0430\u0022,ko:\u0022Terrain Layout\u0022},qNe={en:\u0022Who is the Defender?\u0022,fr:\u0022Qui est le D\u00E9fenseur ?\u0022,es:\u0022\u00BFQui\u00E9n es el Defensor?\u0022,cn:\u0022\u8C01\u662F\u9632\u5FA1\u65B9\uFF1F\u0022,it:\u0022Chi \u00E8 il Difensore?\u0022,de:\u0022Wer ist der Verteidiger?\u0022,ja:\u0022\u8AB0\u304C\u30C7\u30A3\u30D5\u30A7\u30F3\u30C0\u30FC\u3067\u3059\u304B\uFF1F\u0022,pl:\u0022Kto jest Obro\u0144c\u0105?\u0022,pt:\u0022Quem \u00E9 o Defensor?\u0022,hr:\u0022Tko je branitelj?\u0022,cz:\u0022Who is the Defender?\u0022,sk:\u0022Who is the Defender?\u0022,gr:\u0022\u03A0\u03BF\u03B9\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF \u03B1\u03BC\u03C5\u03BD\u03CC\u03BC\u03B5\u03BD\u03BF\u03C2;\u0022,ru:\u0022\u041A\u0442\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A?\u0022,ko:\u0022Who is the Defender?\u0022},JNe={en:\u0022Who goes First?\u0022,fr:\u0022Qui joue en Premier ?\u0022,es:\u0022\u00BFQui\u00E9n va Primero?\u0022,cn:\u0022\u8C01\u5148\u884C\u52A8\uFF1F\u0022,it:\u0022Chi va per Primo?\u0022,de:\u0022Wer beginnt?\u0022,ja:\u0022\u8AB0\u304C\u5148\u653B\u3067\u3059\u304B\uFF1F\u0022,pl:\u0022Kto idzie Pierwszy?\u0022,pt:\u0022Quem vai Primeiro?\u0022,hr:\u0022Tko ima prvi potez?\u0022,cz:\u0022Who goes First?\u0022,sk:\u0022Who goes First?\u0022,gr:\u0022\u03A0\u03BF\u03B9\u03BF\u03C2 \u03C0\u03B1\u03AF\u03B6\u03B5\u03B9 \u03C0\u03C1\u03CE\u03C4\u03BF\u03C2;\u0022,ru:\u0022\u041A\u0442\u043E \u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0432\u044B\u043C?\u0022,ko:\u0022Who goes First?\u0022},$Ne={en:\u0022No layout selected\u0022,fr:\u0022Aucune disposition s\u00E9lectionn\u00E9e\u0022,es:\u0022No se seleccion\u00F3 disposici\u00F3n\u0022,cn:\u0022\u672A\u9009\u62E9\u5E03\u5C40\u0022,it:\u0022Nessuna disposizione selezionata\u0022,de:\u0022Keine Anordnung ausgew\u00E4hlt\u0022,ja:\u0022\u30EC\u30A4\u30A2\u30A6\u30C8\u304C\u9078\u629E\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u0022,pl:\u0022Nie wybrano uk\u0142adu\u0022,pt:\u0022Nenhum layout selecionado\u0022,hr:\u0022Nema rasporeda rasporeda\u0022,cz:\u0022No layout selected\u0022,sk:\u0022No layout selected\u0022,gr:\u0022\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03B5\u03B9 \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7\u0022,ru:\u0022\u0420\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u0430\u0022,ko:\u0022No layout selected\u0022},ZNe={en:\u0022\u26A0\uFE0F This layout is not compatible with the selected mission\u0022,fr:\u0022\u26A0\uFE0F Cette disposition n\u0027est pas compatible avec la mission s\u00E9lectionn\u00E9e\u0022,es:\u0022\u26A0\uFE0F Esta disposici\u00F3n no es compatible con la misi\u00F3n seleccionada\u0022,cn:\u0022\u26A0\uFE0F \u6B64\u5E03\u5C40\u4E0E\u6240\u9009\u4EFB\u52A1\u4E0D\u517C\u5BB9\u0022,it:\u0022\u26A0\uFE0F Questa disposizione non \u00E8 compatibile con la missione selezionata\u0022,de:\u0022\u26A0\uFE0F Diese Anordnung ist nicht mit der ausgew\u00E4hlten Mission kompatibel\u0022,ja:\u0022\u26A0\uFE0F \u3053\u306E\u30EC\u30A4\u30A2\u30A6\u30C8\u306F\u9078\u629E\u3055\u308C\u305F\u30DF\u30C3\u30B7\u30E7\u30F3\u3068\u4E92\u63DB\u6027\u304C\u3042\u308A\u307E\u305B\u3093\u0022,pl:\u0022\u26A0\uFE0F Ten uk\u0142ad nie jest kompatybilny z wybran\u0105 misj\u0105\u0022,pt:\u0022\u26A0\uFE0F Este layout n\u00E3o \u00E9 compat\u00EDvel com a miss\u00E3o selecionada\u0022,hr:\u0022Nekompatibilno s odabranom misijom\u0022,cz:\u0022\u26A0\uFE0F This layout is not compatible with the selected mission\u0022,sk:\u0022\u26A0\uFE0F This layout is not compatible with the selected mission\u0022,gr:\u0022\u039C\u03B7 \u03C3\u03C5\u03BC\u03B2\u03B1\u03C4\u03AE \u03B4\u03B9\u03AC\u03C4\u03B1\u03BE\u03B7 \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u03C2\u0022,ru:\u0022\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435: \u043D\u0435\u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u0430\u044F \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430\u0022,ko:\u0022\u26A0\uFE0F This layout is not compatible with the selected mission\u0022},XNe={en:\u0022Select Layout\u0022,fr:\u0022S\u00E9lectionner la Disposition\u0022,es:\u0022Seleccionar Disposici\u00F3n\u0022,cn:\u0022\u9009\u62E9\u5E03\u5C40\u0022,it:\u0022Seleziona Disposizione\u0022,de:\u0022Anordnung Ausw\