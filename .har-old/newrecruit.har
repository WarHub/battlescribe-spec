 un Preset\u0022,cn:\u0022\u9009\u62E9\u9884\u8BBE\u0022,it:\u0022Seleziona un Preset\u0022,de:\u0022Select a Preset\u0022,ja:\u0022\u30D7\u30EA\u30BB\u30C3\u30C8\u3092\u9078\u629E\u0022,pl:\u0022Wybierz Preset\u0022,pt:\u0022Selecionar um Predefini\u00E7\u00E3o\u0022,hr:\u0022Odaberi predlo\u017Eak\u0022,cz:\u0022Select a Preset\u0022,sk:\u0022Select a Preset\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0435\u0441\u0435\u0442\u0022,ko:\u0022a Preset \uC120\uD0DD\u0022},IPe={en:\u0022Select a Preset for {name}\u0022,fr:\u0022S\u00E9lectionner un Preset pour {name}\u0022,es:\u0022Seleccionar un Preset para {name}\u0022,cn:\u0022\u4E3A{name}\u9009\u62E9\u9884\u8BBE\u0022,it:\u0022Seleziona un Preset per {name}\u0022,de:\u0022Select a Preset for {name}\u0022,ja:\u0022{name} \u306E\u30D7\u30EA\u30BB\u30C3\u30C8\u3092\u9078\u629E\u0022,pl:\u0022Wybierz Preset dla {name}\u0022,pt:\u0022Selecionar uma Predefini\u00E7\u00E3o para {name}\u0022,hr:\u0022Odaberi predlo\u017Eak za\u0022,cz:\u0022Select a Preset for {name}\u0022,sk:\u0022Select a Preset for {name}\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE\u03C2 \u03B3\u03B9\u03B1\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0435\u0441\u0435\u0442 \u0434\u043B\u044F\u0022,ko:\u0022a Preset for {name} \uC120\uD0DD\u0022},PPe={en:\u0022Cancel the first print dialog to print the page.\u0022,fr:\u0022Annulez la premi\u00E8re bo\u00EEte de dialogue d\u0027impression pour imprimer la page.\u0022,es:\u0022Cancele el primer di\u00E1logo de impresi\u00F3n para imprimir la p\u00E1gina.\u0022,cn:\u0022\u53D6\u6D88\u7B2C\u4E00\u4E2A\u6253\u5370\u5BF9\u8BDD\u6846\u4EE5\u6253\u5370\u9875\u9762\u3002\u0022,it:\u0022Annulla la prima finestra di dialogo di stampa per stampare la pagina.\u0022,de:\u0022Cancel the first print dialog to print the page.\u0022,ja:\u0022\u30DA\u30FC\u30B8\u3092\u5370\u5237\u3059\u308B\u306B\u306F\u3001\u6700\u521D\u306E\u5370\u5237\u30C0\u30A4\u30A2\u30ED\u30B0\u3092\u30AD\u30E3\u30F3\u30BB\u30EB\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,pl:\u0022Anuluj pierwsze okno dialogowe drukowania, aby wydrukowa\u0107 stron\u0119.\u0022,pt:\u0022Cancele o primeiro di\u00E1logo de impress\u00E3o para imprimir a p\u00E1gina.\u0022,hr:\u0022Pretpregled ispisa\u0022,cz:\u0022Cancel the first print dialog to print the page.\u0022,sk:\u0022Cancel the first print dialog to print the page.\u0022,gr:\u0022\u0394\u03B9\u03AC\u03BB\u03BF\u03B3\u03BF\u03C2 \u03B5\u03BA\u03C4\u03CD\u03C0\u03C9\u03C3\u03B7\u03C2 \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03C3\u03BA\u03CC\u03C0\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041F\u0440\u0435\u0434\u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u0435\u0447\u0430\u0442\u0438\u0022,ko:\u0022Cancel the first print dialog to print the page.\u0022},TPe={en:\u0022Select a template\u0022,fr:\u0022S\u00E9lectionner un mod\u00E8le\u0022,es:\u0022Seleccionar una plantilla\u0022,cn:\u0022\u9009\u62E9\u6A21\u677F\u0022,it:\u0022Seleziona un modello\u0022,de:\u0022Select a template\u0022,ja:\u0022\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u3092\u9078\u629E\u0022,pl:\u0022Wybierz szablon\u0022,pt:\u0022Selecionar um modelo\u0022,hr:\u0022Odaberi predlo\u017Eak\u0022,cz:\u0022Select a template\u0022,sk:\u0022Select a template\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0448\u0430\u0431\u043B\u043E\u043D\u0022,ko:\u0022a template \uC120\uD0DD\u0022},NPe={en:\u0022Create a new template using HTML \u0026 CSS (WIP)\u0022,fr:\u0022Cr\u00E9er un nouveau mod\u00E8le avec HTML et CSS (en cours)\u0022,es:\u0022Crear una nueva plantilla usando HTML y CSS (en progreso)\u0022,cn:\u0022\u4F7F\u7528HTML\u548CCSS\u521B\u5EFA\u65B0\u6A21\u677F\uFF08\u8FDB\u884C\u4E2D\uFF09\u0022,it:\u0022Crea un nuovo modello usando HTML e CSS (In Lavorazione)\u0022,de:\u0022Create a new template using HTML \u0026 CSS (WIP)\u0022,ja:\u0022HTML \u3068 CSS \u3092\u4F7F\u7528\u3057\u3066\u65B0\u3057\u3044\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u3092\u4F5C\u6210\uFF08WIP\uFF09\u0022,pl:\u0022Utw\u00F3rz nowy szablon u\u017Cywaj\u0105c HTML i CSS (W TRAKCIE)\u0022,pt:\u0022Criar um novo modelo usando HTML e CSS (WIP)\u0022,hr:\u0022Kreiraj novi predlo\u017Eak\u0022,cz:\u0022Create a new template using HTML \u0026 CSS (WIP)\u0022,sk:\u0022Create a new template using HTML \u0026 CSS (WIP)\u0022,gr:\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0448\u0430\u0431\u043B\u043E\u043D\u0022,ko:\u0022a new template using HTML \u0026 CSS (WIP) \uC0DD\uC131\u0022},FPe={en:\u0022More example templates and documentation is available the readme of\u0022,fr:\u0022Plus d\u0027exemples de mod\u00E8les et de documentation sont disponibles dans le readme de\u0022,es:\u0022M\u00E1s plantillas de ejemplo y documentaci\u00F3n est\u00E1n disponibles en el readme de\u0022,cn:\u0022\u66F4\u591A\u793A\u4F8B\u6A21\u677F\u548C\u6587\u6863\u53EF\u5728\u4EE5\u4E0Breadme\u4E2D\u627E\u5230\u0022,it:\u0022Altri esempi di modelli e documentazione sono disponibili nel readme di\u0022,de:\u0022More example templates and documentation is available the readme of\u0022,ja:\u0022\u30B5\u30F3\u30D7\u30EB\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u3068\u30C9\u30AD\u30E5\u30E1\u30F3\u30C8\u306E\u8A73\u7D30\u306F readme \u3067\u5165\u624B\u3067\u304D\u307E\u3059\u0022,pl:\u0022Wi\u0119cej przyk\u0142adowych szablon\u00F3w i dokumentacji jest dost\u0119pnych w readme\u0022,pt:\u0022Mais exemplos de modelos e documenta\u00E7\u00E3o est\u00E3o dispon\u00EDveis no readme de\u0022,hr:\u0022Dokumentacija predlo\u017Eaka\u0022,cz:\u0022More example templates and documentation is available the readme of\u0022,sk:\u0022More example templates and documentation is available the readme of\u0022,gr:\u0022\u03A4\u03B5\u03BA\u03BC\u03B7\u03C1\u03AF\u03C9\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u043F\u043E \u0448\u0430\u0431\u043B\u043E\u043D\u0430\u043C\u0022,ko:\u0022More example templates and documentation is available the readme of\u0022},RPe={en:\u0022Sync to new file\u0022,fr:\u0022Synchroniser vers un nouveau fichier\u0022,es:\u0022Sincronizar a nuevo archivo\u0022,cn:\u0022\u540C\u6B65\u5230\u65B0\u6587\u4EF6\u0022,it:\u0022Sincronizza con nuovo file\u0022,de:\u0022Sync to new file\u0022,ja:\u0022\u65B0\u3057\u3044\u30D5\u30A1\u30A4\u30EB\u306B\u540C\u671F\u0022,pl:\u0022Synchronizuj do nowego pliku\u0022,pt:\u0022Sincronizar para novo arquivo\u0022,hr:\u0022Sinkroniziraj kao novu datoteku\u0022,cz:\u0022Sync to new file\u0022,sk:\u0022Sync to new file\u0022,gr:\u0022\u03A3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2 \u03BC\u03B5 \u03BD\u03AD\u03BF \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF\u0022,ru:\u0022\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F to \u041D\u043E\u0432\u044B\u0439 \u0424\u0430\u0439\u043B\u0022,ko:\u0022Sync to new file\u0022},MPe={en:\u0022Sync to existing file\u0022,fr:\u0022Synchroniser vers un fichier existant\u0022,es:\u0022Sincronizar a archivo existente\u0022,cn:\u0022\u540C\u6B65\u5230\u73B0\u6709\u6587\u4EF6\u0022,it:\u0022Sincronizza con file esistente\u0022,de:\u0022Sync to existing file\u0022,ja:\u0022\u65E2\u5B58\u306E\u30D5\u30A1\u30A4\u30EB\u306B\u540C\u671F\u0022,pl:\u0022Synchronizuj do istniej\u0105cego pliku\u0022,pt:\u0022Sincronizar para arquivo existente\u0022,hr:\u0022Sinkroniziraj postoje\u0107u datoteku\u0022,cz:\u0022Sync to existing file\u0022,sk:\u0022Sync to existing file\u0022,gr:\u0022\u03A3\u03C5\u03B3\u03C7\u03C1\u03BF\u03BD\u03B9\u03C3\u03BC\u03CC\u03C2 \u03BC\u03B5 \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03BD \u03B1\u03C1\u03C7\u03B5\u03AF\u03BF\u0022,ru:\u0022\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u0444\u0430\u0439\u043B\u0022,ko:\u0022Sync to existing file\u0022},UPe={en:\u0022Edit Template\u0022,fr:\u0022Modifier le Mod\u00E8le\u0022,es:\u0022Editar Plantilla\u0022,cn:\u0022\u7F16\u8F91\u6A21\u677F\u0022,it:\u0022Modifica Modello\u0022,de:\u0022Edit Template\u0022,ja:\u0022\u7DE8\u96C6\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u0022,pl:\u0022Edytuj Szablon\u0022,pt:\u0022Editar Modelo\u0022,hr:\u0022Uredi predlo\u017Eak\u0022,cz:\u0022Edit Template\u0022,sk:\u0022Edit Template\u0022,gr:\u0022\u0395\u03C0\u03B5\u03BE\u03B5\u03C1\u03B3\u03B1\u03C3\u03AF\u03B1 \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0420\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0448\u0430\u0431\u043B\u043E\u043D\u0022,ko:\u0022Template \uD3B8\uC9D1\u0022},xPe={en:\u0022Delete Template\u0022,fr:\u0022Supprimer le Mod\u00E8le\u0022,es:\u0022Eliminar Plantilla\u0022,cn:\u0022\u5220\u9664\u6A21\u677F\u0022,it:\u0022Elimina Modello\u0022,de:\u0022Delete Template\u0022,ja:\u0022\u524A\u9664\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u0022,pl:\u0022Usu\u0144 Szablon\u0022,pt:\u0022Excluir Modelo\u0022,hr:\u0022Obri\u0161i predlo\u017Eak\u0022,cz:\u0022Delete Template\u0022,sk:\u0022Delete Template\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0448\u0430\u0431\u043B\u043E\u043D\u0022,ko:\u0022Template \uC0AD\uC81C\u0022},QPe={en:\u0022What should the new template be named?\u0022,fr:\u0022Quel nom donner au nouveau mod\u00E8le ?\u0022,es:\u0022\u00BFC\u00F3mo deber\u00EDa llamarse la nueva plantilla?\u0022,cn:\u0022\u65B0\u6A21\u677F\u5E94\u8BE5\u53EB\u4EC0\u4E48\u540D\u5B57\uFF1F\u0022,it:\u0022Come dovrebbe essere nominato il nuovo modello?\u0022,de:\u0022What should the new template be named?\u0022,ja:\u0022\u65B0\u3057\u3044\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u306E\u540D\u524D\u306F\uFF1F\u0022,pl:\u0022Jak powienien nazywa\u0107 si\u0119 nowy szablon?\u0022,pt:\u0022Qual deve ser o nome do novo modelo?\u0022,hr:\u0022Unesite naziv predlo\u0161ka\u0022,cz:\u0022What should the new template be named?\u0022,sk:\u0022What should the new template be named?\u0022,gr:\u0022\u038C\u03BD\u03BF\u03BC\u03B1 \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0448\u0430\u0431\u043B\u043E\u043D\u0430\u0022,ko:\u0022What should the new template be named?\u0022},LPe={en:\u0022Are you sure you want to delete this template?\u0022,fr:\u0022\u00CAtes-vous s\u00FBr de vouloir supprimer ce mod\u00E8le ?\u0022,es:\u0022\u00BFEst\u00E1 seguro de que desea eliminar esta plantilla?\u0022,cn:\u0022\u60A8\u786E\u5B9A\u8981\u5220\u9664\u6B64\u6A21\u677F\u5417\uFF1F\u0022,it:\u0022Sei sicuro di voler eliminare questo modello?\u0022,de:\u0022Are you sure you want to delete this template?\u0022,ja:\u0022\u3053\u306E\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u3092\u524A\u9664\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F\u0022,pl:\u0022Czy na pewno chcesz usun\u0105\u0107 ten szablon?\u0022,pt:\u0022Tem certeza de que deseja excluir este modelo?\u0022,hr:\u0022Jeste li sigurni da \u017Eelite obrisati ovaj predlo\u017Eak?\u0022,cz:\u0022Are you sure you want to delete this template?\u0022,sk:\u0022Are you sure you want to delete this template?\u0022,gr:\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03B9 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03B3\u03C1\u03AC\u03C8\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C0\u03C1\u03CC\u03C4\u03C5\u03C0\u03BF;\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0448\u0430\u0431\u043B\u043E\u043D?\u0022,ko:\u0022Are you sure you want to delete this template?\u0022},DPe={en:\u0022Save Template\u0022,fr:\u0022Enregistrer le mod\u00E8le\u0022,es:\u0022Guardar plantilla\u0022,cn:\u0022\u4FDD\u5B58\u6A21\u677F\u0022,it:\u0022Salva modello\u0022,de:\u0022Vorlage speichern\u0022,ja:\u0022\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u3092\u4FDD\u5B58\u0022,pl:\u0022Zapisz szablon\u0022,pt:\u0022Salvar modelo\u0022,hr:\u0022Spremi predlo\u017Eak\u0022,cz:\u0022Ulo\u017Eit \u0161ablonu\u0022,sk:\u0022Ulo\u017Ei\u0165 \u0161abl\u00F3nu\u0022,gr:\u0022\u0391\u03C0\u03BF\u03B8\u03AE\u03BA\u03B5\u03C5\u03C3\u03B7 \u03C0\u03C1\u03BF\u03C4\u03CD\u03C0\u03BF\u03C5\u0022,ru:\u0022\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0448\u0430\u0431\u043B\u043E\u043D\u0022,ko:\u0022\uD15C\uD50C\uB9BF \uC800\uC7A5\u0022},OPe={en:\u0022Output (HTML)\u0022,fr:\u0022Sortie (HTML)\u0022,es:\u0022Salida (HTML)\u0022,cn:\u0022\u8F93\u51FA (HTML)\u0022,it:\u0022Output (HTML)\u0022,de:\u0022Ausgabe (HTML)\u0022,ja:\u0022\u51FA\u529B (HTML)\u0022,pl:\u0022Wyj\u015Bcie (HTML)\u0022,pt:\u0022Sa\u00EDda (HTML)\u0022,hr:\u0022Izlaz (HTML)\u0022,cz:\u0022V\u00FDstup (HTML)\u0022,sk:\u0022V\u00FDstup (HTML)\u0022,gr:\u0022\u0388\u03BE\u03BF\u03B4\u03BF\u03C2 (HTML)\u0022,ru:\u0022\u0412\u044B\u0432\u043E\u0434 (HTML)\u0022,ko:\u0022\uCD9C\uB825 (HTML)\u0022},HPe={en:\u0022No template selected\u0022,fr:\u0022Aucun mod\u00E8le s\u00E9lectionn\u00E9\u0022,es:\u0022Ninguna plantilla seleccionada\u0022,cn:\u0022\u672A\u9009\u62E9\u6A21\u677F\u0022,it:\u0022Nessun modello selezionato\u0022,de:\u0022No template selected\u0022,ja:\u0022\u30C6\u30F3\u30D7\u30EC\u30FC\u30C8\u304C\u9078\u629E\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u0022,pl:\u0022Nie wybrano szablonu\u0022,pt:\u0022Nenhum modelo selecionado\u0022,hr:\u0022Nema odabranog predlo\u0161ka\u0022,cz:\u0022No template selected\u0022,sk:\u0022No template selected\u0022,gr:\u0022\u0394\u03B5\u03BD \u03B5\u03C0\u03B9\u03BB\u03AD\u03C7\u03B8\u03B7\u03BA\u03B5 \u03C0\u03C1\u03CC\u03C4\u03C5\u03C0\u03BF\u0022,ru:\u0022\u0428\u0430\u0431\u043B\u043E\u043D \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u0022,ko:\u0022No template selected\u0022},GPe={en:\u0022A Player is awarded a Victory Counter for each enemy Scoring Unit removed as casualty or both fleeing and shattered at the end of the game. Each friendly Scoring Unit in the opponent deployment at the end of the game also awards a Victory counter.\u0022,fr:\u0022Un Joueur re\u00E7oit un Compteur de Victoire pour chaque Unit\u00E9 de Score ennemie supprim\u00E9e comme victime ou \u00E0 la fois en fuite et bris\u00E9e \u00E0 la fin de la partie. Chaque Unit\u00E9 de Score amie dans le d\u00E9ploiement adverse \u00E0 la fin de la partie octroie \u00E9galement un Compteur de Victoire.\u0022,es:\u0022Un Jugador recibe un Contador de Victoria por cada Unidad de Puntuaci\u00F3n enemiga eliminada como baja o tanto huyendo como destrozada al final del juego. Cada Unidad de Puntuaci\u00F3n aliada en el despliegue oponente al final del juego tambi\u00E9n otorga un Contador de Victoria.\u0022,cn:\u0022\u73A9\u5BB6\u4E3A\u6BCF\u4E2A\u5728\u6E38\u620F\u7ED3\u675F\u65F6\u88AB\u79FB\u9664\u4F5C\u4E3A\u4F24\u4EA1\u6216\u65E2\u9003\u8DD1\u53C8\u7834\u788E\u7684\u654C\u65B9\u5F97\u5206\u5355\u4F4D\u83B7\u5F97\u4E00\u4E2A\u80DC\u5229\u8BA1\u6570\u5668\u3002\u5728\u6E38\u620F\u7ED3\u675F\u65F6\u4F4D\u4E8E\u5BF9\u624B\u90E8\u7F72\u533A\u7684\u6BCF\u4E2A\u53CB\u65B9\u5F97\u5206\u5355\u4F4D\u4E5F\u4F1A\u83B7\u5F97\u4E00\u4E2A\u80DC\u5229\u8BA1\u6570\u5668\u3002\u0022,it:\u0022Un Giocatore riceve un Contatore di Vittoria per ogni Unit\u00E0 di Punteggio nemica rimossa come perdita o sia in fuga che distrutta alla fine della partita. Ogni Unit\u00E0 di Punteggio amica nel dispiegamento avversario alla fine della partita assegna anche un contatore di Vittoria.\u0022,de:\u0022A Player is awarded a Victory Counter for each enemy Scoring Unit removed as casualty or both fleeing and shattered at the end of the game. Each friendly Scoring Unit in the opponent deployment at the end of the game also awards a Victory counter.\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u3001\u30B2\u30FC\u30E0\u7D42\u4E86\u6642\u306B\u6B7B\u50B7\u8005\u3068\u3057\u3066\u9664\u53BB\u3055\u308C\u305F\u304B\u3001\u9003\u8D70\u3057\u3066\u7C89\u7815\u3055\u308C\u305F\u6575\u306E\u30B9\u30B3\u30A2\u30EA\u30F3\u30B0\u30E6\u30CB\u30C3\u30C8\u3054\u3068\u306B\u52DD\u5229\u30AB\u30A6\u30F3\u30BF\u30FC\u3092\u7372\u5F97\u3057\u307E\u3059\u3002\u30B2\u30FC\u30E0\u7D42\u4E86\u6642\u306B\u5BFE\u6226\u76F8\u624B\u306E\u914D\u7F6E\u30A8\u30EA\u30A2\u306B\u3044\u308B\u5473\u65B9\u306E\u30B9\u30B3\u30A2\u30EA\u30F3\u30B0\u30E6\u30CB\u30C3\u30C8\u3082\u52DD\u5229\u30AB\u30A6\u30F3\u30BF\u30FC\u3092\u7372\u5F97\u3057\u307E\u3059\u3002\u0022,pl:\u0022Gracz otrzymuje Licznik Zwyci\u0119stwa za ka\u017Cd\u0105 wrog\u0105 Jednostk\u0119 Punktuj\u0105c\u0105 usuni\u0119t\u0105 jako strata lub zar\u00F3wno uciekaj\u0105c\u0105, jak i roztrzaskan\u0105 na koniec gry. Ka\u017Cda przyjazna Jednostka Punktuj\u0105ca w rozmieszczeniu przeciwnika na koniec gry r\u00F3wnie\u017C przyznaje Licznik Zwyci\u0119stwa.\u0022,pt:\u0022Um Jogador \u00E9 premiado com um Contador de Vit\u00F3ria para cada Unidade de Pontua\u00E7\u00E3o inimiga removida como baixa ou ambos em fuga e destru\u00EDda no final do jogo. Cada Unidade de Pontua\u00E7\u00E3o amiga na implanta\u00E7\u00E3o do oponente no final do jogo tamb\u00E9m concede um contador de Vit\u00F3ria.\u0022,hr:\u0022Broja\u010D bodova cilja\u0022,cz:\u0022A Player is awarded a Victory Counter for each enemy Scoring Unit removed as casualty or both fleeing and shattered at the end of the game. Each friendly Scoring Unit in the opponent deployment at the end of the game also awards a Victory counter.\u0022,sk:\u0022A Player is awarded a Victory Counter for each enemy Scoring Unit removed as casualty or both fleeing and shattered at the end of the game. Each friendly Scoring Unit in the opponent deployment at the end of the game also awards a Victory counter.\u0022,gr:\u0022\u039C\u03B5\u03C4\u03C1\u03B7\u03C4\u03AE\u03C2 \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD \u03C3\u03C4\u03CC\u03C7\u03BF\u03C5\u0022,ru:\u0022\u0421\u0447\u0435\u0442\u0447\u0438\u043A \u043E\u0447\u043A\u043E\u0432 \u0437\u0430 \u0437\u0430\u0434\u0430\u0447\u0443\u0022,ko:\u0022A Player is awarded a Victory Counter for each enemy Scoring Unit removed as casualty or both fleeing and shattered at the end of the game. Each friendly Scoring Unit in the opponent deployment at the end of the game also awards a Victory counter.\u0022},VPe={en:\u0022At the end of the game, the player with the most Victory Counters wins this Secondary Objective.\u0022,fr:\u0022\u00C0 la fin de la partie, le joueur avec le plus de Compteurs de Victoire gagne cet Objectif Secondaire.\u0022,es:\u0022Al final del juego, el jugador con m\u00E1s Contadores de Victoria gana este Objetivo Secundario.\u0022,cn:\u0022\u5728\u6E38\u620F\u7ED3\u675F\u65F6\uFF0C\u62E5\u6709\u6700\u591A\u80DC\u5229\u8BA1\u6570\u5668\u7684\u73A9\u5BB6\u8D62\u5F97\u6B64\u6B21\u8981\u76EE\u6807\u3002\u0022,it:\u0022Alla fine della partita, il giocatore con pi\u00F9 Contatori di Vittoria vince questo Obiettivo Secondario.\u0022,de:\u0022At the end of the game, the player with the most Victory Counters wins this Secondary Objective.\u0022,ja:\u0022\u30B2\u30FC\u30E0\u7D42\u4E86\u6642\u306B\u6700\u3082\u591A\u304F\u306E\u52DD\u5229\u30AB\u30A6\u30F3\u30BF\u30FC\u3092\u6301\u3063\u3066\u3044\u308B\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u3053\u306E\u526F\u6B21\u76EE\u6A19\u306B\u52DD\u5229\u3057\u307E\u3059\u3002\u0022,pl:\u0022Na koniec gry, gracz z najwi\u0119ksz\u0105 liczb\u0105 Licznik\u00F3w Zwyci\u0119stwa wygrywa ten Cel Drugorz\u0119dny.\u0022,pt:\u0022No final do jogo, o jogador com mais Contadores de Vit\u00F3ria vence este Objetivo Secund\u00E1rio.\u0022,hr:\u0022Kliknite za pove\u0107anje, desni klik za smanjenje\u0022,cz:\u0022At the end of the game, the player with the most Victory Counters wins this Secondary Objective.\u0022,sk:\u0022At the end of the game, the player with the most Victory Counters wins this Secondary Objective.\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03BF\u03BB\u03BF\u03C5\u03B8\u03AE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C0\u03CC\u03BD\u03C4\u03BF\u03C5\u03C2 \u03B3\u03B9\u03B1 \u03BA\u03AC\u03B8\u03B5 \u03C3\u03C4\u03CC\u03C7\u03BF\u0022,ru:\u0022\u041E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043E\u0447\u043A\u0438 \u0437\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438\u0022,ko:\u0022At the end of the game, the player with the most Victory Counters wins this Secondary Objective.\u0022},WPe={en:\u0022Immediately after determining Deployment Zones, both players place one marker on the Battlefield, starting with the player who chose their Deployment Zone. Each player must place the marker with its centre on a point that is more than 12\u2033 away from their Deployment Zone and at least a third of the long Board Edge length (24\u2033 on a standard board) from the point marked by the other marker. A marker is controlled by the player with the most Scoring Units within 6\u2033 of the centre of the marker. If a unit is within 6\u2033 of the centres of both markers, it only counts as within 6\u2033 of the centre of the marker which is closest to its Centre (randomise if both markers\u0027 centres are equally close).\u0022,fr:\u0022Imm\u00E9diatement apr\u00E8s avoir d\u00E9termin\u00E9 les Zones de D\u00E9ploiement, les deux joueurs placent un marqueur sur le Champ de Bataille, en commen\u00E7ant par le joueur qui a choisi sa Zone de D\u00E9ploiement. Chaque joueur doit placer le marqueur avec son centre sur un point qui est \u00E0 plus de 12\u2033 de sa Zone de D\u00E9ploiement et au moins \u00E0 un tiers de la longueur du Bord de Plateau long (24\u2033 sur un plateau standard) du point marqu\u00E9 par l\u0027autre marqueur. Un marqueur est contr\u00F4l\u00E9 par le joueur ayant le plus d\u0027Unit\u00E9s de Score dans un rayon de 6\u2033 du centre du marqueur. Si une unit\u00E9 se trouve dans un rayon de 6\u2033 des centres des deux marqueurs, elle ne compte que comme \u00E9tant dans un rayon de 6\u2033 du centre du marqueur le plus proche de son Centre (al\u00E9atoire si les centres des deux marqueurs sont \u00E9quidistants).\u0022,es:\u0022Inmediatamente despu\u00E9s de determinar las Zonas de Despliegue, ambos jugadores colocan un marcador en el Campo de Batalla, comenzando por el jugador que eligi\u00F3 su Zona de Despliegue. Cada jugador debe colocar el marcador con su centro en un punto que est\u00E9 a m\u00E1s de 12\u2033 de su Zona de Despliegue y al menos a un tercio de la longitud del Borde Largo del Tablero (24\u2033 en un tablero est\u00E1ndar) del punto marcado por el otro marcador. Un marcador es controlado por el jugador con m\u00E1s Unidades de Puntuaci\u00F3n dentro de 6\u2033 del centro del marcador. Si una unidad est\u00E1 dentro de 6\u2033 de los centros de ambos marcadores, solo cuenta como estando dentro de 6\u2033 del centro del marcador que est\u00E9 m\u00E1s cerca de su Centro (aleatorio si los centros de ambos marcadores est\u00E1n igualmente cerca).\u0022,cn:\u0022\u5728\u786E\u5B9A\u90E8\u7F72\u533A\u540E\u7ACB\u5373\uFF0C\u53CC\u65B9\u73A9\u5BB6\u5728\u6218\u573A\u4E0A\u653E\u7F6E\u4E00\u4E2A\u6807\u8BB0\uFF0C\u4ECE\u9009\u62E9\u90E8\u7F72\u533A\u7684\u73A9\u5BB6\u5F00\u59CB\u3002\u6BCF\u4E2A\u73A9\u5BB6\u5FC5\u987B\u5C06\u6807\u8BB0\u7684\u4E2D\u5FC3\u653E\u5728\u8DDD\u79BB\u5176\u90E8\u7F72\u533A\u8D85\u8FC712\u2033\u5E76\u4E14\u8DDD\u79BB\u53E6\u4E00\u4E2A\u6807\u8BB0\u70B9\u81F3\u5C11\u4E09\u5206\u4E4B\u4E00\u957F\u8FB9\u957F\u5EA6\uFF08\u6807\u51C6\u68CB\u76D824\u2033\uFF09\u7684\u70B9\u4E0A\u3002\u6807\u8BB0\u7531\u5728\u6807\u8BB0\u4E2D\u5FC36\u2033\u8303\u56F4\u5185\u62E5\u6709\u6700\u591A\u5F97\u5206\u5355\u4F4D\u7684\u73A9\u5BB6\u63A7\u5236\u3002\u5982\u679C\u4E00\u4E2A\u5355\u4F4D\u5728\u4E24\u4E2A\u6807\u8BB0\u4E2D\u5FC3\u76846\u2033\u8303\u56F4\u5185\uFF0C\u5B83\u53EA\u7B97\u4F5C\u5728\u79BB\u5176\u4E2D\u5FC3\u6700\u8FD1\u7684\u6807\u8BB0\u4E2D\u5FC36\u2033\u8303\u56F4\u5185\uFF08\u5982\u679C\u4E24\u4E2A\u6807\u8BB0\u4E2D\u5FC3\u7B49\u8DDD\u79BB\u5219\u968F\u673A\u51B3\u5B9A\uFF09\u3002\u0022,it:\u0022Immediatamente dopo aver determinato le Zone di Schieramento, entrambi i giocatori piazzano un segnalino sul Campo di Battaglia, iniziando con il giocatore che ha scelto la propria Zona di Schieramento. Ogni giocatore deve piazzare il segnalino con il suo centro su un punto che si trova a pi\u00F9 di 12\u2033 dalla propria Zona di Schieramento e almeno un terzo della lunghezza del Bordo del Tavolo lungo (24\u2033 su un tavolo standard) dal punto segnato dall\u0027altro segnalino. Un segnalino \u00E8 controllato dal giocatore con il maggior numero di Unit\u00E0 di Punteggio entro 6\u2033 dal centro del segnalino. Se un\u0027unit\u00E0 \u00E8 entro 6\u2033 dai centri di entrambi i segnalini, conta solo come entro 6\u2033 dal centro del segnalino pi\u00F9 vicino al suo Centro (casualizza se i centri di entrambi i segnalini sono equidistanti).\u0022,de:\u0022Immediately after determining Deployment Zones, both players place one marker on the Battlefield, starting with the player who chose their Deployment Zone. Each player must place the marker with its centre on a point that is more than 12\u2033 away from their Deployment Zone and at least a third of the long Board Edge length (24\u2033 on a standard board) from the point marked by the other marker. A marker is controlled by the player with the most Scoring Units within 6\u2033 of the centre of the marker. If a unit is within 6\u2033 of the centres of both markers, it only counts as within 6\u2033 of the centre of the marker which is closest to its Centre (randomise if both markers\u0027 centres are equally close).\u0022,ja:\u0022\u914D\u7F6E\u30BE\u30FC\u30F3\u3092\u6C7A\u5B9A\u3057\u305F\u76F4\u5F8C\u306B\u3001\u4E21\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u914D\u7F6E\u30BE\u30FC\u30F3\u3092\u9078\u629E\u3057\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u304B\u3089\u59CB\u3081\u3066\u3001\u6226\u5834\u306B1\u3064\u306E\u30DE\u30FC\u30AB\u30FC\u3092\u914D\u7F6E\u3057\u307E\u3059\u3002\u5404\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u3001\u81EA\u5206\u306E\u914D\u7F6E\u30BE\u30FC\u30F3\u304B\u308912\u30A4\u30F3\u30C1\u4EE5\u4E0A\u96E2\u308C\u3001\u3082\u3046\u4E00\u65B9\u306E\u30DE\u30FC\u30AB\u30FC\u3067\u30DE\u30FC\u30AF\u3055\u308C\u305F\u70B9\u304B\u3089\u9577\u3044\u30DC\u30FC\u30C9\u30A8\u30C3\u30B8\u306E\u9577\u3055\u306E\u5C11\u306A\u304F\u3068\u30823\u5206\u306E1\uFF08\u6A19\u6E96\u30DC\u30FC\u30C9\u306724\u30A4\u30F3\u30C1\uFF09\u96E2\u308C\u305F\u70B9\u306B\u30DE\u30FC\u30AB\u30FC\u306E\u4E2D\u5FC3\u3092\u914D\u7F6E\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u30DE\u30FC\u30AB\u30FC\u306F\u3001\u30DE\u30FC\u30AB\u30FC\u306E\u4E2D\u5FC3\u304B\u30896\u30A4\u30F3\u30C1\u4EE5\u5185\u306B\u6700\u3082\u591A\u304F\u306E\u30B9\u30B3\u30A2\u30EA\u30F3\u30B0\u30E6\u30CB\u30C3\u30C8\u3092\u6301\u3064\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u3088\u3063\u3066\u5236\u5FA1\u3055\u308C\u307E\u3059\u3002\u30E6\u30CB\u30C3\u30C8\u304C\u4E21\u65B9\u306E\u30DE\u30FC\u30AB\u30FC\u306E\u4E2D\u5FC3\u304B\u30896\u30A4\u30F3\u30C1\u4EE5\u5185\u306B\u3042\u308B\u5834\u5408\u3001\u305D\u306E\u30E6\u30CB\u30C3\u30C8\u306F\u4E2D\u5FC3\u306B\u6700\u3082\u8FD1\u3044\u30DE\u30FC\u30AB\u30FC\u306E\u4E2D\u5FC3\u304B\u30896\u30A4\u30F3\u30C1\u4EE5\u5185\u306B\u3042\u308B\u3068\u306E\u307F\u30AB\u30A6\u30F3\u30C8\u3055\u308C\u307E\u3059\uFF08\u4E21\u65B9\u306E\u30DE\u30FC\u30AB\u30FC\u306E\u4E2D\u5FC3\u304C\u7B49\u8DDD\u96E2\u306E\u5834\u5408\u306F\u30E9\u30F3\u30C0\u30E0\u5316\uFF09\u3002\u0022,pl:\u0022Natychmiast po okre\u015Bleniu Stref Rozlokowania, obaj gracze umieszczaj\u0105 jeden znacznik na Polu Bitwy, zaczynaj\u0105c od gracza, kt\u00F3ry wybra\u0142 swoj\u0105 Stref\u0119 Rozlokowania. Ka\u017Cdy gracz musi umie\u015Bci\u0107 znacznik z jego \u015Brodkiem w punkcie oddalonym o wi\u0119cej ni\u017C 12\u2033 od swojej Strefy Rozlokowania i przynajmniej jedn\u0105 trzeci\u0105 d\u0142ugo\u015Bci d\u0142ugiej kraw\u0119dzi planszy (24\u2033 na standardowej planszy) od punktu oznaczonego przez drugi znacznik. Znacznik jest kontrolowany przez gracza z najwi\u0119ksz\u0105 liczb\u0105 Jednostek Punktuj\u0105cych w odleg\u0142o\u015Bci 6\u2033 od \u015Brodka znacznika. Je\u015Bli jednostka znajduje si\u0119 w odleg\u0142o\u015Bci 6\u2033 od \u015Brodk\u00F3w obu znacznik\u00F3w, liczy si\u0119 tylko jako b\u0119d\u0105ca w odleg\u0142o\u015Bci 6\u2033 od \u015Brodka znacznika, kt\u00F3ry jest najbli\u017Cej jej \u015Arodka (losuj, je\u015Bli \u015Brodki obu znacznik\u00F3w s\u0105 r\u00F3wnie blisko).\u0022,pt:\u0027Imediatamente ap\u00F3s determinar as Zonas de Implanta\u00E7\u00E3o, ambos os jogadores colocam um marcador no Campo de Batalha, come\u00E7ando com o jogador que escolheu sua Zona de Implanta\u00E7\u00E3o. Cada jogador deve colocar o marcador com seu centro em um ponto que esteja a mais de 12\u0022 de dist\u00E2ncia de sua Zona de Implanta\u00E7\u00E3o e pelo menos um ter\u00E7o do comprimento da Borda Longa do Tabuleiro (24\u0022 em um tabuleiro padr\u00E3o) do ponto marcado pelo outro marcador. Um marcador \u00E9 controlado pelo jogador com mais Unidades de Pontua\u00E7\u00E3o dentro de 6\u0022 do centro do marcador. Se uma unidade estiver dentro de 6\u0022 dos centros de ambos os marcadores, ela conta apenas como dentro de 6\u0022 do centro do marcador mais pr\u00F3ximo de seu Centro (randomize se os centros de ambos os marcadores estiverem igualmente pr\u00F3ximos).\u0027,hr:\u0022Ozna\u010Diva\u010D cilja\u0022,cz:\u0022Immediately after determining Deployment Zones, both players place one marker on the Battlefield, starting with the player who chose their Deployment Zone. Each player must place the marker with its centre on a point that is more than 12\u2033 away from their Deployment Zone and at least a third of the long Board Edge length (24\u2033 on a standard board) from the point marked by the other marker. A marker is controlled by the player with the most Scoring Units within 6\u2033 of the centre of the marker. If a unit is within 6\u2033 of the centres of both markers, it only counts as within 6\u2033 of the centre of the marker which is closest to its Centre (randomise if both markers\u0027 centres are equally close).\u0022,sk:\u0022Immediately after determining Deployment Zones, both players place one marker on the Battlefield, starting with the player who chose their Deployment Zone. Each player must place the marker with its centre on a point that is more than 12\u2033 away from their Deployment Zone and at least a third of the long Board Edge length (24\u2033 on a standard board) from the point marked by the other marker. A marker is controlled by the player with the most Scoring Units within 6\u2033 of the centre of the marker. If a unit is within 6\u2033 of the centres of both markers, it only counts as within 6\u2033 of the centre of the marker which is closest to its Centre (randomise if both markers\u0027 centres are equally close).\u0022,gr:\u0022\u0394\u03B5\u03AF\u03BA\u03C4\u03B7\u03C2 \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD \u03C3\u03C4\u03CC\u03C7\u03BF\u03C5\u0022,ru:\u0022\u041C\u0430\u0440\u043A\u0435\u0440\u044B \u043E\u0447\u043A\u043E\u0432 \u0437\u0430 \u0437\u0430\u0434\u0430\u0447\u0443\u0022,ko:\u0022Immediately after determining Deployment Zones, both players place one marker on the Battlefield, starting with the player who chose their Deployment Zone. Each player must place the marker with its centre on a point that is more than 12\u2033 away from their Deployment Zone and at least a third of the long Board Edge length (24\u2033 on a standard board) from the point marked by the other marker. A marker is controlled by the player with the most Scoring Units within 6\u2033 of the centre of the marker. If a unit is within 6\u2033 of the centres of both markers, it only counts as within 6\u2033 of the centre of the marker which is closest to its Centre (randomise if both markers\u0027 centres are equally close).\u0022},YPe={en:\u0022At the end of each Game Turn after the first, a Victory Counter is awarded to the Player which controls the most markers. The Player with the most Victory Counters at the end of the game wins this Secondary objective.\u0022,fr:\u0022\u00C0 la fin de chaque Tour de Jeu apr\u00E8s le premier, un Compteur de Victoire est accord\u00E9 au Joueur qui contr\u00F4le le plus de marqueurs. Le Joueur avec le plus de Compteurs de Victoire \u00E0 la fin de la partie gagne cet Objectif Secondaire.\u0022,es:\u0022Al final de cada Turno de Juego despu\u00E9s del primero, se otorga un Contador de Victoria al Jugador que controla m\u00E1s marcadores. El Jugador con m\u00E1s Contadores de Victoria al final del juego gana este Objetivo Secundario.\u0022,cn:\u0022\u5728\u7B2C\u4E00\u4E2A\u6E38\u620F\u56DE\u5408\u4E4B\u540E\u7684\u6BCF\u4E2A\u6E38\u620F\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u63A7\u5236\u6700\u591A\u6807\u8BB0\u7684\u73A9\u5BB6\u5C06\u83B7\u5F97\u4E00\u4E2A\u80DC\u5229\u8BA1\u6570\u5668\u3002\u5728\u6E38\u620F\u7ED3\u675F\u65F6\u62E5\u6709\u6700\u591A\u80DC\u5229\u8BA1\u6570\u5668\u7684\u73A9\u5BB6\u8D62\u5F97\u6B64\u6B21\u8981\u76EE\u6807\u3002\u0022,it:\u0022Alla fine di ogni Turno di Gioco dopo il primo, un Contatore di Vittoria viene assegnato al Giocatore che controlla pi\u00F9 segnalini. Il Giocatore con pi\u00F9 Contatori di Vittoria alla fine della partita vince questo obiettivo Secondario.\u0022,de:\u0022At the end of each Game Turn after the first, a Victory Counter is awarded to the Player which controls the most markers. The Player with the most Victory Counters at the end of the game wins this Secondary objective.\u0022,ja:\u0022\u6700\u521D\u306E\u30B2\u30FC\u30E0\u30BF\u30FC\u30F3\u5F8C\u306E\u5404\u30B2\u30FC\u30E0\u30BF\u30FC\u30F3\u306E\u7D42\u4E86\u6642\u306B\u3001\u6700\u3082\u591A\u304F\u306E\u30DE\u30FC\u30AB\u30FC\u3092\u5236\u5FA1\u3057\u3066\u3044\u308B\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u52DD\u5229\u30AB\u30A6\u30F3\u30BF\u30FC\u304C\u6388\u4E0E\u3055\u308C\u307E\u3059\u3002\u30B2\u30FC\u30E0\u7D42\u4E86\u6642\u306B\u6700\u3082\u591A\u304F\u306E\u52DD\u5229\u30AB\u30A6\u30F3\u30BF\u30FC\u3092\u6301\u3063\u3066\u3044\u308B\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u3053\u306E\u526F\u6B21\u76EE\u6A19\u306B\u52DD\u5229\u3057\u307E\u3059\u3002\u0022,pl:\u0022Na ko\u0144cu ka\u017Cdej Tury Gry po pierwszej, Licznik Zwyci\u0119stwa jest przyznawany Graczowi, kt\u00F3ry kontroluje najwi\u0119ksz\u0105 liczb\u0119 znacznik\u00F3w. Gracz z najwi\u0119ksz\u0105 liczb\u0105 Licznik\u00F3w Zwyci\u0119stwa na koniec gry wygrywa ten Cel Drugorz\u0119dny.\u0022,pt:\u0022No final de cada Turno de Jogo ap\u00F3s o primeiro, um Contador de Vit\u00F3ria \u00E9 concedido ao Jogador que controla a maioria dos marcadores. O Jogador com mais Contadores de Vit\u00F3ria no final do jogo vence este objetivo secund\u00E1rio.\u0022,hr:\u0022Kliknite za ozna\u010Davanje je li cilj postignut\u0022,cz:\u0022At the end of each Game Turn after the first, a Victory Counter is awarded to the Player which controls the most markers. The Player with the most Victory Counters at the end of the game wins this Secondary objective.\u0022,sk:\u0022At the end of each Game Turn after the first, a Victory Counter is awarded to the Player which controls the most markers. The Player with the most Victory Counters at the end of the game wins this Secondary objective.\u0022,gr:\u0022\u03A3\u03B7\u03BC\u03B5\u03B9\u03CE\u03C3\u03C4\u03B5 \u03C4\u03BF\u03C5\u03C2 \u03C3\u03C4\u03CC\u03C7\u03BF\u03C5\u03C2 \u03C0\u03BF\u03C5 \u03BF\u03BB\u03BF\u03BA\u03BB\u03B7\u03C1\u03CE\u03B8\u03B7\u03BA\u03B1\u03BD\u0022,ru:\u0022\u0420\u0430\u0437\u043C\u0435\u0449\u0430\u0439\u0442\u0435 \u043C\u0430\u0440\u043A\u0435\u0440\u044B \u0434\u043B\u044F \u043F\u043E\u0434\u0441\u0447\u0435\u0442\u0430 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022At the end of each Game Turn after the first, a Victory Counter is awarded to the Player which controls the most markers. The Player with the most Victory Counters at the end of the game wins this Secondary objective.\u0022},KPe={en:\u0022Select a Force to replace {force}\u0022,fr:\u0022S\u00E9lectionner une Force pour remplacer {force}\u0022,es:\u0022Seleccionar una Fuerza para reemplazar {force}\u0022,cn:\u0022\u9009\u62E9\u4E00\u4E2A\u90E8\u961F\u6765\u66FF\u6362{force}\u0022,it:\u0022Seleziona una Forza da sostituire a {force}\u0022,de:\u0022Select a Force to replace {force}\u0022,ja:\u0022{force} \u3092\u7F6E\u304D\u63DB\u3048\u308B\u6226\u529B\u3092\u9078\u629E\u0022,pl:\u0022Wybierz Si\u0142\u0119 do zast\u0105pienia {force}\u0022,pt:\u0022Selecione uma For\u00E7a para substituir {force}\u0022,hr:\u0022Odaberi jedinicu za zamjenu\u0022,cz:\u0022Select a Force to replace {force}\u0022,sk:\u0022Select a Force to replace {force}\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7\u03C2 \u03B3\u03B9\u03B1 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u0022,ru:\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0442\u0440\u044F\u0434 \u0434\u043B\u044F \u0437\u0430\u043C\u0435\u043D\u044B\u0022,ko:\u0022a Force to replace {force} \uC120\uD0DD\u0022},qPe={en:\u0022Select a Force\u0022,fr:\u0022S\u00E9lectionner une Force\u0022,es:\u0022Seleccionar una Fuerza\u0022,cn:\u0022\u9009\u62E9\u90E8\u961F\u0022,it:\u0022Seleziona una Forza\u0022,de:\u0022Select a Force\u0022,ja:\u0022\u6226\u529B\u3092\u9078\u629E\u0022,pl:\u0022Wybierz Si\u0142\u0119\u0022,pt:\u0022Selecionar uma For\u00E7a\u0022,hr:\u0022Odaberi jedinicu\u0022,cz:\u0022Select a Force\u0022,sk:\u0022Select a Force\u0022,gr:\u0022\u0395\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE a \u0394\u03CD\u03BD\u03B1\u03BC\u03B7\u0022,ru:\u0022\u0412\u044B\u0431\u0440\u0430\u0442\u044C a \u0410\u0440\u043C\u0438\u044F\u0022,ko:\u0022a Force \uC120\uD0DD\u0022},JPe={en:\u0022Support New Recruit to\u0022,fr:\u0022Soutenez New Recruit pour\u0022,es:\u0022Apoya a New Recruit para\u0022,cn:\u0022\u652F\u6301 New Recruit \u4EE5\u0022,it:\u0022Supporta New Recruit per\u0022,de:\u0022Support New Recruit to\u0022,ja:\u0022New Recruit\u3092\u30B5\u30DD\u30FC\u30C8\u3057\u3066\u0022,pl:\u0022Wesprzyj New Recruit, aby\u0022,pt:\u0022Apoie o New Recruit para\u0022,hr:\u0022Podr\u017Eite New Recruit uklanjanjem oglasa\u0022,cz:\u0022Support New Recruit to\u0022,sk:\u0022Support New Recruit to\u0022,gr:\u0022\u03A5\u03C0\u03BF\u03C3\u03C4\u03B7\u03C1\u03AF\u03BE\u03C4\u03B5 \u03C4\u03B7\u03BD \u03B1\u03BD\u03AC\u03C0\u03C4\u03C5\u03BE\u03B7\u0022,ru:\u0022\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0442\u0435 New Recruit \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0440\u0435\u043A\u043B\u0430\u043C\u0443\u0022,ko:\u0022Support New Recruit to\u0022},$Pe={en:\u0022enjoy an ad free experience!\u0022,fr:\u0022profiter d\u0027une exp\u00E9rience sans pub!\u0022,es:\u0022disfrutar de una experiencia sin anuncios!\u0022,cn:\u0022\u4EAB\u53D7\u65E0\u5E7F\u544A\u4F53\u9A8C\uFF01\u0022,it:\u0022godere di un\u0027esperienza senza pubblicit\u00E0!\u0022,de:\u0022enjoy an ad free experience!\u0022,ja:\u0022\u5E83\u544A\u306A\u3057\u306E\u4F53\u9A13\u3092\u304A\u697D\u3057\u307F\u304F\u3060\u3055\u3044\uFF01\u0022,pl:\u0022cieszy\u0107 si\u0119 do\u015Bwiadczeniem bez reklam!\u0022,pt:\u0022desfrutar de uma experi\u00EAncia sem an\u00FAncios!\u0022,