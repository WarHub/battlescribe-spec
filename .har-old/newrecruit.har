1 \u03B5\u03AF\u03C3\u03C4\u03B5 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B4\u03B5\u03BC\u03AD\u03BD\u03BF\u03B9 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,\u0022\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0430\u0432\u0442\u043E\u0440\u0438\u0437\u043E\u0432\u0430\u043D\u044B, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u043F\u0430\u0440\u043E\u043B\u044C.\u0022,{\u0022en\u0022:412,\u0022fr\u0022:413,\u0022es\u0022:414,\u0022cn\u0022:415,\u0022it\u0022:416,\u0022de\u0022:417,\u0022ja\u0022:418,\u0022pl\u0022:419,\u0022pt\u0022:420,\u0022hr\u0022:421,\u0022cz\u0022:422,\u0022sk\u0022:423,\u0022gr\u0022:424,\u0022ru\u0022:425,\u0022ko\u0022:412},\u0022Passwords do not match.\u0022,\u0022Les mots de passe ne correspondent pas.\u0022,\u0022Las contrase\u00F1as no coinciden.\u0022,\u0022\u5BC6\u7801\u4E0D\u5339\u914D\u3002\u0022,\u0022Le password non corrispondono.\u0022,\u0022Passw\u00F6rter stimmen nicht \u00FCberein.\u0022,\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u4E00\u81F4\u3057\u307E\u305B\u3093\u3002\u0022,\u0022Has\u0142a nie pasuj\u0105.\u0022,\u0022As senhas n\u00E3o correspondem.\u0022,\u0022Lozinke se ne podudaraju.\u0022,\u0022Hesla se neshoduj\u00ED.\u0022,\u0022Hesl\u00E1 sa nezhoduj\u00FA.\u0022,\u0022\u039F\u03B9 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03AF \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03B4\u03B5\u03BD \u03C4\u03B1\u03B9\u03C1\u03B9\u03AC\u03B6\u03BF\u03C5\u03BD\u0022,\u0022\u041F\u0430\u0440\u043E\u043B\u0438 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442.\u0022,{\u0022en\u0022:427,\u0022fr\u0022:428,\u0022es\u0022:429,\u0022cn\u0022:430,\u0022it\u0022:431,\u0022de\u0022:432,\u0022ja\u0022:433,\u0022pl\u0022:434,\u0022pt\u0022:435,\u0022hr\u0022:436,\u0022cz\u0022:437,\u0022sk\u0022:438,\u0022gr\u0022:439,\u0022ru\u0022:440,\u0022ko\u0022:427},\u0022Please enter a username.\u0022,\u0022Veuillez entrer un nom d\u0027utilisateur.\u0022,\u0022Por favor ingrese un nombre de usuario.\u0022,\u0022\u8BF7\u8F93\u5165\u7528\u6237\u540D\u3002\u0022,\u0022Inserisci un nome utente.\u0022,\u0022Bitte geben Sie einen Benutzernamen ein.\u0022,\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,\u0022Prosz\u0119 wprowadzi\u0107 nazw\u0119 u\u017Cytkownika.\u0022,\u0022Por favor, insira um nome de usu\u00E1rio.\u0022,\u0022Molimo unesite korisni\u010Dko ime.\u0022,\u0022Pros\u00EDm zadejte u\u017Eivatelsk\u00E9 jm\u00E9no.\u0022,\u0022Pros\u00EDm zadajte pou\u017E\u00EDvate\u013Esk\u00E9 meno.\u0022,\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B5\u03B9\u03C3\u03AC\u03B3\u03B5\u03C4\u03B5 \u03AD\u03BD\u03B1 \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7\u0022,\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F.\u0022,{\u0022en\u0022:442,\u0022fr\u0022:443,\u0022es\u0022:444,\u0022cn\u0022:445,\u0022it\u0022:446,\u0022de\u0022:447,\u0022ja\u0022:448,\u0022pl\u0022:449,\u0022pt\u0022:450,\u0022hr\u0022:451,\u0022cz\u0022:452,\u0022sk\u0022:453,\u0022gr\u0022:454,\u0022ru\u0022:455,\u0022ko\u0022:442},\u0022Please enter a password that contains at least 5 characters.\u0022,\u0022Veuillez entrer un mot de passe contenant au moins 5 caract\u00E8res.\u0022,\u0022Por favor ingrese una contrase\u00F1a que contenga al menos 5 caracteres.\u0022,\u0022\u8BF7\u8F93\u5165\u81F3\u5C11\u5305\u542B5\u4E2A\u5B57\u7B26\u7684\u5BC6\u7801\u3002\u0022,\u0022Inserisci una password che contenga almeno 5 caratteri.\u0022,\u0022Bitte geben Sie ein Passwort mit mindestens 5 Zeichen ein.\u0022,\u0022\u5C11\u306A\u304F\u3068\u30825\u6587\u5B57\u3092\u542B\u3080\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,\u0022Prosz\u0119 wprowadzi\u0107 has\u0142o zawieraj\u0105ce co najmniej 5 znak\u00F3w.\u0022,\u0022Por favor, insira uma senha que contenha pelo menos 5 caracteres.\u0022,\u0022Molimo unesite lozinku koja sadr\u017Ei najmanje 5 znakova.\u0022,\u0022Pros\u00EDm zadejte heslo obsahuj\u00EDc\u00ED alespo\u0148 5 znak\u016F.\u0022,\u0022Pros\u00EDm zadajte heslo, ktor\u00E9 obsahuje minim\u00E1lne 5 znakov.\u0022,\u0022\u039F \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C4\u03BF\u03C5\u03BB\u03AC\u03C7\u03B9\u03C3\u03C4\u03BF\u03BD 5 \u03C7\u03B1\u03C1\u03B1\u03BA\u03C4\u03AE\u03C1\u03B5\u03C2\u0022,\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0430\u0440\u043E\u043B\u044C, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 5 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432.\u0022,{\u0022en\u0022:457,\u0022fr\u0022:458,\u0022es\u0022:459,\u0022cn\u0022:460,\u0022it\u0022:461,\u0022de\u0022:462,\u0022ja\u0022:463,\u0022pl\u0022:464,\u0022pt\u0022:465,\u0022hr\u0022:466,\u0022cz\u0022:467,\u0022sk\u0022:468,\u0022gr\u0022:469,\u0022ru\u0022:470,\u0022ko\u0022:457},\u0022Your username and password have been updated! You will be logged out.\u0022,\u0022Votre nom d\u0027utilisateur et mot de passe ont \u00E9t\u00E9 mis \u00E0 jour ! Vous allez \u00EAtre d\u00E9connect\u00E9.\u0022,\u0022\u00A1Tu nombre de usuario y contrase\u00F1a han sido actualizados! Ser\u00E1s desconectado.\u0022,\u0022\u60A8\u7684\u7528\u6237\u540D\u548C\u5BC6\u7801\u5DF2\u66F4\u65B0\uFF01\u60A8\u5C06\u88AB\u6CE8\u9500\u3002\u0022,\u0022Il tuo nome utente e password sono stati aggiornati! Verrai disconnesso.\u0022,\u0022Ihr Benutzername und Passwort wurden aktualisiert! Sie werden abgemeldet.\u0022,\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3068\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u66F4\u65B0\u3055\u308C\u307E\u3057\u305F\uFF01\u30ED\u30B0\u30A2\u30A6\u30C8\u3055\u308C\u307E\u3059\u3002\u0022,\u0022Twoja nazwa u\u017Cytkownika i has\u0142o zosta\u0142y zaktualizowane! Zostaniesz wylogowany.\u0022,\u0022Seu nome de usu\u00E1rio e senha foram atualizados! Voc\u00EA ser\u00E1 desconectado.\u0022,\u0022Va\u0161e korisni\u010Dko ime i lozinka su a\u017Eurirani! Bit \u0107ete odjavljeni.\u0022,\u0022Va\u0161e u\u017Eivatelsk\u00E9 jm\u00E9no a heslo byly aktualizov\u00E1ny! Budete odhl\u00E1\u0161eni.\u0022,\u0022Va\u0161e pou\u017E\u00EDvate\u013Esk\u00E9 meno a heslo boli aktualizovan\u00E9! Budete odhl\u00E1sen\u00FD.\u0022,\u0022\u03A4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03BF \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B1\u03BD. \u0398\u03B1 \u03B1\u03C0\u03BF\u03C3\u03C5\u03BD\u03B4\u03B5\u03B8\u03B5\u03AF\u03C4\u03B5.\u0022,\u0022\u0412\u0430\u0448\u0435 \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438 \u043F\u0430\u0440\u043E\u043B\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u044B! \u0412\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u0440\u0430\u0437\u043B\u043E\u0433\u0438\u043D\u0435\u043D\u044B.\u0022,{\u0022en\u0022:472,\u0022fr\u0022:473,\u0022es\u0022:474,\u0022cn\u0022:475,\u0022it\u0022:476,\u0022de\u0022:477,\u0022ja\u0022:478,\u0022pl\u0022:479,\u0022pt\u0022:480,\u0022hr\u0022:481,\u0022cz\u0022:482,\u0022sk\u0022:483,\u0022gr\u0022:484,\u0022ru\u0022:485,\u0022ko\u0022:472},\u0022Your password has been updated!\u0022,\u0022Votre mot de passe a \u00E9t\u00E9 mis \u00E0 jour !\u0022,\u0022\u00A1Tu contrase\u00F1a ha sido actualizada!\u0022,\u0022\u60A8\u7684\u5BC6\u7801\u5DF2\u66F4\u65B0\uFF01\u0022,\u0022La tua password \u00E8 stata aggiornata!\u0022,\u0022Ihr Passwort wurde aktualisiert!\u0022,\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u66F4\u65B0\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,\u0022Twoje has\u0142o zosta\u0142o zaktualizowane!\u0022,\u0022Sua senha foi atualizada!\u0022,\u0022Va\u0161a lozinka je a\u017Eurirana!\u0022,\u0022Va\u0161e heslo bylo aktualizov\u00E1no!\u0022,\u0022Va\u0161e heslo bolo aktualizovan\u00E9!\u0022,\u0022\u039F \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC\u03C2 \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B5\u0022,\u0022\u0412\u0430\u0448 \u043F\u0430\u0440\u043E\u043B\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0451\u043D!\u0022,{\u0022en\u0022:487,\u0022fr\u0022:488,\u0022es\u0022:489,\u0022cn\u0022:490,\u0022it\u0022:491,\u0022de\u0022:492,\u0022ja\u0022:493,\u0022pl\u0022:494,\u0022pt\u0022:495,\u0022hr\u0022:496,\u0022cz\u0022:497,\u0022sk\u0022:498,\u0022gr\u0022:499,\u0022ru\u0022:500,\u0022ko\u0022:487},\u0022This username is already taken!\u0022,\u0022Ce nom d\u0027utilisateur est d\u00E9j\u00E0 pris !\u0022,\u0022\u00A1Este nombre de usuario ya est\u00E1 en uso!\u0022,\u0022\u6B64\u7528\u6237\u540D\u5DF2\u88AB\u4F7F\u7528\uFF01\u0022,\u0022Questo nome utente \u00E8 gi\u00E0 in uso!\u0022,\u0022Dieser Benutzername ist bereits vergeben!\u0022,\u0022\u3053\u306E\u30E6\u30FC\u30B6\u30FC\u540D\u306F\u65E2\u306B\u4F7F\u7528\u3055\u308C\u3066\u3044\u307E\u3059\uFF01\u0022,\u0022Ta nazwa u\u017Cytkownika jest ju\u017C zaj\u0119ta!\u0022,\u0022Este nome de usu\u00E1rio j\u00E1 est\u00E1 em uso!\u0022,\u0022Ovo korisni\u010Dko ime je ve\u0107 zauzeto!\u0022,\u0022Toto u\u017Eivatelsk\u00E9 jm\u00E9no je ji\u017E obsazeno!\u0022,\u0022Toto pou\u017E\u00EDvate\u013Esk\u00E9 meno je u\u017E obsaden\u00E9!\u0022,\u0022\u0391\u03C5\u03C4\u03CC \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B5\u03AF\u03C4\u03B1\u03B9 \u03AE\u03B4\u03B7\u0022,\u0022\u042D\u0442\u043E \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u0442\u043E!\u0022,{\u0022en\u0022:502,\u0022fr\u0022:503,\u0022es\u0022:504,\u0022cn\u0022:505,\u0022it\u0022:506,\u0022de\u0022:507,\u0022ja\u0022:508,\u0022pl\u0022:509,\u0022pt\u0022:510,\u0022hr\u0022:511,\u0022cz\u0022:512,\u0022sk\u0022:513,\u0022gr\u0022:514,\u0022ru\u0022:515,\u0022ko\u0022:502},\u0022Error while updating your username and password!\u0022,\u0022Erreur lors de la mise \u00E0 jour de votre nom d\u0027utilisateur et mot de passe !\u0022,\u0022\u00A1Error al actualizar tu nombre de usuario y contrase\u00F1a!\u0022,\u0022\u66F4\u65B0\u7528\u6237\u540D\u548C\u5BC6\u7801\u65F6\u51FA\u9519\uFF01\u0022,\u0022Errore durante l\u0027aggiornamento del nome utente e password!\u0022,\u0022Fehler beim Aktualisieren Ihres Benutzernamens und Passworts!\u0022,\u0022\u30E6\u30FC\u30B6\u30FC\u540D\u3068\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u66F4\u65B0\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\uFF01\u0022,\u0022B\u0142\u0105d podczas aktualizacji nazwy u\u017Cytkownika i has\u0142a!\u0022,\u0022Erro ao atualizar seu nome de usu\u00E1rio e senha!\u0022,\u0022Gre\u0161ka prilikom a\u017Euriranja korisni\u010Dkog imena i lozinke!\u0022,\u0022Chyba p\u0159i aktualizaci u\u017Eivatelsk\u00E9ho jm\u00E9na a hesla!\u0022,\u0022Chyba pri aktualiz\u00E1cii v\u00E1\u0161ho pou\u017E\u00EDvate\u013Esk\u00E9ho mena a hesla!\u0022,\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BF\u03BD\u03CC\u03BC\u03B1\u03C4\u03BF\u03C2 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03BA\u03B1\u03B9 \u03C4\u03BF\u03C5 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u0438\u043C\u0435\u043D\u0438 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438 \u043F\u0430\u0440\u043E\u043B\u044F!\u0022,{\u0022en\u0022:517,\u0022fr\u0022:518,\u0022es\u0022:519,\u0022cn\u0022:520,\u0022it\u0022:521,\u0022de\u0022:522,\u0022ja\u0022:523,\u0022pl\u0022:524,\u0022pt\u0022:525,\u0022hr\u0022:526,\u0022cz\u0022:527,\u0022sk\u0022:528,\u0022gr\u0022:529,\u0022ru\u0022:530,\u0022ko\u0022:517},\u0022Error while updating your password!\u0022,\u0022Erreur lors de la mise \u00E0 jour de votre mot de passe !\u0022,\u0022\u00A1Error al actualizar tu contrase\u00F1a!\u0022,\u0022\u66F4\u65B0\u5BC6\u7801\u65F6\u51FA\u9519\uFF01\u0022,\u0022Errore durante l\u0027aggiornamento della password!\u0022,\u0022Fehler beim Aktualisieren Ihres Passworts!\u0022,\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u306E\u66F4\u65B0\u4E2D\u306B\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3057\u307E\u3057\u305F\uFF01\u0022,\u0022B\u0142\u0105d podczas aktualizacji has\u0142a!\u0022,\u0022Erro ao atualizar sua senha!\u0022,\u0022Gre\u0161ka prilikom a\u017Euriranja lozinke!\u0022,\u0022Chyba p\u0159i aktualizaci hesla!\u0022,\u0022Chyba pri aktualiz\u00E1cii v\u00E1\u0161ho hesla!\u0022,\u0022\u03A3\u03C6\u03AC\u03BB\u03BC\u03B1 \u03BA\u03B1\u03C4\u03AC \u03C4\u03B7\u03BD \u03B5\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5 \u03BA\u03C9\u03B4\u03B9\u03BA\u03BF\u03CD \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2\u0022,\u0022\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u043F\u0430\u0440\u043E\u043B\u044F!\u0022,{\u0022en\u0022:532,\u0022fr\u0022:533,\u0022es\u0022:534,\u0022cn\u0022:535,\u0022it\u0022:536,\u0022de\u0022:537,\u0022ja\u0022:538,\u0022pl\u0022:539,\u0022pt\u0022:540,\u0022hr\u0022:541,\u0022cz\u0022:542,\u0022sk\u0022:543,\u0022gr\u0022:544,\u0022ru\u0022:545,\u0022ko\u0022:532},\u0022Cannot change password: Unable to connect!\u0022,\u0022Impossible de changer le mot de passe : Connexion impossible !\u0022,\u0022No se puede cambiar la contrase\u00F1a: \u00A1No se pudo conectar!\u0022,\u0022\u65E0\u6CD5\u66F4\u6539\u5BC6\u7801\uFF1A\u65E0\u6CD5\u8FDE\u63A5\uFF01\u0022,\u0022Impossibile cambiare password: Impossibile connettersi!\u0022,\u0022Passwort kann nicht ge\u00E4ndert werden: Verbindung fehlgeschlagen!\u0022,\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5909\u66F4\u3067\u304D\u307E\u305B\u3093\uFF1A\u63A5\u7D9A\u3067\u304D\u307E\u305B\u3093\uFF01\u0022,\u0022Nie mo\u017Cna zmieni\u0107 has\u0142a: Nie mo\u017Cna po\u0142\u0105czy\u0107!\u0022,\u0022N\u00E3o \u00E9 poss\u00EDvel alterar a senha: N\u00E3o foi poss\u00EDvel conectar!\u0022,\u0022Nije mogu\u0107e promijeniti lozinku: Nemogu\u0107e se povezati!\u0022,\u0022Nelze zm\u011Bnit heslo: P\u0159ipojen\u00ED se nezda\u0159ilo!\u0022,\u0022Nemo\u017Eno zmeni\u0165 heslo: Ned\u00E1 sa pripoji\u0165!\u0022,\u0022\u0394\u03B5\u03BD \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C4\u03BF\u03BD \u03BA\u03C9\u03B4\u03B9\u03BA\u03CC \u03C0\u03C1\u03CC\u03C3\u03B2\u03B1\u03C3\u03B7\u03C2 \u03C7\u03C9\u03C1\u03AF\u03C2 \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03C3\u03C4\u03BF \u03B4\u03B9\u03B1\u03B4\u03AF\u03BA\u03C4\u03C5\u03BF\u0022,\u0022\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0430\u0440\u043E\u043B\u044C: \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F!\u0022,{\u0022en\u0022:547,\u0022fr\u0022:548,\u0022es\u0022:549,\u0022cn\u0022:550,\u0022it\u0022:551,\u0022de\u0022:552,\u0022ja\u0022:553,\u0022pl\u0022:554,\u0022pt\u0022:555,\u0022hr\u0022:556,\u0022cz\u0022:557,\u0022sk\u0022:558,\u0022gr\u0022:559,\u0022ru\u0022:560,\u0022ko\u0022:547},\u0022You must enter a password (you can use your current password if you only want to change your username).\u0022,\u0022Vous devez entrer un mot de passe (vous pouvez utiliser votre mot de passe actuel si vous souhaitez seulement changer votre nom d\u0027utilisateur).\u0022,\u0022Debes ingresar una contrase\u00F1a (puedes usar tu contrase\u00F1a actual si solo quieres cambiar tu nombre de usuario).\u0022,\u0022\u60A8\u5FC5\u987B\u8F93\u5165\u5BC6\u7801\uFF08\u5982\u679C\u60A8\u53EA\u60F3\u66F4\u6539\u7528\u6237\u540D\uFF0C\u53EF\u4EE5\u4F7F\u7528\u5F53\u524D\u5BC6\u7801\uFF09\u3002\u0022,\u0022Devi inserire una password (puoi usare la tua password attuale se vuoi solo cambiare il tuo nome utente).\u0022,\u0022Sie m\u00FCssen ein Passwort eingeben (Sie k\u00F6nnen Ihr aktuelles Passwort verwenden, wenn Sie nur Ihren Benutzernamen \u00E4ndern m\u00F6chten).\u0022,\u0022\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u5165\u529B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\uFF08\u30E6\u30FC\u30B6\u30FC\u540D\u306E\u307F\u3092\u5909\u66F4\u3057\u305F\u3044\u5834\u5408\u306F\u3001\u73FE\u5728\u306E\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u4F7F\u7528\u3067\u304D\u307E\u3059\uFF09\u3002\u0022,\u0022Musisz wprowadzi\u0107 has\u0142o (mo\u017Cesz u\u017Cy\u0107 swojego obecnego has\u0142a, je\u015Bli chcesz tylko zmieni\u0107 nazw\u0119 u\u017Cytkownika).\u0022,\u0022Voc\u00EA deve inserir uma senha (voc\u00EA pode usar sua senha atual se quiser apenas alterar seu nome de usu\u00E1rio).\u0022,\u0022Morate unijeti lozinku (mo\u017Eete koristiti trenutnu lozinku ako \u017Eelite promijeniti samo korisni\u010Dko ime).\u0022,\u0022Mus\u00EDte zadat heslo (m\u016F\u017Eete pou\u017E\u00EDt sv\u00E9 sou\u010Dasn\u00E9 heslo, pokud chcete zm\u011Bnit pouze u\u017Eivatelsk\u00E9 jm\u00E9no).\u0022,\u0022Mus\u00EDte zada\u0165 heslo (m\u00F4\u017Eete pou\u017Ei\u0165 aktu\u00E1lne heslo, ak chcete zmeni\u0165 len pou\u017E\u00EDvate\u013Esk\u00E9 meno).\u0022,\u0022\u0395\u03AC\u03BD \u03B1\u03BB\u03BB\u03AC\u03BE\u03B5\u03C4\u03B5 \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03C3\u03B1\u03C2, \u03B8\u03B1 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF \u03BD\u03AD\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1 \u03C7\u03C1\u03AE\u03C3\u03C4\u03B7 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B4\u03B5\u03B8\u03B5\u03AF\u03C4\u03B5 \u03C3\u03C4\u03BF \u03BC\u03AD\u03BB\u03BB\u03BF\u03BD\u0022,\u0022\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0432\u0432\u0435\u0441\u0442\u0438 \u043F\u0430\u0440\u043E\u043B\u044C (\u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0439 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u0430\u0440\u043E\u043B\u044C, \u0435\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F).\u0022,{\u0022en\u0022:562,\u0022fr\u0022:563,\u0022es\u0022:562,\u0022cn\u0022:564,\u0022it\u0022:565,\u0022de\u0022:566,\u0022ja\u0022:567,\u0022pl\u0022:568,\u0022pt\u0022:569,\u0022hr\u0022:570,\u0022cz\u0022:571,\u0022sk\u0022:572,\u0022gr\u0022:562,\u0022ru\u0022:573,\u0022ko\u0022:562},\u0022Log Out\u0022,\u0022D\u00E9connexion\u0022,\u0022\u767B\u51FA\u0022,\u0022Disconnetti\u0022,\u0022Abmelden\u0022,\u0022\u30ED\u30B0\u30A2\u30A6\u30C8\u0022,\u0022Wyloguj si\u0119\u0022,\u0022Sair\u0022,\u0022Odjava\u0022,\u0022Odhl\u00E1sit se\u0022,\u0022Odhl\u00E1si\u0165 sa\u0022,\u0022\u0412\u044B\u0439\u0442\u0438\u0022,{\u0022en\u0022:575,\u0022fr\u0022:576,\u0022es\u0022:575,\u0022cn\u0022:577,\u0022it\u0022:578,\u0022de\u0022:579,\u0022ja\u0022:580,\u0022pl\u0022:581,\u0022pt\u0022:582,\u0022hr\u0022:583,\u0022cz\u0022:584,\u0022sk\u0022:585,\u0022gr\u0022:586,\u0022ru\u0022:587,\u0022ko\u0022:575},\u0022Force Update\u0022,\u0022Forcer la Mise \u00E0 Jour\u0022,\u0022\u5F3A\u5236\u5347\u7EA7\u0022,\u0022Forza Aggiornamento\u0022,\u0022Update Erzwingen\u0022,\u0022\u5F37\u5236\u66F4\u65B0\u0022,\u0022Wymu\u015B Aktualizacj\u0119\u0022,\u0022For\u00E7ar Atualiza\u00E7\u00E3o\u0022,\u0022Prisilno a\u017Euriranje\u0022,\u0022Vynutit aktualizaci\u0022,\u0022Vyn\u00FAti\u0165 aktualiz\u00E1ciu\u0022,\u0022\u0394\u03CD\u03BD\u03B1\u03BC\u03B7 \u0395\u03BD\u03B7\u03BC\u03AD\u03C1\u03C9\u03C3\u03B7\u0022,\u0022\u0410\u0440\u043C\u0438\u044F \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\u0022,{\u0022en\u0022:589,\u0022fr\u0022:590,\u0022es\u0022:589,\u0022cn\u0022:591,\u0022it\u0022:592,\u0022de\u0022:593,\u0022ja\u0022:594,\u0022pl\u0022:595,\u0022pt\u0022:596,\u0022hr\u0022:597,\u0022cz\u0022:598,\u0022sk\u0022:599,\u0022gr\u0022:600,\u0022ru\u0022:601,\u0022ko\u0022:589},\u0022Uninstall\u0022,\u0022D\u00E9sinstaller\u0022,\u0022\u5378\u8F7D\u0022,\u0022Disinstalla\u0022,\u0022Deinstallieren\u0022,\u0022\u30A2\u30F3\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u0022,\u0022Odinstaluj\u0022,\u0022Desinstalar\u0022,\u0022Deinstaliraj\u0022,\u0022Odinstalovat\u0022,\u0022Odin\u0161talova\u0165\u0022,\u0022\u0391\u03C0\u03B5\u03B3\u03BA\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u0022,\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C\u0022,{\u0022en\u0022:603,\u0022fr\u0022:604,\u0022es\u0022:603,\u0022cn\u0022:605,\u0022it\u0022:606,\u0022de\u0022:607,\u0022ja\u0022:608,\u0022pl\u0022:609,\u0022pt\u0022:610,\u0022hr\u0022:611,\u0022cz\u0022:612,\u0022sk\u0022:613,\u0022gr\u0022:614,\u0022ru\u0022:615,\u0022ko\u0022:603},\u0022Back to Army Lists\u0022,\u0022Retour vers les Listes\u0022,\u0022\u8FD4\u56DE\u519B\u8868\u0022,\u0022Torna alle Liste d\u0027Armata\u0022,\u0022Zur\u00FCck zu Armeelisten\u0022,\u0022\u30A2\u30FC\u30DF\u30FC\u30EA\u30B9\u30C8\u306B\u623B\u308B\u0022,\u0022Powr\u00F3t do list armii\u0022,\u0022Voltar para Listas de Ex\u00E9rcito\u0022,\u0022Natrag na popise vojski\u0022,\u0022Zp\u011Bt na seznamy arm\u00E1d\u0022,\u0022Sp\u00E4\u0165 na zoznamy arm\u00E1d\u0022,\u0022\u0395\u03C0\u03B9\u03C3\u03C4\u03C1\u03BF\u03C6\u03AE \u03C3\u03C4\u03BF \u03C3\u03C4\u03C1\u03B1\u03C4\u03CC\u0022,\u0022\u041D\u0430\u0437\u0430\u0434 \u043A \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u043C \u0441\u043F\u0438\u0441\u043A\u0430\u043C\u0022,{\u0022en\u0022:617,\u0022fr\u0022:618,\u0022es\u0022:617,\u0022cn\u0022:619,\u0022it\u0022:620,\u0022de\u0022:621,\u0022ja\u0022:622,\u0022pl\u0022:623,\u0022pt\u0022:624,\u0022hr\u0022:625,\u0022cz\u0022:626,\u0022sk\u0022:627,\u0022gr\u0022:628,\u0022ru\u0022:629,\u0022ko\u0022:617},\u0022Contact / Legal Info\u0022,\u0022Contact / Info L\u00E9gales\u0022,\u0022\u8054\u7CFB\u6211/\u6CD5\u5F8B\u4FE1\u606F\u0022,\u0022Contatto / Informazioni Legali\u0022,\u0022Kontakt / Rechtliche Informationen\u0022,\u0022\u304A\u554F\u3044\u5408\u308F\u305B / \u6CD5\u7684\u60C5\u5831\u0022,\u0022Kontakt / Informacje Prawne\u0022,\u0022Contato / Informa\u00E7\u00F5es Legais\u0022,\u0022Kontakt / Pravne informacije\u0022,\u0022Kontakt / Pr\u00E1vn\u00ED informace\u0022,\u0022Kontakt / Pr\u00E1vne inform\u00E1cie\u0022,\u0022\u0395\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AF\u03B1 / \u039D\u03CC\u03BC\u03B9\u03BC\u03BF \u03A0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u0022,\u0022\u041A\u043E\u043D\u0442\u0430\u043A\u0442\u044B / \u042E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0022,{\u0022en\u0022:631,\u0022fr\u0022:632,\u0022es\u0022:631,\u0022cn\u0022:631,\u0022it\u0022:633,\u0022de\u0022:634,\u0022ja\u0022:635,\u0022pl\u0022:636,\u0022pt\u0022:637,\u0022hr\u0022:638,\u0022cz\u0022:631,\u0022sk\u0022:631,\u0022gr\u0022:639,\u0022ru\u0022:640,\u0022ko\u0022:631},\u0022You can contact me in English or French.\\u003Cbr/\u003E\\u003Cbr/\u003EIf it is matter related to subs, payments, refunds, feel free to send me a private message (@Flammy on Discord) if you want a faster reply.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003EPlease use the in app Report Data Issue for all game data related issues!\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003EI will always answer faster on Discord.\\u003C/strong\u003E\u0022,\u0022Vous pouvez me contacter en anglais ou en fran\u00E7ais. Privil\u00E9giez DISCORD. Il y a des canaux pour les rapports de bug. S\u0027il s\u0027agit d\u0027un souci concernant les abonnements, les payments un remboursement, vous pouvez m\u0027envoyer un message priv\u00E9 sur Discord (@Flammy), mais \u00E9galement envoyer un mail.\\u003Cbr/\u003E\\u003Cbr/\u003ESVP ne m\u0027envoyez pas d\u0027email concernant les \\u003Cstrong\u003EDONNEES DES JEUX (erreurs de points, options ou unit\u00E9s manquantes...)\\u003C/strong\u003E, il y a des canaux Discord d\u00E9di\u00E9s pour cela, SVP lisez les r\u00E8gles sur le canal RULES avant de poster un rapport de bug.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003EJe r\u00E9pondrai en g\u00E9n\u00E9ral plus vite pour toutes les demandes faites via Discord.\\u003C/strong\u003E\u0022,\u0022Puoi contattarmi in inglese o francese.\\u003Cbr/\u003E\\u003Cbr/\u003ESe si tratta di abbonamenti, pagamenti, rimborsi, sentiti libero di inviarmi un messaggio privato (@Flammy su Discord) se desideri una risposta pi\u00F9 veloce.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003EUtilizza la funzione di segnalazione dati nell\u0027app per tutti i problemi relativi ai dati di gioco!\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003ERisponder\u00F2 sempre pi\u00F9 velocemente su Discord.\\u003C/strong\u003E\u0022,\u0022Sie k\u00F6nnen mich auf Englisch oder Franz\u00F6sisch kontaktieren.\\u003Cbr/\u003E\\u003Cbr/\u003EWenn es sich um Abonnements, Zahlungen oder R\u00FCckerstattungen handelt, k\u00F6nnen Sie mir gerne eine private Nachricht (@Flammy auf Discord) senden, wenn Sie eine schnellere Antwort w\u00FCnschen.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003EBitte verwenden Sie die In-App-Funktion \u0027Datenproblem Melden\u0027 f\u00FCr alle spielbezogenen Datenprobleme!\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003EIch antworte auf Discord immer schneller.\\u003C/strong\u003E\u0022,\u0022\u82F1\u8A9E\u307E\u305F\u306F\u30D5\u30E9\u30F3\u30B9\u8A9E\u3067\u3054\u9023\u7D61\u304F\u3060\u3055\u3044\u3002\\u003Cbr/\u003E\\u003Cbr/\u003E\u30B5\u30D6\u30B9\u30AF\u30EA\u30D7\u30B7\u30E7\u30F3\u3001\u652F\u6255\u3044\u3001\u8FD4\u91D1\u306B\u95A2\u3059\u308B\u554F\u984C\u306B\u3064\u3044\u3066\u306F\u3001\u3088\u308A\u8FC5\u901F\u306A\u8FD4\u4FE1\u304C\u5FC5\u8981\u306A\u5834\u5408\u306FDiscord\u3067\u79C1\u306B\u30D7\u30E9\u30A4\u30D9\u30FC\u30C8\u30E1\u30C3\u30BB\u30FC\u30B8(@Flammy)\u3092\u304A\u9001\u308A\u304F\u3060\u3055\u3044\u3002\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003E\u30B2\u30FC\u30E0\u30C7\u30FC\u30BF\u306B\u95A2\u3059\u308B\u3059\u3079\u3066\u306E\u554F\u984C\u306B\u3064\u3044\u3066\u306F\u3001\u30A2\u30D7\u30EA\u5185\u306E\u30C7\u30FC\u30BF\u554F\u984C\u5831\u544A\u6A5F\u80FD\u3092\u3054\u5229\u7528\u304F\u3060\u3055\u3044\uFF01\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003EDiscord\u3067\u306F\u5E38\u306B\u3088\u308A\u65E9\u304F\u8FD4\u4FE1\u3057\u307E\u3059\u3002\\u003C/strong\u003E\u0022,\u0022Mo\u017Cesz skontaktowa\u0107 si\u0119 ze mn\u0105 po angielsku lub francusku.\\u003Cbr/\u003E\\u003Cbr/\u003EJe\u015Bli sprawa dotyczy subskrypcji, p\u0142atno\u015Bci lub zwrot\u00F3w, wy\u015Blij mi wiadomo\u015B\u0107 prywatn\u0105 (@Flammy na Discord), je\u015Bli potrzebujesz szybszej odpowiedzi.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003EProsz\u0119 u\u017Cywa\u0107 funkcji zg\u0142aszania problem\u00F3w z danymi w aplikacji dla wszystkich zagadnie\u0144 zwi\u0105zanych z danymi gry!\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003EZawsze odpowiem szybciej na Discord.\\u003C/strong\u003E\u0022,\u0022Voc\u00EA pode me contatar em ingl\u00EAs ou franc\u00EAs.\\u003Cbr/\u003E\\u003Cbr/\u003ESe for um assunto relacionado a assinaturas, pagamentos ou reembolsos, sinta-se \u00E0 vontade para me enviar uma mensagem privada (@Flammy no Discord) se quiser uma resposta mais r\u00E1pida.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003EPor favor, use o recurso Reportar Problema de Dados no aplicativo para todos os problemas relacionados aos dados do jogo!\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003ESempre responderei mais r\u00E1pido no Discord.\\u003C/strong\u003E\u0022,\u0022Mo\u017Eete me kontaktirati na engleskom ili francuskom.\\u003Cbr/\u003E\\u003Cbr/\u003EAko je rije\u010D o pretplatama, pla\u0107anjima ili povratima novca, slobodno mi po\u0161aljite privatnu poruku (@Flammy na Discord) ako \u017Eelite br\u017Ei odgovor.\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cb\u003EMolimo koristite prijavu problema s podacima u aplikaciji za sve probleme vezane uz podatke igre!\\u003C/b\u003E\\u003Cbr/\u003E\\u003Cbr/\u003E\\u003Cstrong class=\u0027blue\u0027\u003EUvijek \u0107u odgovoriti br\u017Ee na Discord.\\u003C/strong\u003E\u0022,\u0022\u0395\u03C0\u03B9\u03BA\u03BF\u03B9\u03BD\u03C9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03BC\u03B1\u03B6\u03AF \u03BC\u03BF\u03C5 (\u0391\u03B3\u03B3\u03BB\u03B9\u03BA\u03AC \u03AE \u0393\u03B1\u03BB\u03BB\u03B9\u03BA\u03AC)\u0022,\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u043D\u0430 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C \u0438\u043B\u0438 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u043C \u044F\u0437\u044B\u043A\u0435\u0022,{\u0022en\u0022:642,\u0022fr\u0022:643,\u0022es\u0022:642,\u0022cn\u0022:642,\u0022it\u0022:644,\u0022de\u0022:645,\u0022ja\u0022:646,\u0022pl\u0022:647,\u0022pt\u0022:648,\u0022hr\u0022:649,\u0022cz\u0022:650,\u0022sk\u0022:651,\u0022gr\u0022:652,\u0022ru\u0022:653,\u0022ko\u0022:642},\u0022Pending Tournaments\u0022,\u0022Tournois en Pr\u00E9paration\u0022,\u0022Tornei in Attesa\u0022,\u0022Ausstehende Turniere\u0022,\u0022\u4FDD\u7559\u4E2D\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u0022,\u0022Oczekuj\u0105ce Turnieje\u0022,\u0022Torneios Pendentes\u0022,\u0022Turniri na \u010Dekanju\u0022,\u0022P\u0159ipravovan\u00E9 turnaje\u0022,\u0022\u010Cakaj\u00FAce turnaje\u0022,\u0022\u03A0\u03C1\u03BF\u03C3\u03B5\u03C7\u03AE \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0422\u0443\u0440\u043D\u0438\u0440\u044B\u0022,{\u0022en\u0022:655,\u0022fr\u0022:656,\u0022es\u0022:655,\u0022cn\u0022:655,\u0022it\u0022:657,\u0022de\u0022:658,\u0022ja\u0022:659,\u0022pl\u0022:660,\u0022pt\u0022:661,\u0022hr\u0022:662,\u0022cz\u0022:663,\u0022sk\u0022:664,\u0022gr\u0022:665,\u0022ru\u0022:666,\u0022ko\u0022:655},\u0022Open Tournaments\u0022,\u0022Tournois Ouverts\u0022,\u0022Tornei Aperti\u0022,\u0022Offene Turniere\u0022,\u0022\u516C\u958B\u4E2D\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u0022,\u0022Otwarte Turnieje\u0022,\u0022Torneios Abertos\u0022,\u0022Otvoreni turniri\u0022,\u0022Otev\u0159en\u00E9 turnaje\u0022,\u0022Otvoren\u00E9 turnaje\u0022,\u0022\u0391\u03BD\u03BF\u03B9\u03C7\u03C4\u03AC \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0422\u0443\u0440\u043D\u0438\u0440\u044B\u0022,{\u0022en\u0022:668,\u0022fr\u0022:669,\u0022es\u0022:668,\u0022cn\u0022:668,\u0022it\u0022:670,\u0022de\u0022:671,\u0022ja\u0022:672,\u0022pl\u0022:673,\u0022pt\u0022:674,\u0022hr\u0022:675,\u0022cz\u0022:676,\u0022sk\u0022:677,\u0022gr\u0022:678,\u0022ru\u0022:679,\u0022ko\u0022:668},\u0022Ongoing Tournaments\u0022,\u0022Tournois En cours\u0022,\u0022Tornei in Corso\u0022,\u0022Laufende Turniere\u0022,\u0022\u9032\u884C\u4E2D\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u0022,\u0022Trwaj\u0105ce Turnieje\u0022,\u0022Torneios em Andamento\u0022,\u0022Turniri u tijeku\u0022,\u0022Prob\u00EDhaj\u00EDc\u00ED turnaje\u0022,\u0022Prebiehaj\u00FAce turnaje\u0022,\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03C3\u03B5 \u03B5\u03BE\u03AD\u03BB\u03B9\u03BE\u03B7\u0022,\u0022\u0418\u0434\u0451\u0442 \u0422\u0443\u0440\u043D\u0438\u0440\u044B\u0022,{\u0022en\u0022:681,\u0022fr\u0022:682,\u0022es\u0022:681,\u0022cn\u0022:681,\u0022it\u0022:683,\u0022de\u0022:684,\u0022ja\u0022:685,\u0022pl\u0022:686,\u0022pt\u0022:687,\u0022hr\u0022:688,\u0022cz\u0022:689,\u0022sk\u0022:690,\u0022gr\u0022:691,\u0022ru\u0022:692,\u0022ko\u0022:681},\u0022Closed Tournaments\u0022,\u0022Tournois Ferm\u00E9s\u0022,\u0022Tornei Chiusi\u0022,\u0022Abgeschlossene Turniere\u0022,\u0022\u7D42\u4E86\u3057\u305F\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u0022,\u0022Zamkni\u0119te Turnieje\u0022,\u0022Torneios Encerrados\u0022,\u0022Zatvoreni turniri\u0022,\u0022Ukon\u010Den\u00E9 turnaje\u0022,\u0022Uzavret\u00E9 turnaje\u0022,\u0022\u039A\u03BB\u03B5\u03B9\u03C3\u03C4\u03AC \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u0417\u0430\u043A\u0440\u044B\u0442 \u0422\u0443\u0440\u043D\u0438\u0440\u044B\u0022,{\u0022en\u0022:694,\u0022fr\u0022:695,\u0022es\u0022:694,\u0022cn\u0022:694,\u0022it\u0022:696,\u0022de\u0022:697,\u0022ja\u0022:698,\u0022pl\u0022:699,\u0022pt\u0022:700,\u0022hr\u0022:701,\u0022cz\u0022:702,\u0022sk\u0022:702,\u0022gr\u0022:703,\u0022ru\u0022:704,\u0022ko\u0022:694},\u0022My Tournaments\u0022,\u0022Mes Tournois\u0022,\u0022I Miei Tornei\u0022,\u0022Meine Turniere\u0022,\u0022\u30DE\u30A4\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u0022,\u0022Moje Turnieje\u0022,\u0022Meus Torneios\u0022,\u0022Moji turniri\u0022,\u0022Moje turnaje\u0022,\u0022\u03A4\u03B1 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03BC\u03BF\u03C5\u0022,\u0022My \u0422\u0443\u0440\u043D\u0438\u0440\u044B\u0022,{\u0022en\u0022:706,\u0022fr\u0022:706,\u0022es\u0022:706,\u0022cn\u0022:706,\u0022it\u0022:707,\u0022de\u0022:706,\u0022ja\u0022:708,\u0022pl\u0022:709,\u0022pt\u0022:710,\u0022hr\u0022:711,\u0022cz\u0022:712,\u0022sk\u0022:713,\u0022gr\u0022:714,\u0022ru\u0022:715,\u0022ko\u0022:706},\u0022Organisation\u0022,\u0022Organizzazione\u0022,\u0022\u904B\u55B6\u0022,\u0022Organizacja\u0022,\u0022Organiza\u00E7\u00E3o\u0022,\u0022Organizacija\u0022,\u0022Organizace\u0022,\u0022Organiz\u00E1cia\u0022,\u0022\u0394\u03B9\u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u0022,{\u0022en\u0022:717,\u0022fr\u0022:718,\u0022es\u0022:719,\u0022cn\u0022:720,\u0022it\u0022:721,\u0022de\u0022:722,\u0022ja\u0022:723,\u0022pl\u0022:724,\u0022pt\u0022:725,\u0022hr\u0022:726,\u0022cz\u0022:727,\u0022sk\u0022:727,\u0022gr\u0022:728,\u0022ru\u0022:729,\u0022ko\u0022:717},\u0022Players\u0022,\u0022Joueurs\u0022,\u0022Jugadores\u0022,\u0022\u73A9\u5BB6\u0022,\u0022Giocatori\u0022,\u0022Spieler\u0022,\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u0022,\u0022Gracze\u0022,\u0022Jogadores\u0022,\u0022Igra\u010Di\u0022,\u0022Hr\u00E1\u010Di\u0022,\u0022\u03A0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2\u0022,\u0022\u0418\u0433\u0440\u043E\u043A\u0438\u0022,{\u0022en\u0022:731,\u0022fr\u0022:732,\u0022es\u0022:731,\u0022cn\u0022:731,\u0022it\u0022:733,\u0022de\u0022:734,\u0022ja\u0022:735,\u0022pl\u0022:736,\u0022pt\u0022:732,\u0022hr\u0022:737,\u0022cz\u0022:731,\u0022sk\u0022:731,\u0022gr\u0022:738,\u0022ru\u0022:739,\u0022ko\u0022:731},\u0022Teams\u0022,\u0022Equipes\u0022,\u0022Squadre\u0022,\u0022Mannschaften\u0022,\u0022\u30C1\u30FC\u30E0\u0022,\u0022Dru\u017Cyny\u0022,\u0022Timovi\u0022,\u0022\u039F\u03BC\u03AC\u03B4\u03B5\u03C2\u0022,\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,{\u0022en\u0022:741,\u0022fr\u0022:742,\u0022es\u0022:741,\u0022cn\u0022:741,\u0022it\u0022:743,\u0022de\u0022:744,\u0022ja\u0022:745,\u0022pl\u0022:746,\u0022pt\u0022:747,\u0022hr\u0022:748,\u0022cz\u0022:741,\u0022sk\u0022:741,\u0022gr\u0022:749,\u0022ru\u0022:750,\u0022ko\u0022:741},\u0022Tournament Details\u0022,\u0022Informations du Tournoi\u0022,\u0022Dettagli Torneo\u0022,\u0022Turnierdetails\u0022,\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u8A73\u7D30\u0022,\u0022Szczeg\u00F3\u0142y turnieju\u0022,\u0022Detalhes do Torneio\u0022,\u0022Detalji turnira\u0022,\u0022\u039B\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0414\u0435\u0442\u0430\u043B\u0438\u0022,{\u0022en\u0022:752,\u0022fr\u0022:753,\u0022es\u0022:752,\u0022cn\u0022:752,\u0022it\u0022:754,\u0022de\u0022:755,\u0022ja\u0022:756,\u0022pl\u0022:757,\u0022pt\u0022:758,\u0022hr\u0022:759,\u0022cz\u0022:752,\u0022sk\u0022:752,\u0022gr\u0022:760,\u0022ru\u0022:761,\u0022ko\u0022:752},\u0022Tournament Rules\u0022,\u0022R\u00E8gles du Tournoi\u0022,\u0022Regole del Torneo\u0022,\u0022Turnierregeln\u0022,\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u30EB\u30FC\u30EB\u0022,\u0022Zasady turnieju\u0022,\u0022Regras do Torneio\u0022,\u0022Pravila turnira\u0022,\u0022\u03A4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u039A\u03B1\u03BD\u03CC\u03BD\u03B5\u03C2\u0022,\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u041F\u0440\u0430\u0432\u0438\u043B\u0430\u0022,{\u0022en\u0022:763,\u0022fr\u0022:764,\u0022es\u0022:763,\u0022cn\u0022:763,\u0022it\u0022:765,\u0022de\u0022:766,\u0022ja\u0022:767,\u0022pl\u0022:768,\u0022pt\u0022:769,\u0022hr\u0022:770,\u0022cz\u0022:763,\u0022sk\u0022:763,\u0022gr\u0022:771,\u0022ru\u0022:772,\u0022ko\u0022:763},\u0022Players and Lists\u0022,\u0022Joueurs et Listes\u0022,\u0022Giocatori e Liste\u0022,\u0022Spieler und Listen\u0022,\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u3068\u30EA\u30B9\u30C8\u0022,\u0022Gracze i Listy\u0022,\u0022Jogadores e Listas\u0022,\u0022Igra\u010Di i popisi\u0022,\u0022\u03A0\u03B1\u03AF\u03BA\u03C4\u03B5\u03C2 \u03BA\u03B1\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2\u0022,\u0022\u0418\u0433\u0440\u043E\u043A\u0438 and \u0421\u043F\u0438\u0441\u043A\u0438\u0022,{\u0022en\u0022:774,\u0022fr\u0022:775,\u0022es\u0022:774,\u0022cn\u0022:774,\u0022it\u0022:776,\u0022de\u0022:777,\u0022ja\u0022:778,\u0022pl\u0022:779,\u0022pt\u0022:780,\u0022hr\u0022:781,\u0022cz\u0022:774,\u0022sk\u0022:774,\u0022gr\u0022:782,\u0022ru\u0022:783,\u0022ko\u0022:774},\u0022Tournament Details have been updated!\u0022,\u0022Les Informations du Tournoi ont \u00E9t\u00E9 mises \u00E0 jour !\u0022,\u0022I dettagli del torneo sono stati aggiornati!\u0022,\u0022Turnierdetails wurden aktualisiert!\u0022,\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u8A73\u7D30\u304C\u66F4\u65B0\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,\u0022Szczeg\u00F3\u0142y turnieju zosta\u0142y zaktualizowane!\u0022,\u0022Os detalhes do torneio foram atualizados!\u0022,\u0022Detalji turnira su a\u017Eurirani!\u0022,\u0022\u039F\u03B9 \u03BB\u03B5\u03C0\u03C4\u03BF\u03BC\u03AD\u03C1\u03B5\u03B9\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03BD\u03B7\u03BC\u03B5\u03C1\u03CE\u03B8\u03B7\u03BA\u03B1\u03BD\u0022,\u0022\u0414\u0435\u0442\u0430\u043B\u0438 \u0442\u0443\u0440\u043D\u0438\u0440\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u044B!\u0022,{\u0022en\u0022:785,\u0022fr\u0022:786,\u0022es\u0022:785,\u0022cn\u0022:785,\u0022it\u0022:787,\u0022de\u0022:788,\u0022ja\u0022:789,\u0022pl\u0022:790,\u0022pt\u0022:791,\u0022hr\u0022:792,\u0022cz\u0022:793,\u0022sk\u0022:785,\u0022gr\u0022:794,\u0022ru\u0022:795,\u0022ko\u0022:785},\u0022Sign Up\u0022,\u0022S\u0027inscrire\u0022,\u0022Iscriviti\u0022,\u0022Anmelden\u0022,\u0022\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u0022,\u0022Zarejestruj si\u0119\u0022,\u0022Inscrever-se\u0022,\u0022Registracija\u0022,\u0022Registrovat se\u0022,\u0022\u0395\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE\u0022,\u0022\u0417\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F\u0022,{\u0022en\u0022:797,\u0022fr\u0022:798,\u0022es\u0022:797,\u0022cn\u0022:797,\u0022it\u0022:799,\u0022de\u0022:800,\u0022ja\u0022:801,\u0022pl\u0022:802,\u0022pt\u0022:803,\u0022hr\u0022:804,\u0022cz\u0022:797,\u0022sk\u0022:797,\u0022gr\u0022:805,\u0022ru\u0022:806,\u0022ko\u0022:797},\u0022Your Discord ID will be used by the New Recruit bot to send you notifications about the tournament.\u0022,\u0022Ton ID Discord sera utilis\u00E9 par le bot New Recruit pour t\u0027envoyer des notifications conernant le tournoi.\u0022,\u0022Il tuo ID Discord sar\u00E0 utilizzato dal bot New Recruit per inviarti notifiche sul torneo.\u0022,\u0022Ihre Discord-ID wird vom New Recruit Bot verwendet, um Ihnen Benachrichtigungen \u00FCber das Turnier zu senden.\u0022,\u0022\u3042\u306A\u305F\u306EDiscord ID\u306F\u3001New Recruit\u30DC\u30C3\u30C8\u304C\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u95A2\u3059\u308B\u901A\u77E5\u3092\u9001\u4FE1\u3059\u308B\u305F\u3081\u306B\u4F7F\u7528\u3055\u308C\u307E\u3059\u3002\u0022,\u0022Tw\u00F3j Discord ID zostanie u\u017Cyty przez bota New Recruit do wysy\u0142ania powiadomie\u0144 o turnieju.\u0022,\u0022Seu ID do Discord ser\u00E1 usado pelo bot New Recruit para enviar notifica\u00E7\u00F5es sobre o torneio.\u0022,\u0022Va\u0161 Discord ID \u0107e koristiti New Recruit bot za slanje obavijesti o turniru.\u0022,\u0022\u03A4\u03BF Discord ID \u03C3\u03B1\u03C2\u0022,\u0022\u0412\u0430\u0448 Discord ID\u0022,{\u0022en\u0022:808,\u0022fr\u0022:809,\u0022es\u0022:808,\u0022cn\u0022:808,\u0022it\u0022:810,\u0022de\u0022:811,\u0022ja\u0022:812,\u0022pl\u0022:813,\u0022pt\u0022:814,\u0022hr\u0022:815,\u0022cz\u0022:808,\u0022sk\u0022:808,\u0022gr\u0022:816,\u0022ru\u0022:817,\u0022ko\u0022:808},\u0022This email address will be shared with Tournament Organisers.\u0022,\u0022Cette adresse email sera partag\u00E9e avec les Organisateurs du Tournoi\u0022,\u0022Questo indirizzo email sar\u00E0 condiviso con gli organizzatori del torneo.\u0022,\u0022Diese E-Mail-Adresse wird mit Turnierveranstaltern geteilt.\u0022,\u0022\u3053\u306E\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u306F\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u4E3B\u50AC\u8005\u3068\u5171\u6709\u3055\u308C\u307E\u3059\u3002\u0022,\u0022Ten adres email zostanie udost\u0119pniony organizatorom turnieju.\u0022,\u0022Este endere\u00E7o de e-mail ser\u00E1 compartilhado com os Organizadores do Torneio.\u0022,\u0022Ova email adresa \u0107e biti podijeljena s organizatorima turnira.\u0022,\u0022\u0391\u03C5\u03C4\u03AE \u03B7 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7 email\u0022,\u0022\u042D\u0442\u043E\u0442 \u0430\u0434\u0440\u0435\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u043F\u043E\u0447\u0442\u044B \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430\u043C \u0442\u0443\u0440\u043D\u0438\u0440\u0430.\u0022,{\u0022en\u0022:819,\u0022fr\u0022:820,\u0022es\u0022:819,\u0022cn\u0022:819,\u0022it\u0022:821,\u0022de\u0022:822,\u0022ja\u0022:823,\u0022pl\u0022:824,\u0022pt\u0022:825,\u0022hr\u0022:826,\u0022cz\u0022:819,\u0022sk\u0022:819,\u0022gr\u0022:827,\u0022ru\u0022:828,\u0022ko\u0022:819},\u0022In Online Tournaments, it will also be sent to your opponents.\u0022,\u0022Pour les Tournois en Ligne, elle sera envoy\u00E9e \u00E0 vos adversaires.\u0022,\u0022Nei tornei online, sar\u00E0 anche inviato ai tuoi avversari.\u0022,\u0022Bei Online-Turnieren wird sie auch an Ihre Gegner gesendet.\u0022,\u0022\u30AA\u30F3\u30E9\u30A4\u30F3\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u3067\u306F\u3001\u5BFE\u6226\u76F8\u624B\u306B\u3082\u9001\u4FE1\u3055\u308C\u307E\u3059\u3002\u0022,\u0022W turniejach online zostanie r\u00F3wnie\u017C wys\u0142any do przeciwnik\u00F3w.\u0022,\u0022Em Torneios Online, ele tamb\u00E9m ser\u00E1 enviado aos seus oponentes.\u0022,\u0022U online turnirima, bit \u0107e poslana i va\u0161im protivnicima.\u0022,\u0022\u03A3\u03B5 online \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u0412 \u043E\u043D\u043B\u0430\u0439\u043D-\u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0445 \u043E\u043D \u0442\u0430\u043A\u0436\u0435 \u0431\u0443\u0434\u0435\u0442 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u0432\u0430\u0448\u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C.\u0022,{\u0022en\u0022:830,\u0022fr\u0022:831,\u0022es\u0022:830,\u0022cn\u0022:830,\u0022it\u0022:832,\u0022de\u0022:833,\u0022ja\u0022:834,\u0022pl\u0022:835,\u0022pt\u0022:836,\u0022hr\u0022:837,\u0022cz\u0022:830,\u0022sk\u0022:830,\u0022gr\u0022:838,\u0022ru\u0022:839,\u0022ko\u0022:830},\u0022You can specify a different email address from that of your New Recruit account.\u0022,\u0022Tu peux sp\u00E9cifier une adresse email diff\u00E9rente de celle qui est associ\u00E9e \u00E0 votre compte New Recruit.\u0022,\u0022Puoi specificare un indirizzo email diverso da quello del tuo account New Recruit.\u0022,\u0022Sie k\u00F6nnen eine andere E-Mail-Adresse als die Ihres New Recruit-Kontos angeben.\u0022,\u0022New Recruit\u30A2\u30AB\u30A6\u30F3\u30C8\u3068\u306F\u7570\u306A\u308B\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u3092\u6307\u5B9A\u3067\u304D\u307E\u3059\u3002\u0022,\u0022Mo\u017Cesz poda\u0107 inny adres email ni\u017C ten z konta New Recruit.\u0022,\u0022Voc\u00EA pode especificar um endere\u00E7o de e-mail diferente daquele da sua conta New Recruit.\u0022,\u0022Mo\u017Eete navesti drugu email adresu od one va\u0161eg New Recruit ra\u010Duna.\u0022,\u0022\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03BF\u03C1\u03AF\u03C3\u03B5\u03C4\u03B5\u0022,\u0022\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0432\u043E\u0439 Discord ID \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u043F\u0440\u043E\u0444\u0438\u043B\u044F\u0022,{\u0022en\u0022:841,\u0022fr\u0022:842,\u0022es\u0022:841,\u0022cn\u0022:841,\u0022it\u0022:843,\u0022de\u0022:844,\u0022ja\u0022:845,\u0022pl\u0022:846,\u0022pt\u0022:847,\u0022hr\u0022:848,\u0022cz\u0022:841,\u0022sk\u0022:841,\u0022gr\u0022:849,\u0022ru\u0022:850,\u0022ko\u0022:851},\u0022Add or Remove Lists\u0022,\u0022Ajouter ou supprimer des Listes\u0022,\u0022Aggiungi o Rimuovi Liste\u0022,\u0022Listen Hinzuf\u00FCgen oder Entfernen\u0022,\u0022\u30EA\u30B9\u30C8\u306E\u8FFD\u52A0\u30FB\u524A\u9664\u0022,\u0022Dodaj lub usu\u0144 listy\u0022,\u0022Adicionar ou Remover Listas\u0022,\u0022Dodaj ili ukloni popise\u0022,\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7/\u03B1\u03C6\u03B1\u03AF\u03C1\u03B5\u03C3\u03B7 \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD\u0022,\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C or \u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0421\u043F\u0438\u0441\u043A\u0438\u0022,\u0022or Remove Lists \uCD94\uAC00\u0022,{\u0022en\u0022:853,\u0022fr\u0022:854,\u0022es\u0022:853,\u0022cn\u0022:853,\u0022it\u0022:855,\u0022de\u0022:856,\u0022ja\u0022:857,\u0022pl\u0022:858,\u0022pt\u0022:859,\u0022hr\u0022:860,\u0022cz\u0022:853,\u0022sk\u0022:853,\u0022gr\u0022:861,\u0022ru\u0022:862,\u0022ko\u0022:863},\u0022Select your army list and click the \u002B button to submit it.\u0022,\u0022S\u00E9lectionne ta liste et clique sur le bouton \u002B pour l\u0027envoyer.\u0022,\u0022Seleziona la tua lista d\u0027armata e clicca il pulsante \u002B per inviarla.\u0022,\u0022W\u00E4hlen Sie Ihre Armeeliste aus und klicken Sie auf die \u002B Schaltfl\u00E4che, um sie einzureichen.\u0022,\u0022\u30A2\u30FC\u30DF\u30FC\u30EA\u30B9\u30C8\u3092\u9078\u629E\u3057\u3066\u3001\u002B\u30DC\u30BF\u30F3\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u9001\u4FE1\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u0022,\u0022Wybierz swoj\u0105 list\u0119 armii i kliknij przycisk \u002B, aby j\u0105 przes\u0142a\u0107.\u0022,\u0022Selecione sua lista de ex\u00E9rcito e clique no bot\u00E3o \u002B para envi\u00E1-la.\u0022,\u0022Odaberite popis vojske i kliknite \u002B gumb za prijavu.\u0022,\u0022\u0395\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03C4\u03B7 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03C3\u03B1\u03C2 \u03BA\u03B1\u03B9\u0022,\u0022\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043E\u0439 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0441\u043F\u0438\u0441\u043E\u043A \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443 \u002B, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E.\u0022,\u0022your army list and click the \u002B button to submit it. \uC120\uD0DD\u0022,{\u0022en\u0022:865,\u0022fr\u0022:866,\u0022es\u0022:865,\u0022cn\u0022:865,\u0022it\u0022:867,\u0022de\u0022:868,\u0022ja\u0022:869,\u0022pl\u0022:870,\u0022pt\u0022:871,\u0022hr\u0022:872,\u0022cz\u0022:865,\u0022sk\u0022:865,\u0022gr\u0022:873,\u0022ru\u0022:874,\u0022ko\u0022:865},\u0022I signed up for this tournament!\u0022,\u0022Je suis inscrit \u00E0 ce tournoi !\u0022,\u0022Mi sono iscritto a questo torneo!\u0022,\u0022Ich habe mich f\u00FCr dieses Turnier angemeldet!\u0022,\u0022\u3053\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u767B\u9332\u3057\u307E\u3057\u305F\uFF01\u0022,\u0022Zapisa\u0142em si\u0119 na ten turniej!\u0022,\u0022Eu me inscrevi neste torneio!\u0022,\u0022Prijavio sam se za ovaj turnir!\u0022,\u0022\u0388\u03C7\u03C9 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03B5\u03AF\u0022,\u0022\u042F \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0441\u044F \u043D\u0430 \u044D\u0442\u043E\u0442 \u0442\u0443\u0440\u043D\u0438\u0440!\u0022,{\u0022en\u0022:876,\u0022fr\u0022:877,\u0022es\u0022:876,\u0022cn\u0022:876,\u0022it\u0022:878,\u0022de\u0022:879,\u0022ja\u0022:880,\u0022pl\u0022:881,\u0022pt\u0022:882,\u0022hr\u0022:883,\u0022cz\u0022:876,\u0022sk\u0022:876,\u0022gr\u0022:884,\u0022ru\u0022:885,\u0022ko\u0022:876},\u0022...Awaiting confirmation by the tournament organiser...\u0022,\u0022...En attente de confirmation par l\u0027organisateur du tournoi...\u0022,\u0022...In attesa di conferma dall\u0027organizzatore del torneo...\u0022,\u0022...Warte auf Best\u00E4tigung durch den Turnierveranstalter...\u0022,\u0022...\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u4E3B\u50AC\u8005\u306B\u3088\u308B\u78BA\u8A8D\u3092\u5F85\u3063\u3066\u3044\u307E\u3059...\u0022,\u0022...Oczekiwanie na potwierdzenie przez organizatora turnieju...\u0022,\u0022...Aguardando confirma\u00E7\u00E3o pelo organizador do torneio...\u0022,\u0022...\u010Ceka se potvrda organizatora turnira...\u0022,\u0022\u0391\u03BD\u03B1\u03BC\u03BF\u03BD\u03AE \u03B5\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B7\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B7 \u03B4\u03B9\u03BF\u03C1\u03B3\u03AC\u03BD\u03C9\u03C3\u03B7\u0022,\u0022...\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F \u043E\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430 \u0442\u0443\u0440\u043D\u0438\u0440\u0430...\u0022,{\u0022en\u0022:887,\u0022fr\u0022:888,\u0022es\u0022:887,\u0022cn\u0022:887,\u0022it\u0022:889,\u0022de\u0022:890,\u0022ja\u0022:891,\u0022pl\u0022:892,\u0022pt\u0022:893,\u0022hr\u0022:894,\u0022cz\u0022:887,\u0022sk\u0022:887,\u0022gr\u0022:895,\u0022ru\u0022:896,\u0022ko\u0022:887},\u0022Lists have not been published by the tournament organisers yet.\u0022,\u0022Les listes n\u0027ont pas encore \u00E9t\u00E9 publi\u00E9es par les organisateurs du tournoi.\u0022,\u0022Le liste non sono ancora state pubblicate dagli organizzatori del torneo.\u0022,\u0022Listen wurden von den Turnierveranstaltern noch nicht ver\u00F6ffentlicht.\u0022,\u0022\u30EA\u30B9\u30C8\u306F\u307E\u3060\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u4E3B\u50AC\u8005\u306B\u3088\u3063\u3066\u516C\u958B\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002\u0022,\u0022Listy nie zosta\u0142y jeszcze opublikowane przez organizator\u00F3w turnieju.\u0022,\u0022As listas ainda n\u00E3o foram publicadas pelos organizadores do torneio.\u0022,\u0022Organizatori turnira jo\u0161 nisu objavili popise.\u0022,\u0022\u039F\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B4\u03B5\u03BD \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B7\u03BC\u03CC\u03C3\u03B9\u03B5\u03C2\u0022,\u0022\u0421\u043F\u0438\u0441\u043A\u0438 \u0435\u0449\u0451 \u043D\u0435 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u044B \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430\u043C\u0438 \u0442\u0443\u0440\u043D\u0438\u0440\u0430.\u0022,{\u0022en\u0022:898,\u0022fr\u0022:899,\u0022es\u0022:898,\u0022cn\u0022:898,\u0022it\u0022:900,\u0022de\u0022:566,\u0022ja\u0022:901,\u0022pl\u0022:568,\u0022pt\u0022:902,\u0022hr\u0022:570,\u0022cz\u0022:571,\u0022sk\u0022:898,\u0022gr\u0022:903,\u0022ru\u0022:573,\u0022ko\u0022:898},\u0022Sign Out\u0022,\u0022Se d\u00E9sinscrire\u0022,\u0022Disiscriviti\u0022,\u0022\u30B5\u30A4\u30F3\u30A2\u30A6\u30C8\u0022,\u0022Cancelar Inscri\u00E7\u00E3o\u0022,\u0022\u0391\u03C0\u03BF\u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u0022,{\u0022en\u0022:905,\u0022fr\u0022:906,\u0022es\u0022:905,\u0022cn\u0022:905,\u0022it\u0022:907,\u0022de\u0022:908,\u0022ja\u0022:909,\u0022pl\u0022:910,\u0022pt\u0022:911,\u0022hr\u0022:912,\u0022cz\u0022:905,\u0022sk\u0022:905,\u0022gr\u0022:913,\u0022ru\u0022:914,\u0022ko\u0022:905},\u0022Are you sure you want to sign out from this tournament?\u0022,\u0022Es-tu certain de vouloir te d\u00E9sinscrire de ce tournoi ?\u0022,\u0022Sei sicuro di volerti disiscrivere da questo torneo?\u0022,\u0022Sind Sie sicher, dass Sie sich von diesem Turnier abmelden m\u00F6chten?\u0022,\u0022\u3053\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u304B\u3089\u30B5\u30A4\u30F3\u30A2\u30A6\u30C8\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F\u0022,\u0022Czy na pewno chcesz wypisa\u0107 si\u0119 z tego turnieju?\u0022,\u0022Tem certeza de que deseja cancelar sua inscri\u00E7\u00E3o neste torneio?\u0022,\u0022Jeste li sigurni da se \u017Eelite odjaviti s ovog turnira?\u0022,\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03B9 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C3\u03C5\u03BD\u03B4\u03B5\u03B8\u03B5\u03AF\u03C4\u03B5 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC;\u0022,\u0022\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u043E\u0442\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0442\u0443\u0440\u043D\u0438\u0440\u0430?\u0022,{\u0022en\u0022:916,\u0022fr\u0022:917,\u0022es\u0022:916,\u0022cn\u0022:916,\u0022it\u0022:918,\u0022de\u0022:919,\u0022ja\u0022:920,\u0022pl\u0022:921,\u0022pt\u0022:922,\u0022hr\u0022:923,\u0022cz\u0022:916,\u0022sk\u0022:916,\u0022gr\u0022:924,\u0022ru\u0022:925,\u0022ko\u0022:916},\u0022Are you sure you want to drop out of the tournament?\u0022,\u0022Es-tu certain de vouloir quitter ce tournoi ?\u0022,\u0022Sei sicuro di volerti ritirare dal torneo?\u0022,\u0022Sind Sie sicher, dass Sie aus dem Turnier aussteigen m\u00F6chten?\u0022,\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u304B\u3089\u9000\u51FA\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B\uFF1F\u0022,\u0022Czy na pewno chcesz wycofa\u0107 si\u0119 z turnieju?\u0022,\u0022Tem certeza de que deseja abandonar o torneio?\u0022,\u0022Jeste li sigurni da \u017Eelite odustati od turnira?\u0022,\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03B9 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B1\u03C0\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03C4\u03B5 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC;\u0022,\u0022\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0442\u0443\u0440\u043D\u0438\u0440\u0430?\u0022,{\u0022en\u0022:927,\u0022fr\u0022:928,\u0022es\u0022:927,\u0022cn\u0022:927,\u0022it\u0022:929,\u0022de\u0022:930,\u0022ja\u0022:931,\u0022pl\u0022:932,\u0022pt\u0022:933,\u0022hr\u0022:934,\u0022cz\u0022:927,\u0022sk\u0022:927,\u0022gr\u0022:935,\u0022ru\u0022:936,\u0022ko\u0022:927},\u0022Tournament Management\u0022,\u0022Gestion du Tournoi\u0022,\u0022Gestione Torneo\u0022,\u0022Turnierverwaltung\u0022,\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u7BA1\u7406\u0022,\u0022Zarz\u0105dzanie turniejem\u0022,\u0022Gerenciamento do Torneio\u0022,\u0022Upravljanje turnirom\u0022,\u0022\u0394\u03B9\u03B1\u03C7\u03B5\u03AF\u03C1\u03B9\u03C3\u03B7 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0442\u0443\u0440\u043D\u0438\u0440\u043E\u043C\u0022,{\u0022en\u0022:938,\u0022fr\u0022:939,\u0022es\u0022:940,\u0022cn\u0022:33,\u0022it\u0022:941,\u0022de\u0022:938,\u0022ja\u0022:942,\u0022pl\u0022:938,\u0022pt\u0022:938,\u0022hr\u0022:938,\u0022cz\u0022:938,\u0022sk\u0022:938,\u0022gr\u0022:943,\u0022ru\u0022:944,\u0022ko\u0022:945},\u0022Status\u0022,\u0022Etat\u0022,\u0022Estado\u0022,\u0022Stato\u0022,\u0022\u30B9\u30C6\u30FC\u30BF\u30B9\u0022,\u0022\u039A\u03B1\u03C4\u03AC\u03C3\u03C4\u03B1\u03C3\u03B7\u0022,\u0022\u0421\u0442\u0430\u0442\u0443\u0441\u0022,\u0022\uC0C1\uD0DC\u0022,{\u0022en\u0022:947,\u0022fr\u0022:948,\u0022es\u0022:947,\u0022cn\u0022:947,\u0022it\u0022:949,\u0022