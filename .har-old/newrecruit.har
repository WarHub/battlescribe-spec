03C7\u03B9\u03C3\u03C4\u03C9\u03BD \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD\u0022,ru:\u0022\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022Set a minimum for extra points\u0022},j_e={en:\u0022Set a max for extra points\u0022,fr:\u0022D\u00E9finir un maximum pour les points suppl\u00E9mentaires\u0022,es:\u0022Establecer un m\u00E1ximo para puntos extra\u0022,cn:\u0022\u4E3A\u989D\u5916\u79EF\u5206\u8BBE\u7F6E\u6700\u5927\u503C\u0022,it:\u0022Set a max for extra points\u0022,de:\u0022Maximum f\u00FCr Extrapunkte festlegen\u0022,ja:\u0022\u8A2D\u5B9A a max \u306E\u305F\u3081\u306E extra \u30DD\u30A4\u30F3\u30C8\u0022,pl:\u0022Zestaw a maks for extra punkty\u0022,pt:\u0022Definir um m\u00E1ximo para pontos extra\u0022,hr:\u0022Postavite maksimum za dodatne bodove\u0022,cz:\u0022Set a max for extra points\u0022,sk:\u0022Set a max for extra points\u0022,gr:\u0022\u039F\u03C1\u03B9\u03C3\u03BC\u03CC\u03C2 \u03BC\u03AD\u03B3\u03B9\u03C3\u03C4\u03C9\u03BD \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD \u03C0\u03CC\u03BD\u03C4\u03C9\u03BD\u0022,ru:\u0022\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0447\u043A\u043E\u0432\u0022,ko:\u0022Set a max for extra points\u0022},z_e={en:\u0022Changes have been saved!\u0022,fr:\u0022Les modifications ont \u00E9t\u00E9 sauvegard\u00E9es !\u0022,es:\u0022\u00A1Los cambios han sido guardados!\u0022,cn:\u0022\u66F4\u6539\u5DF2\u4FDD\u5B58\uFF01\u0022,it:\u0022Changes have been saved!\u0022,de:\u0022\u00C4nderungen wurden gespeichert!\u0022,ja:\u0022Changes have been \u4FDD\u5B58\u6E08\u307F!\u0022,pl:\u0022Changes have been zapisane!\u0022,pt:\u0022Altera\u00E7\u00F5es foram salvas!\u0022,hr:\u0022Promjene su spremljene!\u0022,cz:\u0022Changes have been saved!\u0022,sk:\u0022Changes have been saved!\u0022,gr:\u0022\u039F\u03B9 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2 \u03B1\u03C0\u03BF\u03B8\u03B7\u03BA\u03B5\u03CD\u03C4\u03B7\u03BA\u03B1\u03BD\u0022,ru:\u0022\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B\u0022,ko:\u0022Changes have been saved!\u0022},I_e={en:\u0022Awaiting opponent team...\u0022,fr:\u0022En attente de l\u0027\u00E9quipe adverse...\u0022,es:\u0022Esperando equipo oponente...\u0022,cn:\u0022\u7B49\u5F85\u5BF9\u624B\u961F\u4F0D...\u0022,it:\u0022Awaiting opponent team...\u0022,de:\u0022Warte auf gegnerisches Team...\u0022,ja:\u0022Awaiting\u5BFE\u6226\u76F8\u624B\u30C1\u30FC\u30E0...\u0022,pl:\u0022Awaiting opponent dru\u017Cyna...\u0022,pt:\u0022Aguardando equipe oponente...\u0022,hr:\u0022\u010Ceka se protivni\u010Dki tim...\u0022,cz:\u0022Awaiting opponent team...\u0022,sk:\u0022Awaiting opponent team...\u0022,gr:\u0022\u0391\u03BD\u03B1\u03BC\u03BF\u03BD\u03AE \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2 \u03B1\u03BD\u03C4\u03B9\u03C0\u03AC\u03BB\u03BF\u03C5\u0022,ru:\u0022\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u0022,ko:\u0022Awaiting opponent team...\u0022},P_e={en:\u0022Click here to Match\u0022,fr:\u0022Cliquez ici pour Apparier\u0022,es:\u0022Haz clic aqu\u00ED para Emparejar\u0022,cn:\u0022\u70B9\u51FB\u6B64\u5904\u914D\u5BF9\u0022,it:\u0022Click here to Partita\u0022,de:\u0022Hier klicken zum Zuordnen\u0022,ja:\u0022\u30AF\u30EA\u30C3\u30AFhereto\u4E00\u81F4\u0022,pl:\u0022Kliknij tutaj do Dopasuj\u0022,pt:\u0022Clique aqui para Parear\u0022,hr:\u0022Kliknite ovdje za Uparivanje\u0022,cz:\u0022Click here to Match\u0022,sk:\u0022Click here to Match\u0022,gr:\u0022\u039A\u03AC\u03BD\u03C4\u03B5 \u03BA\u03BB\u03B9\u03BA \u03B5\u0