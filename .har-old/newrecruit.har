22,\u0022Nome Reale\u0022,\u0022Echter Name\u0022,\u0022\u672C\u540D\u0022,\u0022Nome Real\u0022,\u0022Pravo ime\u0022,\u0022\u03A0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,\u0022\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0438\u043C\u044F\u0022,{\u0022en\u0022:1581,\u0022fr\u0022:1582,\u0022es\u0022:1581,\u0022cn\u0022:1581,\u0022it\u0022:1583,\u0022de\u0022:1584,\u0022ja\u0022:1585,\u0022pl\u0022:1586,\u0022pt\u0022:1587,\u0022hr\u0022:1588,\u0022cz\u0022:1581,\u0022sk\u0022:1581,\u0022gr\u0022:1589,\u0022ru\u0022:1590,\u0022ko\u0022:1581},\u0022Enforce Discord username (players MUST enter their Discord ID when they sign up)\u0022,\u0022Forcer l\u0027ID Discord (les joueurs DOIVENT entrer leur ID Discord \u00E0 l\u0027inscription\u0022,\u0022Richiedi nome utente Discord (i giocatori DEVONO inserire il loro ID Discord quando si iscrivono)\u0022,\u0022Discord-Benutzername erzwingen (Spieler M\u00DCSSEN ihre Discord-ID bei der Anmeldung eingeben)\u0022,\u0022Discord\u30E6\u30FC\u30B6\u30FC\u540D\u3092\u5FC5\u9808\u306B\u3059\u308B\uFF08\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u6642\u306BDiscord ID\u3092\u5165\u529B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\uFF09\u0022,\u0022Enforce Discord nazwa u\u017Cytkownika (players MUST enter their Discord ID kiedy oni znak up)\u0022,\u0022Exigir nome de usu\u00E1rio Discord (jogadores DEVEM inserir seu ID do Discord ao se inscrever)\u0022,\u0022Obavezno Discord korisni\u010Dko ime (igra\u010Di MORAJU unijeti svoj Discord ID pri prijavi)\u0022,\u0022\u03A5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03CC Discord\u0022,\u0022\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C Discord ID\u0022,{\u0022en\u0022:1592,\u0022fr\u0022:1593,\u0022es\u0022:1592,\u0022cn\u0022:1592,\u0022it\u0022:1594,\u0022de\u0022:1595,\u0022ja\u0022:1596,\u0022pl\u0022:1597,\u0022pt\u0022:1598,\u0022hr\u0022:1599,\u0022cz\u0022:1592,\u0022sk\u0022:1592,\u0022gr\u0022:1600,\u0022ru\u0022:1601,\u0022ko\u0022:1592},\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022,\u0022Forcer les noms r\u00E9els (les joueurs DOIVENT entrer leur nom r\u00E9el \u00E0 l\u0027inscription\u0022,\u0022Richiedi nomi reali (i giocatori DEVONO inserire il loro nome reale quando si iscrivono)\u0022,\u0022Echte Namen erzwingen (Spieler M\u00DCSSEN ihren echten Namen bei der Anmeldung eingeben)\u0022,\u0022\u672C\u540D\u3092\u5FC5\u9808\u306B\u3059\u308B\uFF08\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u6642\u306B\u672C\u540D\u3092\u5165\u529B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\uFF09\u0022,\u0022Enforce prawdziwy names (players MUST enter their prawdziwy nazwa kiedy oni znak up)\u0022,\u0022Exigir nomes reais (jogadores DEVEM inserir seu nome real ao se inscrever)\u0022,\u0022Obavezna prava imena (igra\u010Di MORAJU unijeti svoje pravo ime pri prijavi)\u0022,\u0022\u03A5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03CC \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,\u0022\u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0438\u043C\u044F (\u0438\u0433\u0440\u043E\u043A\u0438 \u0414\u041E\u041B\u0416\u041D\u042B \u0432\u0432\u0435\u0441\u0442\u0438 \u0441\u0432\u043E\u0451 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0438\u043C\u044F \u043F\u0440\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438)\u0022,{\u0022en\u0022:1603,\u0022fr\u0022:1604,\u0022es\u0022:1603,\u0022cn\u0022:1603,\u0022it\u0022:1605,\u0022de\u0022:1606,\u0022ja\u0022:1607,\u0022pl\u0022:1603,\u0022pt\u0022:1608,\u0022hr\u0022:1609,\u0022cz\u0022:1603,\u0022sk\u0022:1603,\u0022gr\u0022:1610,\u0022ru\u0022:1611,\u0022ko\u0022:1612},\u0022Hide results of incomplete rounds\u0022,\u0022Masquer les r\u00E9sultats des rondes incompl\u00E8tes\u0022,\u0022Nascondi risultati dei turni incompleti\u0022,\u0022Ergebnisse unvollst\u00E4ndiger Runden ausblenden\u0022,\u0022\u672A\u5B8C\u4E86\u30E9\u30A6\u30F3\u30C9\u306E\u7D50\u679C\u3092\u975E\u8868\u793A\u0022,\u0022Ocultar resultados de rodadas incompletas\u0022,\u0022Sakrij rezultate nezavr\u0161enih rundi\u0022,\u0022\u0391\u03C0\u03CC\u03BA\u03C1\u03C5\u03C8\u03B7 \u03B7\u03BC\u03B9\u03C4\u03B5\u03BB\u03CE\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD \u03B3\u03CD\u03C1\u03BF\u03C5\u0022,\u0022\u0421\u043A\u0440\u044B\u0442\u044C \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B of \u041D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E \u0420\u0430\u0443\u043D\u0434\u044B\u0022,\u0022results of incomplete rounds \uC228\uAE30\uAE30\u0022,{\u0022en\u0022:1614,\u0022fr\u0022:1615,\u0022es\u0022:1614,\u0022cn\u0022:1614,\u0022it\u0022:1616,\u0022de\u0022:1617,\u0022ja\u0022:1618,\u0022pl\u0022:1619,\u0022pt\u0022:1620,\u0022hr\u0022:1621,\u0022cz\u0022:1614,\u0022sk\u0022:1614,\u0022gr\u0022:1622,\u0022ru\u0022:1623,\u0022ko\u0022:1614},\u0022Tournament is full\u0022,\u0022Le tournoi est plein\u0022,\u0022Il torneo \u00E8 completo\u0022,\u0022Turnier ist voll\u0022,\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u6E80\u54E1\u3067\u3059\u0022,\u0022Turniej is pe\u0142ne\u0022,\u0022Torneio est\u00E1 cheio\u0022,\u0022Turnir je popunjen\u0022,\u0022\u03A4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2\u0022,\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0022,{\u0022en\u0022:1625,\u0022fr\u0022:1626,\u0022es\u0022:1625,\u0022cn\u0022:1625,\u0022it\u0022:1627,\u0022de\u0022:1628,\u0022ja\u0022:1629,\u0022pl\u0022:1630,\u0022pt\u0022:1631,\u0022hr\u0022:1632,\u0022cz\u0022:1625,\u0022sk\u0022:1625,\u0022gr\u0022:1633,\u0022ru\u0022:1634,\u0022ko\u0022:1625},\u0022Subscription is confirmed\u0022,\u0022L\u0027inscription est confirm\u00E9e\u0022,\u0022L\u0027iscrizione \u00E8 confermata\u0022,\u0022Anmeldung ist best\u00E4tigt\u0022,\u0022\u767B\u9332\u304C\u78BA\u8A8D\u3055\u308C\u307E\u3057\u305F\u0022,\u0022Subskrypcja is potwierdzone\u0022,\u0022Inscri\u00E7\u00E3o est\u00E1 confirmada\u0022,\u0022Pretplata je potvr\u0111ena\u0022,\u0022\u0397 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03B8\u03B7\u03BA\u03B5\u0022,\u0022\u041F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430\u0022,{\u0022en\u0022:1636,\u0022fr\u0022:1637,\u0022es\u0022:1636,\u0022cn\u0022:1636,\u0022it\u0022:1638,\u0022de\u0022:1639,\u0022ja\u0022:1640,\u0022pl\u0022:1641,\u0022pt\u0022:1642,\u0022hr\u0022:1643,\u0022cz\u0022:1636,\u0022sk\u0022:1636,\u0022gr\u0022:1644,\u0022ru\u0022:1645,\u0022ko\u0022:1636},\u0022Payment has been received\u0022,\u0022Le paiement a \u00E9t\u00E9 re\u00E7u\u0022,\u0022Il pagamento \u00E8 stato ricevuto\u0022,\u0022Zahlung wurde erhalten\u0022,\u0022\u652F\u6255\u3044\u304C\u53D7\u9818\u3055\u308C\u307E\u3057\u305F\u0022,\u0022P\u0142atno\u015B\u0107 has been otrzymane\u0022,\u0022Pagamento foi recebido\u0022,\u0022Pla\u0107anje je primljeno\u0022,\u0022\u0397 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE \u03C4\u03BF\u03C5 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03BB\u03AE\u03C6\u03B8\u03B7\u0022,\u0022\u041E\u043F\u043B\u0430\u0442\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430\u0022,{\u0022en\u0022:1647,\u0022fr\u0022:1648,\u0022es\u0022:1647,\u0022cn\u0022:1647,\u0022it\u0022:1649,\u0022de\u0022:1650,\u0022ja\u0022:1651,\u0022pl\u0022:1652,\u0022pt\u0022:1653,\u0022hr\u0022:1654,\u0022cz\u0022:1647,\u0022sk\u0022:1647,\u0022gr\u0022:1655,\u0022ru\u0022:1656,\u0022ko\u0022:1647},\u0022Player or Team has one or more invalid lists\u0022,\u0022Le Joueur ou l\u0027Equipe a au moins une liste invalide\u0022,\u0022Il giocatore o la squadra ha una o pi\u00F9 liste non valide\u0022,\u0022Spieler oder Mannschaft hat eine oder mehrere ung\u00FCltige Listen\u0022,\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u307E\u305F\u306F\u30C1\u30FC\u30E0\u306B\u7121\u52B9\u306A\u30EA\u30B9\u30C8\u304C\u3042\u308A\u307E\u3059\u0022,\u0022Gracz or Dru\u017Cyna has jeden or bardziej nieprawid\u0142owy listy\u0022,\u0022Jogador ou Equipe tem uma ou mais listas inv\u00E1lidas\u0022,\u0022Igra\u010D ili tim ima jedan ili vi\u0161e neva\u017Ee\u0107ih popisa\u0022,\u0022\u039C\u03B7 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B5\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,\u0022\u0423 \u0438\u0433\u0440\u043E\u043A\u0430 \u0438\u043B\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0435\u0441\u0442\u044C \u043E\u0434\u0438\u043D \u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u043F\u0438\u0441\u043A\u043E\u0432\u0022,{\u0022en\u0022:1658,\u0022fr\u0022:1659,\u0022es\u0022:1658,\u0022cn\u0022:1658,\u0022it\u0022:1660,\u0022de\u0022:1661,\u0022ja\u0022:1662,\u0022pl\u0022:1663,\u0022pt\u0022:1664,\u0022hr\u0022:1665,\u0022cz\u0022:1658,\u0022sk\u0022:1658,\u0022gr\u0022:1666,\u0022ru\u0022:1667,\u0022ko\u0022:1658},\u0022All lists are valid for this Player or Team\u0022,\u0022Toutes les listes sont valides pour ce Joueur ou cette Equipe\u0022,\u0022Tutte le liste sono valide per questo giocatore o squadra\u0022,\u0022Alle Listen sind f\u00FCr diesen Spieler oder diese Mannschaft g\u00FCltig\u0022,\u0022\u3053\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u307E\u305F\u306F\u30C1\u30FC\u30E0\u306E\u3059\u3079\u3066\u306E\u30EA\u30B9\u30C8\u304C\u6709\u52B9\u3067\u3059\u0022,\u0022Wszystkie listy are wa\u017Cne for to Gracz or Dru\u017Cyna\u0022,\u0022Todas as listas s\u00E3o v\u00E1lidas para este Jogador ou Equipe\u0022,\u0022Svi popisi su va\u017Ee\u0107i za ovog igra\u010Da ili tim\u0022,\u0022\u038C\u03BB\u03B5\u03C2 \u03BF\u03B9 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B5\u03C2\u0022,\u0022\u0412\u0441\u0435 \u0441\u043F\u0438\u0441\u043A\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430 \u0438\u043B\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,{\u0022en\u0022:1669,\u0022fr\u0022:1669,\u0022es\u0022:1669,\u0022cn\u0022:1669,\u0022it\u0022:1670,\u0022de\u0022:1671,\u0022ja\u0022:1672,\u0022pl\u0022:1669,\u0022pt\u0022:1673,\u0022hr\u0022:1674,\u0022cz\u0022:1669,\u0022sk\u0022:1669,\u0022gr\u0022:1675,\u0022ru\u0022:1676,\u0022ko\u0022:1669},\u0022Votes\u0022,\u0022Voti\u0022,\u0022Abstimmungen\u0022,\u0022\u6295\u7968\u0022,\u0022Votos\u0022,\u0022Glasovi\u0022,\u0022\u03A8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2\u0022,\u0022\u0413\u043E\u043B\u043E\u0441\u0430\u0022,{\u0022en\u0022:1678,\u0022fr\u0022:1679,\u0022es\u0022:1678,\u0022cn\u0022:1678,\u0022it\u0022:1680,\u0022de\u0022:1681,\u0022ja\u0022:1682,\u0022pl\u0022:1683,\u0022pt\u0022:1684,\u0022hr\u0022:1685,\u0022cz\u0022:1678,\u0022sk\u0022:1678,\u0022gr\u0022:1686,\u0022ru\u0022:1687,\u0022ko\u0022:1688},\u0022Create new Vote\u0022,\u0022Cr\u00E9er un vote\u0022,\u0022Crea nuovo voto\u0022,\u0022Neue Abstimmung Erstellen\u0022,\u0022\u65B0\u898F\u6295\u7968\u3092\u4F5C\u6210\u0022,\u0022Utw\u00F3rz nowe G\u0142osowanie\u0022,\u0022Criar nova Vota\u00E7\u00E3o\u0022,\u0022Kreiraj novo glasanje\u0022,\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 \u03BD\u03AD\u03B1\u03C2 \u03C8\u03B7\u03C6\u03BF\u03C6\u03BF\u03C1\u03AF\u03B1\u03C2\u0022,\u0022\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u041D\u043E\u0432\u044B\u0