   Inspired by \u003Ca href=\u0022https://nilsueter.github.io/fancyscribe/\u0022 target=\u0022_blank\u0022\u003E\u003Cb\u003EFancyScribe\u003C/b\u003E\u003C/a\u003E\n  \u003C/p\u003E\n  \u003Csetting id=\u0022expandRules\u0022 label=\u0022Expand Rules\u0022 type=\u0022checkbox\u0022 default=\u0022false\u0022 /\u003E\n  \u003Csetting id=\u0022showUnitImages\u0022 label=\u0022Include Unit Images\u0022 type=\u0022checkbox\u0022 default=\u0022true\u0022 /\u003E\n  \u003Cset name=\u0022ruleProfiles\u0022 value=\u0022special rule,rule,rules\u0022 /\u003E\n  \u003Cset name=\u0022unitProfiles\u0022 value=\u0022model,unit,stats,vehicle,ship,profile,knight\u0022 /\u003E\n  \u003Cset name=\u0022hideCharacteristics\u0022 value=\u0022troop type,unit size,unit type,access points,type\u0022 /\u003E\n  \u003Cset name=\u0022dataProfiles\u0022 value=\u0022ranged weapons,ranged weapon,psychic weapon,melee weapons,melee weapon,weapons,magic weapons,magic weapon,weapon,spell,load\u0022 /\u003E\n  \u003Cset\n    name=\u0022abilityProfiles\u0022\n    value=\u0022ability,abilities,ability (passive),ability (activated),ability (spell),ability (command),ability (prayer),psychic power,wargear item,reaction\u0022\n  \u003E\n    \u003Cif field=\u0022settings.expandRules.state\u0022 type=\u0022equals\u0022 value=\u0022true\u0022\u003E\n      \u003Cappend-attribute name=\u0022value\u0022 value=\u0022special rule,rule,rules\u0022 join=\u0022,\u0022 /\u003E\n    \u003C/if\u003E\n  \u003C/set\u003E\n  \u003Cset name=\u0022hideProfiles\u0022 value=\u0022base\u0022 /\u003E\n  \u003Cset name=\u0022infoCharacteristics\u0022 value=\u0022abilities,notes,note,description,effect,details,longText\u0022 /\u003E\n  \u003Cset name=\u0022inlineCharacteristics\u0022 value=\u0022tag,annotation,keywords,special rules,ability,number,special\u0022\u003E\n    \u003Cif field=\u0022system.name\u0022 type=\u0022equals\u0022 value=\u0022Horus Heresy (2022)\u0022\u003E\n      \u003Cappend-attribute name=\u0022value\u0022 value=\u0022type\u0022 join=\u0022,\u0022 /\u003E\n    \u003C/if\u003E\n  \u003C/set\u003E\n\n  \u003Cunits dedupe=\u0022true\u0022\u003E\n    \u003Cif type=\u0022has-profile\u0022 value=\u0022{{unitProfiles}}\u0022 recursive=\u0022true\u0022\u003E\n      \u003Cdiv class=\u0022avoid-page-break\u0022 style=\u0022margin-bottom: 52px\u0022 type=\u0022card\u0022 catalogue=\u0022{{catalogue}}\u0022\u003E\n        \u003Cdiv\n          class=\u0022min-h-15rem\u0022\n          style=\u0022\n            padding: 24px 0px;\n            background: linear-gradient(90deg, rgb(20, 21, 25) 0%, rgb(48, 57, 62) 45%, rgb(73, 74, 79) 100%);\n            color: rgb(255, 255, 255);\n            position: relative;\n          \u0022\n        \u003E\n          \u003Cdiv style=\u0022display: flex; gap: 5px\u0022\u003E\n            \u003C!-- Header Section --\u003E\n            \u003Cdiv style=\u0022padding: 4px 16px; color: rgb(255, 255, 255); position: relative; margin-left: 1.3rem; flex: 1\u0022\u003E\n              \u003C!--  Title Background Graphic --\u003E\n              \u003Cdiv style=\u0022position: absolute; left: 0px; top: 0px; width: 100%; display: flex\u0022\u003E\n                \u003Cdiv style=\u0022background-color: var(--primary-color-transparent); height: 80px; min-width: 33%\u0022\u003E \u003C/div\u003E\n                \u003Cdiv style=\u0022height: 79px; display: flex; flex-direction: column\u0022\u003E\n                  \u003Cdiv style=\u0022background-color: var(--primary-color-transparent); height: 40px\u0022\u003E\u003C/div\u003E\n                  \u003Csvg height=\u002240\u0022 width=\u0022100\u0022 viewBox=\u00220 0 100 40\u0022 style=\u0022fill: var(--primary-color-transparent)\u0022\u003E\n                    \u003Cpath d=\u0022m0 0h100c-32 0-68 40-100 40z\u0022\u003E\u003C/path\u003E\n                  \u003C/svg\u003E\n                \u003C/div\u003E\n                \u003Cdiv style=\u0022flex: 10 1 0%; background-color: var(--primary-color-transparent); height: 40px\u0022\u003E \u003C/div\u003E\n              \u003C/div\u003E\n\n              \u003C!--  Unit Name \u0026 Costs --\u003E\n              \u003Cdiv\n                style=\u0022\n                  font-family: ConduitITCStd;\n                  font-size: 2.5em;\n                  letter-spacing: 0.1px;\n                  line-height: 1;\n                  font-weight: 800;\n                  text-transform: uppercase;\n                  z-index: 1;\n                  position: relative;\n                  display: flex;\n                  justify-content: space-between;\n                  align-items: center;\n                  margin-bottom: 2px;\n                \u0022\n              \u003E\n                \u003Cif field=\u0022customName\u0022\u003E\n                  \u003Cspan\u003E{{customName}} \u003Cspan style=\u0022color: darkgrey; margin-left: 10px\u0022\u003E{{name}}\u003C/span\u003E\u003C/span\u003E\n                \u003C/if\u003E\n                \u003Celse\u003E\n                  \u003Cspan\u003E{{name}}\u003C/span\u003E\n                \u003C/else\u003E\n                \u003Ccosts\u003E\n                  \u003Cspan style=\u0022text-transform: initial; font-size: 1.2rem\u0022\u003E\n                    \u003Cspan\u003E{{value}}\u003C/span\u003E\n                    \u003Cspan\u003E{{name}}\u003C/span\u003E\n                  \u003C/span\u003E\n                \u003C/costs\u003E\n              \u003C/div\u003E\n\n              \u003C!-- Models --\u003E\n              \u003Cdiv style=\u0022display: flex; flex-direction: column; gap: 6px; z-index: 1; position: relative\u0022\u003E\n                \u003CgroupBy\u003E\n                  \u003Centries\u003E\n                    \u003Cif type=\u0022has-profile\u0022 value=\u0022{{unitProfiles}}\u0022\u003E\n                      \u003Cby\u003E\n                        \u003Cprofiles include=\u0022{{unitProfiles}}\u0022 recursive=\u0022false\u0022\u003E\n                          \u003Ccharacteristics exclude=\u0022{{hideCharacteristics}}\u0022\u003E{{name}}{{$text}} \u003C/characteristics\u003E\n                        \u003C/profiles\u003E\n                      \u003C/by\u003E\n                    \u003C/if\u003E\n                  \u003C/entries\u003E\n\n                  \u003Cgroups\u003E\n                    \u003Cdiv style=\u0022display: flex; gap: 6px; z-index: 1; position: relative\u0022\u003E\n                      \u003C!-- Model Stats --\u003E\n                      \u003Citems max=\u00221\u0022\u003E\n                        \u003Cprofiles include=\u0022{{unitProfiles}}\u0022 recursive=\u0022false\u0022\u003E\n                          \u003Ccharacteristics exclude=\u0022{{hideCharacteristics}}\u0022\u003E\n                            \u003Cdiv class=\u0022modelCharacteristic\u0022 style=\u0022display: flex; flex-direction: column; align-items: center\u0022\u003E\n                              \u003Cdiv style=\u0022font-size: 0.9em; font-weight: 800\u0022\u003E{{name}}\u003C/div\u003E\n                              \u003Cdiv\n                                style=\u0022\n                                  color: var(--primary-color);\n                                  padding: 2px;\n                                  background: var(--primary-color);\n                                  clip-path: polygon(12% 0px, 100% 0px, 100% 20%, 100% 88%, 88% 100%, 20% 100%, 0px 100%, 0px 12%);\n                                \u0022\n                              \u003E\n                                \u003Cdiv\n                                  style=\u0022\n                                    min-width: 3rem;\n                                    min-height: 3rem;\n                                    display: flex;\n                                    align-items: center;\n                                    justify-content: center;\n                                    background: rgb(232, 237, 231);\n                                    clip-path: polygon(10% 0px, 100% 0px, 100% 20%, 100% 90%, 90% 100%, 20% 100%, 0px 100%, 0px 10%);\n                                    padding: 3px;\n                                    font-size: 1.6em;\n                                    font-weight: 800;\n                                  \u0022\n                                \u003E\n                                  {{$text}}\n                                \u003C/div\u003E\n                              \u003C/div\u003E\n                            \u003C/div\u003E\n                          \u003C/characteristics\u003E\n                        \u003C/profiles\u003E\n                      \u003C/items\u003E\n\n                      \u003Cdiv class=\u0022model\u0022 style=\u0022display: flex; gap: 1.2rem\u0022\u003E\n                        \u003Citems\u003E\n                          \u003C!-- Model Name \u0026 Options --\u003E\n                          \u003Cdiv class=\u0022flex flex-wrap items-center gap-2 model-name-options\u0022 style=\u0022margin-top: 16px; text-shadow: rgb(0, 0, 0) 0px 0px 5px; display: inline-block\u0022\u003E\n                            \u003Cspan style=\u0022white-space: nowrap\u0022\u003E\n                              \u003Cif field=\u0022amount\u0022 type=\u0022greater\u0022 value=\u00221\u0022\u003E\n                                \u003Cspan\u003E{{amount}}x\u003C/span\u003E\n                              \u003C/if\u003E\n                              \u003Cif field=\u0022ungrouped.length\u0022 type=\u0022greater\u0022 value=\u00221\u0022\u003E\n                                \u003Cspan class=\u0022model-name\u0022\u003E{{name}}\u003C/span\u003E\n                              \u003C/if\u003E\n                            \u003C/span\u003E\n                            \u003Cdiv style=\u0022font-size: 0.7em\u0022\u003E\n                              \u003Cdiv class=\u0022model-options\u0022\u003E {{options}}\u003C/div\u003E\n                            \u003C/div\u003E\n                          \u003C/div\u003E\n                        \u003C/items\u003E\n                      \u003C/div\u003E\n                    \u003C/div\u003E\n                  \u003C/groups\u003E\n                \u003C/groupBy\u003E\n              \u003C/div\u003E\n            \u003C/div\u003E\n\n            \u003C!-- Unit Miniature Image --\u003E\n            \u003Cif field=\u0022settings.showUnitImages.state\u0022 type=\u0022equals\u0022 value=\u0022true\u0022\u003E\n              \u003Cif field=\u0022miniatureImageUrl\u0022\u003E\n                \u003Cdiv style=\u0022border: 3px solid var(--primary-color); border-radius: 8px; overflow: hidden; background: white; flex-shrink: 0; align-self: flex-start\u0022\u003E\n                  \u003Cimg src=\u0022https://www.newrecruit.eu{{miniatureImageUrl}}\u0022 alt=\u0022{{name}}\u0022 style=\u0022width: 100px; height: 125px; object-fit: cover; display: block\u0022 /\u003E\n                \u003C/div\u003E\n              \u003C/if\u003E\n            \u003C/if\u003E\n          \u003C/div\u003E\n        \u003C/div\u003E\n        \u003Cdiv class=\u0022border-b-2 border-t-0 border-var(--primary-color) sm:border-l-2 sm:border-r-2\u0022 style=\u0022display: flex; background-color: rgb(223, 224, 226)\u0022\u003E\n          \u003C!-- Left Section --\u003E\n          \u003Cdiv class=\u0022pt-5\u0022 style=\u0022width: 65%; border-right: 2px solid var(--primary-color); position: relative; padding-bottom: 40px; display: flex; flex-direction: column\u0022\u003E\n            \u003C!-- Data Profiles --\u003E\n            \u003Cprofiles grouped=\u0022true\u0022 include=\u0022{{dataProfiles}}\u0022\u003E\n              \u003Ctable cellspacing=\u00220\u0022 class=\u0022weapons-table\u0022 style=\u0022width: 100%\u0022\u003E\n                \u003Cthead\u003E\n                  \u003Citems max=\u00221\u0022\u003E\n                    \u003Ctr class=\u0022uppercase\u0022 style=\u0022background-color: var(--primary-color); color: rgb(255, 255, 255)\u0022\u003E\n                      \u003Cth style=\u0022max-width: 32px; min-width: 32px; width: 0%\u0022\u003E\n                        \u003Cdiv style=\u0022display: flex; width: 100%; justify-content: center\u0022\u003E\n                          \u003Cimg class=\u0022profile-icon\u0022 typeName=\u0022{{typeName}}\u0022 style=\u0022max-width: 20px\u0022 src=\u0022\u0022 /\u003E\n                        \u003C/div\u003E\n                      \u003C/th\u003E\n                      \u003Cth style=\u0022text-align: left\u0022 class=\u0022row-header\u0022\u003E\n                        \u003Cspan\u003E{{typeName}}\u003C/span\u003E\n                        \u003Cif field=\u0022group\u0022\u003E\u003Cspan style=\u0022font-weight: normal; text-transform: none\u0022\u003E({{group}})\u003C/span\u003E \u003C/if\u003E\n                      \u003C/th\u003E\n\n                      \u003Ccharacteristics exclude=\u0022{{inlineCharacteristics}},{{infoCharacteristics}}\u0022\u003E\n                        \u003Cth class=\u0022data-cell\u0022\u003E{{name}}\u003C/th\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n                  \u003C/items\u003E\n                \u003C/thead\u003E\n                \u003Ctbody\u003E\n                  \u003Citems\u003E\n                    \u003Ctr\u003E\n                      \u003Ctd style=\u0022border-top: none; background-color: rgb(223, 224, 226)\u0022\u003E\u003C/td\u003E\n                      \u003Ctd style=\u0022text-align: left\u0022\u003E\n                        \u003Cdiv style=\u0022display: flex; align-items: baseline; flex-wrap: wrap; gap: 0px 4px; line-height: 1.05\u0022\u003E\n                          \u003Cspan style=\u0022font-weight: bold\u0022\u003E{{name}}\u003C/span\u003E\n\n                          \u003C!-- Inlined after name Characteristics --\u003E\n                          \u003Ccharacteristics include=\u0022{{inlineCharacteristics}}\u0022 max=\u00221\u0022\u003E\n                            \u003Cif type=\u0022not-match\u0022 value=\u0022^\\\\\\\\s*-\\\\\\\\s*$\u0022 field=\u0022$text\u0022\u003E\n                              \u003Cspan if=\u0022$text\u0022 style=\u0022font-size: 0.8em; font-weight: 700; color: var(--primary-color); text-transform: uppercase; line-height: 1.5\u0022\u003E\n                                [\u003Cspan type=\u0022markdown\u0022\u003E{{$text}}\u003C/span\u003E]\n                              \u003C/span\u003E\n                            \u003C/if\u003E\n                          \u003C/characteristics\u003E\n                        \u003C/div\u003E\n                      \u003C/td\u003E\n                      \u003Ccharacteristics exclude=\u0022{{inlineCharacteristics}},{{infoCharacteristics}}\u0022\u003E\n                        \u003Ctd class=\u0022align-middle\u0022 type=\u0022markdown\u0022\u003E{{$text}}\u003C/td\u003E\n                      \u003C/characteristics\u003E\n                    \u003C/tr\u003E\n\n                    \u003C!-- Full row spanning characteristic such as notes --\u003E\n                    \u003Ccharacteristics include=\u0022{{infoCharacteristics}}\u0022\u003E\n                      \u003Cif field=\u0022$text\u0022\u003E\n                        \u003Cif field=\u0022$text\u0022 type=\u0022not-match\u0022 value=\u0022^[-\\\\\\\\s]*$\u0022\u003E\n                          \u003Ctr class=\u0022noBorderTop\u0022\u003E\n                            \u003Ctd style=\u0022border-top: none; background-color: rgb(223, 224, 226)\u0022\u003E \u003C/td\u003E\n                            \u003Ctd colspan=\u00227\u0022 class=\u0022row\u0022 style=\u0022text-align: left; font-size: 0.9em; padding-top: 0px; padding-bottom: 1px; line-height: 1.4\u0022 type=\u0022markdown\u0022\n                              \u003E{{$text}}\u003C/td\n                            \u003E\n                          \u003C/tr\u003E\n                        \u003C/if\u003E\n                      \u003C/if\u003E\n                    \u003C/characteristics\u003E\n                  \u003C/items\u003E\n                  \u003Citems max=\u00221\u0022\u003E\n                    \u003Ctr class=\u0022emptyRow\u0022\u003E\n                      \u003Ctd style=\u0022border-top: none\u0022\u003E\u003C/td\u003E\n                      \u003Ctd colspan=\u00227\u0022\u003E\u003C/td\u003E\n                    \u003C/tr\u003E\n                  \u003C/items\u003E\n                \u003C/tbody\u003E\n              \u003C/table\u003E\n            \u003C/profiles\u003E\n\n            \u003C!-- Remaining Misc profiles --\u003E\n            \u003Cprofiles grouped=\u0022true\u0022 exclude=\u0022{{unitProfiles}},{{ruleProfiles}},{{dataProfiles}},{{abilityProfiles}},{{hideProfiles}}\u0022\u003E\n              \u003Ctable cellspacing=\u00220\u0022 style=\u0022width: 100%\u0022 class=\u0022removable\u0022\u003E\n                \u003Cthead\u003E\n                  \u003Citems max=\u00221\u0022\u003E\n                    \u003Ctr class=\u0022uppercase\u0022 style=\u0022background-color: var(--primary-color); color: rgb(255, 255, 255)\u0022\u003E\n                      \u003Cth style=\u0022width: 32px; min-width: 32px\u0022 /\u003E\n                      \u003Cth colspan=\u00227\u0022 class=\u0022row\u0022 style=\u0022text-align: left\u0022\u003E{{typeName}}\u003C/th\u003E\n                    \u003C/tr\u003E\n                  \u003C/items\u003E\n                \u003C/thead\u003E\n                \u003Ctbody\u003E\n                  \u003Citems\u003E\n                    \u003Ctr style=\u0022border-top: 1px dotted #9e9fa1\u0022 class=\u0022removable\u0022\u003E\n                      \u003Ctd class=\u0022w-2em\u0022\u003E\u003C/td\u003E\n                      \u003Ctd colspan=\u00227\u0022 style=\u0022font-size: 1em; line-height: 1.4; text-align: left; padding-top: 4px; padding-bottom: 4px\u0022\u003E\n                        \u003Cspan style=\u0022font-weight: 700\u0022\u003E{{name}}\u003C/span\u003E:\n                        \u003Ccharacteristics\u003E\n                          \u003Cif field=\u0022$text\u0022\u003E\n                            \u003Cif field=\u0022length\u0022 type=\u0022greater\u0022 value=\u00221\u0022\u003E\n                              \u003Cdiv style=\u0022margin-left: 4px\u0022\n                                \u003E\u003Cspan style=\u0022font-weight: bold; font-size: 0.8em\u0022\u003E{{name}}\u003C/span\u003E:\n                                \u003Cspan type=\u0022markdown\u0022\u003E{{$text}}\u003C/span\u003E\n                              \u003C/div\u003E\n                            \u003C/if\u003E\n                            \u003Cif field=\u0022length\u0022 type=\u0022atmost\u0022 value=\u00221\u0022\u003E\n                              \u003Cspan type=\u0022markdown\u0022\u003E{{$text}}\u003C/span\u003E\n                            \u003C/if\u003E\n                          \u003C/if\u003E\n                        \u003C/characteristics\u003E\n                      \u003C/td\u003E\n                    \u003C/tr\u003E\n                  \u003C/items\u003E\n                \u003C/tbody\u003E\n              \u003C/table\u003E\n            \u003C/profiles\u003E\n\n            \u003C!-- Keywords / Categories --\u003E\n            \u003Cdiv\n              style=\u0022\n                position: absolute;\n                right: -2px;\n                bottom: -16px;\n                padding: 0px 42px 0px 8px;\n                display: flex;\n                align-items: center;\n                background-color: rgb(188, 188, 190);\n                border: 2px solid var(--primary-color);\n                width: calc(100% - 0.9rem);\n                background-size: contain;\n                min-height: 54px;\n                gap: 3px;\n              \u0022\n            \u003E\n              \u003Cspan style=\u0022font-size: 1.1em\u0022\u003EKEYWORDS:\u003C/span\u003E\n              \u003Cdiv\u003E\n                \u003Csecondaries\u003E\n                  \u003Cif field=\u0022name\u0022 type=\u0022not-match\u0022 value=\u0022faction: .*\u0022 flags=\u0022i\u0022\u003E\n                    \u003Cif field=\u0022length\u0022 type=\u0022atleast\u0022 value=\u00225\u0022\u003E\n                      \u003Cspan class=\u0022split rule\u0022 style=\u0022font-size: 0.9em; font-weight: 800; display: inline-block\u0022\u003E{{name}}\u003C/span\u003E\n                    \u003C/if\u003E\n                    \u003Cif field=\u0022length\u0022 type=\u0022less\u0022 value=\u00225\u0022\u003E\n                      \u003Cspan class=\u0022split rule\u0022 style=\u0022font-size: 1em; font-weight: 800; display: inline-block\u0022\u003E{{name}}\u003C/span\u003E\n                    \u003C/if\u003E\n                  \u003C/if\u003E\n                \u003C/secondaries\u003E\n              \u003C/div\u003E\n            \u003C/div\u003E\n          \u003C/div\u003E\n\n          \u003C!-- Right Section --\u003E\n          \u003Cdiv\n            class=\u0022relative w-full flex-1 p-1 pb-50pxpt-5 print:p-20px sm:p-2 sm:pb-50px sm:pt-5 sm:print:p-20px sm:print:pb-50px md:p-20px md:pb-50px md:pt-5 md:print:p-20px md:print:pb-50px\u0022\n          \u003E\n            \u003Cdiv\n              style=\u0022\n                font-size: 1.1em;\n                padding: 1px 6px;\n                background-color: var(--primary-color);\n                color: rgb(255, 255, 255);\n                font-weight: 600;\n                min-height: 27px;\n                display: flex;\n                align-items: center;\n              \u0022\n            \u003E\n              ABILITIES\n            \u003C/div\u003E\n\n            \u003C!-- Rules --\u003E\n            \u003Cdiv class=\u0022rules-block\u0022 style=\u0022padding: 5px 2px; gap: 3px; border-bottom: 1px dotted rgb(158, 159, 161); line-height: 1.3; display: flex; flex-wrap: wrap\u0022\u003E\n              \u003Cspan style=\u0022font-size: 0.8em\u0022\u003ERULES: \u003C/span\u003E\n              \u003Cprofiles include-rules=\u0022true\u0022 exclude-entries-with-profile=\u0022{{dataProfiles}}\u0022 exclude=\u0022{{abilityProfiles}}\u0022 include=\u0022{{ruleProfiles}}\u0022\u003E\n                \u003Cspan class=\u0022split rule\u0022 style=\u0022white-space: nowrap; font-size: 0.8em; font-weight: 700\u0022\u003E{{name}}\u003C/span\u003E\n              \u003C/profiles\u003E\n            \u003C/div\u003E\n\n            \u003C!-- Ability Profiles --\u003E\n            \u003Cdiv class=\u0022hide-if-empty\u0022 style=\u0022display: flex; flex-direction: column; gap: 8px; padding: 4px 2px; border-bottom: 1px dotted rgb(158, 159, 161)\u0022\u003E\n              \u003Cprofiles include-rules=\u0022true\u0022 include=\u0022{{abilityProfiles}}\u0022 exclude-entries-with-profile=\u0022{{dataProfiles}}\u0022\u003E\n                \u003Cdiv class=\u0022removable\u0022 style=\u0022font-size: 0.8em; line-height: 1.4\u0022\u003E\n                  \u003Cspan class=\u0022rule-name\u0022 style=\u0022font-weight: 700\u0022\u003E{{name}}\u003C/span\u003E\n                  \u003Ccharacteristics\u003E\n                    \u003Cif field=\u0022$text\u0022\u003E\n                      \u003Cif field=\u0022length\u0022 type=\u0022greater\u0022 value=\u00221\u0022\u003E\n                        \u003Cdiv class=\u0022removable\u0022 style=\u0022margin-left: 4px\u0022\n                          \u003E\u003Cspan style=\u0022font-weight: bold; font-size: 0.8em\u0022\u003E{{name}}\u003C/span\u003E:\n                          \u003Cspan type=\u0022markdown\u0022\u003E{{$text}}\u003C/span\u003E\n                        \u003C/div\u003E\n                      \u003C/if\u003E\n                      \u003Cif field=\u0022length\u0022 type=\u0022atmost\u0022 value=\u00221\u0022\u003E\n                        \u003Cspan class=\u0022removable\u0022 type=\u0022markdown\u0022\u003E{{$text}}\u003C/span\u003E\n                      \u003C/if\u003E\n                    \u003C/if\u003E\n                  \u003C/characteristics\u003E\n                \u003C/div\u003E\n              \u003C/profiles\u003E\n            \u003C/div\u003E\n\n            \u003C!-- Placeholder to prevent text being under keywords --\u003E\n            \u003Cdiv style=\u0022margin-bottom: 50px\u0022 /\u003E\n\n            \u003C!-- Faction Keywords/Categories --\u003E\n            \u003Cdiv class=\u0022keywords\u0022\u003E\n              \u003Cspan style=\u0022font-size: 0.9em; line-height: 1.3\u0022\u003EFACTION KEYWORDS:\u003C/span\u003E\n              \u003Csecondaries\u003E\n                \u003Cif field=\u0022name\u0022 type=\u0022match\u0022 value=\u0022faction: .*\u0022 flags=\u0022i\u0022\u003E\n                  \u003Cscript\u003E\n                    cleanedName = String(secondary.name ?? \u0022\u0022).match(/faction: (.*)/i)[1];\n                  \u003C\\/script\u003E\n                  \u003Cspan class=\u0022split keyword\u0022 style=\u0022font-size: 0.9em; font-weight: 600; white-space: nowrap\u0022\u003E{{cleanedName}}\u003C/span\u003E\n                \u003C/if\u003E\n              \u003C/secondaries\u003E\n            \u003C/div\u003E\n\n            \u003C!-- Faction Icon--\u003E\n            \u003Cdiv\n              style=\u0022\n                position: absolute;\n                left: -28px;\n                bottom: -16px;\n                width: 54px;\n                height: 54px;\n                transform: rotate(-45deg);\n                border: 2px solid var(--primary-color);\n                overflow: hidden;\n                display: flex;\n                align-items: center;\n                justify-content: center;\n              \u0022\n            \u003E\n              \u003Cdiv style=\u0022background: center center rgb(188, 188, 190); min-height: 75px; min-width: 76px; transform: rotate(45deg)\u0022\u003E \u003C/div\u003E\n            \u003C/div\u003E\n          \u003C/div\u003E\n        \u003C/div\u003E\n      \u003C/div\u003E\n    \u003C/if\u003E\n  \u003C/units\u003E\n\n  \u003C!-- Rules --\u003E\n  \u003Cdiv type=\u0022card\u0022\u003E\n    \u003Cdiv class=\u0022rules-list\u0022\u003E\n      \u003Cforces\u003E\n        \u003Cif type=\u0022has-rule\u0022\u003E\n          \u003Cdiv class=\u0022force removable\u0022\n            \u003E\u003Cspan class=\u0022force-name\u0022\u003E{{name}}\u003C/span\u003E \u003Cspan class=\u0022force-catalogue\u0022\u003E({{catalogue}})\u003C/span\u003E\n            \u003Crules recursive=\u0022false\u0022\u003E\n              \u003Cdiv class=\u0022rule nested removable\u0022\u003E\n                \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n                \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{description}}\u003C/span\u003E\n              \u003C/div\u003E\n            \u003C/rules\u003E\n          \u003C/div\u003E\n        \u003C/if\u003E\n      \u003C/forces\u003E\n      \u003Cprofiles include-rules=\u0022true\u0022 include=\u0022{{ruleProfiles}}\u0022\u003E\n        \u003Cdiv class=\u0022rule removable\u0022\u003E\n          \u003Cspan class=\u0022rule-name\u0022\u003E{{name}}\u003C/span\u003E\n          \u003Ccharacteristics\u003E\n            \u003Cspan class=\u0022rule-desc\u0022 type=\u0022markdown\u0022\u003E{{value}}\u003C/span\u003E\n          \u003C/characteristics\u003E\n        \u003C/div\u003E\n      \u003C/profiles\u003E\n    \u003C/div\u003E\n  \u003C/div\u003E\n\u003C/template\u003E\n\u003Cstyle\u003E\n  @import url(\u0022https://cdn.jsdelivr.net/npm/notosans-fontface@1.3.0/css/notosans-fontface.min.css\u0022);\n\n  html {\n    --primary-color: #206173;\n    --primary-color-transparent: #20617360;\n  }\n\n  html {\n    line-height: 1.5;\n    -webkit-text-size-adjust: 100%;\n    -moz-tab-size: 4;\n    -o-tab-size: 4;\n    tab-size: 4;\n    font-feature-settings: normal;\n    font-variation-settings: normal;\n\n    @media screen and (min-width: 1400px) {\n      column-count: 2;\n      column-gap: 10px;\n    }\n\n    @media screen and (min-width: 1950px) {\n      column-count: 3;\n      column-gap: 10px;\n    }\n\n    @media screen and (min-width: 2600px) {\n      column-count: 4;\n      column-gap: 10px;\n    }\n  }\n\n  @media print {\n    body {\n      margin: 0;\n      line-height: inherit;\n    }\n  }\n\n  h1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6 {\n    font-size: inherit;\n    font-weight: inherit;\n  }\n\n  b,\n  strong {\n    font-weight: bolder;\n  }\n\n  small {\n    font-size: 80%;\n  }\n\n  table {\n    text-indent: 0;\n    border-color: inherit;\n    border-collapse: collapse;\n  }\n\n  blockquote,\n  dl,\n  dd,\n  h1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6,\n  hr,\n  figure,\n  p,\n  pre {\n    margin: 0;\n  }\n\n  ol,\n  ul,\n  menu {\n    margin: 0;\n    padding-left: 18px;\n    margin-bottom: -18px;\n  }\n\n  :disabled {\n    cursor: default;\n  }\n\n  img,\n  svg,\n  video,\n  canvas,\n  audio,\n  iframe,\n  embed,\n  object {\n    display: block;\n    vertical-align: middle;\n  }\n\n  img,\n  video {\n    max-width: 100%;\n    height: auto;\n  }\n\n  [hidden] {\n    display: none;\n  }\n\n  *,\n  :before,\n  :after {\n    box-sizing: border-box;\n    border-width: 0;\n    border-style: solid;\n    border-color: #e5e7eb;\n  }\n\n  :root {\n    font-family: \u0022Noto Sans\u0022, sans-serif, Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;\n\n    font-size: 14px;\n    color-scheme: light dark;\n    color: #111113;\n    background-color: #fff;\n    text-rendering: optimizeLegibility;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    -webkit-text-size-adjust: 100%;\n    --size-20: 20px;\n    --size-24: 24px;\n    --size-32: 32px;\n  }\n\n  @font-face {\n    font-family: ConduitITCStd;\n    src: url(\u0022https://nilsueter.github.io/fancyscribe/fonts/ConduitITCStd ExtraBold.woff2\u0022) format(\u0022woff2\u0022);\n    font-weight: 800;\n  }\n\n  @font-face {\n    font-family: ConduitITCStd;\n    src: url(\u0022https://nilsueter.github.io/fancyscribe/fonts/ConduitITCStd Bold.woff2\u0022) format(\u0022woff2\u0022);\n    font-weight: 700;\n  }\n\n  * {\n    box-sizing: border-box;\n    print-color-adjust: exact;\n    -webkit-print-color-adjust: exact;\n  }\n\n  body {\n    margin: 0;\n  }\n\n  h1 {\n    font-size: 3.2em;\n    line-height: 1.1;\n  }\n\n  a {\n    font-weight: 500;\n    color: #646cff;\n    text-decoration: inherit;\n  }\n\n  a:hover {\n    color: #535bf2;\n  }\n\n  .weapons-table th {\n    font-size: 1.1em;\n    padding: 2px 0.8rem;\n    height: 27px;\n    font-weight: 600;\n  }\n\n  .weapons-table td {\n    padding: 1px 0.8rem;\n    text-align: center;\n  }\n\n  .weapons-table td:nth-child(2),\n  .weapons-table th:nth-child(2) {\n    padding-left: 0 !important;\n  }\n\n  .weapons-table tr:not(:first-child) {\n    border-top: 1px dotted #9e9fa1;\n  }\n\n  .data-cell {\n    padding: 2px 0.8rem !important;\n  }\n\n  .noBorderTop td {\n    border-top: none;\n  }\n\n  .emptyRow {\n    height: 22.5px;\n  }\n\n  .avoid-page-break {\n    position: relative;\n    page-break-inside: avoid;\n    -moz-column-break-inside: avoid;\n    break-inside: avoid;\n  }\n\n  .page-break:not(.print-display-none) {\n    page-break-after: page;\n    -moz-column-break-after: page;\n    break-after: page;\n  }\n\n  @media print {\n    .print-display-none,\n    .print-display-none * {\n      display: none !important;\n    }\n\n    #root {\n      min-width: 1000px;\n    }\n\n    .body {\n      padding: 0;\n      display: block;\n      max-width: none;\n    }\n  }\n\n  @media screen and (max-width: 800px) {\n    :root {\n      font-size: 11px;\n      --size-20: 8px;\n      --size-24: 12px;\n      --size-32: 16px;\n    }\n  }\n\n  @media screen and (max-width: 640px) {\n    :root {\n      font-size: 9px;\n      line-height: 1.3;\n      --size-20: 8px;\n      --size-24: 12px;\n      --size-32: 16px;\n    }\n\n    .body {\n      padding-left: 0;\n      padding-right: 0;\n    }