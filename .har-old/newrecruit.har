n zu Ihrer Miniaturensammlung hinzugef\u00FCgt!\u0022,ja:\u0022\u3053\u306E\u30E6\u30CB\u30C3\u30C8\u306E\u30E2\u30C7\u30EB\u304C\u30DF\u30CB\u30C1\u30E5\u30A2\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u306B\u8FFD\u52A0\u3055\u308C\u307E\u3057\u305F\uFF01\u0022,pl:\u0022Modele tej jednostki zosta\u0142y dodane do Twoich kolekcji miniatur!\u0022,pt:\u0022Os modelos desta unidade foram adicionados \u00E0s suas cole\u00E7\u00F5es de miniaturas!\u0022,hr:\u0022Modeli dodani u minijature\u0022,cz:\u0022Models for this unit have been added to your miniature collections!\u0022,sk:\u0022Models for this unit have been added to your miniature collections!\u0022,gr:\u0022\u03A4\u03B1 \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03B1 \u03C0\u03C1\u03BF\u03C3\u03C4\u03AD\u03B8\u03B7\u03BA\u03B1\u03BD \u03C3\u03C4\u03B9\u03C2 \u03BC\u03B9\u03BD\u03B9\u03B1\u03C4\u03BF\u03CD\u03C1\u03B5\u03C2\u0022,ru:\u0022\u041C\u043E\u0434\u0435\u043B\u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B \u0432 \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u044B\u0022,ko:\u0022Models for this unit have been added to your miniature collections!\u0022},RFe={en:\u0022Favourite Name\u0022,fr:\u0022Nom du Favori\u0022,es:\u0022Nombre del Favorito\u0022,cn:\u0022\u6536\u85CF\u540D\u79F0\u0022,it:\u0022Nome Preferito\u0022,de:\u0022Favoriten-Name\u0022,ja:\u0022\u304A\u6C17\u306B\u5165\u308A\u540D\u0022,pl:\u0022Nazwa Ulubionego\u0022,pt:\u0022Nome do Favorito\u0022,hr:\u0022Naziv favorita\u0022,cz:\u0022Favourite Name\u0022,sk:\u0022Favourite Name\u0022,gr:\u0022\u038C\u03BD\u03BF\u03BC\u03B1 \u03B1\u03B3\u03B1\u03C0\u03B7\u03BC\u03AD\u03BD\u03BF\u03C5\u0022,ru:\u0022\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E\u0022,ko:\u0022Favourite Name\u0022},MFe={en:\u0022Add List to Miniatures\u0022,fr:\u0022Ajouter la Liste aux Figurines\u0022,es:\u0022A\u00F1adir Lista a Miniaturas\u0022,cn:\u0022\u6DFB\u52A0\u5217\u8868\u5230\u6A21\u578B\u0022,it