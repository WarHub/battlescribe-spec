211,\u0022hr\u0022:12212,\u0022cz\u0022:12204,\u0022sk\u0022:12204,\u0022gr\u0022:12213,\u0022ru\u0022:12214,\u0022ko\u0022:12204},\u0022Double Elimination Bracket\u0022,\u0022Bracket \u00E0 double \u00E9limination\u0022,\u0022Bracket de doble eliminaci\u00F3n\u0022,\u0022\u53CC\u8D25\u6DD8\u6C70\u5236\u0022,\u0022Tabellone a Doppia Eliminazione\u0022,\u0022Doppelausscheidung-Bracket\u0022,\u0022Drabinka Podw\u00F3jnej Eliminacji\u0022,\u0022Chave de Dupla Elimina\u00E7\u00E3o\u0022,\u0022Ljestvica Dvostruke Eliminacije\u0022,\u0022Bracket \u03B4\u03B9\u03C0\u03BB\u03AE\u03C2 \u03B1\u03C0\u03BF\u03BA\u03BB\u03B5\u03B9\u03C3\u03BC\u03BF\u03CD\u0022,\u0022\u0421\u0435\u0442\u043A\u0430 \u0441 \u0434\u0432\u043E\u0439\u043D\u044B\u043C \u0432\u044B\u0431\u044B\u0432\u0430\u043D\u0438\u0435\u043C\u0022,{\u0022en\u0022:12216,\u0022fr\u0022:12217,\u0022es\u0022:12218,\u0022cn\u0022:12219,\u0022it\u0022:12220,\u0022de\u0022:12221,\u0022ja\u0022:12222,\u0022pl\u0022:12223,\u0022pt\u0022:12224,\u0022hr\u0022:12225,\u0022cz\u0022:12216,\u0022sk\u0022:12216,\u0022gr\u0022:12226,\u0022ru\u0022:12227,\u0022ko\u0022:12216},\u0022Generate Bracket\u0022,\u0022G\u00E9n\u00E9rer le bracket\u0022,\u0022Generar bracket\u0022,\u0022\u751F\u6210\u5BF9\u9635\u8868\u0022,\u0022Genera Tabellone\u0022,\u0022Bracket generieren\u0022,\u0022\u751F\u6210\u30D6\u30E9\u30B1\u30C3\u30C8\u0022,\u0022Generuj Drabink\u0119\u0022,\u0022Gerar Chave\u0022,\u0022Generiraj Ljestvicu\u0022,\u0022\u0394\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1 bracket\u0022,\u0022\u0421\u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u0435\u0442\u043A\u0443\u0022,{\u0022en\u0022:12229,\u0022fr\u0022:12230,\u0022es\u0022:12231,\u0022cn\u0022:12232,\u0022it\u0022:12233,\u0022de\u0022:12234,\u0022ja\u0022:12235,\u0022pl\u0022:12236,\u0022pt\u0022:12237,\u0022hr\u0022:12238,\u0022cz\u0022:12229,\u0022sk\u0022:12229,\u0022gr\u0022:12239,\u0022ru\u0022:12240,\u0022ko\u0022:12229},\u0022P