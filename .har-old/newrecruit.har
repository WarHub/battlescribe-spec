ogadores DEVEM inserir seu ID do Discord ao se inscrever)\u0022,hr:\u0022Obavezno Discord korisni\u010Dko ime (igra\u010Di MORAJU unijeti svoj Discord ID pri prijavi)\u0022,cz:\u0022Enforce Discord username (players MUST enter their Discord ID when they sign up)\u0022,sk:\u0022Enforce Discord username (players MUST enter their Discord ID when they sign up)\u0022,gr:\u0022\u03A5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03CC Discord\u0022,ru:\u0022\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C Discord ID\u0022,ko:\u0022Enforce Discord username (players MUST enter their Discord ID when they sign up)\u0022},due={en:\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022,fr:\u0022Forcer les noms r\u00E9els (les joueurs DOIVENT entrer leur nom r\u00E9el \u00E0 l\u0027inscription\u0022,es:\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022,cn:\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022,it:\u0022Richiedi nomi reali (i giocatori DEVONO inserire il loro nome reale quando si iscrivono)\u0022,de:\u0022Echte Namen erzwingen (Spieler M\u00DCSSEN ihren echten Namen bei der Anmeldung eingeben)\u0022,ja:\u0022\u672C\u540D\u3092\u5FC5\u9808\u306B\u3059\u308B\uFF08\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u30B5\u30A4\u30F3\u30A2\u30C3\u30D7\u6642\u306B\u672C\u540D\u3092\u5165\u529B\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\uFF09\u0022,pl:\u0022Enforce prawdziwy names (players MUST enter their prawdziwy nazwa kiedy oni znak up)\u0022,pt:\u0022Exigir nomes reais (jogadores DEVEM inserir seu nome real ao se inscrever)\u0022,hr:\u0022Obavezna prava imena (igra\u010Di MORAJU unijeti svoje pravo ime pri prijavi)\u0022,cz:\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022,sk:\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022,gr:\u0022\u03A5\u03C0\u03BF\u03C7\u03C1\u03B5\u03C9\u03C4\u03B9\u03BA\u03CC \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0438\u043C\u044F (\u0438\u0433\u0440\u043E\u043A\u0438 \u0414\u041E\u041B\u0416\u041D\u042B \u0432\u0432\u0435\u0441\u0442\u0438 \u0441\u0432\u043E\u0451 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0438\u043C\u044F \u043F\u0440\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438)\u0022,ko:\u0022Enforce real names (players MUST enter their real name when they sign up)\u0022},fue={en:\u0022Hide results of incomplete rounds\u0022,fr:\u0022Masquer les r\u00E9sultats des rondes incompl\u00E8tes\u0022,es:\u0022Hide results of incomplete rounds\u0022,cn:\u0022Hide results of incomplete rounds\u0022,it:\u0022Nascondi risultati dei turni incompleti\u0022,de:\u0022Ergebnisse unvollst\u00E4ndiger Runden ausblenden\u0022,ja:\u0022\u672A\u5B8C\u4E86\u30E9\u30A6\u30F3\u30C9\u306E\u7D50\u679C\u3092\u975E\u8868\u793A\u0022,pl:\u0022Hide results of incomplete rounds\u0022,pt:\u0022Ocultar resultados de rodadas incompletas\u0022,hr:\u0022Sakrij rezultate nezavr\u0161enih rundi\u0022,cz:\u0022Hide results of incomplete rounds\u0022,sk:\u0022Hide results of incomplete rounds\u0022,gr:\u0022\u0391\u03C0\u03CC\u03BA\u03C1\u03C5\u03C8\u03B7 \u03B7\u03BC\u03B9\u03C4\u03B5\u03BB\u03CE\u03BD \u03B1\u03C0\u03BF\u03C4\u03B5\u03BB\u03B5\u03C3\u03BC\u03AC\u03C4\u03C9\u03BD \u03B3\u03CD\u03C1\u03BF\u03C5\u0022,ru:\u0022\u0421\u043A\u0440\u044B\u0442\u044C \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B of \u041D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E \u0420\u0430\u0443\u043D\u0434\u044B\u0022,ko:\u0022results of incomplete rounds \uC228\uAE30\uAE30\u0022},pue={en:\u0022Tournament is full\u0022,fr:\u0022Le tournoi est plein\u0022,es:\u0022Tournament is full\u0022,cn:\u0022Tournament is full\u0022,it:\u0022Il torneo \u00E8 completo\u0022,de:\u0022Turnier ist voll\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306F\u6E80\u54E1\u3067\u3059\u0022,pl:\u0022Turniej is pe\u0142ne\u0022,pt:\u0022Torneio est\u00E1 cheio\u0022,hr:\u0022Turnir je popunjen\u0022,cz:\u0022Tournament is full\u0022,sk:\u0022Tournament is full\u0022,gr:\u0022\u03A4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C0\u03BB\u03AE\u03C1\u03B5\u03C2\u0022,ru:\u0022\u0422\u0443\u0440\u043D\u0438\u0440 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0022,ko:\u0022Tournament is full\u0022},hue={en:\u0022Subscription is confirmed\u0022,fr:\u0022L\u0027inscription est confirm\u00E9e\u0022,es:\u0022Subscription is confirmed\u0022,cn:\u0022Subscription is confirmed\u0022,it:\u0022L\u0027iscrizione \u00E8 confermata\u0022,de:\u0022Anmeldung ist best\u00E4tigt\u0022,ja:\u0022\u767B\u9332\u304C\u78BA\u8A8D\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022Subskrypcja is potwierdzone\u0022,pt:\u0022Inscri\u00E7\u00E3o est\u00E1 confirmada\u0022,hr:\u0022Pretplata je potvr\u0111ena\u0022,cz:\u0022Subscription is confirmed\u0022,sk:\u0022Subscription is confirmed\u0022,gr:\u0022\u0397 \u03B5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AE \u03C3\u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03C0\u03B9\u03B2\u03B5\u03B2\u03B1\u03B9\u03CE\u03B8\u03B7\u03BA\u03B5\u0022,ru:\u0022\u041F\u043E\u0434\u043F\u0438\u0441\u043A\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430\u0022,ko:\u0022Subscription is confirmed\u0022},mue={en:\u0022Payment has been received\u0022,fr:\u0022Le paiement a \u00E9t\u00E9 re\u00E7u\u0022,es:\u0022Payment has been received\u0022,cn:\u0022Payment has been received\u0022,it:\u0022Il pagamento \u00E8 stato ricevuto\u0022,de:\u0022Zahlung wurde erhalten\u0022,ja:\u0022\u652F\u6255\u3044\u304C\u53D7\u9818\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022P\u0142atno\u015B\u0107 has been otrzymane\u0022,pt:\u0022Pagamento foi recebido\u0022,hr:\u0022Pla\u0107anje je primljeno\u0022,cz:\u0022Payment has been received\u0022,sk:\u0022Payment has been received\u0022,gr:\u0022\u0397 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE \u03C4\u03BF\u03C5 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03B5\u03BB\u03AE\u03C6\u03B8\u03B7\u0022,ru:\u0022\u041E\u043F\u043B\u0430\u0442\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430\u0022,ko:\u0022Payment has been received\u0022},gue={en:\u0022Player or Team has one or more invalid lists\u0022,fr:\u0022Le Joueur ou l\u0027Equipe a au moins une liste invalide\u0022,es:\u0022Player or Team has one or more invalid lists\u0022,cn:\u0022Player or Team has one or more invalid lists\u0022,it:\u0022Il giocatore o la squadra ha una o pi\u00F9 liste non valide\u0022,de:\u0022Spieler oder Mannschaft hat eine oder mehrere ung\u00FCltige Listen\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u307E\u305F\u306F\u30C1\u30FC\u30E0\u306B\u7121\u52B9\u306A\u30EA\u30B9\u30C8\u304C\u3042\u308A\u307E\u3059\u0022,pl:\u0022Gracz or Dru\u017Cyna has jeden or bardziej nieprawid\u0142owy listy\u0022,pt:\u0022Jogador ou Equipe tem uma ou mais listas inv\u00E1lidas\u0022,hr:\u0022Igra\u010D ili tim ima jedan ili vi\u0161e neva\u017Ee\u0107ih popisa\u0022,cz:\u0022Player or Team has one or more invalid lists\u0022,sk:\u0022Player or Team has one or more invalid lists\u0022,gr:\u0022\u039C\u03B7 \u03AD\u03B3\u03BA\u03C5\u03C1\u03B5\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B5\u03C2 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC\u0022,ru:\u0022\u0423 \u0438\u0433\u0440\u043E\u043A\u0430 \u0438\u043B\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0435\u0441\u0442\u044C \u043E\u0434\u0438\u043D \u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u043F\u0438\u0441\u043A\u043E\u0432\u0022,ko:\u0022Player or Team has one or more invalid lists