hr:\u0022Filtriraj po imenu...\u0022,cz:\u0022Filter by name...\u0022,sk:\u0022Filter by name...\u0022,gr:\u0022\u03A6\u03B9\u03BB\u03C4\u03C1\u03AC\u03C1\u03B9\u03C3\u03BC\u03B1 \u03BC\u03B5 \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u0424\u0438\u043B\u044C\u0442\u0440 by \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435...\u0022,ko:\u0022Filter by name...\u0022},R_e={en:\u0022Date\u0022,fr:\u0022Date\u0022,es:\u0022Fecha\u0022,cn:\u0022\u65E5\u671F\u0022,it:\u0022Data\u0022,de:\u0022Datum\u0022,ja:\u0022\u65E5\u4ED8\u0022,pl:\u0022Data\u0022,pt:\u0022Data\u0022,hr:\u0022Datum\u0022,cz:\u0022Date\u0022,sk:\u0022D\u00E1tum\u0022,gr:\u0022\u0397\u03BC\u03B5\u03C1\u03BF\u03BC\u03B7\u03BD\u03AF\u03B1\u0022,ru:\u0022\u0414\u0430\u0442\u0430\u0022,ko:\u0022\uB0A0\uC9DC\u0022},M_e={en:\u0022Load more\u0022,fr:\u0022Charger plus\u0022,es:\u0022Cargar m\u00E1s\u0022,cn:\u0022\u52A0\u8F7D\u66F4\u591A\u0022,it:\u0022Carica more\u0022,de:\u0022Mehr laden\u0022,ja:\u0022\u8AAD\u307F\u8FBC\u307Fmore\u0022,pl:\u0022Wczytaj bardziej\u0022,pt:\u0022Load more\u0022,hr:\u0022U\u010Ditaj Vi\u0161e\u0022,cz:\u0022Load more\u0022,sk:\u0022Load more\u0022,gr:\u0022\u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03C9\u03BD\u0022,ru:\u0022\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0411\u043E\u043B\u044C\u0448\u0435\u0022,ko:\u0022Load more\u0022},U_e={en:\u0022Team\u0022,fr:\u0022\u00C9quipe\u0022,es:\u0022Equipo\u0022,cn:\u0022\u56E2\u961F\u0022,it:\u0022Team\u0022,de:\u0022Team\u0022,ja:\u0022\u30C1\u30FC\u30E0\u0022,pl:\u0022Dru\u017Cyna\u0022,pt:\u0022Equipe\u0022,hr:\u0022Tim\u0022,cz:\u0022Team\u0022,sk:\u0022Team\u0022,gr:\u0022\u039F\u03BC\u03AC\u03B4\u03B1\u0022,ru:\u0022\u041A\u043E\u043C\u0430\u043D\u0434\u0430\u0022,ko:\u0022Team\u0022},x_e={en:\u0022Discord\u0022,fr:\u0022Discord\u0022,es:\u0022Discord\u0022,cn:\u0022Discord\u0022,it:\u0022Discord\u0022,de:\u0022Discord\u0022,ja:\u0022Discord\u0022,pl:\u0022Discord\u0022,pt:\u0022Discord\u0022,hr:\u0022Discord\u0022,cz:\u0022Discord\u0022,sk:\u0022Discord\u0022,gr:\u0022Discord\u0022,ru:\u0022Discord\u0022,ko:\u0022Discord\u0022},Q_e={en:\u0022Alt name\u0022,fr:\u0022Nom alternatif\u0022,es:\u0022Nombre alternativo\u0022,cn:\u0022\u522B\u540D\u0022,it:\u0022Alt name\u0022,de:\u0022Alternativer Name\u0022,ja:\u0022Alt\u540D\u524D\u0022,pl:\u0022Alt name\u0022,pt:\u0022Alt name\u0022,hr:\u0022Alt Ime\u0022,cz:\u0022Alt name\u0022,sk:\u0022Alt name\u0022,gr:\u0022\u0395\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022Alt \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Alt name\u0022},L_e={en:\u0022Claim Player\u0022,fr:\u0022Revendiquer le joueur\u0022,es:\u0022Reclamar jugador\u0022,cn:\u0022\u8BA4\u9886\u73A9\u5BB6\u0022,it:\u0022Claim Player\u0022,de:\u0022Spieler beanspruchen\u0022,ja:\u0022Claim\u30D7\u30EC\u30A4\u30E4\u30FC\u0022,pl:\u0022Claim Gracz\u0022,pt:\u0022Claim Jogador\u0022,hr:\u0022Zatra\u017Ei Igra\u010Da\u0022,cz:\u0022Claim Player\u0022,sk:\u0022Claim Player\u0022,gr:\u0022\u0394\u03B9\u03B5\u03BA\u03B4\u03AF\u03BA\u03B7\u03C3\u03B7 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u0022,ru:\u0022\u0417\u0430\u044F\u0432\u0438\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u0430\u0022,ko:\u0022Claim Player\u0022},D_e={en:\u0022This player is not attached to a New Recruit account. If this is you, you can click the Claim Player button to attach your New Recruit account to this tournament player. This means game results from this player will now count for your ELO rating and you will see the matches in your Match History. ELO ratings are updated every 24 hours.\u0022,fr:\u0022Ce joueur n\u0027est pas attach\u00E9 \u00E0 un compte New Recruit. Si c\u0027est vous, vous pouvez cliquer sur le bouton Revendiquer le joueur pour attacher votre compte New Recruit \u00E0 ce joueur de tournoi. Cela signifie que les r\u00E9sultats de jeu de ce joueur compteront maintenant pour votre classement ELO et vous verrez les matchs dans votre Historique des matchs. Les classements ELO sont mis \u00E0 jour toutes les 24 heures.\u0022,es:\u0022Este jugador no est\u00E1 vinculado a una cuenta de New Recruit. Si eres t\u00FA, puedes hacer clic en el bot\u00F3n Reclamar Jugador para vincular tu cuenta de New Recruit a este jugador del torneo. Esto significa que los resultados de juego de este jugador ahora contar\u00E1n para tu calificaci\u00F3n ELO y ver\u00E1s los partidos en tu Historial de Partidos. Las calificaciones ELO se actualizan cada 24 horas.\u0022,cn:\u0022\u8BE5\u73A9\u5BB6\u672A\u5173\u8054New Recruit\u8D26\u6237\u3002\u5982\u679C\u8FD9\u662F\u60A8\uFF0C\u60A8\u53EF\u4EE5\u70B9\u51FB\u8BA4\u9886\u73A9\u5BB6\u6309\u94AE\u5C06\u60A8\u7684New Recruit\u8D26\u6237\u4E0E\u6B64\u9526\u6807\u8D5B\u73A9\u5BB6\u5173\u8054\u3002\u8FD9\u610F\u5473\u7740\u8BE5\u73A9\u5BB6\u7684\u6E38\u620F\u7ED3\u679C\u73B0\u5728\u5C06\u8BA1\u5165\u60A8\u7684ELO\u8BC4\u7EA7\uFF0C\u60A8\u5C06\u5728\u6BD4\u8D5B\u5386\u53F2\u4E2D\u770B\u5230\u8FD9\u4E9B\u6BD4\u8D5B\u3002ELO\u8BC4\u7EA7\u6BCF24\u5C0F\u65F6\u66F4\u65B0\u4E00\u6B21\u3002\u0022,it:\u0022This player is not attached to a Nuovo Recruit account. If this is you, you can click the Claim Giocatore button to attach your Nuovo Recruit account to this tournament player. This means game results from this player will now count for your ELO rating and you will see the matches in your Partita History. ELO ratings are updated every 24 hours.\u0022,de:\u0022Dieser Spieler ist nicht mit einem New Recruit-Konto verkn\u00FCpft. Wenn das Sie sind, k\u00F6nnen Sie auf die Schaltfl\u00E4che Spieler beanspruchen klicken, um Ihr New Recruit-Konto mit diesem Turnierspieler zu verkn\u00FCpfen. Dies bedeutet, dass Spielergebnisse von diesem Spieler nun f\u00FCr Ihre ELO-Bewertung z\u00E4hlen und Sie die Spiele in Ihrem Match-Verlauf sehen. ELO-Bewertungen werden alle 24 Stunden aktualisiert.\u0022,ja:\u0022\u3053\u306E \u30D7\u30EC\u30A4\u30E4\u30FC is \u3044\u3044\u3048t \u6DFB\u4ED8ed  a \u65B0\u898F Recruit \u30A2\u30AB\u30A6\u30F3\u30C8. \u3082\u3057 \u3053\u306E is you, you \u3067\u304D\u308B \u30AF\u30EA\u30C3\u30AF  Claim \u30D7\u30EC\u30A4\u30E4\u30FC \u30DC\u30BF\u30F3  \u6DFB\u4ED8 \u3042\u306A\u305F\u306E \u65B0\u898F Recruit \u30A2\u30AB\u30A6\u30F3\u30C8  \u3053\u306E \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8 \u30D7\u30EC\u30A4\u30E4\u30FC. \u3053\u306E means \u30B2\u30FC\u30E0 \u7D50\u679C \u304B\u3089 \u3053\u306E \u30D7\u30EC\u30A4\u30E4\u30FC \u3057\u307E\u3059 \u3044\u3044\u3048w \u30AB\u30A6\u30F3\u30C8 \u306E\u305F\u3081\u306E \u3042\u306A\u305F\u306E ELO \u8A55\u4FA1 \u304A\u3088\u3073 you \u3057\u307E\u3059 see  \u30DE\u30C3\u30C1 \u3067 \u3042\u306A\u305F\u306E \u4E00\u81F4 \u5C65\u6B74. ELO \u8A55\u4FA1s are \u66F4\u65B0d every 24 hours.\u0022,pl:\u0022To gracz is nie do\u0142\u0105czone do a Nowe Recruit konto. If to is ty, ty can kliknij the Claim Gracz przycisk do do\u0142\u0105cz your Nowe Recruit konto do to turniej gracz. To \u015Brodek gra wyniki od to gracz will now licznik for your ELO ocena and ty will see the mecze in your Dopasuj History. ELO ratings are updated every 24 hours.\u0022,pt:\u0022This player is not attached para um N\u00E3ovo Recruit account. If this is you, you can click o Claim Jogador button para attach your N\u00E3ovo Recruit account para this tournament player. This means game results de this player will now count para your ELO rating e you will see o matches em your Parteida History. ELO ratings are updated every 24 hours.\u0022,hr:\u0022Ovaj igra\u010D nije povezan s New Recruit ra\u010Dunom. Ako ste to vi, mo\u017Eete kliknuti gumb Zatra\u017Ei Igra\u010Da kako biste povezali svoj New Recruit ra\u010Dun s ovim igra\u010Dem turnira. To zna\u010Di da \u0107e rezultati igara ovog igra\u010Da sada ra\u010Dunati za va\u0161 ELO rejting i vidjet \u0107ete me\u010Deve u svojoj Povijesti Me\u010Deva. ELO rejtinzi se a\u017Euriraju svakih 24 sata.\u0022,cz:\u0022This player is not attached to a New Recruit account. If this is you, you can click the Claim Player button to attach your New Recruit account to this tournament player. This means game results from this player will now count for your ELO rating and you will see the matches in your Match History. ELO ratings are updated every 24 hours.\u0022,sk:\u0022This player is not attached to a New Recruit account. If this is you, you can click the Claim Player button to attach your New Recruit account to this tournament player. This means game results from this player will now count for your ELO rating and you will see the matches in your Match History. ELO ratings are updated every 24 hours.\u0022,gr:\u0022\u0394\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03AE\u03C3\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC\u03BD \u03C4\u03BF\u03BD \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7 \u03C9\u03C2 \u03B4\u03B9\u03BA\u03CC \u03C3\u03B1\u03C2 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u0022,ru:\u0022\u0421\u0432\u044F\u0437\u0430\u0442\u044C \u044D\u0442\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430 \u0441 \u0432\u0430\u0448\u0435\u0439 \u0443\u0447\u0435\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u044C\u044E\u0022,ko:\u0022This player is not attached to a New Recruit account. If this is you, you can click the Claim Player button to attach your New Recruit account to this tournament player. This means game results from this player will now count for your ELO rating and you will see the matches in your Match History. ELO ratings are updated every 24 hours.\u0022},O_e={en:\u0022Are you sure you want to Claim this player?\u0022,fr:\u0022\u00CAtes-vous s\u00FBr de vouloir revendiquer ce joueur ?\u0022,es:\u0022\u00BFEst\u00E1s seguro de que quieres reclamar este jugador?\u0022,cn:\u0022\u60A8\u786E\u5B9A\u8981\u8BA4\u9886\u8FD9\u4E2A\u73A9\u5BB6\u5417\uFF1F\u0022,it:\u0022Are you sure you want to Claim this player?\u0022,de:\u0022Sind Sie sicher, dass Sie diesen Spieler beanspruchen m\u00F6chten?\u0022,ja:\u0022Are you \u78BA\u304B\u306A you \u3057\u305F\u3044  Claim \u3053\u306E \u30D7\u30EC\u30A4\u30E4\u30FC?\u0022,pl:\u0022Are ty pewne ty chcie\u0107 do Claim to gracz?\u0022,pt:\u0022Are you sure you want para Claim this player?\u0022,hr:\u0022Jeste li sigurni da \u017Eelite zatra\u017Eiti ovog igra\u010Da?\u0022,cz:\u0022Are you sure you want to Claim this player?\u0022,sk:\u0022Are you sure you want to Claim this player?\u0022,gr:\u0022\u0395\u03AF\u03C3\u03C4\u03B5 \u03B2\u03AD\u03B2\u03B1\u03B9\u03BF\u03B9 \u03CC\u03C4\u03B9 \u03B8\u03AD\u03BB\u03B5\u03C4\u03B5 \u03BD\u03B1 \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03AE\u03C3\u03B5\u03C4\u03B5 \u03B1\u03C5\u03C4\u03CC\u03BD \u03C4\u03BF\u03BD \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7;\u0022,ru:\u0022\u0417\u0430\u044F\u0432\u0438\u0442\u044C \u044D\u0442\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430?\u0022,ko:\u0022Are you sure you want to Claim this player?\u0022},H_e={en:\u0022Participant {name} has been claimed!\u0022,fr:\u0022Le participant {name} a \u00E9t\u00E9 revendiqu\u00E9 !\u0022,es:\u0022\u00A1El participante {name} ha sido reclamado!\u0022,cn:\u0022\u53C2\u4E0E\u8005{name}\u5DF2\u88AB\u8BA4\u9886\uFF01\u0022,it:\u0022Participant {name} has been claimed!\u0022,de:\u0022Teilnehmer {name} wurde beansprucht!\u0022,ja:\u0022Participant {\u540D\u524D} has been claimed!\u0022,pl:\u0022Participant {name} has been claimed!\u0022,pt:\u0022Parteicipant {name} has been claimed!\u0022,hr:\u0022Sudionik {name} je zatra\u017Een!\u0022,cz:\u0022Participant {name} has been claimed!\u0022,sk:\u0022Participant {name} has been claimed!\u0022,gr:\u0022\u039F \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03AD\u03C7\u03C9\u03BD \u03B4\u03B9\u03B5\u03BA\u03B4\u03B9\u03BA\u03AE\u03B8\u03B7\u03BA\u03B5\u0022,ru:\u0022\u0423\u0447\u0430\u0441\u0442\u043D\u0438\u043A \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0022,ko:\u0022Participant {name} has been claimed!\u0022},G_e={en:\u0022anonymous\u0022,fr:\u0022anonyme\u0022,es:\u0022an\u00F3nimo\u0022,cn:\u0022\u533F\u540D\u0022,it:\u0022anonymous\u0022,de:\u0022anonym\u0022,ja:\u0022anonymous\u0022,pl:\u0022anonymous\u0022,pt:\u0022anonymous\u0022,ru:\u0022\u0430\u043D\u043E\u043D\u0438\u043C\u043D\u044B\u0439\u0022},V_e={en:\u0022Non playing team member (NPC)\u0022,fr:\u0022Membre d\u0027\u00E9quipe non joueur (NPC)\u0022,es:\u0022Miembro del equipo que no juega (NPC)\u0022,cn:\u0022\u975E\u6E38\u620F\u961F\u5458 (NPC)\u0022,it:\u0022Non playing team member (NPC)\u0022,de:\u0022Nicht spielendes Teammitglied (NPC)\u0022,ja:\u0022Non playing team member (NPC)\u0022,pl:\u0022Non playing dru\u017Cyna member (NPC)\u0022,pt:\u0022N\u00E3on playing team member (NPC)\u0022,hr:\u0022\u010Clan tima koji ne igra (NPC)\u0022,cz:\u0022Non playing team member (NPC)\u0022,sk:\u0022Non playing team member (NPC)\u0022,gr:\u0022\u039C\u03B7 \u03C0\u03B1\u03AF\u03B6\u03BF\u03BD \u03BC\u03AD\u03BB\u03BF\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2\u0022,ru:\u0022\u041D\u0435\u0438\u0433\u0440\u0430\u044E\u0449\u0438\u0439 \u0447\u043B\u0435\u043D \u043A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,ko:\u0022Non playing team member (NPC)\u0022},W_e={en:\u0022Attach NR Account\u0022,fr:\u0022Attacher un compte NR\u0022,es:\u0022Vincular cuenta NR\u0022,cn:\u0022\u5173\u8054NR\u8D26\u6237\u0022,it:\u0022Attach NR Account\u0022,de:\u0022NR-Konto verkn\u00FCpfen\u0022,ja:\u0022\u6DFB\u4ED8NR\u30A2\u30AB\u30A6\u30F3\u30C8\u0022,pl:\u0022Attach NR Account\u0022,pt:\u0022Attach NR Conta\u0022,hr:\u0022Pove\u017Ei NR Ra\u010Dun\u0022,cz:\u0022Attach NR Account\u0022,sk:\u0022Attach NR Account\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD NR\u0022,ru:\u0022\u041F\u0440\u0438\u0432\u044F\u0437\u0430\u0442\u044C \u0443\u0447\u0435\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C NR\u0022,ko:\u0022Attach NR Account\u0022},Y_e={en:\u0022Search Account...\u0022,fr:\u0022Rechercher un compte...\u0022,es:\u0022Buscar cuenta...\u0022,cn:\u0022\u641C\u7D22\u8D26\u6237...\u0022,it:\u0022Cerca Account...\u0022,de:\u0022Konto suchen...\u0022,ja:\u0022\u691C\u7D22\u30A2\u30AB\u30A6\u30F3\u30C8...\u0022,pl:\u0022Search Account...\u0022,pt:\u0022Buscar Conta...\u0022,hr:\u0022Pretra\u017Ei Ra\u010Dun...\u0022,cz:\u0022Search Account...\u0022,sk:\u0022Search Account...\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B6\u03AE\u03C4\u03B7\u03C3\u03B7 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03BF\u03CD\u0022,ru:\u0022\u041F\u043E\u0438\u0441\u043A \u0410\u043A\u043A\u0430\u0443\u043D\u0442...\u0022,ko:\u0022Search Account...\u0022},K_e={en:\u0022Attach to {login}\u0022,fr:\u0022Attacher \u00E0 {login}\u0022,es:\u0022Vincular a {login}\u0022,cn:\u0022\u5173\u8054\u5230{login}\u0022,it:\u0022Attach to {login}\u0022,de:\u0022An {login} anh\u00E4ngen\u0022,ja:\u0022\u6DFB\u4ED8  {\u30ED\u30B0\u30A4\u30F3}\u0022,pl:\u0022Attach to {login}\u0022,pt:\u0022Attach para {login}\u0022,hr:\u0022Pove\u017Ei s {login}\u0022,cz:\u0022Attach to {login}\u0022,sk:\u0022Attach to {login}\u0022,gr:\u0022\u03A3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7 \u03BC\u03B5\u0022,ru:\u0022\u041F\u0440\u0438\u0432\u044F\u0437\u0430\u0442\u044C \u043A\u0022,ko:\u0022Attach to {login}\u0022},q_e={en:\u0022Email address saved!\u0022,fr:\u0022Adresse email sauvegard\u00E9e !\u0022,es:\u0022\u00A1Direcci\u00F3n de email guardada!\u0022,cn:\u0022\u7535\u5B50\u90AE\u4EF6\u5730\u5740\u5DF2\u4FDD\u5B58\uFF01\u0022,it:\u0022Email address saved!\u0022,de:\u0022E-Mail-Adresse gespeichert!\u0022,ja:\u0022\u30E1\u30FC\u30EB address \u4FDD\u5B58\u6E08\u307F!\u0022,pl:\u0022Email address saved!\u0022,pt:\u0022Email address saved!\u0022,hr:\u0022Email adresa spremljena!\u0022,cz:\u0022Email address saved!\u0022,sk:\u0022Email address saved!\u0022,gr:\u0022\u0397 \u03B4\u03B9\u03B5\u03CD\u03B8\u03C5\u03BD\u03C3\u03B7 email \u03B1\u03C0\u03BF\u03B8