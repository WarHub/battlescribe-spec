dden!==!0};this.notifyListeners(\u0022appStateChange\u0022,e),document.hidden?this.notifyListeners(\u0022pause\u0022,null):this.notifyListeners(\u0022resume\u0022,null)},document.addEventListener(\u0022visibilitychange\u0022,this.handleVisibilityChange,!1)}exitApp(){throw this.unimplemented(\u0022Not implemented on web.\u0022)}async getInfo(){throw this.unimplemented(\u0022Not implemented on web.\u0022)}async getLaunchUrl(){return{url:\u0022\u0022}}async getState(){return{isActive:document.hidden!==!0}}async minimizeApp(){throw this.unimplemented(\u0022Not implemented on web.\u0022)}async toggleBackButtonHandler(){throw this.unimplemented(\u0022Not implemented on web.\u0022)}}export{s as AppWeb};\n"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":0.725}},{"startedDateTime":"2026-03-16T05:20:15.659Z","time":9.524,"request":{"method":"POST","url":"https://www.newrecruit.eu/api/rpc","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"www.newrecruit.eu"},{"name":":method","value":"POST"},{"name":":path","value":"/api/rpc"},{"name":":scheme","value":"https"},{"name":"accept","value":"application/json, text/plain, */*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"authorization","value":"undefined"},{"name":"content-length","value":"36"},{"name":"content-type","value":"application/json"},{"name":"nrtab-key","value":"69b7930f459702301ffea433"},{"name":"origin","value":"https://www.newrecruit.eu"},{"name":"priority","value":"u=1, i"},{"name":"referer","value":"https://www.newrecruit.eu/"},{"name":"sec-ch-ua","value":"\u0022Not:A-Brand\u0022;v=\u002299\u0022, \u0022HeadlessChrome\u0022;v=\u0022145\u0022, \u0022Chromium\u0022;v=\u0022145\u0022"},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\u0022Linux\u0022"},{"name":"sec-fetch-dest","value":"empty"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/145.0.7632.6 Safari/537.36"}],"queryString":[],"headersSize":-1,"bodySize":-1,"postData":{"mimeType":"application/json","text":"{\u0022method\u0022:\u0022get_library\u0022,\u0022params\u0022:[]}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-credentials","value":"true"},{"name":"access-control-allow-headers","value":"Origin, X-Requested-With, Content-Type, Accept, Authorization, authorization, x-xsrf-token, nrtab-key, sw-cache-strategy"},{"name":"access-control-allow-origin","value":"https://www.newrecruit.eu"},{"name":"cache-control","value":"no-cache, no-store, must-revalidate"},{"name":"content-encoding","value":"gzip"},{"name":"content-type","value":"text/html"},{"name":"date","value":"Mon, 16 Mar 2026 05:20:15 GMT"},{"name":"server","value":"nginx/1.24.0 (Ubuntu)"},{"name":"vary","value":"Accept-Encoding"}],"content":{"size":-1,"mimeType":"text/html","text":"[{\u0022_id\u0022:\u002261c85ab848856954294b6e85\u0022,\u0022id\u0022:6,\u0022name\u0022:\u0022The Ninth Age\u0022,\u0022version\u0022:\u00222022\u0022,\u0022short\u0022:\u0022t9a\u0022,\u0022app_version\u0022:\u00221\u0022,\u0022default_install\u0022:1,\u0022id_rules_def\u0022:101,\u0022id_unit_stats\u0022:100,\u0022id_spells\u0022:103,\u0022setup_categories\u0022:{\u0022map\u0022:{\u0022id\u0022:\u0022map\u0022,\u0022name\u0022:\u0022Map\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:1,\u0022items\u0022:[{\u0022id\u0022:1,\u0022name\u0022:\u0022Custom Map\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022map\u0022},{\u0022ord\u0022:2,\u0022id\u0022:18,\u0022name\u0022:\u0022Map A1\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Shrouded Pool\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EI will dream of this pool until my dying days. We spilled the blood of three peoples to reach it, and though my steps left bloody footprints, no taint of gor touched its waters.\u003C/p\u003E\u003Cp\u003EIn every mirror I see my reflection in its surface, and the faces of the foes who sought to keep me from it. The Lady was with me that day, and ever since.\u003C/p\u003E\u003Cp\u003EBaron Siclebald of Keldonne\u003C/p\u003E\u0022},{\u0022ord\u0022:3,\u0022id\u0022:19,\u0022name\u0022:\u0022Map A2\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Foothill Outpost\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EThese soft borderlanders knew of our approach when their fields burned and their herds scattered before us.\u003C/p\u003E\u003Cp\u003EThey even mounted a pitiful resistance, loosing arrows from roofs and thickets. Yet we poured from hill and forest and fell upon their hamlet.\u003C/p\u003E\u003Cp\u003ESo we took all that they had, and more than they could spare. None will stand between me and my glory - or my Lord\u2019s.\u003C/p\u003E\u003Cp\u003ETolomeo \u201CShieldcleaver\u201D - Chosen Warrior of Sugulag\u003C/p\u003E\u0022},{\u0022ord\u0022:4,\u0022id\u0022:20,\u0022name\u0022:\u0022Map A3\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Dilapidated Manor\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EWe who know the true power behind the world must often work insecret.\u003C/p\u003E\u003Cp\u003EWith only a little persuasion, the former occupants were kind enough to allow this master of mysticism to set up home.\u003C/p\u003E\u003Cp\u003ENow the estate is inhabited by friends ofmine, and our occasional... guests.\u003C/p\u003E\u003Cp\u003EFortunately, their arrival goes unnoticed in this grand place. Once the Courtesan arrives, the city will have such havoc visited upon it, they shall be gifted glorious visions of a new world.\u003C/p\u003E\u003Cp\u003EBalthazar the Magnificent, servant of the Seven\u003C/p\u003E\u0022},{\u0022ord\u0022:5,\u0022id\u0022:21,\u0022name\u0022:\u0022Map A4\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Volcanic Lake\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EIn the mountains of the Blasted Plains, water is avaluable resource. Even the water to be found in avolcanic caldera can beput to good use.\u003C/p\u003E\u003Cp\u003ENow these interlopers would seek to infringe upon lands we hold by divine right?\u003C/p\u003E\u003Cp\u003EBy force of arms they will learn their error. By steel and discipline they will be driven from this  place. By fire will our retribution be delivered to them.\u003C/p\u003E\u003Cp\u003EProphet Tevika of the Gar\u003Cbr\u003EShakhub Citadel\u003C/p\u003E\u0022},{\u0022ord\u0022:6,\u0022id\u0022:22,\u0022name\u0022:\u0022Map A5\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Misty Marshes\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EYou do not see us, but we see you - uninitiated. You tramp the highlands and bring waste and decay - despoilers.\u003C/p\u003E\u003Cp\u003EWe lie in wait, beneath the surface, and still your eyes fail you - hotbloods.\u003C/p\u003E\u003Cp\u003EWe will strike from bush,from swamp, from grass, silent death comes - prey.\u003C/p\u003E\u003Cp\u003EWe mourn your passing, yet your graves will give new life from decay - renewers.\u003C/p\u003E\u003Cp\u003ESkink Captain Akeakami\u003C/p\u003E\u0022},{\u0022ord\u0022:7,\u0022id\u0022:23,\u0022name\u0022:\u0022Map A6\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ancient Walls\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOnce our walls stood highand proud over the city of Khedesai. Centuries of wind and sand have created breaches that no battering ram ever did.\u003C/p\u003E\u003Cp\u003EYou saw our unmanned walls and thought our history was yours for the taking. Our legacy there to be plundered.\u003C/p\u003E\u003Cp\u003EWe rose from our eternal rest. Took up weapons that survived the ages. Set ourselves to defend our home. And drove the living from our hallowed ground.\u003C/p\u003E\u003Cp\u003EDeath Hierarch Nehi\u003C/p\u003E\u0022},{\u0022ord\u0022:8,\u0022id\u0022:24,\u0022name\u0022:\u0022Map A7\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Beacon Hill\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EAbove all, our people survive on their discipline.\u003C/p\u003E\u003Cp\u003ESome will speak of guns and artillery. They have not seen damp powder or misfires. Some will speak of arms and armour.\u003C/p\u003E\u003Cp\u003EThey have not seen swords break. Some will talk of faith. I honour Sunna, but she will not defend us - we must fight in her name.\u003C/p\u003E\u003Cp\u003EDiscipline  holds us together, binds us to our cause. The Beacons are a symbol of our commitment, and we will defend them!\u003C/p\u003E\u003Cp\u003EMarshall Hugo Hafer\u003C/p\u003E\u0022},{\u0022ord\u0022:9,\u0022id\u0022:25,\u0022name\u0022:\u0022Map A8\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Witch\u2019s Cottage\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EIn the truly wild places, few make their home. As we travel the DarkWoods, we know all the denizens beneath the black boughs.\u003C/p\u003E\u003Cp\u003EThrough the  tangled thickets and dire beasts, the Witch\u2019s story is known to all our people in this land. From her cabin, the Witch sees all, and we respect her wisdom and her trade in herbs - and ales.\u003C/p\u003E\u003Cp\u003ENow interlopers walk beneath the canopy, among her gardens, and we will drive them backonce more. That her story may continue, and that we may tell it anew.\u003C/p\u003E\u003Cp\u003ESoothsayer Bremen\u003C/p\u003E\u0022},{\u0022ord\u0022:10,\u0022id\u0022:26,\u0022name\u0022:\u0022Map B1\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Mage\u2019s Sanctum\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EMany who are talented in the Art choose to reside in our great institutions. Asfada and Canrac offer unparalleled opportunities for magical study. Yet many choose tobuild their own towers in isolation, preferring seclusion while hoarding secrets.\u003C/p\u003E\u003Cp\u003EThe home of Mage Ilthuryn is one such location. An imposing holdfast of white stone, set in a hollow with a still pool of silvery water.\u003C/p\u003E\u003Cp\u003ENow that home is under attack from invaders, and we are mustered to defend the Master Mage. Let nothing stand in our way. For Celeda Ablan!\u003C/p\u003E\u003Cp\u003EWarden of the Flame\u003Cbr\u003ECivessin Eilynore\u003C/p\u003E\u0022},{\u0022ord\u0022:11,\u0022id\u0022:27,\u0022name\u0022:\u0022Map B2\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Villa Grounds\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EThe nobles of Dathen take great pride in their majestic estates, displays of their position and standing.\u003C/p\u003E\u003Cp\u003EThe villa of Prince Folmon Perxina is no exception. He commands one of the grandest manors to be found, with extensive grounds spreading out across the landscape.\u003C/p\u003E\u003Cp\u003EIt is known that beasts trained in the Menagerie roam the holdings, tasked with savaging any who would dare to transgress.\u003C/p\u003E\u003Cp\u003EThe Prince\u2019s personal guard represents a veritable army, and this is the force you now  find yourself in service to. Serve well, and you may secure advancement.\u003C/p\u003E\u003Cp\u003EDread Sergeant\u003Cbr\u003ETrabhr\u00E6n Crislain\u003C/p\u003E\u0022},{\u0022ord\u0022:12,\u0022id\u0022:28,\u0022name\u0022:\u0022Map B3\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ancient Fortress\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EAmong the peaks and valleys of the White Mountains, there are many remnants of bastions which once marked frontiers of our Holds.\u003C/p\u003E\u003Cp\u003EThe  crumbling walls and slopes of Dun Kenaz are one such example. This was once a thriving stronghold, home to a hundred of our kin and a stopping point for those who traversed this mountain pass.\u003C/p\u003E\u003Cp\u003EI dream that one day thefort will be restored, that the walls can be repaired and the flooded courtyard drained and relaid.\u003C/p\u003E\u003Cp\u003EFor now though, I pledge to ensure no others desecrate the memories of those who died and were buried beneath this place.\u003C/p\u003E\u003Cp\u003EThane Bodraz\u003Cbr\u003EBronzespine\u003C/p\u003E\u0022},{\u0022ord\u0022:13,\u0022id\u0022:29,\u0022name\u0022:\u0022Map B4\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Frontier Farm\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOn the border of the Steppe and Tsuandan, the locals know they owe tribute to the Great Khan. Food grown along the border will feed our tribe through the harsh winter.\u003C/p\u003E\u003Cp\u003EWhere there is value,there are thieves. Now they set upon our people,and we must drive the wolves back. Longjing\u2019s people often press along our border, but when they threaten our sustenance, they will taste our wrath.\u003C/p\u003E\u003Cp\u003ECall in the tribe, ready the cannons, and prepare the beasts.\u003C/p\u003E\u003Cp\u003EKhan Jetei\u003C/p\u003E\u0022},{\u0022ord\u0022:14,\u0022id\u0022:30,\u0022name\u0022:\u0022Map B5\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Ravaged Watchtower\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003E In times long past, our reach extended across most of the known world. The Awakening set us as the inheritors of Avras, and all its glory. \u003C/p\u003E \u003Cp\u003E When we were forced to abandon our birthright, our people found havens in many places beneath the notice of those who thought us dispatched. \u003C/p\u003E \u003Cp\u003E This watchtower once stood on the fringes of our territory, in what was the Regio Equitatem. The horselords who rule these lands now see a mere husk of a structure, with no clue of the strength positioned within. These seeds lie in many places, and wait our moment to rise again. \u003C/p\u003E \u003Cp\u003E Senator Mettius Sigilis \u003C/p\u003E\u0022},{\u0022ord\u0022:15,\u0022id\u0022:31,\u0022name\u0022:\u0022Map B6\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Creeping Forest\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EOurs is the tree, the thicket, the forest. Ours is the wilderness, the sylvan lands, the liminal places. \u003C/p\u003E \u003Cp\u003E Yours are the villages, the towns, the cities. The foolhardy attempt to have nature follow lines and squares. \u003C/p\u003E \u003Cp\u003E We see you from our home. For so long as you keep a distance we tolerate. But transgress once too often, and you may find the forest draws near. Nothing built by mortals cannot be undone by nature and time. \u003C/p\u003E \u003Cp\u003E Druid Narycot \u003C/p\u003E\u0022},{\u0022ord\u0022:16,\u0022id\u0022:32,\u0022name\u0022:\u0022Map B7\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Eerie Graveyard\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003E Rest in peace. A quaint notion. To lay the body to rest, to bury all the infinite possibilities in the ground, for worms and maggots to feast. \u003C/p\u003E \u003Cp\u003E You fear my kind. Our knowledge scares you, as does our strength and will to use it. Here, in this quiet hamlet, I have everything I need to build an army. \u003C/p\u003E \u003Cp\u003E The souls of your dead, will provide my soldiers. Your cattle will fall and my zombies will rise. \u003C/p\u003E \u003Cp\u003E And buried somewhere in the nearby hills, I have heard tell of a dragon\u2019s fallen form. Soon, I will be among the great powers, all beginning from a small town graveyard. Rest in peace? You may try\u2026 \u003C/p\u003E \u003Cp\u003E Zakutnik the Necromancer \u003C/p\u003E\u0022},{\u0022ord\u0022:17,\u0022id\u0022:33,\u0022name\u0022:\u0022Map B8\u0022,\u0022id_system_category\u0022:\u0022map\u0022,\u0022fluffname\u0022:\u0022Shattered Bridge\u0022,\u0022fluff\u0022:\u0022\u003Cp\u003EWe cross the bridge, we take the town, we win the game, we take the loot, we keep moving. \u003C/p\u003E \u003Cp\u003E Now peaceborn want to stop us. Break their own bridge. Think Warborn can\u2019t swim? Think goblins not make bridges? We can\u2019t build boats? \u003C/p\u003E \u003Cp\u003E Extra challenge for all this time. Maybe some are returned to the Sleep, and we wait to see them again. \u003C/p\u003E \u003Cp\u003E But we are not easy stopped. We will break walls, show strength, win with cunning. We are born of war, and this will be best war yet! \u003C/p\u003E \u003Cp\u003E Warboss Urbul \u003C/p\u003E\u0022}]},\u0022deployment\u0022:{\u0022id\u0022:\u0022deployment\u0022,\u0022name\u0022:\u0022Deployment Type\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:2,\u0022items\u0022:[{\u0022id\u0022:18,\u0022name\u0022:\u0022Frontline Clash\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:19,\u0022name\u0022:\u0022Dawn Assault\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:20,\u0022name\u0022:\u0022Counterthrust\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:21,\u0022name\u0022:\u0022Encircle\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:22,\u0022name\u0022:\u0022Refused Flank\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:23,\u0022name\u0022:\u0022Marching Columns\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022deployment\u0022},{\u0022id\u0022:24,\u0022name\u0022:\u0022Custom Deployment\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022deployment\u0022}]},\u0022objective\u0022:{\u0022id\u0022:\u0022objective\u0022,\u0022name\u0022:\u0022Secondary Objective\u0022,\u0022id_game_system\u0022:4,\u0022ord\u0022:3,\u0022items\u0022:[{\u0022id\u0022:25,\u0022name\u0022:\u0022Hold the Ground\u0022,\u0022ord\u0022:1,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:26,\u0022name\u0022:\u0022Breakthrough\u0022,\u0022ord\u0022:2,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:27,\u0022name\u0022:\u0022Spoils of War\u0022,\u0022ord\u0022:3,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:28,\u0022name\u0022:\u0022King of the Hill\u0022,\u0022ord\u0022:4,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:29,\u0022name\u0022:\u0022Capture the Flags\u0022,\u0022ord\u0022:5,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:30,\u0022name\u0022:\u0022Secure Target\u0022,\u0022ord\u0022:6,\u0022id_system_category\u0022:\u0022objective\u0022},{\u0022id\u0022:31,\u0022name\u0022:\u0022Custom Objective\u0022,\u0022ord\u0022:0,\u0022id_system_category\u0022:\u0022objective\u0022}]}},\u0022books\u0022:[{\u0022_id\u0022:\u002267aeeeb2507c48521a40f302\u0022,\u0022id\u0022:1,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022\u00C5sklanders\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:318,\u0022filename\u0022:\u0022al.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Barbares d\u0027\u00C5skland\u0022,\u0022cn\u0022:\u0022\u963F\u65AF\u5361\u0022},\u0022short\u0022:\u0022al\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222025-02-14T07:20:18.054Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dcf1\u0022,\u0022id\u0022:2,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Beast Herds\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:371,\u0022filename\u0022:\u0022bh.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Hardes Bestiales\u0022,\u0022cn\u0022:\u0022\u91CE\u517D\u4EBA\u0022},\u0022short\u0022:\u0022bh\u0022,\u0022version\u0022:\u00223rd ed\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u002267aeeeb3507c48521a40f32d\u0022,\u0022id\u0022:24,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Cult of Errahman\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:12,\u0022filename\u0022:\u0022er.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Culte d\u0027Errahman\u0022,\u0022cn\u0022:\u0022Cult of Errahman\u0022},\u0022short\u0022:\u0022er\u0022,\u0022version\u0022:\u00222ed_2023_alpha1\u0022,\u0022last_updated\u0022:\u00222025-02-14T07:20:18.054Z\u0022},{\u0022_id\u0022:\u002268d501670c7e31a7f6c0c8b0\u0022,\u0022id\u0022:19,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Cultists\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:318,\u0022filename\u0022:\u0022cl.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Cultistes\u0022,\u0022cn\u0022:\u0022\u90AA\u6559\u5F92\u0022},\u0022short\u0022:\u0022cl\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222025-09-25T08:46:31.526Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dcee\u0022,\u0022id\u0022:5,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Daemon Legions\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:395,\u0022filename\u0022:\u0022dl.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022L\u00E9gions D\u00E9moniaques\u0022,\u0022cn\u0022:\u0022\u6076\u9B54\u519B\u56E2\u0022},\u0022short\u0022:\u0022dl\u0022,\u0022version\u0022:\u00222024 beta1\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dce7\u0022,\u0022id\u0022:3,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Dread Elves\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:391,\u0022filename\u0022:\u0022de.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Elfes Noirs\u0022,\u0022cn\u0022:\u0022\u6050\u6016\u7CBE\u7075\u0022},\u0022short\u0022:\u0022de\u0022,\u0022version\u0022:\u00222024 beta1\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u00226858f28f1fb102ea2206daed\u0022,\u0022id\u0022:25,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Dread Fleet\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:12,\u0022filename\u0022:\u0022df.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Dread Fleet\u0022,\u0022cn\u0022:\u0022Dread Fleet\u0022},\u0022short\u0022:\u0022df\u0022,\u0022version\u0022:\u0022alpha1\u0022,\u0022last_updated\u0022:\u00222025-06-23T06:22:06.978Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dcec\u0022,\u0022id\u0022:4,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Dwarven Holds\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:362,\u0022filename\u0022:\u0022dh.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Forteresses Naines\u0022,\u0022cn\u0022:\u0022\u8981\u585E\u77EE\u4EBA\u0022},\u0022short\u0022:\u0022dh\u0022,\u0022version\u0022:\u00222024 beta1\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dced\u0022,\u0022id\u0022:6,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Empire of Sonnstahl\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:374,\u0022filename\u0022:\u0022eos.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Empire de Sonnstahl\u0022,\u0022cn\u0022:\u0022\u94C1\u708E\u5E1D\u56FD\u0022},\u0022short\u0022:\u0022eos\u0022,\u0022version\u0022:\u00222024 beta1\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dce6\u0022,\u0022id\u0022:7,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Highborn Elves\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:386,\u0022filename\u0022:\u0022he.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Hautes Lign\u00E9es Elfiques\u0022,\u0022cn\u0022:\u0022\u9AD8\u7B49\u7CBE\u7075\u0022},\u0022short\u0022:\u0022he\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u002267aeeeb4507c48521a40f335\u0022,\u0022id\u0022:20,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Hobgoblins\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:344,\u0022filename\u0022:\u0022hg.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Hobgoblins\u0022,\u0022cn\u0022:\u0022\u5927\u5730\u7CBE\u0022},\u0022short\u0022:\u0022hg\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222025-02-14T07:20:18.054Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dcf0\u0022,\u0022id\u0022:8,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Infernal Dwarves\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:398,\u0022filename\u0022:\u0022id.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Nains Infernaux\u0022,\u0022cn\u0022:\u0022\u70BC\u72F1\u77EE\u4EBA\u0022},\u0022short\u0022:\u0022id\u0022,\u0022version\u0022:\u00222023 beta2\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dce8\u0022,\u0022id\u0022:9,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Kingdom of Equitaine\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:499,\u0022filename\u0022:\u0022koe.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Royaume d\u0027Equitaine\u0022,\u0022cn\u0022:\u0022\u57C3\u594E\u5766\u9A91\u58EB\u56FD\u0022},\u0022short\u0022:\u0022koe\u0022,\u0022version\u0022:\u00222023 beta4\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u002267aeeeb4507c48521a40f349\u0022,\u0022id\u0022:22,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Legions of Sin\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:71,\u0022filename\u0022:\u0022ls.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Legions of Sin\u0022,\u0022cn\u0022:\u0022Legions of Sin\u0022},\u0022short\u0022:\u0022ls\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222025-02-14T07:20:18.054Z\u0022},{\u0022_id\u0022:\u00226858f28f1fb102ea2206db07\u0022,\u0022id\u0022:10,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Makhar\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:313,\u0022filename\u0022:\u0022mh.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Cavaliers Makhar\u0022,\u0022cn\u0022:\u0022\u5308\u5974\u0022},\u0022short\u0022:\u0022mh\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222025-06-23T06:22:06.978Z\u0022},{\u0022_id\u0022:\u002267aeeeb4507c48521a40f358\u0022,\u0022id\u0022:23,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Nippon\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:21,\u0022filename\u0022:\u0022np.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Nippon\u0022,\u0022cn\u0022:\u0022Nippon\u0022},\u0022short\u0022:\u0022np\u0022,\u0022version\u0022:\u00222023\u0022,\u0022last_updated\u0022:\u00222025-02-14T07:20:18.054Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dceb\u0022,\u0022id\u0022:11,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Ogre Khans\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:375,\u0022filename\u0022:\u0022ok.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Khans Ogres\u0022,\u0022cn\u0022:\u0022\u98DF\u4EBA\u9B54\u53EF\u6C57\u0022},\u0022short\u0022:\u0022ok\u0022,\u0022version\u0022:\u00222023 beta2\u0022,\u0022last_updated\u0022:\u00222026-02-25T10:12:14.776Z\u0022},{\u0022_id\u0022:\u002269b44524fe7e33b5d30fec6d\u0022,\u0022id\u0022:12,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Orcs and Goblins\u0022,\u0022playable\u0022:1,\u0022nrversion\u0022:465,\u0022filename\u0022:\u0022ong.json\u0022,\u0022translation\u0022:{\u0022fr\u0022:\u0022Orcs et Gobelins\u0022,\u0022cn\u0022:\u0022\u517D\u4EBA\u4E0E\u5730\u7CBE\u0022},\u0022short\u0022:\u0022ong\u0022,\u0022version\u0022:\u00222023 alpha4\u0022,\u0022last_updated\u0022:\u00222026-03-13T17:11:00.597Z\u0022},{\u0022_id\u0022:\u0022699ecafe382ecf6d9193dcea\u0022,\u0022id\u0022:101,\u0022id_game_system\u0022:6,\u0022name\u0022:\u0022Rule Definitions\u0022,\u0022playable\u0022:0,\u0022nrversion\u0022:426,\u0022fil