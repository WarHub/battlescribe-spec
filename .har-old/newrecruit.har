st4} expires {expiry}\u0022,fr:\u0022Carte finissant par {last4} expire {expiry}\u0022,es:\u0022Tarjeta terminada en {last4} expira {expiry}\u0022,cn:\u0022\u5361\u53F7\u672B\u5C3E{last4}\u5230\u671F{expiry}\u0022,it:\u0022Carta che termina con {last4} scade {expiry}\u0022,de:\u0022Karte endend auf {last4} l\u00E4uft ab am {expiry}\u0022,ja:\u0022Card ending {last4} expires {expiry}\u0022,pl:\u0022Karta ko\u0144cz\u0105ca si\u0119 na {last4} wygasa {expiry}\u0022,pt:\u0022Cart\u00E3o terminando em {last4} expira em {expiry}\u0022,hr:\u0022Kartica koja zavr\u0161ava s\u0022,cz:\u0022Card ending {last4} expires {expiry}\u0022,sk:\u0022Card ending {last4} expires {expiry}\u0022,gr:\u0022\u039A\u03AC\u03C1\u03C4\u03B1 \u03C0\u03BF\u03C5 \u03BB\u03AE\u03B3\u03B5\u03B9 \u03C3\u03C4\u03BF {last4} \u03BB\u03AE\u03B3\u03B5\u03B9 {expiry}\u0022,ru:\u0022\u041A\u0430\u0440\u0442\u0430, \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0449\u0430\u044F\u0441\u044F \u043D\u0430\u0022,ko:\u0022Card ending {last4} expires {expiry}\u0022},pwe={en:\u0022IBAN {code} ending {last4}\u0022,fr:\u0022IBAN {code} finissant par {last4}\u0022,es:\u0022IBAN {code} terminando en {last4}\u0022,cn:\u0022IBAN {code} \u672B\u5C3E{last4}\u0022,it:\u0022IBAN {code} che termina con {last4}\u0022,de:\u0022IBAN {code} endend auf {last4}\u0022,ja:\u0022IBAN {code} ending {last4}\u0022,pl:\u0022IBAN {code} ko\u0144cz\u0105cy si\u0119 na {last4}\u0022,pt:\u0022IBAN {code} terminando em {last4}\u0022,hr:\u0022IBAN koji zavr\u0161ava s\u0022,cz:\u0022IBAN {code} ending {last4}\u0022,sk:\u0022IBAN {code} ending {last4}\u0022,gr:\u0022IBAN {code} \u03C0\u03BF\u03C5 \u03BB\u03AE\u03B3\u03B5\u03B9 \u03C3\u03C4\u03BF {last4}\u0022,ru:\u0022IBAN, \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u043D\u0430\u0022,ko:\u0022IBAN {code} ending {last4}\u0022},hwe={en:\u0022Transaction ID: {id}\u0022,fr:\u0022ID de transaction : {id}\u0022,es:\u0022ID de transacci\u00F3n: {id}\u0022,cn:\u0022\u4EA4\u6613ID\uFF1A{id}\u0022,it:\u0022ID transazione: {id}\u0022,de:\u0022Transaktions-ID: {id}\u0022,ja:\u0022\u30C8\u30E9\u30F3\u30B6\u30AF\u30B7\u30E7\u30F3 ID: {id}\u0022,pl:\u0022ID transakcji: {id}\u0022,pt:\u0022ID da Transa\u00E7\u00E3o: {id}\u0022,hr:\u0022ID transakcije Google Play\u0022,cz:\u0022Transaction ID: {id}\u0022,sk:\u0022Transaction ID: {id}\u0022,gr:\u0022\u0391\u03BD\u03B1\u03B3\u03BD\u03C9\u03C1\u03B9\u03C3\u03C4\u03B9\u03BA\u03CC \u03A3\u03C5\u03BD\u03B1\u03BB\u03BB\u03B1\u03B3\u03AE\u03C2: {id}\u0022,ru:\u0022ID \u0442\u0440\u0430\u043D\u0437\u0430\u043A\u0446\u0438\u0438 Google Play\u0022,ko:\u0022Transaction ID: {id}\u0022},mwe={en:\u0022Loading...\u0022,fr:\u0022Chargement...\u0022,es:\u0022Cargando...\u0022,cn:\u0022\u52A0\u8F7D\u4E2D...\u0022,it:\u0022Caricamento...\u0022,de:\u0022Laden...\u0022,ja:\u0022\u8AAD\u307F\u8FBC\u307F\u4E2D...\u0022,pl:\u0022\u0141adowanie...\u0022,pt:\u0022Carregando...\u0022,hr:\u0022U\u010Ditavanje Stripe...\u0022,cz:\u0022Loading...\u0022,sk:\u0022Na\u010D\u00EDtava sa...\u0022,gr:\u0022\u03A6\u03CC\u03C1\u03C4\u03C9\u03C3\u03B7...\u0022,ru:\u0022\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430...\u0022,ko:\u0022Loading...\u0022},gwe={en:\u0022Stripe Account\u0022,fr:\u0022Compte Stripe\u0022,es:\u0022Cuenta Stripe\u0022,cn:\u0022Stripe \u8D26\u6237\u0022,it:\u0022Account Stripe\u0022,de:\u0022Stripe-Konto\u0022,ja:\u0022Stripe\u30A2\u30AB\u30A6\u30F3\u30C8\u0022,pl:\u0022Konto Stripe\u0022,pt:\u0022Conta Stripe\u0022,hr:\u0022Stripe ra\u010Dun\u0022,cz:\u0022Stripe Account\u0022,sk:\u0022Stripe Account\u0022,gr:\u0022\u039B\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u03C2 Stripe\u0022,ru:\u0022\u0423\u0447\u0435\u0442\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C Stripe\u0022,ko:\u0022Stripe Account\u0022},ywe={en:\u0022This page allows you to create a Stripe account to receive payments for tournament fees.\u0022,fr:\u0022Cette page vous permet de cr\u00E9er un compte Stripe pour recevoir des paiements pour les frais de tournoi.\u0022,es:\u0022Esta p\u00E1gina te permite crear una cuenta Stripe para recibir pagos por tasas de torneo.\u0022,cn:\u0022\u6B64\u9875\u9762\u5141\u8BB8\u60A8\u521B\u5EFA Stripe \u8D26\u6237\u4EE5\u63A5\u6536\u6BD4\u8D5B\u8D39\u7528\u4ED8\u6B3E\u3002\u0022,it:\u0022Questa pagina ti permette di creare un account Stripe per ricevere pagamenti per le quote del torneo.\u0022,de:\u0022Auf dieser Seite k\u00F6nnen Sie ein Stripe-Konto erstellen, um Zahlungen f\u00FCr Turniergeb\u00FChren zu erhalten.\u0022,ja:\u0022\u3053\u306E\u30DA\u30FC\u30B8\u3067\u306F\u3001\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u53C2\u52A0\u8CBB\u306E\u652F\u6255\u3044\u3092\u53D7\u3051\u53D6\u308B\u305F\u3081\u306EStripe\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u4F5C\u6210\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Ta strona umo\u017Cliwia utworzenie konta Stripe w celu otrzymywania p\u0142atno\u015Bci za op\u0142aty turniejowe.\u0022,pt:\u0022Esta p\u00E1gina permite que voc\u00EA crie uma conta Stripe para receber pagamentos de taxas de torneio.\u0022,hr:\u0022Upravljajte svojim Stripe ra\u010Dunom\u0022,cz:\u0022This page allows you to create a Stripe account to receive payments for tournament fees.\u0022,sk:\u0022This page allows you to create a Stripe account to receive payments for tournament fees.\u0022,gr:\u0022\u0391\u03C5\u03C4\u03AE \u03B7 \u03C3\u03B5\u03BB\u03AF\u03B4\u03B1 \u03C3\u03B1\u03C2 \u03B5\u03C0\u03B9\u03C4\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03B4\u03B7\u03BC\u03B9\u03BF\u03C5\u03C1\u03B3\u03AE\u03C3\u03B5\u03C4\u03B5 \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC Stripe \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BB\u03B1\u03BC\u03B2\u03AC\u03BD\u03B5\u03C4\u03B5 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03C2 \u03B3\u03B9\u03B1 \u03C4\u03AD\u03BB\u03B7 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC.\u0022,ru:\u0022\u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u0443\u0447\u0435\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C Stripe \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439\u0022,ko:\u0022This page allows you to create a Stripe account to receive payments for tournament fees.\u0022},wwe={en:\u0022The process usually takes 5-10 minutes and requires business information.\u0022,fr:\u0022Le processus prend g\u00E9n\u00E9ralement 5 \u00E0 10 minutes et n\u00E9cessite des informations commerciales.\u0022,es:\u0022El proceso suele tomar 5-10 minutos y requiere informaci\u00F3n comercial.\u0022,cn:\u0022\u8BE5\u8FC7\u7A0B\u901A\u5E38\u9700\u8981 5-10 \u5206\u949F\uFF0C\u9700\u8981\u5546\u4E1A\u4FE1\u606F\u3002\u0022,it:\u0022Il processo richiede solitamente 5-10 minuti e necessita di informazioni aziendali.\u0022,de:\u0022Der Vorgang dauert normalerweise 5-10 Minuten und erfordert Gesch\u00E4ftsinformationen.\u0022,ja:\u0022\u3053\u306E\u51E6\u7406\u306F\u901A\u5E385\u301C10\u5206\u304B\u304B\u308A\u3001\u30D3\u30B8\u30CD\u30B9\u60C5\u5831\u304C\u5FC5\u8981\u3067\u3059\u3002\u0022,pl:\u0022Proces zwykle trwa 5-10 minut i wymaga informacji biznesowych.\u0022,pt:\u0022O processo geralmente leva de 5 a 10 minutos e requer informa\u00E7\u00F5es comerciais.\u0022,hr:\u0022Vrijeme obrade\u0022,cz:\u0022The process usually takes 5-10 minutes and requires business information.\u0022,sk:\u0022The process usually takes 5-10 minutes and requires business information.\u0022,gr:\u0022\u0397 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03C3\u03C5\u03BD\u03AE\u03B8\u03C9\u03C2 \u03B4\u03B9\u03B1\u03C1\u03BA\u03B5\u03AF 5-10 \u03BB\u03B5\u03C0\u03C4\u03AC \u03BA\u03B1\u03B9 \u03B1\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF \u03B5\u03C0\u03B9\u03C7\u03B5\u03B9\u03C1\u03B7\u03BC\u03B1\u03C4\u03B9\u03BA\u03AD\u03C2 \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2.\u0022,ru:\u0022\u041E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0437\u0430\u0439\u043C\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442\u0022,ko:\u0022The process usually takes 5-10 minutes and requires business information.\u0022},bwe={en:\u0022If you need help,\u0022,fr:\u0022Si vous avez besoin d\u0027aide,\u0022,es:\u0022Si necesitas ayuda,\u0022,cn:\u0022\u5982\u679C\u60A8\u9700\u8981\u5E2E\u52A9\uFF0C\u0022,it:\u0022Se hai bisogno di aiuto,\u0022,de:\u0022Wenn Sie Hilfe ben\u00F6tigen,\u0022,ja:\u0022\u30D8\u30EB\u30D7\u304C\u5FC5\u8981\u306A\u5834\u5408\u306F\u3001\u0022,pl:\u0022Je\u015Bli potrzebujesz pomocy,\u0022,pt:\u0022Se voc\u00EA precisar de ajuda,\u0022,hr:\u0022Kontaktirajte podr\u0161ku\u0022,cz:\u0022If you need help,\u0022,sk:\u0022If you need help,\u0022,gr:\u0022\u0395\u03AC\u03BD \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03B5\u03C3\u03C4\u03B5 \u03B2\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1,\u0022,ru:\u0022\u0421\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C \u0441 \u043D\u0430\u043C\u0438, \u0435\u0441\u043B\u0438 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\u0022,ko:\u0022If you need help,\u0022},vwe={en:\u0022and we\u0027ll assist you.\u0022,fr:\u0022et nous vous aiderons.\u0022,es:\u0022y te ayudaremos.\u0022,cn:\u0022\u6211\u4EEC\u5C06\u4E3A\u60A8\u63D0\u4F9B\u5E2E\u52A9\u3002\u0022,it:\u0022e ti assisteremo.\u0022,de:\u0022werden wir Ihnen helfen.\u0022,ja:\u0022\u30B5\u30DD\u30FC\u30C8\u3044\u305F\u3057\u307E\u3059\u3002\u0022,pl:\u0022a my pomo\u017Cemy.\u0022,pt:\u0022e n\u00F3s o ajudaremos.\u0022,hr:\u0022Poruka kontakta\u0022,cz:\u0022and we\u0027ll assist you.\u0022,sk:\u0022and we\u0027ll assist you.\u0022,gr:\u0022\u03BA\u03B1\u03B9 \u03B8\u03B1 \u03C3\u03B1\u03C2 \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03BF\u03C5\u03BC\u03B5.\u0022,ru:\u0022\u0438 \u043C\u044B \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0436\u0435\u043C.\u0022,ko:\u0022and we\u0027ll assist you.\u0022},kwe={en:\u0022Ready\u0022,fr:\u0022Pr\u00EAt\u0022,es:\u0022Listo\u0022,cn:\u0022\u5C31\u7EEA\u0022,it:\u0022Pronto\u0022,de:\u0022Bereit\u0022,ja:\u0022\u6E96\u5099\u5B8C\u4E86\u0022,pl:\u0022Gotowe\u0022,pt:\u0022Pronto\u0022,hr:\u0022Spreman\u0022,cz:\u0022Ready\u0022,sk:\u0022Pripraven\u00E9\u0022,gr:\u0022\u0388\u03C4\u03BF\u03B9\u03BC\u03BF\u0022,ru:\u0022\u0413\u043E\u0442\u043E\u0432\u043E\u0022,ko:\u0022Ready\u0022},Bwe={en:\u0022Congratulations! Your Stripe account is ready to receive payments.\u0022,fr:\u0022F\u00E9licitations ! Votre compte Stripe est pr\u00EAt \u00E0 recevoir des paiements.\u0022,es:\u0022\u00A1Felicidades! Tu cuenta Stripe est\u00E1 lista para recibir pagos.\u0022,cn:\u0022\u606D\u559C\uFF01\u60A8\u7684 Stripe \u8D26\u6237\u5DF2\u51C6\u5907\u597D\u63A5\u6536\u4ED8\u6B3E\u3002\u0022,it:\u0022Congratulazioni! Il tuo account Stripe \u00E8 pronto per ricevere pagamenti.\u0022,de:\u0022Gl\u00FCckwunsch! Ihr Stripe-Konto ist bereit, Zahlungen zu empfangen.\u0022,ja:\u0022\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01Stripe\u30A2\u30AB\u30A6\u30F3\u30C8\u304C\u652F\u6255\u3044\u3092\u53D7\u3051\u53D6\u308C\u308B\u72B6\u614B\u306B\u306A\u308A\u307E\u3057\u305F\u3002\u0022,pl:\u0022Gratulacje! Twoje konto Stripe jest gotowe do przyjmowania p\u0142atno\u015Bci.\u0022,pt:\u0022Parab\u00E9ns! Sua conta Stripe est\u00E1 pronta para receber pagamentos.\u0022,hr:\u0022\u010Cestitamo!\u0022,cz:\u0022Congratulations! Your Stripe account is ready to receive payments.\u0022,sk:\u0022Congratulations! Your Stripe account is ready to receive payments.\u0022,gr:\u0022\u03A3\u03C5\u03B3\u03C7\u03B1\u03C1\u03B7\u03C4\u03AE\u03C1\u03B9\u03B1! \u039F \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u03C2 \u03C3\u03B1\u03C2 \u03C3\u03C4\u03BF Stripe \u03B5\u03AF\u03BD\u03B1\u03B9 \u03AD\u03C4\u03BF\u03B9\u03BC\u03BF\u03C2 \u03BD\u03B1 \u03BB\u03AC\u03B2\u03B5\u03B9 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AD\u03C2.\u0022,ru:\u0022\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u0022,ko:\u0022Congratulations! Your Stripe account is ready to receive payments.\u0022},Cwe={en:\u0022Awaiting verification\u0022,fr:\u0022En attente de v\u00E9rification\u0022,es:\u0022Esperando verificaci\u00F3n\u0022,cn:\u0022\u7B49\u5F85\u9A8C\u8BC1\u0022,it:\u0022In attesa di verifica\u0022,de:\u0022Warten auf Verifizierung\u0022,ja:\u0022\u78BA\u8A8D\u5F85\u3061\u0022,pl:\u0022Oczekiwanie na weryfikacj\u0119\u0022,pt:\u0022Aguardando verifica\u00E7\u00E3o\u0022,hr:\u0022Provjera\u0022,cz:\u0022Awaiting verification\u0022,sk:\u0022Awaiting verification\u0022,gr:\u0022\u0391\u03BD\u03B1\u03BC\u03BF\u03BD\u03AE \u03B5\u03C0\u03B1\u03BB\u03AE\u03B8\u03B5\u03C5\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438\u0022,ko:\u0022Awaiting verification\u0022},_we={en:\u0022Your account is under review by Stripe. This process can take a few days.\u0022,fr:\u0022Votre compte est en cours d\u0027examen par Stripe. Ce processus peut prendre quelques jours.\u0022,es:\u0022Tu cuenta est\u00E1 siendo revisada por Stripe. Este proceso puede tomar unos d\u00EDas.\u0022,cn:\u0022\u60A8\u7684\u8D26\u6237\u6B63\u5728\u63A5\u53D7 Stripe \u5BA1\u6838\u3002\u6B64\u8FC7\u7A0B\u53EF\u80FD\u9700\u8981\u51E0\u5929\u65F6\u95F4\u3002\u0022,it:\u0022Il tuo account \u00E8 in fase di revisione da parte di Stripe. Questo processo pu\u00F2 richiedere alcuni giorni.\u0022,de:\u0022Ihr Konto wird von Stripe \u00FCberpr\u00FCft. Dieser Vorgang kann einige Tage dauern.\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u306FStripe\u306B\u3088\u308B\u5BE9\u67FB\u4E2D\u3067\u3059\u3002\u3053\u306E\u51E6\u7406\u306B\u306F\u6570\u65E5\u304B\u304B\u308B\u5834\u5408\u304C\u3042\u308A\u307E\u3059\u3002\u0022,pl:\u0022Twoje konto jest sprawdzane przez Stripe. Ten proces mo\u017Ce potrwa\u0107 kilka dni.\u0022,pt:\u0022Sua conta est\u00E1 sendo revisada pela Stripe. Este processo pode levar alguns dias.\u0022,hr:\u0022Va\u0161 ra\u010Dun je u provjeri\u0022,cz:\u0022Your account is under review by Stripe. This process can take a few days.\u0022,sk:\u0022Your account is under review by Stripe. This process can take a few days.\u0022,gr:\u0022\u039F \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC\u03C2 \u03C3\u03B1\u03C2 \u03B5\u03BE\u03B5\u03C4\u03AC\u03B6\u03B5\u03C4\u03B1\u03B9 \u03B1\u03C0\u03CC \u03C4\u03BF Stripe. \u0391\u03C5\u03C4\u03AE \u03B7 \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03B1\u03C3\u03AF\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C1\u03BA\u03AD\u03C3\u03B5\u03B9 \u03BC\u03B5\u03C1\u03B9\u03BA\u03AD\u03C2 \u03B7\u03BC\u03AD\u03C1\u03B5\u03C2.\u0022,ru:\u0022\u0412\u0430\u0448\u0430 \u0443\u0447\u0435\u0442\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0441\u044F\u0022,ko:\u0022Your account is under review by Stripe. This process can take a few days.\u0022},Swe={en:\u0022Incomplete\u0022,fr:\u0022Incomplet\u0022,es:\u0022Incompleto\u0022,cn:\u0022\u4E0D\u5B8C\u6574\u0022,it:\u0022Incompleto\u0022,de:\u0022Unvollst\u00E4ndig\u0022,ja:\u0022\u672A\u5B8C\u4E86\u0022,pl:\u0022Niekompletne\u0022,pt:\u0022Incompleto\u0022,hr:\u0022Nepotpun\u0022,cz:\u0022Incomplete\u0022,sk:\u0022Nedokon\u010Den\u00E9\u0022,gr:\u0022\u0397\u03BC\u03B9\u03C4\u03B5\u03BB\u03AD\u03C2\u0022,ru:\u0022\u041D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E\u0022,ko:\u0022Incomplete\u0022},Ewe={en:\u0022Please complete the account setup process.\u0022,fr:\u0022Veuillez compl\u00E9ter le processus de configuration du compte.\u0022,es:\u0022Por favor completa el proceso de configuraci\u00F3n de la cuenta.\u0022,cn:\u0022\u8BF7\u5B8C\u6210\u8D26\u6237\u8BBE\u7F6E\u8FC7\u7A0B\u3002\u0022,it:\u0022LPease complete the account setup process.\u0022,de:\u0022Bitte schlie\u00DFen Sie den Kontoeinrichtungsprozess ab.\u0022,ja:\u0022\u30A2\u30AB\u30A6\u30F3\u30C8\u306E\u30BB\u30C3\u30C8\u30A2\u30C3\u30D7\u5