n peintes\u0022,es:\u0022Mostrar solo no pintadas\u0022,cn:\u0022\u4EC5\u663E\u793A\u672A\u6D82\u88C5\u0022,it:\u0022Mostra Unpainted only\u0022,de:\u0022Anzeigen Unpainted only\u0022,ja:\u0022\u672A\u5857\u88C5\u306E\u307F\u8868\u793A\u0022,pl:\u0022Poka\u017C tylko niema lowane\u0022,pt:\u0022Mostrar apenas N\u00E3o Pintadas\u0022,hr:\u0022Prika\u017Ei samo neobojene\u0022,cz:\u0022Show Unpainted only\u0022,sk:\u0022Show Unpainted only\u0022,gr:\u0022\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03BC\u03CC\u03BD\u03BF \u0386\u03B2\u03B1\u03C6\u03C9\u03BD\u0022,ru:\u0022\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0440\u0430\u0441\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0435\u0022,ko:\u0022Unpainted only \uD45C\uC2DC\u0022},ebe={en:\u0022Show Not Built only\u0022,fr:\u0022Afficher seulement les non assembl\u00E9es\u0022,es:\u0022Mostrar solo no construidas\u0022,cn:\u0022\u4EC5\u663E\u793A\u672A\u7EC4\u88C5\u0022,it:\u0022Mostra Not Built only\u0022,de:\u0022Anzeigen Neint Built only\u0022,ja:\u0022\u672A\u7D44\u7ACB\u306E\u307F\u8868\u793A\u0022,pl:\u0022Poka\u017C tylko niezbudowane\u0022,pt:\u0022Mostrar apenas N\u00E3o Montadas\u0022,hr:\u0022Prika\u017Ei samo nesastavljene\u0022,cz:\u0022Show Not Built only\u0022,sk:\u0022Show Not Built only\u0022,gr:\u0022\u0395\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 \u03BC\u03CC\u03BD\u03BF \u039C\u03B7 \u039A\u03B1\u03C4\u03B1\u03C3\u03BA\u03B5\u03C5\u03B1\u03C3\u03BC\u03AD\u03BD\u03C9\u03BD\u0022,ru:\u0022\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435\u0022,ko:\u0022Not Built only \uD45C\uC2DC\u0022},tbe={en:\u0022Export Miniatures\u0022,fr:\u0022Exporter les figurines\u0022,es:\u0022Exportar miniaturas\u0022,cn:\u0022\u5BFC\u51FA\u6A21\u578B\u0022,it:\u0022Esporta Miniatures\u0022,de:\u0022Exportieren Miniaturs\u0022,ja:\u0022\u30DF\u30CB\u30C1\u3