\u0027Assistant de Jeu :(\u0022,es:\u0022No se puede abrir este juego en el Asistente de Juego :(\u0022,cn:\u0022\u65E0\u6CD5\u5728\u6E38\u620F\u52A9\u624B\u4E2D\u6253\u5F00\u6B64\u6E38\u620F :(\u0022,it:\u0022Impossibile aprire questa partita nell\u0027Assistente di Gioco :(\u0022,de:\u0022Unable to open this game in the Gaming Assistant :(\u0022,ja:\u0022Unable  \u958B\u304F \u3053\u306E \u30B2\u30FC\u30E0 \u3067  Gaming \u30A2\u30B7\u30B9\u30BF\u30F3\u30C8 :(\u0022,pl:\u0022Nie mo\u017Cna otworzy\u0107 tej gry w Asystencie Gry :(\u0022,pt:\u0022N\u00E3o foi poss\u00EDvel abrir o Assistente de Jogo\u0022,hr:\u0022Nije mogu\u0107e otvoriti ovu igru u pomo\u0107niku za igranje :(\u0022,cz:\u0022Unable to open this game in the Gaming Assistant :(\u0022,sk:\u0022Unable to open this game in the Gaming Assistant :(\u0022,gr:\u0022\u0391\u03B4\u03C5\u03BD\u03B1\u03BC\u03AF\u03B1 \u03B1\u03BD\u03BF\u03AF\u03B3\u03BC\u03B1\u03C4\u03BF\u03C2 \u03B1\u03C5\u03C4\u03BF\u03CD \u03C4\u03BF\u03C5 \u03C0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD \u03C3\u03C4\u03BF\u03BD \u0392\u03BF\u03B7\u03B8\u03CC \u03A0\u03B1\u03B9\u03C7\u03BD\u03B9\u03B4\u03B9\u03BF\u03CD :(\u0022,ru:\u0022\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0022,ko:\u0022Unable to open this game in the Gaming Assistant :(\u0022},Uhe={en:\u0022Identification\u0022,fr:\u0022Identification\u0022,es:\u0022Identificaci\u00F3n\u0022,cn:\u0022\u8EAB\u4EFD\u8BC6\u522B\u0022,it:\u0022Identificazione\u0022,de:\u0022Identification\u0022,ja:\u0022\u8B58\u5225\u0022,pl:\u0022Identyfikacja\u0022,pt:\u0022Identifica\u00E7\u00E3o\u0022,hr:\u0022Identifikacija\u0022,cz:\u0022Identification\u0022,sk:\u0022Identification\u0022,gr:\u0022\u03A4\u03B1\u03C5\u03C4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u0022,ru:\u0022\u0418\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F\u0022,ko:\u0022Identification\u0022},xhe={en:\u0022You can modify your name, real name and alt name within the tournament, this will not affect your New Recruit account and changes will only affect this tournament.\u0022,fr:\u0022Vous pouvez modifier votre nom, nom r\u00E9el et pseudonyme dans le tournoi, cela n\u0027affectera pas votre compte New Recruit et les modifications ne s\u0027appliqueront qu\u0027\u00E0 ce tournoi.\u0022,es:\u0022Puedes modificar tu nombre, nombre real y nombre alternativo dentro del torneo, esto no afectar\u00E1 tu cuenta de New Recruit y los cambios solo afectar\u00E1n este torneo.\u0022,cn:\u0022\u60A8\u53EF\u4EE5\u5728\u9526\u6807\u8D5B\u4E2D\u4FEE\u6539\u60A8\u7684\u59D3\u540D\u3001\u771F\u5B9E\u59D3\u540D\u548C\u522B\u540D\uFF0C\u8FD9\u4E0D\u4F1A\u5F71\u54CD\u60A8\u7684New Recruit\u8D26\u6237\uFF0C\u66F4\u6539\u4EC5\u5BF9\u6B64\u9526\u6807\u8D5B\u6709\u6548\u3002\u0022,it:\u0022Puoi modificare il tuo nome, nome reale e nome alternativo all\u0027interno del torneo, questo non influenzer\u00E0 il tuo account New Recruit\u0022,de:\u0022You can modify your name, real name and alt name within the tournament, this will not affect your New Recruit account and changes will only affect this tournament.\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u5185\u3067\u540D\u524D\u3001\u5B9F\u540D\u3001\u4EE3\u66FF\u540D\u3092\u5909\u66F4\u3067\u304D\u307E\u3059\u3002\u3053\u308C\u306FNew Recruit\u30A2\u30AB\u30A6\u30F3\u30C8\u306B\u5F71\u97FF\u305B\u305A\u3001\u5909\u66F4\u306F\u3053\u306E\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8\u306B\u306E\u307F\u9069\u7528\u3055\u308C\u307E\u3059\u3002\u0022,pl:\u0022Mo\u017Cesz zmodyfikowa\u0107 swoje imi\u0119, prawdziwe imi\u0119 i pseudonim w ramach turnieju, nie wp\u0142ynie to na Twoje konto New Recruit, a zmiany b\u0119d\u0105 dotyczy\u0107 tylko tego turnieju.\u0022,pt:\u0022Voc\u00EA pode modificar o nome que aparece nos confrontos e classifica\u00E7\u00F5es abaixo\u0022,hr:\u0022Mo\u017Eete izmijeniti svoje ime, pravo ime i alternativno ime unutar turnira, to ne\u0107e utjecati na va\u0161 New Recruit ra\u010Dun i promjene \u0107e utjecati samo na ovaj turnir.\u0022,cz:\u0022You can modify your name, real name and alt name within the tournament, this will not affect your New Recruit account and changes will only affect this tournament.\u0022,sk:\u0022You can modify your name, real name and alt name within the tournament, this will not affect your New Recruit account and changes will only affect this tournament.\u0022,gr:\u0022\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03C1\u03BF\u03C0\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03C4\u03B5 \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03B1, \u03C4\u03BF \u03C0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1 \u03BA\u03B1\u03B9 \u03C4\u03BF \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03B1\u03C2 \u03B5\u03BD\u03C4\u03CC\u03C2 \u03C4\u03BF\u03C5 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC, \u03B1\u03C5\u03C4\u03CC \u03B4\u03B5\u03BD \u03B8\u03B1 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03C3\u03B5\u03B9 \u03C4\u03BF\u03BD \u03BB\u03BF\u03B3\u03B1\u03C1\u03B9\u03B1\u03C3\u03BC\u03CC \u03C3\u03B1\u03C2 \u03C3\u03C4\u03BF New Recruit \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B1\u03BB\u03BB\u03B1\u03B3\u03AD\u03C2 \u03B8\u03B1 \u03B5\u03C0\u03B7\u03C1\u03B5\u03AC\u03C3\u03BF\u03C5\u03BD \u03BC\u03CC\u03BD\u03BF \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC.\u0022,ru:\u0022\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0432\u0430\u0448\u0435 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0435 \u0438\u043C\u044F\u0022,ko:\u0022You can modify your name, real name and alt name within the tournament, this will not affect your New Recruit account and changes will only affect this tournament.\u0022},Qhe={en:\u0022Alt name\u0022,fr:\u0022Pseudonyme\u0022,es:\u0022Nombre alternativo\u0022,cn:\u0022\u522B\u540D\u0022,it:\u0022Nome alternativo\u0022,de:\u0022Alt name\u0022,ja:\u0022Alt\u540D\u524D\u0022,pl:\u0022Pseudonim\u0022,pt:\u0022Nome Alternativo\u0022,hr:\u0022Alt Ime\u0022,cz:\u0022Alt name\u0022,sk:\u0022Alt name\u0022,gr:\u0022\u0395\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022Alt \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022Alt name\u0022},Lhe={en:\u0022Real name\u0022,fr:\u0022Nom r\u00E9el\u0022,es:\u0022Nombre real\u0022,cn:\u0022\u771F\u5B9E\u59D3\u540D\u0022,it:\u0022Nome reale\u0022,de:\u0022Real name\u0022,ja:\u0022Real\u540D\u524D\u0022,pl:\u0022Prawdziwe imi\u0119\u0022,pt:\u0022Nome Real\u0022,hr:\u0022Pravo ime\u0022,cz:\u0022Real name\u0022,sk:\u0022Real name\u0022,gr:\u0022\u03A0\u03C1\u03B1\u03B3\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u0412\u0430\u0448\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0438\u043C\u044F\u0022,ko:\u0022Real name\u0022},Dhe={en:\u0022Name\u0022,fr:\u0022Nom\u0022,es:\u0022Nombre\u0022,cn:\u0022\u59D3\u540D\u0022,it:\u0022Nome\u0022,de:\u0022Name\u0022,ja:\u0022\u540D\u524D\u0022,pl:\u0022Nazwa\u0022,pt:\u0022Nome\u0022,hr:\u0022Ime\u0022,cz:\u0022Name\u0022,sk:\u0022N\u00E1zov\u0022,gr:\u0022\u038C\u03BD\u03BF\u03BC\u03B1\u0022,ru:\u0022\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0022,ko:\u0022\uC774\uB984\u0022},Ohe={en:\u0022Alt name can be used to indicate your name in Warhall, TTS or any other software.\u0022,fr:\u0022Le pseudonyme peut \u00EAtre utilis\u00E9 pour indiquer votre nom dans Warhall, TTS ou tout autre logiciel.\u0022,es:\u0022El nombre alternativo puede usarse para indicar tu nombre en Warhall, TTS o cualquier otro software.\u0022,cn:\u0022\u522B\u540D\u53EF\u7528\u4E8E\u5728Warhall\u3001TTS\u6216\u5176\u4ED6\u8F6F\u4EF6\u4E2D\u663E\u793A\u60A8\u7684\u540D\u79F0\u3002\u0022,it:\u0022Il nome alternativo pu\u00F2 essere usato per indicare il tuo nome in Warhall, TTS o qualsiasi altro software.\u0022,de:\u0022Alt name can be used to indicate your name in Warhall, TTS or any other software.\u0022,ja:\u0022\u4EE3\u66FF\u540D\u306F\u3001Warhall\u3001TTS\u3001\u305D\u306E\u4ED6\u306E\u30BD\u30D5\u30C8\u30A6\u30A7\u30A2\u3067\u306E\u540D\u524D\u3092\u793A\u3059\u305F\u3081\u306B\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002\u0022,pl:\u0022Pseudonim mo\u017Ce by\u0107 u\u017Cywany do wskazania Twojej nazwy w Warhall, TTS lub innym oprogramowaniu.\u0022,pt:\u0022Seu nome alternativo ser\u00E1 exibido nas listas de confrontos e classifica\u00E7\u00F5es\u0022,hr:\u0022Alternativno ime se mo\u017Ee koristiti za ozna\u010Davanje va\u0161eg imena u Warhall, TTS ili bilo kojem drugom softveru.\u0022,cz:\u0022Alt name can be used to indicate your name in Warhall, TTS or any other software.\u0022,sk:\u0022Alt name can be used to indicate your name in Warhall, TTS or any other software.\u0022,gr:\u0022\u03A4\u03BF \u03B5\u03BD\u03B1\u03BB\u03BB\u03B1\u03BA\u03C4\u03B9\u03BA\u03CC \u03CC\u03BD\u03BF\u03BC\u03B1 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03B7\u03B8\u03B5\u03AF \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C5\u03C0\u03BF\u03B4\u03B5\u03AF\u03BE\u03B5\u03B9 \u03C4\u03BF \u03CC\u03BD\u03BF\u03BC\u03AC \u03C3\u03B1\u03C2 \u03C3\u03B5 Warhall, TTS \u03AE \u03BF\u03C0\u03BF\u03B9\u03BF\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03AC\u03BB\u03BB\u03BF \u03BB\u03BF\u03B3\u03B9\u03C3\u03BC\u03B9\u03BA\u03CC.\u0022,ru:\u0022\u0410\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u043E\u0435 \u0438\u043C\u044F \u0434\u043B\u044F \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F (\u043F\u0441\u0435\u0432\u0434\u043E\u043D\u0438\u043C)\u0022,ko:\u0022Alt name can be used to indicate your name in Warhall, TTS or any other software.\u0022},Hhe={en:\u0022My Team\u0022,fr:\u0022Mon \u00C9quipe\u0022,es:\u0022Mi Equipo\u0022,cn:\u0022\u6211\u7684\u56E2\u961F\u0022,it:\u0022La Mia Squadra\u0022,de:\u0022My Team\u0022,ja:\u0022My\u30C1\u30FC\u30E0\u0022,pl:\u0022Moja Dru\u017Cyna\u0022,pt:\u0022Minha Equipe\u0022,hr:\u0022My Tim\u0022,cz:\u0022My Team\u0022,sk:\u0022My Team\u0022,gr:\u0022My \u039F\u03BC\u03AC\u03B4\u03B1\u0022,ru:\u0022My \u041A\u043E\u043C\u0430\u043D\u0434\u0430\u0022,ko:\u0022My Team\u0022},Ghe={en:\u0022Payment\u0022,fr:\u0022Paiement\u0022,es:\u0022Pago\u0022,cn:\u0022\u4ED8\u6B3E\u0022,it:\u0022Pagamento\u0022,de:\u0022Payment\u0022,ja:\u0022\u652F\u6255\u3044\u0022,pl:\u0022P\u0142atno\u015B\u0107\u0022,pt:\u0022Pagamento\u0022,hr:\u0022Pla\u0107anje\u0022,cz:\u0022Payment\u0022,sk:\u0022Payment\u0022,gr:\u0022\u03A0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE\u0022,ru:\u0022\u041E\u043F\u043B\u0430\u0442\u0430\u0022,ko:\u0022Payment\u0022},Vhe={en:\u0022Up front online payment is required to participate in this tournament. Please proceed to payment to get started.\u0022,fr:\u0022Un paiement en ligne anticip\u00E9 est requis pour participer \u00E0 ce tournoi. Veuillez proc\u00E9der au paiement pour commencer.\u0022,es:\u0022Se requiere un pago en l\u00EDnea por adelantado para participar en este torneo. Por favor proceda al pago para comenzar.\u0022,cn:\u0022\u53C2\u52A0\u6B64\u9526\u6807\u8D5B\u9700\u8981\u63D0\u524D\u5728\u7EBF\u4ED8\u6B3E\u3002\u8BF7\u8FDB\u884C\u4ED8\u6B3E\u4EE5\u5F00\u59CB\u3002\u0022,it:\u0022\u00C8 richiesto il pagamento online anticipato per partecipare a questo torneo. Si prega di procedere al pagamento per confermare\u0022,de:\u0022Up front online payment is required to participate in this tournament. Please proceed to payment to get started.\u0022,ja:\u0022\u4E0A front \u30AA\u30F3\u30E9\u30A4\u30F3 \u652F\u6255\u3044 is required  participate \u3067 \u3053\u306E \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8. \u304A\u9858\u3044\u3057\u307E\u3059 \u7D9A\u884C  \u652F\u6255\u3044  \u53D6\u5F97 \u958B\u59CBed.\u0022,pl:\u0022Wymagana jest p\u0142atno\u015B\u0107 z g\u00F3ry online, aby wzi\u0105\u0107 udzia\u0142 w tym turnieju. Prosz\u0119 przej\u015B\u0107 do p\u0142atno\u015Bci, aby rozpocz\u0105\u0107.\u0022,pt:\u0022Este torneio requer pagamento para confirmar sua inscri\u00E7\u00E3o\u0022,hr:\u0022Unaprijed je potrebno online pla\u0107anje za sudjelovanje u ovom turniru. Molimo nastavite s pla\u0107anjem za po\u010Detak.\u0022,cz:\u0022Up front online payment is required to participate in this tournament. Please proceed to payment to get started.\u0022,sk:\u0022Up front online payment is required to participate in this tournament. Please proceed to payment to get started.\u0022,gr:\u0022\u0391\u03C0\u03B1\u03B9\u03C4\u03B5\u03AF\u03C4\u03B1\u03B9 \u03B5\u03BA \u03C4\u03C9\u03BD \u03C0\u03C1\u03BF\u03C4\u03AD\u03C1\u03C9\u03BD \u03B4\u03B9\u03B1\u03B4\u03B9\u03BA\u03C4\u03C5\u03B1\u03BA\u03AE \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE \u03B3\u03B9\u03B1 \u03C3\u03C5\u03BC\u03BC\u03B5\u03C4\u03BF\u03C7\u03AE \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC. \u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03C4\u03B5 \u03C3\u03C4\u03B7\u03BD \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03C4\u03B5.\u0022,ru:\u0022\u042D\u0442\u043E\u0442 \u0442\u0443\u0440\u043D\u0438\u0440 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u043F\u043B\u0430\u0442\u044B\u0022,ko:\u0022Up front online payment is required to participate in this tournament. Please proceed to payment to get started.\u0022},Whe={en:\u0022For team tournaments, only one player needs to send a payment for the whole team, usually the team Captain but any player can do it.\u0022,fr:\u0022Pour les tournois d\u0027\u00E9quipe, un seul joueur doit envoyer un paiement pour toute l\u0027\u00E9quipe, g\u00E9n\u00E9ralement le capitaine d\u0027\u00E9quipe mais n\u0027importe quel joueur peut le faire.\u0022,es:\u0022Para torneos de equipos, solo un jugador necesita enviar un pago para todo el equipo, generalmente el Capit\u00E1n del equipo pero cualquier jugador puede hacerlo.\u0022,cn:\u0022\u5BF9\u4E8E\u56E2\u961F\u9526\u6807\u8D5B\uFF0C\u53EA\u9700\u4E00\u540D\u7403\u5458\u4E3A\u6574\u4E2A\u56E2\u961F\u4ED8\u6B3E\uFF0C\u901A\u5E38\u662F\u961F\u957F\uFF0C\u4F46\u4EFB\u4F55\u7403\u5458\u90FD\u53EF\u4EE5\u4ED8\u6B3E\u3002\u0022,it:\u0022Per i tornei a squadre, solo un giocatore deve inviare un pagamento per l\u0027intera squadra, solitamente il capitano della squadra\u0022,de:\u0022For team tournaments, only one player needs to send a payment for the whole team, usually the team Captain but any player can do it.\u0022,ja:\u0022\u306E\u305F\u3081\u306E \u30C1\u30FC\u30E0\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8s, \u306E\u307F 1 \u30D7\u30EC\u30A4\u30E4\u30FC needs  s\u7D42\u4E86 a \u652F\u6255\u3044 \u306E\u305F\u3081\u306E  whole \u30C1\u30FC\u30E0, usually  \u30C1\u30FC\u30E0 Captain \u3057\u304B\u3057 any \u30D7\u30EC\u30A4\u30E4\u30FC \u3067\u304D\u308B do it.\u0022,pl:\u0022W turniejach dru\u017Cynowych tylko jeden gracz musi wys\u0142a\u0107 p\u0142atno\u015B\u0107 za ca\u0142\u0105 dru\u017Cyn\u0119, zazwyczaj kapitan dru\u017Cyny, ale ka\u017Cdy gracz mo\u017Ce to zrobi\u0107.\u0022,pt:\u0022Informa\u00E7\u00F5es de pagamento da equipe\u0022,hr:\u0022Za timske turnire, samo jedan igra\u010D treba poslati pla\u0107anje za cijeli tim, obi\u010Dno kapetan tima, ali bilo koji igra\u010D to mo\u017Ee u\u010Diniti.\u0022,cz:\u0022For team tournaments, only one player needs to send a payment for the whole team, usually the team Captain but any player can do it.\u0022,sk:\u0022For team tournaments, only one player needs to send a payment for the whole team, usually the team Captain but any player can do it.\u0022,gr:\u0022\u0393\u03B9\u03B1 \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC \u03BF\u03BC\u03AC\u03B4\u03C9\u03BD, \u03BC\u03CC\u03BD\u03BF \u03AD\u03BD\u03B1\u03C2 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1 \u03C3\u03C4\u03B5\u03AF\u03BB\u03B5\u03B9 \u03C0\u03BB\u03B7\u03C1\u03C9\u03BC\u03AE \u03B3\u03B9\u03B1 \u03BF\u03BB\u03CC\u03BA\u03BB\u03B7\u03C1\u03B7 \u03C4\u03B7\u03BD \u03BF\u03BC\u03AC\u03B4\u03B1, \u03C3\u03C5\u03BD\u03AE\u03B8\u03C9\u03C2 \u03BF \u03B1\u03C1\u03C7\u03B7\u03B3\u03CC\u03C2 \u03C4\u03B7\u03C2 \u03BF\u03BC\u03AC\u03B4\u03B1\u03C2 \u03B1\u03BB\u03BB\u03AC \u03BF\u03C0\u03BF\u03B9\u03BF\u03C3\u03B4\u03AE\u03C0\u03BF\u03C4\u03B5 \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C4\u03BF \u03BA\u03AC\u03BD\u03B5\u03B9.\u0022,ru:\u0022\u041E\u043F\u043B\u0430\u0442\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,ko:\u0022For team tournaments, only one player needs to send a payment for the whole team, usually the team Captain but any player can do it.\u0022},Yhe={en:\u0022Sign Out\u0022,fr:\u0022Se D\u00E9sinscrire\u0022,es:\u0022Desregistrarse\u0022,cn:\u0022\u9000\u51FA\u767B\u8BB0\u0022,it:\u0022Disconnetti\u0022,de:\u0022Sign Out\u0022,ja:\u0022\u30B5\u30A4\u30F3\u30A2\u30A6\u30C8\u0022,pl:\u0022Wypisz si\u0119\u0022,pt:\u0022Cancelar Inscri\u00E7\u00E3o\u0022,hr:\u0022Odjava\u0022,cz:\u0022Odhl\u00E1sit se\u0022,sk:\u0022Sign Out\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7\u0022,ru:\u0022\u0412\u044B\u0439\u0442\u0438\u0022,ko:\u0022Sign Out\u0022},Khe={en:\u0022Drop Out\u0022,fr:\u0022Abandonner\u0022,es:\u0022Abandonar\u0022,cn:\u0022\u9000\u51FA\u0022,it:\u0022Ritirati\u0022,de:\u0022Drop Out\u0022,ja:\u0022\u30C9\u30ED\u30C3\u30D7Out\u0022,pl:\u0022Wycofaj si\u0119\u0022,pt:\u0022Desistir\u0022,hr:\u0022Odustani\u0022,cz:\u0022Drop Out\u0022,sk:\u0022Drop Out\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C7\u03CE\u03C1\u03B7\u03C3\u03B7\u0022,ru:\u0022\u0412\u044B\u0431\u044B\u0442\u044C\u0022,ko:\u0022Drop Out\u0022},qhe={en:\u0022You signed out from this tournament.\u0022,fr:\u0022Vous vous \u00EAtes d\u00E9sinscrit de ce tournoi.\u0022,es:\u0022Te desregistraste de este torneo.\u0022,cn:\u0022\u60A8\u5DF2\u9000\u51FA\u6B64\u9526\u6807\u8D5B\u3002\u0022,it:\u0022Ti sei disconnesso da questo torneo.\u0022,de:\u0022You signed out from this tournament.\u0022,ja:\u0022You \u7F72\u540D\u6E08\u307F \u30A2\u30A6\u30C8 \u304B\u3089 \u3053\u306E \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8.\u0022,pl:\u0022Wypisa\u0142e\u015B si\u0119 z tego turnieju.\u0022,pt:\u0022Inscri\u00E7\u00E3o cancelada com sucesso\u0022,hr:\u0022Odjavili ste se s ovog turnira.\u0022,cz:\u0022You signed out from this tournament.\u0022,sk:\u0022You signed out from this tournament.\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C3\u03C5\u03BD\u03B4\u03B5\u03B8\u03AE\u03BA\u03B1\u03C4\u03B5 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC.\u0022,ru:\u0022\u0412\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0432\u044B\u043F\u0438\u0441\u0430\u043B\u0438\u0441\u044C \u0441 \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,ko:\u0022You signed out from this tournament.\u0022},Jhe={en:\u0022You dropped out from this tournament.\u0022,fr:\u0022Vous avez abandonn\u00E9 ce tournoi.\u0022,es:\u0022Abandonaste este torneo.\u0022,cn:\u0022\u60A8\u5DF2\u9000\u51FA\u6B64\u9526\u6807\u8D5B\u3002\u0022,it:\u0022Ti sei ritirato da questo torneo.\u0022,de:\u0022You dropped out from this tournament.\u0022,ja:\u0022You dropped \u30A2\u30A6\u30C8 \u304B\u3089 \u3053\u306E \u30C8\u30FC\u30CA\u30E1\u30F3\u30C8.\u0022,pl:\u0022Wycofa\u0142e\u015B si\u0119 z tego turnieju.\u0022,pt:\u0022Desist\u00EAncia registrada com sucesso\u0022,hr:\u0022Odustali ste od ovog turnira.\u0022,cz:\u0022You dropped out from this tournament.\u0022,sk:\u0022You dropped out from this tournament.\u0022,gr:\u0022\u0391\u03C0\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B1\u03C4\u03B5 \u03B1\u03C0\u03CC \u03B1\u03C5\u03C4\u03CC \u03C4\u03BF \u03C4\u03BF\u03C5\u03C1\u03BD\u03BF\u03C5\u03AC.\u0022,ru:\u0022\u0412\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0432\u044B\u0448\u043B\u0438 \u0438\u0437 \u0442\u0443\u0440\u043D\u0438\u0440\u0430\u0022,ko:\u0022You dropped out from this tournament.\u0022},$he={en:\u0022An error occurred.\u0022,fr:\u0022Une erreur s\u0027est produite.\u0022,es:\u0022Ocurri\u00F3 un error.\u0022,cn:\u0022\u53D1\u751F\u4E86\u9519\u8BEF\u3002\u0022,it:\u0022Si \u00E8 verificato un errore.\u0022,de:\u0022An error occurred.\u0022,ja:\u0022An\u30A8\u30E9\u30FCoccurred\u0022,pl:\u0022Wyst\u0105pi\u0142 b\u0142\u0105d.\u0022,pt:\u0022Ocorreu um erro\u0022,hr:\u0022Do\u0161lo je do gre\u0161ke.\u0022,cz:\u0022An error occurred.\u0022,sk:\u0022An error occurred.\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03BF\u03C5\u03C3\u03B9\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5 \u03C3\u03C6\u03AC\u03BB\u03BC\u03B1.\u0022,ru:\u0022\u041F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430 \u043E\u0448\u0438\u0431\u043A\u0430\u0022,ko:\u0022An error occurred.\u0022},Zhe={en:\u0022Vote !\u0022,fr:\u0022Voter !\u0022,es:\u0022\u00A1Votar!\u0022,cn:\u0022\u6295\u7968\uFF01\u0022,it:\u0022Vota!\u0022,de:\u0022Vote !\u0022,ja:\u0022Vote !\u0022,pl:\u0022G\u0142osuj!\u0022,pt:\u0022Votar\u0022,hr:\u0022Glasaj!\u0022,cz:\u0022Vote !\u0022,sk:\u0022Vote !\u0022,gr:\u0022\u03A8\u03B7\u03C6\u03AF\u03C3\u03C4\u03B5 !\u0022,ru:\u0022\u0413\u043E\u043B\u043E\u0441\u043E\u0432\u0430\u0442\u044C!\u0022,ko:\u0022Vote !\u0022},Xhe={en:\u0022Change Vote\u0022,fr:\u0022Modifier le Vote\u0022,es:\u0022Cambiar Voto\u0022,cn:\u0022\u66F4\u6539\u6295\u7968\u0022,it:\u0022Cambia Voto\u0022,de:\u0022Change Vote\u0022,ja:\u0022\u5909\u66F4Vote\u0022,pl:\u0022Zmie\u0144 G\u0142os\u0022,pt:\u0022Alterar Voto\u0022,hr:\u0022Promijeni glas\u0022,cz:\u0022Change Vote\u0022,sk:\u0022Change Vote\u0022,gr:\u0022\u0391\u03BB\u0