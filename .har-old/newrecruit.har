an broj igra\u010Da\u0022,cz:\u0022Max Number of Players\u0022,sk:\u0022Max Number of Players\u0022,gr:\u0022\u039C\u03AD\u03B3\u03B9\u03C3\u03C4\u03BF\u03C2 \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC\u03C2 \u03C0\u03B1\u03B9\u03BA\u03C4\u03CE\u03BD\u0022,ru:\u0022\u041C\u0430\u043A\u0441. \u041D\u043E\u043C\u0435\u0440 of \u0418\u0433\u0440\u043E\u043A\u0438\u0022,ko:\u0022Max Number of Players\u0022},oce={en:\u0022Max Number of Teams\u0022,fr:\u0022Nombre Maximum d\u0027\u00C9quipes\u0022,es:\u0022N\u00FAmero M\u00E1ximo de Equipos\u0022,cn:\u0022\u6700\u5927\u961F\u4F0D\u6570\u91CF\u0022,it:\u0022Numero Massimo di Squadre\u0022,de:\u0022Maximale Mannschaftsanzahl\u0022,ja:\u0022\u6700\u5927\u30C1\u30FC\u30E0\u6570\u0022,pl:\u0022Max Number of Teams\u0022,pt:\u0022N\u00FAmero M\u00E1ximo de Equipes\u0022,hr:\u0022Maksimalan broj timova\u0022,cz:\u0022Max Number of Teams\u0022,sk:\u0022Max Number of Teams\u0022,gr:\u0022\u039C\u03AD\u03B3\u03B9\u03C3\u03C4\u03BF\u03C2 \u03B1\u03C1\u03B9\u03B8\u03BC\u03CC\u03C2 \u03BF\u03BC\u03AC\u03B4\u03C9\u03BD\u0022,ru:\u0022\u041C\u0430\u043A\u0441. \u041D\u043E\u043C\u0435\u0440 of \u041A\u043E\u043C\u0430\u043D\u0434\u044B\u0022,ko:\u0022Max Number of Teams\u0022},ace={en:\u0022Number of lists per Player\u0022,fr:\u0022Nombre de listes par Joueur\u0022,es:\u0022N\u00FAmero de listas por Jugador\u0022,cn:\u0022\u6BCF\u4F4D\u73A9\u5BB6\u7684\u5217\u8868\u6570\u91CF\u0022,it:\u0022Numero di liste per Giocatore\u0022,de:\u0022Anzahl der Listen pro Spieler\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u3054\u3068\u306E\u30EA\u30B9\u30C8\u6570\u0022,pl:\u0022Liczba of listy per Gracz\u0022,pt:\u0022N\u00FAmero de listas por Jogador\u0022,hr:\u0022Broj popisa po igra\u010Du\u0022,cz:\u0022Number of lists per Player\u0022,sk:\u0022Number of lists per Player\u0022,gr:\u0022\u0391\u03C1\u03B9\u03B8\u03BC\u03CC\u03C2 \u03BB\u03B9\u03C3\u03C4\u03CE\u03BD \u03B1\u03BD\u03AC \u03C0\u03B1\u03AF\u03BA\u03C4\u03B7\u0022,ru:\u0022\u041D\u043E\u043C\