4\u6539\uFF0C\u60A8\u53EF\u80FD\u9700\u8981\u624B\u52A8\u9A8C\u8BC1\u3002\u0022,it:\u0022L\u0027esportazione testuale di questa lista \u00E8 stata modificata manualmente, potrebbe essere necessario convalidarla manualmente.\u0022,de:\u0022Der Textexport dieser Liste wurde manuell ge\u00E4ndert. M\u00F6glicherweise m\u00F6chten Sie ihn manuell validieren.\u0022,ja:\u0022\u3053\u306E\u30EA\u30B9\u30C8\u306E\u30C6\u30AD\u30B9\u30C8\u30A8\u30AF\u30B9\u30DD\u30FC\u30C8\u306F\u624B\u52D5\u3067\u5909\u66F4\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u624B\u52D5\u3067\u691C\u8A3C\u3059\u308B\u3053\u3068\u3092\u304A\u52E7\u3081\u3057\u307E\u3059\u3002\u0022,pl:\u0022Eksport tekstowy tej listy zosta\u0142 r\u0119cznie zmieniony, mo\u017Cesz chcie\u0107 zweryfikowa\u0107 go r\u0119cznie.\u0022,pt:\u0022A exporta\u00E7\u00E3o de texto desta lista foi alterada manualmente, voc\u00EA pode querer valid\u00E1-la manualmente.\u0022,hr:\u0022Lista je promijenjena\u0022,cz:\u0022This list\u0027s text export has been manually altered, you may want to validate it manually.\u0022,sk:\u0022This list\u0027s text export has been manually altered, you may want to validate it manually.\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7 \u03C4\u03C1\u03BF\u03C0\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u0431\u044B\u043B \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0022,ko:\u0022This list\u0027s text export has been manually altered, you may want to validate it manually.\u0022},CUe={en:\u0022Delete this list?\u0022,fr:\u0022Supprimer cette liste ?\u0022,es:\u0022\u00BFEliminar esta lista?\u0022,cn:\u0022\u5220\u9664\u6B64\u5217\u8868\uFF1F\u0022,it:\u0022Eliminare questa lista?\u0022,de:\u0022Diese Liste l\u00F6schen?\u0022,ja:\u0022\u3053\u306E\u30EA\u30B9\u30C8\u3092\u524A\u9664\u3057\u307E\u3059\u304B\uFF1F\u0022,pl:\u0022Usun\u0105\u0107 t\u0119 list\u0119?\u0022,pt:\u0022Excluir esta lista?\u0022,hr:\u0022Obri\u0161i ovu listu\u0022,cz:\u0022Delete this list?\u0022,sk:\u0022Delete this list?\u0022,gr:\u0022\u0394\u03B9\u03B1\u03B3\u03C1\u03B1\u03C6\u03AE \u03B1\u03C5\u03C4\u03AE\u03C2 \u03C4\u03B7\u03C2 \u03BB\u03AF\u03C3\u03C4\u03B1\u03C2\u0022,ru:\u0022\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0441\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022this list? \uC0AD\uC81C\u0022},_Ue={en:\u0022List has been imported\u0022,fr:\u0022La liste a \u00E9t\u00E9 import\u00E9e\u0022,es:\u0022La lista ha sido importada\u0022,cn:\u0022\u5217\u8868\u5DF2\u5BFC\u5165\u0022,it:\u0022La lista \u00E8 stata importata\u0022,de:\u0022Liste wurde importiert\u0022,ja:\u0022\u30EA\u30B9\u30C8\u304C\u30A4\u30F3\u30DD\u30FC\u30C8\u3055\u308C\u307E\u3057\u305F\u0022,pl:\u0022Lista zosta\u0142a zaimportowana\u0022,pt:\u0022A lista foi importada\u0022,hr:\u0022Lista uvezena\u0022,cz:\u0022List has been imported\u0022,sk:\u0022List has been imported\u0022,gr:\u0022\u0397 \u03BB\u03AF\u03C3\u03C4\u03B1 \u03B5\u03B9\u03C3\u03AE\u03C7\u03B8\u03B7\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0022,ko:\u0022List has been imported\u0022},SUe={en:\u0022List Review Assignment\u0022,fr:\u0022Assignation de revue de liste\u0022,es:\u0022Asignaci\u00F3n de revisi\u00F3n de lista\u0022,cn:\u0022\u5217\u8868\u5BA1\u6838\u5206\u914D\u0022,it:\u0022Assegnazione revisione elenco\u0022,de:\u0022Listen\u00FCberpr\u00FCfungszuweisung\u0022,ja:\u0022\u30EA\u30B9\u30C8\u5BE9\u67FB\u5272\u308A\u5F53\u3066\u0022,pl:\u0022Przydzia\u0142 przegl\u0105du listy\u0022,pt:\u0022Atribui\u00E7\u00E3o de revis\u00E3o de lista\u0022,hr:\u0022Dodjela recenzije liste\u0022,cz:\u0022List Review Assignment\u0022,sk:\u0022List Review Assignment\u0022,gr:\u0022\u03A4\u03AF\u03C4\u03BB\u03BF\u03C2 \u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u03C2 \u03B1\u03BE\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0441\u043F\u0438\u0441\u043A\u0430\u0022,ko:\u0022List Review Assignment\u0022},EUe={en:\u0022You have been assigned to review the list of {playerName} in tournament {tournamentName}.\u0022,fr:\u0022Vous avez \u00E9t\u00E9 assign\u00E9 pour revoir la liste de {playerName} dans le tournoi {tournamentName}.\u0022,es:\u0022Se te ha asignado revisar la lista de {playerName} en el torneo {tournamentName}.\u0022,cn:\u0022\u60A8\u5DF2\u88AB\u5206\u914D\u5BA1\u6838 {tournamentName} \u9526\u6807\u8D5B\u4E2D {playerName} \u7684\u5217\u8868\u3002\u0022,it:\u0022Ti \u00E8 stata assegnata la revisione dell\u0027elenco di {playerName} nel torneo {tournamentName}.\u0022,de:\u0022Du wurdest zugewiesen, die Liste von {playerName} im Turnier {tournamentName} zu \u00FCberpr\u00FCfen.\u0022,ja:\u0022\u30C8\u30FC\u30CA\u30E1\u30F3\u30C8 {tournamentName} \u3067 {playerName} \u306E\u30EA\u30B9\u30C8\u3092\u30EC\u30D3\u30E5\u30FC\u3059\u308B\u3088\u3046\u5272\u308A\u5F53\u3066\u3089\u308C\u307E\u3057\u305F\u3002\u0022,pl:\u0022Zosta\u0142e\u015B przydzielony do przegl\u0105du listy gracza {playerName} w turnieju {tournamentName}.\u0022,pt:\u0022Voc\u00EA foi designado para revisar a lista de {playerName} no torneio {tournamentName}.\u0022,hr:\u0022Dodijeljeni ste za recenziju liste\u0022,cz:\u0022You have been assigned to review the list of {playerName} in tournament {tournamentName}.\u0022,sk:\u0022You have been assigned to review the list of {playerName} in tournament {tournamentName}.\u0022,gr:\u0022\u039C\u03AE\u03BD\u03C5\u03BC\u03B1 \u03B5\u03B9\u03B4\u03BF\u03C0\u03BF\u03AF\u03B7\u03C3\u03B7\u03C2 \u03B1\u03BE\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u0412\u0430\u043C \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0441\u043F\u0438\u0441\u043E\u043A \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438\u0022,ko:\u0022You have been assigned to review the list of {playerName} in tournament {tournamentName}.\u0022},jUe={en:\u0022No review assignments yet\u0022,fr:\u0022Aucune assignation de revue pour le moment\u0022,es:\u0022A\u00FAn no hay asignaciones de revisi\u00F3n\u0022,cn:\u0022\u5C1A\u65E0\u5BA1\u6838\u5206\u914D\u0022,it:\u0022Nessuna assegnazione di revisione ancora\u0022,de:\u0022Noch keine \u00DCberpr\u00FCfungszuweisungen\u0022,ja:\u0022\u307E\u3060\u30EC\u30D3\u30E5\u30FC\u5272\u308A\u5F53\u3066\u304C\u3042\u308A\u307E\u305B\u3093\u0022,pl:\u0022Jeszcze brak przydzia\u0142\u00F3w recenzji\u0022,pt:\u0022Ainda n\u00E3o h\u00E1 atribui\u00E7\u00F5es de revis\u00E3o\u0022,hr:\u0022Nema dodjela recenzija\u0022,cz:\u0022No review assignments yet\u0022,sk:\u0022No review assignments yet\u0022,gr:\u0022\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B1\u03BD\u03B1\u03B8\u03AD\u03C3\u03B5\u03B9\u03C2 \u03B1\u03BE\u03B9\u03BF\u03BB\u03CC\u03B3\u03B7\u03C3\u03B7\u03C2\u0022,ru:\u0022\u041D\u0435\u0442 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438\u0022,ko:\u0022No review assignments yet\u0022},zUe={en:\u0022View List\u0022,fr:\u0022Voir la liste\u0022,es:\u0022Ver lista\u0022,cn:\u0022\u67E5\u770B\u5217\u8868\u0022,it:\u0022Visualizza elenco\u0022,de:\u0022Liste anzeigen\u0022,ja:\u0022\u30EA\u30B9\u30C8\u3092\u8868\u793A\u0022,pl:\u0022Zobacz list\u0119\u0022,pt:\u0022Ver lista\u0022,hr:\u0022Pregledaj listu\u0022,cz:\u0022View List\u0022,sk:\u0022View List\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03B2\u03BF\u03BB\u03AE \u039B\u03AF\u03C3\u03C4\u03B1\u0022,ru:\u0022\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u0421\u043F\u0438\u0441\u043E\u043A\u0022,ko:\u0022List \uBCF4\uAE30\u0022},IUe={en:\u0022Please select whether the list is legal or illegal\u0022,fr:\u0022Veuillez s\u00E9lectionner si la liste est l\u00E9gale ou ill\u00E9gale\u0022,es:\u0022Por favor seleccione si la lista es legal o ilegal\u0022,cn:\u0022\u8BF7\u9009\u62E9\u5217\u8868\u662F\u5426\u5408\u6CD5\u0022,it:\u0022Si prega di selezionare se l\u0027elenco \u00E8 legale o illegale\u0022,de:\u0022Bitte w\u00E4hlen Sie, ob die Liste legal oder illegal ist\u0022,ja:\u0022\u30EA\u30B9\u30C8\u304C\u5408\u6CD5\u304B\u9055\u6CD5\u304B\u3092\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u0022,pl:\u0022Prosz\u0119 wybra\u0107, czy lista jest legalna czy nielegalna\u0022,pt:\u0022Por favor selecione se a lista \u00E9 legal ou ilegal\u0022,hr:\u0022Molimo odaberite legalnost\u0022,cz:\u0022Please select whether the list is legal or illegal\u0022,sk:\u0022Please select whether the list is legal or illegal\u0022,gr:\u0022\u03A0\u03B1\u03C1\u03B1\u03BA\u03B1\u03BB\u03CE \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03C4\u03B5 \u03BD\u03BF\u03BC\u03B9\u03BC\u03CC\u03C4\u03B7\u03C4\u03B1\u0022,ru:\u0022\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u0022,ko:\u0022Please select whether the list is legal or illegal\u0022},PUe={en:\u0022No list submitted\u0022,fr:\u0022Aucune liste soumise\u0022,es:\u0022No se ha enviado ninguna lista\u0022,cn:\u0022\u672A\u63D0\u4EA4\u5217\u8868\u0022,it:\u0022Nessun elenco inviato\u0022,de:\u0022Keine Liste eingereicht\u0022,ja:\u0022\u30EA\u30B9\u30C8\u304C\u9001\u4FE1\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u0022,pl:\u0022Nie przes\u0142ano listy\u0022,pt:\u0022Nenhuma lista enviada\u0022,hr:\u0022Nema podnesene liste\u0022,cz:\u0022No list submitted\u0022,sk:\u0022No list submitted\u0022,gr:\u0022\u0394\u03B5\u03BD \u03C5\u03C0\u03BF\u03B2\u03BB\u03AE\u03B8\u03B7\u03BA\u03B5 \u03BB\u03AF\u03C3\u03C4\u03B1\u0022,ru:\u0022\u0421\u043F\u0438\u0441\u043E\u043A \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0022,ko:\u0022No list submitted\u0022},TUe={en:\u0022No reviewers assigned\u0022,fr:\u0022Aucun reviewer assign\u00E9\u0022,es:\u0022No hay revisores asignados\u0022,cn:\u0022\u672A\u5206\u914D\u5BA1\u6838\u8005\u0022,it:\u0022Nessun revisore assegnato\u0022,de:\u0022Keine Pr\u00FCfer zugewiesen\u0022,ja:\u0022\u30EC\u30D3\u30E5\u30A2\u30FC\u304C\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u307E\u305B\u3093\u0022,pl:\u0022Brak przypisanych recenzent\u00F3w\u0022,pt:\u0022Nenhum revisor atribu\u00EDdo\u0022,hr:\u0022Nema recenzenata\u0022,cz:\u0022No reviewers assigned\u0022,sk:\u0022No reviewers assigned\u0022,gr:\u0022\u0394\u03B5\u03BD \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B1\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B7\u03C4\u03AD\u03C2\u0022,ru:\u0022\u041D\u0435\u0442 \u0440\u0435\u0446\u0435\u043D\u0437\u0435\u043D\u0442\u043E\u0432\u0022,ko:\u0022No reviewers assigned\u0022},NUe={en:\u0022Add Reviewer\u0022,fr:\u0022Ajouter un reviewer\u0022,es:\u0022Agregar revisor\u0022,cn:\u0022\u6DFB\u52A0\u5BA1\u6838\u8005\u0022,it:\u0022Aggiungi revisore\u0022,de:\u0022Pr\u00FCfer hinzuf\u00FCgen\u0022,ja:\u0022\u30EC\u30D3\u30E5\u30A2\u30FC\u3092\u8FFD\u52A0\u0022,pl:\u0022Dodaj recenzenta\u0022,pt:\u0022Adicionar revisor\u0022,hr:\u0022Dodaj recenzenta\u0022,cz:\u0022Add Reviewer\u0022,sk:\u0022Add Reviewer\u0022,gr:\u0022\u03A0\u03C1\u03BF\u03C3\u03B8\u03AE\u03BA\u03B7 \u03B1\u03BE\u03B9\u03BF\u03BB\u03BF\u03B3\u03B7\u03C4\u03AE\u0022,ru:\u0022\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0440\u0435\u0446\u0435\u043D\u0437\u0435\u043D\u0442\u0430\u0022,ko:\u0022Reviewer \uCD94\uAC00\u0022},FUe={en:\u0022Select a player\u0022,fr:\u0022S\u00E9lectionner un joueur\u0022,es:\u0022Seleccionar un jugador\u0022,cn:\u0022\u9009\u62E9\u73A9\u5BB6\u0022,it:\u0022Seleziona un giocatore\u0022,de:\u0022W\u00E4hlen Sie einen Spieler\u0022,ja:\u0022\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u9078\u629E\u0022,pl:\u0022Wybierz gracza\u0022,pt:\u0022Selecione um jogador\u0022,hr:\u0022Odaberi igra\u010Da\