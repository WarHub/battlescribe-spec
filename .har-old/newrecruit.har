px 4px #0006;display:grid;grid-template-rows:40px 30px auto;margin:10px;padding:15px;text-align:center;width:220px}.feature img[data-v-f5648adb]{max-height:25px}.feature[data-v-f5648adb]{background-color:#fff}.feature .featureElements[data-v-f5648adb]{display:grid;line-height:1.3em;text-align:center}.feature .featureElements a[data-v-f5648adb]:last-child{text-align:center}.feature .learn[data-v-f5648adb]{color:#000;cursor:pointer;font-size:14px;font-style:italic;text-decoration:underline}.learnMore[data-v-f5648adb]{background-color:#0101011a;border:1px dotted gray;margin-top:5px;padding:5px}li[data-v-f5648adb]{text-align:justify}.box[data-v-f5648adb]{margin-bottom:20px}@media screen and (max-width:1350px){.index a.title[data-v-f5648adb]{grid-auto-flow:row;grid-gap:10px}.index a.title h3[data-v-f5648adb]{text-align:center}}.disclaimer h3[data-v-f5648adb]{font-size:16px}.disclaimer p[data-v-f5648adb]{font-size:14px}.tournaments ul[data-v-f5648adb]{line-height:1.3}.block[data-v-f5648adb]{display:inline-block;white-space:nowrap}.block-try-now[data-v-f5648adb]{background-color:#555;border:2px solid #1e90ff;border-radius:4px;color:#fff;display:inline-block;margin-bottom:40px;padding:14px}.block-try-now[data-v-f5648adb]:hover{text-decoration:underline}.center[data-v-f5648adb]{text-align:center}.inline-block[data-v-f5648adb]{display:inline-block}\u003C/style\u003E\u003Cstyle\u003E.menu[data-v-b7a818a9]{background-color:#2d2e18;display:grid;justify-items:center;padding:5px}.menuContent[data-v-b7a818a9]{font-size:18px;text-align:center}.menuContent a[data-v-b7a818a9]{color:var(--font-color);color:#fff;display:inline-block;font-weight:700;padding:2px 10px;text-align:center;text-decoration:none}.menuContent a[data-v-b7a818a9]:hover{text-decoration:underline}.menuContent .appLink img[data-v-b7a818a9]{vertical-align:middle;width:35px}@media screen and (max-width:500px){.trouble[data-v-b7a818a9]{display:none}}\u003C/style\u003E\u003Clink rel=\u0022stylesheet\u0022 href=\u0022/_nuxt/entry.DKFMTdLi.css\u0022 crossorigin\u003E\u003Clink rel=\u0022stylesheet\u0022 href=\u0022/_nuxt/OuterMenu.DK4WG2pc.css\u0022 crossorigin\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/BsM9VQE9.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/Dn8H0_T3.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/Da0XTgwL.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/CCCJpFTr.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/C0vuTbAm.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/CwW9bWnF.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/DiC9SyWY.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/C6e_iGsX.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/Cvq6eT4u.js\u0022\u003E\u003Clink rel=\u0022modulepreload\u0022 as=\u0022script\u0022 crossorigin href=\u0022/_nuxt/C24MkwNi.js\u0022\u003E\u003Cscript type=\u0022module\u0022 src=\u0022/_nuxt/BsM9VQE9.js\u0022 crossorigin\u003E\u003C/script\u003E\u003Cmeta hid=\u0022description\u0022 name=\u0022description\u0022 content=\u0022New Recruit, the best army builder for all tabletop miniature games. Warhammer 40 000, The Old World, The 9th Age, Age of Sigmar, Horus Heresy and more!\u0022\u003E\u003Cmeta name=\u0022google\u0022 content=\u0022notranslate\u0022\u003E\u003Cmeta name=\u0022mobile-web-app-capable\u0022 content=\u0022yes\u0022\u003E\u003Cmeta name=\u0022apple-mobile-web-app-status-bar-style\u0022 content=\u0022default\u0022\u003E\u003Clink rel=\u0022icon\u0022 type=\u0022image/x-icon\u0022 href=\u0022/favicon.ico\u0022\u003E\u003Clink rel=\u0022manifest\u0022 href=\u0022/manifest.json\u0022\u003E\u003Clink rel=\u0022apple-touch-icon\u0022 href=\u0022/assets/icons/icon.png\u0022\u003E\u003C/head\u003E\u003Cbody\u003E\u003Cdiv id=\u0022__nuxt\u0022\u003E\u003Cdiv class=\u0022container\u0022 data-v-80f58a77\u003E\u003Cdiv class=\u0022index\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022menu\u0022 data-v-f5648adb data-v-b7a818a9\u003E\u003Cdiv class=\u0022menuContent\u0022 data-v-b7a818a9\u003E\u003C!----\u003E \u003Ca href=\u0022/\u0022 data-v-b7a818a9\u003EHome\u003C/a\u003E \u003Ca href=\u0022/ladder\u0022 data-v-b7a818a9\u003ELadder\u003C/a\u003E \u003Ca href=\u0022/news\u0022 data-v-b7a818a9\u003ENews\u003C/a\u003E \u003Ca class=\u0022trouble\u0022 href=\u0022/troubleshotting\u0022 data-v-b7a818a9\u003ETroubleshooting\u003C/a\u003E \u003Ca href=\u0022/tutorials\u0022 data-v-b7a818a9\u003ETutorials\u003C/a\u003E \u003Ca href=\u0022/wiki\u0022 data-v-b7a818a9\u003EWiki\u003C/a\u003E \u003Ca href=\u0022/download/\u0022 class=\u0022appLink\u0022 data-v-b7a818a9\u003EDownload\u003C/a\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022content\u0022 style=\u0022margin-left:20px;margin-right:20px;\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022mainSection\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022title\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022block block-logo\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022logo\u0022 data-v-f5648adb\u003E\u003Cimg alt=\u0022logo\u0022 src=\u0022/assets/icons/icon.png\u0022 data-v-f5648adb\u003E\u003Cbr data-v-f5648adb\u003E \u003Ch1 data-v-f5648adb\u003ENEW\u003Cbr data-v-f5648adb\u003ERECRUIT\u003Cbr data-v-f5648adb\u003E\u003C/h1\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022block\u0022 data-v-f5648adb\u003E\u003Ch3 class=\u0022tt\u0022 data-v-f5648adb\u003EThe best army builder\u003Cbr /\u003Efor miniature games\u003C/h3\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022center\u0022 data-v-f5648adb\u003E\u003Ca href=\u0022/app\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022block-try-now\u0022 data-v-f5648adb\u003E\u003Ch2 data-v-f5648adb\u003EClick here to try it now!\u003C/h2\u003E\u003C/div\u003E\u003C/a\u003E\u003C/div\u003E \u003Cdiv class=\u0022center inline-block\u0022 data-v-f5648adb\u003E\u003Cp class=\u0022center\u0022 data-v-f5648adb\u003ENew Recruit is a \u003Cstrong\u003Emodern, free, web based army builder\u003C/strong\u003E.\u003C/p\u003E \u003Cp data-v-f5648adb\u003EHistorically New Recruit was only available for \u003Ca class=\u0022t9a\u0022 href=\u0022https://www.the-ninth-age.com/\u0022\u003EThe 9th Age Fantasy Battles\u003C/a\u003E. Over the years New Recruit has been recognised as the best army builder for The 9th Age by thousands of people and \u003Cstrong\u003Eit is now available for many more game systems \u003C/strong\u003E like \u003Ca href=\u0022https://www.newrecruit.eu/wiki/wh40k-10e/warhammer-40%2C000-10th-edition/\u0022\u003EWarhammer 40k\u003C/a\u003E, \u003Ca href=\u0022https://www.newrecruit.eu/wiki/tow/warhammer-the-old-world\u0022\u003EWarhammer The Old World\u003C/a\u003E, \u003Ca href=\u0022https://www.newrecruit.eu/wiki/warhammer-age-of-sigmar/age-of-sigmar/\u0022\u003EAge of Sigmar\u003C/a\u003E, \u003Ca href=\u0022https://www.newrecruit.eu/wiki/horus-heresy-3rd-edition/horus-heresy-3rd-edition\u0022\u003EHorus Heresy\u003C/a\u003E, \u003Ca href=\u0022https://www.newrecruit.eu/wiki/wh40k-killteam/warhammer-40,000:-kill-team-(2021)/\u0022\u003EKill Team\u003C/a\u003E, \u003Ca href=\u0022https://www.newrecruit.eu/wiki/warhammer-armies-project/warhammer-armies-project/\u0022\u003EWarhammer Armies Project\u003C/a\u003E...\u003C/p\u003E \u003Cdiv class=\u0022featureList\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/hammer.png\u0022 class=\u0022Build Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003E\u003Ca class=\u0022blue\u0022 href=\u0022https://www.newrecruit.eu/app\u0022 data-v-f5648adb\u003EBuild\u003C/a\u003E\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003EEasily create army lists, automatically count points, make sure your lists are valid.\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/cloud2.png\u0022 alt=\u0022Cloud Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003ESynchronize\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003ESynchronize your lists in just one click, no need to manually handle files.\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/devices.png\u0022 alt=\u0022Devices Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003EMultiplatform\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003ENew Recruit seamlessly works on all platforms: phones, tablets, computers\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/bs.png\u0022 alt=\u0022Battlescribe Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003EBattleScribe compatibility\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003ECreate, Load and Edit your BattleScribe Rosters within New Recruit\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/support.png\u0022 alt=\u0022Heart Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003EFree\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003ENew Recruit is free, if you want to support us, you can get a sub to obtain some cool bonus features.\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/profile.png\u0022 alt=\u0022Profile Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003EPlayer Profiles\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003ETrack of your game results and view interesting stats about your games.\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/tourny.png\u0022 alt=\u0022Tournaments Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003ETournaments\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003EEasily organise or play in tournaments, ELO based ladders\u003C/div\u003E \u003Ca href=\u0022#\u0022 class=\u0022learn\u0022 data-v-f5648adb\u003ELearn more\u003C/a\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022feature\u0022 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/warhall_small.png\u0022 alt=\u0022Warhall Icon\u0022 data-v-f5648adb\u003E \u003Cstrong class=\u0022blue\u0022 data-v-f5648adb\u003EWarhall Integration\u003C/strong\u003E \u003Cdiv class=\u0022featureElements\u0022 data-v-f5648adb\u003E\u003Cdiv data-v-f5648adb\u003EEasily deploy your armies in \u003Ca href=\u0022https://www.warhall.eu\u0022\u003EWarhall\u003C/a\u003E, a 3D miniature game simulator.\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022learnMore\u0022 style=\u0022display:none;\u0022 data-v-f5648adb\u003E\u003Cdiv class=\u0022tournaments\u0022 style=\u0022display:none;\u0022 data-v-f5648adb\u003E\u003Cp data-v-f5648adb\u003ENew Recruit includes Tournament Organisation tool. \u003Cstrong class=\u0022blue\u0022\u003E It is free to use!\u003C/strong\u003E Here is a short summary of what it can do for you if you want to organise a tournament:\u003C/p\u003E \u003Cul data-v-f5648adb\u003E\u003Cli data-v-f5648adb\u003ESwiss Rounds or Group Stages/Direct Elimitation tournament formats\u003C/li\u003E \u003Cli data-v-f5648adb\u003ELets players sign up and submit their Army Lists through New Recruit\u003C/li\u003E \u003Cli data-v-f5648adb\u003E\u003Cstrong class=\u0022blue\u0022\u003EAutomatically checks the validity of lists\u003C/strong\u003E! This works using Battlescribe data sets that are kept up to date by the BS data communities\u003C/li\u003E \u003Cli data-v-f5648adb\u003EAutomatically generate Pairings with a smart algorithm that always find the optimal pairings\u003C/li\u003E \u003Cli data-v-f5648adb\u003ELets players or Tournament Organisers easily submit the results of matches from any device\u003C/li\u003E \u003Cli data-v-f5648adb\u003EGenerates rankings based on tournament results\u003C/li\u003E \u003Cli data-v-f5648adb\u003EGenerates stats (such as win rate for each army, units, options...)\u003C/li\u003E \u003Cli data-v-f5648adb\u003EAutomatically includes tournaments into a global ELO based Ladder for each game system\u003C/li\u003E\u003C/ul\u003E \u003Cp data-v-f5648adb\u003EYou can also create \u003Cstrong class=\u0022blue\u0022\u003E your own Leagues \u003C/strong\u003E which lets you have League specific ladders and stats for a specific set of Tournaments you control.\u003C/p\u003E\u003C/div\u003E \u003Cdiv class=\u0022boutons\u0022 data-v-f5648adb\u003E\u003Cbutton class=\u0022bouton\u0022 data-v-f5648adb\u003EClose\u003C/button\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E \u003Cdiv class=\u0022discord\u0022 data-v-f5648adb\u003E\u003Ch3 data-v-f5648adb\u003E\u003Cimg src=\u0022/assets/icons/discord_small.png\u0022 alt=\u0022Discord Icon\u0022 /\u003E Join us on Discord!\u003C/h3\u003E \u003Cp data-v-f5648adb\u003EWe actively listen to bug reports, feature requests and suggestions!\u003C/p\u003E \u003Cp data-v-f5648adb\u003EDiscord link: \u003Ca class=\u0022blue\u0022 href=\u0022https://discord.gg/cCtqGbugwb\u0022\u003Ehttps://discord.gg/cCtqGbugwb\u003C/a\u003E\u003C/p\u003E\u003C/div\u003E \u003Cdiv class=\u0022disclaimer\u0022 data-v-f5648adb\u003E\u003Ch3 class=\u0022section\u0022 data-v-f5648adb\u003EDisclaimer\u003C/h3\u003E \u003Cp data-v-f5648adb\u003ENew Recruit does not host any game data files other than data for The 9th Age. The data files used by New Recruit are maintained by the BSData community and are directly downloaded from GitHub on this repository: https://github.com/BSData\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003C/div\u003E\u003Cdiv id=\u0022teleports\u0022\u003E\u003C/div\u003E\u003Cscript\u003Ewindow.__NUXT__={};window.__NUXT__.config={public:{apiBaseUrl:\u0022\u0022,testServer:false,clientVersion:\u002234.18\u0022,electron:false,capacitor:false,android:false,ios:false,gtag:{enabled:true,initMode:\u0022auto\u0022,id:\u0022G-GTNR157EL9\u0022,initCommands:[],config:{},tags:[],loadingStrategy:\u0022defer\u0022,url:\u0022https://www.googletagmanager.com/gtag/js\u0022}},app:{baseURL:\u0022/\u0022,buildId:\u0022b7722f60-7d22-4f4d-b85a-45eb25acf1a8\u0022,buildAssetsDir:\u0022/_nuxt/\u0022,cdnURL:\u0022\u0022}}\u003C/script\u003E\u003Cscript type=\u0022application/json\u0022 data-nuxt-data=\u0022nuxt-app\u0022 data-ssr=\u0022true\u0022 id=\u0022__NUXT_DATA__\u0022\u003E[[\u0022ShallowReactive\u0022,1],{\u0022data\u0022:2,\u0022state\u0022:4,\u0022once\u0022:6,\u0022_errors\u0022:7,\u0022serverRendered\u0022:9,\u0022path\u0022:10,\u0022pinia\u0022:11},[\u0022ShallowReactive\u0022,3],{},[\u0022Reactive\u0022,5],{},[\u0022Set\u0022],[\u0022ShallowReactive\u0022,8],{},true,\u0022/\u0022,[\u0022Reactive\u0022,12],{\u0022refe