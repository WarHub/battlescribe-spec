<Project>
  <!--
    THIS FILE IS THE WHOLE RECORD OF WHAT A RESTORE RESOLVES. Every version below is exact, and
    transitive pinning holds any package listed here to that version wherever it appears in the
    graph; everything else resolves by NuGet's lowest-applicable rule against immutable nuget.org
    packages, so the same file restores the same graph on every machine.

    There are no packages.lock.json files, deliberately. They were on from the start and recorded
    that same graph a second time, sixteen times over, and a second record drifts from the first:
    Dependabot regenerates a lock only for a project that references a bumped package DIRECTLY, so
    a bump left the locks of projects that reach it only through a ProjectReference stale, and the CI
    check that verified them failed #500, #501 and #503 in turn — three weekly Dependabot PRs whose
    build and tests never ran, each superseded by the next. That check was the locks' only consumer.
    Do not bring them back to fix a restore that differs between machines; find the floating input
    instead.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="IKVM" Version="8.16.1" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <!--
      xunit.v3 4.x is the Microsoft.Testing.Platform v2 flavour, and the suites run on that platform: a
      test project is an executable whose entry point is tests/TestProfiles/TestHost.cs (it resolves
      the test profile a run names from the registry), and global.json selects the platform for
      `dotnet test`. There is deliberately NO pin here for Microsoft.Testing.Platform or any of its
      extensions: xunit.v3 states the platform it needs, and a central pin of a package no project
      references is one Dependabot cannot see — it is how 2.2.1 once held xunit 4 back for six weeks
      (NU1109, and an update Dependabot dropped without a word). GitHubActionsTestLogger is a platform
      extension too (annotations and the step summary in Actions); it is referenced directly, so it is
      pinned and watched like any other package.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
    <PackageVersion Include="Yaml2JsonNode" Version="3.0.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>