<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="${{ match("[^"]+") }}" name="protocol-kitchen-sink" battleScribeVersion="2.03" generatedBy="https://newrecruit.eu" gameSystemId="ks-gs" gameSystemName="Kitchen Sink GS" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
