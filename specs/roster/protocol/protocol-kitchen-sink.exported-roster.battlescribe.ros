<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<roster id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="protocol-kitchen-sink" battleScribeVersion="2.03" gameSystemId="ks-gs" gameSystemName="Kitchen Sink GS" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/rosterSchema">
  <costs>
    <cost name="pts" typeId="ct-pts" value="320.0"/>
    <cost name="power" typeId="ct-power" value="14.0"/>
  </costs>
  <costLimits>
    <costLimit name="pts" typeId="ct-pts" value="200.0"/>
  </costLimits>
  <forces>
    <force id="${{ steps.add-battalion.forceId }}" name="Battalion" entryId="fe-battalion" customName="Alpha Strike Force" publicationId="pub-core" page="10" catalogueId="cat-1" catalogueRevision="1" catalogueName="Test Catalogue">
      <customNotes>Main battle group</customNotes>
      <rules>
        <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Combat Doctrine" hidden="false">
          <description>Re-roll hit rolls of 1</description>
        </rule>
        <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Battle-forged" publicationId="pub-core" page="5" hidden="false">
          <description>This army is battle-forged</description>
        </rule>
      </rules>
      <selections>
        <selection id="${{ steps.add-battalion.selections.se-required }}" name="Required Unit" entryId="se-required" number="1" type="unit">
          <rules>
            <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Rapid Fire" hidden="false">
              <description>Double shots at half range</description>
            </rule>
          </rules>
          <profiles>
            <profile id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Boltgun" hidden="false" typeId="pt-weapon" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="char-range">24</characteristic>
                <characteristic name="Str" typeId="char-str">4</characteristic>
                <characteristic name="AP" typeId="char-ap">0</characteristic>
                <characteristic name="D" typeId="char-d">1</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="power" typeId="ct-power" value="0.0"/>
            <cost name="pts" typeId="ct-pts" value="0.0"/>
          </costs>
          <categories>
            <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Elites" entryId="cat-elites" primary="true"/>
          </categories>
        </selection>
        <selection id="${{ steps.select-commander.selectionId }}" name="Commander" entryId="se-commander" customName="The General" number="1" type="unit">
          <customNotes>Veteran commander</customNotes>
          <rules>
            <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Fearless" hidden="false">
              <description>This unit automatically passes morale tests</description>
            </rule>
            <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Inspiring Leader" hidden="false">
              <description>Friendly units within 6 inches re-roll morale</description>
            </rule>
          </rules>
          <profiles>
            <profile id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Power Armor" hidden="false" typeId="pt-unit" typeName="Unit Stats">
              <characteristics>
                <characteristic name="WS" typeId="char-ws">3+</characteristic>
                <characteristic name="BS" typeId="char-bs">3+</characteristic>
                <characteristic name="S" typeId="char-s">4</characteristic>
                <characteristic name="T" typeId="char-t">4</characteristic>
                <characteristic name="W" typeId="char-w">2</characteristic>
              </characteristics>
            </profile>
            <profile id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Power Sword" hidden="false" typeId="pt-weapon" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="char-range">Melee</characteristic>
                <characteristic name="Str" typeId="char-str">5</characteristic>
                <characteristic name="AP" typeId="char-ap">-3</characteristic>
                <characteristic name="D" typeId="char-d">1</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selections>
            <selection id="${{ steps.select-bold.selectionId }}" name="Bold" entryId="se-cmd-trait-bold" entryGroupId="seg-cmd-traits" number="1" type="upgrade">
              <costs>
                <cost name="power" typeId="ct-power" value="0.0"/>
                <cost name="pts" typeId="ct-pts" value="0.0"/>
              </costs>
            </selection>
          </selections>
          <costs>
            <cost name="pts" typeId="ct-pts" value="100.0"/>
            <cost name="power" typeId="ct-power" value="4.0"/>
          </costs>
          <categories>
            <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="HQ" entryId="cat-hq" primary="true"/>
          </categories>
        </selection>
        <selection id="${{ steps.select-infantry-2.selectionId }}" name="Infantry Squad" entryId="se-infantry" publicationId="pub-core" page="42" number="1" type="unit">
          <rules>
            <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Orders" publicationId="pub-core" page="43" hidden="false">
              <description>Can receive orders from officers</description>
            </rule>
          </rules>
          <profiles>
            <profile id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Infantry" hidden="false" typeId="pt-unit" typeName="Unit Stats">
              <characteristics>
                <characteristic name="WS" typeId="char-ws">4+</characteristic>
                <characteristic name="BS" typeId="char-bs">4+</characteristic>
                <characteristic name="S" typeId="char-s">3</characteristic>
                <characteristic name="T" typeId="char-t">3</characteristic>
                <characteristic name="W" typeId="char-w">1</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="ct-pts" value="100.0"/>
            <cost name="power" typeId="ct-power" value="5.0"/>
          </costs>
          <categories>
            <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Troops" entryId="cat-troops" primary="true"/>
          </categories>
        </selection>
        <selection id="${{ steps.duplicate-infantry.selectionId }}" name="Infantry Squad" entryId="se-infantry" publicationId="pub-core" page="42" number="1" type="unit">
          <rules>
            <rule id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Orders" publicationId="pub-core" page="43" hidden="false">
              <description>Can receive orders from officers</description>
            </rule>
          </rules>
          <profiles>
            <profile id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Infantry" hidden="false" typeId="pt-unit" typeName="Unit Stats">
              <characteristics>
                <characteristic name="WS" typeId="char-ws">4+</characteristic>
                <characteristic name="BS" typeId="char-bs">4+</characteristic>
                <characteristic name="S" typeId="char-s">3</characteristic>
                <characteristic name="T" typeId="char-t">3</characteristic>
                <characteristic name="W" typeId="char-w">1</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selections>
            <selection id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Trooper" entryId="se-inf-trooper" number="2" type="model">
              <costs>
                <cost name="pts" typeId="ct-pts" value="20.0"/>
                <cost name="power" typeId="ct-power" value="0.0"/>
              </costs>
            </selection>
          </selections>
          <costs>
            <cost name="pts" typeId="ct-pts" value="100.0"/>
            <cost name="power" typeId="ct-power" value="5.0"/>
          </costs>
          <categories>
            <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Troops" entryId="cat-troops" primary="true"/>
          </categories>
        </selection>
      </selections>
      <publications>
        <publication id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Supplement"/>
        <publication id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Core Rulebook"/>
      </publications>
      <categories>
        <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Uncategorised" entryId="(No Category)" primary="false"/>
        <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="HQ" entryId="cat-hq" customName="Command HQ" primary="false">
          <customNotes>HQ deployment notes</customNotes>
        </category>
        <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Troops" entryId="cat-troops" primary="false"/>
        <category id="${{ match('[- 0-9A-Za-z()_.:]+') }}" name="Elites" entryId="cat-elites" primary="false"/>
      </categories>
    </force>
  </forces>
</roster>
