<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="Completeness Catalogue" id="cat-1" battleScribeVersion="2.03" gameSystemId="gs-1" gameSystemRevision="1" library="false" revision="1" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink name="Completeness Library (linked)" id="cl-lib" importRootEntries="true" targetId="cat-lib" type="catalogue"/>
  </catalogueLinks>
  <categoryEntries>
    <categoryEntry name="HQ" id="ce-hq" hidden="false" page="12" publicationId="pub-core">
      <constraints>
        <constraint id="con-hq-max" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="2"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false"/>
      </modifiers>
    </categoryEntry>
  </categoryEntries>
  <costTypes>
    <costType name="Local Points" id="cct-pts" defaultCostLimit="-1" hidden="false"/>
  </costTypes>
  <entryLinks>
    <entryLink name="Relic Blade" id="el-root-relic" collective="false" hidden="false" import="true" targetId="lib-sse-relic" type="selectionEntry"/>
  </entryLinks>
  <forceEntries>
    <forceEntry name="Detachment" id="fe-detachment" hidden="false" page="5" publicationId="pub-core">
      <categoryLinks>
        <categoryLink name="HQ" id="cl-fe-hq" hidden="false" primary="false" targetId="ce-hq"/>
      </categoryLinks>
      <constraints>
        <constraint id="con-fe-min" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
      </constraints>
      <forceEntries>
        <forceEntry name="Sub-Detachment" id="fe-sub" hidden="false"/>
      </forceEntries>
      <rules>
        <rule name="Detachment Rule" id="rule-fe" hidden="false">
          <description>A force-level rule.</description>
        </rule>
      </rules>
    </forceEntry>
  </forceEntries>
  <infoLinks>
    <infoLink name="Shared Core Rule" id="il-root-rule" hidden="false" targetId="srule-core" type="rule"/>
  </infoLinks>
  <profileTypes>
    <profileType name="Extra" id="cpt-extra">
      <characteristicTypes>
        <characteristicType name="Note" id="ccht-note"/>
      </characteristicTypes>
    </profileType>
  </profileTypes>
  <publications>
    <publication name="Core Rulebook" id="pub-core" publicationDate="2024" publisher="Games Co" publisherUrl="https://example.test/crb" shortName="CRB"/>
  </publications>
  <rules>
    <rule name="Catalogue Rule" id="rule-root" hidden="false">
      <description>A catalogue-root rule.</description>
    </rule>
  </rules>
  <selectionEntries>
    <selectionEntry name="Tactical Squad" id="se-squad" collective="false" hidden="false" import="true" page="40" publicationId="pub-core" type="unit">
      <categoryLinks>
        <categoryLink name="Infantry" id="cl-primary" hidden="false" primary="true" targetId="gce-infantry"/>
        <categoryLink name="Character" id="cl-secondary" hidden="false" primary="false" targetId="gce-character"/>
      </categoryLinks>
      <constraints>
        <constraint id="con-squad-min" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="5"/>
        <constraint id="con-squad-max" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="10"/>
      </constraints>
      <costs>
        <cost typeId="ct-pts" value="90"/>
      </costs>
      <entryLinks>
        <entryLink name="Boltgun" id="el-squad-bolter" collective="false" hidden="false" import="true" targetId="sse-bolter" type="selectionEntry">
          <constraints>
            <constraint id="con-link-max" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost typeId="ct-pts" value="2"/>
          </costs>
          <entryLinks>
            <entryLink name="Relic Blade" id="el-nested-relic" collective="false" hidden="false" import="true" targetId="lib-sse-relic" type="selectionEntry"/>
          </entryLinks>
        </entryLink>
      </entryLinks>
      <infoGroups>
        <infoGroup name="Squad Abilities" id="ig-squad" hidden="false">
          <infoGroups>
            <infoGroup name="Nested Info" id="ig-nested" hidden="false"/>
          </infoGroups>
          <infoLinks>
            <infoLink name="Shared Core Rule" id="il-ig-rule" hidden="false" targetId="srule-core" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Combat Squads" id="prof-ig" hidden="false" typeId="pt-ability" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="cht-desc">Split into two units.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Feel No Pain" id="il-squad-profile" hidden="false" targetId="sprof-ability" type="profile"/>
      </infoLinks>
      <modifierGroups>
        <modifierGroup>
          <conditions>
            <condition childId="sse-bolter" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="greaterThan" value="0"/>
          </conditions>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </modifierGroup>
      </modifierGroups>
      <modifiers>
        <modifier field="ct-pts" type="increment" value="10">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="sse-bolter" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="lessThan" value="3"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
          <conditions>
            <condition childId="sse-bolter" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="atLeast" value="1"/>
          </conditions>
          <repeats>
            <repeat childId="sse-bolter" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="false" value="1"/>
          </repeats>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Marine" id="prof-squad" hidden="false" typeId="pt-weapon" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="cht-range">-</characteristic>
            <characteristic name="Str" typeId="cht-str">4</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="And They Shall Know No Fear" id="rule-squad" hidden="false">
          <description>Auto-pass morale.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Sergeant" id="se-sergeant" collective="false" hidden="false" import="true" type="model"/>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Wargear" id="seg-wargear" collective="false" defaultSelectionEntryId="se-bolter-child" hidden="false" import="true">
          <entryLinks>
            <entryLink name="Relic Blade" id="el-group-relic" collective="false" hidden="false" import="true" targetId="lib-sse-relic" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="Bolter" id="se-bolter-child" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost typeId="ct-pts" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
  </selectionEntries>
  <sharedInfoGroups>
    <infoGroup name="Shared Info" id="sig-shared" hidden="false">
      <profiles>
        <profile name="Aura" id="prof-sig" hidden="false" typeId="pt-ability" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="cht-desc">Affects nearby units.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
  </sharedInfoGroups>
  <sharedProfiles>
    <profile name="Feel No Pain" id="sprof-ability" hidden="false" typeId="pt-ability" typeName="Ability">
      <characteristics>
        <characteristic name="Description" typeId="cht-desc">Ignore wounds on a 5+.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Shared Core Rule" id="srule-core" hidden="false" page="7" publicationId="pub-core">
      <description>A shared rule body.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry name="Boltgun" id="sse-bolter" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost typeId="ct-pts" value="2"/>
      </costs>
      <profiles>
        <profile name="Boltgun" id="prof-bolter" hidden="false" typeId="pt-weapon" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="cht-range">24&quot;</characteristic>
            <characteristic name="Str" typeId="cht-str">4</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Shared Wargear" id="sseg-shared" collective="false" defaultSelectionEntryId="sseg-child-knife" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Combat Knife" id="sseg-child-knife" collective="false" hidden="false" import="true" type="upgrade"/>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
