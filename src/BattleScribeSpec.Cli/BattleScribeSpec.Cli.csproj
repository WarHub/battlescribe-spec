<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BattleScribeSpec.Cli</RootNamespace>
    <AssemblyName>bs-spec</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BattleScribeSpec.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI is engine-free: it speaks the adapter protocol and forwards probe/discover to
         bs-engine-host. It needs only the test kit (core model/protocol/runners) and XmlGen
         (probe/export XML generation). TestKit was previously transitive via XmlGen — now explicit. -->
    <ProjectReference Include="..\BattleScribeSpec.TestKit\BattleScribeSpec.TestKit.csproj" />
    <ProjectReference Include="..\BattleScribeSpec.XmlGen\BattleScribeSpec.XmlGen.csproj" />
  </ItemGroup>

</Project>
