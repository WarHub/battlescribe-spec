<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BattleScribeSpec</RootNamespace>
    <Description>BattleScribe conformance spec test kit — run declarative YAML specs against any roster editing engine.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleScribeSpec.Telemetry\BattleScribeSpec.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BattleScribeSpec.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="specs\**\*.yaml" />
    <EmbeddedResource Include="..\..\specs\**\*.yaml" LinkBase="specs" />
  </ItemGroup>

</Project>
