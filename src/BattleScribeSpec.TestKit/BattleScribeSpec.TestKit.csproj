<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BattleScribeSpec</RootNamespace>
    <Description>BattleScribe conformance spec test kit — run declarative YAML specs against any roster editing engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="specs\**\*.yaml" />
    <EmbeddedResource Include="..\..\specs\**\*.yaml" LinkBase="specs" />
  </ItemGroup>

</Project>
