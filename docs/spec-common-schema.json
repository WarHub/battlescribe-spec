{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BattleScribe Spec: shared definitions",
  "description": "What every spec domain shares: the setup data (a game system, its catalogues and everything in them, the protocol's setup types in src/BattleScribeSpec.TestKit/Protocol/ProtocolMessages.cs), spec-level engine expectations, expectFailure and expectedFile. Referenced by roster-spec-schema.json, gamedata-spec-schema.json and scenario-spec-schema.json; it is not a spec schema itself.",
  "$defs": {
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known tags only (SpecLintTests.KnownTags; .agents/skills/writing-specs/references/KNOWN-TAGS.md)."
    },
    "constraintType": {
      "type": "string",
      "enum": ["min", "max", "exactly"],
      "$comment": "min/max are original BattleScribe; exactly is a NewRecruit addition."
    },
    "conditionType": {
      "type": "string",
      "enum": [
        "atLeast", "atMost", "equalTo", "greaterThan", "lessThan", "notEqualTo", "instanceOf",
        "notInstanceOf", "always", "never", "before"
      ],
      "$comment": "always/never/before are NewRecruit additions (before only valid in a localConditionGroup)."
    },
    "modifierType": {
      "type": "string",
      "enum": [
        "set", "add", "increment", "decrement", "append", "remove", "set-primary", "unset-primary",
        "multiply", "divide", "modulo", "power", "exponent", "triangular", "ceil", "floor", "cumulative-add",
        "cumulative-multiply", "cumulative-power", "prepend", "replace", "hide"
      ],
      "$comment": "set..unset-primary are original BattleScribe; the rest are NewRecruit additions."
    },
    "scopeValue": {
      "description": "What a query counts within: a scope keyword, or the id of an ancestor entry or category to scope it to. An id that names nothing is the editor's validation error to report, so the schema does not refuse it.",
      "anyOf": [
        { "$ref": "#/$defs/scopeKeyword" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "scopeKeyword": {
      "type": "string",
      "enum": [
        "self", "parent", "force", "roster", "primary-category", "primary-catalogue", "ancestor",
        "root-entry", "unit", "model", "upgrade", "model-or-unit"
      ],
      "$comment": "root-entry and the type scopes (unit/model/upgrade/model-or-unit) are NewRecruit additions."
    },
    "conditionGroupType": {
      "type": "string",
      "enum": [
        "and", "or", "not", "count", "add", "subtract", "multiply", "divide", "modulo", "power", "min", "max",
        "greater", "greaterOrEqual", "less", "lessOrEqual", "equal", "notEqual"
      ],
      "$comment": "and/or are original BattleScribe; the boolean/numeric/comparison kinds are NewRecruit additions."
    },
    "selectionEntryType": {
      "type": "string",
      "enum": ["unit", "model", "upgrade", "unit-group", "mount", "crew"],
      "$comment": "unit/model/upgrade are original BattleScribe; unit-group/mount/crew are NewRecruit additions."
    },
    "entryLinkType": { "type": "string", "enum": ["selectionEntry", "selectionEntryGroup"] },
    "engineExpectation": { "type": "string", "enum": ["pass", "fail", "skip"] },
    "specEngines": {
      "type": "object",
      "description": "Per-engine expectation: pass (the default), fail or skip. Every runner reads it by one rule: an engine's own entry, else its family's (a UI driver's family is its name without -ui, so battlescribe: skip covers battlescribe-ui). Give a UI driver an entry only where its value differs from its family's; the lint refuses a restatement.",
      "propertyNames": { "$ref": "#/$defs/engineName" },
      "additionalProperties": { "$ref": "#/$defs/engineExpectation" }
    },
    "engineName": {
      "type": "string",
      "description": "An engine name: battlescribe, battlescribe-ui, newrecruit, newrecruit-ui, or an external adapter's own. A UI driver inherits its base engine's entry unless it has one of its own."
    },
    "expectFailure": {
      "description": "Assert that this action is refused by the engine — a parser rejecting the payload, an engine declining the edit. Satisfied ONLY by an engine refusal: a failure the adapter raised while resolving an id the spec named, a harness fault, and a failure from an adapter that sends no 'kind' all stay fatal. Distinct from expectedState.errors, which asserts the validation list of a roster the engine accepted. A refused step does not end the run, so a following expectedState can assert what the refusal left behind.",
      "oneOf": [
        {
          "type": "boolean",
          "description": "true: the engine must refuse. false: it must succeed (the default), used as a per-engine override to record an engine that accepts input the others reject."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected": {
              "type": "boolean",
              "description": "Whether this engine is expected to refuse. Defaults to true."
            },
            "messageContains": {
              "type": "string",
              "description": "Case-insensitive substring the refusal message must contain. Matched against the engine's own message, never the harness framing around it."
            },
            "engines": {
              "type": "object",
              "description": "Per-engine overrides. Each value takes the same three shapes as the field itself; 'engines' cannot nest inside one.",
              "propertyNames": { "$ref": "#/$defs/engineName" },
              "additionalProperties": {
                "oneOf": [
                  { "type": "boolean" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "expected": { "type": "boolean" },
                      "messageContains": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "expectedFile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Byte-compare the engine's exported file against a per-engine snapshot (keyed by the step id) or inline content.",
      "properties": {
        "content": { "type": "string" },
        "fileType": { "type": "string" },
        "engines": {
          "type": "object",
          "description": "Per-engine overrides: an override's content or fileType replaces the base for that engine.",
          "propertyNames": { "$ref": "#/$defs/engineName" },
          "additionalProperties": { "$ref": "#/$defs/expectedFileOverride" }
        }
      }
    },
    "expectedFileOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "type": "string" },
        "fileType": { "type": "string" }
      }
    },
    "gameSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "costTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/costType" }
