        }
      }
    },
    "catalogue": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gameSystemId": { "type": "string" },
        "library": { "type": "boolean" },
