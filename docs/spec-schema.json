    "categoryLink": {
      "type": "object",
      "required": ["targetId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string" },
        "name": { "type": "string" },
        "primary": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "rules": {
