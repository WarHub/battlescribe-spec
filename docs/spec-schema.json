        "value": { "type": "number" }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["id", "type", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/constraintType" },
        "value": { "type": "number" },
        "field": { "type": "string" },
        "scope": { "$ref": "#/$defs/scopeValue" },
        "shared": { "type": "boolean" },
        "includeChildSelections": { "type": "boolean" },
        "includeChildForces": { "type": "boolean" },
        "percentValue": { "type": "boolean" }
      }
    },
    "modifier": {
      "type": "object",
      "required": ["type", "field", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/modifierType" },
        "field": { "type": "string" },
        "value": {
          "description": "Modifier value — always a string. Quote numeric and boolean values in YAML.",
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "conditionGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/conditionGroup" }
        },
        "repeats": {
          "type": "array",
          "items": { "$ref": "#/$defs/repeat" }
        }
      }
    },
    "modifierGroup": {
      "type": "object",
