        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/conditionType" },
        "value": { "type": "number" },
        "field": { "type": "string" },
        "scope": { "$ref": "#/$defs/scopeValue" },
        "childId": { "type": "string" },
        "shared": { "type": "boolean" },
        "includeChildSelections": { "type": "boolean" },
        "includeChildForces": { "type": "boolean" },
        "percentValue": { "type": "boolean" }
      }
    },
    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/conditionGroupType" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "conditionGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/conditionGroup" }
        }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "repeats": { "type": "integer" },
