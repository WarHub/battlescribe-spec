          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        },
        "selectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "selectionEntryGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntryGroup" }
        },
        "entryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryLink" }
        },
        "categoryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryLink" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "infoGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoGroup" }
        },
        "infoLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoLink" }
        }
      }
    },
    "selectionEntryGroup": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "hidden": { "type": "boolean" },
        "collective": { "type": "boolean" },
        "import": { "type": "boolean" },
        "defaultSelectionEntryId": { "type": "string" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        },
        "selectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "selectionEntryGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntryGroup" }
        },
        "entryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryLink" }
        },
        "categoryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryLink" }
        },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/costValue" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "infoGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoGroup" }
        },
        "infoLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoLink" }
        }
      }
    },
    "entryLink": {
      "type": "object",
      "required": ["id", "targetId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "targetId": { "type": "string" },
        "type": { "$ref": "#/$defs/entryLinkType" },
        "hidden": { "type": "boolean" },
        "collective": { "type": "boolean" },
        "import": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/costValue" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        },
        "categoryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryLink" }
        },
        "selectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "selectionEntryGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntryGroup" }
        },
        "entryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryLink" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "infoGroups": {
