{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WarHub/battlescribe-spec/docs/spec-schema.json",
  "title": "BattleScribe Spec",
  "description": "Schema for BattleScribe conformance test spec YAML files.",
  "type": "object",
  "required": ["id", "category", "description", "setup", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "engines": { "$ref": "#/$defs/specEngines" },
    "setup": { "$ref": "#/$defs/setup" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "minItems": 1
    }
  },
  "$defs": {
    "actionName": {
      "type": "string",
      "enum": [
        "addForce",
        "addChildForce",
        "removeForce",
        "selectEntry",
        "selectChildEntry",
        "deselectSelection",
        "setSelectionCount",
        "duplicateSelection",
        "duplicateForce",
        "setCostLimit",
        "setCustomization",
        "dump"
      ]
    },
    "constraintType": {
      "type": "string",
      "enum": ["min", "max"]
    },
    "conditionType": {
      "type": "string",
      "enum": [
        "atLeast",
        "atMost",
        "equalTo",
        "greaterThan",
        "lessThan",
        "notEqualTo",
        "instanceOf",
        "notInstanceOf"
      ]
    },
    "modifierType": {
      "type": "string",
      "enum": ["set", "add", "increment", "decrement", "append", "remove", "set-primary", "unset-primary"]
    },
    "scopeValue": {
      "type": "string",
      "enum": ["self", "parent", "force", "roster", "primary-category", "primary-catalogue", "ancestor"]
    },
    "conditionGroupType": {
      "type": "string",
      "enum": ["and", "or"]
    },
    "selectionEntryType": {
      "type": "string",
      "enum": ["unit", "model", "upgrade"]
    },
    "entryLinkType": {
      "type": "string",
      "enum": ["selectionEntry", "selectionEntryGroup"]
    },
    "engineExpectation": {
      "type": "string",
      "enum": ["pass", "fail", "skip"]
    },

    "specEngines": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/engineName" },
      "additionalProperties": {
        "enum": ["pass", "fail", "skip"]
      }
    },
    "engineName": {
      "type": "string"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameSystem": { "$ref": "#/$defs/gameSystem" },
        "dataSource": { "type": "string" },
        "catalogues": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogue" }
        }
      },
      "oneOf": [
        { "required": ["gameSystem"] },
        { "required": ["dataSource"] }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "action": { "$ref": "#/$defs/actionName" },
        "forceEntryId": { "type": "string" },
        "entryId": { "type": "string" },
        "catalogueId": { "type": "string" },
        "forceId": { "type": "string" },
        "selectionId": { "type": "string" },
        "costTypeId": { "type": "string" },
        "count": { "type": "integer" },
        "value": { "type": "number" },
        "customName": { "type": "string" },
        "customNotes": { "type": "string" },
        "categoryEntryId": { "type": "string" },
        "path": { "type": "string" },
        "skipEngines": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Engine names to skip this action step for (e.g., [\"battlescribe\"])"
        },
        "expectedState": { "$ref": "#/$defs/expectedState" }
      },
      "oneOf": [
        { "required": ["action"] },
        { "required": ["expectedState"] }
      ]
    },

    "gameSystem": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "costTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/costType" }
        },
        "forceEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/forceEntry" }
        },
        "categoryEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryEntry" }
        },
        "profileTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/profileType" }
        },
        "publications": {
          "type": "array",
          "items": { "$ref": "#/$defs/publication" }
        },
        "selectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "entryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryLink" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "infoLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoLink" }
        },
        "sharedSelectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "sharedSelectionEntryGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntryGroup" }
        },
        "sharedRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "sharedProfiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "sharedInfoGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoGroup" }
        }
      }
    },
    "catalogue": {
      "type": "object",
      "required": ["id", "name", "gameSystemId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gameSystemId": { "type": "string" },
        "library": { "type": "boolean" },
        "selectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "entryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryLink" }
        },
        "sharedSelectionEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntry" }
        },
        "sharedSelectionEntryGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectionEntryGroup" }
        },
        "sharedRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "sharedProfiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "sharedInfoGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoGroup" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "infoLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoLink" }
        },
        "catalogueLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalogueLink" }
        },
        "publications": {
          "type": "array",
          "items": { "$ref": "#/$defs/publication" }
        },
        "costTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/costType" }
        },
        "profileTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/profileType" }
        },
        "categoryEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryEntry" }
        },
        "forceEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/forceEntry" }
        }
      }
    },
    "costType": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "defaultCostLimit": { "type": "number" },
        "hidden": { "type": "boolean" },
        "limit": { "type": "boolean" }
      }
    },
    "profileType": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "characteristicTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/characteristicType" }
        }
      }
    },
    "characteristicType": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "forceEntry": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "hidden": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        },
        "categoryLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryLink" }
        },
        "forceEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/forceEntry" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "infoGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoGroup" }
        },
        "infoLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoLink" }
        }
      }
    },
    "categoryEntry": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "hidden": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "infoGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoGroup" }
        },
        "infoLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/infoLink" }
        }
      }
    },
    "selectionEntry": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/selectionEntryType" },
        "hidden": { "type": "boolean" },
        "import": { "type": "boolean" },
        "collective": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/costValue" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
