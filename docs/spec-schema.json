        "roundUp": { "type": "boolean" },
        "shared": { "type": "boolean" },
        "includeChildSelections": { "type": "boolean" },
        "includeChildForces": { "type": "boolean" },
        "percentValue": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "hidden": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" }
        },
        "modifierGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/modifierGroup" }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "name", "typeId", "typeName"],
