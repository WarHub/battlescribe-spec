{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BattleScribe Roster Spec",
  "description": "A roster spec, specs/roster/{category}/{id}.yaml: steps in the roster editor over data that never changes. Model: src/BattleScribeSpec.TestKit/Roster/RosterSpecModels.cs.",
  "type": "object",
  "required": ["id", "category", "description", "setup", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "Must match the file name, without .yaml." },
    "category": { "type": "string", "description": "Must match the parent directory's name." },
    "description": { "type": "string" },
    "tags": { "$ref": "spec-common-schema.json#/$defs/tags" },
    "engines": { "$ref": "spec-common-schema.json#/$defs/specEngines" },
    "setup": { "$ref": "#/$defs/setup" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "actionName": {
      "type": "string",
      "enum": [
        "addForce", "addChildForce", "removeForce", "selectEntry", "selectChildEntry", "deselectSelection",
        "setSelectionCount", "duplicateSelection", "duplicateForce", "setCostLimit", "setCustomization",
        "loadRoster", "reload", "dump"
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameSystem": { "$ref": "spec-common-schema.json#/$defs/gameSystem" },
        "dataSource": { "type": "string" },
        "catalogues": {
          "type": "array",
          "items": { "$ref": "spec-common-schema.json#/$defs/catalogue" }
        }
      },
      "oneOf": [
        { "required": ["gameSystem"] },
        { "required": ["dataSource"] }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "action": { "$ref": "#/$defs/actionName" },
        "forceEntryId": { "type": "string" },
        "entryId": { "type": "string" },
        "catalogueId": { "type": "string" },
        "forceId": { "type": "string" },
        "selectionId": { "type": "string" },
        "costTypeId": { "type": "string" },
        "count": { "type": "integer" },
        "value": { "type": "number" },
        "customName": { "type": "string" },
        "customNotes": { "type": "string" },
        "categoryEntryId": { "type": "string" },
        "content": { "type": "string", "description": "Inline BattleScribe .ros XML payload for loadRoster." },
        "skipEngines": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Engine names to skip this step for (e.g., [\"battlescribe\"]). Applies to any step kind — actions, expectedState and expectedFile alike — and is how a spec declares that an engine cannot do what the step asks. The runner never swallows a capability gap, so an undeclared one fails the spec. Skipped steps are reported in the run summary. Spec-level equivalent: engines: {<engine>: skip}."
        },
        "engines": {
          "type": "object",
          "description": "Per-engine overrides for this step's action inputs (e.g. a different value/count per engine). The step's action, id and assertions are never overridden.",
          "propertyNames": { "$ref": "spec-common-schema.json#/$defs/engineName" },
          "additionalProperties": { "$ref": "#/$defs/stepOverride" }
        },
        "expectFailure": { "$ref": "spec-common-schema.json#/$defs/expectFailure" },
        "expectedState": { "$ref": "#/$defs/expectedState" },
        "expectedFile": { "$ref": "spec-common-schema.json#/$defs/expectedFile" }
      },
      "oneOf": [
        { "required": ["action"] },
        { "required": ["expectedState"] },
        { "required": ["expectedFile", "id"] }
      ],
      "if": { "required": ["expectFailure"] },
      "then": {
        "required": ["action"],
        "description": "expectFailure asserts that an action was refused, so it only belongs on an action step. The validation list of a roster the engine ACCEPTED is expectedState.errors."
      }
    },
    "stepOverride": {
      "type": "object",
      "description": "One engine's action inputs. Each field set here replaces the step's own for that engine.",
      "additionalProperties": false,
      "properties": {
        "forceEntryId": { "type": "string" },
        "entryId": { "type": "string" },
        "catalogueId": { "type": "string" },
        "forceId": { "type": "string" },
        "selectionId": { "type": "string" },
        "costTypeId": { "type": "string" },
        "count": { "type": "integer" },
        "value": { "type": "number" },
        "customName": { "type": "string" },
        "customNotes": { "type": "string" },
        "categoryEntryId": { "type": "string" },
        "content": { "type": "string", "description": "Inline BattleScribe .ros XML payload for loadRoster." }
      }
    },
    "expectedState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "forceCount": { "type": "integer" },
        "selectionCount": { "type": "integer" },
        "forces": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedForce" }
        },
        "costCount": { "type": "integer" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedCost" }
        },
        "costLimits": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedCost" }
        },
        "costLimitCount": { "type": "integer" },
        "gameSystemName": { "type": "string" },
        "gameSystemId": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/errorAssertion" }
        },
        "errorsContain": {
          "type": "array",
          "items": { "$ref": "#/$defs/errorAssertion" }
        },
        "errorCount": { "type": "integer" },
        "engines": {
          "type": "object",
          "propertyNames": { "$ref": "spec-common-schema.json#/$defs/engineName" },
          "additionalProperties": { "$ref": "#/$defs/expectedState" }
        }
      }
    },
    "errorAssertion": {
      "type": "object",
      "required": ["on", "from"],
      "additionalProperties": false,
      "properties": {
        "on": {
          "description": "The roster NODE the engine raised the error on. '<kind> ${{ steps.<id>.<field> }}' for force/category/selection — node ids are minted per run, so a literal id is never valid: it names a catalogue ENTRY, which is a set of nodes, not one. Written bare, those kinds match on kind alone. 'roster' and 'group' are always bare: neither has an id a spec can name.",
          "type": "string",
          "pattern": "^\\s*(roster|group)\\s*$|^\\s*(force|category|selection)(\\s+\\$\\{\\{.*\\}\\})?\\s*$"
        },
        "from": { "type": "string" },
        "messageContains": { "type": "string" }
      }
    },
    "expectedForce": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "selectionCount": { "type": "integer" },
        "availableEntryCount": { "type": "integer" },
        "hidden": { "type": "boolean" },
        "childForceCount": { "type": "integer" },
        "childForces": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedForce" }
        },
        "selections": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedSelection" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedProfile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedRule" }
        },
        "publicationId": { "type": "string" },
        "page": { "type": "string" },
        "entryId": { "type": "string" },
        "categoryCount": { "type": "integer" },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedCategory" }
        },
        "publications": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedPublication" }
        },
        "catalogueId": { "type": "string" },
        "catalogueName": { "type": "string" },
        "customName": { "type": "string" },
        "customNotes": { "type": "string" }
      }
    },
    "expectedSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "number": { "type": "integer" },
        "hidden": { "type": "boolean" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedCost" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedSelection" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedProfile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedRule" }
        },
        "categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedCategory" }
        },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "publicationName": { "type": "string" },
        "entryGroupId": { "type": "string" },
        "entryId": { "type": "string" },
        "childCount": { "type": "integer" },
        "customName": { "type": "string" },
        "customNotes": { "type": "string" }
      }
    },
    "expectedCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "typeId": { "type": "string" },
        "value": { "type": "number" },
        "hidden": { "type": "boolean" }
      }
    },
    "expectedProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "typeId": { "type": "string" },
        "typeName": { "type": "string" },
        "hidden": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" },
        "characteristics": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedCharacteristic" }
        }
      }
    },
    "expectedCharacteristic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "typeId": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "expectedRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "hidden": { "type": "boolean" },
        "page": { "type": "string" },
        "publicationId": { "type": "string" }
      }
    },
    "expectedCategory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "entryId": { "type": "string" },
        "primary": { "type": "boolean" },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedProfile" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedRule" }
        },
        "publicationId": { "type": "string" },
        "page": { "type": "string" },
        "customName": { "type": "string" },
        "customNotes": { "type": "string" }
      }
    },
    "expectedPublication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    }
  }
}
